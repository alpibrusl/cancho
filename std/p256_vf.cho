edition 6;
module std.p256_vf;
import std.p256;
import std.p256_comb;
import std.p256_pt;

// `std.p256_vf` -- ECDSA verification on P-256 (SEC 1 §4.1.4) on `std.p256`'s
// arithmetic (`docs/p256-fast.md` §7), for `std.ecdsa`. Public data only:
// nothing here is constant time, and it branches and indexes on the scalars.
//
// u1 G + u2 Q by Shamir's trick over one chain of doublings: u1 in width-7
// wNAF against the generator's odd multiples 1G .. 63G (a `static`, affine,
// mixed additions), u2 in width-5 wNAF against 1Q .. 15Q built per call.
// Points are Jacobian (X : Y : Z), x = X / Z^2, with the doubling of
// dbl-2001-b and the additions of add-2007-bl and madd-2007-bl; the cases
// they do not cover (an equal pair, an opposite pair) are handled by the
// caller of the formula, as `std.ecdsa` did. Whether a value is zero modulo p
// is asked of its reduced form (`p256.from_mont`): a lazy element has no
// single representation of zero. Whether the running sum is the point at
// infinity is a flag, not a test of Z.
//
// A key that verifies many signatures can have a table (`build_table`,
// `docs/p256-fast.md` §11), given to `verify` in place of the point: both
// scalars' digits are then split into four runs over one chain of 64
// doublings. Public data too.
//
// Every function answers 0, or a code of `std.ecdsa` (-31 to -42).

// Temporaries t0..t13.
fn t(i: int) -> [] int {
    return p256.fe(p256.base() + i);
}

fn pt_acc() -> [] int {
    return p256.base() + 14;
}

// A table entry or a doubled point, a point of its own.
fn pt_ent() -> [] int {
    return p256.base() + 17;
}

fn pt_q2() -> [] int {
    return p256.base() + 20;
}

// Multiple 2k + 1 of Q, k = 0 to 7.
fn qtab(k: int) -> [] int {
    return p256.base() + 23 + 3 * k;
}

// u1, u2, r and a scratch element.
fn e_u1() -> [] int {
    return p256.fe(p256.base() + 47);
}

fn e_u2() -> [] int {
    return p256.fe(p256.base() + 48);
}

fn e_r() -> [] int {
    return p256.fe(p256.base() + 49);
}

fn e_zero() -> [] int {
    return p256.fe(p256.base() + 50);
}

// The wNAF digits of u1 and of u2, 260 words each.
fn dig1() -> [] int {
    return p256.fe(p256.base() + 51);
}

fn dig2() -> [] int {
    return dig1() + 260;
}

pub fn work_len() -> [] int {
    return dig2() + 260;
}

fn x_of(p: int) -> [] int {
    return p256_pt.x_of(p);
}

fn y_of(p: int) -> [] int {
    return p256_pt.y_of(p);
}

fn z_of(p: int) -> [] int {
    return p256_pt.z_of(p);
}

fn copy_point[&w](w: &!w [int], from: int, to: int) -> [] int {
    return p256_pt.copy_point(w, from, to);
}

// Whether the element at `x` is zero modulo p; `s` is a scratch element.
fn zero_mod[&w](w: &!w [int], x: int, s: int) -> [] bool {
    p256.from_mont(w, x, s);
    return p256.is_zero(w, s);
}

// d = 2p (dbl-2001-b, a = -3). Gives Z = 0 by itself for p infinite or
// Y = 0. `d` may be `p`.
fn double[&w](w: &!w [int], p: int, d: int) -> [] int {
    let x = x_of(p);
    let y = y_of(p);
    let z = z_of(p);
    // delta = Z^2, gamma = Y^2, beta = X gamma.
    p256.sqr(w, z, t(0));
    p256.sqr(w, y, t(1));
    p256.mul(w, x, t(1), t(2));
    // alpha = 3 (X - delta)(X + delta).
    p256.sub2(w, x, t(0), t(3));
    p256.add(w, x, t(0), t(4));
    p256.mul(w, t(3), t(4), t(3));
    p256.add(w, t(3), t(3), t(4));
    p256.add(w, t(4), t(3), t(5));
    // X3 = alpha^2 - 8 beta.
    p256.sqr(w, t(5), t(6));
    p256.add(w, t(2), t(2), t(7));
    p256.add(w, t(7), t(7), t(7));
    p256.add(w, t(7), t(7), t(8));
    p256.sub16(w, t(6), t(8), t(9));
    // Z3 = (Y + Z)^2 - gamma - delta.
    p256.add(w, y, z, t(10));
    p256.sqr(w, t(10), t(10));
    p256.sub2(w, t(10), t(1), t(10));
    p256.sub2(w, t(10), t(0), t(10));
    // Y3 = alpha (4 beta - X3) - 8 gamma^2.
    p256.sub32(w, t(7), t(9), t(11));
    p256.mul(w, t(5), t(11), t(11));
    p256.sqr(w, t(1), t(12));
    p256.add(w, t(12), t(12), t(12));
    p256.add(w, t(12), t(12), t(12));
    p256.add(w, t(12), t(12), t(12));
    p256.sub16(w, t(11), t(12), t(11));
    p256.copy(w, t(9), x_of(d));
    p256.copy(w, t(11), y_of(d));
    p256.copy(w, t(10), z_of(d));
    return 0;
}

// d = p + q (add-2007-bl) for two finite points; `d` may be `p`. 0, or 1 when
// the sum is the point at infinity (p = -q); an equal pair is doubled.
fn add_jac[&w](w: &!w [int], p: int, q: int, d: int) -> [] int {
    // Z1Z1, Z2Z2, U1 = X1 Z2Z2, U2 = X2 Z1Z1, S1 = Y1 Z2 Z2Z2, S2 = Y2 Z1 Z1Z1.
    p256.sqr(w, z_of(p), t(0));
    p256.sqr(w, z_of(q), t(1));
    p256.mul(w, x_of(p), t(1), t(2));
    p256.mul(w, x_of(q), t(0), t(3));
    p256.mul(w, y_of(p), z_of(q), t(4));
    p256.mul(w, t(4), t(1), t(4));
    p256.mul(w, y_of(q), z_of(p), t(5));
    p256.mul(w, t(5), t(0), t(5));
    // H = U2 - U1, r = S2 - S1.
    p256.sub2(w, t(3), t(2), t(6));
    p256.sub2(w, t(5), t(4), t(7));
    if zero_mod(w, t(6), t(13)) {
        if zero_mod(w, t(7), t(13)) {
            return double(w, p, d);
        }
        return 1;
    }
    // r = 2 (S2 - S1), I = (2H)^2, J = H I, V = U1 I.
    p256.add(w, t(7), t(7), t(7));
    p256.add(w, t(6), t(6), t(8));
    p256.sqr(w, t(8), t(8));
    p256.mul(w, t(6), t(8), t(9));
    p256.mul(w, t(2), t(8), t(10));
    // X3 = r^2 - J - 2V.
    p256.sqr(w, t(7), t(11));
    p256.sub2(w, t(11), t(9), t(11));
    p256.sub2(w, t(11), t(10), t(11));
    p256.sub2(w, t(11), t(10), t(11));
    // Y3 = r (V - X3) - 2 S1 J.
    p256.sub8(w, t(10), t(11), t(12));
    p256.mul(w, t(7), t(12), t(12));
    p256.mul(w, t(4), t(9), t(3));
    p256.add(w, t(3), t(3), t(3));
    p256.sub4(w, t(12), t(3), t(12));
    // Z3 = ((Z1 + Z2)^2 - Z1Z1 - Z2Z2) H.
    p256.add(w, z_of(p), z_of(q), t(3));
    p256.sqr(w, t(3), t(3));
    p256.sub2(w, t(3), t(0), t(3));
    p256.sub2(w, t(3), t(1), t(3));
    p256.mul(w, t(3), t(6), t(3));
    p256.copy(w, t(11), x_of(d));
    p256.copy(w, t(12), y_of(d));
    p256.copy(w, t(3), z_of(d));
    return 0;
}

// d = p + q for q affine, (X2, Y2) with Z2 = 1 (madd-2007-bl); `d` may be `p`.
// 0, or 1 when the sum is the point at infinity; an equal pair is doubled.
fn madd[&w](w: &!w [int], p: int, q: int, d: int) -> [] int {
    let x1 = x_of(p);
    let y1 = y_of(p);
    let z1 = z_of(p);
    let x2 = x_of(q);
    let y2 = y_of(q);
    // Z1Z1, U2 = X2 Z1Z1, S2 = Y2 Z1 Z1Z1, H = U2 - X1, r = S2 - Y1.
    p256.sqr(w, z1, t(0));
    p256.mul(w, x2, t(0), t(1));
    p256.mul(w, y2, z1, t(2));
    p256.mul(w, t(2), t(0), t(2));
    p256.sub32(w, t(1), x1, t(3));
    p256.sub32(w, t(2), y1, t(4));
    if zero_mod(w, t(3), t(13)) {
        if zero_mod(w, t(4), t(13)) {
            return double(w, p, d);
        }
        return 1;
    }
    // HH, I = 4 HH, J = H I, r = 2 r, V = X1 I.
    p256.sqr(w, t(3), t(5));
    p256.add(w, t(5), t(5), t(6));
    p256.add(w, t(6), t(6), t(6));
    p256.mul(w, t(3), t(6), t(7));
    p256.add(w, t(4), t(4), t(4));
    p256.mul(w, x1, t(6), t(8));
    // X3 = r^2 - J - 2V.
    p256.sqr(w, t(4), t(9));
    p256.sub2(w, t(9), t(7), t(9));
    p256.sub2(w, t(9), t(8), t(9));
    p256.sub2(w, t(9), t(8), t(9));
    // Y3 = r (V - X3) - 2 Y1 J.
    p256.sub8(w, t(8), t(9), t(10));
    p256.mul(w, t(4), t(10), t(10));
    p256.mul(w, y1, t(7), t(11));
    p256.add(w, t(11), t(11), t(11));
    p256.sub4(w, t(10), t(11), t(10));
    // Z3 = (Z1 + H)^2 - Z1Z1 - HH.
    p256.add(w, z1, t(3), t(12));
    p256.sqr(w, t(12), t(12));
    p256.sub2(w, t(12), t(0), t(12));
    p256.sub2(w, t(12), t(5), t(12));
    p256.copy(w, t(9), x_of(d));
    p256.copy(w, t(10), y_of(d));
    p256.copy(w, t(12), z_of(d));
    return 0;
}

// ---- wNAF ----

// Bit `i` of the element at `x` (tight limbs of 28 bits).
fn bit[&w](w: &w [int], x: int, i: int) -> [] int {
    return w[x + i / 28] >> i % 28 & 1;
}

// The `width` bits from bit `i` of the element at `x`, as a number.
fn bits[&w](w: &w [int], x: int, i: int, width: int) -> [] int {
    let idx = i / 28;
    let off = i % 28;
    var v = w[x + idx] >> off;
    if off + width > 28 && idx + 1 < 10 {
        v = v | w[x + idx + 1] << 28 - off;
    }
    return v & (1 << width) - 1;
}

// Adds 2^pos to the element at `x`, rippling the carry through the limbs.
fn add_bit[&w](w: &!w [int], x: int, pos: int) -> [] int {
    var idx = pos / 28;
    var v = w[x + idx] + (1 << pos % 28);
    while v >> 28 != 0 && idx < 9 {
        w[x + idx] = v & 0xfffffff;
        idx = idx + 1;
        v = w[x + idx] + 1;
    }
    w[x + idx] = v;
    return 0;
}

// The width-`width` non-adjacent form of the element at `x` (a number below
// 2^256, destroyed) into `dig`: 257 digits, each 0 or odd in
// (-2^(width-1), 2^(width-1)), nonzero digits at least `width` apart. Public for
// `tests/programs/p256_driver.cho`.
pub fn wnaf[&w](w: &!w [int], x: int, dig: int, width: int) -> [] int {
    // -42 (`ecdsa-work-length`) when the element or the digits are not inside `w`, or the
    // width is not one this module uses.
    if x < 0 || dig < 0 || x + 10 > len(w) || dig + 260 > len(w) || width < 2 || width > 8 {
        return -42;
    }
    var i = 0;
    while i < 260 {
        w[dig + i] = 0;
        i = i + 1;
    }
    i = 0;
    while i < 257 {
        if bit(w, x, i) == 0 {
            i = i + 1;
        } else {
            let d = bits(w, x, i, width);
            if d >= 1 << width - 1 {
                w[dig + i] = d - (1 << width);
                add_bit(w, x, i + width);
            } else {
                w[dig + i] = d;
            }
            i = i + width;
        }
    }
    return 0;
}

// The entry for digit `d` (odd, nonzero) of the generator's table into the
// affine point `pt_ent()`: X, Y as elements; Z is set to 1.
fn load_g[&w](w: &!w [int], d: int) -> [] int {
    var k = d;
    if d < 0 {
        k = 0 - d;
    }
    let at = (k - 1) / 2 * 20;
    var t = 0;
    while t < 20 {
        w[x_of(pt_ent()) + t] = p256_comb.odd_at(at + t);
        t = t + 1;
    }
    p256.copy(w, p256.one_mont(), z_of(pt_ent()));
    if d < 0 {
        p256.sub2(w, e_zero(), y_of(pt_ent()), y_of(pt_ent()));
    }
    return 0;
}

// The entry for digit `d` of Q's table into `pt_ent()`.
fn load_q[&w](w: &!w [int], d: int) -> [] int {
    var k = d;
    if d < 0 {
        k = 0 - d;
    }
    copy_point(w, qtab((k - 1) / 2), pt_ent());
    if d < 0 {
        p256.sub32(w, e_zero(), y_of(pt_ent()), y_of(pt_ent()));
    }
    return 0;
}

// Whether the sum in `pt_acc()` has x = r modulo n (`rr` is r, below n): x = r, or x = r + n
// when that is below p. Compared as X = r Z^2, so there is no inversion.
fn matches[&w](w: &!w [int], rr: int) -> [] bool {
    p256.sqr(w, z_of(pt_acc()), t(0));
    p256.to_mont(w, rr, t(1));
    p256.mul(w, t(1), t(0), t(1));
    p256.sub2(w, x_of(pt_acc()), t(1), t(2));
    if zero_mod(w, t(2), t(3)) {
        return true;
    }
    p256.put_n(w, t(3));
    p256.add(w, rr, t(3), t(3));
    if p256.below_p(w, t(3)) {
        p256.to_mont(w, t(3), t(1));
        p256.mul(w, t(1), t(0), t(1));
        p256.sub2(w, x_of(pt_acc()), t(1), t(2));
        if zero_mod(w, t(2), t(3)) {
            return true;
        }
    }
    return false;
}

// Whether a sum with affine x `x` (Z = 1) passes the final check against `r`: `matches`, for
// `tests/programs/p256_driver.cho`, which cannot reach the sums for which x = r + n.
pub fn check_x[&r, &x, &w](r: &r [byte], x: &x [byte], w: &!w [int]) -> [] bool {
    if len(w) < work_len() || len(r) > 35 || len(x) > 35 {
        return false;
    }
    p256.init(w);
    p256.load(r, w, e_r());
    p256.load(x, w, x_of(pt_acc()));
    p256.to_mont(w, x_of(pt_acc()), x_of(pt_acc()));
    p256.copy(w, p256.one_mont(), z_of(pt_acc()));
    return matches(w, e_r());
}

// SEC 1 §4.1.4's checks and step 4 for P-256, shared by `verify` and `verify_tabled`: the point
// `point` (04 || x || y), the digest, r and s as big-endian bytes of any length up to 35. On 0,
// u1 = e / s and u2 = r / s modulo n are in `e_u1()` and `e_u2()` as plain numbers, r in `e_r()`,
// zero in `e_zero()`, and Q (Montgomery form, Z = 1) in `qtab(0)`. Else the code of `std.ecdsa`:
// -42 the work, -31 the point's form, -38 r, -39 s, -33 and -34 the point.
fn prepare[&d, &q, &r, &s, &w](digest: &d [byte], point: &q [byte], r: &r [byte], s: &s [byte], w: &!w [int]) -> [] int {
    if len(w) < work_len() {
        return -42;
    }
    if len(point) != 65 || int_of(point[0]) != 4 {
        return -31;
    }
    p256.init(w);
    p256.set_zero(w, e_zero());
    // r and s in [1, n).
    if len(r) > 35 || len(s) > 35 {
        if len(r) > 35 {
            return -38;
        }
        return -39;
    }
    let rr = e_r();
    let sm = t(0);
    let em = t(1);
    p256.load(r, w, rr);
    if !p256.below_n(w, rr) || p256.is_zero(w, rr) {
        return -38;
    }
    p256.load(s, w, sm);
    if !p256.below_n(w, sm) || p256.is_zero(w, sm) {
        return -39;
    }
    // e: the digest's leftmost 32 bytes, below 2^256 < 2n: one subtraction.
    var m = len(digest);
    if m > 32 {
        m = 32;
    }
    p256.load(digest[0..m], w, em);
    p256.sreduce(w, em, em);
    // u1 = e / s, u2 = r / s modulo n, as plain numbers.
    p256.sto_mont(w, sm, sm);
    p256.sinvert(w, sm, sm);
    p256.sto_mont(w, em, em);
    p256.smul(w, em, sm, e_u1());
    p256.sfrom_mont(w, e_u1(), e_u1());
    p256.copy(w, rr, t(2));
    p256.sto_mont(w, t(2), t(2));
    p256.smul(w, t(2), sm, e_u2());
    p256.sfrom_mont(w, e_u2(), e_u2());
    // Q: both coordinates below p, on the curve.
    let q1 = qtab(0);
    p256.load(point[1..33], w, x_of(q1));
    p256.load(point[33..65], w, y_of(q1));
    if !p256.below_p(w, x_of(q1)) || !p256.below_p(w, y_of(q1)) {
        return -33;
    }
    p256.to_mont(w, x_of(q1), x_of(q1));
    p256.to_mont(w, y_of(q1), y_of(q1));
    p256.copy(w, p256.one_mont(), z_of(q1));
    if !p256_pt.on_curve_xy(w, x_of(q1), y_of(q1), t(0), t(1), t(2)) {
        return -34;
    }
    return 0;
}

// The entry in `pt_ent()` added to the running sum in `pt_acc()`, which is the point at infinity
// when `inf`: whether the sum is the point at infinity after.
fn accumulate[&w](w: &!w [int], inf: bool) -> [] bool {
    if inf {
        copy_point(w, pt_ent(), pt_acc());
        return false;
    }
    return madd(w, pt_acc(), pt_ent(), pt_acc()) != 0;
}

// SEC 1 §4.1.4 steps 4 and 5 for P-256 (`docs/p256-fast.md` §7): the point
// `point` (04 || x || y), the digest, r and s as big-endian bytes of any
// length up to 35. The code is `std.ecdsa`'s: -38 r, -39 s, -33 and -34 the
// point, -40 infinity, -41 mismatch. `point` may instead be a key's table
// (`build_table`, `table_len()` bytes), which begins with the point: the
// same answer, in about half the time (`docs/p256-fast.md` §11).
pub fn verify[&d, &q, &r, &s, &w](digest: &d [byte], point: &q [byte], r: &r [byte], s: &s [byte], w: &!w [int]) -> [] int {
    if len(point) == table_len() {
        return verify_tabled(digest, point, r, s, w);
    }
    let code = prepare(digest, point, r, s, w);
    if code != 0 {
        return code;
    }
    wnaf(w, e_u1(), dig1(), 7);
    wnaf(w, e_u2(), dig2(), 5);
    // 1Q, 3Q, ..., 15Q.
    double(w, qtab(0), pt_q2());
    var k = 1;
    while k < 8 {
        if add_jac(w, qtab(k - 1), pt_q2(), qtab(k)) != 0 {
            return -40;
        }
        k = k + 1;
    }
    // The chain.
    var inf = true;
    var i = 256;
    while i >= 0 {
        if !inf {
            double(w, pt_acc(), pt_acc());
        }
        let d1 = w[dig1() + i];
        if d1 != 0 {
            load_g(w, d1);
            if inf {
                copy_point(w, pt_ent(), pt_acc());
                inf = false;
            } else if madd(w, pt_acc(), pt_ent(), pt_acc()) != 0 {
                inf = true;
            }
        }
        let d2 = w[dig2() + i];
        if d2 != 0 {
            load_q(w, d2);
            if inf {
                copy_point(w, pt_ent(), pt_acc());
                inf = false;
            } else if add_jac(w, pt_acc(), pt_ent(), pt_acc()) != 0 {
                inf = true;
            }
        }
        i = i - 1;
    }
    if inf {
        return -40;
    }
    if !matches(w, e_r()) {
        return -41;
    }
    return 0;
}

// ---- A key's table (`docs/p256-fast.md` §11) ----
//
// For a public key Q that verifies many signatures -- a TLS server's own, which checks each one it
// makes (`docs/tls-server.md` §3.3), or a trust anchor's (`docs/x509-verify.md` §11) -- the odd
// multiples 1 .. 63 of Q, 2^65 Q, 2^130 Q and 2^195 Q, affine, built once. u2's digits then fall
// into four runs of 65, as u1's do against `p256_comb.odd`, and one chain of 64 doublings serves the
// eight runs where `verify` doubles 256 times. **Public data only:** a table is computed from the
// public point, never from a private key, and nothing here is constant time.
//
// A table is `table_len()` bytes: the point it was built from (65 bytes, 04 || x || y), then 128
// entries, entry 32 j + k being (2k + 1) 2^(65 j) Q: x then y, each in Montgomery form and fully
// reduced, as ten limbs of four bytes, least significant first. It is given to `verify` in place of
// the point, so it cannot be used for another key; the point in it is checked on every call, as a
// point given alone is. The entries are trusted as `build_table` wrote them, as the key's bytes are.

// The bits of a run, and the runs: 4 runs of 65 cover the 257 wNAF digits of a number below 2^256.
pub fn span() -> [] int {
    return 65;
}

pub fn chunks() -> [] int {
    return 4;
}

fn per_chunk() -> [] int {
    return 32;
}

fn entry_bytes() -> [] int {
    return 80;
}

pub fn table_len() -> [] int {
    return 65 + chunks() * per_chunk() * entry_bytes();
}

// Building: a run's 32 multiples in Jacobian coordinates, their running products, and three
// elements for the inversions. (`qtab`, which `verify` uses at the same place, is not used here.)
fn jtab(k: int) -> [] int {
    return p256.base() + 23 + 3 * k;
}

fn pre(k: int) -> [] int {
    return p256.fe(p256.base() + 119 + k);
}

fn e_inv() -> [] int {
    return p256.fe(p256.base() + 151);
}

fn e_zi() -> [] int {
    return p256.fe(p256.base() + 152);
}

fn e_zi2() -> [] int {
    return p256.fe(p256.base() + 153);
}

// The words `build_table` needs.
pub fn table_work_len() -> [] int {
    return p256.words(154);
}

// The element at `x` (Montgomery form, lazily reduced) fully reduced, as ten limbs of four bytes
// into `table` at `at`: to_mont then from_mont gives x mod p, still in Montgomery form. `s` is a
// scratch element.
fn put_limbs[&w, &t](w: &!w [int], x: int, s: int, table: &!t [byte], at: int) -> [] int {
    p256.to_mont(w, x, s);
    p256.from_mont(w, s, s);
    var i = 0;
    while i < 10 {
        let v = w[s + i];
        table[at + 4 * i] = byte_of(v & 255);
        table[at + 4 * i + 1] = byte_of(v >> 8 & 255);
        table[at + 4 * i + 2] = byte_of(v >> 16 & 255);
        table[at + 4 * i + 3] = byte_of(v >> 24);
        i = i + 1;
    }
    return 0;
}

// Run `j`'s 32 entries from its base, the Jacobian point `b`: the odd multiples by additions of 2b,
// then all 32 made affine with one inversion (Montgomery's trick: the running products of the Z's,
// one inverse, and each Z's inverse peeled off it). 0, or -40 when a multiple is the point at
// infinity, which a point of the curve (prime order n) never gives.
fn run[&w, &t](w: &!w [int], b: int, table: &!t [byte], j: int) -> [] int {
    copy_point(w, b, jtab(0));
    double(w, b, pt_q2());
    var k = 1;
    while k < per_chunk() {
        if add_jac(w, jtab(k - 1), pt_q2(), jtab(k)) != 0 {
            return -40;
        }
        k = k + 1;
    }
    p256.copy(w, z_of(jtab(0)), pre(0));
    k = 1;
    while k < per_chunk() {
        p256.mul(w, pre(k - 1), z_of(jtab(k)), pre(k));
        k = k + 1;
    }
    if zero_mod(w, pre(per_chunk() - 1), t(13)) {
        return -40;
    }
    p256.invert(w, pre(per_chunk() - 1), e_inv());
    k = per_chunk() - 1;
    while k >= 0 {
        // e_zi = 1 / Z_k; e_inv becomes 1 / (Z_0 ... Z_(k-1)).
        if k > 0 {
            p256.mul(w, e_inv(), pre(k - 1), e_zi());
            p256.mul(w, e_inv(), z_of(jtab(k)), e_inv());
        } else {
            p256.copy(w, e_inv(), e_zi());
        }
        p256.sqr(w, e_zi(), e_zi2());
        p256.mul(w, x_of(jtab(k)), e_zi2(), t(0));
        p256.mul(w, e_zi2(), e_zi(), e_zi2());
        p256.mul(w, y_of(jtab(k)), e_zi2(), t(1));
        let at = 65 + (per_chunk() * j + k) * entry_bytes();
        put_limbs(w, t(0), t(2), table, at);
        put_limbs(w, t(1), t(2), table, at + 40);
        k = k - 1;
    }
    return 0;
}

// The table of the point `point` (04 || x || y) into `table` (`table_len()` bytes; `w` holds
// `table_work_len()` words, zeroed before the answer). The point is checked as `verify` checks it.
// Its 65 bytes are written last, so a table cut short by a refusal starts with a zero byte and is
// never taken for a key (`table_for`). 0, or -42 for the lengths, -31 the point's form, -33 and -34
// the point (the table is then zeros), -40 (not reached by a point of the curve). Public data: the
// point's multiples, never the private key.
pub fn build_table[&q, &t, &w](point: &q [byte], table: &!t [byte], w: &!w [int]) -> [] int {
    if len(table) < table_len() || len(w) < table_work_len() {
        return -42;
    }
    let code = build(point, table, w);
    p256.wipe(w, 0, table_work_len());
    return code;
}

fn build[&q, &t, &w](point: &q [byte], table: &!t [byte], w: &!w [int]) -> [] int {
    var i = 0;
    while i < table_len() {
        table[i] = byte_of(0);
        i = i + 1;
    }
    if len(point) != 65 || int_of(point[0]) != 4 {
        return -31;
    }
    p256.init(w);
    let b = pt_acc();
    p256.load(point[1..33], w, x_of(b));
    p256.load(point[33..65], w, y_of(b));
    if !p256.below_p(w, x_of(b)) || !p256.below_p(w, y_of(b)) {
        return -33;
    }
    p256.to_mont(w, x_of(b), x_of(b));
    p256.to_mont(w, y_of(b), y_of(b));
    p256.copy(w, p256.one_mont(), z_of(b));
    if !p256_pt.on_curve_xy(w, x_of(b), y_of(b), t(0), t(1), t(2)) {
        return -34;
    }
    var code = 0;
    var j = 0;
    while j < chunks() && code == 0 {
        if j > 0 {
            var d = 0;
            while d < span() {
                double(w, b, b);
                d = d + 1;
            }
        }
        code = run(w, b, table, j);
        j = j + 1;
    }
    if code != 0 {
        i = 0;
        while i < table_len() {
            table[i] = byte_of(0);
            i = i + 1;
        }
        return code;
    }
    i = 0;
    while i < 65 {
        table[i] = point[i];
        i = i + 1;
    }
    return 0;
}

// Whether `table` is a table of `point`: its length, and its first 65 bytes are the point. A caller
// that keeps a table beside a key asks this before giving the table to `verify` in its place.
pub fn table_for[&t, &q](table: &t [byte], point: &q [byte]) -> [] bool {
    if len(table) != table_len() || len(point) != 65 || int_of(point[0]) != 4 {
        return false;
    }
    var i = 0;
    while i < 65 {
        if table[i] != point[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The generator's entry for digit `d` (odd, nonzero) of run `j` into `pt_ent()`.
fn load_gj[&w](w: &!w [int], j: int, d: int) -> [] int {
    var k = d;
    if d < 0 {
        k = 0 - d;
    }
    let row = p256_comb.odd_row(640 * j + (k - 1) / 2 * 20);
    let e = w[x_of(pt_ent())..x_of(pt_ent()) + 20];
    var t = 0;
    while t < 20 {
        e[t] = row[t];
        t = t + 1;
    }
    p256.copy(w, p256.one_mont(), z_of(pt_ent()));
    if d < 0 {
        p256.sub2(w, e_zero(), y_of(pt_ent()), y_of(pt_ent()));
    }
    return 0;
}

// The table's entry for digit `d` (odd, nonzero) of run `j` into `pt_ent()`.
fn load_tab[&t, &w](table: &t [byte], w: &!w [int], j: int, d: int) -> [] int {
    var k = d;
    if d < 0 {
        k = 0 - d;
    }
    let at = 65 + (per_chunk() * j + (k - 1) / 2) * entry_bytes();
    let b = table[at..at + 80];
    let e = w[x_of(pt_ent())..x_of(pt_ent()) + 20];
    var i = 0;
    while i < 20 {
        e[i] = int_of(b[4 * i]) | int_of(b[4 * i + 1]) << 8 | int_of(b[4 * i + 2]) << 16 | int_of(b[4 * i + 3]) << 24;
        i = i + 1;
    }
    p256.copy(w, p256.one_mont(), z_of(pt_ent()));
    if d < 0 {
        p256.sub2(w, e_zero(), y_of(pt_ent()), y_of(pt_ent()));
    }
    return 0;
}

// `verify` against the key's table `table` (`build_table`), whose first 65 bytes are the point: u1
// against the generator's runs and u2 against the table's, both in width-7 wNAF, over one chain of 64
// doublings. The point is checked as `verify` checks it, and the answer is `verify`'s.
fn verify_tabled[&d, &t, &r, &s, &w](digest: &d [byte], table: &t [byte], r: &r [byte], s: &s [byte], w: &!w [int]) -> [] int {
    let code = prepare(digest, table[0..65], r, s, w);
    if code != 0 {
        return code;
    }
    wnaf(w, e_u1(), dig1(), 7);
    wnaf(w, e_u2(), dig2(), 7);
    var inf = true;
    var i = span() - 1;
    while i >= 0 {
        if !inf {
            double(w, pt_acc(), pt_acc());
        }
        var j = 0;
        while j < chunks() {
            let at = span() * j + i;
            let d1 = w[dig1() + at];
            if d1 != 0 {
                load_gj(w, j, d1);
                inf = accumulate(w, inf);
            }
            let d2 = w[dig2() + at];
            if d2 != 0 {
                load_tab(table, w, j, d2);
                inf = accumulate(w, inf);
            }
            j = j + 1;
        }
        i = i - 1;
    }
    if inf {
        return -40;
    }
    if !matches(w, e_r()) {
        return -41;
    }
    return 0;
}
