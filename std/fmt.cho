}

// ceil for the small numbers used here
fn ceil_int(v: float) -> [] int {
    let t = truncate(v);
    if float_of(t) < v {
        return t + 1;
    }
    return t;
}

// Weed the digits so that they are the closest to w among the shortest in the interval, or say that this cannot be told (false): Loitsch's `RoundWeed`, every comparison unsigned.
fn round_weed[&d](digits: &!d [int], length: int, dist: int, unsafe_i: int, rest0: int, ten_kappa: int, unit: int) -> [] bool {
    var rest = rest0;
    let small = wrapping_sub(dist, unit);
    let big = wrapping_add(dist, unit);
    var go = true;
    while go {
        if ult(rest, small) && !ult(wrapping_sub(unsafe_i, rest), ten_kappa) {
            let rt = wrapping_add(rest, ten_kappa);
            if ult(rt, small) || !ult(wrapping_sub(small, rest), wrapping_sub(rt, small)) {
                digits[length - 1] = digits[length - 1] - 1;
                rest = rt;
            } else {
                go = false;
            }
        } else {
            go = false;
        }
    }
    if ult(rest, big) && !ult(wrapping_sub(unsafe_i, rest), ten_kappa) {
        let rt = wrapping_add(rest, ten_kappa);
        if ult(rt, big) || ult(wrapping_sub(rt, big), wrapping_sub(big, rest)) {
            return false;
        }
    }
    let two_unit = wrapping_mul(2, unit);
    let four_unit = wrapping_mul(4, unit);
    return !ult(rest, two_unit) && !ult(wrapping_sub(unsafe_i, four_unit), rest);
}

// The shortest digits of the scaled interval: answers (length, kappa, ok), the digits in `digits`.
fn digit_gen[&d](low_f: int, w_f: int, high_f: int, e: int, digits: &!d [int]) -> [] (int, int, bool) {
    var unit = 1;
    let too_low = wrapping_sub(low_f, 1);
    let too_high = wrapping_add(high_f, 1);
    var unsafe_i = wrapping_sub(too_high, too_low);
    let shift = 0 - e;
    let one = 1 << shift;
    var integrals = lsr(too_high, shift);
    var fractionals = too_high & one - 1;
    // the biggest power of ten not above the integral part
    var divisor = 0;
    var kappa = 0;
    if integrals > 0 {
        divisor = 1;
        kappa = 1;
        while divisor * 10 <= integrals {
            divisor = divisor * 10;
            kappa = kappa + 1;
        }
    }
    var length = 0;
    while kappa > 0 {
        let digit = integrals / divisor;
        digits[length] = digit;
        length = length + 1;
        integrals = integrals % divisor;
        kappa = kappa - 1;
        let rest = wrapping_add(integrals << shift, fractionals);
        if ult(rest, unsafe_i) {
            let ok = round_weed(digits, length, wrapping_sub(too_high, w_f), unsafe_i, rest, divisor << shift, unit);
            return (length, kappa, ok);
        }
        divisor = divisor / 10;
    }
    var more = true;
    while more {
        fractionals = wrapping_mul(fractionals, 10);
        unit = unit * 10;
        unsafe_i = wrapping_mul(unsafe_i, 10);
        let digit = lsr(fractionals, shift);
        digits[length] = digit;
        length = length + 1;
        fractionals = fractionals & one - 1;
        kappa = kappa - 1;
        if ult(fractionals, unsafe_i) {
            let ok = round_weed(digits, length, wrapping_mul(wrapping_sub(too_high, w_f), unit), unsafe_i, fractionals, one, unit);
            return (length, kappa, ok);
        }
        if length >= 20 {
            more = false;
        }
    }
    return (length, kappa, false);
}

// `x` positive, finite. Answers (d, k) with x = d * 10^k, d the shortest digits, or (-1, 0).
fn grisu(x: float) -> [] (int, int) {
    let bits = bits_of(x);
    let raw = bits & 0xfffffffffffff;
    let ex = bits >> 52 & 0x7ff;
    var f = raw;
    var e = 0 - 1074;
    if ex != 0 {
        f = raw | 1 << 52;
        e = ex - 1075;
    }
    let lower_closer = raw == 0 && ex > 1;
    // w, normalized
    var wf = f;
    var we = e;
    while wf & 1 << 62 == 0 && wf & 1 << 63 == 0 {
        wf = wf << 1;
        we = we - 1;
    }
    if wf & 1 << 63 == 0 {
        wf = wf << 1;
        we = we - 1;
    }
    // m_plus, normalized
    var pf = (f << 1) + 1;
    var pe = e - 1;
    while pf & 1 << 63 == 0 {
        pf = pf << 1;
        pe = pe - 1;
    }
    var mf = (f << 1) - 1;
    var me = e - 1;
    if lower_closer {
        mf = (f << 2) - 1;
        me = e - 2;
    }
    mf = mf << me - pe;
    me = pe;
    // the cached power of ten that brings the product's exponent into [-60, -32]
    let min_exp = 0 - 60 - (we + 64);
    let k = ceil_int(float_of(min_exp + 63) * 0.30102999566398114);
    let index = (348 + k - 1) / 8 + 1;
    let cf = cached_f[index];
    let ce = cached_e[index];
    let mk = 0 - 348 + 8 * index;
    let sw = mul_f(wf, cf);
    let sp = mul_f(pf, cf);
    let sm = mul_f(mf, cf);
    let se = we + ce + 64;
    var result = (0 - 1, 0);
    region a {
        let digits = alloc_slice[a](24, 0);
        let (length, kappa, ok) = digit_gen(sm, sw, sp, se, digits);
        if ok && length > 0 && length <= 17 {
            var d = 0;
            var j = 0;
            while j < length {
                d = d * 10 + digits[j];
                j = j + 1;
            }
            result = (d, kappa - mk);
        }
    }
    return result;
}
