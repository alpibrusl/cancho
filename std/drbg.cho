module std.drbg;
import std.chacha20;

// `std.drbg` -- a fast-key-erasure generator: ChaCha20 in counter
// mode, each block's first half replacing the key and its second half
// the output (#289; `docs/tls-pure.md` \u00a76, where the construction
// came from). The same generator `packages/tls` carried privately
// since the client's first handshake, moved to `std` so that every
// program has one copy and one review. Not independently reviewed
// (#209).
//
// Seeding is the caller's: a program reads 32 bytes of `/dev/urandom`
// through `Fs` (or any other source it trusts) and passes them to
// `seed`. The module reads no file and takes no capability; an
// authority report shows exactly what the caller read. A generator
// that was never seeded refuses `draw` with a typed refusal, never a
// predictable key.
//
// The state is 32 bytes (the key) and one word for the seeded flag;
// nothing else, so a `Box` of `state_len()` bytes and `seeded_len()`
// words is the whole of it. `seed` may be called again at any time:
// each call erases the old key. Nothing here branches on the key, so
// the sequence of operations is the same whatever it is.

pub fn ok() -> [] int {
    return 0;
}

// The seed is not 32 bytes.
pub fn refused_seed_length() -> [] int {
    return -1;
}

// `draw` before any `seed`: the generator holds no key yet.
pub fn refused_unseeded() -> [] int {
    return -2;
}

// The words of the seeded flag: one int, 0 or 1.
pub fn seeded_len() -> [] int {
    return 1;
}

// The bytes of the key: 32.
pub fn state_len() -> [] int {
    return 32;
}

pub fn refusal_tag(code: int) -> [] &static [byte] {
    if code == 0 {
        return "ok";
    }
    if code == -1 {
        return "drbg-seed-length";
    }
    if code == -2 {
        return "drbg-unseeded";
    }
    return "unknown";
}

// The key in `state` (32 bytes) is replaced by `entropy` (32 bytes),
// and the generator is marked seeded. The old key is overwritten, not
// kept anywhere.
pub fn seed[&s, &k, &f](entropy: &s [byte], key: &!k [byte], seeded: &!f [int]) -> [] int {
    if len(entropy) != 32 || len(key) < 32 {
        return -1;
    }
    var i = 0;
    while i < 32 {
        key[i] = entropy[i];
        i = i + 1;
    }
    seeded[0] = 1;
    return 0;
}

// Up to `len(out)` bytes into `out`, from the generator `key` (32
// bytes) whose state is `seeded` (one word, as `seed` wrote it).
// Each ChaCha20 block: the first 32 bytes become the next key, the
// last 32 are output, so at most 32 bytes of any one key ever guard
// output, and the key before last is gone. 0, or -2 when unseeded.
pub fn draw[&k, &f, &o](key: &!k [byte], seeded: &f [int], out: &!o [byte]) -> [] int {
    if len(key) < 32 || seeded[0] != 1 {
        return -2;
    }
    region r {
        let nonce = alloc_slice[r](12, byte_of(0));
        let stream = alloc_slice[r](64, byte_of(0));
        var done = 0;
        while done < len(out) {
            chacha20.block(key, 0, nonce, stream);
            var i = 0;
            while i < 32 {
                key[i] = stream[i];
                i = i + 1;
            }
            i = 0;
            while i < 32 && done < len(out) {
                out[done] = stream[32 + i];
                done = done + 1;
                i = i + 1;
            }
        }
        // Best effort, as everywhere (`docs/hkdf.md` \u00a73).
        var i = 0;
        while i < 64 {
            stream[i] = byte_of(0);
            i = i + 1;
        }
    }
    return 0;
}
