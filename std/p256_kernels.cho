    let m1 = s & 268435455;
    c = wrapping_add(s >> 28, m1);
    let g2_0 = m0 + m1;
    s = c;
    s = wrapping_add(s, wrapping_mul(a0, a2) << 1);
    s = wrapping_add(s, wrapping_mul(a1, a1));
    s = wrapping_add(s, wrapping_sub(g2_0 << 28, g2_0));
    let m2 = s & 268435455;
    c = wrapping_add(s >> 28, m2);
    let g3_1 = m1 + m2;
    s = c;
    s = wrapping_add(s, wrapping_add(wrapping_mul(a0, a3), wrapping_mul(a1, a2)) << 1);
    s = wrapping_add(s, wrapping_sub(m0 << 12, m0));
    s = wrapping_add(s, wrapping_sub(g3_1 << 28, g3_1));
    let m3 = s & 268435455;
    c = wrapping_add(s >> 28, m3);
    let g4_1 = m2 + m3;
    s = c;
    s = wrapping_add(s, wrapping_add(wrapping_mul(a0, a4), wrapping_mul(a1, a3)) << 1);
    s = wrapping_add(s, wrapping_mul(a2, a2));
    s = wrapping_add(s, wrapping_sub(m1 << 12, m1));
    s = wrapping_add(s, wrapping_sub(g4_1 << 28, g4_1));
    let m4 = s & 268435455;
    c = wrapping_add(s >> 28, m4);
    let g5_1 = m3 + m4;
    s = c;
    s = wrapping_add(s, wrapping_add(wrapping_add(wrapping_mul(a0, a5), wrapping_mul(a1, a4)), wrapping_mul(a2, a3)) << 1);
