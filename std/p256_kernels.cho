    s = wrapping_add(s, wrapping_mul(a3, a3));
    s = wrapping_add(s, wrapping_sub(m3 << 12, m3));
    s = wrapping_add(s, wrapping_sub(g6_1 << 28, g6_1));
    s = wrapping_add(s, m0 << 24);
    let m6 = s & 268435455;
    c = wrapping_add(s >> 28, m6);
    let g7_1 = m5 + m6;
    s = c;
    s = wrapping_add(s, wrapping_add(wrapping_add(wrapping_add(wrapping_mul(a0, a7), wrapping_mul(a1, a6)), wrapping_mul(a2, a5)), wrapping_mul(a3, a4)) << 1);
    s = wrapping_add(s, wrapping_sub(m4 << 12, m4));
    s = wrapping_add(s, wrapping_sub(g7_1 << 28, g7_1));
    s = wrapping_add(s, m1 << 24);
    let m7 = s & 268435455;
    c = wrapping_add(s >> 28, m7);
