pub fn canon_p[&w](w: &!w [int], x: int, d: int) -> [] int {
    var u = 0;
    var v = 0;
    v = w[x + 0] - 268435455 - u;
    u = v >> 63 & 1;
    v = w[x + 1] - 268435455 - u;
    u = v >> 63 & 1;
    v = w[x + 2] - 268435455 - u;
    u = v >> 63 & 1;
    v = w[x + 3] - 4095 - u;
    u = v >> 63 & 1;
    v = w[x + 4] - 0 - u;
    u = v >> 63 & 1;
    v = w[x + 5] - 0 - u;
    u = v >> 63 & 1;
    v = w[x + 6] - 16777216 - u;
    u = v >> 63 & 1;
    v = w[x + 7] - 0 - u;
    u = v >> 63 & 1;
    v = w[x + 8] - 268435455 - u;
    u = v >> 63 & 1;
    v = w[x + 9] - 15 - u;
    u = v >> 63 & 1;
    // All ones when x >= mod; through the barrier so the optimiser cannot make the
    // subtraction below a branch on it (docs/value-barrier.md).
    let m = value_barrier(u - 1);
    u = 0;
    v = w[x + 0] - (268435455 & m) - u;
    w[d + 0] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 1] - (268435455 & m) - u;
    w[d + 1] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 2] - (268435455 & m) - u;
    w[d + 2] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 3] - (4095 & m) - u;
    w[d + 3] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 4] - (0 & m) - u;
    w[d + 4] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 5] - (0 & m) - u;
    w[d + 5] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 6] - (16777216 & m) - u;
    w[d + 6] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 7] - (0 & m) - u;
    w[d + 7] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 8] - (268435455 & m) - u;
    w[d + 8] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 9] - (15 & m) - u;
    w[d + 9] = v & 268435455;
    u = v >> 63 & 1;
    return 0;
