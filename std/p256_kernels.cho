pub fn add[&w](w: &!w [int], x: int, y: int, d: int) -> [] int {
    let xs = w[x..x + 10];
    let ys = w[y..y + 10];
    let os = w[d..d + 10];
    var c = 0;
    var v = 0;
    v = xs[0] + ys[0];
    os[0] = v & 268435455;
    c = v >> 28;
    v = xs[1] + ys[1] + c;
    os[1] = v & 268435455;
    c = v >> 28;
    v = xs[2] + ys[2] + c;
    os[2] = v & 268435455;
    c = v >> 28;
    v = xs[3] + ys[3] + c;
    os[3] = v & 268435455;
    c = v >> 28;
    v = xs[4] + ys[4] + c;
    os[4] = v & 268435455;
    c = v >> 28;
    v = xs[5] + ys[5] + c;
    os[5] = v & 268435455;
    c = v >> 28;
    v = xs[6] + ys[6] + c;
    os[6] = v & 268435455;
    c = v >> 28;
    v = xs[7] + ys[7] + c;
    os[7] = v & 268435455;
    c = v >> 28;
    v = xs[8] + ys[8] + c;
    os[8] = v & 268435455;
    c = v >> 28;
    v = xs[9] + ys[9] + c;
    os[9] = v;
    return 0;
}

