pub fn sqr_p[&w](w: &!w [int], x: int, d: int) -> [] int {
    let xs = w[x..x + 10];
    let a0 = xs[0];
    let a1 = xs[1];
    let a2 = xs[2];
    let a3 = xs[3];
    let a4 = xs[4];
    let a5 = xs[5];
    let a6 = xs[6];
    let a7 = xs[7];
    let a8 = xs[8];
    let a9 = xs[9];
    let os = w[d..d + 10];
    var s = 0;
    var c = 0;
    s = wrapping_mul(a0, a0);
    let m0 = s & 268435455;
    c = wrapping_add(s >> 28, m0);
    s = c;
