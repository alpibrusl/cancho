// `(hi, lo) + a * b`, a two-word accumulator plus the whole product of two words.
fn mac(hi: int, lo: int, a: int, b: int) -> [] (int, int) {
    let (h, l) = mul_wide(a, b);
    let (s, c) = add_carry(lo, l, 0);
    return (wrapping_add(wrapping_add(hi, h), c), s);
}

// Bits 56.. of the accumulator `hi * 2^64 + lo`, as a word. `lo >> 56` is arithmetic, so its
// eight meaningful bits are masked.
fn shr56(hi: int, lo: int) -> [] int {
    return lo >> 56 & 255 | hi << 8;
}

