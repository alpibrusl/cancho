    v = w[x + 6] - (16777215 & m) - u;
    w[d + 6] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 7] - (0 & m) - u;
    w[d + 7] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 8] - (268435455 & m) - u;
    w[d + 8] = v & 268435455;
    u = v >> 63 & 1;
    v = w[x + 9] - (15 & m) - u;
    w[d + 9] = v & 268435455;
    u = v >> 63 & 1;
    return 0;
}
