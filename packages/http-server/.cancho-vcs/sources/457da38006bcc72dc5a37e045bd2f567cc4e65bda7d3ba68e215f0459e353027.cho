edition 5;

// `http.server` -- the server loop, as a package (`docs/http-server.md`).
//
// What `examples/api/api.cho` carried alongside its routes: accepting, reading,
// parsing, framing (a length or chunked), pipelining, back-pressure on a client
// that does not read, an idle timeout. What it does *not* carry is anything
// about what a request means -- no routes, no JSON, no handler. The
// application's loop calls `wait`, then `next` until it answers `-1`, answering
// each request with `respond`:
//
//     var srv = server.open(heap, poller, listener, size, chunk, idle);
//     while true {
//         srv = server.wait(heap, srv, clock, listener, 1000);
//         while next(srv) >= 0 { ... server.head/parsed/body ...; server.respond(srv, answer); }
//     }
//
// A callback would have been the obvious shape and does not type-check: a
// function value's type may mention only regions already in scope, and a
// request is a view of a buffer this loop borrows itself (`http-server.md` §2).
// So the views are borrows of the `Server`, valid where the application reads
// them, and the application's own state stays its own variables.
//
// A server can also be opened with no sockets (`open_bytes`): the application
// moves the bytes, which is what a TLS terminator in front of it does
// (`docs/http-server.md` §11). It is the same framing, pipelining,
// back-pressure and idle sweep -- one parser -- and the end of this file is
// the part that is only for it:
//
//     var srv = server.open_bytes(heap, size, out, idle, max);   // an `Opening`
//     k = server.attach(srv, now_ms);
//     server.input(srv, k, plaintext, now_ms);                    // up to `room`
//     server.ready(srv, now_ms);
//     while next(srv) >= 0 { ... server.respond(srv, answer); }  // as above
//     n = server.output(srv, k, out, now_ms);                     // for `tls.send`
//     if server.closing(srv, k) { /* close_notify, close */ server.detach(srv, k); }
//
// Imports `std`, which makes this the first package that does
// (`docs/package-system.md` §4.8): publish it with `--std`.

module http.server;

import std.buffer;
import std.bytes;
import std.conns;
import std.http;
import std.json;

// Connections at once, at most.
fn max_connections() -> [] int {
    return 1024;
}

// How much input buffer all the connections may hold together: 256 MiB, so a
// bigger per-connection buffer means fewer connections rather than more memory.
fn input_budget() -> [] int {
    return 268435456;
}

// What one connection may have waiting to be sent. One whole answer and a
// little more; a connection that cannot even do that is closed.
fn output_size() -> [] int {
    return 65536;
}

// How many connections fit: `max_connections`, or what the budget allows at
// this buffer size if that is fewer.
fn connection_limit(size: int) -> [] int {
    var limit = input_budget() / size;
    if limit > max_connections() {
        limit = max_connections();
    }
    return limit;
}

// Per connection `k`, `state[16k..16k+16]` is:
//
//      0  bytes of input buffered
//      1  the time of its last progress, in seconds
//      2  bytes of output waiting (-1: it could not be held)
//      3  1 if it is to close once that output has gone
//      4  1 if the slot is in use (a byte-fed server: 2 once it has ended, until `detach`)
//      5  what it is watched for (1 to read, 2 to write)
//      6  bytes of the buffer already answered, this visit
//      7  the head of the request in hand, in bytes
//      8  the bytes after the head that the request consumed
//      9  the body's length, as the application sees it
//     10  1 if that body was decoded into `decoded`, 0 if it is in the buffer
//     11  1 if the connection must be dropped now
//     12  1 if it is in `ready`
//     13  1 if the request in the front of the buffer is held: handed to the application
//         and not yet answered (`hold`)
//     14  how many connections have used this slot, so a held request's ticket can tell
//         the connection it was taken from from a later one in the same slot
//     15  1 if the peer will send no more (`end_input`): what is buffered is still answered
//
// A server with `limits` (`http-server.md` §12) uses these too; they are 0 for a request with no body:
//     16  the request's body: 1 a length (or a whole body), 2 chunked, 0 none
//     17  a length body: bytes of it still to arrive
//     18  the chunk machine's state, 19 the bytes left in the chunk (while the size is read, the size), 20 digits or extension bytes seen
//     21  where the body bytes the application has not taken start in the buffer, 22 how many there are
//     23  body bytes received, decoded (what `max_body` counts)
//     24  flags: 1 keep-alive, 2 `Expect: 100-continue` not answered, 4 the answer has begun, 8 the body has all arrived, 16 any of it has
//     25  a refusal recorded for the next `next` to send (`rule_*`), 0 for none
//     26  when the head was first seen incomplete, in ms + 1 (0: not waiting for one)
//     27  when the client last made progress on the body, in ms
//     28  (spare), 29 trailer bytes
fn stride() -> [] int {
    return 32;
}

// Everything but the connection table, which `wait` has to take out of the
// server to grow (`std.conns.put` consumes it).
res struct Core {
    poller: Poller,
    // `poller_wait` fills these with (token, readiness) pairs.
    events: Box[[int]],
    state: Box[[int]],
    // One input buffer per connection, one slab.
    bufs: Box[[byte]],
    // One output buffer per connection, one slab.
    pends: Box[[byte]],
    // The parse table of the request in hand: `std.http` fills it.
    parsed: Box[[int]],
    // Where a chunked body is decoded: one request at a time uses it.
    decoded: Box[[byte]],
    // Connections that hold input, in the order `next` visits them.
    ready: Box[[int]],
    limit: int,
    size: int,
    chunk: int,
    idle: int,
    nready: int,
    cursor: int,
    // The connection `next` is draining, or -1.
    cur: int,
    last_sweep: int,
    // What `poller_wait` reported for tokens the application registered itself (above
    // `limit`): (token, readiness) pairs, `nforeign` of them, from the last `wait`.
    foreign: Box[[int]],
    nforeign: int,
    // 1 for a server opened with `open_bytes`: no socket is ever read or written, the
    // application moves the bytes (`http-server.md` §11).
    fed: int,
    // What one connection may have waiting to be sent (`output_size` for a socket server).
    osize: int,
    // A byte-fed server's connections in use, and where `attach` looks for a free slot next.
    nlive: int,
    scan: int,
    // `limits` (`http-server.md` §12): 1 once called, and the bounds it set.
    lim: int,
    maxb: int,
    piece: int,
    head_ms: int,
    body_ms: int,
    // The last time the caller gave, in ms, and when the timers were last scanned.
    now: int,
    last_tick: int,
}

pub res struct Server {
    tab: conns.Table,
    core: Core,
}

// ---------------------------------------------------------------------
// Answers
// ---------------------------------------------------------------------

// A whole JSON response: the head, then `body`.
pub fn reply[&h, &b](heap: &!h Heap, out: buffer.Buffer, status: int, body: &b [byte], keep: bool) -> [heap] buffer.Buffer {
    return reply_with(heap, out, status, body, keep, "");
}

// `reply`, with extra header lines in the head.
pub fn reply_with[&h, &b, &x](heap: &!h Heap, out: buffer.Buffer, status: int, body: &b [byte], keep: bool, extra: &x [byte]) -> [heap] buffer.Buffer {
    return reply_as(heap, out, status, "application/json", body, keep, extra);
}

// A whole response of any content type -- `application/problem+json`,
// `text/plain` -- with extra header lines (`Location: /users/7\r\n`) in the head.
pub fn reply_as[&h, &c, &b, &x](heap: &!h Heap, out: buffer.Buffer, status: int, content_type: &c [byte], body: &b [byte], keep: bool, extra: &x [byte]) -> [heap] buffer.Buffer {
    let head = http.respond_head_with(heap, out, status, content_type, len(body), keep, extra);
    return buffer.append(heap, head, body);
}

// A response with no body: `204 No Content` or `304 Not Modified`, which carry
// no `Content-Length` and no `Content-Type` (`std.http.respond_no_content`).
pub fn reply_empty[&h, &x](heap: &!h Heap, out: buffer.Buffer, status: int, keep: bool, extra: &x [byte]) -> [heap] buffer.Buffer {
    return http.respond_no_content(heap, out, status, keep, extra);
}

// `{"error": message}`.
pub fn failure[&h, &m](heap: &!h Heap, out: buffer.Buffer, status: int, message: &m [byte], keep: bool) -> [heap] buffer.Buffer {
    return failure_with(heap, out, status, message, keep, "");
}

// `failure`, with extra header lines (`Allow: GET\r\n`) in the head.
pub fn failure_with[&h, &m, &x](heap: &!h Heap, out: buffer.Buffer, status: int, message: &m [byte], keep: bool, extra: &x [byte]) -> [heap] buffer.Buffer {
    var w = json.writer(heap, 64);
    w = json.begin_object(heap, w);
    w = json.put_key(heap, w, "error");
    w = json.put_string(heap, w, message);
    w = json.end_object(heap, w);
    let body = json.finish(w);
    var answer = out;
    borrow body as &bb in {
        answer = reply_with(heap, answer, status, buffer.bytes(bb), keep, extra);
    }
    buffer.drop(heap, body);
    return answer;
}

// ---------------------------------------------------------------------
// One connection's bytes
// ---------------------------------------------------------------------

// How many of `wanted` bytes one write is handed: all of them, or `chunk` of
// them if there is a limit (`chunk` of 0 means none).
fn quantum(wanted: int, chunk: int) -> [] int {
    if chunk > 0 && wanted > chunk {
        return chunk;
    }
    return wanted;
}

// Hand `data` to the kernel without waiting for room, and keep what it did not
// take.
//
// `pend[0..pending]` is what this connection already has waiting. If there is
// none, the answer is offered to the connection straight away -- the common
// case, and the whole of the fast path; if there is some, the new bytes must
// queue behind it or the answers would arrive out of order. Whatever was not
// sent is appended to `pend`. Answers the new `pending`, or -1 if the queue
// cannot hold it, which is a client that is not reading and has asked for more
// than the buffer -- or a connection that has failed: the caller closes it.
//
// A connection that takes nothing (`Again`) is the kernel being full, which is
// the one case this queue exists for.
//
// A byte-fed server (`fed` is 1) has no kernel to offer the answer to: it all goes
// into `pend`, which is what `output` drains, and an answer that does not fit is
// refused by the same -1 (`http-server.md` §11).
fn emit[&c, &d, &e](table: &!c conns.Table, fed: int, slot: int, chunk: int, data: &d [byte], pend: &!e [byte], pending: int) -> [conn_write] int {
    var at = 0;
    if pending == 0 && fed == 0 {
        match conns.write(table, slot, data[0..quantum(len(data), chunk)]) {
            Sent::Wrote(n) => {
                at = n;
            }
            Sent::Again => {
            }
            Sent::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    if at >= len(data) {
        return pending;
    }
    if pending + len(data) - at > len(pend) {
        return 0 - 1;
    }
    var i = at;
    while i < len(data) {
        pend[pending + i - at] = data[i];
        i = i + 1;
    }
    return pending + len(data) - at;
}

// Close connection `k` and give its slot back.
fn shut[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    if core.fed == 1 {
        // The application owns the socket: this connection has ended, and what it has to do
        // is send close_notify, close, and `detach` (which frees the slot). Whatever was
        // still waiting to be sent is dropped, as a closed socket would have dropped it.
        st[stride() * k + 2] = 0;
        st[stride() * k + 4] = 2;
        st[stride() * k + 12] = 0;
        st[stride() * k + 13] = 0;
        return 0;
    }
    conns.close(tab, k);
    st[stride() * k + 4] = 0;
    st[stride() * k + 12] = 0;
    st[stride() * k + 13] = 0;
    return 0;
}

// Watch `k` for what it now waits on: room to write if output is queued (and
// read no more), input otherwise.
fn settle[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    if core.fed == 1 {
        return 0;
    }
    let st = contents(core.state);
    let p = stride() * k;
    var want = 1;
    if st[p + 2] > 0 {
        want = 2;
    } else if st[p + 13] == 1 && readable(core, k) == 0 {
        // A held request and a full buffer behind it: nothing to read into, so nothing
        // to be woken for -- except the peer going away, which the poller reports anyway.
        want = 0;
    }
    if want != st[p + 5] {
        conns.rewatch(tab, core.poller, k, k + 1, want);
        st[p + 5] = want;
    }
    return 0;
}

// One step of I/O on connection `k`, which the poller said was ready: send
// what is waiting if anything is, otherwise read. Answers 1 if there is input
// to answer now, 2 if the connection is to close, 0 if nothing more can be done
// until the next wakeup.
fn step[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int, now: int) -> [conn_read, conn_write] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let size = core.size;
    let p = stride() * k;
    let base = k * size;
    let obase = k * core.osize;
    var code = 0;
    if st[p + 2] > 0 {
        // Waiting to send: the kernel can take more.
        match conns.write(tab, k, pd[obase..obase + quantum(st[p + 2], core.chunk)]) {
            Sent::Wrote(sent) => {
                st[p + 1] = now;
                var at = 0;
                while at < st[p + 2] - sent {
                    pd[obase + at] = pd[obase + sent + at];
                    at = at + 1;
                }
                st[p + 2] = st[p + 2] - sent;
                if st[p + 2] == 0 {
                    if st[p + 3] == 1 {
                        code = 2;
                    } else if st[p] > 0 {
                        // Held back while the last answer was being sent.
                        code = 1;
                    }
                }
            }
            Sent::Again => {
            }
            Sent::Failed(e) => {
                code = 2;
            }
        }
    } else if st[p + 25] != 0 {
        // A refusal is recorded: nothing is read, and the next `next` sends it.
    } else if readable(core, k) == 0 {
        // No room to read into. Only a held request can leave the buffer full (anything
        // else is refused first), and `settle` then asks to be woken for nothing: what
        // wakes it is the peer hanging up.
        code = 2;
    } else {
        // As much as `readable` allows: not past the end of a length body (§12.4).
        let room = readable(core, k);
        if room > size - st[p] {
            reclaim(core, k);
        }
        match conns.read(tab, k, bf[base + st[p]..base + st[p] + room]) {
            Received::Data(got) => {
                st[p] = st[p] + got;
                st[p + 1] = now;
                ingest(core, k, st[p] - got);
                code = 1;
            }
            Received::End => {
                code = 2;
            }
            Received::Again => {
            }
            Received::Failed(e) => {
                code = 2;
            }
        }
    }
    return code;
}

// Parse the next request at the front of connection `k`'s input, if there is
// a whole one, and leave it in hand for the application: `state[7..11]` says
// where its head ends and what its body is, `parsed` is its parse table.
//
// Answers 1 for a request in hand, 0 for none. A request that cannot be served
// -- one the parser refuses, or one that could never fit the buffer -- is
// refused here with the status that says why, and the connection closes once
// that has been sent: after a malformed request there is no saying where the
// next one starts.
//
// Nothing is taken from a connection that has output waiting (back-pressure:
// no more requests from a connection that is not taking its answers) or that is
// ending, and a body that has not all arrived is waited for.
fn produce[&h, &t, &c](heap: &!h Heap, tab: &!t conns.Table, core: &!c Core, k: int) -> [heap, conn_write] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 25] != 0 {
        return reject(heap, tab, core, k);
    }
    if st[p + 2] != 0 || st[p + 3] != 0 || st[p + 13] == 1 {
        return 0;
    }
    let size = core.size;
    let base = k * size;
    let data = contents(core.bufs)[base..base + size];
    let scratch = contents(core.decoded);
    let table = contents(core.parsed);
    let filled = st[p];
    let used = st[p + 6];
    if used >= filled {
        return 0;
    }
    if st[p + 16] != 0 {
        // A streaming request is still in hand (`next` was called again without `hold` or `respond`).
        return 1;
    }
    let view = data[used..filled];
    let n = http.parse(view, table);
    // What to refuse with, or 0 to carry on.
    var refuse = 0;
    var message = "bad request";
    var tag = "head.malformed";
    var ready = 0;
    if n < 0 {
        if http.is_incomplete(n) {
            // Nothing wrong yet -- unless there is no room for the rest.
            if used == 0 && filled >= size {
                refuse = 431;
                message = "request head too large";
                tag = "head.too-large";
            } else if core.lim == 1 && st[p + 26] == 0 {
                st[p + 26] = core.now + 1;
            }
        } else {
            refuse = 400;
            message = http.error_message(http.error_code(n));
        }
    } else if core.lim == 1 {
        // §12.3: what a head with a body is.
        st[p + 26] = 0;
        let c = classify(core, k, n, view);
        if c > 0 {
            ready = 1;
        } else {
            refuse = rule_status(0 - c);
            message = rule_message(0 - c);
            tag = rule_tag(0 - c);
        }
    } else if http.is_chunked(table) {
        let (took, decoded) = http.dechunk(view[n..filled], scratch);
        if http.dechunk_incomplete(took) {
            // The body is still arriving -- unless it could never fit.
            if used == 0 && filled >= size {
                refuse = 413;
                message = "request too large";
                tag = "request.too-large";
            }
        } else if took < 0 {
            refuse = 400;
            if took == 0 - 4 {
                refuse = 413;
                tag = "request.too-large";
            }
            message = http.dechunk_message(took);
        } else {
            st[p + 7] = n;
            st[p + 8] = took;
            st[p + 9] = decoded;
            st[p + 10] = 1;
            ready = 1;
        }
    } else {
        let length = http.content_length(table);
        var body_length = 0;
        if length > 0 {
            body_length = length;
        }
        if n + body_length > size {
            refuse = 413;
            message = "request too large";
            tag = "request.too-large";
        } else if used + n + body_length <= filled {
            st[p + 7] = n;
            st[p + 8] = body_length;
            st[p + 9] = body_length;
            st[p + 10] = 0;
            ready = 1;
        }
        // Otherwise the body is still arriving.
    }
    if refuse != 0 {
        refuse_with(heap, tab, core, k, refuse, message, tag);
        return 0;
    }
    return ready;
}

// Connection `k` has no more requests to give this round: move what is left of
// its input (the start of a request still arriving, or requests held back) to
// the front, then close it or set what it is watched for.
fn finish[&t, &c](tab: &!t conns.Table, core: &!c Core, k: int) -> [poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let p = stride() * k;
    let base = k * core.size;
    st[p + 12] = 0;
    if st[p + 11] == 1 {
        shut(tab, core, k);
        return 0;
    }
    let used = st[p + 6];
    if used > 0 {
        var at = 0;
        while at < st[p] - used {
            bf[base + at] = bf[base + used + at];
            at = at + 1;
        }
        st[p] = st[p] - used;
        st[p + 6] = 0;
        if st[p + 16] != 0 {
            st[p + 21] = st[p + 21] - used;
        }
    }
    if st[p + 3] == 1 && st[p + 2] == 0 {
        shut(tab, core, k);
    } else {
        settle(tab, core, k);
    }
    return 0;
}

// The next connection with a request in hand, or -1.
fn advance[&h, &t, &c](heap: &!h Heap, tab: &!t conns.Table, core: &!c Core) -> [heap, conn_write, poll] int {
    let st = contents(core.state);
    let queue = contents(core.ready);
    var found = 0 - 1;
    var going = true;
    while going {
        if core.cur >= 0 {
            if produce(heap, tab, core, core.cur) == 1 {
                found = core.cur;
                going = false;
            } else {
                // No request is left to give. If the peer will send no more (`end_input`) and
                // nothing is held or waiting to be sent, nothing ever will be: it ends once
                // what was answered has gone (a partial request is dropped, as the end of a
                // socket's input drops it).
                let q = stride() * core.cur;
                if st[q + 15] == 1 && st[q + 2] == 0 && st[q + 13] == 0 {
                    st[q + 3] = 1;
                }
                finish(tab, core, core.cur);
                core.cur = 0 - 1;
            }
        } else if core.cursor >= core.nready {
            going = false;
        } else {
            let k = queue[core.cursor];
            core.cursor = core.cursor + 1;
            // It may have been closed since it was queued.
            if st[stride() * k + 4] == 1 {
                core.cur = k;
                st[stride() * k + 6] = 0;
            }
        }
    }
    return found;
}

// A connection takes slot `slot`: what `accept_all` and `attach` both set.
fn init_slot[&c](core: &!c Core, slot: int, now: int) -> [] int {
    let st = contents(core.state);
    let p = stride() * slot;
    st[p] = 0;
    st[p + 1] = now;
    st[p + 2] = 0;
    st[p + 3] = 0;
    st[p + 4] = 1;
    st[p + 5] = 1;
    st[p + 6] = 0;
    st[p + 11] = 0;
    st[p + 12] = 0;
    st[p + 13] = 0;
    st[p + 14] = st[p + 14] + 1;
    st[p + 15] = 0;
    clear_body(core, slot);
    return 0;
}

// Queue connection `k` for `next`, once. The queue holds `limit` entries and a connection
// that was visited and has input again is queued a second time before the round's
// compaction, so a full queue is compacted first, as `answer` always did.
fn enqueue[&c](core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 12] == 1 {
        return 0;
    }
    let queue = contents(core.ready);
    if core.nready >= core.limit {
        var left = 0;
        while core.cursor + left < core.nready {
            queue[left] = queue[core.cursor + left];
            left = left + 1;
        }
        core.nready = left;
        core.cursor = 0;
        if left >= core.limit {
            // Still full: a connection is queued twice (`hold` or `answer` ended its visit outside `next`, so the flag
            // was cleared with its entry still waiting). Keep one entry each, and none for a slot not in use.
            var i = 0;
            while i < left {
                st[stride() * queue[i] + 12] = 0;
                i = i + 1;
            }
            var kept = 0;
            i = 0;
            while i < left {
                let q = stride() * queue[i];
                if st[q + 12] == 0 && st[q + 4] == 1 {
                    st[q + 12] = 1;
                    queue[kept] = queue[i];
                    kept = kept + 1;
                }
                i = i + 1;
            }
            core.nready = kept;
        }
        if st[p + 12] == 1 {
            return 0;
        }
    }
    st[p + 12] = 1;
    queue[core.nready] = k;
    core.nready = core.nready + 1;
    return 0;
}

// Take every connection waiting on the listener, up to the limit: each goes
// in the table, is made non-blocking, and is watched for input under the token
// `slot + 1` (the listener is token 0).
fn accept_all[&h, &l, &c](heap: &!h Heap, conn: conns.Table, listener: &!l Listener, core: &!c Core, now: int) -> [heap, conn_accept, poll] conns.Table {
    var table = conn;
    var more = true;
    while more {
        match tcp_accept(listener) {
            Accepted::Ok(c) => {
                var held = 0;
                borrow table as &tt in {
                    held = conns.live(tt);
                }
                if held >= core.limit {
                    conn_close(c);
                } else {
                    let (grown, slot) = conns.put(heap, table, c);
                    table = grown;
                    if slot >= 0 {
                        init_slot(core, slot, now);
                        borrow mut table as &!ct in {
                            if conns.nonblocking(ct, slot) != 0 || conns.watch(ct, core.poller, slot, slot + 1, 1) != 0 {
                                shut(ct, core, slot);
                            }
                        }
                    }
                }
            }
            Accepted::Again => {
                more = false;
            }
            Accepted::Failed(e) => {
                more = false;
            }
        }
    }
    return table;
}

// What the poller woke for, and the idle sweep: step every connection that
// woke, queue the ones with input, and once a second close the ones that have
// gone quiet.
fn serve_events[&t, &c](tab: &!t conns.Table, core: &!c Core, ready: int, now: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let ev = contents(core.events);
    let outside = contents(core.foreign);
    var j = 0;
    while j < ready {
        let token = ev[2 * j];
        let k = token - 1;
        if token > core.limit {
            // The application's own handle (`first_token`): not a connection of ours, and
            // `state` has no slot for it.
            if 2 * core.nforeign + 1 < len(outside) {
                outside[2 * core.nforeign] = token;
                outside[2 * core.nforeign + 1] = ev[2 * j + 1];
                core.nforeign = core.nforeign + 1;
            }
        } else if token > 0 && st[stride() * k + 4] == 1 {
            let code = step(tab, core, k, now);
            if code == 2 {
                shut(tab, core, k);
            } else if code == 1 {
                enqueue(core, k);
            } else {
                settle(tab, core, k);
            }
        }
        j = j + 1;
    }
    sweep_idle(tab, core, now);
    sweep_timers(tab, core);
    return 0;
}

// Once a second: close the connections that have gone quiet. A held request is waiting
// on the application, which is not the client's fault, so it is spared -- unless there is
// output waiting that has not moved: that is a client (or a transport) that is not
// reading, held or not. (A socket server never holds with output waiting, so for it the
// exception changes nothing.)
fn sweep_idle[&t, &c](tab: &!t conns.Table, core: &!c Core, now: int) -> [] int {
    let st = contents(core.state);
    if now != core.last_sweep {
        core.last_sweep = now;
        var count = core.limit;
        if core.fed == 0 {
            count = conns.slots(tab);
        }
        var s = 0;
        while s < count {
            let p = stride() * s;
            if st[p + 4] == 1 && (st[p + 13] == 0 || st[p + 2] > 0) && now - st[p + 1] > core.idle {
                shut(tab, core, s);
            }
            s = s + 1;
        }
    }
    return 0;
}

// ---------------------------------------------------------------------
// Streaming bodies (`http-server.md` §12)
// ---------------------------------------------------------------------

// Flags, word 24 of a slot.
fn f_keep() -> [] int { return 1; }

fn f_expect() -> [] int { return 2; }

fn f_started() -> [] int { return 4; }

fn f_done() -> [] int { return 8; }

fn f_touched() -> [] int { return 16; }

fn has(flags: int, bit: int) -> [] bool {
    return flags / bit % 2 == 1;
}

fn set_flag[&s](st: &!s [int], p: int, bit: int) -> [] int {
    if !has(st[p + 24], bit) { st[p + 24] = st[p + 24] + bit; }
    return 0;
}

fn clear_flag[&s](st: &!s [int], p: int, bit: int) -> [] int {
    if has(st[p + 24], bit) { st[p + 24] = st[p + 24] - bit; }
    return 0;
}

// A slot has no request streaming: words 16 to 29 are 0.
fn clear_body[&c](core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    var i = 16;
    while i < stride() { st[stride() * k + i] = 0; i = i + 1; }
    return 0;
}

// What a refusal is, by code: the status, the message the client reads, the rule tag it is sent in `X-Rule`
// (§12.4). 1 to 10 are the streaming ones; 11 to 13 the three the socket and byte-fed servers always had.
fn rule_status(code: int) -> [] int {
    if code == 1 { return 413; }
    if code == 6 || code == 11 { return 431; }
    if code == 7 || code == 8 { return 408; }
    if code == 9 { return 417; }
    if code == 13 { return 413; }
    return 400;
}

fn rule_message(code: int) -> [] &static [byte] {
    if code == 1 { return "request body too large"; }
    if code == 2 { return "bad chunk size"; }
    if code == 3 { return "bad chunk framing"; }
    if code == 4 { return "bad chunk extension"; }
    if code == 5 { return "bad chunk trailer"; }
    if code == 6 { return "chunk trailers too large"; }
    if code == 7 { return "request head timeout"; }
    if code == 8 { return "request body timeout"; }
    if code == 9 { return "expectation failed"; }
    if code == 11 { return "request head too large"; }
    if code == 13 { return "request too large"; }
    return "bad request";
}

fn rule_tag(code: int) -> [] &static [byte] {
    if code == 1 { return "body.too-large"; }
    if code == 2 { return "body.chunk-size"; }
    if code == 3 { return "body.chunk-framing"; }
    if code == 4 { return "body.chunk-extension"; }
    if code == 5 { return "body.trailer"; }
    if code == 6 { return "body.trailer-too-large"; }
    if code == 7 { return "timeout.head"; }
    if code == 8 { return "timeout.body"; }
    if code == 9 { return "expect.unsupported"; }
    if code == 11 { return "head.too-large"; }
    if code == 13 { return "request.too-large"; }
    return "head.malformed";
}

// How many bytes connection `k` may read now: the free room in its buffer, and while a length body is
// arriving no more than it still owes, so the bytes after it are never mixed into it. 0 once a refusal is
// recorded. (It does not look at output waiting or at a closing connection: its callers do.)
fn readable[&c](core: &c Core, k: int) -> [] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 25] != 0 { return 0; }
    var free = core.size - st[p];
    if st[p + 16] != 0 && !has(st[p + 24], f_done()) {
        // The bytes the application has taken are room again (`reclaim`).
        free = free + st[p + 21];
        if st[p + 16] == 1 && st[p + 17] < free { return st[p + 17]; }
    }
    return free;
}

fn hexv(c: int) -> [] int {
    if c >= 48 && c <= 57 { return c - 48; }
    if c >= 97 && c <= 102 { return c - 87; }
    if c >= 65 && c <= 70 { return c - 55; }
    return 0 - 1;
}

fn tchar(c: int) -> [] bool {
    return c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126;
}

fn eq_ci[&a, &l](a: &a [byte], lit: &l [byte]) -> [] bool {
    if len(a) != len(lit) { return false; }
    var i = 0;
    while i < len(a) {
        if bytes.to_lower(int_of(a[i])) != int_of(lit[i]) { return false; }
        i = i + 1;
    }
    return true;
}

// The chunk machine's step for one byte that is not chunk data (§12.4). The states, in word 18:
//     0 start of a size line, 1 in its digits, 2 in an extension, 3 after the CR of the size line,
//     4 data (run by `chunk_run`), 5 after data, 6 after the CR that follows data,
//     7 start of a trailer line (or the final CR), 8 in a trailer name, 9 in its value, 10 after its CR,
//     11 after the final CR, 12 the end.
// Answers 0, or the code of the refusal (`rule_*`).
fn chunk_step[&s](st: &!s [int], p: int, c: int, maxb: int) -> [] int {
    let cs = st[p + 18];
    if cs >= 7 && cs <= 10 {
        st[p + 29] = st[p + 29] + 1;
        if st[p + 29] > 4096 { return 6; }
    }
    if cs == 0 || cs == 1 {
        let v = hexv(c);
        if v >= 0 {
            if st[p + 20] >= 8 { return 2; }
            st[p + 19] = st[p + 19] * 16 + v;
            st[p + 20] = st[p + 20] + 1;
            st[p + 18] = 1;
            return 0;
        }
        if cs == 0 { return 2; }
        if c == 59 {
            st[p + 18] = 2;
            st[p + 20] = 0;
            return 0;
        }
        if c == 13 { st[p + 18] = 3; return 0; }
        return 3;
    }
    if cs == 2 {
        if c == 13 { st[p + 18] = 3; return 0; }
        st[p + 20] = st[p + 20] + 1;
        if c < 32 && c != 9 || c == 127 || st[p + 20] > 256 { return 4; }
        return 0;
    }
    if cs == 3 {
        if c != 10 { return 3; }
        if st[p + 19] == 0 { st[p + 18] = 7; return 0; }
        if st[p + 23] + st[p + 19] > maxb { return 1; }
        st[p + 18] = 4;
        return 0;
    }
    if cs == 5 {
        if c != 13 { return 3; }
        st[p + 18] = 6;
        return 0;
    }
    if cs == 6 {
        if c != 10 { return 3; }
        st[p + 18] = 0;
        st[p + 19] = 0;
        st[p + 20] = 0;
        return 0;
    }
    if cs == 7 {
        if c == 13 { st[p + 18] = 11; return 0; }
        if !tchar(c) { return 5; }
        st[p + 18] = 8;
        return 0;
    }
    if cs == 8 {
        if c == 58 { st[p + 18] = 9; return 0; }
        if !tchar(c) { return 5; }
        return 0;
    }
    if cs == 9 {
        if c == 13 { st[p + 18] = 10; return 0; }
        if c < 32 && c != 9 || c == 127 { return 5; }
        return 0;
    }
    if cs == 10 {
        if c != 10 { return 5; }
        st[p + 18] = 7;
        return 0;
    }
    if cs == 11 {
        if c != 10 { return 5; }
        st[p + 18] = 12;
        return 0;
    }
    return 3;
}

// Run the chunk machine over connection `k`'s buffer from `from` to the bytes it holds, in place: what is
// data is moved down over the framing that carried it (the write position never passes the read position), so
// the buffer holds the decoded bytes the application has not taken and, once the final CRLF is read, the bytes
// that follow the body, moved down to meet them. The machine's state is in the slot's words, so a byte is
// looked at once however the body is split. A refusal is recorded in word 25.
fn chunk_run[&c](core: &!c Core, k: int, from: int) -> [] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let p = stride() * k;
    let base = k * core.size;
    let end = st[p];
    var r = from;
    var w = st[p + 21] + st[p + 22];
    var code = 0;
    while r < end && st[p + 18] != 12 && code == 0 {
        if st[p + 18] == 4 {
            var m = end - r;
            if m > st[p + 19] { m = st[p + 19]; }
            var i = 0;
            while i < m { bf[base + w + i] = bf[base + r + i]; i = i + 1; }
            r = r + m;
            w = w + m;
            st[p + 19] = st[p + 19] - m;
            st[p + 23] = st[p + 23] + m;
            if st[p + 19] == 0 { st[p + 18] = 5; }
        } else {
            code = chunk_step(st, p, int_of(bf[base + r]), core.maxb);
            r = r + 1;
        }
    }
    st[p + 22] = w - st[p + 21];
    if code != 0 {
        st[p + 25] = code;
        st[p] = w;
        return code;
    }
    if st[p + 18] == 12 {
        set_flag(st, p, f_done());
        var i = 0;
        while r + i < end { bf[base + w + i] = bf[base + r + i]; i = i + 1; }
        st[p] = w + end - r;
    } else {
        st[p] = w;
    }
    return 0;
}

// Until a body is whole the buffer holds nothing but its bytes: give the room the application's `body_take` freed back
// by moving what is left to the front. Called before bytes are read in; answers how many are buffered.
fn reclaim[&c](core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 16] != 0 && !has(st[p + 24], f_done()) && st[p + 21] > 0 {
        let bf = contents(core.bufs);
        let base = k * core.size;
        var i = 0;
        while i < st[p] - st[p + 21] {
            bf[base + i] = bf[base + st[p + 21] + i];
            i = i + 1;
        }
        st[p] = st[p] - st[p + 21];
        st[p + 21] = 0;
    }
    return st[p];
}

// Bytes `from` to the end of what connection `k` holds have just arrived (`step`, `input`): if a body is
// streaming they are its, and are counted (and, if chunked, decoded). A refusal is recorded, not sent.
fn ingest[&c](core: &!c Core, k: int, from: int) -> [] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 16] == 0 || has(st[p + 24], f_done()) || st[p + 25] != 0 { return 0; }
    st[p + 27] = core.now;
    set_flag(st, p, f_touched());
    if st[p + 16] == 2 {
        chunk_run(core, k, from);
        if st[p + 25] != 0 { enqueue(core, k); }
        return 0;
    }
    let got = st[p] - from;
    st[p + 17] = st[p + 17] - got;
    st[p + 22] = st[p + 22] + got;
    st[p + 23] = st[p + 23] + got;
    if st[p + 17] <= 0 { set_flag(st, p, f_done()); }
    return 0;
}

// What a head that has a body is, in a server with `limits`: 1 if the request is whole (its body is in the buffer,
// and `state[7..11]` is set as for any request), 2 if the body is still arriving (the head is handed over, `streaming`
// is true), or `0 - code` for a refusal. `n` is the head's length, `view` the buffer from the request's start.
fn classify[&c, &v](core: &!c Core, k: int, n: int, view: &v [byte]) -> [] int {
    let st = contents(core.state);
    let table = contents(core.parsed);
    let p = stride() * k;
    let used = st[p + 6];
    var expect = 0;
    var i = 0;
    while i < http.header_count(table) {
        if eq_ci(http.header_name(view, table, i), "expect") {
            if eq_ci(http.header_value(view, table, i), "100-continue") { expect = 1; } else {
                return 0 - 9;
            }
        }
        i = i + 1;
    }
    let chunked = http.is_chunked(table);
    var blen = 0;
    if http.content_length(table) > 0 { blen = http.content_length(table); }
    if !chunked && blen == 0 {
        // No body: the head is the whole request.
        st[p + 7] = n;
        st[p + 8] = 0;
        st[p + 9] = 0;
        st[p + 10] = 0;
        return 1;
    }
    if !chunked && blen > core.maxb { return 0 - 1; }
    let have = st[p] - used - n;
    st[p + 21] = used + n;
    st[p + 22] = 0;
    st[p + 23] = 0;
    if http.keeps_alive(table) { set_flag(st, p, f_keep()); }
    if !chunked {
        var got = have;
        if got > blen { got = blen; }
        st[p + 16] = 1;
        st[p + 17] = blen - got;
        st[p + 22] = got;
        st[p + 23] = got;
        if got == blen { set_flag(st, p, f_done()); }
    } else {
        st[p + 16] = 2;
        chunk_run(core, k, used + n);
        if st[p + 25] != 0 {
            let code = st[p + 25];
            clear_body(core, k);
            return 0 - code;
        }
    }
    st[p + 7] = n;
    st[p + 9] = st[p + 22];
    st[p + 10] = 0;
    if has(st[p + 24], f_done()) { return 1; }
    st[p + 9] = 0;
    if expect == 1 && http.version(table) == 11 { set_flag(st, p, f_expect()); }
    if have > 0 { set_flag(st, p, f_touched()); }
    st[p + 27] = core.now;
    return 2;
}

// Answer connection `k` with a refusal and end it once that has gone: `message` is what the client reads, `tag`
// the rule (in `X-Rule`, for a server with `limits`).
fn refuse_with[&h, &t, &c, &m, &g](heap: &!h Heap, tab: &!t conns.Table, core: &!c Core, k: int, status: int, message: &m [byte], tag: &g [byte]) -> [heap, conn_write] int {
    let st = contents(core.state);
    let p = stride() * k;
    let pd = contents(core.pends);
    var o = buffer.empty(heap, 256);
    if core.lim == 1 {
        var x = buffer.append(heap, buffer.empty(heap, 48), "X-Rule: ");
        x = buffer.append(heap, x, tag);
        x = buffer.append(heap, x, "\r\n");
        borrow x as &xb in {
            o = failure_with(heap, o, status, message, false, buffer.bytes(xb));
        }
        buffer.drop(heap, x);
    } else {
        o = failure(heap, o, status, message, false);
    }
    borrow o as &ob in {
        st[p + 2] = emit(tab, core.fed, k, core.chunk, buffer.bytes(ob), pd[k * core.osize..(k + 1) * core.osize], st[p + 2]);
    }
    buffer.drop(heap, o);
    if st[p + 2] < 0 { st[p + 11] = 1; }
    st[p + 3] = 1;
    return 0;
}

// A refusal was recorded for connection `k` while no heap was at hand (`ingest`, the timers, `end_input`): its
// request is over. Answer it, unless the application's answer has begun (or the peer is gone), and end the connection.
fn reject[&h, &t, &c](heap: &!h Heap, tab: &!t conns.Table, core: &!c Core, k: int) -> [heap, conn_write] int {
    let st = contents(core.state);
    let p = stride() * k;
    let code = st[p + 25];
    let begun = has(st[p + 24], f_started());
    st[p + 13] = 0;
    clear_body(core, k);
    if code == 10 || begun || st[p + 2] < 0 || st[p + 3] == 1 {
        // Nothing can be said (or the connection is ending with its answer): end it, but not over an answer on its way.
        if st[p + 3] == 0 { st[p + 11] = 1; }
        return 0;
    }
    return refuse_with(heap, tab, core, k, rule_status(code), rule_message(code), rule_tag(code));
}

// A held request is over, answered or not (`deliver_to`): where the next request starts, and whether the
// connection goes on (§12.9).
fn end_request[&c](core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    let p = stride() * k;
    let flags = st[p + 24];
    if !has(flags, f_keep()) { st[p + 3] = 1; }
    if has(flags, f_done()) { st[p + 6] = st[p + 21] + st[p + 22]; } else if has(flags, f_expect()) && !has(flags, f_touched()) {
        st[p + 6] = st[p + 6] + st[p + 7];
    } else {
        st[p + 3] = 1;
    }
    clear_body(core, k);
    return 0;
}

// `hold` of a request in a server with `limits`: the head is let go (the application has read what it wants of it)
// and a request whose body is already whole becomes one that has all arrived, so `body_part` serves both.
fn release_head[&c](core: &!c Core, k: int) -> [] int {
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 16] == 0 {
        st[p + 16] = 1;
        st[p + 21] = st[p + 6] + st[p + 7];
        set_flag(st, p, f_done());
        if http.keeps_alive(contents(core.parsed)) { set_flag(st, p, f_keep()); }
    }
    st[p + 6] = st[p + 6] + st[p + 7];
    st[p + 7] = 0;
    return 0;
}

// Record `code` as connection `s`'s refusal, for the next `next` to send.
fn record[&c](core: &!c Core, s: int, code: int) -> [] int {
    contents(core.state)[stride() * s + 25] = code;
    enqueue(core, s);
    return 0;
}

// The two timers (§12.8), at most every 50 ms: a head that has taken `head_ms` since it was first seen
// incomplete, and a body the client has not added to for `body_ms` while the server has room to take it.
fn sweep_timers[&t, &c](tab: &!t conns.Table, core: &!c Core) -> [] int {
    if core.lim == 0 || core.now - core.last_tick < 50 { return 0; }
    core.last_tick = core.now;
    let st = contents(core.state);
    var count = core.limit;
    if core.fed == 0 { count = conns.slots(tab); }
    var s = 0;
    while s < count {
        let p = stride() * s;
        if st[p + 4] == 1 && st[p + 25] == 0 && st[p + 3] == 0 && st[p + 2] == 0 {
            if st[p + 16] != 0 {
                if !has(st[p + 24], f_done()) && !has(st[p + 24], f_expect()) && readable(core, s) > 0 && core.now - st[p + 27] > core.body_ms {
                    record(core, s, 8);
                }
            } else if st[p + 26] > 0 && st[p + 13] == 0 && core.now + 1 - st[p + 26] > core.head_ms {
                record(core, s, 7);
            }
        }
        s = s + 1;
    }
    return 0;
}

// ---------------------------------------------------------------------
// The interface
// ---------------------------------------------------------------------

// A server for connections on `listener` (already listening and non-blocking),
// waited on through `poller`, which it owns from now on. `size` is each
// connection's input buffer -- a request, head and body together, must fit in
// it -- and the number of connections that fit shrinks with it so the buffers
// together never pass 256 MiB. `chunk` is a limit on how many bytes one write
// is handed (0: none), and `idle` how many seconds a connection may go without
// progress -- a byte read, a byte sent -- before it is closed.
pub fn open[&h, &l](heap: &!h Heap, poller: Poller, listener: &!l Listener, size: int, chunk: int, idle: int) -> [heap] Server {
    let limit = connection_limit(size);
    var p = poller;
    borrow mut p as &!pw in {
        poller_add_listener(pw, listener, 0);
    }
    let core = Core { poller: p, events: box_slice(heap, 128, 0), state: box_slice(heap, stride() * limit, 0), bufs: box_slice(heap, limit * size, byte_of(0)), pends: box_slice(heap, limit * output_size(), byte_of(0)), parsed: box_slice(heap, http.slots(64), 0), decoded: box_slice(heap, size, byte_of(0)), ready: box_slice(heap, limit, 0), limit: limit, size: size, chunk: chunk, idle: idle, nready: 0, cursor: 0, cur: 0 - 1, last_sweep: 0, foreign: box_slice(heap, 128, 0), nforeign: 0, fed: 0, osize: output_size(), nlive: 0, scan: 0, lim: 0, maxb: 0, piece: 0, head_ms: 0, body_ms: 0, now: 0, last_tick: 0 - 50 };
    return Server { tab: conns.empty(heap, 64), core: core };
}

// End the server: every connection still open is closed, the poller ended and
// the buffers freed.
pub fn close[&h](heap: &!h Heap, srv: Server) -> [heap] int {
    let Server { tab, core } = srv;
    conns.drop(heap, tab);
    let Core { poller, events, state, bufs, pends, parsed, decoded, ready, limit, size, chunk, idle, nready, cursor, cur, last_sweep, foreign, nforeign, fed, osize, nlive, scan, lim, maxb, piece, head_ms, body_ms, now, last_tick } = core;
    poller_close(poller);
    unbox_slice(heap, events);
    unbox_slice(heap, state);
    unbox_slice(heap, bufs);
    unbox_slice(heap, pends);
    unbox_slice(heap, parsed);
    unbox_slice(heap, decoded);
    unbox_slice(heap, ready);
    unbox_slice(heap, foreign);
    return 0;
}

// How many connections are open.
pub fn connections[&s](srv: &s Server) -> [] int {
    if srv.core.fed == 1 {
        return srv.core.nlive;
    }
    return conns.live(srv.tab);
}

// What the start of a round does, for `wait` and `ready`: what `next` did not reach goes
// to the front of the queue, and the connection it was part-way through is finished -- and,
// if requests are still buffered behind the one answered (or the peer has ended and there
// is an ending to see to), queued again: no input will arrive to wake it for them. Answers
// how many connections are queued.
fn begin_round[&t, &c](tab: &!t conns.Table, core: &!c Core) -> [poll] int {
    let st = contents(core.state);
    let queue = contents(core.ready);
    core.nforeign = 0;
    var left = 0;
    while core.cursor + left < core.nready {
        queue[left] = queue[core.cursor + left];
        left = left + 1;
    }
    core.nready = left;
    core.cursor = 0;
    let half = core.cur;
    if half >= 0 {
        core.cur = 0 - 1;
        finish(tab, core, half);
        let p = stride() * half;
        if st[p + 4] == 1 && (st[p] > 0 || st[p + 15] == 1) && st[p + 2] == 0 && st[p + 3] == 0 {
            enqueue(core, half);
        }
    }
    return core.nready;
}

// Wait for the network, at most `timeout_ms`, and do the I/O that is ready:
// take new connections, read, send what was waiting, close the ones that have
// gone quiet. Connections that now hold input are queued for `next`.
//
// By value, because accepting replaces the connection table.
//
// `next` must be called until it answers -1 before the next `wait`. If it was
// not, the connection it was part-way through is finished and the ones it had
// not reached stay queued, and the wait does not block.
pub fn wait[&h, &k, &l](heap: &!h Heap, srv: Server, clock: &k Clock, listener: &!l Listener, timeout_ms: int) -> [heap, conn_accept, conn_read, conn_write, poll, clock] Server {
    let Server { tab, core } = srv;
    var table = tab;
    var state = core;
    var timeout = timeout_ms;
    // A byte-fed server has no listener to accept on and nothing to wait for: `ready`.
    var fed = 0;
    borrow state as &cr in {
        fed = cr.fed;
    }
    if fed == 1 {
        return Server { tab: table, core: state };
    }
    borrow mut table as &!tw in {
        borrow mut state as &!cw in {
            if begin_round(tw, cw) > 0 {
                timeout = 0;
            }
        }
    }
    var ready = 0 - 1;
    borrow mut state as &!cw in {
        ready = poller_wait(cw.poller, contents(cw.events), timeout);
    }
    let now = clock_ms(clock) / 1000;
    borrow mut state as &!cw in {
        cw.now = clock_ms(clock);
    }
    if ready >= 0 {
        // New connections first, while the table is ours to grow.
        var j = 0;
        while j < ready {
            var token = 0 - 1;
            borrow state as &cr in {
                token = contents(cr.events)[2 * j];
            }
            if token == 0 {
                borrow mut state as &!cw in {
                    table = accept_all(heap, table, listener, cw, now);
                }
            }
            j = j + 1;
        }
        borrow mut table as &!tw in {
            borrow mut state as &!cw in {
                serve_events(tw, cw, ready, now);
            }
        }
    }
    return Server { tab: table, core: state };
}

// The next request, in hand, or -1 when no connection has a whole one left.
// The answer is the connection's slot, which is only for telling requests
// apart: everything to do with it goes through `head`, `parsed`, `body` and
// `respond`, which act on the request in hand.
//
// Refusals the loop owns -- a request the parser rejects, one that cannot fit
// -- are answered here and never reach the application.
pub fn next[&h, &s](heap: &!h Heap, srv: &!s Server) -> [heap, conn_write, poll] int {
    return advance(heap, srv.tab, srv.core);
}

// The request in hand: its request line and headers, as `std.http` reads them
// with `parsed`.
pub fn head[&s](srv: &s Server) -> [] &s [byte] {
    let core = srv.core;
    let st = contents(core.state);
    let p = stride() * core.cur;
    let from = core.cur * core.size + st[p + 6];
    return contents(core.bufs)[from..from + st[p + 7]];
}

// The parse table of the request in hand.
pub fn parsed[&s](srv: &s Server) -> [] &s [int] {
    return contents(srv.core.parsed);
}

// The body of the request in hand, whole: a chunked body is already decoded,
// so the application cannot tell the two apart. Empty if there is none.
pub fn body[&s](srv: &s Server) -> [] &s [byte] {
    let core = srv.core;
    let st = contents(core.state);
    let p = stride() * core.cur;
    if st[p + 10] == 1 {
        return contents(core.decoded)[0..st[p + 9]];
    }
    let from = core.cur * core.size + st[p + 6] + st[p + 7];
    return contents(core.bufs)[from..from + st[p + 9]];
}

// Answer the request in hand. The bytes are offered to the connection at once
// if nothing is queued ahead of them and otherwise queued behind it, so answers
// leave in the order of their requests; what the kernel did not take waits in
// the connection's output buffer and the connection is watched for room instead
// of input. A connection that asked for `Connection: close`, or whose answer
// could not be held at all (a client that is not reading and has asked for more
// than the buffer), is closed once its output is gone, or at once.
//
// Answers the bytes now waiting, or -1 if the connection was abandoned.
pub fn respond[&s, &a](srv: &!s Server, answer: &a [byte]) -> [conn_write] int {
    return deliver(srv.tab, srv.core, answer);
}

fn deliver[&t, &c, &a](tab: &!t conns.Table, core: &!c Core, answer: &a [byte]) -> [conn_write] int {
    return deliver_to(tab, core, core.cur, answer);
}

// `deliver` for connection `k`, which is the one in hand or one whose request was held.
fn deliver_to[&t, &c, &a](tab: &!t conns.Table, core: &!c Core, k: int, answer: &a [byte]) -> [conn_write] int {
    if k < 0 {
        return 0 - 1;
    }
    let st = contents(core.state);
    let pd = contents(core.pends);
    let p = stride() * k;
    let osize = core.osize;
    if st[p + 25] != 0 {
        // Its request is over (a refusal is recorded): the next `next` sends that.
        return 0 - 1;
    }
    st[p + 2] = emit(tab, core.fed, k, core.chunk, answer, pd[k * osize..(k + 1) * osize], st[p + 2]);
    if st[p + 2] < 0 {
        st[p + 11] = 1;
        return 0 - 1;
    }
    if st[p + 16] != 0 {
        end_request(core, k);
        return st[p + 2];
    }
    if !http.keeps_alive(contents(core.parsed)) {
        st[p + 3] = 1;
    }
    // The request is answered: the next starts after it.
    st[p + 6] = st[p + 6] + st[p + 7] + st[p + 8];
    return st[p + 2];
}

// ---------------------------------------------------------------------
// A request that is answered later
// ---------------------------------------------------------------------

// A held request is named by a ticket: the connection's slot and how many connections
// have used that slot, so that an answer for a connection that has since gone cannot
// reach whichever one took its place. The slot is `ticket % ticket_span()`.
fn ticket_span() -> [] int {
    return 2048;
}

// The slot a ticket names, to index the application's own per-connection records with.
pub fn ticket_slot(ticket: int) -> [] int {
    return ticket % ticket_span();
}

// Leave the request in hand unanswered and go on with the others. Answers its ticket, or -1
// if there is no request in hand.
//
// What stays with the application is the ticket and whatever it noted about the request
// (its route, the id in its path); what goes is the request's *views*: `head`, `parsed` and
// `body` are for the request in hand, and the next `next` replaces it. The request itself
// stays whole at the front of the connection's buffer. Nothing more is taken from the
// connection until `answer`; what the client sends meanwhile is buffered (a client that
// sends more than the buffer holds is read no more, and closed if it hangs up), and a
// held connection is not closed for being idle: the application's own timeout says how
// long it will wait. A held connection that is closed -- the client left -- makes `answer`
// answer -1.
pub fn hold[&s](srv: &!s Server) -> [poll] int {
    return hold_in(srv.tab, srv.core);
}

fn hold_in[&t, &c](tab: &!t conns.Table, core: &!c Core) -> [poll] int {
    let k = core.cur;
    if k < 0 {
        return 0 - 1;
    }
    let st = contents(core.state);
    let p = stride() * k;
    st[p + 13] = 1;
    core.cur = 0 - 1;
    if core.lim == 1 {
        release_head(core, k);
    }
    // As if the visit were over: what was answered before it is dropped from the buffer and
    // the held request becomes its front.
    finish(tab, core, k);
    return st[p + 14] * ticket_span() + k;
}

// Answer a held request, as `respond` would have answered it in hand. Answers the bytes
// now waiting, or -1: the ticket is not one that was handed out and is still held (it was
// answered already, or its connection closed, or another has taken its slot), or the
// connection could not be written to and was abandoned.
//
// The connection goes back to being served: if the client had sent more requests behind
// this one they are given by `next` now.
pub fn answer[&s, &a](srv: &!s Server, ticket: int, bytes: &a [byte]) -> [conn_write, poll] int {
    return answer_in(srv.tab, srv.core, ticket, bytes);
}

fn answer_in[&t, &c, &a](tab: &!t conns.Table, core: &!c Core, ticket: int, bytes: &a [byte]) -> [conn_write, poll] int {
    if ticket < 0 {
        return 0 - 1;
    }
    let k = ticket % ticket_span();
    if k >= core.limit {
        return 0 - 1;
    }
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 4] != 1 || st[p + 13] != 1 || st[p + 14] != ticket / ticket_span() || st[p + 25] != 0 {
        return 0 - 1;
    }
    // The parse table holds whichever request came after; this one is still whole at the
    // front of the buffer, so it parses again (`deliver` reads whether to keep alive from it).
    // (A request with `limits` let go of its head when held: its flags say.)
    let base = k * core.size;
    if st[p + 16] == 0 {
        http.parse(contents(core.bufs)[base..base + st[p]], contents(core.parsed));
    }
    st[p + 13] = 0;
    let sent = deliver_to(tab, core, k, bytes);
    finish(tab, core, k);
    if st[p + 4] == 1 && (st[p] > 0 || st[p + 15] == 1) && st[p + 2] == 0 && st[p + 3] == 0 && st[p + 11] == 0 {
        // More requests were already buffered behind it (or the peer has ended), and no
        // input will arrive to wake the connection for them.
        enqueue(core, k);
    }
    return sent;
}

// ---------------------------------------------------------------------
// Streaming a request body (`http-server.md` §12)
// ---------------------------------------------------------------------

// Opt in: from now on a request whose body is still arriving (or does not fit the buffer) is handed over
// by `next` as soon as its head is complete, and the body is read with `body_part` from the request's
// ticket. `max_body` is the most body bytes a request may have, `piece` the most `body_part` shows (a piece
// over `size` is `size`: the buffer holds no more), `head_ms` the deadline for a head and `body_ms` the longest wait for more of a body (§12.8).
// 0, or -1 for a bound under 1. Takes effect for the heads parsed after it.
pub fn limits[&s](srv: &!s Server, max_body: int, piece: int, head_ms: int, body_ms: int) -> [] int {
    if max_body < 1 || piece < 1 || head_ms < 1 || body_ms < 1 { return 0 - 1; }
    srv.core.lim = 1;
    srv.core.maxb = max_body;
    srv.core.piece = piece;
    srv.core.head_ms = head_ms;
    srv.core.body_ms = body_ms;
    return 0;
}

// Does the request in hand have a body that is still arriving? Then `hold` it and read the body from the ticket.
pub fn streaming[&s](srv: &s Server) -> [] bool {
    let k = srv.core.cur;
    if k < 0 { return false; }
    let st = contents(srv.core.state);
    return st[stride() * k + 16] != 0 && !has(st[stride() * k + 24], f_done());
}

// The slot a ticket names while its request is held and not over, else -1.
fn held_slot[&c](core: &c Core, ticket: int) -> [] int {
    if ticket < 0 { return 0 - 1; }
    let k = ticket % ticket_span();
    if k >= core.limit { return 0 - 1; }
    let st = contents(core.state);
    let p = stride() * k;
    if st[p + 4] != 1 || st[p + 13] != 1 || st[p + 14] != ticket / ticket_span() || st[p + 25] != 0 || st[p + 16] == 0 {
        return 0 - 1;
    }
    return k;
}

// The application will read the body: if the client asked for `100 Continue` and has not been sent it, send it
// now (§12.5). 1 if sent, 0 if there was nothing to send (no `Expect`, already sent, or the answer has begun),
// -1 if the ticket's request is over.
pub fn proceed[&s](srv: &!s Server, ticket: int) -> [conn_write, poll] int {
    return proceed_in(srv.tab, srv.core, ticket);
}

fn proceed_in[&t, &c](tab: &!t conns.Table, core: &!c Core, ticket: int) -> [conn_write, poll] int {
    let k = held_slot(core, ticket);
    if k < 0 { return 0 - 1; }
    let st = contents(core.state);
    let p = stride() * k;
    if !has(st[p + 24], f_expect()) || has(st[p + 24], f_started()) { return 0; }
    clear_flag(st, p, f_expect());
    st[p + 27] = core.now;
    let pd = contents(core.pends);
    st[p + 2] = emit(tab, core.fed, k, core.chunk, "HTTP/1.1 100 Continue\r\n\r\n", pd[k * core.osize..(k + 1) * core.osize], st[p + 2]);
    if st[p + 2] < 0 { shut(tab, core, k); return 0 - 1; }
    settle(tab, core, k);
    return 1;
}

// The next piece of the body: at most `piece` bytes that have arrived and not been taken (empty when there are none
// now, or the ticket's request is over). It is a view: it stays the same until `body_take`.
pub fn body_part[&s](srv: &s Server, ticket: int) -> [] &s [byte] {
    let core = srv.core;
    let bf = contents(core.bufs);
    let k = held_slot(core, ticket);
    if k < 0 { return bf[0..0]; }
    let st = contents(core.state);
    let p = stride() * k;
    var n = st[p + 22];
    if n > core.piece { n = core.piece; }
    return bf[k * core.size + st[p + 21]..k * core.size + st[p + 21] + n];
}

// The application has used `n` bytes of the piece `body_part` showed: they are dropped, and the room they held is
// given back (a socket server is watched for input again; a byte-fed caller finds it in `room`). `n`, or -1 for an `n`
// past the piece or a request that is over.
pub fn body_take[&s](srv: &!s Server, ticket: int, n: int) -> [poll] int {
    let k = held_slot(srv.core, ticket);
    if k < 0 { return 0 - 1; }
    let st = contents(srv.core.state);
    let p = stride() * k;
    var can = st[p + 22];
    if can > srv.core.piece { can = srv.core.piece; }
    if n < 0 || n > can { return 0 - 1; }
    st[p + 21] = st[p + 21] + n;
    st[p + 22] = st[p + 22] - n;
    st[p + 27] = srv.core.now;
    settle(srv.tab, srv.core, k);
    return n;
}

// 0 if more of the body is coming, 1 if all of it has arrived (some may still wait to be taken), -1 if the request is
// over: the server refused it, the connection went, or the ticket was answered.
pub fn body_state[&s](srv: &s Server, ticket: int) -> [] int {
    let k = held_slot(srv.core, ticket);
    if k < 0 { return 0 - 1; }
    if has(contents(srv.core.state)[stride() * k + 24], f_done()) { return 1; }
    return 0;
}

// Body bytes received so far, decoded; -1 if the request is over.
pub fn body_total[&s](srv: &s Server, ticket: int) -> [] int {
    let k = held_slot(srv.core, ticket);
    if k < 0 { return 0 - 1; }
    return contents(srv.core.state)[stride() * k + 23];
}

// ---------------------------------------------------------------------
// Handles of the application's own
// ---------------------------------------------------------------------

// The server's poller, to register handles with (`std.conns.watch`) that are not its own
// connections -- a database connection, say -- so that one `wait` serves both.
pub fn poller[&s](srv: &!s Server) -> [] &!s Poller {
    return srv.core.poller;
}

// The first token the application may register a handle under: the server uses 0 for the
// listener and 1 to `limit` for its connections. Token `first_token(srv) + i` is the
// application's `i`-th.
pub fn first_token[&s](srv: &s Server) -> [] int {
    return srv.core.limit + 1;
}

// What the last `wait` reported for those handles: `foreign_count` pairs, flat, of (token,
// readiness) -- 1 for readable (or hung up), 2 for writable. The server does nothing for
// them but tell the application.
pub fn foreign_count[&s](srv: &s Server) -> [] int {
    return srv.core.nforeign;
}

pub fn foreign[&s](srv: &s Server) -> [] &s [int] {
    return contents(srv.core.foreign)[0..2 * srv.core.nforeign];
}

// ---------------------------------------------------------------------
// A server with no sockets (`http-server.md` §11)
// ---------------------------------------------------------------------

// What `open_bytes` answers: the server, or the `errno` of the one thing that can fail.
pub enum Opening {
    Ok(Server),
    Failed(int),
}

// The smallest output room worth having: one status line and a few headers.
fn least_output() -> [] int {
    return 512;
}

// A server whose connections are not sockets: the application moves the bytes, which is
// what a TLS terminator in front of it does (`attach`, `input`, `ready`, `next` and the
// rest, `output`, `closing`, `detach`).
//
// `size` is each connection's input buffer, `out` how much answer each may have waiting
// (at least 512: an answer larger than the room left is refused like an answer to a client
// that does not read, so a bigger one is `hold`ed and `stream`ed), `idle` the seconds a
// connection may go without progress before it ends, and `max` how many connections at
// most (at least 1, at most what `open` allows at that `size`). Memory is `max * (size +
// out)` and a little, allocated here, and nothing else grows.
//
// It still holds a kernel poller, which it never registers anything in: `Core` has the
// field for the socket server and a `res` cannot be absent. It is closed by `close`.
// `Failed` is that poller's `errno`, or 22 for a `size`, `out` or `max` out of range.
pub fn open_bytes[&h](heap: &!h Heap, size: int, out: int, idle: int, max: int) -> [heap] Opening {
    if size < 1 || out < least_output() || max < 1 {
        return Opening::Failed(22);
    }
    match poller_new() {
        Polling::Ok(p) => {
            var limit = connection_limit(size);
            if max < limit {
                limit = max;
            }
            let core = Core { poller: p, events: box_slice(heap, 2, 0), state: box_slice(heap, stride() * limit, 0), bufs: box_slice(heap, limit * size, byte_of(0)), pends: box_slice(heap, limit * out, byte_of(0)), parsed: box_slice(heap, http.slots(64), 0), decoded: box_slice(heap, size, byte_of(0)), ready: box_slice(heap, limit, 0), limit: limit, size: size, chunk: 0, idle: idle, nready: 0, cursor: 0, cur: 0 - 1, last_sweep: 0, foreign: box_slice(heap, 2, 0), nforeign: 0, fed: 1, osize: out, nlive: 0, scan: 0, lim: 0, maxb: 0, piece: 0, head_ms: 0, body_ms: 0, now: 0, last_tick: 0 - 50 };
            return Opening::Ok(Server { tab: conns.empty(heap, 1), core: core });
        }
        Polling::Failed(e) => {
            return Opening::Failed(e);
        }
    }
}

// Is `k` a connection of this server that is in use (not ended)?
fn live_slot[&c](core: &c Core, k: int) -> [] bool {
    if core.fed != 1 || k < 0 || k >= core.limit {
        return false;
    }
    return contents(core.state)[stride() * k + 4] == 1;
}

// A new connection: its slot, or -1 if the server is full (or is not byte-fed). `now_ms` is
// the caller's clock, which the idle timeout counts from.
pub fn attach[&s](srv: &!s Server, now_ms: int) -> [] int {
    if srv.core.fed != 1 || srv.core.nlive >= srv.core.limit {
        return 0 - 1;
    }
    let st = contents(srv.core.state);
    var k = srv.core.scan;
    var tried = 0;
    // `nlive < limit`, so a free slot is in the next `limit` looked at.
    while tried < srv.core.limit && st[stride() * k + 4] != 0 {
        k = (k + 1) % srv.core.limit;
        tried = tried + 1;
    }
    if tried >= srv.core.limit {
        return 0 - 1;
    }
    init_slot(srv.core, k, now_ms / 1000);
    srv.core.now = now_ms;
    srv.core.scan = (k + 1) % srv.core.limit;
    srv.core.nlive = srv.core.nlive + 1;
    return k;
}

// How many bytes `input` takes for `k` now: what is left of its buffer, and none while
// answers are waiting to be sent (a client that is not taking its answers is not read:
// the same back-pressure a socket gets by not being watched for reading), nor once it is
// ending. 0 is not an error: hold the bytes and ask again after `output`.
pub fn room[&s](srv: &s Server, k: int) -> [] int {
    if !live_slot(srv.core, k) {
        return 0;
    }
    let st = contents(srv.core.state);
    let p = stride() * k;
    if st[p + 2] > 0 || st[p + 3] == 1 || st[p + 15] == 1 {
        return 0;
    }
    return readable(srv.core, k);
}

// Bytes the peer sent, into connection `k`: as many as `room` allows, answering how many
// were taken (the application keeps the rest), or -1 for a connection that is not in use.
// A request is a whole one when `next` says so; it may arrive in any number of pieces.
pub fn input[&s, &d](srv: &!s Server, k: int, data: &d [byte], now_ms: int) -> [] int {
    if !live_slot(srv.core, k) {
        return 0 - 1;
    }
    srv.core.now = now_ms;
    var n = room(srv, k);
    if len(data) < n {
        n = len(data);
    }
    if n > 0 {
        let st = contents(srv.core.state);
        let bf = contents(srv.core.bufs);
        let p = stride() * k;
        if n > srv.core.size - st[p] {
            reclaim(srv.core, k);
        }
        let at = k * srv.core.size + st[p];
        var i = 0;
        while i < n {
            bf[at + i] = data[i];
            i = i + 1;
        }
        st[p] = st[p] + n;
        st[p + 1] = now_ms / 1000;
        ingest(srv.core, k, st[p] - n);
        enqueue(srv.core, k);
    }
    return n;
}

// The peer will send no more (a TCP half-close, or its close_notify): what it sent is still
// answered, in order, and then the connection ends -- `closing` says when. A request it did
// not finish is dropped. 0, or -1 for a connection that is not in use.
pub fn end_input[&s](srv: &!s Server, k: int) -> [] int {
    if !live_slot(srv.core, k) {
        return 0 - 1;
    }
    let st = contents(srv.core.state);
    st[stride() * k + 15] = 1;
    if st[stride() * k + 16] != 0 && !has(st[stride() * k + 24], f_done()) {
        // The body will never be whole: its request is over, and there is nothing to answer (§12.9).
        st[stride() * k + 25] = 10;
    }
    enqueue(srv.core, k);
    return 0;
}

// Wait without waiting: what `wait` does before and after its `poller_wait`, with the clock
// the caller read (`now_ms`, any monotonic milliseconds, the same as `attach` and `input`
// were given): what `next` did not reach is queued again, and a connection with no progress
// for more than `idle` seconds ends (once a second). Answers how many connections are queued
// for `next`.
pub fn ready[&s](srv: &!s Server, now_ms: int) -> [poll] int {
    if srv.core.fed != 1 {
        return 0 - 1;
    }
    srv.core.now = now_ms;
    begin_round(srv.tab, srv.core);
    sweep_idle(srv.tab, srv.core, now_ms / 1000);
    sweep_timers(srv.tab, srv.core);
    return srv.core.nready;
}

// How many bytes of answer are waiting to be sent on `k`.
pub fn pending[&s](srv: &s Server, k: int) -> [] int {
    if !live_slot(srv.core, k) {
        return 0;
    }
    return contents(srv.core.state)[stride() * k + 2];
}

// How many more bytes of answer `k` can hold: what `respond` and `stream` may be given at once.
pub fn space[&s](srv: &s Server, k: int) -> [] int {
    if !live_slot(srv.core, k) {
        return 0;
    }
    return srv.core.osize - contents(srv.core.state)[stride() * k + 2];
}

// What the server would have written to the socket: up to `len(out)` of `k`'s waiting answer
// into `out`, answering how many (0 when none is waiting). Taking bytes is progress, and when
// the last of an answer that ends the connection goes, the connection ends (`closing`); when
// requests were waiting behind the answer they are served again by the next `next`.
pub fn output[&s, &o](srv: &!s Server, k: int, out: &!o [byte], now_ms: int) -> [] int {
    if !live_slot(srv.core, k) {
        return 0;
    }
    let st = contents(srv.core.state);
    let pd = contents(srv.core.pends);
    let p = stride() * k;
    let base = k * srv.core.osize;
    srv.core.now = now_ms;
    var n = st[p + 2];
    if len(out) < n {
        n = len(out);
    }
    if n == 0 {
        return 0;
    }
    var i = 0;
    while i < n {
        out[i] = pd[base + i];
        i = i + 1;
    }
    i = 0;
    while i < st[p + 2] - n {
        pd[base + i] = pd[base + n + i];
        i = i + 1;
    }
    st[p + 2] = st[p + 2] - n;
    st[p + 1] = now_ms / 1000;
    if st[p + 2] == 0 {
        if st[p + 3] == 1 {
            shut(srv.tab, srv.core, k);
        } else if st[p] > 0 || st[p + 15] == 1 {
            // Held back while the answer was being sent.
            enqueue(srv.core, k);
        }
    }
    return n;
}

// Has `k` ended? The server is done with it -- it answered `Connection: close`, the peer ended
// and everything is answered, it was idle, it could not hold an answer, or what it sent
// was refused -- and what is left is the application's: send close_notify, close the socket,
// `detach`. Bytes still waiting were dropped.
pub fn closing[&s](srv: &s Server, k: int) -> [] bool {
    if srv.core.fed != 1 || k < 0 || k >= srv.core.limit {
        return false;
    }
    return contents(srv.core.state)[stride() * k + 4] == 2;
}

// Free `k`'s slot, ended or not (the socket failed, the application gave up on it, `closing`
// was seen to). A request held for it is forgotten: its ticket answers -1 from now on, even
// once the slot is taken again. 0, or -1 for a slot not in use.
pub fn detach[&s](srv: &!s Server, k: int) -> [] int {
    if srv.core.fed != 1 || k < 0 || k >= srv.core.limit {
        return 0 - 1;
    }
    let st = contents(srv.core.state);
    let p = stride() * k;
    if st[p + 4] == 0 {
        return 0 - 1;
    }
    if srv.core.cur == k {
        srv.core.cur = 0 - 1;
    }
    if st[p + 12] == 1 {
        // Out of the queue, or the slot's next connection would be in it twice.
        let queue = contents(srv.core.ready);
        var from = 0;
        var to = 0;
        while from < srv.core.nready {
            if queue[from] != k {
                queue[to] = queue[from];
                to = to + 1;
            } else if from < srv.core.cursor {
                srv.core.cursor = srv.core.cursor - 1;
            }
            from = from + 1;
        }
        srv.core.nready = to;
    }
    st[p] = 0;
    st[p + 2] = 0;
    st[p + 4] = 0;
    st[p + 12] = 0;
    st[p + 13] = 0;
    clear_body(srv.core, k);
    srv.core.nlive = srv.core.nlive - 1;
    return 0;
}

// Part of the answer to a held request (`hold`): as many of `bytes` as the connection has room
// for, appended to what is waiting, answering how many (the application offers the rest again
// after `output` has made room), or -1 for a ticket that is not held (answered, or its
// connection gone). The request stays held: nothing behind it is given out and the idle
// timeout spares it while nothing is waiting to be sent; `answer` with the last of the bytes
// (or none) ends it. This is how an answer larger than the output room is sent, the head first
// and the body as the peer takes it. Only a byte-fed server has it; a socket server answers -1.
pub fn stream[&s, &a](srv: &!s Server, ticket: int, bytes: &a [byte]) -> [] int {
    if srv.core.fed != 1 || ticket < 0 {
        return 0 - 1;
    }
    let k = ticket % ticket_span();
    if k >= srv.core.limit {
        return 0 - 1;
    }
    let st = contents(srv.core.state);
    let p = stride() * k;
    if st[p + 4] != 1 || st[p + 13] != 1 || st[p + 14] != ticket / ticket_span() || st[p + 25] != 0 {
        return 0 - 1;
    }
    var n = srv.core.osize - st[p + 2];
    if len(bytes) < n {
        n = len(bytes);
    }
    let pd = contents(srv.core.pends);
    let at = k * srv.core.osize + st[p + 2];
    var i = 0;
    while i < n {
        pd[at + i] = bytes[i];
        i = i + 1;
    }
    st[p + 2] = st[p + 2] + n;
    if n > 0 {
        set_flag(st, p, f_started());
    }
    return n;
}
