module agent.wire;

// `agent.wire` -- the third real `cancho-vcs` package.
//
// `examples/vsock/vsock.cho` and `examples/agent_guest/agent_guest.cho`
// each declared the same five pure functions, independently, to decode
// one field out of a real `lex-os-proto` `AgentViewMsg` line -- not a
// JSON library, exactly the two things a guest that reads a goal and a
// step needs, copied byte-for-byte between the two files
// (`agent_guest.cho`'s own header said so plainly: "copied from
// `examples/vsock/vsock.cho`'s ... unchanged"). That is the same shape
// `docs/package-system.md` §4.1 already used for `net.sockets`/
// `net.connect`: a `cancho-vcs` store two particular programs both
// happen to want, not something general enough for `std`.
//
// **What is deliberately not here.** The encoder side
// (`append_json_escaped`/`encode_done`/`encode_exec_result` in
// `vsock.cho`, `put_escaped`/`encode_view` in
// `examples/agent_supervisor/agent_supervisor.cho`) escapes the same five
// bytes in both files, but not byte-for-byte the same code: one writes
// into a growable `std.buffer.Buffer` (`heap`), the other into a fixed
// slice with a cursor, because `agent_supervisor.cho` has no `Heap` to
// spend. Bundling two different signatures under one name would be
// guessing at a shape neither file asked for, the opposite of this
// package's own reason to exist -- so the escaper stays where it is
// until a third file needs it in one of these two shapes specifically.
//
// No `import std.bytes` for the same reason `net.sockets`'s own `put`/
// `put_nat` have none: `vcs publish` never makes `--std` available
// (`crates/cancho/src/vcs_cli.rs`'s `cmd_publish` parses with
// `with_std: false` unconditionally), so a package's own source has to
// be self-contained. `step_of` below inlines the one-line digit check
// `std.bytes.digit_of` would otherwise provide.

// The index just past the first occurrence of `needle` in `hay` at or
// after `start`, or `-1`. `needle` is always a literal the caller wrote,
// so a naive scan (no Boyer-Moore, no skip table) is the whole search
// either decoder ever needs.
pub fn find_after[&hay, &needle](hay: &hay [byte], needle: &needle [byte], start: int) -> [] int {
    let hn = len(hay);
    let nn = len(needle);
    var i = start;
    while i + nn <= hn {
        var matched = true;
        var j = 0;
        while j < nn {
            if int_of(hay[i + j]) != int_of(needle[j]) {
                matched = false;
            }
            j = j + 1;
        }
        if matched {
            return i + nn;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// The end of the quoted string starting at `start` (the index right
// after its opening `"`) -- the first unescaped `"`. Goals and outcomes
// in either caller's own examples never contain a backslash, so skipping
// exactly one character after a `\` is enough to step over an escape
// without decoding it.
pub fn end_of_quoted[&s](s: &s [byte], start: int) -> [] int {
    var i = start;
    let n = len(s);
    while i < n {
        let c = int_of(s[i]);
        if c == 92 {
            i = i + 2;
        } else if c == 34 {
            return i;
        } else {
            i = i + 1;
        }
    }
    return 0 - 1;
}

// The index right after `{"goal":"` in `line`, i.e. where the goal text
// itself starts -- or `-1` if `line` does not open that way.
pub fn goal_start_of[&line](line: &line [byte]) -> [] int {
    return find_after(line, "{\"goal\":\"", 0);
}

// The index of the `"` that closes the goal text starting at `start`, so
// a caller slices the goal out as `line[start..goal_end_of(line, start)]`
// with no further allocation -- or `-1` if it never closes.
pub fn goal_end_of[&line](line: &line [byte], start: int) -> [] int {
    return end_of_quoted(line, start);
}

// `AgentViewMsg`'s `step`, the field right after `completed`'s own close
// in real `lex-os-proto` JSON but read starting from wherever the
// caller's own scan of `goal` already reached, since `"step":` never
// repeats. `-1` on a decode failure: no `"step":` key found, or no digit
// after it.
pub fn step_of[&line](line: &line [byte], after: int) -> [] int {
    let after_key = find_after(line, "\"step\":", after);
    if after_key < 0 {
        return 0 - 1;
    }
    var i = after_key;
    let n = len(line);
    var step = 0;
    var saw_digit = false;
    while i < n {
        let c = int_of(line[i]);
        var d = 0 - 1;
        if c >= '0' && c <= '9' {
            d = c - '0';
        }
        if d < 0 {
            i = n;
        } else {
            step = step * 10 + d;
            saw_digit = true;
            i = i + 1;
        }
    }
    if !saw_digit {
        return 0 - 1;
    }
    return step;
}
