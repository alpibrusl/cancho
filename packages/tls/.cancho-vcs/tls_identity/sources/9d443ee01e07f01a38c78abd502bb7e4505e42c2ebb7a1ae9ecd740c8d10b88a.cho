edition 6;
module tls_identity;
import std.bytes;
import std.crypto;
import tls_message;
import tls_record;
import tls_slot;
import x509;
import x509_key;
import x509_names;
import x509_verify;

// `tls_identity` -- what a server engine is configured with
// (`docs/tls-server.md` §2.1, §4): up to 16 identities, each a chain, its
// P-256 key and the names it serves, and the ALPN protocols the server
// speaks. All of it is one byte slice, `cfg`, which the engine owns and
// hands to `tls_server` with every `feed`, so a ClientHello can choose
// from it. The engine never reads a file: the program gives the PEM
// bytes. There is no function that answers a key. Not independently
// reviewed (#209).
//
// The layout: the ALPN list's length (2 bytes) and the list, in ALPN's
// wire form (each name after its length byte); then each identity, a
// fixed stride: in use (1 byte), the key (32), its public point (65), the
// names' length (2) and the names, the certificate_list's length (3) and
// the list, as Certificate sends it, then the leaf certificate's SHA-256 (32) and its notAfter (8, seconds
// since 1970), which a session ticket binds to (`docs/tls-server.md` §12.3 d). After the identities, the clients' trust
// store and the mode of client authentication (`docs/tls-server.md` §13.3): the mode (1 byte), the generation (4), the
// store's length (3) and the store, in `x509_verify.store_load`'s format.

pub fn max_identities() -> [] int {
    return 16;
}

// The certificate_list's room: each certificate's DER after a 3-byte
// length, then 2 bytes of no extensions. A Let's Encrypt chain is about
// 3 KiB.
pub fn chain_cap() -> [] int {
    return 16384;
}

pub fn names_cap() -> [] int {
    return 1024;
}

pub fn alpn_cap() -> [] int {
    return 512;
}

fn ids_base() -> [] int {
    return 2 + alpn_cap();
}

fn o_key() -> [] int {
    return 1;
}

fn o_point() -> [] int {
    return 33;
}

fn o_names_len() -> [] int {
    return 98;
}

fn o_names() -> [] int {
    return 100;
}

fn o_list_len() -> [] int {
    return o_names() + names_cap();
}

fn o_list() -> [] int {
    return o_list_len() + 3;
}

fn o_fp() -> [] int {
    return o_list() + chain_cap();
}

fn o_not_after() -> [] int {
    return o_fp() + 32;
}

fn stride() -> [] int {
    return o_not_after() + 8;
}

fn at(id: int) -> [] int {
    return ids_base() + id * stride();
}

fn client_base() -> [] int {
    return ids_base() + max_identities() * stride();
}

pub fn cfg_len() -> [] int {
    return client_base() + 8 + client_store_cap();
}

// ---- ALPN ----

// The protocols, in the server's order of preference, from `text`:
// names separated by spaces ("h2 http/1.1"). Empty clears the list,
// and ALPN a client offers is then ignored (RFC 7301 §3.2). 0, or
// `server_alpn_list` for a name over 255 bytes or a list over
// `alpn_cap()`; then the list is as it was.
pub fn set_alpn[&c, &t](cfg: &!c [byte], text: &t [byte]) -> [] int {
    var code = 0;
    region r {
        let wire = alloc_slice[r](alpn_cap(), byte_of(0));
        var n = 0;
        var p = 0;
        while code == 0 && p < len(text) {
            while p < len(text) && int_of(text[p]) == 32 {
                p = p + 1;
            }
            var e = p;
            while e < len(text) && int_of(text[e]) != 32 {
                e = e + 1;
            }
            if e > p {
                if e - p > 255 || n + 1 + e - p > alpn_cap() {
                    code = tls_record.server_alpn_list();
                } else {
                    wire[n] = byte_of(e - p);
                    tls_slot.copy_bytes(text[p..e], wire[n + 1..n + 1 + e - p]);
                    n = n + 1 + e - p;
                }
            }
            p = e;
        }
        if code == 0 {
            tls_message.put(cfg, 0, n, 2);
            bytes.zero(cfg[2..2 + alpn_cap()]);
            tls_slot.copy_bytes(wire[0..n], cfg[2..2 + n]);
        }
    }
    return code;
}

// The ALPN list, in its wire form.
pub fn alpn_list[&c](cfg: &c [byte]) -> [] &c [byte] {
    return cfg[2..2 + tls_message.get(cfg, 0, 2)];
}

// ---- Identities ----

pub fn in_use[&c](cfg: &c [byte], id: int) -> [] bool {
    return id >= 0 && id < max_identities() && int_of(cfg[at(id)]) == 1;
}

pub fn count[&c](cfg: &c [byte]) -> [] int {
    var n = 0;
    var id = 0;
    while id < max_identities() {
        if in_use(cfg, id) {
            n = n + 1;
        }
        id = id + 1;
    }
    return n;
}

pub fn key[&c](cfg: &c [byte], id: int) -> [] &c [byte] {
    return cfg[at(id) + o_key()..at(id) + o_key() + 32];
}

pub fn point[&c](cfg: &c [byte], id: int) -> [] &c [byte] {
    return cfg[at(id) + o_point()..at(id) + o_point() + 65];
}

// The certificate_list Certificate sends.
pub fn list[&c](cfg: &c [byte], id: int) -> [] &c [byte] {
    let n = tls_message.get(cfg, at(id) + o_list_len(), 3);
    return cfg[at(id) + o_list()..at(id) + o_list() + n];
}

// The SHA-256 of identity `id`'s leaf certificate, which a session ticket records: a replaced
// identity with another certificate has another one, and the tickets of the old are refused.
pub fn fingerprint[&c](cfg: &c [byte], id: int) -> [] &c [byte] {
    return cfg[at(id) + o_fp()..at(id) + o_fp() + 32];
}

// The leaf's notAfter, seconds since 1970: no ticket outlives it.
pub fn not_after[&c](cfg: &c [byte], id: int) -> [] int {
    return tls_message.get(cfg, at(id) + o_not_after(), 8);
}

// A key parser's refusal as this package's (`x509_key.refusal_tag`): a
// key of another algorithm or curve is `server_key_type`; anything else
// about the file, `server_key_format`.
fn from_key(code: int) -> [] int {
    if code == 0 {
        return 0;
    }
    if code == -82 || code == -83 {
        return tls_record.server_key_type();
    }
    return tls_record.server_key_format();
}

// The chain `chain_pem` (PEM certificates, leaf first) and its key
// `key_pem` (PKCS#8 or SEC 1, P-256) checked as `docs/tls-server.md` §4
// says, and written into identity `id` with `names` (space-separated, at
// most `names_cap()` bytes; `None` keeps the names `id` has). `now` is
// seconds since 1970; `work` holds `x509_key.work_len()` words. Nothing
// is written unless every check passes: a refused replacement leaves the
// identity as it was. 0, or the refusal.
pub fn load[&c, &p, &k, &n, &w](cfg: &!c [byte], id: int, chain_pem: &p [byte], key_pem: &k [byte], names: &n [byte], keep_names: bool, now: int, work: &!w [int]) -> [] int {
    if !keep_names && len(names) > names_cap() {
        return tls_record.server_names();
    }
    var code = 0;
    region r {
        let chain = alloc_slice[r](chain_cap(), byte_of(0));
        let der = alloc_slice[r](chain_cap(), byte_of(0));
        let info = alloc_slice[r](2, 0);
        let view = alloc_slice[r](x509.view_len(), 0);
        let secret = alloc_slice[r](32, byte_of(0));
        let pub_point = alloc_slice[r](65, byte_of(0));
        var n = 0;
        var certs = 0;
        var leaf_not_after = 0;
        var from = 0;
        var going = true;
        while code == 0 && going {
            let got = x509.pem_next(chain_pem, from, der, info);
            if got == 1 {
                going = false;
            } else if got != 0 || n + 5 + info[0] > chain_cap() {
                code = tls_record.server_chain();
            } else {
                if certs == 0 {
                    // The leaf: it parses, its key is P-256, and it has
                    // not expired.
                    if x509.parse(der[0..info[0]], view) != 0 {
                        code = tls_record.server_chain();
                    } else if view[x509.key_algorithm()] != x509.oid_ec_public_key() || view[x509.key_curve()] != x509.oid_p256() {
                        code = tls_record.server_key_type();
                    } else if view[x509.not_after()] < now {
                        code = tls_record.server_cert_expired();
                    }
                    leaf_not_after = view[x509.not_after()];
                }
                tls_message.put(chain, n, info[0], 3);
                tls_slot.copy_bytes(der[0..info[0]], chain[n + 3..n + 3 + info[0]]);
                n = n + 5 + info[0];
                certs = certs + 1;
                from = info[1];
            }
        }
        if code == 0 && certs == 0 {
            code = tls_record.server_chain();
        }
        if code == 0 {
            code = from_key(x509_key.parse_pem(key_pem, secret, pub_point, work));
        }
        if code == 0 {
            let leaf_len = tls_message.get(chain, 0, 3);
            let m = x509_key.matches_certificate(chain[3..3 + leaf_len], pub_point);
            if m == -92 {
                code = tls_record.server_key_mismatch();
            } else if m != 0 {
                code = tls_record.server_key_type();
            }
        }
        if code == 0 {
            let b = at(id);
            // The old key goes first (best effort, `docs/tls-pure.md` §7.3).
            bytes.zero(cfg[b + o_key()..b + o_key() + 32]);
            tls_slot.copy_bytes(secret, cfg[b + o_key()..b + o_key() + 32]);
            tls_slot.copy_bytes(pub_point, cfg[b + o_point()..b + o_point() + 65]);
            bytes.zero(cfg[b + o_list()..b + o_list() + chain_cap()]);
            tls_message.put(cfg, b + o_list_len(), n, 3);
            tls_slot.copy_bytes(chain[0..n], cfg[b + o_list()..b + o_list() + n]);
            crypto.sha256(chain[3..3 + tls_message.get(chain, 0, 3)], cfg[b + o_fp()..b + o_fp() + 32]);
            tls_message.put(cfg, b + o_not_after(), leaf_not_after, 8);
            if !keep_names {
                bytes.zero(cfg[b + o_names()..b + o_names() + names_cap()]);
                tls_message.put(cfg, b + o_names_len(), len(names), 2);
                var i = 0;
                while i < len(names) {
                    cfg[b + o_names() + i] = byte_of(bytes.to_lower(int_of(names[i])));
                    i = i + 1;
                }
            }
            cfg[b] = byte_of(1);
        }
        bytes.zero(secret);
        bytes.zero(der);
    }
    return code;
}

// The identity whose names match `host` (lowercase; `x509_names`'s rules,
// so `*.example.com` stands for one label), the first in the order they
// were added; or -1 when none does, and the caller uses the default, 0.
pub fn select[&c, &h](cfg: &c [byte], host: &h [byte]) -> [] int {
    if len(host) == 0 {
        return 0 - 1;
    }
    var id = 0;
    while id < max_identities() {
        if in_use(cfg, id) {
            let b = at(id);
            let names = cfg[b + o_names()..b + o_names() + tls_message.get(cfg, b + o_names_len(), 2)];
            var p = 0;
            while p < len(names) {
                while p < len(names) && int_of(names[p]) == 32 {
                    p = p + 1;
                }
                var e = p;
                while e < len(names) && int_of(names[e]) != 32 {
                    e = e + 1;
                }
                if e > p && x509_names.dns_matches(names[p..e], host) {
                    return id;
                }
                p = e;
            }
        }
        id = id + 1;
    }
    return 0 - 1;
}

// Every key and chain overwritten (best effort, `docs/tls-pure.md` §7.3).
pub fn wipe[&c](cfg: &!c [byte]) -> [] int {
    return bytes.zero(cfg);
}

// ---- The clients' trust store (`docs/tls-server.md` §13.3) ----

// The most roots, and bytes, a client store holds: the system bundle's 128 roots take 138,350 bytes
// (`docs/x509-verify.md` §8.2), so a bundle over either is refused whole, a tripwire against pointing
// the store at the system roots, which it must never hold (`docs/x509-verify.md` §10.3).
pub fn max_client_roots() -> [] int {
    return 32;
}

// 32 KiB, not 64: the store is staged in a region before it replaces the old one, and a region chunk is
// 64 KiB, one larger `alloc_slice` traps (`docs/websocket-spike.md` §4).
pub fn client_store_cap() -> [] int {
    return 32768;
}

// The most bytes the CertificateRequest's certificate_authorities list takes; over it the extension is left
// out (`docs/tls-server.md` §13.2).
pub fn authorities_cap() -> [] int {
    return 8192;
}

// 0 off, 1 optional, 2 required.
pub fn client_mode[&c](cfg: &c [byte]) -> [] int {
    return int_of(cfg[client_base()]);
}

// How many times the store was replaced.
pub fn client_generation[&c](cfg: &c [byte]) -> [] int {
    return tls_message.get(cfg, client_base() + 1, 4);
}

// The store, for `x509_verify.verify_chain`.
pub fn client_store[&c](cfg: &c [byte]) -> [] &c [byte] {
    let n = tls_message.get(cfg, client_base() + 5, 3);
    return cfg[client_base() + 8..client_base() + 8 + n];
}

// The mode, taken by `serve` for the connections it starts. A mode other than off needs a store.
pub fn set_client_mode[&c](cfg: &!c [byte], mode: int) -> [] int {
    if mode < 0 || mode > 2 {
        return tls_record.server_client_auth_config();
    }
    if mode != 0 && len(client_store(cfg)) == 0 {
        return tls_record.server_client_store();
    }
    cfg[client_base()] = byte_of(mode);
    return 0;
}

// How many PEM blocks `pem` begins ("-----BEGIN "), of any label.
fn pem_blocks[&p](pem: &p [byte]) -> [] int {
    let mark = "-----BEGIN ";
    var n = 0;
    var at = 0;
    while at + 11 <= len(pem) {
        var same = true;
        var k = 0;
        while same && k < 11 {
            if pem[at + k] != mark[k] {
                same = false;
            }
            k = k + 1;
        }
        if same {
            n = n + 1;
            at = at + 11;
        } else {
            at = at + 1;
        }
    }
    return n;
}

// Replaces the store with the certificates of `pem`: the roots stored, or `server_client_store` for a
// bundle with no certificate, a block that is not one this package reads, or over the bounds. Nothing
// changes on a refusal. The generation counts the replacements.
pub fn load_client_store[&c, &p](cfg: &!c [byte], pem: &p [byte]) -> [] int {
    var code = 0;
    region r {
        let store = alloc_slice[r](client_store_cap(), byte_of(0));
        let info = alloc_slice[r](2, 0);
        let n = x509_verify.store_load(pem, store, info);
        // Every block must be a certificate stored: a private key pasted into the file, or a block cut short,
        // is a mistake to report (`docs/tls-server.md` §13.3).
        if n <= 0 || n > max_client_roots() || info[1] != 0 || n != pem_blocks(pem) {
            code = tls_record.server_client_store();
        } else {
            let b = client_base();
            bytes.zero(cfg[b + 8..b + 8 + client_store_cap()]);
            tls_slot.copy_bytes(store[0..info[0]], cfg[b + 8..b + 8 + info[0]]);
            tls_message.put(cfg, b + 5, info[0], 3);
            tls_message.put(cfg, b + 1, (client_generation(cfg) + 1) % 4294967296, 4);
            code = n;
        }
    }
    return code;
}

// The subject Name of each root of the store, each after a 2-byte length, into `out`
// (`authorities_cap()` bytes at most): how many bytes, or 0 when the list does not fit and
// certificate_authorities is left out.
pub fn client_authorities[&c, &o](cfg: &c [byte], out: &!o [byte]) -> [] int {
    let store = client_store(cfg);
    var at = 0;
    var n = 0;
    while at + 7 <= len(store) {
        let size = tls_message.get(store, at, 3);
        let so = tls_message.get(store, at + 3, 2);
        let sl = tls_message.get(store, at + 5, 2);
        if sl == 0 || at + 7 + size > len(store) || so + sl > size || n + 2 + sl > authorities_cap() || n + 2 + sl > len(out) {
            return 0;
        }
        tls_message.put(out, n, sl, 2);
        tls_slot.copy_bytes(store[at + 7 + so..at + 7 + so + sl], out[n + 2..n + 2 + sl]);
        n = n + 2 + sl;
        at = at + 7 + size;
    }
    return n;
}
