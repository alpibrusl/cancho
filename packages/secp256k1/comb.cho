module secp256k1_comb;

// GENERATED by `scripts/secp256k1_tables.py`; do not edit. `python3 scripts/secp256k1_tables.py --check` fails when this file is not what the
// script prints.
//
// `secp256k1_comb` -- the generator's comb for `secp256k1` (`docs/secp256k1.md` §2): affine points, x then y, each coordinate in Montgomery form
// (value * 2^256 mod p) as four 64-bit limbs, least significant first. Entry (i, j) is j * 16^i * G for i in 0..64 and j in 0..16 (entry 0 is G
// and is never used), at word (16 i + j) * 8. A `static` is evaluated while compiling and is read-only data in the binary
// (`docs/compile-time-data.md`): nothing is built when a program runs.

pub static comb: [int] {
    let t = alloc_slice[static](8192, 0);
    let s = "";
    var i = 0;
    while i < 8192 {
        var hi = 0;
        var lo = 0;
        var j = 0;
        while j < 8 {
            let a = int_of(s[16 * i + j]);
            let b = int_of(s[16 * i + 8 + j]);
            hi = hi * 16 + (a >> 6) * 9 + (a & 15);
            lo = lo * 16 + (b >> 6) * 9 + (b & 15);
            j = j + 1;
        }
        t[i] = wrapping_add(wrapping_mul(hi, 4294967296), lo);
        i = i + 1;
    }
    return t;
}

// The 8 words of entry (i, j).
pub fn row(i: int, j: int) -> [] &static [int] {
    let at = (16 * i + j) * 8;
    return comb[at..at + 8];
}
