module selfhost.syscode;

// syscode.cho -- the code of a lent system (`docs/bare-system.md`): `system m(a, b) in { .. }` on the target with no
// system under it. What is lent is kept in a global of the module for the length of the block, and the functions the
// hosted builtins call are written here, each passing what was lent, and its own arguments, to the function of the
// program's module.

import selfhost.emit;
import selfhost.mmio;

fn system_at[&s](st: &!s [int], i: int) -> [] int {
    emit.str(st, "ptr getelementptr inbounds ([32 x i64], ptr @cancho_sys_lent, i64 0, i64 ");
    emit.nat(st, i);
    return emit.str(st, ")");
}

// Has a `system` block already been written into this module? (Its globals are among the constants.)
pub fn system_seen[&s](st: &!s [int]) -> [] bool {
    let mark = "@cancho_sys_lent = ";
    var at = 0;
    while at + len(mark) <= st[57] {
        var k = 0;
        while k < len(mark) && st[st[56] + at + k] == int_of(mark[k]) {
            k = k + 1;
        }
        if k == len(mark) {
            return true;
        }
        at = at + 1;
    }
    return false;
}

// Has a block that runs been written into this module (`@cancho_runs_body` is among the constants)?
pub fn runs_seen[&s](st: &!s [int]) -> [] bool {
    let mark = "define internal i64 @cancho_runs_body(";
    var at = 0;
    while at + len(mark) <= st[57] {
        var k = 0;
        while k < len(mark) && st[st[56] + at + k] == int_of(mark[k]) {
            k = k + 1;
        }
        if k == len(mark) {
            return true;
        }
        at = at + 1;
    }
    return false;
}

// The globals: what is lent, and room for sixty-four arguments of 255 bytes. (Whether something is lent, `@cancho_sys_on`, is
// `runtime/bare.ll`'s, since the trap reads it in every module of this target.)
pub fn system_globals[&s](st: &!s [int]) -> [] int {
    let keep = st[49];
    st[49] = 3;
    emit.str(st, "@cancho_sys_lent = global [32 x i64] zeroinitializer\n@cancho_sys_args = global [64 x [256 x i8]] zeroinitializer\n");
    st[49] = keep;
    return 0;
}

// The last `n` arguments pushed are what is lent: each goes to its place in the global. They stay pushed.
pub fn system_lend[&s](st: &!s [int], n: int) -> [] int {
    let first = st[52] - n;
    var i = 0;
    while i < n {
        let at = st[51] + 4 * (first + i);
        emit.str(st, "  store ");
        emit.llvm_type(st, st[at]);
        emit.str(st, " ");
        emit.operand(st, st[at], st[at + 1] != 0, st[at + 2], st[at + 3]);
        emit.str(st, ", ");
        system_at(st, i);
        emit.str(st, "\n");
        i = i + 1;
    }
    return 0;
}

pub fn system_switch[&s](st: &!s [int], on: bool) -> [] int {
    if on {
        return emit.str(st, "  store i64 1, ptr @cancho_sys_on\n");
    }
    return emit.str(st, "  store i64 0, ptr @cancho_sys_on\n");
}

// The count of arguments the system gave, in the temporary `count`, to where `arg_count` reads it.
pub fn system_count[&s](st: &!s [int], count: int) -> [] int {
    emit.str(st, "  store i64 ");
    emit.temp(st, count);
    return emit.str(st, ", ptr @cancho_argc\n");
}

// The start of one of the functions: nothing lent is a trap; then what is lent, loaded.
fn system_open[&s](st: &!s [int], n: int) -> [] int {
    emit.str(st, "  %on = load i64, ptr @cancho_sys_on\n  %off = icmp eq i64 %on, 0\n  br i1 %off, label %none, label %lent\nnone:\n  call void @cancho_trap()\n  unreachable\nlent:\n");
    let first = st[52] - n;
    var i = 0;
    while i < n {
        let at = st[51] + 4 * (first + i);
        emit.str(st, "  %l");
        emit.nat(st, i);
        emit.str(st, " = load ");
        emit.llvm_type(st, st[at]);
        emit.str(st, ", ");
        system_at(st, i);
        emit.str(st, "\n");
        i = i + 1;
    }
    return 0;
}

// `%r = call i64 @lexs_<callee>(` and what is lent; the caller writes the operation's own arguments and `)`.
fn system_call[&s](st: &!s [int], callee: int, n: int, more: bool) -> [] int {
    return system_asks(st, callee, n, more, 0 - 1);
}

// The same, with the answer in `%r<turn>` when the function is asked more than once (`turn` at least 0).
fn system_asks[&s](st: &!s [int], callee: int, n: int, more: bool, turn: int) -> [] int {
    emit.str(st, "  %r");
    if turn >= 0 {
        emit.nat(st, turn);
    }
    emit.str(st, " = call i64 @lexs_");
    emit.nat(st, callee);
    emit.str(st, "(");
    let first = st[52] - n;
    var i = 0;
    while i < n {
        let at = st[51] + 4 * (first + i);
        if i > 0 {
            emit.str(st, ", ");
        }
        emit.llvm_type(st, st[at]);
        emit.str(st, " %l");
        emit.nat(st, i);
        i = i + 1;
    }
    if more && n > 0 {
        emit.str(st, ", ");
    }
    return 0;
}

// The function of the runtime that operation `op` is, written among the constants: 1 `out`, 2 `err`, 3 `in`, 4 `flush`,
// 5 `arg`; and the files (`system_files` below). `callee` is the program's function for it, or -1 if its module has
// none: then the function traps. The last `n` arguments pushed are what is lent.
pub fn system_glue[&s](st: &!s [int], op: int, callee: int, n: int) -> [] int {
    let keep = st[49];
    st[49] = 3;
    if op == 1 {
        emit.str(st, "define i64 @cancho_write_bytes(ptr %p, i64 %n) {\nentry:\n");
    } else if op == 2 {
        emit.str(st, "define i64 @write(i32 %fd, ptr %p, i64 %n) {\nentry:\n");
    } else if op == 3 {
        emit.str(st, "define i32 @getchar() {\nentry:\n");
    } else if op == 4 {
        emit.str(st, "define void @cancho_flush_out(ptr %out) {\nentry:\n");
    } else {
        emit.str(st, "define ptr @cancho_arg(i64 %n) {\nentry:\n");
    }
    if callee < 0 {
        emit.str(st, "  call void @cancho_trap()\n  unreachable\n}\n");
        st[49] = keep;
        return 0;
    }
    system_open(st, n);
    if op == 1 || op == 2 {
        system_call(st, callee, n, true);
        emit.str(st, "ptr %p, i64 %n)\n  ret i64 %r\n}\n");
    } else if op == 3 {
        system_call(st, callee, n, false);
        emit.str(st, ")\n  %c = trunc i64 %r to i32\n  ret i32 %c\n}\n");
    } else if op == 4 {
        // what `flush_out` reads: whether it failed, nothing, and why
        system_call(st, callee, n, false);
        emit.str(st, ")\n  %bad = icmp ne i64 %r, 0\n  %f = zext i1 %bad to i64\n  store i64 %f, ptr %out\n  %o1 = getelementptr inbounds i64, ptr %out, i64 1\n  store i64 0, ptr %o1\n  %o2 = getelementptr inbounds i64, ptr %out, i64 2\n  store i64 %r, ptr %o2\n  ret void\n}\n");
    } else {
        // the argument's bytes go to a place of their own, with a zero after them: `arg` measures it as a C string
        emit.str(st, "  %far = icmp uge i64 %n, 64\n  br i1 %far, label %bad, label %near\nbad:\n  call void @cancho_trap()\n  unreachable\nnear:\n  %buf = getelementptr inbounds [64 x [256 x i8]], ptr @cancho_sys_args, i64 0, i64 %n, i64 0\n");
        system_call(st, callee, n, true);
        emit.str(st, "i64 %n, ptr %buf, i64 255)\n  %long = icmp ugt i64 %r, 255\n  br i1 %long, label %bad, label %fits\nfits:\n  %end = getelementptr inbounds i8, ptr %buf, i64 %r\n  store i8 0, ptr %end\n  ret ptr %buf\n}\n");
    }
    if op == 1 {
        // `putchar` is one byte to the same function
        emit.str(st, "define i32 @putchar(i32 %c) {\nentry:\n  %b = alloca i8\n  %t = trunc i32 %c to i8\n  store i8 %t, ptr %b\n  %w = call i64 @cancho_write_bytes(ptr %b, i64 1)\n  ret i32 %c\n}\n");
    }
    st[49] = keep;
    return 0;
}

// The three numbers a directory operation answers, from `%r`: whether it failed, the handle, and why (`-r`).
fn system_triple[&s](st: &!s [int]) -> [] int {
    return emit.str(st, "  %bad = icmp slt i64 %r, 0\n  %f = zext i1 %bad to i64\n  store i64 %f, ptr %out\n  %o1 = getelementptr inbounds i64, ptr %out, i64 1\n  store i64 %r, ptr %o1\n  %neg = sub i64 0, %r\n  %why = select i1 %bad, i64 %neg, i64 0\n  %o2 = getelementptr inbounds i64, ptr %out, i64 2\n  store i64 %why, ptr %o2\n  ret void\n}\n");
}

// The files and directories a lent system reads: 6 `folder` (a path to a directory), 7 `step` (a name under one: 0 a
// directory, 1 a file to read), 8 `open` (a path to a file, and how), 9 `read`, 10 `read_at`, 11 `size`, 12 `close`.
// And what a directory holds: 13 `list` (a listing of one), 14 `next` (its next name, written into the bytes given:
// 0 at the end, else the name's length and 65536 times its kind), 15 a listing closed, which is `close` again, and
// 16 `stat` (a name under a directory, and which of three is asked: 0 its kind, 1 its size, 2 when it was changed).
// And what writes: `step` again (2 a file that must not be there yet, 3 a file to add to, made if it is not there),
// 17 `write` (bytes to a file: how many were taken), 18 `sync` (a file, kept), 19 `lock` (a file, held by no other),
// 20 `rename` (a name under a directory to another under the same one; `fresh` 1 refuses a name that is taken),
// 21 `remove` (a name under a directory), 22 a directory kept, which is `sync` again. And the time: 23 `clock`
// (`wall` 0: milliseconds since a moment of the system's choosing, which only go up; 1: milliseconds since 1970).
// And the network: 24 `dial` (a host and a port, held to the bound of the `Out` first), 25 `receive` (bytes from a
// connection: how many came, 0 at its end) and 26 `send` (bytes to one: how many were taken); a connection is closed by
// `close`, as a file is, so the handles of both are the system's to tell apart.
// Each of the program's functions answers a whole number: a handle or a count, or minus the reason it failed, which is
// what the runtime's own answer. A path was held to the capability's prefix, and a name to being one component, before
// the program's function is asked: those are the language's promises, not the system's.
pub fn system_files[&s](st: &!s [int], op: int, callee: int, n: int) -> [] int {
    let keep = st[49];
    st[49] = 3;
    if op == 6 {
        emit.str(st, "define void @cancho_dir_open(ptr %src, i64 %len, ptr %prefix, i64 %plen, ptr %out) {\nentry:\n");
    } else if op == 7 {
        emit.str(st, "define void @cancho_dir_step(ptr %dir, ptr %name, i64 %len, i64 %which, ptr %out) {\nentry:\n");
    } else if op == 8 {
        emit.str(st, "define i64 @cancho_open(ptr %src, i64 %len, ptr %prefix, i64 %plen, i64 %mode) {\nentry:\n");
    } else if op == 9 {
        emit.str(st, "define i64 @cancho_fd_read(i64 %fd, ptr %p, i64 %n) {\nentry:\n");
    } else if op == 10 {
        emit.str(st, "define i64 @cancho_fd_pread(i64 %fd, ptr %p, i64 %n, i64 %at) {\nentry:\n");
    } else if op == 11 {
        emit.str(st, "define i64 @cancho_fd_size(i64 %fd) {\nentry:\n");
    } else if op == 13 {
        emit.str(st, "define void @cancho_dir_list(ptr %dir, ptr %out) {\nentry:\n");
    } else if op == 14 {
        emit.str(st, "define void @cancho_dir_next(ptr %list, ptr %buf, i64 %room, ptr %out) {\nentry:\n");
    } else if op == 15 {
        emit.str(st, "define i64 @cancho_dir_list_close(i64 %fd) {\nentry:\n");
    } else if op == 16 {
        emit.str(st, "define void @cancho_dir_stat(ptr %dir, ptr %name, i64 %len, ptr %out) {\nentry:\n");
    } else if op == 17 {
        emit.str(st, "define i64 @cancho_fd_write(i64 %fd, ptr %p, i64 %n) {\nentry:\n");
    } else if op == 18 {
        emit.str(st, "define i64 @cancho_fd_sync(i64 %fd) {\nentry:\n");
    } else if op == 19 {
        emit.str(st, "define i64 @cancho_fd_lock(i64 %fd) {\nentry:\n");
    } else if op == 20 {
        emit.str(st, "define void @cancho_dir_rename(ptr %dir, ptr %from, i64 %flen, ptr %to, i64 %tlen, i64 %fresh, ptr %out) {\nentry:\n");
    } else if op == 21 {
        emit.str(st, "define void @cancho_dir_remove(ptr %dir, ptr %name, i64 %len, ptr %out) {\nentry:\n");
    } else if op == 22 {
        emit.str(st, "define void @cancho_dir_sync(ptr %dir, ptr %out) {\nentry:\n");
    } else if op == 23 {
        emit.str(st, "define i64 @cancho_clock_ms(i64 %wall) {\nentry:\n");
    } else if op == 24 {
        // the host and the port are held to the capability's bound first, on every target the same: a trap if not
        emit.str(st, "define void @cancho_net_tcp_connect(ptr %name, i64 %len, i64 %port, ptr %bound, i64 %bound_len, ptr %out) {\nentry:\n  call void @cancho_sys_dial_check(ptr %name, i64 %len, i64 %port, ptr %bound, i64 %bound_len)\n");
    } else if op == 25 {
        emit.str(st, "define void @cancho_net_conn_read(ptr %conn, ptr %buf, i64 %len, ptr %out) {\nentry:\n");
    } else if op == 26 {
        emit.str(st, "define void @cancho_net_conn_write(ptr %conn, ptr %buf, i64 %len, ptr %out) {\nentry:\n");
    } else {
        emit.str(st, "define i64 @cancho_fd_close(i64 %fd) {\nentry:\n");
    }
    if callee < 0 {
        emit.str(st, "  call void @cancho_trap()\n  unreachable\n}\n");
        st[49] = keep;
        return 0;
    }
    system_open(st, n);
    if op == 6 || op == 8 {
        emit.str(st, "  %in = call i1 @cancho_path_covers(ptr %src, i64 %len, ptr %prefix, i64 %plen)\n  br i1 %in, label %go, label %none\ngo:\n");
        system_call(st, callee, n, true);
        if op == 6 {
            emit.str(st, "ptr %src, i64 %len)\n");
            system_triple(st);
        } else {
            emit.str(st, "ptr %src, i64 %len, i64 %mode)\n  ret i64 %r\n}\n");
        }
    } else if op == 7 {
        // a name that is not one component is refused here, as the runtime refuses it: 22 is EINVAL
        emit.str(st, "  %one = call i1 @cancho_sys_component(ptr %name, i64 %len)\n  br i1 %one, label %go, label %no\nno:\n  store i64 1, ptr %out\n  %n1 = getelementptr inbounds i64, ptr %out, i64 1\n  store i64 -1, ptr %n1\n  %n2 = getelementptr inbounds i64, ptr %out, i64 2\n  store i64 22, ptr %n2\n  ret void\ngo:\n  %h = load i64, ptr %dir\n");
        system_call(st, callee, n, true);
        emit.str(st, "i64 %h, ptr %name, i64 %len, i64 %which)\n");
        system_triple(st);
    } else if op == 13 {
        emit.str(st, "  %h = load i64, ptr %dir\n");
        system_call(st, callee, n, true);
        emit.str(st, "i64 %h)\n");
        system_triple(st);
    } else if op == 14 {
        // what `dir_next` reads: 0 a name, 1 the end, 2 a failure; the name's length; its kind; why
        emit.str(st, "  %h = load i64, ptr %list\n");
        system_call(st, callee, n, true);
        emit.str(st, "i64 %h, ptr %buf, i64 %room)\n  %bad = icmp slt i64 %r, 0\n  %end = icmp eq i64 %r, 0\n  %t1 = select i1 %end, i64 1, i64 0\n  %tag = select i1 %bad, i64 2, i64 %t1\n  store i64 %tag, ptr %out\n  %low = and i64 %r, 65535\n  %n0 = select i1 %bad, i64 0, i64 %low\n  %o1 = getelementptr inbounds i64, ptr %out, i64 1\n  store i64 %n0, ptr %o1\n  %high = lshr i64 %r, 16\n  %k0 = select i1 %bad, i64 0, i64 %high\n  %o2 = getelementptr inbounds i64, ptr %out, i64 2\n  store i64 %k0, ptr %o2\n  %neg = sub i64 0, %r\n  %why = select i1 %bad, i64 %neg, i64 0\n  %o3 = getelementptr inbounds i64, ptr %out, i64 3\n  store i64 %why, ptr %o3\n  ret void\n}\n");
    } else if op == 16 {
        // what `dir_stat` reads: whether it failed, the kind, the size, the time it was changed, why. The program's
        // function is asked three times, `which` 0, 1 and 2, and the first that fails is the answer.
        emit.str(st, "  %o1 = getelementptr inbounds i64, ptr %out, i64 1\n  %o2 = getelementptr inbounds i64, ptr %out, i64 2\n  %o3 = getelementptr inbounds i64, ptr %out, i64 3\n  %o4 = getelementptr inbounds i64, ptr %out, i64 4\n  store i64 0, ptr %o1\n  store i64 0, ptr %o2\n  store i64 0, ptr %o3\n  %one = call i1 @cancho_sys_component(ptr %name, i64 %len)\n  br i1 %one, label %go, label %no\nno:\n  store i64 1, ptr %out\n  store i64 22, ptr %o4\n  ret void\ngo:\n  %h = load i64, ptr %dir\n");
        var w = 0;
        while w < 3 {
            system_asks(st, callee, n, true, w);
            emit.str(st, "i64 %h, ptr %name, i64 %len, i64 ");
            emit.nat(st, w);
            emit.str(st, ")\n  %b");
            emit.nat(st, w);
            emit.str(st, " = icmp slt i64 %r");
            emit.nat(st, w);
            emit.str(st, ", 0\n  br i1 %b");
            emit.nat(st, w);
            emit.str(st, ", label %f");
            emit.nat(st, w);
            emit.str(st, ", label %g");
            emit.nat(st, w);
            emit.str(st, "\nf");
            emit.nat(st, w);
            emit.str(st, ":\n  %w");
            emit.nat(st, w);
            emit.str(st, " = sub i64 0, %r");
            emit.nat(st, w);
            emit.str(st, "\n  store i64 1, ptr %out\n  store i64 %w");
            emit.nat(st, w);
            emit.str(st, ", ptr %o4\n  ret void\ng");
            emit.nat(st, w);
            emit.str(st, ":\n");
            w = w + 1;
        }
        emit.str(st, "  store i64 0, ptr %out\n  store i64 %r0, ptr %o1\n  store i64 %r1, ptr %o2\n  store i64 %r2, ptr %o3\n  store i64 0, ptr %o4\n  ret void\n}\n");
    } else if op == 20 {
        // both names are held to being one component, as the runtime holds them: 22 is EINVAL
        emit.str(st, "  %a = call i1 @cancho_sys_component(ptr %from, i64 %flen)\n  %b = call i1 @cancho_sys_component(ptr %to, i64 %tlen)\n  %one = and i1 %a, %b\n  br i1 %one, label %go, label %no\nno:\n  store i64 1, ptr %out\n  %n1 = getelementptr inbounds i64, ptr %out, i64 1\n  store i64 -1, ptr %n1\n  %n2 = getelementptr inbounds i64, ptr %out, i64 2\n  store i64 22, ptr %n2\n  ret void\ngo:\n  %h = load i64, ptr %dir\n");
        system_call(st, callee, n, true);
        emit.str(st, "i64 %h, ptr %from, i64 %flen, ptr %to, i64 %tlen, i64 %fresh)\n");
        system_triple(st);
    } else if op == 21 {
        emit.str(st, "  %one = call i1 @cancho_sys_component(ptr %name, i64 %len)\n  br i1 %one, label %go, label %no\nno:\n  store i64 1, ptr %out\n  %n1 = getelementptr inbounds i64, ptr %out, i64 1\n  store i64 -1, ptr %n1\n  %n2 = getelementptr inbounds i64, ptr %out, i64 2\n  store i64 22, ptr %n2\n  ret void\ngo:\n  %h = load i64, ptr %dir\n");
        system_call(st, callee, n, true);
        emit.str(st, "i64 %h, ptr %name, i64 %len)\n");
        system_triple(st);
    } else if op == 22 {
        emit.str(st, "  %h = load i64, ptr %dir\n");
        system_call(st, callee, n, true);
        emit.str(st, "i64 %h)\n");
        system_triple(st);
    } else if op == 23 {
        // `clock_ms` (0) and `clock_unix_ms` (1): milliseconds, since some moment or since 1970
        system_call(st, callee, n, true);
        emit.str(st, "i64 %wall)\n  ret i64 %r\n}\n");
    } else if op == 24 {
        // what `tcp_connect` reads: whether it failed, the connection's handle, and why
        system_call(st, callee, n, true);
        emit.str(st, "ptr %name, i64 %len, i64 %port)\n");
        system_triple(st);
    } else if op == 25 {
        // what `conn_read` reads: 0 bytes came, 1 the other end closed, 3 a failure (2, not yet, is never answered: a
        // connection here waits); how many; why. Reading into no room is refused as the runtime refuses it: 22 is EINVAL
        emit.str(st, "  %h = load i64, ptr %conn\n  %o1 = getelementptr inbounds i64, ptr %out, i64 1\n  %o2 = getelementptr inbounds i64, ptr %out, i64 2\n  %nothing = icmp eq i64 %len, 0\n  br i1 %nothing, label %no, label %go\nno:\n  store i64 3, ptr %out\n  store i64 -1, ptr %o1\n  store i64 22, ptr %o2\n  ret void\ngo:\n");
        system_call(st, callee, n, true);
        emit.str(st, "i64 %h, ptr %buf, i64 %len)\n  %bad = icmp slt i64 %r, 0\n  %end = icmp eq i64 %r, 0\n  %t1 = select i1 %end, i64 1, i64 0\n  %tag = select i1 %bad, i64 3, i64 %t1\n  store i64 %tag, ptr %out\n  store i64 %r, ptr %o1\n  %neg = sub i64 0, %r\n  %why = select i1 %bad, i64 %neg, i64 0\n  store i64 %why, ptr %o2\n  ret void\n}\n");
    } else if op == 26 {
        // what `conn_write` reads: 0 so many were taken, 2 a failure (1, not yet, is never answered); how many; why
        emit.str(st, "  %h = load i64, ptr %conn\n");
        system_call(st, callee, n, true);
        emit.str(st, "i64 %h, ptr %buf, i64 %len)\n  %bad = icmp slt i64 %r, 0\n  %tag = select i1 %bad, i64 2, i64 0\n  store i64 %tag, ptr %out\n  %o1 = getelementptr inbounds i64, ptr %out, i64 1\n  store i64 %r, ptr %o1\n  %neg = sub i64 0, %r\n  %why = select i1 %bad, i64 %neg, i64 0\n  %o2 = getelementptr inbounds i64, ptr %out, i64 2\n  store i64 %why, ptr %o2\n  ret void\n}\n");
    } else if op == 9 || op == 17 {
        system_call(st, callee, n, true);
        emit.str(st, "i64 %fd, ptr %p, i64 %n)\n  ret i64 %r\n}\n");
    } else if op == 10 {
        system_call(st, callee, n, true);
        emit.str(st, "i64 %fd, i64 %at, ptr %p, i64 %n)\n  ret i64 %r\n}\n");
    } else {
        system_call(st, callee, n, true);
        emit.str(st, "i64 %fd)\n  ret i64 %r\n}\n");
    }
    st[49] = keep;
    return 0;
}

// ------------------------------------------------------------ a block that runs (docs/bare-system.md, 11e) ---
//
// The block `at .. at + size` is the program's. From `at`: 0 the state (0 fresh, 1 running, 2 ended, 3 failed), 8 the value it
// ended with or why it failed, 16 where, 24 its 21 saved registers, 192 its allocator's record (52 words), 608 the whole numbers and
// booleans the body copies; its heap from 1024 to the stack's end, three quarters in; its stack from there to the top. The
// kernel's registers, while a program runs, are in `@cancho_sys_back`.

// The functions of a module with a block that runs, written once: the switch (the 21 words the processor's calling rules keep:
// x19 to x30, the stack pointer, d8 to d15, stored at the first argument and loaded from the second), where a program begins and
// ends, where it fails (the trap calls it through `@cancho_runs_hook`), and what the system's functions do around the module's.
pub fn runs_functions[&s](st: &!s [int]) -> [] int {
    let keep = st[49];
    st[49] = 3;
    emit.str(st, "@cancho_sys_back = internal global [21 x i64] zeroinitializer\n@cancho_sys_block = internal global ptr null\n");
    emit.str(st, "module asm \".text\"\nmodule asm \".p2align 2\"\nmodule asm \"cancho_switch:\"\n");
    emit.str(st, "module asm \"  stp x19, x20, [x0, #0]\"\nmodule asm \"  stp x21, x22, [x0, #16]\"\nmodule asm \"  stp x23, x24, [x0, #32]\"\nmodule asm \"  stp x25, x26, [x0, #48]\"\nmodule asm \"  stp x27, x28, [x0, #64]\"\nmodule asm \"  stp x29, x30, [x0, #80]\"\nmodule asm \"  mov x9, sp\"\nmodule asm \"  str x9, [x0, #96]\"\nmodule asm \"  stp d8, d9, [x0, #104]\"\nmodule asm \"  stp d10, d11, [x0, #120]\"\nmodule asm \"  stp d12, d13, [x0, #136]\"\nmodule asm \"  stp d14, d15, [x0, #152]\"\n");
    emit.str(st, "module asm \"  ldp x19, x20, [x1, #0]\"\nmodule asm \"  ldp x21, x22, [x1, #16]\"\nmodule asm \"  ldp x23, x24, [x1, #32]\"\nmodule asm \"  ldp x25, x26, [x1, #48]\"\nmodule asm \"  ldp x27, x28, [x1, #64]\"\nmodule asm \"  ldp x29, x30, [x1, #80]\"\nmodule asm \"  ldr x9, [x1, #96]\"\nmodule asm \"  mov sp, x9\"\nmodule asm \"  ldp d8, d9, [x1, #104]\"\nmodule asm \"  ldp d10, d11, [x1, #120]\"\nmodule asm \"  ldp d12, d13, [x1, #136]\"\nmodule asm \"  ldp d14, d15, [x1, #152]\"\nmodule asm \"  ret\"\n");
    emit.str(st, "declare void @cancho_switch(ptr, ptr)\n");
    // a program begins here, on its own stack, and ends with the value of its body
    emit.str(st, "define internal void @cancho_runs_start() noreturn noinline {\nentry:\n  %b = load ptr, ptr @cancho_sys_block\n  %c = getelementptr i8, ptr %b, i64 608\n  %v = call i64 @cancho_runs_body(ptr %c)\n  %vp = getelementptr i64, ptr %b, i64 1\n  store i64 %v, ptr %vp\n  store i64 2, ptr %b\n  store i64 0, ptr @cancho_sys_on\n  %r = getelementptr i8, ptr %b, i64 24\n  call void @cancho_switch(ptr %r, ptr @cancho_sys_back)\n  unreachable\n}\n\n");
    // a program fails: why, and where the trap was called from
    emit.str(st, "define internal void @cancho_runs_failed(ptr %at) noreturn noinline {\nentry:\n  %b = load ptr, ptr @cancho_sys_block\n  %w = load i64, ptr @cancho_sys_why\n  %none = icmp eq i64 %w, 0\n  %why = select i1 %none, i64 1, i64 %w\n  store i64 3, ptr %b\n  %wp = getelementptr i64, ptr %b, i64 1\n  store i64 %why, ptr %wp\n  %where = ptrtoint ptr %at to i64\n  %ap = getelementptr i64, ptr %b, i64 2\n  store i64 %where, ptr %ap\n  store i64 0, ptr @cancho_sys_why\n  store i64 0, ptr @cancho_sys_on\n  %r = getelementptr i8, ptr %b, i64 24\n  call void @cancho_switch(ptr %r, ptr @cancho_sys_back)\n  unreachable\n}\n\n");
    // the kernel enters the block, and is back when the program has ended or failed
    emit.str(st, "define internal void @cancho_runs_enter(ptr %b, i64 %size) noinline {\nentry:\n  %a = ptrtoint ptr %b to i64\n  store i64 1, ptr %b\n  %vp = getelementptr i64, ptr %b, i64 1\n  store i64 0, ptr %vp\n  %ap = getelementptr i64, ptr %b, i64 2\n  store i64 0, ptr %ap\n  %top = add i64 %a, %size\n  %q = lshr i64 %size, 2\n  %low = sub i64 %top, %q\n  %rec = getelementptr i8, ptr %b, i64 192\n  call void @llvm.memset.p0.i64(ptr %rec, i8 0, i64 416, i1 false)\n  %heap = add i64 %a, 1024\n  %h50 = getelementptr i64, ptr %rec, i64 50\n  store i64 %heap, ptr %h50\n  %h51 = getelementptr i64, ptr %rec, i64 51\n  store i64 %low, ptr %h51\n  %regs = getelementptr i8, ptr %b, i64 24\n  call void @llvm.memset.p0.i64(ptr %regs, i8 0, i64 168, i1 false)\n  %lr = getelementptr i64, ptr %regs, i64 11\n  store ptr @cancho_runs_start, ptr %lr\n  %sp = getelementptr i64, ptr %regs, i64 12\n  store i64 %top, ptr %sp\n  store ptr %b, ptr @cancho_sys_block\n  store ptr %rec, ptr @cancho_bare_arena\n  %end = add i64 %low, 4096\n  store i64 %end, ptr @cancho_stack_end\n  store ptr @cancho_runs_failed, ptr @cancho_runs_hook\n  store i64 1, ptr @cancho_sys_on\n  call void @cancho_switch(ptr @cancho_sys_back, ptr %regs)\n  store i64 0, ptr @cancho_stack_end\n  store ptr null, ptr @cancho_bare_arena\n  store ptr null, ptr @cancho_runs_hook\n  store ptr null, ptr @cancho_sys_block\n  ret void\n}\n\n");
    // around the module's function, while a program runs: room on its stack for the kernel's answer (16 KiB, or the program
    // fails, why 3), and the answer made by the kernel, with the kernel's allocator
    emit.str(st, "define internal void @cancho_runs_away() {\nentry:\n  %h = load ptr, ptr @cancho_runs_hook\n  %none = icmp eq ptr %h, null\n  br i1 %none, label %done, label %program\nprogram:\n  %sp = call i64 asm \"mov $0, sp\", \"=r\"()\n  %need = sub i64 %sp, 16384\n  %end = load i64, ptr @cancho_stack_end\n  %deep = icmp ult i64 %need, %end\n  br i1 %deep, label %over, label %room\nover:\n  store i64 3, ptr @cancho_sys_why\n  call void @cancho_trap()\n  unreachable\nroom:\n  store i64 2, ptr @cancho_sys_on\n  store ptr null, ptr @cancho_bare_arena\n  br label %done\ndone:\n  ret void\n}\n\n");
    emit.str(st, "define internal void @cancho_runs_back() {\nentry:\n  %h = load ptr, ptr @cancho_runs_hook\n  %none = icmp eq ptr %h, null\n  br i1 %none, label %done, label %program\nprogram:\n  store i64 1, ptr @cancho_sys_on\n  %b = load ptr, ptr @cancho_sys_block\n  %rec = getelementptr i8, ptr %b, i64 192\n  store ptr %rec, ptr @cancho_bare_arena\n  br label %done\ndone:\n  ret void\n}\n\n");
    st[49] = keep;
    return 0;
}

// Does the line of buffer 3 from `at` to `end` begin with `s`?
fn line_begins[&s](st: &!s [int], at: int, end: int, s: &static [byte]) -> [] bool {
    if end - at < len(s) {
        return false;
    }
    var k = 0;
    while k < len(s) {
        if st[st[56] + at + k] != int_of(s[k]) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn line_has[&s](st: &!s [int], at: int, end: int, s: &static [byte]) -> [] bool {
    var i = at;
    while i + len(s) <= end {
        if line_begins(st, i, end, s) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn place_text[&s](st: &!s [int], at: int, s: &static [byte]) -> [] int {
    var k = 0;
    while k < len(s) {
        st[st[56] + at + k] = int_of(s[k]);
        k = k + 1;
    }
    return 0;
}

// The system's functions written from `from` in buffer 3, for a block that runs: before each call of the module's function
// `@cancho_runs_away()`, and before each `ret` `@cancho_runs_back()` (which is nothing where none was away). In place, from the
// end, so that nothing is copied twice.
pub fn runs_wrap[&s](st: &!s [int], from: int) -> [] int {
    let away = "  call void @cancho_runs_away()\n";
    let back = "  call void @cancho_runs_back()\n";
    let end = st[57];
    var extra = 0;
    var at = from;
    while at < end {
        var e = at;
        while e < end && st[st[56] + e] != 10 {
            e = e + 1;
        }
        if e < end {
            e = e + 1;
        }
        if line_begins(st, at, e, "  ret ") {
            extra = extra + len(back);
        }
        if line_has(st, at, e, "@lexs_") {
            extra = extra + len(away);
        }
        at = e;
    }
    if end + extra > st[50] {
        // too long for its buffer: `emit.overflowed` says the code is no good
        st[57] = st[50] + 1;
        return 0;
    }
    var src = end;
    var dst = end + extra;
    while src > from {
        var start = src - 1;
        while start > from && st[st[56] + start - 1] != 10 {
            start = start - 1;
        }
        let is_ret = line_begins(st, start, src, "  ret ");
        let is_call = line_has(st, start, src, "@lexs_");
        var i = src;
        while i > start {
            i = i - 1;
            dst = dst - 1;
            st[st[56] + dst] = st[st[56] + i];
        }
        src = start;
        if is_ret {
            dst = dst - len(back);
            place_text(st, dst, back);
        }
        if is_call {
            dst = dst - len(away);
            place_text(st, dst, away);
        }
    }
    st[57] = end + extra;
    return 0;
}

// The body of the block, which the checker wrote into the function (buffer 1 from `m1`, its `alloca`s in buffer 2 from `m2`), is
// cut out and becomes `@cancho_runs_body`, among the constants: it is handed where the copies are, makes a slot for each binding of
// the function it named, fills it, and runs. A body that reaches its end ends with 0.
pub fn runs_cut[&s](st: &!s [int], m1: int, m2: int) -> [] int {
    let keep = st[49];
    st[49] = 3;
    emit.str(st, "define internal i64 @cancho_runs_body(ptr %copies) {\nentry:\n");
    var i = m2;
    while i < st[48] {
        emit.put(st, st[st[47] + i]);
        i = i + 1;
    }
    var k = 0;
    while k < st[69] {
        emit.str(st, "  %s");
        emit.nat(st, st[70 + 2 * k]);
        emit.str(st, " = alloca ");
        emit.llvm_type(st, st[71 + 2 * k]);
        emit.str(st, "\n");
        k = k + 1;
    }
    k = 0;
    while k < st[69] {
        emit.str(st, "  %runs.p");
        emit.nat(st, k);
        emit.str(st, " = getelementptr i64, ptr %copies, i64 ");
        emit.nat(st, k);
        emit.str(st, "\n  %runs.v");
        emit.nat(st, k);
        emit.str(st, " = load ");
        emit.llvm_type(st, st[71 + 2 * k]);
        emit.str(st, ", ptr %runs.p");
        emit.nat(st, k);
        emit.str(st, "\n  store ");
        emit.llvm_type(st, st[71 + 2 * k]);
        emit.str(st, " %runs.v");
        emit.nat(st, k);
        emit.str(st, ", ptr %s");
        emit.nat(st, st[70 + 2 * k]);
        emit.str(st, "\n");
        k = k + 1;
    }
    i = m1;
    while i < st[46] {
        emit.put(st, st[st[45] + i]);
        i = i + 1;
    }
    emit.str(st, "  ret i64 0\n}\n\n");
    st[46] = m1;
    st[48] = m2;
    st[49] = keep;
    return 0;
}

// Where the block was, in the function: `at` and `size` held to what `runs` asks (a trap with nothing lent, the kernel's, if
// not: `size` a power of two of 64 KiB or more, `at` a multiple of 16, the block inside one range of the bound `text[from..to]`
// of `mem`, the empty bound being every address); then, if the state is 0, the copies and the program, until it has ended or
// failed.
pub fn runs_site[&s, &x](st: &!s [int], text: &x [byte], from: int, to: int, ak: bool, av: int, ar: int, zk: bool, zv: int, zr: int) -> [] int {
    emit.str(st, "  %runs.at = add i64 0, ");
    emit.operand(st, 1, ak, av, ar);
    emit.str(st, "\n  %runs.size = add i64 0, ");
    emit.operand(st, 1, zk, zv, zr);
    emit.str(st, "\n  %runs.m1 = sub i64 %runs.size, 1\n  %runs.pow = and i64 %runs.size, %runs.m1\n  %runs.npow = icmp ne i64 %runs.pow, 0\n  %runs.small = icmp ult i64 %runs.size, 65536\n  %runs.odd = and i64 %runs.at, 15\n  %runs.nodd = icmp ne i64 %runs.odd, 0\n  %runs.b1 = or i1 %runs.npow, %runs.small\n  %runs.b2 = or i1 %runs.b1, %runs.nodd\n");
    let ranges = mmio.count(text, from, to);
    if ranges > 0 {
        emit.str(st, "  %runs.in0 = icmp ne i64 0, 0\n");
        var k = 0;
        while k < ranges {
            let lo = mmio.low(text, from, to, k);
            let hi = mmio.high(text, from, to, k);
            // inside: lo <= at, at <= hi, size <= hi - at
            emit.str(st, "  %runs.lo");
            emit.nat(st, k);
            emit.str(st, " = icmp uge i64 %runs.at, ");
            emit.nat(st, lo);
            emit.str(st, "\n  %runs.hi");
            emit.nat(st, k);
            emit.str(st, " = icmp ule i64 %runs.at, ");
            emit.nat(st, hi);
            emit.str(st, "\n  %runs.room");
            emit.nat(st, k);
            emit.str(st, " = sub i64 ");
            emit.nat(st, hi);
            emit.str(st, ", %runs.at\n  %runs.fits");
            emit.nat(st, k);
            emit.str(st, " = icmp ule i64 %runs.size, %runs.room");
            emit.nat(st, k);
            emit.str(st, "\n  %runs.a");
            emit.nat(st, k);
            emit.str(st, " = and i1 %runs.lo");
            emit.nat(st, k);
            emit.str(st, ", %runs.hi");
            emit.nat(st, k);
            emit.str(st, "\n  %runs.c");
            emit.nat(st, k);
            emit.str(st, " = and i1 %runs.a");
            emit.nat(st, k);
            emit.str(st, ", %runs.fits");
            emit.nat(st, k);
            emit.str(st, "\n  %runs.in");
            emit.nat(st, k + 1);
            emit.str(st, " = or i1 %runs.in");
            emit.nat(st, k);
            emit.str(st, ", %runs.c");
            emit.nat(st, k);
            emit.str(st, "\n");
            k = k + 1;
        }
        emit.str(st, "  %runs.out = xor i1 %runs.in");
        emit.nat(st, ranges);
        emit.str(st, ", true\n  %runs.bad = or i1 %runs.b2, %runs.out\n");
    } else {
        emit.str(st, "  %runs.bad = or i1 %runs.b2, false\n");
    }
    emit.str(st, "  br i1 %runs.bad, label %runs.wrong, label %runs.right\nruns.wrong:\n  call void @cancho_trap()\n  unreachable\nruns.right:\n  %runs.b = inttoptr i64 %runs.at to ptr\n  %runs.state = load i64, ptr %runs.b\n  %runs.fresh = icmp eq i64 %runs.state, 0\n  br i1 %runs.fresh, label %runs.go, label %runs.past\nruns.go:\n");
    var k = 0;
    while k < st[69] {
        emit.str(st, "  %runs.q");
        emit.nat(st, k);
        emit.str(st, " = getelementptr i8, ptr %runs.b, i64 ");
        emit.nat(st, 608 + 8 * k);
        emit.str(st, "\n  %runs.x");
        emit.nat(st, k);
        emit.str(st, " = load ");
        emit.llvm_type(st, st[71 + 2 * k]);
        emit.str(st, ", ptr %s");
        emit.nat(st, st[70 + 2 * k]);
        emit.str(st, "\n  store ");
        emit.llvm_type(st, st[71 + 2 * k]);
        emit.str(st, " %runs.x");
        emit.nat(st, k);
        emit.str(st, ", ptr %runs.q");
        emit.nat(st, k);
        emit.str(st, "\n");
        k = k + 1;
    }
    return emit.str(st, "  call void @cancho_runs_enter(ptr %runs.b, i64 %runs.size)\n  br label %runs.past\nruns.past:\n");
}
