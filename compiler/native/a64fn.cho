edition 7;
module selfhost.a64fn;

// a64fn.cho -- a function of the module into AArch64 instructions (`docs/native-backend.md` section 12): its frame, its entry, its blocks and the branches
// between them, and its end; and `generate`, which does it for every function of a module. What one instruction is, is `a64gen.cho`'s.
//
// The frame, from the stack pointer up: the arguments of the calls the function makes that go on the stack; the scratch bytes; a slot for each value; the
// bytes of each `alloca`; then, at the frame pointer, the caller's frame pointer and the return address. The stack pointer does not move between the entry
// and the end, so a slot is at one offset from it throughout.

import selfhost.llmod as lm;
import selfhost.llread as lr;
import selfhost.llbody as lb;
import selfhost.lltop as lt;
import selfhost.lllayout as ly;
import selfhost.llout as out;
import selfhost.a64;
import selfhost.a64frame as fr;
import selfhost.a64call as cc;
import selfhost.a64gen as gen;
import selfhost.mem2reg as m2;
import selfhost.regalloc as ra;

fn op_of[&m](m: &m [int], rec: int) -> [] int {
    return lm.cell(m, rec + 2);
}

fn opnd[&m](m: &m [int], rec: int, k: int) -> [] int {
    return rec + lb.instr_head() + 4 * k;
}

// The record after `rec`.
fn next[&m](m: &m [int], rec: int) -> [] int {
    return m2.next(m, rec);
}

// The first instruction at or after `rec` (constants are records too, and come before what uses them): its record, or 0 at the end of the block.
fn instruction_at[&m](m: &m [int], rec: int) -> [] int {
    var at = rec;
    while at < lm.cell(m, lm.h_top()) && lm.cell(m, at) == lr.r_const() {
        at = next(m, at);
    }
    if lm.cell(m, at) == lr.r_instr() {
        return at;
    }
    return 0;
}

// ---- the frame ----

// Is local `id` one that has no slot of its own once the variables are values (`promoted`): a promoted `alloca`, or a promoted `load` that is another local,
// whose slot it shares (section 17.2)?
fn shared[&s](s: &s [int], id: int, promoted: bool) -> [] bool {
    if !promoted {
        return false;
    }
    let i = m2.instruction_of(s, id);
    if i < 0 {
        return false;
    }
    let what = m2.action(s, i);
    return what == m2.a_removed() || what == m2.a_replaced() && m2.kind(m2.replacement(s, i)) == m2.v_local();
}

// The frame of the function at `func`: a slot for every value, the bytes of every `alloca`, the stack its calls need, and the scratch bytes, which are as
// large as the largest value any instruction works on. With the variables made values (`promoted`, the side table `s`), a promoted `alloca` has neither, a
// promoted `load` that is another local has that local's slot, and each new `phi` has two slots as the module's own do.
fn frame[&m, &s, &o](m: &m [int], s: &s [int], o: &!o [int], func: int, promoted: bool) -> [] int {
    let names = lm.cell(m, func + 9);
    let n = lm.cell(m, names + 2);
    var stack = 0;
    var largest = 16;
    var at = next(m, func);
    while at < lm.cell(m, lm.h_top()) && lm.cell(m, at) != lr.r_end() {
        if lm.cell(m, at) == lr.r_instr() {
            o[out.h_line()] = lm.cell(m, at + 8);
            let bytes = gen.call_stack(m, o, at);
            if bytes > stack {
                stack = bytes;
            }
            let result = ly.size_of(m, lm.cell(m, at + 6));
            if result > largest {
                largest = result;
            }
            var k = 0;
            while k < lm.cell(m, at + 9) {
                let size = ly.size_of(m, lm.cell(m, opnd(m, at, k)));
                if size > largest && lm.cell(m, opnd(m, at, k) + 1) != lr.o_type() {
                    largest = size;
                }
                k = k + 1;
            }
        }
        at = next(m, at);
    }
    o[out.h_out_area()] = (stack + 15) / 16 * 16;
    o[out.h_frame()] = o[out.h_out_area()];
    if o[out.h_saved()] != 0 {
        // The registers the allocation uses and the caller keeps, just above the arguments, where a pair of them is reached in one instruction.
        o[out.h_save_at()] = out.reserve(o, 8 * saved_count(o[out.h_saved()]), 16);
    }
    o[cc.h_scratch()] = out.reserve(o, largest, 16);
    if cc.in_memory(m, lm.cell(m, func + 5)) {
        o[out.h_sret()] = out.reserve(o, 8, 8);
    }
    var id = 0;
    while id < n && !out.failed(o) {
        let info = names + 3 + 4 * id;
        let ty = lm.cell(m, info + 2);
        let def = lm.cell(m, info + 1);
        if lm.cell(m, info + 3) == 0 && ty != lm.ty_void() && !shared(s, id, promoted) {
            if lm.type_kind(m, lm.resolved(m, ty)) == lm.k_vector() {
                o[out.h_line()] = lm.cell(m, def + 8);
                return out.fail(o, out.why_vector());
            }
            var align = ly.align_of(m, ty);
            out.set_slot(o, id, out.reserve(o, ly.size_of(m, ty), align));
            if lm.cell(m, def) == lr.r_instr() && op_of(m, def) == lr.op_phi() {
                out.set_phi_slot(o, id, out.reserve(o, ly.size_of(m, ty), align));
            }
            if lm.cell(m, def) == lr.r_instr() && op_of(m, def) == lr.op_alloca() {
                // The bytes it is the address of: so many of a type, the count a number.
                let of = lm.cell(m, opnd(m, def, 0));
                var count = 1;
                if lm.cell(m, def + 3) & lr.f_counted() != 0 {
                    let c = fr.constant(m, opnd(m, def, 1), 0);
                    if !c.good || c.slot >= 0 || c.offset < 0 || c.offset > 1 << 30 {
                        o[out.h_line()] = lm.cell(m, def + 8);
                        return out.fail(o, out.why_alloca());
                    }
                    count = c.offset;
                }
                align = ly.align_of(m, of);
                if lm.cell(m, def + 7) > align {
                    align = lm.cell(m, def + 7);
                }
                if align > 16 || ly.size_of(m, of) > 1 << 30 {
                    o[out.h_line()] = lm.cell(m, def + 8);
                    return out.fail(o, out.why_frame());
                }
                out.set_phi_slot(o, id, out.reserve(o, ly.size_of(m, of) * count, align));
            }
        }
        id = id + 1;
    }
    if promoted {
        var k = 0;
        while k < m2.phis(s) && !out.failed(o) {
            let ty = m2.phi_type(s, k);
            out.set_slot(o, n + k, out.reserve(o, ly.size_of(m, ty), ly.align_of(m, ty)));
            out.set_phi_slot(o, n + k, out.reserve(o, ly.size_of(m, ty), ly.align_of(m, ty)));
            k = k + 1;
        }
        id = 0;
        while id < n && !out.failed(o) {
            let i = m2.instruction_of(s, id);
            if i >= 0 && m2.action(s, i) == m2.a_replaced() && m2.kind(m2.replacement(s, i)) == m2.v_local() {
                out.set_slot(o, id, out.slot(o, m2.value_of(m2.replacement(s, i))));
            }
            id = id + 1;
        }
    }
    o[out.h_frame()] = (o[out.h_frame()] + 15) / 16 * 16;
    return 0;
}

// The entry: the two registers saved, the frame pointer set, the frame made, and each parameter moved from where the caller put it into its slot.
fn entry[&m, &o](m: &m [int], o: &!o [int], func: int) -> [] int {
    let size = o[out.h_frame()];
    out.emit(o, a64.load_store_pair(1, 0, 3, 0, 29, 30, 31, 0 - 2));
    out.emit(o, a64.addsub_imm(1, 0, 0, 29, 31, 0, 0));
    if size < 4096 {
        out.emit(o, a64.addsub_imm(1, 1, 0, 31, 31, size, 0));
    } else if size < 1 << 24 {
        out.emit(o, a64.addsub_imm(1, 1, 0, 31, 31, size >> 12, 1));
        if size & 4095 != 0 {
            out.emit(o, a64.addsub_imm(1, 1, 0, 31, 31, size & 4095, 0));
        }
    } else {
        fr.mov_imm(o, 17, size);
        out.emit(o, a64.addsub_ext(1, 1, 0, 31, 31, 17, 3, 0));
    }
    saved(o, 0);
    if o[out.h_sret()] >= 0 {
        fr.access(o, 3, 0, 0, 8, fr.sp(), o[out.h_sret()]);
    }
    cc.reset(o);
    var k = 0;
    while k < lm.cell(m, func + 6) && !out.failed(o) {
        let p = func + lt.func_head() + 3 * k;
        let ty = lm.cell(m, p);
        let id = lm.cell(m, p + 1);
        if id >= 0 && out.slot(o, id) >= 0 && out.reg(o, id) >= 0 && cc.one_register(m, ty) {
            cc.from_register(m, o, ty, out.reg(o, id), cc.w_parameter());
        } else if id >= 0 && out.slot(o, id) >= 0 {
            fr.add_offset(o, 14, fr.sp(), out.slot(o, id));
            cc.walk(m, o, ty, 0, cc.w_parameter(), 0);
        } else {
            // A parameter with no name still took its registers.
            cc.walk(m, o, ty, 0, cc.w_count(), 0);
        }
        k = k + 1;
    }
    return 0;
}

// How many registers the mask `saved` (bit `r` for `x<r>`, `32 + r` for `d<r>`) has.
fn saved_count(saved: int) -> [] int {
    var n = 0;
    var bit = 0;
    while bit < 64 {
        if saved >> bit & 1 == 1 {
            n = n + 1;
        }
        bit = bit + 1;
    }
    return n;
}

// The registers the allocation uses that a caller keeps, written to their place in the frame (`load` 0) or read back from it (1): in pairs where two of a
// kind are next to each other and the offset is one a pair reaches.
fn saved[&o](o: &!o [int], load: int) -> [] int {
    let mask = o[out.h_saved()];
    var at = o[out.h_save_at()];
    var pending = 0 - 1;
    var bit = 0;
    while bit < 64 {
        if mask >> bit & 1 == 1 {
            if pending >= 0 && pending >> 5 == bit >> 5 && (at - 8) / 8 < 64 {
                out.emit(o, a64.load_store_pair(1, bit >> 5, 2, load, pending & 31, bit & 31, fr.sp(), (at - 8) / 8));
                pending = 0 - 1;
            } else {
                if pending >= 0 {
                    fr.access(o, 3, pending >> 5, load, pending & 31, fr.sp(), at - 8);
                }
                pending = bit;
            }
            at = at + 8;
        }
        bit = bit + 1;
    }
    if pending >= 0 {
        fr.access(o, 3, pending >> 5, load, pending & 31, fr.sp(), at - 8);
    }
    return 0;
}

// The end: the registers kept for the caller restored, the frame given back, the two registers restored, and the return.
fn leave[&o](o: &!o [int]) -> [] int {
    saved(o, 1);
    out.emit(o, a64.addsub_imm(1, 0, 0, 31, 29, 0, 0));
    out.emit(o, a64.load_store_pair(1, 0, 1, 1, 29, 30, 31, 2));
    out.emit(o, a64.branch_reg(2, 30));
    return 0;
}

// ---- blocks ----

// The record of the block whose label is local `id` of the function at `func`.
fn block_of[&m](m: &m [int], func: int, id: int) -> [] int {
    let names = lm.cell(m, func + 9);
    if id < 0 || id >= lm.cell(m, names + 2) {
        return 0;
    }
    return lm.cell(m, names + 3 + 4 * id + 1);
}

// A value of the side table (`mem2reg.cho`) of type `ty`, a scalar, written at `x14`: a local's from its slot, an operand of the module, or zero.
fn put_value[&t, &m, &o](text: &t [byte], m: &m [int], o: &!o [int], value: int, ty: int) -> [] int {
    var size = fr.word_size(m, ty);
    if size < 0 && fr.float_kind(m, ty) >= 0 {
        size = 2 + fr.float_kind(m, ty);
    }
    if size < 0 {
        return out.fail(o, out.why_operand());
    }
    if m2.kind(value) == m2.v_local() {
        let slot = out.slot(o, m2.value_of(value));
        if slot < 0 {
            return out.fail(o, out.why_operand());
        }
        if fr.spill(m, o, m2.value_of(value), ty, 14, 0) {
            return 0;
        }
        fr.access(o, size, 0, 1, 9, fr.sp(), slot);
        return fr.access(o, size, 0, 0, 9, 14, 0);
    }
    if m2.kind(value) == m2.v_operand() {
        return fr.store_value(text, m, o, m2.value_of(value), ty, 0, 0);
    }
    return fr.access(o, size, 0, 0, 31, 14, 0);
}

// A jump from the block being written (number `from`) to the block of label `id`: each `phi` of that block is given the value it has when it is come to from
// here (into its second slot: the block moves them all into the first when it begins, so that one `phi` may read another's old value), the new `phi`s of the
// side table too, and then the branch.
//
// A `phi` that has a register is given its value here, not through its second slot: the moves of all of them are one parallel copy (each reads what was there
// before any is written), made after the `phi`s in memory have been given theirs, which read the same old values.
fn jump[&t, &m, &s, &o](text: &t [byte], m: &m [int], s: &s [int], o: &!o [int], func: int, id: int, promoted: bool, from: int) -> [] int {
    let block = block_of(m, func, id);
    if block == 0 || lm.cell(m, block) != lr.r_block() {
        return out.fail(o, out.why_operand());
    }
    var moves = 0;
    var at = instruction_at(m, next(m, block));
    while at != 0 && op_of(m, at) == lr.op_phi() && !out.failed(o) {
        let phi = lm.cell(m, at + 4);
        var k = 0;
        var found = false;
        while k + 1 < lm.cell(m, at + 9) && !found {
            if lm.cell(m, opnd(m, at, k + 1) + 2) == o[cc.h_block()] {
                found = true;
                if out.reg(o, phi) >= 0 {
                    moves = add_move(m, o, moves, phi, lm.cell(m, at + 6), 0, opnd(m, at, k), fr.register_of(m, o, opnd(m, at, k)));
                } else {
                    fr.add_offset(o, 14, fr.sp(), out.phi_slot(o, phi));
                    fr.store_value(text, m, o, opnd(m, at, k), lm.cell(m, at + 6), 0, 0);
                }
            }
            k = k + 2;
        }
        if !found || out.phi_slot(o, phi) < 0 {
            // A `phi` with no value for a block that jumps to it.
            return out.fail(o, out.why_operand());
        }
        at = instruction_at(m, next(m, at));
    }
    if promoted {
        let to = m2.block_of(s, id);
        var j = 0;
        while j < m2.block_phis(s, to) && !out.failed(o) {
            let k = m2.block_phi(s, to, j);
            let value = m2.phi_value_from(s, k, from);
            if value < 0 {
                return out.fail(o, out.why_operand());
            }
            let phi = m2.names(s) + k;
            if out.reg(o, phi) >= 0 {
                var r = 0 - 1;
                if m2.kind(value) == m2.v_local() {
                    r = out.reg(o, m2.value_of(value));
                }
                moves = add_move(m, o, moves, phi, m2.phi_type(s, k), 1, value, r);
            } else {
                fr.add_offset(o, 14, fr.sp(), out.phi_slot(o, phi));
                put_value(text, m, o, value, m2.phi_type(s, k));
            }
            j = j + 1;
        }
    }
    parallel_copy(text, m, o, moves);
    out.fixup(o, out.here(o), id);
    out.emit(o, a64.branch(0, 0));
    return 0;
}

// ---- the moves of a jump into the `phi`s that have registers ----
//
// Five cells a move, in the output's room for them: the register it writes (`d` ones 32 on, so that the two kinds are one set of numbers), the register it
// reads (the same way; -1: what it reads is in memory or a constant), the type, and what it reads: 0 and an operand of the module, or 1 and a value of the
// side table (`mem2reg.cho`).

fn move_cell[&o](o: &o [int], k: int, c: int) -> [] int {
    return lm.cell(o, o[out.h_moves()] + 5 * k + c);
}

fn set_move[&o](o: &!o [int], k: int, c: int, value: int) -> [] int {
    if k < 0 || 5 * k + c >= out.moves_room() {
        return out.fail(o, out.why_room());
    }
    o[o[out.h_moves()] + 5 * k + c] = value;
    return 0;
}

// The register `r` of a value of type `ty` as a number of the moves.
fn numbered[&m](m: &m [int], ty: int, r: int) -> [] int {
    if r >= 0 && fr.float_kind(m, ty) >= 0 {
        return r + 32;
    }
    return r;
}

// A move into the register of `phi`, of type `ty`, from what `kind` and `what` say, which is in the register `r` (-1: not one): how many moves there are now.
fn add_move[&m, &o](m: &m [int], o: &!o [int], moves: int, phi: int, ty: int, kind: int, what: int, r: int) -> [] int {
    let d = numbered(m, ty, out.reg(o, phi));
    let from = numbered(m, ty, r);
    if d == from {
        return moves;
    }
    set_move(o, moves, 0, d);
    set_move(o, moves, 1, from);
    set_move(o, moves, 2, ty);
    set_move(o, moves, 3, kind);
    set_move(o, moves, 4, what);
    return moves + 1;
}

// Is a register any of the first `moves` moves still has to read?
fn read_by[&o](o: &o [int], moves: int, r: int) -> [] bool {
    var k = 0;
    while k < moves {
        if move_cell(o, k, 1) == r && move_cell(o, k, 0) >= 0 {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// Move `k` made: what it reads into its register.
fn make_move[&t, &m, &o](text: &t [byte], m: &m [int], o: &!o [int], k: int) -> [] int {
    let d = move_cell(o, k, 0);
    let from = move_cell(o, k, 1);
    let ty = move_cell(o, k, 2);
    let what = move_cell(o, k, 4);
    if from >= 32 {
        return fr.fmov(o, d - 32, from - 32);
    }
    if from >= 0 {
        return fr.mov(o, d, from);
    }
    if move_cell(o, k, 3) == 0 {
        if d >= 32 {
            return fr.operand_fp(m, o, what, d - 32);
        }
        return fr.operand(m, o, what, d, false);
    }
    // A value of the side table that is in no register: zero, a local in its slot, or an operand of the module.
    if m2.kind(what) == m2.v_operand() {
        if d >= 32 {
            return fr.operand_fp(m, o, m2.value_of(what), d - 32);
        }
        return fr.operand(m, o, m2.value_of(what), d, false);
    }
    if m2.kind(what) == m2.v_local() {
        let slot = out.slot(o, m2.value_of(what));
        if slot < 0 {
            return out.fail(o, out.why_operand());
        }
        if d >= 32 {
            return fr.access(o, 2 + fr.float_kind(m, ty), 1, 1, d - 32, fr.sp(), slot);
        }
        return fr.load_local(m, o, ty, d, m2.value_of(what), false);
    }
    if d >= 32 {
        out.emit(o, a64.fp_int(1, 1, 5, d - 32, 31));
        return 0;
    }
    return fr.mov(o, d, 31);
}

// The moves made as one parallel copy: each whose register no other still reads, until none is left; when every one left is read by another, they are
// cycles of registers, and one register of one is kept in `x17` (or `d17`) while the cycle is undone. The text has the proof that this is all it takes.
fn parallel_copy[&t, &m, &o](text: &t [byte], m: &m [int], o: &!o [int], moves: int) -> [] int {
    var left = moves;
    var rounds = 0;
    while left > 0 && !out.failed(o) && rounds <= 4 * moves + 4 {
        rounds = rounds + 1;
        var made = false;
        var k = 0;
        while k < moves {
            let d = move_cell(o, k, 0);
            if d >= 0 && !read_by(o, moves, d) {
                make_move(text, m, o, k);
                set_move(o, k, 0, 0 - 1);
                left = left - 1;
                made = true;
            }
            k = k + 1;
        }
        if !made && left > 0 {
            // A cycle: the first move left gives what its register holds to the scratch register, which those that read it read instead.
            k = 0;
            while k < moves && move_cell(o, k, 0) < 0 {
                k = k + 1;
            }
            let d = move_cell(o, k, 0);
            var temp = 17;
            if d >= 32 {
                temp = 49;
                fr.fmov(o, 17, d - 32);
            } else {
                fr.mov(o, 17, d);
            }
            var j = 0;
            while j < moves {
                if move_cell(o, j, 0) >= 0 && move_cell(o, j, 1) == d {
                    set_move(o, j, 1, temp);
                }
                j = j + 1;
            }
        }
    }
    if left > 0 {
        return out.fail(o, out.why_room());
    }
    return 0;
}

// A block begins (number `b`): its label is here, and each of its `phi`s, and of its new `phi`s, takes the value the jump left for it.
fn begin_block[&m, &s, &o](m: &m [int], s: &s [int], o: &!o [int], block: int, promoted: bool, b: int) -> [] int {
    let id = lm.cell(m, block + 2);
    o[cc.h_block()] = id;
    if id >= 0 {
        out.set_label(o, id, out.here(o));
    }
    var at = instruction_at(m, next(m, block));
    while at != 0 && op_of(m, at) == lr.op_phi() && !out.failed(o) {
        let phi = lm.cell(m, at + 4);
        if out.reg(o, phi) < 0 {
            fr.add_offset(o, 13, fr.sp(), out.phi_slot(o, phi));
            fr.add_offset(o, 14, fr.sp(), out.slot(o, phi));
            fr.copy(o, ly.size_of(m, lm.cell(m, at + 6)), 8);
        }
        at = instruction_at(m, next(m, at));
    }
    if promoted {
        var j = 0;
        while j < m2.block_phis(s, b) && !out.failed(o) {
            let k = m2.block_phi(s, b, j);
            if out.reg(o, m2.names(s) + k) < 0 {
                fr.add_offset(o, 13, fr.sp(), out.phi_slot(o, m2.names(s) + k));
                fr.add_offset(o, 14, fr.sp(), out.slot(o, m2.names(s) + k));
                fr.copy(o, ly.size_of(m, m2.phi_type(s, k)), 8);
            }
            j = j + 1;
        }
    }
    return 0;
}

// A promoted `load` (instruction `i`) is its value: nothing to do when that is another local, whose slot it has; a constant or zero is written to its slot.
fn replaced[&t, &m, &s, &o](text: &t [byte], m: &m [int], s: &s [int], o: &!o [int], rec: int, i: int) -> [] int {
    let value = m2.replacement(s, i);
    let id = lm.cell(m, rec + 4);
    if m2.kind(value) == m2.v_local() || id < 0 {
        return 0;
    }
    if out.slot(o, id) < 0 {
        return out.fail(o, out.why_operand());
    }
    let r = out.reg(o, id);
    if r >= 0 {
        // Its register is given the constant.
        let ty = lm.cell(m, rec + 6);
        if m2.kind(value) == m2.v_operand() && fr.float_kind(m, ty) >= 0 {
            return fr.operand_fp(m, o, m2.value_of(value), r);
        }
        if m2.kind(value) == m2.v_operand() {
            return fr.operand(m, o, m2.value_of(value), r, false);
        }
        if fr.float_kind(m, ty) >= 0 {
            out.emit(o, a64.fp_int(1, 1, 5, r, 31));
            return 0;
        }
        return fr.mov(o, r, 31);
    }
    fr.add_offset(o, 14, fr.sp(), out.slot(o, id));
    return put_value(text, m, o, value, lm.cell(m, rec + 6));
}

// The instruction that ends a block, or one whose meaning is the frame's.
fn control[&t, &m, &s, &o](text: &t [byte], m: &m [int], s: &s [int], o: &!o [int], func: int, rec: int, promoted: bool, b: int) -> [] int {
    let op = op_of(m, rec);
    let n = lm.cell(m, rec + 9);
    if op == lr.op_phi() {
        return 0;
    }
    if op == lr.op_alloca() {
        let id = lm.cell(m, rec + 4);
        if id < 0 {
            return 0;
        }
        fr.add_offset(o, 9, fr.sp(), out.phi_slot(o, id));
        return fr.access(o, 3, 0, 0, 9, fr.sp(), out.slot(o, id));
    }
    if op == lr.op_ret() {
        let r = fr.register_of(m, o, opnd(m, rec, 0));
        if n > 0 && r >= 0 && o[out.h_sret()] < 0 && cc.one_register(m, lm.cell(m, opnd(m, rec, 0))) {
            cc.reset(o);
            cc.from_register(m, o, lm.cell(m, opnd(m, rec, 0)), r, cc.w_result_out());
        } else if n > 0 {
            let ty = lm.cell(m, opnd(m, rec, 0));
            let place = fr.in_frame(text, m, o, opnd(m, rec, 0), ty, o[cc.h_scratch()]);
            if o[out.h_sret()] >= 0 {
                fr.add_offset(o, 13, fr.sp(), place);
                fr.access(o, 3, 0, 1, 14, fr.sp(), o[out.h_sret()]);
                fr.copy(o, ly.size_of(m, ty), 8);
            } else {
                cc.reset(o);
                fr.add_offset(o, 14, fr.sp(), place);
                cc.walk(m, o, ty, 0, cc.w_result_out(), 0);
            }
        }
        return leave(o);
    }
    if op == lr.op_br() {
        if n == 1 {
            return jump(text, m, s, o, func, lm.cell(m, opnd(m, rec, 0) + 2), promoted, b);
        }
        // The condition's low bit: clear, over the jump to the first block and its `phi` values, to the jump to the second.
        let c = fr.source(m, o, opnd(m, rec, 0), 9, false);
        let test = out.emit(o, 0);
        jump(text, m, s, o, func, lm.cell(m, opnd(m, rec, 1) + 2), promoted, b);
        out.patch(o, test, a64.bit_branch(0, c, 0, out.here(o) - test));
        return jump(text, m, s, o, func, lm.cell(m, opnd(m, rec, 2) + 2), promoted, b);
    }
    if op == lr.op_switch() {
        // A compare a case, in the order written; then the default.
        let ty = lm.cell(m, opnd(m, rec, 0));
        if fr.word_size(m, ty) < 0 {
            return out.fail(o, out.why_operand());
        }
        var k = 2;
        while k + 1 < n && !out.failed(o) {
            let a = fr.source(m, o, opnd(m, rec, 0), 9, false);
            let c = fr.source(m, o, opnd(m, rec, k), 10, false);
            out.emit(o, a64.addsub_shift(1, 1, 1, 31, a, c, 0, 0));
            let skip = out.emit(o, 0);
            jump(text, m, s, o, func, lm.cell(m, opnd(m, rec, k + 1) + 2), promoted, b);
            out.patch(o, skip, a64.branch_cond(1, out.here(o) - skip));
            k = k + 2;
        }
        return jump(text, m, s, o, func, lm.cell(m, opnd(m, rec, 1) + 2), promoted, b);
    }
    return gen.lower(text, m, o, rec);
}

// The function whose record is at `func`; with a side table `s` that is not empty, its variables made values first (`mem2reg.cho`), unless the pass left it
// as it is or the new `phi`s do not fit the output's table, which is then counted.
fn function[&t, &m, &s, &o](text: &t [byte], m: &m [int], s: &!s [int], o: &!o [int], func: int) -> [] int {
    let names = lm.cell(m, func + 9);
    let n = lm.cell(m, names + 2);
    o[out.h_line()] = lm.cell(m, func + 13);
    var promoted = false;
    if len(s) > 0 {
        let status = m2.promote(m, s, func);
        if status == 1 {
            return out.fail(o, out.why_room());
        }
        if status == 0 && m2.promoted(s) > 0 && n + m2.phis(s) <= o[out.h_loc_cap()] {
            promoted = true;
            o[out.h_promoted()] = o[out.h_promoted()] + m2.promoted(s);
        } else if status != 0 || m2.promoted(s) > 0 {
            o[out.h_left()] = o[out.h_left()] + 1;
        }
    }
    var locals = n;
    if promoted {
        locals = n + m2.phis(s);
    }
    out.begin_function(o, func, locals);
    if len(s) > 0 && m2.status(s) == 0 {
        // The values given registers (`regalloc.cho`): each local's, and the registers to keep for the caller.
        ra.allocate(m, s, func, promoted);
        if ra.status(s) == 1 {
            var id = 0;
            while id < locals {
                out.set_reg(o, id, ra.register(s, id));
                id = id + 1;
            }
            o[out.h_saved()] = ra.used(s);
            o[out.h_allocated()] = o[out.h_allocated()] + ra.allocated(s);
            o[out.h_spilled()] = o[out.h_spilled()] + ra.spilled(s);
        } else {
            o[out.h_unallocated()] = o[out.h_unallocated()] + 1;
        }
    }
    frame(m, s, o, func, promoted);
    if out.failed(o) {
        return 0;
    }
    entry(m, o, func);
    var at = next(m, func);
    var b = 0 - 1;
    var i = 0;
    while at < lm.cell(m, lm.h_top()) && lm.cell(m, at) != lr.r_end() && !out.failed(o) {
        let kind = lm.cell(m, at);
        if kind == lr.r_block() {
            b = b + 1;
            begin_block(m, s, o, at, promoted, b);
        } else if kind == lr.r_instr() {
            o[out.h_line()] = lm.cell(m, at + 8);
            if !promoted || m2.action(s, i) == m2.a_keep() {
                control(text, m, s, o, func, at, promoted, b);
            } else if m2.action(s, i) == m2.a_replaced() {
                replaced(text, m, s, o, at, i);
            }
            i = i + 1;
        }
        at = next(m, at);
    }
    // Every branch is given its distance.
    var f = o[out.h_fix()];
    while f < o[out.h_fix_top()] && !out.failed(o) {
        let target = out.label(o, o[f + 1]);
        if target < 0 {
            out.fail(o, out.why_operand());
        } else {
            out.patch(o, o[f], a64.branch(0, target - o[f]));
        }
        f = f + 2;
    }
    return out.end_function(o);
}

// The code of every function of the module in `m` (read from `text` with no refusal), into `o`, which has `llout.room(m)` cells: 0, or 1 for a refusal, its
// line and its reason in the header of `o`. `s` is the side table of `mem2reg.cho`, with `mem2reg.room(m)` cells; empty, the pass is not run and every
// value has its slot as in section 12 (`--no-registers`, section 17.5).
pub fn generate[&t, &m, &s, &o](text: &t [byte], m: &m [int], s: &!s [int], o: &!o [int]) -> [] int {
    out.layout(m, o);
    if len(o) < out.header() {
        return 1;
    }
    if len(m) < lm.header() || lm.failed(m) || lm.cell(m, lm.h_ready()) == 0 {
        out.fail(o, out.why_room());
        return 1;
    }
    if len(s) > 0 && m2.layout(m, s) != 0 {
        out.fail(o, out.why_room());
        return 1;
    }
    var at = lm.cell(m, lm.h_rec());
    while at < lm.cell(m, lm.h_top()) && !out.failed(o) {
        if lm.cell(m, at) == lr.r_func() {
            function(text, m, s, o, at);
        }
        at = next(m, at);
    }
    if out.failed(o) {
        return 1;
    }
    return 0;
}
