edition 7;
module selfhost.llback;

// llback.cho -- what the command line asks of the native backend today (`docs/native-backend.md` sections 8 and 10): a module of the compiler read, and either
// judged (`--backend native`: the reader with vectors refused, then the code generator; there is no object to put the code in yet) or written back (`--backend roundtrip`: the module the reader
// read, as text, for clang).

import std.buffer;
import selfhost.llmod as lm;
import selfhost.lltop as lt;
import selfhost.llprint as lp;
import selfhost.llout as out;
import selfhost.a64fn;
import selfhost.mem2reg as m2;
import selfhost.elf;
import selfhost.layout as la;
import selfhost.a64asm as asm;
import selfhost.image;

// What became of a module: the text to give clang (`roundtrip`) or the bytes of its object (`native`), and the refusal if there was one (`why` 0 for none; else the line of the
// module and the reason, a code of `llout.why_text`, which has the reader's and the code generator's).
pub res struct Judged {
    text: buffer.Buffer,
    line: int,
    why: int,
}

pub fn native() -> [] int {
    return 1;
}

pub fn roundtrip() -> [] int {
    return 2;
}

// The module `ir`, written for the target `target` of the driver (0 Linux on x86-64, 1 Darwin, 2 Linux on AArch64, 3 AArch64 with no system), through the
// backend `backend`; for the native one with its variables made values (`registers`, section 17) or not (`--no-registers`).
pub fn through[&h, &r](heap: &!h Heap, ir: &r [byte], backend: int, target: int, registers: bool) -> [heap] Judged {
    var strict = 0;
    if backend == native() {
        strict = 1;
    }
    let table = box_slice(heap, lm.room(ir), 0);
    var text = buffer.empty(heap, 0);
    var line = 0;
    var why = 0;
    borrow mut table as &!tw in {
        let m = contents(tw);
        if lt.read(ir, m, strict) != 0 {
            line = lm.cell(m, lm.h_fail_line());
            why = lm.cell(m, lm.h_fail_why());
            if why == 0 {
                why = lm.why_room();
            }
        } else if backend == roundtrip() {
            buffer.drop(heap, text);
            text = lp.print(heap, ir, m);
        } else if target != 2 && target != 3 {
            why = out.why_machine();
        } else {
            // The module is read: its code (`docs/native-backend.md` section 12), and the object the code and the module's values are (section 13).
            let code = box_slice(heap, out.room(m), 0);
            let side = box_slice(heap, side_room(m, registers), 0);
            borrow mut code as &!cw in {
                borrow mut side as &!sw in {
                    let o = contents(cw);
                    if a64fn.generate(ir, m, contents(sw), o) != 0 {
                        line = lm.cell(o, out.h_fail_line());
                        why = lm.cell(o, out.h_fail_why());
                        if why == 0 {
                            why = out.why_room();
                        }
                    } else {
                        let (file, bad) = elf.object(heap, ir, m, o);
                        buffer.drop(heap, text);
                        text = file;
                        if bad != 0 {
                            why = out.why_constant();
                        }
                    }
                }
            }
            unbox_slice(heap, code);
            unbox_slice(heap, side);
        }
    }
    unbox_slice(heap, table);
    return Judged { text: text, line: line, why: why };
}

// The cells of the side table of `mem2reg.cho` for the module in `m`: none when the variables stay in memory.
fn side_room[&m](m: &m [int], registers: bool) -> [] int {
    if registers {
        return m2.room(m);
    }
    return 0;
}

// What became of a program for no system that was to be an image (`docs/native-backend.md` section 16): the file, or where it was refused. `stage` is 0
// for a file; 1 for the module or its code (`line` of the module, `why` of `llout.why_text`); 2 for the layout (`line` of it, `why` of `layout.why_text`);
// 3 for the boot page (`line` of it, `why` of `a64asm.why_text`); 4 for the image (`why` of `image.why_text`, and the name and the number `image.Made` has).
pub res struct Imaged {
    file: buffer.Buffer,
    stage: int,
    line: int,
    why: int,
    space: int,
    from: int,
    size: int,
    number: int,
}

// The module `ir` with the boot page `page` (`boot` false for none), placed as the layout `plan` says: the flat image, or with `executable` an ELF
// executable that holds it.
pub fn bare_image[&h, &r, &q, &s](heap: &!h Heap, ir: &r [byte], plan: &q [byte], page: &s [byte], boot: bool, executable: bool, registers: bool) -> [heap] Imaged {
    let table = box_slice(heap, lm.room(ir), 0);
    var result = buffer.empty(heap, 0);
    var stage = 0;
    var line = 0;
    var reason = 0;
    var where_space = 0;
    var where_from = 0;
    var where_size = 0;
    var amount = 0;
    borrow mut table as &!tw in {
        let m = contents(tw);
        if lt.read(ir, m, 1) != 0 {
            stage = 1;
            line = lm.cell(m, lm.h_fail_line());
            reason = lm.cell(m, lm.h_fail_why());
            if reason == 0 {
                reason = lm.why_room();
            }
        } else {
            let code = box_slice(heap, out.room(m), 0);
            let side = box_slice(heap, side_room(m, registers), 0);
            let lines = box_slice(heap, la.room(plan), 0);
            let labels = box_slice(heap, asm.room(page), 0);
            var assembled = buffer.empty(heap, 4096);
            borrow mut code as &!cw in {
                borrow mut lines as &!lw in {
                    borrow mut labels as &!aw in {
                        let o = contents(cw);
                        let l = contents(lw);
                        let a = contents(aw);
                        var status = 0;
                        borrow mut side as &!sw in {
                            status = a64fn.generate(ir, m, contents(sw), o);
                        }
                        if status != 0 {
                            stage = 1;
                            line = lm.cell(o, out.h_fail_line());
                            reason = lm.cell(o, out.h_fail_why());
                            if reason == 0 {
                                reason = out.why_room();
                            }
                        } else if la.read(plan, l) != 0 {
                            stage = 2;
                            line = lm.cell(l, la.h_fail_line());
                            reason = lm.cell(l, la.h_fail_why());
                        } else {
                            assembled = asm.assemble(heap, page, a, assembled);
                            if boot && asm.failed(a) {
                                stage = 3;
                                line = asm.fail_line(a);
                                reason = asm.fail_why(a);
                            } else {
                                borrow assembled as &ab in {
                                    let image.Made { file, why, space, from, size, number } = image.make(heap, ir, m, o, page, a, buffer.bytes(ab), boot, plan, l, executable);
                                    buffer.drop(heap, result);
                                    result = file;
                                    if why != 0 {
                                        stage = 4;
                                        reason = why;
                                        where_space = space;
                                        where_from = from;
                                        where_size = size;
                                        amount = number;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            buffer.drop(heap, assembled);
            unbox_slice(heap, code);
            unbox_slice(heap, side);
            unbox_slice(heap, lines);
            unbox_slice(heap, labels);
        }
    }
    unbox_slice(heap, table);
    return Imaged { file: result, stage: stage, line: line, why: reason, space: where_space, from: where_from, size: where_size, number: amount };
}
