edition 7;
module selfhost.lllayout;

// lllayout.cho -- the size, the alignment and the offsets of a type of the module in memory (`docs/native-backend.md` section 4): LLVM's data layout for the
// targets the native backend has, computed from the reader's type table. The compiler names no size (it writes `getelementptr (T, ptr null, i32 1)` and leaves
// the arithmetic to LLVM), so these numbers must be LLVM's, and `tests/native/layout_test.cho` holds them to what clang answered. Pure, and no trap on any type:
// a type with no size (`void`, `label`, a function type, a named type with no body) has size 0, and a type nested deeper than `llmod.deepest` is cut there.

import selfhost.llmod as lm;

fn up(n: int, align: int) -> [] int {
    if align <= 1 {
        return n;
    }
    return (n + align - 1) / align * align;
}

fn align_at[&m](m: &m [int], ty: int, depth: int) -> [] int {
    let t = lm.resolved(m, ty);
    let kind = lm.type_kind(m, t);
    if depth > lm.deepest() {
        return 1;
    }
    if kind == lm.k_int() {
        let bits = lm.type_count(m, t);
        if bits <= 8 {
            return 1;
        }
        if bits <= 16 {
            return 2;
        }
        if bits <= 32 {
            return 4;
        }
        if bits <= 64 {
            return 8;
        }
        return 16;
    }
    if kind == lm.k_float() {
        return 4;
    }
    if kind == lm.k_double() || kind == lm.k_ptr() {
        return 8;
    }
    if kind == lm.k_array() {
        return align_at(m, lm.type_part(m, t, 0), depth + 1);
    }
    if kind == lm.k_vector() {
        // A vector is aligned to its size, up to sixteen bytes.
        let size = size_at(m, t, depth + 1);
        var a = 1;
        while a < size && a < 16 {
            a = a * 2;
        }
        return a;
    }
    if kind == lm.k_struct() {
        var most = 1;
        var k = 0;
        while k < lm.type_count(m, t) {
            let a = align_at(m, lm.type_part(m, t, k), depth + 1);
            if a > most {
                most = a;
            }
            k = k + 1;
        }
        return most;
    }
    return 1;
}

fn size_at[&m](m: &m [int], ty: int, depth: int) -> [] int {
    let t = lm.resolved(m, ty);
    let kind = lm.type_kind(m, t);
    if depth > lm.deepest() {
        return 0;
    }
    if kind == lm.k_int() {
        let bits = lm.type_count(m, t);
        if bits <= 8 {
            return 1;
        }
        if bits <= 16 {
            return 2;
        }
        if bits <= 32 {
            return 4;
        }
        if bits <= 64 {
            return 8;
        }
        return 16;
    }
    if kind == lm.k_float() {
        return 4;
    }
    if kind == lm.k_double() || kind == lm.k_ptr() {
        return 8;
    }
    if kind == lm.k_array() || kind == lm.k_vector() {
        let element = lm.type_part(m, t, 0);
        let count = lm.type_count(m, t);
        let each = up(size_at(m, element, depth + 1), align_at(m, element, depth + 1));
        if kind == lm.k_vector() {
            // The elements of a vector are packed by bits: sixteen `i1` are two bytes.
            let e = lm.resolved(m, element);
            if lm.type_kind(m, e) == lm.k_int() {
                return up((lm.type_count(m, e) * count + 7) / 8, 1);
            }
        }
        if each > 0 && count > 4611686018427387904 / each {
            return 0;
        }
        return each * count;
    }
    if kind == lm.k_struct() {
        var at = 0;
        var k = 0;
        while k < lm.type_count(m, t) {
            let field = lm.type_part(m, t, k);
            at = up(at, align_at(m, field, depth + 1)) + size_at(m, field, depth + 1);
            if at > 4611686018427387904 {
                return 0;
            }
            k = k + 1;
        }
        return up(at, align_at(m, t, depth));
    }
    return 0;
}

// The alignment of a value of type `ty`, in bytes: 1 or more.
pub fn align_of[&m](m: &m [int], ty: int) -> [] int {
    return align_at(m, ty, 0);
}

// The size of a value of type `ty` in memory, in bytes, its padding included: what `getelementptr (T, ptr null, i32 1)` is.
pub fn size_of[&m](m: &m [int], ty: int) -> [] int {
    let size = size_at(m, ty, 0);
    return up(size, align_at(m, ty, 0));
}

// Where field `index` of the struct `ty` is, in bytes from its start; where element `index` of an array is. -1 for a type that has no such part.
pub fn offset_of[&m](m: &m [int], ty: int, index: int) -> [] int {
    let t = lm.resolved(m, ty);
    let kind = lm.type_kind(m, t);
    if kind == lm.k_array() || kind == lm.k_vector() {
        if index < 0 || index >= lm.type_count(m, t) {
            return 0 - 1;
        }
        return index * size_of(m, lm.type_part(m, t, 0));
    }
    if kind != lm.k_struct() || index < 0 || index >= lm.type_count(m, t) {
        return 0 - 1;
    }
    var at = 0;
    var k = 0;
    while k <= index {
        let field = lm.type_part(m, t, k);
        at = up(at, align_at(m, field, 1));
        if k < index {
            at = at + size_at(m, field, 1);
        }
        k = k + 1;
    }
    return at;
}

// The type of part `index` of `ty`: a field, or the element. -1 for none.
pub fn part_of[&m](m: &m [int], ty: int, index: int) -> [] int {
    let t = lm.resolved(m, ty);
    let kind = lm.type_kind(m, t);
    if kind == lm.k_array() || kind == lm.k_vector() {
        return lm.type_part(m, t, 0);
    }
    if kind == lm.k_struct() && index >= 0 && index < lm.type_count(m, t) {
        return lm.type_part(m, t, index);
    }
    return 0 - 1;
}
