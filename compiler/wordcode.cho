module selfhost.wordcode;

// wordcode.cho -- the code for the builtins that work on words: `trap`, `copy_within`, `value_barrier`, `mul_wide`,
// `add_carry`, `sub_borrow`, `load_le64`, `byte_mask64`, `trailing_zeros`, `leading_zeros` and `popcount`. Plain
// LLVM, as the Rust backend writes it (`docs/word-scan.md`, `docs/wide-multiply.md`, `docs/memory-moves.md`).
//
// Every function reads its arguments from the last `n` entries of the argument stack (a slice is two) and drops them.

import selfhost.nativert;
import selfhost.emit;
import selfhost.mmio;

fn line[&s](st: &!s [int], text: &static [byte]) -> [] int {
    let n = emit.start(st);
    emit.str(st, text);
    emit.str(st, "\n");
    return n;
}

fn done[&s](st: &!s [int], n: int) -> [] int {
    st[52] = st[52] - n;
    return 0;
}

// Trap unless `0 <= at` and `at + width <= length`, without forming the sum.
fn room[&s](st: &!s [int], n: int, length: int, at: int, width: int) -> [] int {
    let space = emit.start(st);
    emit.str(st, "sub i64 ");
    emit.last_operand(st, n, length);
    emit.str(st, ", ");
    emit.nat(st, width);
    emit.str(st, "\n");
    let past = emit.start(st);
    emit.str(st, "icmp ugt i64 ");
    emit.last_operand(st, n, at);
    emit.str(st, ", ");
    emit.temp(st, space);
    emit.str(st, "\n");
    let short = emit.start(st);
    emit.str(st, "icmp slt i64 ");
    emit.last_operand(st, n, length);
    emit.str(st, ", ");
    emit.nat(st, width);
    emit.str(st, "\n");
    let failed = emit.start(st);
    emit.str(st, "or i1 ");
    emit.temp(st, past);
    emit.str(st, ", ");
    emit.temp(st, short);
    emit.str(st, "\n");
    emit.trap_if(st, failed);
    return 0;
}

// `trap()`.
pub fn stop[&s](st: &!s [int]) -> [] int {
    let always = line(st, "icmp eq i64 0, 0");
    emit.trap_if(st, always);
    return 0;
}

// `value_barrier(x)`: the value comes out of an empty `asm`, so nothing is known about it.
pub fn barrier[&s](st: &!s [int]) -> [] int {
    let r = emit.start(st);
    emit.str(st, "call i64 asm \"\", \"=r,0\"(i64 ");
    emit.last_operand(st, 1, 0);
    emit.str(st, ")\n");
    done(st, 1);
    return r;
}

// `trailing_zeros` (0), `leading_zeros` (1), `popcount` (2).
pub fn count_bits[&s](st: &!s [int], which: int) -> [] int {
    let r = emit.start(st);
    if which == 0 {
        emit.str(st, "call i64 @llvm.cttz.i64(i64 ");
    } else if which == 1 {
        emit.str(st, "call i64 @llvm.ctlz.i64(i64 ");
    } else {
        emit.str(st, "call i64 @llvm.ctpop.i64(i64 ");
    }
    emit.last_operand(st, 1, 0);
    if which < 2 {
        emit.str(st, ", i1 false)\n");
    } else {
        emit.str(st, ")\n");
    }
    done(st, 1);
    return r;
}

// `load_le64(text, at)`: one unaligned load, after the room is checked.
pub fn load_le64[&s](st: &!s [int]) -> [] int {
    room(st, 3, 1, 2, 8);
    let place = emit.start(st);
    emit.str(st, "getelementptr i8, ptr ");
    emit.last_operand(st, 3, 0);
    emit.str(st, ", i64 ");
    emit.last_operand(st, 3, 2);
    emit.str(st, "\n");
    let word = emit.start(st);
    emit.str(st, "load i64, ptr ");
    emit.temp(st, place);
    emit.str(st, ", align 1\n");
    done(st, 3);
    return word;
}

// `byte_mask64(text, at, b)`: bit `i` is set when byte `at + i` is `b`; four 16-byte compares.
pub fn byte_mask64[&s](st: &!s [int]) -> [] int {
    room(st, 4, 1, 2, 64);
    let start = emit.start(st);
    emit.str(st, "getelementptr i8, ptr ");
    emit.last_operand(st, 4, 0);
    emit.str(st, ", i64 ");
    emit.last_operand(st, 4, 2);
    emit.str(st, "\n");
    if st[55] & nativert.bit() != 0 {
        // For the native backend, which has no vectors: the same answer from a function of the module's own, a byte at a time.
        let slow = emit.start(st);
        emit.str(st, "call i64 @cancho_byte_mask64(ptr ");
        emit.temp(st, start);
        emit.str(st, ", i8 ");
        emit.last_operand(st, 4, 3);
        emit.str(st, ")\n");
        done(st, 4);
        return slow;
    }
    let ins = emit.start(st);
    emit.str(st, "insertelement <16 x i8> poison, i8 ");
    emit.last_operand(st, 4, 3);
    emit.str(st, ", i64 0\n");
    let splat = emit.start(st);
    emit.str(st, "shufflevector <16 x i8> ");
    emit.temp(st, ins);
    emit.str(st, ", <16 x i8> poison, <16 x i32> zeroinitializer\n");
    var acc = 0 - 1;
    var q = 0;
    while q < 4 {
        let p = emit.start(st);
        emit.str(st, "getelementptr i8, ptr ");
        emit.temp(st, start);
        emit.str(st, ", i64 ");
        emit.nat(st, 16 * q);
        emit.str(st, "\n");
        let v = emit.start(st);
        emit.str(st, "load <16 x i8>, ptr ");
        emit.temp(st, p);
        emit.str(st, ", align 1\n");
        let eq = emit.start(st);
        emit.str(st, "icmp eq <16 x i8> ");
        emit.temp(st, v);
        emit.str(st, ", ");
        emit.temp(st, splat);
        emit.str(st, "\n");
        let bits = emit.start(st);
        emit.str(st, "bitcast <16 x i1> ");
        emit.temp(st, eq);
        emit.str(st, " to i16\n");
        let wide = emit.start(st);
        emit.str(st, "zext i16 ");
        emit.temp(st, bits);
        emit.str(st, " to i64\n");
        if q == 0 {
            acc = wide;
        } else {
            let shifted = emit.start(st);
            emit.str(st, "shl i64 ");
            emit.temp(st, wide);
            emit.str(st, ", ");
            emit.nat(st, 16 * q);
            emit.str(st, "\n");
            let joined = emit.start(st);
            emit.str(st, "or i64 ");
            emit.temp(st, acc);
            emit.str(st, ", ");
            emit.temp(st, shifted);
            emit.str(st, "\n");
            acc = joined;
        }
        q = q + 1;
    }
    done(st, 4);
    return acc;
}

// `copy_within(buf, dst, src, n)`: `memmove` inside one slice, after the checks indexing makes.
pub fn copy_within[&s](st: &!s [int]) -> [] int {
    // dst < 0 is the first test; src < 0 and n < 0 follow.
    let below = emit.start(st);
    emit.str(st, "icmp slt i64 ");
    emit.last_operand(st, 5, 2);
    emit.str(st, ", 0\n");
    var failed = below;
    var k = 3;
    while k <= 4 {
        let negative = emit.start(st);
        emit.str(st, "icmp slt i64 ");
        emit.last_operand(st, 5, k);
        emit.str(st, ", 0\n");
        let joined = emit.start(st);
        emit.str(st, "or i1 ");
        emit.temp(st, failed);
        emit.str(st, ", ");
        emit.temp(st, negative);
        emit.str(st, "\n");
        failed = joined;
        k = k + 1;
    }
    k = 2;
    while k <= 3 {
        let space = emit.start(st);
        emit.str(st, "sub i64 ");
        emit.last_operand(st, 5, 1);
        emit.str(st, ", ");
        emit.last_operand(st, 5, k);
        emit.str(st, "\n");
        let past = emit.start(st);
        emit.str(st, "icmp sgt i64 ");
        emit.last_operand(st, 5, 4);
        emit.str(st, ", ");
        emit.temp(st, space);
        emit.str(st, "\n");
        let joined = emit.start(st);
        emit.str(st, "or i1 ");
        emit.temp(st, failed);
        emit.str(st, ", ");
        emit.temp(st, past);
        emit.str(st, "\n");
        failed = joined;
        k = k + 1;
    }
    emit.trap_if(st, failed);
    let to = emit.start(st);
    emit.str(st, "getelementptr i8, ptr ");
    emit.last_operand(st, 5, 0);
    emit.str(st, ", i64 ");
    emit.last_operand(st, 5, 2);
    emit.str(st, "\n");
    let from = emit.start(st);
    emit.str(st, "getelementptr i8, ptr ");
    emit.last_operand(st, 5, 0);
    emit.str(st, ", i64 ");
    emit.last_operand(st, 5, 3);
    emit.str(st, "\n");
    emit.str(st, "  call ptr @memmove(ptr ");
    emit.temp(st, to);
    emit.str(st, ", ptr ");
    emit.temp(st, from);
    emit.str(st, ", i64 ");
    emit.last_operand(st, 5, 4);
    emit.str(st, ")\n");
    done(st, 5);
    return 0;
}

// The pair `(first, second)` as the aggregate `ty` is.
fn pair[&s](st: &!s [int], ty: int, first: int, second: int) -> [] int {
    let a = emit.insert_at(st, ty, 0 - 1, 0, 1, false, 0, first);
    return emit.insert_at(st, ty, a, 1, 1, false, 0, second);
}

// `mul_wide(a, b)`: `(hi, lo)` of the unsigned product, through a 128-bit multiply.
pub fn mul_wide[&s](st: &!s [int], ty: int) -> [] int {
    let wa = emit.start(st);
    emit.str(st, "zext i64 ");
    emit.last_operand(st, 2, 0);
    emit.str(st, " to i128\n");
    let wb = emit.start(st);
    emit.str(st, "zext i64 ");
    emit.last_operand(st, 2, 1);
    emit.str(st, " to i128\n");
    let p = emit.start(st);
    emit.str(st, "mul i128 ");
    emit.temp(st, wa);
    emit.str(st, ", ");
    emit.temp(st, wb);
    emit.str(st, "\n");
    let lo = emit.start(st);
    emit.str(st, "trunc i128 ");
    emit.temp(st, p);
    emit.str(st, " to i64\n");
    let top = emit.start(st);
    emit.str(st, "lshr i128 ");
    emit.temp(st, p);
    emit.str(st, ", 64\n");
    let hi = emit.start(st);
    emit.str(st, "trunc i128 ");
    emit.temp(st, top);
    emit.str(st, " to i64\n");
    done(st, 2);
    return pair(st, ty, hi, lo);
}

// `add_carry(a, b, c)` and, with `sub`, `sub_borrow`: `(sum, carry_out)` of `a + b + (c != 0)`.
pub fn add_carry[&s](st: &!s [int], ty: int, sub: bool) -> [] int {
    let nz = emit.start(st);
    emit.str(st, "icmp ne i64 ");
    emit.last_operand(st, 3, 2);
    emit.str(st, ", 0\n");
    let cin = emit.start(st);
    emit.str(st, "zext i1 ");
    emit.temp(st, nz);
    emit.str(st, " to i64\n");
    let first = emit.start(st);
    if sub {
        emit.str(st, "call { i64, i1 } @llvm.usub.with.overflow.i64(i64 ");
    } else {
        emit.str(st, "call { i64, i1 } @llvm.uadd.with.overflow.i64(i64 ");
    }
    emit.last_operand(st, 3, 0);
    emit.str(st, ", i64 ");
    emit.last_operand(st, 3, 1);
    emit.str(st, ")\n");
    let v1 = emit.start(st);
    emit.str(st, "extractvalue { i64, i1 } ");
    emit.temp(st, first);
    emit.str(st, ", 0\n");
    let o1 = emit.start(st);
    emit.str(st, "extractvalue { i64, i1 } ");
    emit.temp(st, first);
    emit.str(st, ", 1\n");
    let second = emit.start(st);
    if sub {
        emit.str(st, "call { i64, i1 } @llvm.usub.with.overflow.i64(i64 ");
    } else {
        emit.str(st, "call { i64, i1 } @llvm.uadd.with.overflow.i64(i64 ");
    }
    emit.temp(st, v1);
    emit.str(st, ", i64 ");
    emit.temp(st, cin);
    emit.str(st, ")\n");
    let v2 = emit.start(st);
    emit.str(st, "extractvalue { i64, i1 } ");
    emit.temp(st, second);
    emit.str(st, ", 0\n");
    let o2 = emit.start(st);
    emit.str(st, "extractvalue { i64, i1 } ");
    emit.temp(st, second);
    emit.str(st, ", 1\n");
    let both = emit.start(st);
    emit.str(st, "or i1 ");
    emit.temp(st, o1);
    emit.str(st, ", ");
    emit.temp(st, o2);
    emit.str(st, "\n");
    let out = emit.start(st);
    emit.str(st, "zext i1 ");
    emit.temp(st, both);
    emit.str(st, " to i64\n");
    done(st, 3);
    return pair(st, ty, v2, out);
}

// `a or b` of two `i1` temporaries.
fn either[&s](st: &!s [int], a: int, b: int) -> [] int {
    let r = emit.start(st);
    emit.str(st, "or i1 ");
    emit.temp(st, a);
    emit.str(st, ", ");
    emit.temp(st, b);
    emit.str(st, "\n");
    return r;
}

fn bits[&s](st: &!s [int], width: int) -> [] int {
    emit.str(st, "i");
    return emit.nat(st, 8 * width);
}

// `mmio_read8/32/64(m, address)` and `mmio_write8/32/64(m, address, value)` (`docs/mmio.md` 4): one volatile load or store of `width` bytes at the address, after the
// checks. It traps unless the address is a multiple of the width, the `width` bytes at it are inside one range of the bound `text[from..to]` (the empty bound is every
// address) and, for a write, the value is one the width holds. The capability is the first of the arguments and is nothing in the code. On a target with a system under
// the program (`bare` false) there is no address to reach, and it traps. Answers the temporary of what was read; nothing for a write.
pub fn mmio[&s, &x](st: &!s [int], text: &x [byte], from: int, to: int, width: int, write: bool, bare: bool) -> [] int {
    var n = 2;
    if write {
        n = 3;
    }
    var bad = 0;
    if !bare {
        bad = line(st, "icmp eq i64 0, 0");
    } else {
        let low = emit.start(st);
        emit.str(st, "and i64 ");
        emit.last_operand(st, n, 1);
        emit.str(st, ", ");
        emit.nat(st, width - 1);
        emit.str(st, "\n");
        bad = emit.start(st);
        emit.str(st, "icmp ne i64 ");
        emit.temp(st, low);
        emit.str(st, ", 0\n");
        let ranges = mmio.count(text, from, to);
        if ranges > 0 {
            var held = line(st, "icmp ne i64 0, 0");
            var k = 0;
            while k < ranges {
                let lo = mmio.low(text, from, to, k);
                let room = mmio.high(text, from, to, k) - lo - width;
                if room >= 0 {
                    let off = emit.start(st);
                    emit.str(st, "sub i64 ");
                    emit.last_operand(st, n, 1);
                    emit.str(st, ", ");
                    emit.nat(st, lo);
                    emit.str(st, "\n");
                    let here = emit.start(st);
                    emit.str(st, "icmp ule i64 ");
                    emit.temp(st, off);
                    emit.str(st, ", ");
                    emit.nat(st, room);
                    emit.str(st, "\n");
                    held = either(st, held, here);
                }
                k = k + 1;
            }
            let outside = emit.start(st);
            emit.str(st, "xor i1 ");
            emit.temp(st, held);
            emit.str(st, ", true\n");
            bad = either(st, bad, outside);
        }
        if write && width < 8 {
            let wide = emit.start(st);
            emit.str(st, "icmp ugt i64 ");
            emit.last_operand(st, n, 2);
            if width == 1 {
                emit.str(st, ", 255\n");
            } else {
                emit.str(st, ", 4294967295\n");
            }
            bad = either(st, bad, wide);
        }
    }
    emit.trap_if(st, bad);
    let place = emit.start(st);
    emit.str(st, "inttoptr i64 ");
    emit.last_operand(st, n, 1);
    emit.str(st, " to ptr\n");
    var result = 0 - 1;
    if write {
        var value = 0 - 1;
        if width < 8 {
            value = emit.start(st);
            emit.str(st, "trunc i64 ");
            emit.last_operand(st, n, 2);
            emit.str(st, " to ");
            bits(st, width);
            emit.str(st, "\n");
        }
        emit.str(st, "  store volatile ");
        bits(st, width);
        emit.str(st, " ");
        if value >= 0 {
            emit.temp(st, value);
        } else {
            emit.last_operand(st, n, 2);
        }
        emit.str(st, ", ptr ");
        emit.temp(st, place);
    } else {
        result = emit.start(st);
        emit.str(st, "load volatile ");
        bits(st, width);
        emit.str(st, ", ptr ");
        emit.temp(st, place);
    }
    emit.str(st, ", align ");
    emit.nat(st, width);
    emit.str(st, "\n");
    if !write && width < 8 {
        let narrow = result;
        result = emit.start(st);
        emit.str(st, "zext ");
        bits(st, width);
        emit.str(st, " ");
        emit.temp(st, narrow);
        emit.str(st, " to i64\n");
    }
    done(st, n);
    return result;
}

// `cpu_read` (0), `cpu_write` (1) and `cpu_do` (2) (`docs/cpu.md` 3), for the name `text[from..to]`, which `atoms.cpu_builtin` has held to its letters: one `mrs`; one
// `msr` and the `isb` that makes it hold for the next instruction; or the instruction (`tlbi_vmalle1` is the flush, the wait for it and the `isb`). The arguments are the
// capability, the name (two operands, unused) and, for a write, the value. Where the machine is not a bare AArch64 (`bare` false) there is no such register to reach, and
// it traps. Answers the temporary of what was read; nothing otherwise.
pub fn cpu[&s, &x](st: &!s [int], text: &x [byte], from: int, to: int, kind: int, bare: bool) -> [] int {
    var n = 3;
    if kind == 1 {
        n = 4;
    }
    var result = 0 - 1;
    if !bare {
        stop(st);
        if kind == 0 {
            // (What a read answers is never a number known when the program is compiled, on any target.)
            result = line(st, "add i64 0, 0");
        }
    } else if kind == 0 {
        result = emit.start(st);
        emit.str(st, "call i64 asm sideeffect \"mrs $0, ");
        emit.slice(st, text, from, to);
        emit.str(st, "\", \"=r\"()\n");
    } else if kind == 1 {
        emit.str(st, "  call void asm sideeffect \"msr ");
        emit.slice(st, text, from, to);
        emit.str(st, ", $0\\0Aisb\", \"r\"(i64 ");
        emit.last_operand(st, n, 3);
        emit.str(st, ")\n");
    } else if to - from == 3 {
        emit.str(st, "  call void asm sideeffect \"");
        emit.slice(st, text, from, to);
        emit.str(st, "\", \"\"()\n");
    } else {
        emit.str(st, "  call void asm sideeffect \"tlbi vmalle1\\0Adsb nsh\\0Aisb\", \"\"()\n");
    }
    done(st, n);
    return result;
}
