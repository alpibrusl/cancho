module selfhost.effects;

// effects.cho -- what a function performs, against the row it declares.
//
// A function's row lists the effects it may have, and Rust holds it exact (`docs/linearity-and-
// effects.md` section 7.3): what a body performs, which is what the builtins it calls perform and
// what the rows of the functions it calls say, must be the row, in both directions. A label in the
// body and not the row is `effect-not-declared`; a label in the row and not the body is
// `effect-declared-not-performed`. Both are refused at the function.
//
// A set of labels is an integer here, bit i for the label `builtins.effect_name(i)`. A label that
// carries an argument (`fs_read("/tmp")`), or whose name no builtin performs, is not one of those;
// a row with either is reported in the two high bits and left to the callers to be careful about.

import selfhost.ast;
import selfhost.kinds;
import selfhost.narrowing;
import selfhost.rules;
import selfhost.builtins;
import selfhost.lexcore as lc;
import selfhost.pass1;
import selfhost.tables;
import selfhost.instances;
import selfhost.types;
import std.bytes;

pub fn two_to[&s](st: &!s [int], n: int) -> [] int {
    var v = 1;
    var i = 0;
    while i < n {
        v = v * 2;
        i = i + 1;
    }
    return v;
}

// The bit of the high flag for a label with an argument, and for one no builtin performs.
// The labels the masks keep: the ones a builtin performs, then `conc`, which `spawn` and `join` perform and which is no
// builtin's.
pub fn label_count() -> [] int {
    return builtins.effect_count() + 1;
}

pub fn conc_bit() -> [] int {
    return builtins.effect_count();
}

pub fn arg_flag[&s](st: &!s [int]) -> [] int {
    return two_to(st, 60);
}

pub fn unknown_flag[&s](st: &!s [int]) -> [] int {
    return two_to(st, 61);
}

// Does `mask` have bit `n` set?
fn has[&s](st: &!s [int], mask: int, n: int) -> [] bool {
    return mask / two_to(st, n) % 2 == 1;
}

// The labels of the row of function `fn_item`: the mask of those a builtin performs, plus the
// flags for an argument and for an unknown name. `[` is the token the item keeps for it.
pub fn row_mask[&s, &x](st: &!s [int], text: &x [byte], fn_item: int) -> [] int {
    return row_mask_at(st, text, ast.get(st, fn_item, 9));
}

// The same for the row whose `[` is the token `open`: a function's, or the one written in a function type.
pub fn row_mask_at[&s, &x](st: &!s [int], text: &x [byte], open: int) -> [] int {
    var p = open + 1;
    var mask = 0;
    while !pass1.is_code(st, p, lc.Tok::RBracket) {
        var found = 0 - 1;
        var i = 0;
        while i < builtins.effect_count() {
            if lc.spells(text, ast.tstart(st, p), ast.tend(st, p), builtins.effect_name(i)) {
                found = i;
            }
            i = i + 1;
        }
        if found < 0 && lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "conc") {
            found = conc_bit();
        }
        p = p + 1;
        if pass1.is_code(st, p, lc.Tok::LParen) {
            while !pass1.is_code(st, p, lc.Tok::RParen) {
                p = p + 1;
            }
            p = p + 1;
            if !has(st, mask, 60) {
                mask = mask + arg_flag(st);
            }
        } else if found < 0 {
            if !has(st, mask, 61) {
                mask = mask + unknown_flag(st);
            }
        } else if !has(st, mask, found) {
            mask = mask + two_to(st, found);
        }
        if pass1.is_code(st, p, lc.Tok::Comma) {
            p = p + 1;
        }
    }
    return mask;
}

// A row that is only labels a builtin performs: nothing with an argument, nothing unknown.
pub fn plain_row[&s](st: &!s [int], mask: int) -> [] bool {
    return mask < arg_flag(st);
}

// The builtin `b` performs its labels: added to the set `st[54]` the function being checked
// keeps. A label that carries an argument is not one the checker follows: answers false.
pub fn perform[&s](st: &!s [int], b: int) -> [] bool {
    var k = 0;
    while k < builtins.builtin_effect_count(b) {
        let code = builtins.builtin_effect(b, k);
        if code % 2 == 1 {
            return false;
        }
        if !has(st, st[54], code / 2) {
            st[54] = st[54] + two_to(st, code / 2);
        }
        k = k + 1;
    }
    return true;
}

// The function performs the label called `name`, which some builtin performs.
pub fn perform_named[&s](st: &!s [int], name: &static [byte]) -> [] int {
    if bytes.equal(name, "conc") && !has(st, st[54], conc_bit()) {
        st[54] = st[54] + two_to(st, conc_bit());
    }
    var n = 0;
    while n < builtins.effect_count() {
        if bytes.equal(builtins.effect_name(n), name) && !has(st, st[54], n) {
            st[54] = st[54] + two_to(st, n);
        }
        n = n + 1;
    }
    return 0;
}

// The bit of a set for the label called `name`, which some builtin performs.
pub fn label_bit[&s](st: &!s [int], name: &static [byte]) -> [] int {
    var n = 0;
    while n < builtins.effect_count() {
        if bytes.equal(builtins.effect_name(n), name) {
            return two_to(st, n);
        }
        n = n + 1;
    }
    return 0;
}

// The function performed something the masks do not keep: a label with an argument (a path, a program, an address, a
// library), or what a function value does. Bit 61 of the set says so, and the refusal that the row says more than the body
// does is not made for such a function.
pub fn mark_untracked[&s](st: &!s [int]) -> [] int {
    if !has(st, st[54], 61) {
        st[54] = st[54] + two_to(st, 61);
    }
    return 0;
}

pub fn untracked[&s](st: &!s [int]) -> [] bool {
    return has(st, st[54], 61);
}

// The function performed a label with an argument, which is untracked too (bit 62): an empty row declares none.
pub fn mark_arg[&s](st: &!s [int]) -> [] int {
    // An earlier performance that was never followed stays counted (bit 58); this one waits to be (bit 57).
    if has(st, st[54], 57) && !has(st, st[54], 58) {
        st[54] = st[54] + two_to(st, 58);
    }
    if !has(st, st[54], 57) {
        st[54] = st[54] + two_to(st, 57);
    }
    mark_untracked(st);
    if !has(st, st[54], 62) {
        st[54] = st[54] + two_to(st, 62);
    }
    return 0;
}

pub fn arg_performed[&s](st: &!s [int]) -> [] bool {
    return has(st, st[54], 62);
}

// The labels a call to a function with the row `mask` performs, added to the set.
pub fn perform_row[&s](st: &!s [int], mask: int) -> [] int {
    if has(st, mask, 60) {
        mark_arg(st);
    }
    var n = 0;
    while n < label_count() {
        if has(st, mask, n) && !has(st, st[54], n) {
            st[54] = st[54] + two_to(st, n);
        }
        n = n + 1;
    }
    return 0;
}

// The labels owning a value of the prelude type `index` stands for: what `discharged_by` says of it.
// A type that carries a literal discharges labels with an argument too, which are not in the mask.
pub fn discharged[&s](st: &!s [int], index: int) -> [] int {
    let labels = tables.prelude_labels(index);
    var mask = 0;
    var i = 0;
    while i < len(labels) {
        var j = i;
        while j < len(labels) && int_of(labels[j]) != 32 {
            j = j + 1;
        }
        if j > i {
            let last = int_of(labels[j - 1]);
            if last != '*' && last != '=' {
                var n = 0;
                while n < builtins.effect_count() {
                    if lc.spells(labels, i, j, builtins.effect_name(n)) && !has(st, mask, n) {
                        mask = mask + two_to(st, n);
                    }
                    n = n + 1;
                }
            }
        }
        i = j + 1;
    }
    return mask;
}

// ------------------------------------------------------------------- a lent system (`docs/bare-system.md` 12) ---
//
// On the target with no system, a `system` block discharges the hosted labels its module answers: the body's set is counted apart from the function's, and what is not
// discharged is added back after it. `instances.lent` is what the block discharges, with bit 59 while its body is walked.

// Is the body of a `system` block being walked, and does the block answer the label with an argument numbered `label` (`arg_label_name`)? `fs_read` (1) and
// `net_out` (3) are the ones a block answers (`instances.lent_args`).
fn answered[&s](st: &!s [int], label: int) -> [] bool {
    let lent = instances.lent(st);
    return has(st, lent, 59) && has(st, lent, 60) && label >= 0 && label < 16 && has(st, instances.lent_args(st), label);
}

// Inside the body of a `system` block, the function performed a label with an argument the block does not answer (or something that has no row to tell by): bit 55 of the
// body's set, which is in no set outside a body.
fn mark_kept[&s](st: &!s [int]) -> [] int {
    if has(st, instances.lent(st), 59) && !has(st, st[54], 55) {
        st[54] = st[54] + two_to(st, 55);
    }
    return 0;
}

// The function being checked performs `label` with the argument whose literal is the token `lit`: the row is kept (`instances.note_label`), and a `system` block is told
// whether it is one of its own.
fn note_arg[&s](st: &!s [int], label: int, lit: int) -> [] bool {
    if !answered(st, label) {
        mark_kept(st);
    }
    return instances.note_label(st, st[64], label, lit);
}

// The body of a `system` block that discharges `labels` (the plain ones by their bits, bit 60 for `fs_read`) starts: the set the function has so far is answered, to be
// given back to `lend_end`, and the body starts from the empty one.
pub fn lend[&s](st: &!s [int], labels: int) -> [] int {
    let outer = st[54];
    st[54] = 0;
    instances.set_lent(st, labels + two_to(st, 59));
    instances.set_lender(st, st[64] + 1);
    return outer;
}

// The body has ended. The function's set is `outer` and, of the body's: every plain label the block does not discharge; the flags for a function value and for a label that
// was not followed; and the flags for a label with an argument only if the body performed one the block does not answer, since otherwise all it performed were the
// `fs_read` rows taken out here (those from row `rows` on; one the function had before the block stays).
pub fn lend_end[&s](st: &!s [int], outer: int, rows: int) -> [] int {
    let labels = instances.lent(st) - two_to(st, 59);
    let body = st[54];
    var set = outer;
    var n = 0;
    while n < label_count() {
        if has(st, body, n) && !has(st, labels, n) && !has(st, set, n) {
            set = set + two_to(st, n);
        }
        n = n + 1;
    }
    let kept = has(st, body, 55) || has(st, body, 56) || has(st, body, 57) || has(st, body, 58);
    n = 56;
    while n < 63 {
        if n != 59 && n != 60 && has(st, body, n) && !has(st, set, n) && (kept || n < 61) {
            set = set + two_to(st, n);
        }
        n = n + 1;
    }
    if has(st, labels, 60) {
        var a = 0;
        while a < 16 {
            if has(st, instances.lent_args(st), a) {
                instances.forget_labels(st, st[64], a, rows);
            }
            a = a + 1;
        }
    }
    st[54] = set;
    instances.set_lent(st, labels);
    return 0;
}

// The function `fn_item`, if it is the one that contains the `system` block, is held to what the block discharged: a label of those that its row still lists, and that
// it performs nowhere outside the block, is `effect-declared-not-performed`. `check` does not say so of a function that performs a label with an argument while code is
// written, and the function that lends is such a one in a kernel (its `mmio`). Not asked where the set is not all there is: a function value called, a label not followed.
pub fn lender_exact[&s, &x](st: &!s [int], text: &x [byte], fn_item: int, from: int, to: int) -> [] int {
    if instances.lender(st) != fn_item + 1 || has(st, st[54], 56) || has(st, st[54], 58) {
        return 0;
    }
    let labels = instances.lent(st);
    let declared = row_mask(st, text, fn_item);
    var n = 0;
    while n < label_count() {
        if has(st, labels, n) && has(st, declared, n) && !has(st, st[54], n) {
            ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
            return 0;
        }
        n = n + 1;
    }
    if has(st, labels, 60) && has(st, instances.lent_args(st), 1) && mmio_in_row(st, text, 1, ast.get(st, fn_item, 9), 0) >= 0 {
        var reads = false;
        var row = 0;
        while row < instances.label_rows(st) {
            if instances.label_item(st, row) == fn_item && instances.label_name(st, row) == 1 {
                reads = true;
            }
            row = row + 1;
        }
        if !reads {
            ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
        }
    }
    return 0;
}

// Does a function that owns `Fs("/tmp")` or `Exec("/bin")` discharge the path or program in token `lit`, which a callee
// performs (`family` 0 reads and writes of `Fs`, 1 `Exec`)? A `World` discharges every one; a borrowed capability none
// (`discharged_by`). What is not a literal of a prelude type is not judged: true.
fn owner_covers[&s, &x](st: &!s [int], text: &x [byte], caller: int, family: int, lit: int) -> [] bool {
    var owned = ast.get(st, caller, 7);
    while owned >= 0 {
        let ty = ast.get(st, owned, 5);
        if ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 2 {
            let index = ast.get(st, ty, 9);
            if index == 0 {
                return true;
            }
            if index == tables.prelude_fs() && family == 0 || index == tables.prelude_exec() && family == 1 {
                let arg = ast.get(st, ty, 6);
                if ast.get(st, ty, 7) != 1 || !ast.is_kind(st, arg, kinds.NK::TLit) {
                    return true;
                }
                if narrowing.path_inside(st, text, ast.get(st, arg, 4), lit) {
                    return true;
                }
            }
        }
        owned = ast.next(st, owned);
    }
    return false;
}

// A call of `callee` performs a path or a program that no capability `caller` owns reaches, and `caller` declares no label
// with an argument to say so: `Label::covers` compares `fs_read("/tmpevil")` with what an `Fs("/tmp")` discharges at a
// separator, and a label with an argument never covers a plain one. Only the rows of functions are read here, so what
// a builtin performs with a borrowed capability is not judged.
pub fn outside_owned[&s, &x](st: &!s [int], text: &x [byte], caller: int, callee: int) -> [] bool {
    if caller < 0 || has(st, row_mask(st, text, caller), 60) {
        return false;
    }
    var p = ast.get(st, callee, 9) + 1;
    while !pass1.is_code(st, p, lc.Tok::RBracket) {
        var family = 0 - 1;
        if lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "fs_read") && answered(st, 1) {
            // a path read inside a `system` block that answers `fs_read` is the block's to answer, not an owner's
            family = 0 - 1;
        } else if lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "fs_read") || lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "fs_write") {
            family = 0;
        } else if lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "exec") {
            family = 1;
        }
        p = p + 1;
        if pass1.is_code(st, p, lc.Tok::LParen) {
            if family >= 0 && pass1.is_code(st, p + 1, lc.Tok::Str) && !owner_covers(st, text, caller, family, p + 1) {
                return true;
            }
            while !pass1.is_code(st, p, lc.Tok::RParen) {
                p = p + 1;
            }
            p = p + 1;
        }
        if pass1.is_code(st, p, lc.Tok::Comma) {
            p = p + 1;
        }
    }
    return false;
}

// What a call of `callee` performs, added to the set, and the refusal when that is outside what the function being checked
// (`st[64]`) owns and declares.
pub fn perform_call[&s, &x](st: &!s [int], text: &x [byte], callee: int) -> [] int {
    let mask = row_mask(st, text, callee);
    perform_row(st, mask);
    if has(st, mask, 60) {
        followed(st, note_row_args(st, text, ast.get(st, callee, 9)));
    }
    if outside_owned(st, text, st[64], callee) {
        ast.fail(st, rules.r_effect_not_declared(), ast.nstart(st, st[64]), ast.nend(st, st[64]));
    }
    return 0;
}

// A call through the binding `local`, which is a parameter of the function being checked written with a function type
// (`docs/function-values.md` §4.2): the row of that type travels with the value, and calling it performs exactly that row.
// What a function value held any other way does stays untracked.
pub fn perform_pointer[&s, &x](st: &!s [int], text: &x [byte], local: int) -> [] int {
    mark_untracked(st);
    mark_pointer(st);
    if st[64] < 0 {
        return 0;
    }
    var param = ast.get(st, st[64], 7);
    while param >= 0 {
        let ty = ast.get(st, param, 5);
        if ast.get(st, param, 4) == st[st[20] + 5 * local] && ast.is_kind(st, ty, kinds.NK::TFn) {
            let mask = row_mask_at(st, text, ast.get(st, ty, 4));
            perform_row(st, mask);
            if has(st, mask, 60) {
                followed(st, note_row_args(st, text, ast.get(st, ty, 4)));
            }
        }
        param = ast.next(st, param);
    }
    return 0;
}

// The labels of two masks.
pub fn union[&s](st: &!s [int], a: int, b: int) -> [] int {
    var mask = a;
    var n = 0;
    while n < label_count() {
        if has(st, b, n) && !has(st, mask, n) {
            mask = mask + two_to(st, n);
        }
        n = n + 1;
    }
    return mask;
}

// Are the string literals in tokens `a` and `b` spelled the same? -1 is the empty one.
fn same_literal[&s, &x](st: &!s [int], text: &x [byte], a: int, b: int) -> [] bool {
    var na = 2;
    var nb = 2;
    if a >= 0 {
        na = ast.tend(st, a) - ast.tstart(st, a);
    }
    if b >= 0 {
        nb = ast.tend(st, b) - ast.tstart(st, b);
    }
    if na != nb {
        return false;
    }
    var i = 1;
    while i < na - 1 {
        if int_of(text[ast.tstart(st, a) + i]) != int_of(text[ast.tstart(st, b) + i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The token of the literal of the `k`th `mmio("...")` of the row whose `[` is the token `open`, or -1 when the row has no more.
fn mmio_in_row[&s, &x](st: &!s [int], text: &x [byte], label: int, open: int, k: int) -> [] int {
    var seen = 0;
    var p = open + 1;
    while !pass1.is_code(st, p, lc.Tok::RBracket) {
        let named = lc.spells(text, ast.tstart(st, p), ast.tend(st, p), arg_label_name(label));
        p = p + 1;
        if pass1.is_code(st, p, lc.Tok::LParen) {
            if named && pass1.is_code(st, p + 1, lc.Tok::Str) {
                if seen == k {
                    return p + 1;
                }
                seen = seen + 1;
            }
            while !pass1.is_code(st, p, lc.Tok::RParen) {
                p = p + 1;
            }
            p = p + 1;
        }
        if pass1.is_code(st, p, lc.Tok::Comma) {
            p = p + 1;
        }
    }
    return 0 - 1;
}

// Does `fn_item` own what discharges `mmio` of the bound in token `lit`: a `World`, or an `Mmio` of that bound?
fn mmio_owned[&s, &x](st: &!s [int], text: &x [byte], label: int, fn_item: int, lit: int) -> [] bool {
    var owned = ast.get(st, fn_item, 7);
    while owned >= 0 {
        let ty = ast.get(st, owned, 5);
        if ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 2 {
            if ast.get(st, ty, 9) == 0 || label == 9 && ast.get(st, ty, 9) == tables.prelude_cpu() {
                return true;
            }
            if label == 8 && ast.get(st, ty, 9) == tables.prelude_mmio() && ast.get(st, ty, 7) == 1 && ast.is_kind(st, ast.get(st, ty, 6), kinds.NK::TLit) && same_literal(st, text, ast.get(st, ast.get(st, ty, 6), 4), lit) {
                return true;
            }
        }
        owned = ast.next(st, owned);
    }
    return false;
}

// `mmio` is exact with its argument (`docs/mmio.md` 5): every bound the body of `fn_item` reached hardware through, itself or by the row of a function it calls, is
// an `mmio("...")` of its row spelled the same, unless the function owns what discharges it; and every `mmio("...")` of the row is one the body performed. True if
// refused. The bounds performed are the rows `instances.note_label` keeps, so nothing is judged where there are none (`st[40]` is 0).
fn mmio_inexact[&s, &x](st: &!s [int], text: &x [byte], label: int, fn_item: int, from: int, to: int) -> [] bool {
    if st[40] == 0 {
        return false;
    }
    let open = ast.get(st, fn_item, 9);
    var row = 0;
    while row < instances.label_rows(st) {
        if instances.label_item(st, row) == fn_item && instances.label_name(st, row) == label && !mmio_owned(st, text, label, fn_item, instances.label_literal(st, row)) {
            var declared = false;
            var k = 0;
            while mmio_in_row(st, text, label, open, k) >= 0 {
                if same_literal(st, text, mmio_in_row(st, text, label, open, k), instances.label_literal(st, row)) {
                    declared = true;
                }
                k = k + 1;
            }
            if !declared {
                ast.fail(st, rules.r_effect_not_declared(), from, to);
                return true;
            }
        }
        row = row + 1;
    }
    var k = 0;
    while mmio_in_row(st, text, label, open, k) >= 0 {
        var performed = false;
        row = 0;
        while row < instances.label_rows(st) {
            if instances.label_item(st, row) == fn_item && instances.label_name(st, row) == label && same_literal(st, text, mmio_in_row(st, text, label, open, k), instances.label_literal(st, row)) {
                performed = true;
            }
            row = row + 1;
        }
        if !performed {
            ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
            return true;
        }
        k = k + 1;
    }
    return false;
}

// The row is exact: what the body performed against what `fn_item` declares. The first
// disagreement is a refusal at the function, `effect-not-declared` when the body does more than the
// row says and `effect-declared-not-performed` when the row says more. `both` is false while code is
// written: not every builtin records what it performs there yet, so a row that says more may be right,
// and only the refusal that cannot be wrong is made.
pub fn check[&s, &x](st: &!s [int], text: &x [byte], fn_item: int, from: int, to: int, authority: int, both: bool) -> [] int {
    // (8 `mmio`, with the bound; 9 `cpu`, with the register or the instruction: `docs/cpu.md` 4.)
    if mmio_inexact(st, text, 8, fn_item, from, to) || mmio_inexact(st, text, 9, fn_item, from, to) {
        return 0;
    }
    let declared = row_mask(st, text, fn_item);
    // A function that owns a capability needs no label for what the capability allows (section 8.2
    // of the same document): what the parameters discharge is not performed as far as the row goes.
    var performed = 0;
    var m = 0;
    while m < label_count() {
        if has(st, st[54], m) && !has(st, authority, m) {
            performed = performed + two_to(st, m);
        }
        m = m + 1;
    }
    // A plain label performed and not in the row is refused whatever else the row carries: a label with an argument
    // covers no plain label (`Label::covers`).
    var n = 0;
    while n < label_count() {
        if has(st, performed, n) && !has(st, declared, n) {
            ast.fail(st, rules.r_effect_not_declared(), from, to);
            return 0;
        }
        n = n + 1;
    }
    if has(st, declared, 60) {
        if !both {
            return 0;
        }
        // A label with an argument is a different label from the plain one a builtin performs, and
        // from every other: nothing performed can be compared with it yet.
        if performed != 0 {
            ast.fail(st, rules.r_skip(), from, to);
            return 0;
        }
        ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
        return 0;
    }
    if !both {
        return 0;
    }
    n = 0;
    while n < label_count() {
        if has(st, declared, n) && !has(st, performed, n) {
            ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
            return 0;
        }
        n = n + 1;
    }
    if has(st, declared, 61) {
        ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
    }
    return 0;
}

// The labels the function `fn_item` performed, kept for `cancho authority` in slot 15 of the item (which the stamps of the walk over types use only for a struct and an enum): the set the body came to
// before what the parameters own is taken off it, bit by bit as `st[54]` has them, the flags for a label with an argument, one that is not known, and one not followed included. A function checked
// more than once (each instance of a generic function) keeps the union.
pub fn record[&s](st: &!s [int], fn_item: int) -> [] int {
    var mask = ast.get(st, fn_item, 15);
    if mask < 0 {
        mask = 0;
    }
    var n = 0;
    while n < 56 || n >= 60 && n < 63 {
        if has(st, st[54], n) && !has(st, mask, n) {
            mask = mask + two_to(st, n);
        }
        n = n + 1;
        if n == 56 {
            n = 60;
        }
    }
    if (has(st, st[54], 57) || has(st, st[54], 58) || has(st, st[54], 56)) && !has(st, mask, 59) {
        mask = mask + two_to(st, 59);
    }
    ast.put(st, fn_item, 15, mask);
    return 0;
}

// The function being checked called through a function value: what it did is not followed whatever the type of the value says (`cancho authority` answers that it did not follow it).
pub fn mark_pointer[&s](st: &!s [int]) -> [] int {
    if !has(st, st[54], 56) {
        st[54] = st[54] + two_to(st, 56);
    }
    return 0;
}

// The performance of a label with an argument that `mark_arg` counted is followed (`ok`: its labels were kept), or it stays counted, and `record` says the function has a label that was not followed.
pub fn followed[&s](st: &!s [int], ok: bool) -> [] int {
    if has(st, st[54], 57) {
        st[54] = st[54] - two_to(st, 57);
        if !ok && !has(st, st[54], 58) {
            st[54] = st[54] + two_to(st, 58);
        }
    }
    return 0;
}

// The labels with an argument, by number (the second slot of a row `instances.note_label` keeps).
pub fn arg_label_name(i: int) -> [] &static [byte] {
    if i == 0 {
        return "ffi";
    }
    if i == 1 {
        return "fs_read";
    }
    if i == 2 {
        return "fs_write";
    }
    if i == 3 {
        return "net_out";
    }
    if i == 4 {
        return "net_in";
    }
    if i == 5 {
        return "signals";
    }
    if i == 6 {
        return "exec";
    }
    if i == 8 {
        return "mmio";
    }
    if i == 9 {
        return "cpu";
    }
    return "tty_open";
}

// Which labels with an argument the builtin whose name is `text[from..to]` performs with the literal its capability was narrowed to (`cancho-ir/src/lower`: `memory.rs` for the paths, `process.rs`,
// `net.rs`, `tty.rs`): bit 0 `fs_read`, 1 `fs_write`, 2 `exec`, 3 `net_out`, 4 `net_in`, 5 `tty_open`, 6 `mmio`; 0 for a builtin whose labels this does not know.
fn label_bits[&x](text: &x [byte], from: int, to: int) -> [] int {
    if lc.spells(text, from, to, "fs_read") || lc.spells(text, from, to, "open_read") || lc.spells(text, from, to, "open_dir") {
        return 1;
    }
    if lc.spells(text, from, to, "fs_write") || lc.spells(text, from, to, "fs_remove") || lc.spells(text, from, to, "fs_rename") || lc.spells(text, from, to, "open_write") || lc.spells(text, from, to, "open_append") || lc.spells(text, from, to, "open_new") {
        return 2;
    }
    if lc.spells(text, from, to, "open_rw") {
        return 3;
    }
    if lc.spells(text, from, to, "exec_spawn") || lc.spells(text, from, to, "exec_spawn_in") || lc.spells(text, from, to, "exec_spawn_detached") {
        return 4;
    }
    if lc.spells(text, from, to, "connect") || lc.spells(text, from, to, "tcp_connect") || lc.spells(text, from, to, "tcp_connect_start") || lc.spells(text, from, to, "udp_connect") {
        return 8;
    }
    if lc.spells(text, from, to, "bind") || lc.spells(text, from, to, "udp_bind") || lc.spells(text, from, to, "tcp_listen") || lc.spells(text, from, to, "tcp_listen_on") {
        return 16;
    }
    if lc.spells(text, from, to, "tty_open") {
        return 32;
    }
    if lc.spells(text, from, to, "mmio_read8") || lc.spells(text, from, to, "mmio_read32") || lc.spells(text, from, to, "mmio_read64") || lc.spells(text, from, to, "mmio_write8") || lc.spells(text, from, to, "mmio_write32") || lc.spells(text, from, to, "mmio_write64") {
        return 64;
    }
    return 0;
}

// The call `id` of a builtin performs its labels with an argument, with the literal the capability of type `cap` was narrowed to (the empty one for a capability that was not): kept for the function being
// checked. True if the builtin is one whose labels are known and every one was kept.
pub fn note_call[&s, &x](st: &!s [int], text: &x [byte], id: int, cap: int) -> [] bool {
    let callee = ast.get(st, id, 5);
    let bits = label_bits(text, ast.tstart(st, callee), ast.tend(st, callee));
    if bits == 0 || st[64] < 0 {
        return false;
    }
    var inner = cap;
    if types.is_ref(st, inner) {
        inner = types.ref_inner(st, inner);
    }
    var lit = 0 - 1;
    if types.is_prelude(st, inner) {
        lit = types.prelude_lit_tok(st, inner);
    }
    var ok = true;
    var bit = 0;
    while bit < 7 {
        if bits / two_to(st, bit) % 2 == 1 {
            var label = 6;
            if bit == 0 {
                label = 1;
            } else if bit == 1 {
                label = 2;
            } else if bit == 3 {
                label = 3;
            } else if bit == 4 {
                label = 4;
            } else if bit == 5 {
                label = 7;
            } else if bit == 6 {
                label = 8;
            }
            if !note_arg(st, label, lit) {
                ok = false;
            }
        }
        bit = bit + 1;
    }
    return ok;
}

// The function being checked performs `cpu` with the name in the string token `lit` (`atoms.cpu_builtin`).
pub fn note_cpu[&s](st: &!s [int], lit: int) -> [] int {
    mark_arg(st);
    followed(st, st[64] >= 0 && note_arg(st, 9, lit));
    return 0;
}

// The labels with an argument in the row whose `[` is the token `open`, kept for the function being checked. True if every one was kept.
pub fn note_row_args[&s, &x](st: &!s [int], text: &x [byte], open: int) -> [] bool {
    if st[64] < 0 {
        return false;
    }
    var ok = true;
    var p = open + 1;
    while !pass1.is_code(st, p, lc.Tok::RBracket) {
        var found = 0 - 1;
        var i = 0;
        while i < 10 {
            if lc.spells(text, ast.tstart(st, p), ast.tend(st, p), arg_label_name(i)) {
                found = i;
            }
            i = i + 1;
        }
        p = p + 1;
        if pass1.is_code(st, p, lc.Tok::LParen) {
            if found < 0 || !pass1.is_code(st, p + 1, lc.Tok::Str) || !note_arg(st, found, p + 1) {
                ok = false;
            }
            while !pass1.is_code(st, p, lc.Tok::RParen) {
                p = p + 1;
            }
            p = p + 1;
        }
        if pass1.is_code(st, p, lc.Tok::Comma) {
            p = p + 1;
        }
    }
    return ok;
}

// The function being checked calls the foreign function `it`: it performs the labels of its row, with their arguments, and `cancho authority` lists the symbol (a row with the label 100).
pub fn perform_extern[&s, &x](st: &!s [int], text: &x [byte], it: int) -> [] int {
    mark_arg(st);
    // (a foreign function is never a lent system's to answer, whatever its row says)
    mark_kept(st);
    followed(st, note_row_args(st, text, ast.get(st, it, 9)));
    if st[64] >= 0 {
        instances.note_label(st, st[64], 100, it);
    }
    return 0;
}

// The call watches a set of signals: it performs `signals` with the set the capability of type `cap` was narrowed to (which a claim has to write canonically, so the literal is the set). It is a
// label with an argument like a path's or an address's (`atoms.push_prefix`), so the function is marked the same way: a row that declares `signals("...")` is not refused as saying more than the body
// does, and an empty row on a function that owns no capability is refused as saying less (#638).
pub fn note_signals[&s](st: &!s [int], cap: int) -> [] int {
    mark_arg(st);
    // (a set that was not narrowed has no row)
    mark_kept(st);
    var ok = st[64] >= 0;
    var inner = cap;
    if types.is_ref(st, inner) {
        inner = types.ref_inner(st, inner);
    }
    if ok && types.is_prelude(st, inner) && types.prelude_lit_tok(st, inner) >= 0 {
        ok = note_arg(st, 5, types.prelude_lit_tok(st, inner));
    }
    followed(st, ok);
    return 0;
}

// Do the tokens `a` and `b` spell the same bytes?
fn same_token[&s, &x](st: &!s [int], text: &x [byte], a: int, b: int) -> [] bool {
    let n = ast.tend(st, a) - ast.tstart(st, a);
    if ast.tend(st, b) - ast.tstart(st, b) != n {
        return false;
    }
    var i = 0;
    while i < n {
        if text[ast.tstart(st, a) + i] != text[ast.tstart(st, b) + i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The literal of the `k`-th `signals("...")` of the row whose `[` is the token `open` (counting from 0), or `0 - 1` when the row has no more.
fn row_signals[&s, &x](st: &!s [int], text: &x [byte], open: int, k: int) -> [] int {
    var seen = 0;
    var p = open + 1;
    while !pass1.is_code(st, p, lc.Tok::RBracket) {
        if lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "signals") && pass1.is_code(st, p + 1, lc.Tok::LParen) && pass1.is_code(st, p + 2, lc.Tok::Str) {
            if seen == k {
                return p + 2;
            }
            seen = seen + 1;
        }
        p = p + 1;
    }
    return 0 - 1;
}

// `signals("...")` is exact in the row of `fn_item`, a function that owns no capability (`docs/signals.md` section 3: the set in a row is the set in the capability's type): every set the body
// watched, or a function it called declares, is a `signals` of the row with the same literal (`effect-not-declared`), and every `signals` of the row is one of those
// (`effect-declared-not-performed`; not asked of a function that called through a function value or performed a label that was not followed). Judged only where the labels with an argument are kept.
pub fn signals_exact[&s, &x](st: &!s [int], text: &x [byte], fn_item: int, from: int, to: int) -> [] int {
    if st[40] == 0 {
        return 0;
    }
    let open = ast.get(st, fn_item, 9);
    let rows = instances.label_rows(st);
    var k = 0;
    while k < rows {
        if instances.label_item(st, k) == fn_item && instances.label_name(st, k) == 5 && instances.label_literal(st, k) >= 0 {
            var found = false;
            var j = 0;
            while row_signals(st, text, open, j) >= 0 {
                if same_token(st, text, row_signals(st, text, open, j), instances.label_literal(st, k)) {
                    found = true;
                }
                j = j + 1;
            }
            if !found {
                ast.fail(st, rules.r_effect_not_declared(), from, to);
                return 0;
            }
        }
        k = k + 1;
    }
    if has(st, st[54], 56) || has(st, st[54], 58) {
        return 0;
    }
    var j = 0;
    while row_signals(st, text, open, j) >= 0 {
        var found = false;
        k = 0;
        while k < rows {
            if instances.label_item(st, k) == fn_item && instances.label_name(st, k) == 5 && instances.label_literal(st, k) >= 0 && same_token(st, text, row_signals(st, text, open, j), instances.label_literal(st, k)) {
                found = true;
            }
            k = k + 1;
        }
        if !found {
            ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
            return 0;
        }
        j = j + 1;
    }
    return 0;
}
