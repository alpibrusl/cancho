//~ STDOUT hahaha
//~ EXIT 0
import std.buffer;
import std.io;

fn repeat[&h, &r](heap: &!h Heap, s: &r [byte], n: int) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 16);
    var k = 0;
    while k < n {
        out = buffer.append(heap, out, s);
        k = k + 1;
    }
    return out;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(ffi); release(fs); release(args);
    borrow mut heap as &!h in {
        let text = repeat(h, "ha", 3);
        borrow mut io as &!i in {
            borrow text as &t in {
                buffer.write(i, t);
                io.newline(i);
            }
        }
        buffer.drop(h, text);
    }
    release(io);
    release(heap);
    return 0;
}
