//~ SATISFIES count_words.contract.cho
//~ SATISFIES ../../exercises/05-contract/count_words.contract.cho
import std.bytes;

pub fn count_words[&r](text: &r [byte]) -> [] int {
    var words = 0;
    var in_word = false;
    var k = 0;
    while k < len(text) {
        if bytes.is_blank(int_of(text[k])) {
            in_word = false;
        } else {
            if !in_word {
                words = words + 1;
            }
            in_word = true;
        }
        k = k + 1;
    }
    return words;
}
