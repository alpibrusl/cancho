# Bootstrap compiler build output (the v0 compiler is hosted in Rust)
/target
**/*.rs.bk
Cargo.lock.bak

# cancho build output
/build
*.o
*.a
*.so
*.dylib
*.out

# mdBook output (docs/SUMMARY.md, book.toml -- built and deployed by CI)
/book

# ACLI's `.cli/` reference folder (docs/agent-cli.md): regenerated by
# `cancho introspect`/`version` on demand, not a committed snapshot --
# `cancho skill`/`introspect` themselves are the up-to-date surface.
/.cli

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Python bytecode from the measurement scripts
__pycache__/
*.pyc

# Core dumps: the trap tests end programs by signal, and a Linux whose
# core_pattern is `core` writes one into the test's working directory
core
core.[0-9]*
