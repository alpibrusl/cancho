edition 9;

fn run[&i](io: &!i Io) -> [io_write, io_read] int {
    putchar(io, 72);
    var code = 0;
    match flush_out(io) {
        Done::Ok(n) => {
            code = 1;
        }
        Done::Failed(e) => {
            code = 2;
        }
    }
    region a {
        let buf = alloc_slice[a](8, byte_of(0));
        match read_bytes(io, buf) {
            Read::Got(n) => {
                code = code + n;
            }
            Read::End => {
                code = code + 10;
            }
            Read::Failed(e) => {
                code = code + 20;
            }
        }
    }
    return code;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    var code = 0;
    var console = io;
    borrow mut console as &!i in {
        code = run(i);
    }
    release(console);
    return code;
}
