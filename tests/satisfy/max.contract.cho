// The contract `max` a caller depends on (`docs/satisfy.md` §4, #406):
// point examples and a commutativity witness, stated as the only
// thing the checker already reads — a `.cho` file whose tests call
// the candidate. The candidate lives beside it; CI runs
// `cancho satisfy max.contract.cho max.candidate.cho --std`.

fn test_max_picks_the_larger() -> [] int {
    if max(3, 7) != 7 { return 1; }
    if max(7, 3) != 7 { return 1; }
    if max(-5, 2) != 2 { return 1; }
    if max(5, 5) != 5 { return 1; }
    return 0;
}

fn test_max_is_commutative() -> [] int {
    var failures = 0;
    var i = 0;
    while i < 100 {
        if max(i, 100 - i) != max(100 - i, i) { failures = failures + 1; }
        i = i + 1;
    }
    return failures;
}

fn test_max_is_at_least_both() -> [] int {
    var failures = 0;
    var i = 0;
    while i < 50 {
        if max(i, i + 10) < i { failures = failures + 1; }
        if max(i, i + 10) < i + 10 { failures = failures + 1; }
        i = i + 1;
    }
    return failures;
}
