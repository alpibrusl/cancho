edition 5;

module http_client_time;

import std.buffer;
import std.bytes;
import std.test;
import http_client as hc;
import http_client_wire as wire;
import http_client_harness as th;

// `http_client`: time on the caller's clock, a connection that ends, the refusals at the call, and every wrong handle.

// ---------------------------------------------------------------------
// Time, on the caller's clock
// ---------------------------------------------------------------------
pub fn test_a_dial_that_takes_too_long_fails_the_request[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 1, 2048, 1024, th.limits(100, 200, 300, 0, 1000, 0, 0, 8, 1000));
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            w[1] = th.mode_detach();
            th.eq(w, 25, hc.next_deadline(cw, 0), 0 - 1);
            let t = hc.request(cw, 1000, 1, "GET", "/x", "h", "", hc.body_none(), 0);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 1000));
            th.eq(w, 28, hc.next_deadline(cw, 1000), 100);
            th.eq(w, 29, hc.next_deadline(cw, 1060), 40);
            th.eq(w, 30, hc.next_deadline(cw, 1100), 0);
            // 99 ms after the dial began is in time; 100 is not.
            th.eq(w, 32, hc.tick(cw, 1099), 0);
            th.eq(w, 33, hc.failure(cw, t), 0);
            th.eq(w, 34, hc.tick(cw, 1100), 1);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 1100));
            th.eq(w, 36, hc.failure(cw, t), wire.c_connect_timeout());
            th.eq(w, 37, th.count_of(w, log, 6), 1);
            th.eq(w, 38, th.count_of(w, log, 7), 1);
            // Once. And the slot is free: a dial that is answered in time is not failed by the clock.
            th.eq(w, 40, hc.tick(cw, 5000), 0);
            let u = hc.request(cw, 6000, 1, "GET", "/y", "h", "", hc.body_none(), 0);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 6000));
            th.eq(w, 43, hc.connected(cw, 0, 6099), 0);
            th.eq(w, 44, hc.tick(cw, 6100), 0);
            th.ck(w, 45, u > 0);
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

pub fn test_a_head_that_takes_too_long_fails_and_every_byte_in_or_out_restarts_the_clock[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 1, 2048, 1024, th.limits(100, 200, 300, 0, 1000, 0, 0, 8, 1000));
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            w[1] = th.mode_all();
            let t = th.started(heap, cw, w, log, 1, "GET", "/x", hc.body_none(), 0, 0);
            // Taken at 10: the head is due at 210.
            buffer.drop(heap, th.sent(heap, cw, 0, 10));
            th.eq(w, 64, hc.next_deadline(cw, 10), 200);
            th.eq(w, 65, hc.tick(cw, 209), 0);
            // A byte of the head at 100 restarts it: due at 300.
            hc.give(cw, 0, "HTT", 100);
            th.eq(w, 68, hc.tick(cw, 299), 0);
            th.eq(w, 69, hc.next_deadline(cw, 299), 1);
            th.eq(w, 70, hc.tick(cw, 300), 1);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 300));
            th.eq(w, 72, hc.failure(cw, t), wire.c_head_timeout());
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

pub fn test_a_body_that_stalls_fails_but_a_caller_that_has_not_consumed_is_not_charged[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 1, 2048, 1024, th.limits(100, 200, 300, 0, 1000, 0, 0, 8, 1000));
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            // The body is not eaten by the harness.
            w[1] = th.mode_dial() + th.mode_detach();
            let t = th.started(heap, cw, w, log, 1, "GET", "/x", hc.body_none(), 0, 0);
            buffer.drop(heap, th.sent(heap, cw, 0, 10));
            th.reply(heap, cw, w, log, 0, "HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\nabc", 50);
            th.eq(w, 92, hc.avail(cw, t), 3);
            // Three bytes wait for the caller: however long it takes, the upstream is not at fault.
            th.eq(w, 94, hc.tick(cw, 100000), 0);
            th.eq(w, 95, hc.next_deadline(cw, 100000), 0 - 1);
            // Consumed at 100,000, the upstream has 300 ms to send the rest.
            th.eq(w, 97, hc.consume(cw, t, 3, 100000), 3);
            th.eq(w, 98, hc.next_deadline(cw, 100000), 300);
            th.eq(w, 99, hc.tick(cw, 100299), 0);
            th.eq(w, 100, hc.tick(cw, 100300), 1);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 100300));
            th.eq(w, 102, hc.failure(cw, t), wire.c_body_timeout());
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

pub fn test_the_whole_exchange_has_a_bound_of_its_own[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 1, 2048, 1024, th.limits(100, 200, 300, 5000, 1000, 0, 0, 8, 1000));
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            w[1] = th.mode_all();
            let t = th.started(heap, cw, w, log, 1, "GET", "/x", hc.body_none(), 0, 0);
            buffer.drop(heap, th.sent(heap, cw, 0, 10));
            th.reply(heap, cw, w, log, 0, "HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\n", 20);
            // A byte every 100 ms satisfies the body timer for ever; the total bound ends it at 5,000.
            var now = 120;
            while now < 5000 {
                hc.give(cw, 0, "x", now);
                buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), now));
                th.eq(w, 126, hc.tick(cw, now), 0);
                now = now + 100;
            }
            th.eq(w, 129, hc.next_deadline(cw, 4980), 20);
            th.eq(w, 130, hc.tick(cw, 4999), 0);
            th.eq(w, 131, hc.tick(cw, 5000), 1);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 5000));
            th.eq(w, 133, hc.failure(cw, t), wire.c_total_timeout());
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

pub fn test_the_time_the_caller_takes_to_give_a_request_body_is_not_charged_to_the_upstream[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 1, 2048, 1024, th.limits(100, 200, 300, 0, 1000, 0, 0, 8, 1000));
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            w[1] = th.mode_all();
            let t = th.started(heap, cw, w, log, 1, "POST", "/x", 10, 0, 0);
            buffer.drop(heap, th.sent(heap, cw, 0, 10));
            // The head is out and the body is not given: the caller is slow, not the upstream.
            th.eq(w, 152, hc.tick(cw, 50000), 0);
            th.eq(w, 153, hc.next_deadline(cw, 50000), 0 - 1);
            // Given at 50,000 and not taken by the transport: from then on the upstream (or the transport) is slow.
            th.eq(w, 155, hc.send_body(cw, t, "0123456789", 50000), 10);
            th.eq(w, 156, hc.next_deadline(cw, 50000), 200);
            th.eq(w, 157, hc.tick(cw, 50199), 0);
            th.eq(w, 158, hc.tick(cw, 50200), 1);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 50200));
            th.eq(w, 160, hc.failure(cw, t), wire.c_head_timeout());
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

pub fn test_a_connection_that_ends_says_where_in_the_response_it_ended[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    // Before any byte: closed early. In the head: truncated. In a length body, in a chunk, between chunks: truncated.
    if th.cut_after(heap, "", 0) != wire.c_closed_early() {
        failed = failed + 1;
    }
    if th.cut_after(heap, "HTTP/1.1 200 O", 0) != wire.c_truncated() {
        failed = failed + 2;
    }
    if th.cut_after(heap, "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhel", 0) != wire.c_truncated() {
        failed = failed + 4;
    }
    if th.cut_after(heap, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhel", 0) != wire.c_truncated() {
        failed = failed + 8;
    }
    if th.cut_after(heap, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n", 0) != wire.c_truncated() {
        failed = failed + 16;
    }
    if th.cut_after(heap, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n", 0) != wire.c_truncated() {
        failed = failed + 32;
    }
    // A body that runs to the end of the connection is complete when it ends, and so is one that was whole already.
    if th.cut_after(heap, "HTTP/1.1 200 OK\r\n\r\nabc", 0) != 0 {
        failed = failed + 64;
    }
    if th.cut_after(heap, "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nabc", 0) != 0 {
        failed = failed + 128;
    }
    // A failure of the transport is a reset wherever it falls, even in a body that would have run to the end.
    if th.cut_after(heap, "", 1) != wire.c_reset() {
        failed = failed + 256;
    }
    if th.cut_after(heap, "HTTP/1.1 200 O", 1) != wire.c_reset() {
        failed = failed + 512;
    }
    if th.cut_after(heap, "HTTP/1.1 200 OK\r\n\r\nabc", 1) != wire.c_reset() {
        failed = failed + 1024;
    }
    if th.cut_after(heap, "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nabc", 1) != 0 {
        failed = failed + 2048;
    }
    return failed;
}

pub fn test_a_dial_that_fails_says_why[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var kind = 0;
    while kind < 3 {
        var c = hc.open(heap, 1, 2048, 1024, hc.default_limits());
        borrow mut c as &!cw in {
            region a {
                let w = alloc_slice[a](8, 0);
                let log = alloc_slice[a](128, 0);
                w[1] = th.mode_detach();
                let t = hc.request(cw, 0, 1, "GET", "/x", "h", "", hc.body_none(), 0);
                buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 0));
                th.eq(w, 224, hc.connect_failed(cw, 0, kind, 1), 0);
                buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 1));
                var want = wire.c_connect();
                if kind == 1 {
                    want = wire.c_tls();
                }
                if kind == 2 {
                    want = wire.c_resolve();
                }
                th.eq(w, 233, hc.failure(cw, t), want);
                th.eq(w, 234, th.count_of(w, log, 6), 1);
                th.eq(w, 235, th.count_of(w, log, 7), 1);
                th.eq(w, 236, hc.free_slots(cw), 1);
                // It is not a dial any more: it cannot be answered twice.
                th.eq(w, 238, hc.connect_failed(cw, 0, kind, 2), 0 - 1);
                th.eq(w, 239, hc.connected(cw, 0, 2), 0 - 1);
                failed = failed + w[7];
            }
        }
        hc.close(heap, c);
        kind = kind + 1;
    }
    return failed;
}

pub fn test_bytes_or_an_end_on_an_idle_connection_close_it[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 2, 2048, 1024, hc.default_limits());
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            w[1] = th.mode_all();
            let ok = "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n";
            th.exchange(heap, cw, w, log, 1, "/a", ok, 10);
            th.exchange(heap, cw, w, log, 2, "/b", ok, 10);
            th.eq(w, 260, hc.idle(cw), 2);
            // Whatever arrives on an idle connection is swallowed and closes it.
            th.ck(w, 262, hc.room(cw, 0) > 0);
            let stray = "HTTP/1.1 408 Request Timeout\r\n\r\n";
            th.eq(w, 264, hc.give(cw, 0, stray, 20), len(stray));
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 20));
            th.eq(w, 266, hc.close_reason(cw, 0), hc.r_unsolicited());
            th.eq(w, 267, hc.idle(cw), 1);
            th.eq(w, 268, hc.room(cw, 0), 0);
            // An end on an idle connection closes it too.
            th.eq(w, 270, hc.eof(cw, 1, 21), 0);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 21));
            th.eq(w, 272, hc.close_reason(cw, 1), hc.r_peer_closed());
            th.eq(w, 273, hc.idle(cw), 0);
            // The next request to either dials.
            let before = hc.connects(cw);
            hc.request(cw, 30, 1, "GET", "/c", "h", "", hc.body_none(), 0);
            th.eq(w, 277, hc.connects(cw), before + 1);
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

pub fn test_an_abort_closes_the_connection_and_reports_nothing[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 2, 2048, 1024, hc.default_limits());
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            w[1] = th.mode_all();
            // While dialling.
            let t1 = hc.request(cw, 0, 1, "GET", "/a", "h", "", hc.body_none(), 0);
            th.eq(w, 295, hc.abort(cw, t1, 1), 0);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 1));
            th.eq(w, 297, th.count_of(w, log, 1), 0);
            th.eq(w, 298, th.count_of(w, log, 7), 1);
            th.eq(w, 299, th.count_of(w, log, 6), 0);
            th.eq(w, 300, hc.close_reason(cw, hc.ticket_slot(t1)), hc.r_aborted());
            th.eq(w, 301, hc.abort(cw, t1, 2), 0 - 1);
            // In the middle of a response.
            let t2 = th.started(heap, cw, w, log, 1, "GET", "/b", hc.body_none(), 0, 3);
            buffer.drop(heap, th.sent(heap, cw, hc.ticket_slot(t2), 3));
            th.reply(heap, cw, w, log, hc.ticket_slot(t2), "HTTP/1.1 200 OK\r\nContent-Length: 10\r\n\r\nabc", 4);
            th.eq(w, 306, hc.abort(cw, t2, 5), 0);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 5));
            th.eq(w, 308, th.count_of(w, log, 6), 0);
            th.eq(w, 309, th.count_of(w, log, 5), 0);
            th.eq(w, 310, hc.free_slots(cw), 2);
            th.eq(w, 311, hc.idle(cw), 0);
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

// ---------------------------------------------------------------------
// Refusals at the call
// ---------------------------------------------------------------------
pub fn test_a_request_that_is_not_one_is_refused_with_its_tag[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 2, 2048, 1024, hc.default_limits());
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let none = hc.body_none();
            th.eq(w, 329, hc.request(cw, 0, 0 - 1, "GET", "/", "h", "", none, 0), 0 - wire.c_key());
            th.eq(w, 330, hc.request(cw, 0, 1, "", "/", "h", "", none, 0), 0 - wire.c_method());
            th.eq(w, 331, hc.request(cw, 0, 1, "GE T", "/", "h", "", none, 0), 0 - wire.c_method());
            th.eq(w, 332, hc.request(cw, 0, 1, "CONNECT", "/", "h", "", none, 0), 0 - wire.c_method());
            th.eq(w, 333, hc.request(cw, 0, 1, "GET\r\n", "/", "h", "", none, 0), 0 - wire.c_method());
            th.eq(w, 334, hc.request(cw, 0, 1, "GET", "", "h", "", none, 0), 0 - wire.c_target());
            th.eq(w, 335, hc.request(cw, 0, 1, "GET", "x", "h", "", none, 0), 0 - wire.c_target());
            th.eq(w, 336, hc.request(cw, 0, 1, "GET", "/a b", "h", "", none, 0), 0 - wire.c_target());
            th.eq(w, 337, hc.request(cw, 0, 1, "GET", "/a#b", "h", "", none, 0), 0 - wire.c_target());
            th.eq(w, 338, hc.request(cw, 0, 1, "GET", "/a\r\nX: y", "h", "", none, 0), 0 - wire.c_target());
            th.eq(w, 339, hc.request(cw, 0, 1, "GET", "http://other/", "h", "", none, 0), 0 - wire.c_target());
            th.eq(w, 340, hc.request(cw, 0, 1, "GET", "/", "", "", none, 0), 0 - wire.c_host());
            th.eq(w, 341, hc.request(cw, 0, 1, "GET", "/", "a b", "", none, 0), 0 - wire.c_host());
            th.eq(w, 342, hc.request(cw, 0, 1, "GET", "/", "a/b", "", none, 0), 0 - wire.c_host());
            th.eq(w, 343, hc.request(cw, 0, 1, "GET", "/", "a\r\nX: y", "", none, 0), 0 - wire.c_host());
            // A caller's header lines: whole, well formed, and none the client writes itself.
            th.eq(w, 345, hc.request(cw, 0, 1, "GET", "/", "h", "X: y", none, 0), 0 - wire.c_header());
            th.eq(w, 346, hc.request(cw, 0, 1, "GET", "/", "h", "X: y\n", none, 0), 0 - wire.c_header());
            th.eq(w, 347, hc.request(cw, 0, 1, "GET", "/", "h", "X y\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 348, hc.request(cw, 0, 1, "GET", "/", "h", ": y\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 349, hc.request(cw, 0, 1, "GET", "/", "h", "X: y\r\nZ", none, 0), 0 - wire.c_header());
            th.eq(w, 350, hc.request(cw, 0, 1, "GET", "/", "h", "X: y\r\n\r\nGET / HTTP/1.1\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 351, hc.request(cw, 0, 1, "GET", "/", "h", "Host: other\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 352, hc.request(cw, 0, 1, "GET", "/", "h", "content-length: 4\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 353, hc.request(cw, 0, 1, "GET", "/", "h", "Transfer-Encoding: chunked\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 354, hc.request(cw, 0, 1, "GET", "/", "h", "CONNECTION: close\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 355, hc.request(cw, 0, 1, "GET", "/", "h", "Expect: 100-continue\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 356, hc.request(cw, 0, 1, "GET", "/", "h", "Upgrade: websocket\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 357, hc.request(cw, 0, 1, "GET", "/", "h", "TE: trailers\r\n", none, 0), 0 - wire.c_header());
            th.eq(w, 358, hc.request(cw, 0, 1, "GET", "/", "h", "Keep-Alive: 5\r\n", none, 0), 0 - wire.c_header());
            // Lengths and flags.
            th.eq(w, 360, hc.request(cw, 0, 1, "POST", "/", "h", "", 0 - 3, 0), 0 - wire.c_length());
            th.eq(w, 361, hc.request(cw, 0, 1, "POST", "/", "h", "", 9007199254740992, 0), 0 - wire.c_length());
            th.eq(w, 362, hc.request(cw, 0, 1, "GET", "/", "h", "", none, 8), 0 - wire.c_length());
            th.eq(w, 363, hc.request(cw, 0, 1, "GET", "/", "h", "", none, 0 - 1), 0 - wire.c_length());
            // The head must fit in the output buffer (1,024 bytes).
            region big {
                let target = alloc_slice[big](2000, byte_of(97));
                target[0] = byte_of(47);
                th.eq(w, 368, hc.request(cw, 0, 1, "GET", target, "h", "", none, 0), 0 - wire.c_too_large());
                // And one that fits exactly is taken.
                let fits = alloc_slice[big](1024 - len("GET  HTTP/1.1\r\nHost: h\r\n\r\n"), byte_of(97));
                fits[0] = byte_of(47);
                th.ck(w, 372, hc.request(cw, 0, 1, "GET", fits, "h", "", none, 0) > 0);
                let over = alloc_slice[big](1025 - len("GET  HTTP/1.1\r\nHost: h\r\n\r\n"), byte_of(97));
                over[0] = byte_of(47);
                th.eq(w, 375, hc.request(cw, 0, 1, "GET", over, "h", "", none, 0), 0 - wire.c_too_large());
            }
            // None of that took a slot but the one request that was accepted.
            th.eq(w, 378, hc.free_slots(cw), 1);
            th.eq(w, 379, hc.requests(cw), 1);
            // Well-formed headers are carried as they are.
            let ok = hc.request(cw, 0, 1, "GET", "/", "h", "X-One: 1\r\nX-Two:  two  \r\n", none, 0);
            th.ck(w, 382, ok > 0);
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

pub fn test_the_request_is_written_as_asked[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 8, 2048, 1024, hc.default_limits());
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            w[1] = th.mode_all();
            hc.request(cw, 0, 1, "GET", "/a?b=c&d", "example.com:8443", "X-One: 1\r\nAccept: */*\r\n", hc.body_none(), 0);
            hc.request(cw, 0, 2, "POST", "/", "[::1]:80", "", 0, 0);
            hc.request(cw, 0, 3, "DELETE", "/", "h", "", hc.body_none(), hc.flag_close());
            hc.request(cw, 0, 4, "PUT", "/", "h", "", 12, 0);
            hc.request(cw, 0, 5, "OPTIONS", "*", "h", "", hc.body_none(), 0);
            hc.request(cw, 0, 6, "PATCH", "/", "h", "", hc.body_chunked(), hc.flag_expect() + hc.flag_close());
            hc.request(cw, 0, 7, "GET", "/", "h", "", 0, 0);
            hc.request(cw, 0, 8, "POST", "/", "h", "", hc.body_chunked(), hc.flag_retry());
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 0));
            th.assert_bytes(heap, w, 407, th.sent(heap, cw, 0, 1), "GET /a?b=c&d HTTP/1.1\r\nHost: example.com:8443\r\nX-One: 1\r\nAccept: */*\r\n\r\n");
            th.assert_bytes(heap, w, 408, th.sent(heap, cw, 1, 1), "POST / HTTP/1.1\r\nHost: [::1]:80\r\nContent-Length: 0\r\n\r\n");
            th.assert_bytes(heap, w, 409, th.sent(heap, cw, 2, 1), "DELETE / HTTP/1.1\r\nHost: h\r\nConnection: close\r\n\r\n");
            th.assert_bytes(heap, w, 410, th.sent(heap, cw, 3, 1), "PUT / HTTP/1.1\r\nHost: h\r\nContent-Length: 12\r\n\r\n");
            th.assert_bytes(heap, w, 411, th.sent(heap, cw, 4, 1), "OPTIONS * HTTP/1.1\r\nHost: h\r\n\r\n");
            th.assert_bytes(heap, w, 412, th.sent(heap, cw, 5, 1), "PATCH / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\nExpect: 100-continue\r\nConnection: close\r\n\r\n");
            // A GET with a length of 0 says nothing of a body: it has none.
            th.assert_bytes(heap, w, 414, th.sent(heap, cw, 6, 1), "GET / HTTP/1.1\r\nHost: h\r\n\r\n");
            th.assert_bytes(heap, w, 415, th.sent(heap, cw, 7, 1), "POST / HTTP/1.1\r\nHost: h\r\nTransfer-Encoding: chunked\r\n\r\n");
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

// ---------------------------------------------------------------------
// Tickets, slots and every wrong argument
// ---------------------------------------------------------------------
pub fn test_every_call_with_a_wrong_handle_is_refused_and_changes_nothing[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 2, 2048, 1024, hc.default_limits());
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            w[1] = th.mode_all();
            let out = alloc_slice[a](16, byte_of(0));
            let t = th.started(heap, cw, w, log, 1, "GET", "/x", hc.body_none(), 0, 0);
            // Slots out of range, below zero, and slots that hold nothing.
            th.eq(w, 437, hc.take(cw, 0 - 1, out, 1), 0);
            th.eq(w, 438, hc.take(cw, 2, out, 1), 0);
            th.eq(w, 439, hc.take(cw, 1, out, 1), 0);
            th.eq(w, 440, hc.give(cw, 0 - 1, "x", 1), 0 - 1);
            th.eq(w, 441, hc.give(cw, 2, "x", 1), 0 - 1);
            th.eq(w, 442, hc.give(cw, 1, "x", 1), 0 - 1);
            th.eq(w, 443, hc.room(cw, 0 - 1), 0);
            th.eq(w, 444, hc.room(cw, 1), 0);
            th.eq(w, 445, hc.pending(cw, 1), 0);
            th.eq(w, 446, hc.eof(cw, 1, 1), 0 - 1);
            th.eq(w, 447, hc.eof(cw, 5, 1), 0 - 1);
            th.eq(w, 448, hc.reset(cw, 0 - 1, 1), 0 - 1);
            th.eq(w, 449, hc.connected(cw, 0, 1), 0 - 1);
            th.eq(w, 450, hc.connected(cw, 1, 1), 0 - 1);
            th.eq(w, 451, hc.connect_failed(cw, 1, 0, 1), 0 - 1);
            th.eq(w, 452, hc.detach(cw, 0, 1), 0 - 1);
            th.eq(w, 453, hc.detach(cw, 1, 1), 0 - 1);
            th.eq(w, 454, hc.detach(cw, 0 - 1, 1), 0 - 1);
            th.eq(w, 455, hc.key(cw, 1), 0 - 1);
            th.eq(w, 456, hc.key(cw, 7), 0 - 1);
            th.eq(w, 457, hc.ticket_of(cw, 1), 0 - 1);
            th.eq(w, 458, hc.close_reason(cw, 9), 0);
            // Tickets that were never issued, or are negative, or name a slot that is not there.
            th.eq(w, 460, hc.status(cw, 0 - 1), 0 - 1);
            th.eq(w, 461, hc.status(cw, 0), 0 - 1);
            th.eq(w, 462, hc.status(cw, 1), 0 - 1);
            th.eq(w, 463, hc.status(cw, 2), 0 - 1);
            th.eq(w, 464, hc.status(cw, 4096 * 7 + 5), 0 - 1);
            th.eq(w, 465, hc.avail(cw, 99999999), 0);
            th.eq(w, 466, len(hc.body(cw, 0 - 5)), 0);
            th.eq(w, 467, len(hc.head(cw, 12345)), 0);
            th.eq(w, 468, len(hc.header(cw, t, "content-type")), 0);
            th.eq(w, 469, hc.header_count(cw, 1), 0);
            th.eq(w, 470, hc.consume(cw, 0 - 1, 0, 1), 0 - 1);
            th.eq(w, 471, hc.consume(cw, t, 1, 1), 0 - 1);
            th.eq(w, 472, hc.send_body(cw, 0 - 4, "x", 1), 0 - wire.c_ticket());
            th.eq(w, 473, hc.send_body(cw, t + 4096, "x", 1), 0 - wire.c_ticket());
            th.eq(w, 474, hc.end_body(cw, 3, 1), 0 - wire.c_ticket());
            th.eq(w, 475, hc.send_room(cw, 0 - 1), 0);
            th.eq(w, 476, hc.abort(cw, 0 - 1, 1), 0 - 1);
            th.eq(w, 477, hc.abort(cw, t + 4096, 1), 0 - 1);
            th.eq(w, 478, hc.failure(cw, 0 - 1), 0);
            th.eq(w, 479, hc.attempts(cw, 0 - 1), 0);
            th.ck(w, 480, !hc.request_complete(cw, 0 - 1));
            th.ck(w, 481, !hc.reused(cw, 0 - 1));
            th.eq(w, 482, hc.ticket_slot(0 - 1), 0 - 1);
            th.eq(w, 483, hc.retire(cw, 99, 1), 0);
            // The request in hand is untouched by all that.
            th.eq(w, 485, hc.pending(cw, 0), len("GET /x HTTP/1.1\r\nHost: h\r\n\r\n"));
            th.reply(heap, cw, w, log, 0, "HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\n", 2);
            th.eq(w, 487, hc.status(cw, t), 200);
            // `consume` of more than is waiting, or less than nothing, is refused.
            let u = th.started(heap, cw, w, log, 1, "GET", "/y", hc.body_none(), 0, 3);
            buffer.drop(heap, th.sent(heap, cw, 0, 3));
            w[1] = th.mode_dial() + th.mode_detach();
            th.reply(heap, cw, w, log, 0, "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nabcd", 4);
            th.eq(w, 493, hc.avail(cw, u), 4);
            th.eq(w, 494, hc.consume(cw, u, 5, 5), 0 - 1);
            th.eq(w, 495, hc.consume(cw, u, 0 - 1, 5), 0 - 1);
            th.eq(w, 496, hc.consume(cw, u, 0, 5), 0);
            th.eq(w, 497, hc.avail(cw, u), 4);
            th.eq(w, 498, hc.consume(cw, u, 4, 5), 4);
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}

pub fn test_the_head_can_be_read_until_the_first_byte_of_the_body_is_taken[&h](heap: &!h Heap) -> [heap] int {
    var failed = 0;
    var c = hc.open(heap, 1, 2048, 1024, hc.default_limits());
    borrow mut c as &!cw in {
        region a {
            let w = alloc_slice[a](8, 0);
            let log = alloc_slice[a](128, 0);
            w[1] = th.mode_dial() + th.mode_detach();
            let t = th.started(heap, cw, w, log, 1, "GET", "/x", hc.body_none(), 0, 0);
            buffer.drop(heap, th.sent(heap, cw, 0, 1));
            let text = "HTTP/1.1 201 Created\r\nContent-Type: text/plain\r\nSet-Cookie: a=1\r\nSET-COOKIE: b=2\r\nX-Empty:\r\nContent-Length: 6\r\n\r\nbody!!";
            th.reply(heap, cw, w, log, 0, text, 2);
            th.eq(w, 518, hc.status(cw, t), 201);
            th.eq(w, 519, hc.header_count(cw, t), 5);
            th.ck(w, 520, bytes.equal(hc.header_name(cw, t, 0), "Content-Type"));
            th.ck(w, 521, bytes.equal(hc.header_value(cw, t, 0), "text/plain"));
            th.ck(w, 522, bytes.equal(hc.header_name(cw, t, 3), "X-Empty"));
            th.ck(w, 523, bytes.equal(hc.header_value(cw, t, 3), ""));
            th.ck(w, 524, bytes.equal(hc.header(cw, t, "content-type"), "text/plain"));
            th.ck(w, 525, bytes.equal(hc.header(cw, t, "set-cookie"), "a=1"));
            th.ck(w, 526, bytes.equal(hc.header(cw, t, "content-length"), "6"));
            th.eq(w, 527, len(hc.header(cw, t, "nope")), 0);
            th.eq(w, 528, len(hc.header_name(cw, t, 5)), 0);
            th.eq(w, 529, len(hc.header_name(cw, t, 0 - 1)), 0);
            th.eq(w, 530, len(hc.head(cw, t)), len(text) - 6);
            th.ck(w, 531, bytes.starts_with(hc.head(cw, t), "HTTP/1.1 201 Created\r\n"));
            th.ck(w, 532, bytes.equal(hc.body(cw, t), "body!!"));
            th.eq(w, 533, hc.consume(cw, t, 2, 3), 2);
            // The text of the head went with the bytes before the body's; the numbers stay.
            th.eq(w, 535, len(hc.head(cw, t)), 0);
            th.eq(w, 536, hc.header_count(cw, t), 0);
            th.eq(w, 537, hc.status(cw, t), 201);
            th.eq(w, 538, hc.content_length(cw, t), 6);
            th.eq(w, 539, hc.body_kind(cw, t), 1);
            th.ck(w, 540, bytes.equal(hc.body(cw, t), "dy!!"));
            th.eq(w, 541, hc.consume(cw, t, 4, 4), 4);
            buffer.drop(heap, th.pump(heap, cw, w, log, buffer.empty(heap, 16), 4));
            th.eq(w, 543, th.count_of(w, log, 5), 1);
            failed = w[7];
        }
    }
    hc.close(heap, c);
    return failed;
}
