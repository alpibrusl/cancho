// Same host, ports that merely share digits: the port is exact, so `:80` and `:8080` are disjoint and the form accepts
// both. (`docs/net-bounds.md` §2.2.)
//~ STDOUT 0
//~ EXIT 0

edition 5;
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(clock);
    let (a, b) = narrow(net, "127.0.0.1:80", "127.0.0.1:8080");
    release(a);
    release(b);
    borrow mut io as &!i in {
        putchar(i, '0');
        putchar(i, 10);
    }
    release(io);
    return 0;
}
