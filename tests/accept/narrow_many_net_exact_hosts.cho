// `docs/net-bounds.md` §2.3, edition 10: two exact hosts one digit apart are disjoint siblings. (Before edition 10
// `127.0.0.1` was a prefix of `127.0.0.10`, and the form refused the pair.)
//~ EXIT 0

edition 10;
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    let (a, b) = narrow(net, "127.0.0.1:9", "127.0.0.10:9");
    release(a);
    release(b);
    return 0;
}
