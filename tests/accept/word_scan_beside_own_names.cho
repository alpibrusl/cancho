//~ EXIT 0

// `docs/word-scan.md` §6: a program at edition 7 may declare `popcount`, `trailing_zeros`, `leading_zeros`, `load_le64`
// and `byte_mask64` itself, and means its own: the new names are not visible before edition 8, so nothing it wrote moves.

edition 7;

fn popcount(x: int) -> [] int {
    return x + 1;
}

fn trailing_zeros(x: int) -> [] int {
    return x + 2;
}

fn leading_zeros(x: int) -> [] int {
    return x + 3;
}

fn load_le64[&t](text: &t [byte], at: int) -> [] int {
    return at + len(text);
}

fn byte_mask64[&t](text: &t [byte], at: int, b: int) -> [] int {
    return at + b + len(text);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    if popcount(1) != 2 || trailing_zeros(1) != 3 || leading_zeros(1) != 4 {
        return 1;
    }
    if load_le64("abc", 1) != 4 || byte_mask64("abc", 1, 2) != 6 {
        return 2;
    }
    return 0;
}
