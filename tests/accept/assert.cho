// `std.test`: `assert`/`assert_eq`/`assert_ne`, the primitive
// `docs/testing.md` §2 argues a program had no way to state at all.
//
// Every assertion here passes, which is the point: this fixture is
// what "an assumption held" looks like. `traps::assert_fails_the_same_way_every_other_trap_does`
// (`crates/cancho/tests/conformance/traps.rs`) is what "an assumption
// failed" looks like — killed by a signal, the same as every other
// trap, not a value this file's own `//~ EXIT` could express.
//~ STDOUT ok
//~ EXIT 0

import std.test;
import std.io as console;

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(args);
    release(ffi);
    release(fs);
    release(heap);

    test.assert(1 == 1);
    test.assert_eq(2 + 2, 4);
    test.assert_ne(1, 2);
    test.assert(test.assert_eq(3, 3) == 0);

    borrow mut io as &!i in {
        console.write_all(i, "ok");
        console.newline(i);
    }
    release(io);
    return 0;
}
