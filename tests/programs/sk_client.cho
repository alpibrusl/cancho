edition 9;

import std.io as console;
import std.buffer;
import std.bytes;
import std.conns;

// A scripted socket client for the command tests (docs/gate.md, G4 wave 3), in cancho.
//
//     sk_client PORT SCRIPT
//
// SCRIPT is one argument: lines of commands, run in order against a server that is already listening (the test's shell script starts it).
// Connections are numbered slots 0 to 15. The client prints a transcript that the test compares with a file; several clients at once are
// several processes of this program, started by the script with `&`. Exit 0 when the script ran to its end, 2 when a connection was refused
// for ten seconds, 3 for a line it does not understand.
//
//     open S               dial 127.0.0.1:PORT into slot S (retrying for ten seconds while nothing listens)
//     close S              close slot S
//     send S TEXT          write TEXT (escapes \r \n \t \\ ) in one go
//     rep S N C            write N copies of the character C
//     put TEXT             add TEXT to the pending write         putgen N SEED   add N generated bytes (see GEN)
//     putchunked N SEED PIECE EXT TRAILERS   add a generated body as chunks of PIECE bytes, EXT after each size (- for none), then the
//                          last chunk and TRAILERS (escapes)     flush S   write the pending bytes to slot S in one go
//     gen S N SEED PIECE PAUSE   write N generated bytes in pieces of PIECE bytes, PAUSE milliseconds between them; prints sent n=.. c=..
//                          Byte i is 97 + (7 i + i / 13 + SEED) mod 26; c is the running checksum  c = (131 c + byte) mod 1000000007
//     chunked S N SEED PIECE EXT TRAILERS    putchunked, then flush S
//     head S               read a response head (to the blank line); prints each line after `< `
//     resp S               head, then the body of its Content-Length; prints the body after `= `
//     ends S MS            prints whether the connection ends (or is reset) within MS milliseconds
//     read S NEEDLE MS     read until NEEDLE has arrived, the connection ends or MS pass; prints how many reads, over how long
//     show S MS            read what comes in MS milliseconds (or until the end) and print it with \r and \n escaped
//     sleep MS             stamp [K]   remember the time (in clock K, 0 to 3)     since lt|gt MS [K]   whether the time since stamp K is less or greater than MS
//     fill S MB            write 64 KiB at a time to a slot nobody reads until the kernel refuses for 500 ms or MB mebibytes went in
//     ticks S N PAUSE TEXT write TEXT N times, PAUSE milliseconds apart, ignoring a connection that has gone

fn number[&b](b: &b [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(b) && int_of(b[i]) >= '0' && int_of(b[i]) <= '9' {
        n = n * 10 + (int_of(b[i]) - '0');
        i = i + 1;
    }
    return n;
}

// Sleep `ms` milliseconds: a poller with nothing registered waits out its timeout.
fn nap(ms: int) -> [poll] int {
    match poller_new() {
        Polling::Ok(p) => {
            var poller = p;
            region r {
                let events = alloc_slice[r](8, 0);
                borrow mut poller as &!ph in {
                    poller_wait(ph, events, ms);
                }
            }
            poller_close(poller);
            return 0;
        }
        Polling::Failed(e) => {
            return 1;
        }
    }
}

// Wait until slot `slot` is ready for `events` (1 read, 2 write) or `ms` pass: 1 ready, 0 not.
fn ready[&t](table: &!t conns.Table, slot: int, events: int, ms: int) -> [poll] int {
    var answer = 0;
    match poller_new() {
        Polling::Ok(p) => {
            var poller = p;
            borrow mut poller as &!ph in {
                if conns.watch(table, ph, slot, 1, events) == 0 {
                    region r {
                        let out = alloc_slice[r](8, 0);
                        if poller_wait(ph, out, ms) > 0 {
                            answer = 1;
                        }
                    }
                }
            }
            poller_close(poller);
        }
        Polling::Failed(e) => {
        }
    }
    return answer;
}

// Write all of `data` to slot `slot`: 0, or -1 when the connection has gone.
fn send_all[&t, &d](table: &!t conns.Table, slot: int, data: &d [byte]) -> [conn_write, poll] int {
    var off = 0;
    while off < len(data) {
        match conns.write(table, slot, data[off..len(data)]) {
            Sent::Wrote(n) => {
                off = off + n;
            }
            Sent::Again => {
                ready(table, slot, 2, 5000);
            }
            Sent::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    return 0;
}

// Read some bytes into `into` from slot `slot`, waiting up to `ms`: the count, 0 at the end of the stream, -1 on a timeout, -2 on a reset.
fn recv_some[&t, &b](table: &!t conns.Table, slot: int, into: &!b [byte], ms: int) -> [conn_read, poll] int {
    var tries = 0;
    while tries < 3 {
        match conns.read(table, slot, into) {
            Received::Data(n) => {
                return n;
            }
            Received::End => {
                return 0;
            }
            Received::Again => {
                if ready(table, slot, 1, ms) == 0 {
                    return 0 - 1;
                }
            }
            Received::Failed(e) => {
                return 0 - 2;
            }
        }
        tries = tries + 1;
    }
    return 0 - 1;
}

// The generated byte i of stream `seed`.
fn byte_at(i: int, seed: int) -> [] int {
    return 97 + (i * 7 + i / 13 + seed) % 26;
}

// Append `n` generated bytes of stream `seed`, starting at index `from`, to `out`; the checksum goes on from `sum`.
fn push_gen[&h](heap: &!h Heap, out: buffer.Buffer, from: int, n: int, seed: int) -> [heap] buffer.Buffer {
    var b = out;
    var i = from;
    while i < from + n {
        b = buffer.push(heap, b, byte_of(byte_at(i, seed)));
        i = i + 1;
    }
    return b;
}

fn checksum_of[&t](text: &t [byte]) -> [] int {
    var c = 0;
    var i = 0;
    while i < len(text) {
        c = (c * 131 + int_of(text[i])) % 1000000007;
        i = i + 1;
    }
    return c;
}

fn hex_push[&h](heap: &!h Heap, out: buffer.Buffer, n: int) -> [heap] buffer.Buffer {
    var b = out;
    if n >= 16 {
        b = hex_push(heap, b, n / 16);
    }
    let d = n % 16;
    if d < 10 {
        return buffer.push(heap, b, byte_of('0' + d));
    }
    return buffer.push(heap, b, byte_of('a' + d - 10));
}

// `text` with \r \n \t \\ decoded.
fn unescape[&h, &t](heap: &!h Heap, out: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    var b = out;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c == '\\' && i + 1 < len(text) {
            let d = int_of(text[i + 1]);
            if d == 'r' {
                b = buffer.push(heap, b, byte_of(13));
            } else if d == 'n' {
                b = buffer.push(heap, b, byte_of(10));
            } else if d == 't' {
                b = buffer.push(heap, b, byte_of(9));
            } else if d == 's' {
                b = buffer.push(heap, b, byte_of(32));
            } else {
                b = buffer.push(heap, b, byte_of(d));
            }
            i = i + 2;
        } else {
            b = buffer.push(heap, b, byte_of(c));
            i = i + 1;
        }
    }
    return b;
}

// The text of a line after its first `k` words.
fn rest_of[&t](line: &t [byte], k: int) -> [] &t [byte] {
    var at = 0;
    var seen = 0;
    while at < len(line) && seen < k {
        if int_of(line[at]) == ' ' {
            seen = seen + 1;
        }
        at = at + 1;
    }
    return line[at..len(line)];
}

fn is[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    return bytes.equal(x, y);
}

// Print `text` with the carriage returns taken out, every line after `prefix`.
fn print_lines[&i, &p, &t](io: &!i Io, prefix: &p [byte], text: &t [byte]) -> [io_write] int {
    var start = 0;
    var i = 0;
    while i <= len(text) {
        if i == len(text) || int_of(text[i]) == 10 {
            if i > start {
                var end = i;
                if int_of(text[end - 1]) == 13 {
                    end = end - 1;
                }
                if end > start {
                    console.write_all(io, prefix);
                    console.write_all(io, text[start..end]);
                    console.newline(io);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

// Print `text` on one line with \r and \n escaped.
fn print_escaped[&i, &t](io: &!i Io, text: &t [byte]) -> [io_write] int {
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c == 13 {
            console.write_all(io, "\\r");
        } else if c == 10 {
            console.write_all(io, "\\n");
        } else {
            console.write_all(io, text[i..i + 1]);
        }
        i = i + 1;
    }
    console.newline(io);
    return 0;
}

// Read one response head (to the blank line, inclusive) into a buffer; `ms` for each byte.
fn read_head[&h, &t](heap: &!h Heap, table: &!t conns.Table, slot: int, ms: int) -> [heap, conn_read, poll] buffer.Buffer {
    var out = buffer.empty(heap, 256);
    var going = true;
    region r {
        let one = alloc_slice[r](1, byte_of(0));
        while going {
            let n = recv_some(table, slot, one, ms);
            if n <= 0 {
                going = false;
            } else {
                out = buffer.push(heap, out, one[0]);
                borrow out as &ob in {
                    let all = buffer.bytes(ob);
                    if len(all) >= 4 && bytes.ends_with(all, "\r\n\r\n") {
                        going = false;
                    }
                }
            }
        }
    }
    return out;
}

// Read exactly `n` bytes (fewer if the connection ends first) into a buffer.
fn read_body[&h, &t](heap: &!h Heap, table: &!t conns.Table, slot: int, n: int) -> [heap, conn_read, poll] buffer.Buffer {
    var out = buffer.empty(heap, n + 16);
    var left = n;
    region r {
        let chunk = alloc_slice[r](4096, byte_of(0));
        while left > 0 {
            var want = left;
            if want > 4096 {
                want = 4096;
            }
            let got = recv_some(table, slot, chunk[0..want], 10000);
            if got <= 0 {
                left = 0;
            } else {
                out = buffer.append(heap, out, chunk[0..got]);
                left = left - got;
            }
        }
    }
    return out;
}

// `head S` and `resp S`: prints the head; with `body`, the body too.
fn response[&h, &i, &t](heap: &!h Heap, io: &!i Io, table: &!t conns.Table, slot: int, body: bool) -> [heap, conn_read, poll, io_write] int {
    var head = read_head(heap, table, slot, 10000);
    var length = 0;
    borrow head as &hb in {
        let text = buffer.bytes(hb);
        print_lines(io, "< ", text);
        let at = bytes.find(text, "Content-Length: ");
        if at >= 0 {
            length = number(text[at + 16..len(text)]);
        }
    }
    buffer.drop(heap, head);
    if body {
        var got = read_body(heap, table, slot, length);
        borrow got as &gb in {
            print_lines(io, "= ", buffer.bytes(gb));
        }
        buffer.drop(heap, got);
    }
    return 0;
}

fn open_slot[&h, &i, &n, &s](heap: &!h Heap, io: &!i Io, net: &n Net(""), port: int, table: conns.Table, st: &!s [int], slot: int) -> [heap, io_write, net_out(""), poll] (conns.Table, int) {
    var t = table;
    var tries = 0;
    while tries < 500 {
        match tcp_connect(net, "127.0.0.1", port) {
            Dialed::Ok(c) => {
                let (t2, real) = conns.put(heap, t, c);
                t = t2;
                borrow mut t as &!tw in {
                    conns.nonblocking(tw, real);
                }
                st[slot] = real + 1;
                return (t, 0);
            }
            Dialed::Failed(e) => {
                nap(20);
            }
        }
        tries = tries + 1;
    }
    console.write_all(io, "refused\n");
    return (t, 2);
}

// The chunked wire of `total` generated bytes: sizes in hex with `ext` after them (`-` for none), the last chunk and `trailers`.
fn push_chunked[&h, &e, &r](heap: &!h Heap, out: buffer.Buffer, total: int, seed: int, piece: int, ext: &e [byte], trailers: &r [byte]) -> [heap] buffer.Buffer {
    var b = out;
    var from = 0;
    var none = int_of(ext[0]) == '-';
    while from < total {
        var size = piece;
        if from + size > total {
            size = total - from;
        }
        b = hex_push(heap, b, size);
        if !none {
            b = buffer.append(heap, b, ext);
        }
        b = buffer.append(heap, b, "\r\n");
        b = push_gen(heap, b, from, size, seed);
        b = buffer.append(heap, b, "\r\n");
        from = from + size;
    }
    b = buffer.push(heap, b, byte_of('0'));
    if !none {
        b = buffer.append(heap, b, ext);
    }
    b = buffer.append(heap, b, "\r\n");
    b = unescape(heap, b, trailers);
    return buffer.append(heap, b, "\r\n");
}

fn yes_no[&i](io: &!i Io, yes: bool) -> [io_write] int {
    if yes {
        console.write_all(io, "yes\n");
    } else {
        console.write_all(io, "no\n");
    }
    return 0;
}

// Read into `got` until `needle` (not looked for when empty) has arrived, the connection ends or `ms` pass; the first and last read's time, and how many
// reads, go to st[20..22], and st[23] is 1 when the connection ended (or was reset).
fn read_until[&h, &t, &k, &n, &s](heap: &!h Heap, table: &!t conns.Table, clock: &k Clock, slot: int, needle: &n [byte], ms: int, st: &!s [int], got: buffer.Buffer) -> [heap, conn_read, poll, clock] buffer.Buffer {
    var out = got;
    borrow mut out as &!ow in {
        buffer.clear(ow);
    }
    let start = clock_ms(clock);
    st[20] = 0;
    st[21] = 0;
    st[22] = 0;
    st[23] = 0;
    var going = true;
    region r {
        let chunk = alloc_slice[r](8192, byte_of(0));
        while going && clock_ms(clock) - start < ms {
            let n = recv_some(table, slot, chunk, 50);
            if n > 0 {
                out = buffer.append(heap, out, chunk[0..n]);
                let now = clock_ms(clock);
                if st[22] == 0 {
                    st[20] = now;
                }
                st[21] = now;
                st[22] = st[22] + 1;
                if len(needle) > 0 {
                    borrow out as &ob in {
                        if bytes.find(buffer.bytes(ob), needle) >= 0 {
                            going = false;
                        }
                    }
                }
            } else if n == 0 || n == 0 - 2 {
                st[23] = 1;
                going = false;
            }
        }
    }
    return out;
}

fn check_chunks[&i, &t](io: &!i Io, all: &t [byte], taken: int, blind: int) -> [io_write] int {
    let head = bytes.find(all, "\r\n\r\n") + 4;
    let text = all[head..len(all)];
    let whole = len(text) / 4007;
    var ok = true;
    var c = 0;
    while c < whole && ok {
        let piece = text[c * 4007..(c + 1) * 4007];
        if !bytes.starts_with(piece, "fa0\r\n") || !bytes.ends_with(piece, "\r\n") {
            ok = false;
        }
        var j = 5;
        while j < 4005 && ok {
            if int_of(piece[j]) != 'x' {
                ok = false;
            }
            j = j + 1;
        }
        c = c + 1;
    }
    let tail = text[whole * 4007..len(text)];
    var k = 0;
    while k < len(tail) && ok {
        var want = 'x';
        if k < 5 {
            want = int_of("fa0\r\n"[k]);
        } else if k == 4005 {
            want = 13;
        } else if k == 4006 {
            want = 10;
        }
        if int_of(tail[k]) != want {
            ok = false;
        }
        k = k + 1;
    }
    let lost = taken + blind - len(text);
    console.write_all(io, "chunks whole, the last one at most cut: ");
    yes_no(io, ok);
    console.write_all(io, "bytes lost with the connection in 0..65536: ");
    yes_no(io, lost >= 0 && lost <= 65536);
    return 0;
}

// One command that works on connections already open: the pending bytes, and 0 or 3 for a line it does not understand.
fn step[&h, &i, &k, &t, &s, &l](heap: &!h Heap, io: &!i Io, clock: &k Clock, table: &!t conns.Table, pending: buffer.Buffer, got: buffer.Buffer, st: &!s [int], line: &l [byte]) -> [heap, io_write, conn_read, conn_write, poll, clock] (buffer.Buffer, buffer.Buffer, int) {
    var keep = pending;
    var seen = got;
    var status = 0;
    let cmd = bytes.field(line, ' ', 1);
    let word2 = bytes.field(line, ' ', 2);
    let arg2 = number(word2);
    let slot = st[arg2 % 16] - 1;
    if is(cmd, "sleep") {
        nap(arg2);
    } else if is(cmd, "stamp") {
        st[16 + arg2 % 4] = clock_ms(clock);
    } else if is(cmd, "since") {
        let spent = clock_ms(clock) - st[16 + number(bytes.field(line, ' ', 4)) % 4];
        let limit = number(bytes.field(line, ' ', 3));
        var yes = spent < limit;
        if is(word2, "gt") {
            yes = spent > limit;
        }
        console.write_all(io, "since ");
        console.write_all(io, word2);
        console.write_all(io, " ");
        console.print_int(io, limit);
        console.write_all(io, ": ");
        yes_no(io, yes);
    } else if is(cmd, "put") {
        keep = unescape(heap, keep, rest_of(line, 1));
    } else if is(cmd, "putgen") {
        keep = push_gen(heap, keep, 0, arg2, number(bytes.field(line, ' ', 3)));
    } else if is(cmd, "putchunked") {
        keep = push_chunked(heap, keep, arg2, number(bytes.field(line, ' ', 3)), number(bytes.field(line, ' ', 4)), bytes.field(line, ' ', 5), rest_of(line, 5));
    } else if is(cmd, "flush") {
        borrow keep as &kb in {
            send_all(table, slot, buffer.bytes(kb));
        }
        borrow mut keep as &!kw in {
            buffer.clear(kw);
        }
    } else if is(cmd, "chunked") {
        var wire = push_chunked(heap, buffer.empty(heap, 4096), number(bytes.field(line, ' ', 3)), number(bytes.field(line, ' ', 4)), number(bytes.field(line, ' ', 5)), bytes.field(line, ' ', 6), rest_of(line, 6));
        borrow wire as &wb in {
            send_all(table, slot, buffer.bytes(wb));
        }
        buffer.drop(heap, wire);
    } else if is(cmd, "close") {
        conns.close(table, slot);
    } else if is(cmd, "send") {
        var text = unescape(heap, buffer.empty(heap, 64), rest_of(line, 2));
        borrow text as &tb in {
            send_all(table, slot, buffer.bytes(tb));
        }
        buffer.drop(heap, text);
    } else if is(cmd, "rep") {
        var run_of = buffer.empty(heap, 64);
        let count = number(bytes.field(line, ' ', 3));
        var chb = unescape(heap, buffer.empty(heap, 4), bytes.field(line, ' ', 4));
        var j = 0;
        while j < count {
            borrow chb as &cb in {
                run_of = buffer.push(heap, run_of, buffer.bytes(cb)[0]);
            }
            j = j + 1;
        }
        buffer.drop(heap, chb);
        borrow run_of as &rb in {
            send_all(table, slot, buffer.bytes(rb));
        }
        buffer.drop(heap, run_of);
    } else if is(cmd, "gen") {
        status = gen(heap, io, table, slot, number(bytes.field(line, ' ', 3)), number(bytes.field(line, ' ', 4)), number(bytes.field(line, ' ', 5)), number(bytes.field(line, ' ', 6)));
    } else if is(cmd, "fill") {
        status = fill(io, table, slot, number(bytes.field(line, ' ', 3)));
    } else if is(cmd, "ticks") {
        var text = unescape(heap, buffer.empty(heap, 64), rest_of(line, 4));
        let rounds = number(bytes.field(line, ' ', 3));
        let pause = number(bytes.field(line, ' ', 4));
        var j = 0;
        while j < rounds {
            borrow text as &tb in {
                send_all(table, slot, buffer.bytes(tb));
            }
            nap(pause);
            j = j + 1;
        }
        buffer.drop(heap, text);
    } else if is(cmd, "read") {
        var needle = unescape(heap, buffer.empty(heap, 16), bytes.field(line, ' ', 3));
        borrow needle as &nb in {
            seen = read_until(heap, table, clock, slot, buffer.bytes(nb), number(bytes.field(line, ' ', 4)), st, seen);
            borrow seen as &sb in {
                console.write_all(io, "read ");
                console.write_all(io, bytes.field(line, ' ', 3));
                console.write_all(io, ": ");
                yes_no(io, bytes.find(buffer.bytes(sb), buffer.bytes(nb)) >= 0);
            }
        }
        buffer.drop(heap, needle);
    } else if is(cmd, "readend") {
        seen = read_until(heap, table, clock, slot, "", number(bytes.field(line, ' ', 3)), st, seen);
        console.write_all(io, "readend closed: ");
        yes_no(io, st[23] == 1);
    } else if is(cmd, "shows") {
        borrow seen as &sb in {
            print_escaped(io, buffer.bytes(sb));
        }
    } else if is(cmd, "has") {
        var needle = unescape(heap, buffer.empty(heap, 16), rest_of(line, 1));
        borrow needle as &nb in {
            borrow seen as &sb in {
                console.write_all(io, "has ");
                console.write_all(io, rest_of(line, 1));
                console.write_all(io, ": ");
                yes_no(io, bytes.find(buffer.bytes(sb), buffer.bytes(nb)) >= 0);
            }
        }
        buffer.drop(heap, needle);
    } else if is(cmd, "count") {
        // count NEEDLE MIN MAX: how many times NEEDLE is in what was read, and whether that is within MIN..MAX.
        let word = bytes.field(line, ' ', 2);
        var n = 0;
        borrow seen as &sb in {
            let text = buffer.bytes(sb);
            var at = 0;
            var going = true;
            while going {
                let hit = bytes.find(text[at..len(text)], word);
                if hit < 0 {
                    going = false;
                } else {
                    n = n + 1;
                    at = at + hit + len(word);
                }
            }
        }
        console.write_all(io, "count ");
        console.write_all(io, word);
        console.write_all(io, " in ");
        console.print_int(io, number(bytes.field(line, ' ', 3)));
        console.write_all(io, "..");
        console.print_int(io, number(bytes.field(line, ' ', 4)));
        console.write_all(io, ": ");
        yes_no(io, n >= number(bytes.field(line, ' ', 3)) && n <= number(bytes.field(line, ' ', 4)));
    } else if is(cmd, "spread") {
        // spread MS READS: the reads of the last `read` were at least MS apart from first to last, and at least READS of them.
        console.write_all(io, "spread >= ");
        console.print_int(io, arg2);
        console.write_all(io, " ms over >= ");
        console.print_int(io, number(bytes.field(line, ' ', 3)));
        console.write_all(io, " reads: ");
        yes_no(io, st[21] - st[20] >= arg2 && st[22] >= number(bytes.field(line, ' ', 3)));
    } else if is(cmd, "chunks") {
        // chunks: what was read is the head, then whole chunks (`fa0`, 4000 x, CRLF: 4007 bytes) with at most the last one cut,
        // and what the last `stats` said was taken, with what was offered blind, less the bytes read, is between 0 and 65536.
        borrow seen as &sb in {
            status = check_chunks(io, buffer.bytes(sb), st[24], st[25]);
        }
    } else if is(cmd, "want") {
        status = check_reply(heap, io, table, slot, st, bytes.field(line, ' ', 3), bytes.field(line, ' ', 4), false);
    } else if is(cmd, "ask") {
        var text = unescape(heap, buffer.empty(heap, 64), rest_of(line, 4));
        borrow text as &tb in {
            send_all(table, slot, buffer.bytes(tb));
        }
        buffer.drop(heap, text);
        status = check_reply(heap, io, table, slot, st, bytes.field(line, ' ', 3), bytes.field(line, ' ', 4), false);
    } else if is(cmd, "blob") {
        status = check_reply(heap, io, table, slot, st, "200", bytes.field(line, ' ', 3), true);
    } else if is(cmd, "wantn") {
        // wantn S N STATUS SIZE: N replies, each STATUS and a blob of SIZE bytes.
        var j = 0;
        let count = number(bytes.field(line, ' ', 3));
        while j < count {
            check_reply(heap, io, table, slot, st, bytes.field(line, ' ', 4), bytes.field(line, ' ', 5), true);
            j = j + 1;
        }
    } else if is(cmd, "tally") {
        console.write_all(io, "answers as wanted: ");
        console.print_int(io, st[26] - st[27]);
        console.write_all(io, " of ");
        console.print_int(io, st[26]);
        console.newline(io);
    } else if is(cmd, "line") {
        line_reply(heap, io, table, slot);
    } else if is(cmd, "nodelay") {
        conns.nodelay(table, slot);
    } else if is(cmd, "putrep") {
        let times = arg2;
        var text = unescape(heap, buffer.empty(heap, 64), rest_of(line, 2));
        var j = 0;
        while j < times {
            borrow text as &tb in {
                keep = buffer.append(heap, keep, buffer.bytes(tb));
            }
            j = j + 1;
        }
        buffer.drop(heap, text);
    } else if is(cmd, "bytewise") {
        // bytewise S PAUSE TEXT: TEXT one byte at a time, PAUSE milliseconds apart.
        var text = unescape(heap, buffer.empty(heap, 64), rest_of(line, 3));
        let pause = number(bytes.field(line, ' ', 3));
        borrow text as &tb in {
            let all = buffer.bytes(tb);
            var j = 0;
            while j < len(all) {
                send_all(table, slot, all[j..j + 1]);
                nap(pause);
                j = j + 1;
            }
        }
        buffer.drop(heap, text);
    } else if is(cmd, "size") {
        // size lt N: what the last `read` or `readend` gathered is less than N bytes.
        borrow seen as &sb in {
            console.write_all(io, "read size < ");
            console.print_int(io, number(bytes.field(line, ' ', 3)));
            console.write_all(io, ": ");
            yes_no(io, len(buffer.bytes(sb)) < number(bytes.field(line, ' ', 3)));
        }
    } else if is(cmd, "stats") {
        status = stats(heap, io, table, slot, st);
    } else if is(cmd, "head") {
        response(heap, io, table, slot, false);
    } else if is(cmd, "resp") {
        response(heap, io, table, slot, true);
    } else if is(cmd, "ends") {
        console.write_all(io, "ends ");
        console.print_int(io, arg2);
        console.write_all(io, ": ");
        yes_no(io, ends(table, slot, number(bytes.field(line, ' ', 3))));
    } else {
        status = 3;
    }
    return (keep, seen, status);
}

// `want S STATUS BODY` / `blob S SIZE`: read one reply and compare. A `-` skips a check; with `blob` the body must be `size` bytes of `a`..`z` repeating. The
// replies checked go to st[26], the ones that were not as wanted to st[27], each of those with a line of its own.
fn check_reply[&h, &i, &t, &s, &a, &b](heap: &!h Heap, io: &!i Io, table: &!t conns.Table, slot: int, st: &!s [int], status_text: &a [byte], body_text: &b [byte], blob: bool) -> [heap, io_write, conn_read, poll] int {
    var head = read_head(heap, table, slot, 10000);
    var status = 0;
    var length = 0;
    var close = false;
    borrow head as &hb in {
        let text = buffer.bytes(hb);
        if len(text) >= 12 {
            status = number(text[9..12]);
        }
        let at = bytes.find(text, "Content-Length: ");
        if at >= 0 {
            length = number(text[at + 16..len(text)]);
        }
        close = bytes.find(text, "Connection: close") >= 0;
    }
    buffer.drop(heap, head);
    var body = read_body(heap, table, slot, length);
    var wanted = unescape(heap, buffer.empty(heap, 32), body_text);
    var ok = true;
    borrow wanted as &wb in {
        borrow body as &bb in {
            let text = buffer.bytes(bb);
            if int_of(status_text[0]) != '-' && status != number(status_text) {
                ok = false;
            }
            if blob {
                if len(text) != number(body_text) {
                    ok = false;
                }
                var j = 0;
                while j < len(text) && ok {
                    if int_of(text[j]) != 97 + j % 26 {
                        ok = false;
                    }
                    j = j + 1;
                }
            } else if int_of(body_text[0]) != '-' && !bytes.equal(text, buffer.bytes(wb)) {
                ok = false;
            }
            st[26] = st[26] + 1;
            if !ok {
                st[27] = st[27] + 1;
                console.write_all(io, "MISMATCH on slot ");
                console.print_int(io, slot);
                console.write_all(io, ": ");
                console.print_int(io, status);
                console.write_all(io, " ");
                if len(text) > 80 {
                    console.write_all(io, text[0..80]);
                } else {
                    console.write_all(io, text);
                }
                console.write_all(io, " (wanted ");
                console.write_all(io, status_text);
                console.write_all(io, " ");
                console.write_all(io, body_text);
                console.write_all(io, ")\n");
            }
        }
    }
    buffer.drop(heap, wanted);
    buffer.drop(heap, body);
    return 0;
}

// `line S`: the reply on one line, `STATUS body N bytes, Connection: close yes|no`.
fn line_reply[&h, &i, &t](heap: &!h Heap, io: &!i Io, table: &!t conns.Table, slot: int) -> [heap, io_write, conn_read, poll] int {
    var head = read_head(heap, table, slot, 10000);
    var status = 0;
    var length = 0;
    var close = false;
    borrow head as &hb in {
        let text = buffer.bytes(hb);
        if len(text) >= 12 {
            status = number(text[9..12]);
        }
        let at = bytes.find(text, "Content-Length: ");
        if at >= 0 {
            length = number(text[at + 16..len(text)]);
        }
        close = bytes.find(text, "Connection: close") >= 0;
    }
    buffer.drop(heap, head);
    var body = read_body(heap, table, slot, length);
    buffer.drop(heap, body);
    console.print_int(io, status);
    console.write_all(io, " body ");
    console.print_int(io, length);
    console.write_all(io, " bytes, Connection: close: ");
    yes_no(io, close);
    return 0;
}

// `fill S MB`: write 64 KiB at a time to a connection nobody is reading until the kernel refuses for 500 ms or MB mebibytes are in.
fn fill[&i, &t](io: &!i Io, table: &!t conns.Table, slot: int, mb: int) -> [io_write, conn_write, poll] int {
    var written = 0;
    var blocked = 0;
    region r {
        let chunk = alloc_slice[r](65536, byte_of('q'));
        while blocked < 500 && written < mb * 1048576 {
            match conns.write(table, slot, chunk) {
                Sent::Wrote(n) => {
                    written = written + n;
                    blocked = 0;
                }
                Sent::Again => {
                    if ready(table, slot, 2, 50) == 0 {
                        blocked = blocked + 50;
                    }
                }
                Sent::Failed(e) => {
                    blocked = 500;
                }
            }
        }
    }
    console.write_all(io, "fill blocked: ");
    yes_no(io, blocked >= 500);
    console.write_all(io, "fill under 64 MiB: ");
    yes_no(io, written < 67108864);
    return 0;
}

// `stats S`: ask `GET /stats` on slot S until the server says `refused=1` (at most 30 s); the answer is `taken=N refused=R blind=B`, and N and B are kept.
fn stats[&h, &i, &t, &s](heap: &!h Heap, io: &!i Io, table: &!t conns.Table, slot: int, st: &!s [int]) -> [heap, io_write, conn_read, conn_write, poll] int {
    var tries = 0;
    while tries < 300 {
        send_all(table, slot, "GET /stats HTTP/1.1\r\nHost: t\r\n\r\n");
        var head = read_head(heap, table, slot, 10000);
        var length = 0;
        borrow head as &hb in {
            let at = bytes.find(buffer.bytes(hb), "Content-Length: ");
            if at >= 0 {
                length = number(buffer.bytes(hb)[at + 16..len(buffer.bytes(hb))]);
            }
        }
        buffer.drop(heap, head);
        var body = read_body(heap, table, slot, length);
        var done = false;
        borrow body as &bb in {
            let text = buffer.bytes(bb);
            let r = bytes.find(text, "refused=");
            if r >= 0 && int_of(text[r + 8]) == '1' {
                done = true;
                st[24] = number(text[bytes.find(text, "taken=") + 6..len(text)]);
                st[25] = number(text[bytes.find(text, "blind=") + 6..len(text)]);
            }
        }
        buffer.drop(heap, body);
        if done {
            console.write_all(io, "stats: the stream was ended (refused=1); taken is whole chunks: ");
            yes_no(io, st[24] > 0 && st[24] % 4007 == 0);
            console.write_all(io, "stats: an offer refused took less than a chunk: ");
            yes_no(io, st[25] < 4007);
            return 0;
        }
        nap(100);
        tries = tries + 1;
    }
    console.write_all(io, "stats: the stream was never ended\n");
    return 1;
}

// `gen S N SEED PIECE PAUSE`.
fn gen[&h, &i, &t](heap: &!h Heap, io: &!i Io, table: &!t conns.Table, slot: int, total: int, seed: int, piece: int, pause: int) -> [heap, io_write, conn_write, poll] int {
    var sum = 0;
    var from = 0;
    while from < total {
        var size = piece;
        if from + size > total {
            size = total - from;
        }
        var part = push_gen(heap, buffer.empty(heap, size + 8), from, size, seed);
        borrow part as &pb in {
            let text = buffer.bytes(pb);
            var j = 0;
            while j < len(text) {
                sum = (sum * 131 + int_of(text[j])) % 1000000007;
                j = j + 1;
            }
            send_all(table, slot, text);
        }
        buffer.drop(heap, part);
        from = from + size;
        if pause > 0 {
            nap(pause);
        }
    }
    console.write_all(io, "sent n=");
    console.print_int(io, total);
    console.write_all(io, " c=");
    console.print_int(io, sum);
    console.newline(io);
    return 0;
}

// Does the connection in `slot` end (or get reset) within `ms`, with nothing more to read?
fn ends[&t](table: &!t conns.Table, slot: int, ms: int) -> [conn_read, poll] bool {
    var done = false;
    var going = true;
    region r {
        let sink = alloc_slice[r](4096, byte_of(0));
        while going {
            let n = recv_some(table, slot, sink, ms);
            if n == 0 || n == 0 - 2 {
                done = true;
                going = false;
            } else if n < 0 {
                going = false;
            }
        }
    }
    return done;
}

fn run[&h, &i, &n, &k, &s](heap: &!h Heap, io: &!i Io, net: &n Net(""), clock: &k Clock, port: int, script: &s [byte]) -> [heap, io_write, net_out(""), conn_read, conn_write, poll, clock] int {
    var table = conns.empty(heap, 16);
    var pending = buffer.empty(heap, 256);
    var seen = buffer.empty(heap, 4096);
    var status = 0;
    region r {
        // 0..15: slot map (real slot + 1, or 0); 16: the stamp.
        let st = alloc_slice[r](32, 0);
        let lines = bytes.count_byte(script, 10) + 1;
        var at = 1;
        while at <= lines && status == 0 {
            let line = bytes.field(script, 10, at);
            at = at + 1;
            if len(line) > 0 && int_of(line[0]) != '#' {
                if is(bytes.field(line, ' ', 1), "open") {
                    let (t2, code) = open_slot(heap, io, net, port, table, st, number(bytes.field(line, ' ', 2)));
                    table = t2;
                    status = code;
                } else {
                    var code = 0;
                    borrow mut table as &!tw in {
                        let (kept, reread, c) = step(heap, io, clock, tw, pending, seen, st, line);
                        pending = kept;
                        seen = reread;
                        code = c;
                    }
                    status = code;
                }
            }
        }
    }
    conns.drop(heap, table);
    buffer.drop(heap, pending);
    buffer.drop(heap, seen);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(fs);
    release(signals);
    release(exec);
    release(tty);
    var status = 64;
    borrow mut io as &!i in {
        borrow mut heap as &!h in {
            borrow args as &a in {
                borrow net as &nn in {
                    borrow clock as &k in {
                        if arg_count(a) >= 3 {
                            status = run(h, i, nn, k, number(arg(a, 1)), arg(a, 2));
                        }
                    }
                }
            }
        }
    }
    release(clock);
    release(net);
    release(args);
    release(heap);
    release(io);
    return status;
}
