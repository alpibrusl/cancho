edition 5;

// `docs/tls-assurance.md` §3.3: one handshake message's body, from
// standard input, to the parser its first byte names (modulo 15):
//
//     0 server_hello (with the session id the client sends)
//     1 encrypted_extensions     2 certificate      3 certificate_verify
//     4 finished, SHA-256        5 finished, SHA-384
//     6 new_session_ticket       7 key_update
//     8 certificate12            9 server_key_exchange
//     10 certificate_request12
//     11 certificate_request (TLS 1.3)   12 certificate_request12_info   13 encrypted_extensions_alpn, an offer sent
//     14 the authorities of a CertificateRequest body against the client identity (`tls_cident.names_issuer`)
//     (`docs/tls-parity.md` §6.3, §6.6)
import fuzz_common;
import fuzz_fixture;
import std.io;
import tls_cident;
import tls_message;
import tls_slot;
import x509_key;

// Each parser's `info` is exactly as long as the client makes it, so a
// write past what the client allocates traps here too.
fn info_len(which: int) -> [] int {
    if which == 0 {
        return tls_message.sh_info_len();
    } else if which == 2 || which == 8 {
        return 3 + 2 * tls_message.max_certificates();
    } else if which == 3 {
        return 3;
    } else if which == 6 {
        return tls_message.nst_info_len();
    } else if which == 9 {
        return tls_message.ske_info_len();
    } else if which == 11 || which == 12 {
        return tls_message.cr_info_len();
    } else if which == 13 {
        return 2;
    }
    return 0;
}

fn parse[&b, &r, &f](which: int, b: &b [byte], random: &r [byte], info: &!f [int]) -> [] int {
    if which == 0 {
        return tls_message.server_hello(b, random[32..64], info);
    } else if which == 1 {
        return tls_message.encrypted_extensions(b);
    } else if which == 2 {
        return tls_message.certificate(b, info);
    } else if which == 3 {
        return tls_message.certificate_verify(b, info);
    } else if which == 4 {
        return tls_message.finished(b, 32);
    } else if which == 5 {
        return tls_message.finished(b, 48);
    } else if which == 6 {
        return tls_message.new_session_ticket(b, info);
    } else if which == 7 {
        return tls_message.key_update(b);
    } else if which == 8 {
        return tls_message.certificate12(b, info);
    } else if which == 9 {
        return tls_message.server_key_exchange(b, info);
    } else if which == 11 {
        return tls_message.certificate_request(b, info);
    } else if which == 12 {
        return tls_message.certificate_request12_info(b, info);
    } else if which == 13 {
        return tls_message.encrypted_extensions_alpn(b, true, info);
    }
    return tls_message.certificate_request12(b);
}

// Kind 14: the body is a CertificateRequest's (TLS 1.3); the authorities it names, if it parses, are matched against
// the fixture identity's chain, as `answer_request` does.
fn authorities[&b, &c, &w](body: &b [byte], cred: &!c [byte], work: &!w [int]) -> [] int {
    var found = 0;
    region q {
        let info = alloc_slice[q](tls_message.cr_info_len(), 0);
        if tls_message.certificate_request(body, info) == 0 && tls_cident.load(cred, 0, fuzz_fixture.identity_chain(), fuzz_fixture.identity_key(), "*", false, fuzz_fixture.now(), work) == 0 {
            if tls_cident.names_issuer(cred, 0, body[info[tls_message.cr_ca_start()]..info[tls_message.cr_ca_end()]]) {
                found = 1;
            }
        }
    }
    return found;
}

fn run[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] int {
    var input = box_slice(heap, 65536, byte_of(0));
    var random = box_slice(heap, 96, byte_of(0));
    // The identity's room and the key parser's work are more than a region holds.
    var cred = box_slice(heap, tls_cident.cfg_len(), byte_of(0));
    var work = box_slice(heap, x509_key.work_len(), 0);
    borrow mut input as &!d in {
        borrow mut random as &!r in {
            borrow mut cred as &!cw in {
                borrow mut work as &!ww in {
                    fuzz_common.load_random(contents(r));
                    let n = fuzz_common.read_all(io, contents(d));
                    if n > 0 {
                        let which = int_of(contents(d)[0]) % 15;
                        region q {
                            let info = alloc_slice[q](info_len(which), 0);
                            if which == 14 {
                                authorities(contents(d)[1..n], contents(cw), contents(ww));
                            } else {
                                parse(which, contents(d)[1..n], contents(r), info);
                            }
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, input);
    unbox_slice(heap, random);
    unbox_slice(heap, cred);
    unbox_slice(heap, work);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(args);
    release(ffi);
    release(fs);
    release(net);
    release(clock);
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            run(h, i);
        }
    }
    release(heap);
    release(io);
    return 0;
}
