edition 9;

import std.io as console;

// Bytes for the command tests (`tests/commands/ports.sh`): a shell cannot make a NUL or a byte over 127 reliably, so this does.
//
//     bytes_gen N MUL DIV
//
// writes N bytes to standard output, byte i being (i * MUL + i / DIV) mod 256.

fn number[&b](b: &b [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(b) && int_of(b[i]) >= '0' && int_of(b[i]) <= '9' {
        n = n * 10 + (int_of(b[i]) - '0');
        i = i + 1;
    }
    return n;
}

fn emit[&i](io: &!i Io, total: int, mul: int, div: int) -> [io_write] int {
    region r {
        let chunk = alloc_slice[r](4096, byte_of(0));
        var from = 0;
        while from < total {
            var size = 4096;
            if from + size > total {
                size = total - from;
            }
            var j = 0;
            while j < size {
                let at = from + j;
                chunk[j] = byte_of((at * mul + at / div) % 256);
                j = j + 1;
            }
            console.write_all(io, chunk[0..size]);
            from = from + size;
        }
    }
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    release(ffi);
    release(fs);
    release(heap);
    var status = 64;
    borrow mut io as &!i in {
        borrow args as &a in {
            if arg_count(a) >= 4 {
                status = emit(i, number(arg(a, 1)), number(arg(a, 2)), number(arg(a, 3)));
            }
        }
    }
    release(args);
    release(io);
    return status;
}
