edition 5;

// `docs/tls-memory.md` section 8: `packages/tls`'s work areas, with no network. A client engine and a server
// engine in one process, their bytes carried between them by this program, each with `areas` work areas for
// `slots` slots.
//
//     tls_pool <slots> <areas> <steps> <seed> [hold] [tickets] [mutual] < ca.pem NUL chain.pem NUL key.pem
//     tls_pool <slots> <areas> <steps> <seed> clientcert < ca.pem NUL chain.pem NUL key.pem NUL clients_cas.pem NUL client_chain.pem NUL client_key.pem NUL client_chain2.pem NUL client_big_chain.pem
//
// (the three files on standard input, a NUL byte between them; the leaf is for `echo.lex-sys.test`). It prints one
// line for each thing it checks, `ok ...` or `FAIL ...`, and exits 1 if any failed:
//
//   handshakes   every slot is started in turn on both engines, the next only once the engine says it has an
//                area (`areas_free`), and a start with none free is refused `tls-pool` and starts nothing;
//   steps        `steps` rounds, each on a slot an LCG picks: a message of 1 to 40,000 bytes goes to the server
//                in pieces of a size the LCG picks, comes back echoed, and is checked byte for byte; afterwards
//                the connection is idle, so the server has all its areas, and no free area or free slot holds a
//                byte (`tls.residue`), which is checked on both engines;
//   waiting      a connection with data waiting keeps its area while another connection is served;
//   partial      with one area: a record half fed to one connection holds it; a second connection fed then takes
//                nothing and stays established (`recv` on it needs no area), and is served with the same bytes once
//                the area is back; a third whose socket ends with no area free fails `tls-peer-closed`, keys cleared;
//   tickets      (with `tickets`) the server sends two tickets a connection, the client saves one in every slot and
//                the next connection resumes with it, `tls.residue` 0 throughout; `mutual` opens the client engine
//                with a client identity (`open_mutual_with_areas`, `add_client_identity`);
//   drop         a handshake dropped gives its area back cleared; the slots dropped, the areas all free and clear;
//   clientcert   (instead of the above) a server that requires client certificates: see `drive_clientcert`.
//
// With `hold`, `scripts/tls_memory.py engine` measures the two engines with nothing else in the process: it prints
// `ready start` before the handshakes and `ready established` after them, waiting 4 seconds each time, then sends 16,384 bytes through each connection in turn, prints `ready echoed` and waits 4 seconds;
// then it goes on as above.
import std.buffer;
import std.crypto;
import std.io;
import tls;
import x509;

fn number[&s](s: &s [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(s) {
        n = n * 10 + int_of(s[i]) - 48;
        i = i + 1;
    }
    return n;
}

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

// The pattern slot `k` sends, byte `at` of everything it has sent.
fn pattern(k: int, at: int) -> [] int {
    return at * 7 + k * 13 + at / 251 & 255;
}

// Whether one of the arguments after the fourth is `word`.
fn has_word[&g, &w](g: &g Args, word: &w [byte]) -> [args] bool {
    var k = 5;
    while k < arg_count(g) {
        let a = arg(g, k);
        if len(a) == len(word) {
            var same = true;
            var j = 0;
            while j < len(a) {
                if a[j] != word[j] {
                    same = false;
                }
                j = j + 1;
            }
            if same {
                return true;
            }
        }
        k = k + 1;
    }
    return false;
}

fn next(x: int) -> [] int {
    return (x * 1103515245 + 12345) % 2147483648;
}

fn say[&i, &w](io: &!i Io, ok: bool, what: &w [byte]) -> [io_write] int {
    if ok {
        io.write_all(io, "ok ");
    } else {
        io.write_all(io, "FAIL ");
    }
    io.write_all(io, what);
    io.newline(io);
    if ok {
        return 0;
    }
    return 1;
}

fn say_n[&i, &w](io: &!i Io, ok: bool, what: &w [byte], n: int) -> [io_write] int {
    if ok {
        io.write_all(io, "ok ");
    } else {
        io.write_all(io, "FAIL ");
    }
    io.write_all(io, what);
    io.space(io);
    io.print_int(io, n);
    io.newline(io);
    if ok {
        return 0;
    }
    return 1;
}

// What the server did with the bytes of slot `k`'s connection: everything it received it sends back. What the
// client gets back it compares with the pattern, counting the bytes in `st[k * 4 + 1]` and the mismatches in
// `st[k * 4 + 2]`.
fn client_recv[&c, &s, &a](cli: &!c tls.Engine, st: &!s [int], app: &!a [byte], k: int) -> [] int {
    var moved = 0;
    var n = tls.recv(cli, k, app);
    while n > 0 {
        var j = 0;
        while j < n {
            if int_of(app[j]) != pattern(k, st[k * 4 + 1] + j) {
                st[k * 4 + 2] = st[k * 4 + 2] + 1;
            }
            j = j + 1;
        }
        st[k * 4 + 1] = st[k * 4 + 1] + n;
        moved = moved + n;
        n = tls.recv(cli, k, app);
    }
    return moved;
}

// Everything the server received on `k` goes back.
fn server_echo[&e, &a](srv: &!e tls.Engine, app: &!a [byte], k: int) -> [] int {
    var moved = 0;
    var n = tls.recv(srv, k, app);
    while n > 0 {
        var sent = 0;
        while sent < n {
            let c = tls.send(srv, k, app[sent..n]);
            if c <= 0 {
                return moved;
            }
            sent = sent + c;
        }
        moved = moved + n;
        n = tls.recv(srv, k, app);
    }
    return moved;
}

// One direction of the wire for slot `k` until nothing more moves: `from` has bytes for the socket, `to` is fed
// them in pieces of `chunk` bytes. Answers the bytes moved.
fn carry[&f, &t, &w, &s, &a](from: &!f tls.Engine, to: &!t tls.Engine, wire: &!w [byte], st: &!s [int], app: &!a [byte], k: int, chunk: int, toward_server: bool) -> [] int {
    var total = 0;
    var n = tls.take(from, k, wire);
    while n > 0 {
        var used = 0;
        while used < n {
            var end = used + chunk;
            if end > n {
                end = n;
            }
            let c = tls.feed(to, k, wire[used..end]);
            if c < 0 {
                return total;
            }
            used = used + c;
            if toward_server {
                server_echo(to, app, k);
            } else {
                client_recv(to, st, app, k);
            }
            if c == 0 {
                // Nothing taken: the engine wants its output taken first.
                used = n;
            }
        }
        total = total + n;
        n = tls.take(from, k, wire);
    }
    return total;
}

// Both directions, until neither moves.
fn settle[&c, &s, &w, &t, &a](cli: &!c tls.Engine, srv: &!s tls.Engine, wire: &!w [byte], st: &!t [int], app: &!a [byte], k: int, chunk: int) -> [] int {
    var total = 0;
    var moved = 1;
    while moved > 0 {
        moved = carry(cli, srv, wire, st, app, k, chunk, true) + carry(srv, cli, wire, st, app, k, chunk, false);
        total = total + moved;
    }
    return total;
}

fn tag_is[&e](engine: &e tls.Engine, k: int, tag: &static [byte]) -> [] bool {
    let have = tls.refusal_tag(tls.failure(engine, k));
    if len(have) != len(tag) {
        return false;
    }
    var j = 0;
    while j < len(tag) {
        if have[j] != tag[j] {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// Says `what`, flushed, and keeps the process busy for four seconds: a harness reads its memory meanwhile.
fn wait[&i, &k, &w](io: &!i Io, clock: &k Clock, what: &w [byte]) -> [io_write, clock] int {
    io.write_all(io, what);
    io.newline(io);
    flush_out(io);
    let until = clock_ms(clock) + 4000;
    while clock_ms(clock) < until {
    }
    return 0;
}

fn drive[&i, &c, &s, &w, &a, &m, &t, &k](io: &!i Io, clock: &k Clock, cli: &!c tls.Engine, srv: &!s tls.Engine, wire: &!w [byte], app: &!a [byte], msg: &!m [byte], st: &!t [int], slots: int, areas: int, steps: int, seed: int, hold: bool, tickets: bool) -> [io_write, clock] int {
    var failed = 0;
    let now = 1800000000000;
    region r {
        let host = "echo.lex-sys.test";
        // The handshakes, one slot after another, each finished before the next is started: while a handshake
        // is in progress it holds an area, so with fewer areas than slots the pool is the bound.
        var refused = 0;
        var started = 0;
        var k = 0;
        var good = true;
        if hold {
            wait(io, clock, "ready start");
        }
        while k < slots {
            if tls.areas_free(srv) == 0 || tls.areas_free(cli) == 0 {
                good = false;
            }
            let a = tls.serve(srv, k, now);
            let b = tls.start(cli, k, host, now);
            if a != 0 || b != 0 {
                good = false;
            }
            settle(cli, srv, wire, st, app, k, 1 + (seed + k) % 1500);
            if tls.event(cli, k) != tls.event_established() || tls.event(srv, k) != tls.event_established() {
                good = false;
            }
            // Established and idle: no area held, on either engine.
            if tls.areas_free(srv) != areas || tls.areas_free(cli) != areas {
                good = false;
            }
            k = k + 1;
        }
        failed = failed + say_n(io, good && tls.residue(srv) == 0 && tls.residue(cli) == 0, "handshakes, every slot established and holding no area, and the areas cleared, slots", slots);
        if hold {
            wait(io, clock, "ready established");
            var q = 0;
            while q < slots {
                var j = 0;
                while j < 16384 {
                    msg[j] = byte_of(pattern(q, st[q * 4] + j));
                    j = j + 1;
                }
                tls.send(cli, q, msg[0..16384]);
                st[q * 4] = st[q * 4] + 16384;
                settle(cli, srv, wire, st, app, q, 16384);
                q = q + 1;
            }
            wait(io, clock, "ready echoed");
        }
        // A start with none free is refused and starts nothing.
        if areas < slots {
            // Fill every area with a handshake begun and not carried on.
            var j = 0;
            var all = true;
            while j < areas {
                tls.drop(srv, j);
                tls.drop(cli, j);
                if tls.serve(srv, j, now) != 0 || tls.start(cli, j, host, now) != 0 {
                    all = false;
                }
                j = j + 1;
            }
            if tls.areas_free(srv) != 0 || tls.areas_free(cli) != 0 {
                all = false;
            }
            failed = failed + say(io, all, "areas full of handshakes in progress");
            let other = areas;
            tls.drop(srv, other);
            tls.drop(cli, other);
            let code = tls.serve(srv, other, now);
            let again = tls.start(cli, other, host, now);
            failed = failed + say_n(io, code == 0 - 72 && again == 0 - 72, "serve and start with no area free are tls-pool, code", code);
            failed = failed + say(io, tls.event(srv, other) == tls.event_failed(), "a refused slot is not started");
            // Carry the handshakes on: the areas come back.
            j = 0;
            while j < areas {
                settle(cli, srv, wire, st, app, j, 700);
                j = j + 1;
            }
            failed = failed + say(io, tls.areas_free(srv) == areas && tls.areas_free(cli) == areas, "the areas come back when the handshakes finish");
            j = areas;
            while j < slots {
                tls.drop(srv, j);
                tls.drop(cli, j);
                tls.serve(srv, j, now);
                tls.start(cli, j, host, now);
                settle(cli, srv, wire, st, app, j, 900);
                j = j + 1;
            }
            failed = failed + say(io, tls.areas_free(srv) == areas && tls.areas_free(cli) == areas, "every slot established again");
        }
        // Traffic: a message of random size in random pieces, echoed, on a random slot.
        var x = seed;
        var step = 0;
        var wrong = 0;
        var leaked = 0;
        var residue = 0;
        var sent_total = 0;
        while step < steps {
            x = next(x);
            let slot = x / 7 % slots;
            x = next(x);
            var size = 1 + x / 11 % 40000;
            if step % 5 == 0 {
                size = 1 + x / 11 % 20;
            }
            x = next(x);
            let chunk = 1 + x / 13 % 3000;
            var j = 0;
            while j < size {
                msg[j] = byte_of(pattern(slot, st[slot * 4] + j));
                j = j + 1;
            }
            var sent = 0;
            while sent < size {
                let c = tls.send(cli, slot, msg[sent..size]);
                if c > 0 {
                    sent = sent + c;
                }
                settle(cli, srv, wire, st, app, slot, chunk);
                if c <= 0 && settle(cli, srv, wire, st, app, slot, chunk) == 0 {
                    sent = size + 1;
                }
            }
            st[slot * 4] = st[slot * 4] + size;
            settle(cli, srv, wire, st, app, slot, chunk);
            if st[slot * 4 + 1] != st[slot * 4] || st[slot * 4 + 2] != 0 {
                wrong = wrong + 1;
            }
            if tls.areas_free(srv) != areas || tls.areas_free(cli) != areas {
                leaked = leaked + 1;
            }
            residue = residue + tls.residue(srv) + tls.residue(cli);
            sent_total = sent_total + size;
            step = step + 1;
        }
        failed = failed + say_n(io, wrong == 0, "steps echoed byte for byte, wrong", wrong);
        failed = failed + say_n(io, leaked == 0, "steps that left an area leased, leaked", leaked);
        failed = failed + say_n(io, residue == 0, "after every step no free area or free core holds a byte, residue", residue);
        failed = failed + say_n(io, tls.event(srv, 0) == tls.event_established() && tls.event(cli, 0) == tls.event_established(), "still established, bytes echoed", sent_total);
        // A connection with data waiting keeps its area while another is served: its record fed and not received,
        // then its echo made and not taken, with a second connection's whole exchange between each.
        if areas >= 2 && slots >= 2 {
            let a = 0;
            let b = 1;
            let m = 5000;
            var j = 0;
            while j < m {
                msg[j] = byte_of(pattern(a, st[a * 4] + j));
                j = j + 1;
            }
            tls.send(cli, a, msg[0..m]);
            let n = tls.take(cli, a, wire);
            let c = tls.feed(srv, a, wire[0..n]);
            // The second connection, start to end, while the first's data waits for `recv`.
            var side = true;
            var q = 0;
            while q < 2 {
                var x = 0;
                while x < 3000 {
                    app[x] = byte_of(pattern(b, st[b * 4] + x));
                    x = x + 1;
                }
                // `app` is the client's scratch for `client_recv`; the message goes through `msg` beyond `m`.
                var y = 0;
                while y < 3000 {
                    msg[m + y] = app[y];
                    y = y + 1;
                }
                tls.send(cli, b, msg[m..m + 3000]);
                st[b * 4] = st[b * 4] + 3000;
                settle(cli, srv, wire, st, app, b, 700);
                if st[b * 4 + 1] != st[b * 4] || st[b * 4 + 2] != 0 {
                    side = false;
                }
                if q == 0 {
                    // The first connection's data, received and echoed and left for the socket.
                    server_echo(srv, app, a);
                }
                q = q + 1;
            }
            st[a * 4] = st[a * 4] + m;
            settle(cli, srv, wire, st, app, a, 900);
            failed = failed + say_n(io, c == n && side && st[a * 4 + 1] == st[a * 4] && st[a * 4 + 2] == 0 && tls.areas_free(srv) == areas, "a connection with data waiting keeps its area while another is served, fed", c);
        }
        // A record half fed holds the one area; a second connection that needs one fails.
        if areas < slots && slots >= 3 && areas == 1 {
            let a = 0;
            let b = 1;
            let p = 2;
            // Slot a: a record from the client, only its first 40 bytes fed to the server.
            let m = 3000;
            var j = 0;
            while j < m {
                msg[j] = byte_of(pattern(a, st[a * 4] + j));
                j = j + 1;
            }
            tls.send(cli, a, msg[0..m]);
            let n = tls.take(cli, a, wire);
            let c = tls.feed(srv, a, wire[0..40]);
            failed = failed + say_n(io, c == 40 && tls.areas_free(srv) == 0, "a record half fed holds the area, fed", c);
            // Slot b: the client sends a record, and the server, with no area for it, takes none of it: back-pressure,
            // not a failure. `recv` on it needs no area.
            j = 0;
            while j < 100 {
                msg[m + j] = byte_of(pattern(b, st[b * 4] + j));
                j = j + 1;
            }
            tls.send(cli, b, msg[m..m + 100]);
            st[b * 4] = st[b * 4] + 100;
            let nb = tls.take(cli, b, msg[30000..40000]);
            let cb = tls.feed(srv, b, msg[30000..30000 + nb]);
            let rb = tls.recv(srv, b, msg[20000..20100]);
            failed = failed + say_n(io, cb == 0 && rb == tls.would_block() && tls.event(srv, b) == tls.event_established(), "a connection fed with no area free takes nothing and stays established, fed", cb);
            // Slot a goes on: the rest of its record.
            let d = tls.feed(srv, a, wire[40..n]);
            server_echo(srv, app, a);
            st[a * 4] = st[a * 4] + m;
            settle(cli, srv, wire, st, app, a, 500);
            failed = failed + say_n(io, d == n - 40 && tls.areas_free(srv) == areas && tls.event(srv, a) == tls.event_established(), "the first completes and the area comes back, fed", d);
            failed = failed + say(io, st[a * 4 + 1] == st[a * 4] && st[a * 4 + 2] == 0, "and its echo is right");
            // Slot b's record, offered again, is taken now and echoed.
            let cb2 = tls.feed(srv, b, msg[30000..30000 + nb]);
            server_echo(srv, msg[20000..30000], b);
            settle(cli, srv, wire, st, app, b, 64);
            failed = failed + say_n(io, cb2 == nb && st[b * 4 + 1] == st[b * 4] && st[b * 4 + 2] == 0 && tls.areas_free(srv) == areas, "the same bytes offered again once an area is free are taken and echoed, fed", cb2);
            // With the area held again, the third connection's socket ends: it fails tls-peer-closed with no area, keys cleared.
            tls.send(cli, a, msg[0..m]);
            let n2 = tls.take(cli, a, wire);
            tls.feed(srv, a, wire[0..40]);
            let e = tls.eof(srv, p);
            failed = failed + say_n(io, tls.areas_free(srv) == 0 && tls.event(srv, p) == tls.event_failed() && tag_is(srv, p, "tls-peer-closed") && tls.residue(srv) == 0, "the socket's end with no area free fails tls-peer-closed with its keys cleared, code", e);
            tls.feed(srv, a, wire[40..n2]);
            server_echo(srv, app, a);
            st[a * 4] = st[a * 4] + m;
            settle(cli, srv, wire, st, app, a, 500);
            failed = failed + say(io, st[a * 4 + 1] == st[a * 4] && tls.areas_free(srv) == areas, "and the first is served");
        }
        // A connection that fails while it holds an area (its alert not yet taken): what is read of it is the area's.
        if slots >= 2 {
            let f = slots - 2;
            tls.send(cli, f, msg[0..300]);
            let nf = tls.take(cli, f, wire);
            wire[nf - 3] = byte_of(int_of(wire[nf - 3]) ^ 1);
            let code = tls.feed(srv, f, wire[0..nf]);
            let held_fail = code < 0 && tls.holds_area(srv, f) && tls.failure(srv, f) == code && tls.event(srv, f) == tls.event_want_write();
            let alert = tls.take(srv, f, app);
            failed = failed + say_n(io, held_fail && alert > 0 && !tls.holds_area(srv, f) && tls.failure(srv, f) == code && tls.event(srv, f) == tls.event_failed() && tls.residue(srv) == 0, "a connection that fails holding an area reads as failed before and after its alert is taken, code", code);
        }
        // A connection dropped while it holds an area gives the area back.
        let lone = slots - 1;
        tls.drop(srv, lone);
        tls.drop(cli, lone);
        tls.serve(srv, lone, now);
        tls.start(cli, lone, host, now);
        let held = areas - tls.areas_free(srv) == 1 && areas - tls.areas_free(cli) == 1 && tls.handshakes_in_progress(srv) == 1 && tls.event(srv, lone) == tls.event_want_read();
        tls.drop(srv, lone);
        tls.drop(cli, lone);
        failed = failed + say(io, held && tls.areas_free(srv) == areas && tls.areas_free(cli) == areas && tls.residue(srv) == 0 && tls.residue(cli) == 0, "a handshake in progress holds an area, and dropping it gives the area back cleared");
        // With `tickets`: every slot handshakes in full, the server sends its tickets, the client saves one (while
        // its connection may still hold an area), and the next connection in the slot resumes with it.
        if tickets {
            var saved = 0;
            var resumed = 0;
            var left = 0;
            k = 0;
            while k < slots {
                tls.drop(srv, k);
                tls.drop(cli, k);
                tls.serve(srv, k, now);
                tls.start(cli, k, host, now);
                settle(cli, srv, wire, st, app, k, 1000);
                let pool = tls.save_to(cli, k, 0);
                if pool > 0 {
                    saved = saved + 1;
                }
                left = left + tls.residue(srv) + tls.residue(cli);
                tls.drop(srv, k);
                tls.drop(cli, k);
                tls.serve(srv, k, now);
                tls.start_with(cli, k, host, now, pool);
                settle(cli, srv, wire, st, app, k, 1000);
                if tls.resumed(cli, k) && tls.event(cli, k) == tls.event_established() {
                    resumed = resumed + 1;
                }
                left = left + tls.residue(srv) + tls.residue(cli);
                k = k + 1;
            }
            failed = failed + say_n(io, saved == slots && resumed == slots && left == 0 && tls.areas_free(srv) == areas && tls.areas_free(cli) == areas, "tickets: every slot saved one and resumed with it, the areas cleared, resumed", resumed);
        }
        // Every slot dropped: the areas are all free and every slot is free to start again.
        k = 0;
        while k < slots {
            tls.drop(srv, k);
            tls.drop(cli, k);
            k = k + 1;
        }
        failed = failed + say(io, tls.areas_free(srv) == areas && tls.areas_free(cli) == areas, "all slots dropped, all areas free");
        failed = failed + say_n(io, tls.residue(srv) == 0 && tls.residue(cli) == 0, "after the drops no area or core holds a byte, residue", tls.residue(srv) + tls.residue(cli));
        failed = failed + say(io, tls.serve(srv, 0, now) == 0, "a slot can be served again");
        tls.drop(srv, 0);
    }
    return failed;
}

fn same[&a, &b](x: &a [byte], y: &b [byte]) -> [] bool {
    if len(x) != len(y) {
        return false;
    }
    var j = 0;
    while j < len(x) {
        if x[j] != y[j] {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// Whether every `peer_` call on `k` answers the client's leaf `want` (its DER) as verified: the certificate byte for
// byte, its SHA-256, a subject and a serial, a notAfter, `sans` subjectAltNames each inside the DER, and the
// generation of the store now.
fn identity_is[&e, &w](srv: &e tls.Engine, k: int, want: &w [byte], sans: int) -> [] bool {
    var ok = tls.peer_verified(srv, k) == tls.client_generation(srv) && tls.peer_not_after(srv, k) > 0;
    region q {
        let got = alloc_slice[q](16384, byte_of(0));
        let n = tls.peer_certificate(srv, k, got);
        ok = ok && n == len(want) && same(got[0..len(want)], want);
        let fp = alloc_slice[q](32, byte_of(0));
        crypto.sha256(want, fp);
        ok = ok && tls.peer_fingerprint(srv, k, got[0..32]) == 32 && same(got[0..32], fp);
        ok = ok && tls.peer_subject(srv, k, got) > 0 && tls.peer_serial(srv, k, got) > 0;
        let entry = alloc_slice[q](3, 0);
        var count = 0;
        var at = tls.peer_san(srv, k, 0, entry);
        while at > 0 && count <= sans {
            ok = ok && entry[1] <= entry[2] && entry[2] <= len(want);
            count = count + 1;
            at = tls.peer_san(srv, k, at, entry);
        }
        ok = ok && count == sans;
    }
    return ok;
}

// Whether no `peer_` call on `k` answers an identity.
fn no_identity[&e](srv: &e tls.Engine, k: int) -> [] bool {
    var none = tls.peer_verified(srv, k) == 0 && tls.peer_not_after(srv, k) == 0;
    region q {
        let leaf = alloc_slice[q](16384, byte_of(0));
        let entry = alloc_slice[q](3, 0);
        none = none && tls.peer_certificate(srv, k, leaf) == 0 && tls.peer_fingerprint(srv, k, leaf) == 0 && tls.peer_subject(srv, k, leaf) == 0 && tls.peer_serial(srv, k, leaf) == 0 && tls.peer_san(srv, k, 0, entry) == 0;
    }
    return none;
}

// A new connection in slot `k` of both engines, carried to its end.
fn connect_pair[&c, &s, &w, &t, &a](cli: &!c tls.Engine, srv: &!s tls.Engine, wire: &!w [byte], st: &!t [int], app: &!a [byte], k: int, chunk: int) -> [] int {
    st[k * 4] = 0;
    st[k * 4 + 1] = 0;
    st[k * 4 + 2] = 0;
    tls.serve(srv, k, 1800000000000);
    tls.start(cli, k, "echo.lex-sys.test", 1800000000000);
    return settle(cli, srv, wire, st, app, k, chunk);
}

// With `clientcert` (`docs/tls-server.md` §13, `docs/tls-memory.md` §11): the server requires a client certificate and
// the client engine presents one. A connection whose client was verified gives its area back once its handshake is
// done, the leaf kept in the engine's room for its slot, and every `peer_` call answers what was verified from it,
// while the connection is idle and while it holds an area again for a record; a failure, a drop and the slot's next
// connection leave nothing of it. A leaf larger than the room (`pool_big_chain.pem`) keeps its area, as every verified
// leaf did before; with fewer areas than slots such connections can hold every area, and a serve is then `tls-pool`.
// Then the clients' store is replaced between the client's CertificateVerify and its Finished: the handshake fails
// `tls-server-client-store-replaced` and nothing of it is kept. `tls.residue` is 0 after every step.
fn drive_clientcert[&i, &c, &s, &w, &a, &m, &t, &p, &u](io: &!i Io, cli: &!c tls.Engine, srv: &!s tls.Engine, wire: &!w [byte], app: &!a [byte], msg: &!m [byte], st: &!t [int], slots: int, areas: int, steps: int, seed: int, pems: &p [byte], cuts: &u [int]) -> [io_write] int {
    var failed = 0;
    let now = 1800000000000;
    let store = pems[cuts[2] + 1..cuts[3]];
    let key = pems[cuts[4] + 1..cuts[5]];
    region r {
        // The leaves the client presents, as DER: `pool_chain.pem`'s, `pool_chain2.pem`'s (longer), `pool_big_chain.pem`'s.
        let small = alloc_slice[r](16384, byte_of(0));
        let other = alloc_slice[r](16384, byte_of(0));
        let big = alloc_slice[r](16384, byte_of(0));
        let info = alloc_slice[r](2, 0);
        x509.pem_next(pems[cuts[3] + 1..cuts[4]], 0, small, info);
        let ns = info[0];
        x509.pem_next(pems[cuts[5] + 1..cuts[6]], 0, other, info);
        let no = info[0];
        x509.pem_next(pems[cuts[6] + 1..len(pems)], 0, big, info);
        let nb = info[0];
        var verified = 0;
        var released = 0;
        var clean = true;
        var k = 0;
        while k < slots {
            connect_pair(cli, srv, wire, st, app, k, 1 + (seed + k) % 1500);
            if tls.event(srv, k) == tls.event_established() && tls.client_auth(cli, k) == 1 && identity_is(srv, k, small[0..ns], 1) {
                verified = verified + 1;
            }
            if !tls.holds_area(srv, k) {
                released = released + 1;
            }
            if tls.residue(srv) != 0 || tls.residue(cli) != 0 {
                clean = false;
            }
            k = k + 1;
        }
        failed = failed + say_n(io, verified == slots && released == slots && clean && tls.areas_free(srv) == areas, "clientcert: every client verified, its connection gives its area back and keeps its identity, residue 0 after every step, slots", slots);
        // Traffic: a message on a slot the LCG picks; its first record fed half to the server, which then holds an area
        // again (the identity is read from the room, the area's copy of the core saying it is there), then the rest.
        var x = seed;
        var step = 0;
        var held = 0;
        var good = true;
        while step < steps {
            x = next(x);
            let slot = x / 7 % slots;
            x = next(x);
            let size = 1 + x / 7 % 20000;
            var j = 0;
            while j < size {
                msg[j] = byte_of(pattern(slot, st[slot * 4] + j));
                j = j + 1;
            }
            st[slot * 4] = st[slot * 4] + tls.send(cli, slot, msg[0..size]);
            let out = tls.take(cli, slot, wire);
            let cut = 5 + (int_of(wire[3]) * 256 + int_of(wire[4])) / 2;
            var used = tls.feed(srv, slot, wire[0..cut]);
            if tls.holds_area(srv, slot) && identity_is(srv, slot, small[0..ns], 1) && tls.residue(srv) == 0 {
                held = held + 1;
            }
            while used < out {
                let c = tls.feed(srv, slot, wire[used..out]);
                if c <= 0 {
                    used = out;
                    good = false;
                }
                used = used + c;
                server_echo(srv, app, slot);
            }
            settle(cli, srv, wire, st, app, slot, 1 + x % 3000);
            if st[slot * 4 + 1] != st[slot * 4] || st[slot * 4 + 2] != 0 || tls.holds_area(srv, slot) || !identity_is(srv, slot, small[0..ns], 1) || tls.residue(srv) != 0 || tls.residue(cli) != 0 {
                good = false;
            }
            step = step + 1;
        }
        failed = failed + say_n(io, good && held == steps, "clientcert: traffic on verified connections, an area taken and given back each time, the identity the same while it is held and after, residue 0, steps", steps);
        // A verified connection that fails: before its alert is taken it still holds its area, and gives no identity.
        let f = slots - 1;
        region q {
            let bad = alloc_slice[q](300, byte_of(7));
            tls.send(cli, f, bad);
        }
        let nf = tls.take(cli, f, wire);
        wire[nf - 3] = byte_of(int_of(wire[nf - 3]) ^ 1);
        let fcode = tls.feed(srv, f, wire[0..nf]);
        let before = fcode < 0 && tls.holds_area(srv, f) && no_identity(srv, f);
        let falert = tls.take(srv, f, app);
        failed = failed + say(io, before && falert > 0 && !tls.holds_area(srv, f) && no_identity(srv, f) && tls.residue(srv) == 0, "clientcert: a verified connection that fails gives no identity, before and after its alert is taken, and its area and its leaf back cleared");
        k = 0;
        while k < slots {
            tls.drop(srv, k);
            tls.drop(cli, k);
            k = k + 1;
        }
        failed = failed + say_n(io, tls.areas_free(srv) == areas && tls.residue(srv) == 0 && tls.residue(cli) == 0, "clientcert: dropped, every area back and every leaf cleared, residue", tls.residue(srv));
        // A slot's next connection: a longer leaf (two SANs), then a shorter one, in slot 0.
        tls.replace_client_identity(cli, 0, pems[cuts[5] + 1..cuts[6]], key, now);
        connect_pair(cli, srv, wire, st, app, 0, 700);
        var reuse = identity_is(srv, 0, other[0..no], 2) && !tls.holds_area(srv, 0) && tls.residue(srv) == 0;
        // Dropped while it holds an area again, half a record fed.
        tls.send(cli, 0, msg[0..1000]);
        tls.take(cli, 0, wire);
        tls.feed(srv, 0, wire[0..500]);
        reuse = reuse && tls.holds_area(srv, 0) && identity_is(srv, 0, other[0..no], 2);
        tls.drop(srv, 0);
        tls.drop(cli, 0);
        reuse = reuse && tls.residue(srv) == 0 && no_identity(srv, 0);
        tls.replace_client_identity(cli, 0, pems[cuts[3] + 1..cuts[4]], key, now);
        connect_pair(cli, srv, wire, st, app, 0, 900);
        reuse = reuse && identity_is(srv, 0, small[0..ns], 1) && tls.residue(srv) == 0;
        failed = failed + say(io, reuse, "clientcert: a slot's next connection has its own leaf and nothing of the last one, which was longer and dropped holding an area, residue 0");
        // Leaves larger than the room keep their areas. With one slot, in slot 0 itself.
        tls.replace_client_identity(cli, 0, pems[cuts[6] + 1..len(pems)], key, now);
        var first = 1;
        if slots == 1 {
            tls.drop(srv, 0);
            tls.drop(cli, 0);
            first = 0;
        }
        var bigs = 0;
        var j = first;
        while j < slots && tls.areas_free(srv) > 0 {
            connect_pair(cli, srv, wire, st, app, j, 1 + (seed + j) % 1500);
            if identity_is(srv, j, big[0..nb], 80) && tls.holds_area(srv, j) && tls.residue(srv) == 0 && tls.residue(cli) == 0 {
                bigs = bigs + 1;
            }
            j = j + 1;
        }
        failed = failed + say_n(io, bigs == j - first && bigs > 0, "clientcert: a leaf larger than the room keeps its area and is read from it, connections", bigs);
        if j < slots {
            failed = failed + say(io, tls.serve(srv, j, now) == 0 - 72 && !tls.holds_area(srv, j), "clientcert: with every area held by a connection with a large leaf a serve is tls-pool");
        }
        if slots > 1 {
            // The socket of slot 0's connection, a verified one with its leaf in the room, ends: with no area free when
            // the large leaves hold them all (the core alone fails), else with one.
            let parked = tls.areas_free(srv) == 0;
            tls.eof(srv, 0);
            var none_free = 0;
            if parked {
                none_free = 1;
            }
            failed = failed + say_n(io, tag_is(srv, 0, "tls-peer-closed") && no_identity(srv, 0) && !tls.holds_area(srv, 0) && tls.residue(srv) == 0, "clientcert: a verified connection whose socket ends gives its leaf up, residue 0, with no area free", none_free);
        }
        k = 0;
        while k < slots {
            tls.drop(srv, k);
            tls.drop(cli, k);
            k = k + 1;
        }
        failed = failed + say(io, tls.areas_free(srv) == areas && tls.residue(srv) == 0 && tls.residue(cli) == 0, "clientcert: the large leaves' areas come back cleared when dropped, residue 0");
        tls.replace_client_identity(cli, 0, pems[cuts[3] + 1..cuts[4]], key, now);
    }
    // The store replaced while the client holds its Finished: the client's flight is fed one record at a time, and
    // the store is replaced before the last (its Finished).
    tls.serve(srv, 0, now);
    tls.start(cli, 0, "echo.lex-sys.test", now);
    carry(cli, srv, wire, st, app, 0, 65536, true);
    carry(srv, cli, wire, st, app, 0, 65536, false);
    let n = tls.take(cli, 0, wire);
    var at = 0;
    var records = 0;
    var code = 0;
    while at + 5 <= n && code >= 0 {
        let end = at + 5 + int_of(wire[at + 3]) * 256 + int_of(wire[at + 4]);
        if end >= n {
            tls.trust_clients(srv, store);
        }
        code = tls.feed(srv, 0, wire[at..end]);
        records = records + 1;
        at = end;
    }
    let alert = tls.take(srv, 0, app);
    failed = failed + say_n(io, tag_is(srv, 0, "tls-server-client-store-replaced") && alert > 0 && no_identity(srv, 0) && !tls.holds_area(srv, 0) && tls.residue(srv) == 0, "clientcert: the store replaced before the client's Finished fails the handshake, its area cleared, records fed", records);
    tls.drop(srv, 0);
    tls.drop(cli, 0);
    failed = failed + say(io, tls.areas_free(srv) == areas && tls.residue(srv) == 0 && tls.residue(cli) == 0, "clientcert: after the drops no area or core holds a byte, residue 0");
    return failed;
}

// Where the `k`th NUL byte of `text` is (`len(text)` when there are fewer).
fn nul[&t](text: &t [byte], k: int) -> [] int {
    var seen = 0;
    var j = 0;
    while j < len(text) {
        if int_of(text[j]) == 0 {
            seen = seen + 1;
            if seen == k {
                return j;
            }
        }
        j = j + 1;
    }
    return len(text);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    var status = 2;
    borrow mut io as &!i in {
        borrow args as &g in {
            if arg_count(g) < 5 {
                io.error_all(i, "usage: tls_pool <slots> <areas> <steps> <seed> < ca NUL chain NUL key\n");
            } else {
                let slots = number(arg(g, 1));
                let areas = number(arg(g, 2));
                let steps = number(arg(g, 3));
                let seed = number(arg(g, 4));
                let hold = has_word(g, "hold");
                let tickets = has_word(g, "tickets");
                let clientcert = has_word(g, "clientcert");
                let mutual = has_word(g, "mutual") || clientcert;
                borrow mut heap as &!h in {
                    var all = buffer.empty(h, 65536);
                    all = read_stdin(h, i, all);
                    let wireb = box_slice(h, 65536, byte_of(0));
                    let appb = box_slice(h, 16640, byte_of(0));
                    let msgb = box_slice(h, 40000, byte_of(0));
                    let stb = box_slice(h, 4 * slots, 0);
                    var cli = tls.open_with_areas(h, slots, slots, areas);
                    if mutual {
                        tls.close(h, cli);
                        cli = tls.open_mutual_with_areas(h, slots, slots, areas);
                    }
                    var srv = tls.open_server_with_areas(h, slots, areas);
                    region r {
                        let entropy = alloc_slice[r](32, byte_of(0));
                        var k = 0;
                        while k < 32 {
                            entropy[k] = byte_of(k * 5 + 1);
                            k = k + 1;
                        }
                        borrow all as &ab in {
                            let text = buffer.bytes(ab);
                            // The three files, between NUL bytes.
                            var cut1 = 0;
                            while cut1 < len(text) && int_of(text[cut1]) != 0 {
                                cut1 = cut1 + 1;
                            }
                            var cut2 = cut1 + 1;
                            while cut2 < len(text) && int_of(text[cut2]) != 0 {
                                cut2 = cut2 + 1;
                            }
                            // With `clientcert`, three more: the clients' CA, the client's chain and its key.
                            var cut3 = cut2 + 1;
                            while cut3 < len(text) && int_of(text[cut3]) != 0 {
                                cut3 = cut3 + 1;
                            }
                            var cut4 = cut3 + 1;
                            while cut4 < len(text) && int_of(text[cut4]) != 0 {
                                cut4 = cut4 + 1;
                            }
                            var cut5 = cut4 + 1;
                            while cut5 < len(text) && int_of(text[cut5]) != 0 {
                                cut5 = cut5 + 1;
                            }
                            var key_end = len(text);
                            if clientcert {
                                key_end = cut3;
                            }
                            let cuts = alloc_slice[r](7, 0);
                            var c = 0;
                            while c < 7 {
                                cuts[c] = nul(text, c + 1);
                                c = c + 1;
                            }
                            if cut2 >= len(text) || clientcert && cuts[6] >= len(text) {
                                io.error_all(i, "tls_pool: expected three files\n");
                            } else {
                                borrow mut cli as &!cw in {
                                    borrow mut srv as &!sw in {
                                        tls.seed(cw, entropy);
                                        entropy[0] = byte_of(99);
                                        tls.seed(sw, entropy);
                                        let roots = tls.trust(cw, text[0..cut1]);
                                        let id = tls.add_identity(sw, text[cut1 + 1..cut2], text[cut2 + 1..key_end], "echo.lex-sys.test", 1800000000000);
                                        if tickets {
                                            tls.set_tickets(sw, 2, 3600);
                                            tls.set_resumption(cw, true);
                                        }
                                        if clientcert && (tls.trust_clients(sw, text[cut3 + 1..cut4]) < 1 || tls.client_auth_mode(sw, 2) != 0 || tls.add_client_identity(cw, text[cut4 + 1..cut5], text[cut5 + 1..cuts[5]], "*", 1800000000000) < 0) {
                                            io.error_all(i, "tls_pool: the client certificate setup was refused\n");
                                        }
                                        if mutual && !clientcert && tls.add_client_identity(cw, text[cut1 + 1..cut2], text[cut2 + 1..len(text)], "*", 1800000000000) < 0 {
                                            io.error_all(i, "tls_pool: the client identity was refused\n");
                                        }
                                        if roots < 1 || id < 0 {
                                            io.error_all(i, "tls_pool: the identity or the root was refused\n");
                                        } else {
                                            borrow mut wireb as &!ww in {
                                                borrow mut appb as &!aw in {
                                                    borrow mut msgb as &!mw in {
                                                        borrow mut stb as &!tw in {
                                                            borrow clock as &kk in {
                                                                if clientcert {
                                                                    status = drive_clientcert(i, cw, sw, contents(ww), contents(aw), contents(mw), contents(tw), slots, areas, steps, seed, text, cuts);
                                                                } else {
                                                                    status = drive(i, kk, cw, sw, contents(ww), contents(aw), contents(mw), contents(tw), slots, areas, steps, seed, hold, tickets);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    unbox_slice(h, wireb);
                    unbox_slice(h, appb);
                    unbox_slice(h, msgb);
                    unbox_slice(h, stb);
                    tls.close(h, cli);
                    tls.close(h, srv);
                    buffer.drop(h, all);
                }
            }
        }
    }
    release(fs);
    release(net);
    release(clock);
    release(args);
    release(io);
    release(heap);
    if status > 0 {
        return 1;
    }
    return 0;
}
