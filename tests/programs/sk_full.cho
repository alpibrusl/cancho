edition 9;

import std.conns;
import std.io as console;

// A listener whose accept queue is full (`tests/commands/sockets.sh`: `tcp_connect_start` answers at once against a peer that never answers).
//   argv[1]  the port
// It listens with a backlog of one and never accepts, then dials itself with `tcp_connect_start` until a connection does not complete within 150 ms (the kernel
// drops the SYN of a full queue), keeping every connection it made. It says `full` on standard error and then waits to be killed. Exit 3 when the port cannot be listened on.

fn number[&b](b: &b [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(b) && int_of(b[i]) >= '0' && int_of(b[i]) <= '9' {
        n = n * 10 + (int_of(b[i]) - '0');
        i = i + 1;
    }
    return n;
}

// Wait up to `ms` for slot `slot` of `table` to be writable (its handshake done): 1 when it was, 0 when not.
fn completes[&h, &t](heap: &!h Heap, table: &!t conns.Table, slot: int, ms: int) -> [poll] int {
    var answer = 0;
    match poller_new() {
        Polling::Ok(p) => {
            var poller = p;
            borrow mut poller as &!ph in {
                if conns.watch(table, ph, slot, 1, 2) == 0 {
                    region r {
                        let out = alloc_slice[r](8, 0);
                        if poller_wait(ph, out, ms) > 0 {
                            answer = 1;
                        }
                    }
                }
            }
            poller_close(poller);
        }
        Polling::Failed(e) => {
        }
    }
    return answer;
}

fn fill[&h, &n](heap: &!h Heap, net: &n Net(""), port: int) -> [heap, net_out(""), poll] conns.Table {
    var table = conns.empty(heap, 64);
    var going = true;
    var made = 0;
    while going && made < 20000 {
        match tcp_connect_start(net, "127.0.0.1", port) {
            Dialed::Ok(c) => {
                let (t2, slot) = conns.put(heap, table, c);
                table = t2;
                made = made + 1;
                var done = 0;
                borrow mut table as &!tw in {
                    done = completes(heap, tw, slot, 150);
                }
                if done == 0 {
                    going = false;
                }
            }
            Dialed::Failed(e) => {
                going = false;
            }
        }
    }
    return table;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(fs);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    var status = 3;
    borrow mut io as &!i in {
        borrow mut heap as &!h in {
            borrow args as &a in {
                borrow net as &nn in {
                    match tcp_listen(nn, number(arg(a, 1)), 1, 0) {
                        Listening::Ok(l) => {
                            var listener = l;
                            let table = fill(h, nn, number(arg(a, 1)));
                            console.error_all(i, "full\n");
                            // Held until the shell kills this process: a poller with nothing registered waits out its timeout.
                            match poller_new() {
                                Polling::Ok(p) => {
                                    var poller = p;
                                    region r {
                                        let out = alloc_slice[r](8, 0);
                                        borrow mut poller as &!ph in {
                                            var rounds = 0;
                                            while rounds < 3600 {
                                                poller_wait(ph, out, 1000);
                                                rounds = rounds + 1;
                                            }
                                        }
                                    }
                                    poller_close(poller);
                                    status = 0;
                                }
                                Polling::Failed(e) => {
                                }
                            }
                            conns.drop(h, table);
                            listener_close(listener);
                        }
                        Listening::Failed(e) => {
                        }
                    }
                }
            }
        }
    }
    release(net);
    release(args);
    release(heap);
    release(io);
    return status;
}
