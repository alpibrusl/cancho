edition 5;

// checked_output_authority.cho -- a program that only flushes: its authority report says `io_write` and nothing else (`docs/checked-output.md`).
// Not run; `tests/commands/checked_output.cho` asks `cancho authority` about it.

fn flush[&i](io: &!i Io) -> [io_write] int {
    match flush_out(io) {
        Done::Ok(n) => {
            return 0;
        }
        Done::Failed(e) => {
            return e;
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(net);
    release(clock);
    var code = 0;
    borrow mut io as &!i in {
        code = flush(i);
    }
    release(io);
    return code;
}
