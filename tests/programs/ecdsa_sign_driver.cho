// `docs/ecdsa-sign.md` §5: `std.ecdsa_sign` and `packages/x509`'s
// `x509_key`, driven from standard input, so the RFC 6979 vectors, the
// OpenSSL cross-checks and the key files all go through one program.
// Built with `packages/x509/x509.cho` and `packages/x509/key.cho`.
//
// One case per line, byte strings in lowercase hex (`-` for empty),
// each answered `<code> <tag> <hex>`:
//
//     S <digest> <key> <extra>            ecdsa_sign.sign: r || s
//     C <digest> <key> <point> <extra>    ecdsa_sign.sign_checked: r || s
//     W <digest> <key> <extra>            sign with `work` 10 words short
//     E <sig>                             ecdsa_sign.to_der into 72 bytes: the DER (code: its length)
//     F <sig> <size>                      to_der into `size` (decimal) bytes
//     M <msg> <key> <extra>               sign_checked of SHA-256(msg), the key's point derived: the DER
//     K <pem>                             x509_key.parse_pem: key || point
//     B <format> <der>                    x509_key.parse_der, format 8 or 1: key || point
//     G <pem> <msg> <extra>               parse_pem, then as M: the DER
//     X <cert der> <point>                x509_key.matches_certificate
//
// The tag is `x509_key`'s for codes -80 and below, `std.ecdsa_sign`'s
// otherwise.
import std.buffer;
import std.crypto;
import std.ecdsa_sign;
import std.io;
import x509_key;

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

fn nibble(c: int) -> [] int {
    if c >= 97 {
        return c - 87;
    }
    return c - 48;
}

fn field_end[&s](s: &s [byte], at: int) -> [] int {
    var e = at;
    while e < len(s) && int_of(s[e]) != 32 && int_of(s[e]) != 10 {
        e = e + 1;
    }
    return e;
}

fn next_field[&s](s: &s [byte], at: int) -> [] int {
    return field_end(s, at) + 1;
}

fn hex_len[&s](s: &s [byte], at: int) -> [] int {
    if at >= len(s) {
        return 0;
    }
    if field_end(s, at) - at == 1 && int_of(s[at]) == 45 {
        return 0;
    }
    return (field_end(s, at) - at) / 2;
}

fn hex_into[&s, &o](s: &s [byte], at: int, o: &!o [byte]) -> [] int {
    let n = hex_len(s, at);
    var i = 0;
    while i < len(o) && i < n {
        o[i] = byte_of(nibble(int_of(s[at + i * 2])) * 16 + nibble(int_of(s[at + i * 2 + 1])));
        i = i + 1;
    }
    return n;
}

fn number[&s](s: &s [byte], at: int) -> [] int {
    let e = field_end(s, at);
    var n = 0;
    var p = at;
    while p < e {
        n = n * 10 + int_of(s[p]) - 48;
        p = p + 1;
    }
    return n;
}

fn print_hex[&i, &d](io: &!i Io, d: &d [byte]) -> [io_write] int {
    let digits = "0123456789abcdef";
    var n = 0;
    while n < len(d) {
        let b = int_of(d[n]);
        io.write_all(io, digits[b >> 4..(b >> 4) + 1]);
        io.write_all(io, digits[b & 15..(b & 15) + 1]);
        n = n + 1;
    }
    if len(d) == 0 {
        io.write_all(io, "-");
    }
    return 0;
}

fn tag(code: int) -> [] &static [byte] {
    if code <= -80 {
        return x509_key.refusal_tag(code);
    }
    if code > 0 {
        return "ok";
    }
    return ecdsa_sign.refusal_tag(code);
}

fn report[&i, &d](io: &!i Io, code: int, d: &d [byte]) -> [io_write] int {
    io.print_int(io, code);
    io.space(io);
    io.write_all(io, tag(code));
    io.space(io);
    if code < 0 {
        print_hex(io, d[0..0]);
    } else {
        print_hex(io, d);
    }
    io.newline(io);
    return 0;
}

// SHA-256 of `msg`, signed and checked under `key` with its point
// derived, as DER into `der`: its length, or a refusal.
fn sign_message[&m, &k, &e, &o, &w](msg: &m [byte], key: &k [byte], extra: &e [byte], der: &!o [byte], work: &!w [int]) -> [] int {
    var code = 0;
    region r {
        let digest = alloc_slice[r](32, byte_of(0));
        let point = alloc_slice[r](65, byte_of(0));
        let sig = alloc_slice[r](64, byte_of(0));
        crypto.sha256(msg, digest);
        code = x509_key.public_point(key, point, work);
        if code == 0 {
            code = ecdsa_sign.sign_checked(digest, key, point, extra, sig, work);
        }
        if code == 0 {
            code = ecdsa_sign.to_der(sig, der);
        }
    }
    return code;
}

fn case[&i, &s, &w](io: &!i Io, s: &s [byte], at: int, work: &!w [int]) -> [io_write] int {
    let op = int_of(s[at]);
    var f = at + 2;
    region r {
        let a = alloc_slice[r](hex_len(s, f), byte_of(0));
        hex_into(s, f, a);
        f = next_field(s, f);
        if op == 83 || op == 87 {
            // S, W: digest key extra.
            let key = alloc_slice[r](hex_len(s, f), byte_of(0));
            hex_into(s, f, key);
            f = next_field(s, f);
            let extra = alloc_slice[r](hex_len(s, f), byte_of(0));
            hex_into(s, f, extra);
            let sig = alloc_slice[r](64, byte_of(0));
            var code = 0;
            if op == 83 {
                code = ecdsa_sign.sign(a, key, extra, sig, work);
            } else {
                code = ecdsa_sign.sign(a, key, extra, sig, work[0..len(work) - 10]);
            }
            report(io, code, sig);
        } else if op == 67 {
            // C: digest key point extra.
            let key = alloc_slice[r](hex_len(s, f), byte_of(0));
            hex_into(s, f, key);
            f = next_field(s, f);
            let point = alloc_slice[r](hex_len(s, f), byte_of(0));
            hex_into(s, f, point);
            f = next_field(s, f);
            let extra = alloc_slice[r](hex_len(s, f), byte_of(0));
            hex_into(s, f, extra);
            let sig = alloc_slice[r](64, byte_of(0));
            let code = ecdsa_sign.sign_checked(a, key, point, extra, sig, work);
            report(io, code, sig);
        } else if op == 69 || op == 70 {
            // E, F: sig [size].
            var size = ecdsa_sign.der_max();
            if op == 70 {
                size = number(s, f);
            }
            let der = alloc_slice[r](size, byte_of(0));
            let code = ecdsa_sign.to_der(a, der);
            if code > 0 {
                report(io, code, der[0..code]);
            } else {
                report(io, code, der);
            }
        } else if op == 77 {
            // M: msg key extra.
            let key = alloc_slice[r](hex_len(s, f), byte_of(0));
            hex_into(s, f, key);
            f = next_field(s, f);
            let extra = alloc_slice[r](hex_len(s, f), byte_of(0));
            hex_into(s, f, extra);
            let der = alloc_slice[r](ecdsa_sign.der_max(), byte_of(0));
            let code = sign_message(a, key, extra, der, work);
            if code > 0 {
                report(io, code, der[0..code]);
            } else {
                report(io, code, der);
            }
        } else if op == 75 || op == 66 || op == 71 {
            // K: pem. B: format der. G: pem msg extra.
            let out = alloc_slice[r](97, byte_of(0));
            var code = 0;
            if op == 66 {
                let format = int_of(a[0]);
                let der = alloc_slice[r](hex_len(s, f), byte_of(0));
                hex_into(s, f, der);
                code = x509_key.parse_der(format, der, out[0..32], out[32..97], work);
            } else {
                code = x509_key.parse_pem(a, out[0..32], out[32..97], work);
            }
            if op == 71 && code == 0 {
                let msg = alloc_slice[r](hex_len(s, f), byte_of(0));
                hex_into(s, f, msg);
                f = next_field(s, f);
                let extra = alloc_slice[r](hex_len(s, f), byte_of(0));
                hex_into(s, f, extra);
                let der = alloc_slice[r](ecdsa_sign.der_max(), byte_of(0));
                code = sign_message(msg, out[0..32], extra, der, work);
                if code > 0 {
                    report(io, code, der[0..code]);
                } else {
                    report(io, code, der);
                }
            } else {
                report(io, code, out);
            }
        } else if op == 88 {
            // X: cert point.
            let point = alloc_slice[r](hex_len(s, f), byte_of(0));
            hex_into(s, f, point);
            let code = x509_key.matches_certificate(a, point);
            report(io, code, point[0..0]);
        } else {
            io.write_all(io, "-1 unknown-op -\n");
        }
    }
    return 0;
}

fn run[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read, io_write] int {
    var text = buffer.empty(heap, 4096);
    text = read_stdin(heap, io, text);
    let work = box_slice(heap, ecdsa_sign.work_len(), 0);
    borrow text as &b in {
        let s = buffer.bytes(b);
        borrow mut work as &!w in {
            var at = 0;
            while at < len(s) {
                if int_of(s[at]) != 10 {
                    case(io, s, at, contents(w));
                }
                while at < len(s) && int_of(s[at]) != 10 {
                    at = at + 1;
                }
                at = at + 1;
            }
        }
    }
    unbox_slice(heap, work);
    buffer.drop(heap, text);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(args);
    release(ffi);
    release(fs);
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            run(h, i);
        }
    }
    release(heap);
    release(io);
    return 0;
}
