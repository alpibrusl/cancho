edition 7;

// The driver of `scripts/secp256k1_differential.py` (`docs/secp256k1.md` §3): one command on standard input, one answer on standard output.
//
//   P <key>                      public key              ->  "<rc> <04||x||y>"
//   S <digest> <key> [<extra>]   sign                    ->  "<rc> <r||s||recid>"
//   R <digest> <sig65>           recover                 ->  "<rc> <04||x||y>"
//   V <digest> <pub65> <sig>     verify                  ->  "<rc>"
//   B <key> <rounds3> <op>       the cost of one operation: `op` (the hex byte 50, 53, 52 or 56: P, S, R, V) run `rounds3` times (3 bytes,
//                                big-endian) on the key and a digest equal to it; the answer is the sum of the codes, 0. `scripts/secp256k1_bench.py`.
//
// Every argument is hex. An answer's code is 0 or a refusal (`secp256k1.refusal_tag`).

import secp256k1;
import std.buffer;
import std.io;

fn nibble(c: int) -> [] int {
    if c >= 97 {
        return c - 87;
    }
    if c >= 65 {
        return c - 55;
    }
    return c - 48;
}

fn hex_digit(v: int) -> [] int {
    if v < 10 {
        return 48 + v;
    }
    return 87 + v;
}

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] buffer.Buffer {
    var out = buffer.empty(heap, 256);
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

// The bytes of the `n`th space-separated field (0 is the op) as hex-decoded bytes; empty when there is no such field.
fn field_bytes[&h, &t](heap: &!h Heap, text: &t [byte], n: int) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 32);
    var field = 0;
    var i = 0;
    var half = -1;
    while i < len(text) {
        let c = int_of(text[i]);
        if c == 32 || c == 10 {
            field = field + 1;
        } else if field == n && n > 0 {
            if half < 0 {
                half = nibble(c);
            } else {
                out = buffer.push(heap, out, byte_of(half * 16 + nibble(c)));
                half = -1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn put_hex[&h, &t](heap: &!h Heap, out: buffer.Buffer, bytes: &t [byte]) -> [heap] buffer.Buffer {
    var o = out;
    var k = 0;
    while k < len(bytes) {
        let v = int_of(bytes[k]);
        o = buffer.push(heap, o, byte_of(hex_digit(v >> 4)));
        o = buffer.push(heap, o, byte_of(hex_digit(v & 15)));
        k = k + 1;
    }
    return o;
}

// The loop of `B`: the signature and public key it needs are made first, so the set-up is the same for any rounds and cancels out.
fn bench[&k, &w](key: &k [byte], rounds: int, which: int, work: &!w [int]) -> [] int {
    var total = 0;
    region r {
        let pk = alloc_slice[r](65, byte_of(0));
        let sig = alloc_slice[r](65, byte_of(0));
        let out = alloc_slice[r](65, byte_of(0));
        let none = alloc_slice[r](0, byte_of(0));
        total = total + secp256k1.public_key(key, pk, work);
        total = total + secp256k1.sign(key, key, none, sig, work);
        var n = 0;
        while n < rounds {
            if which == 0x50 {
                total = total + secp256k1.public_key(key, pk, work);
            } else if which == 0x53 {
                total = total + secp256k1.sign(key, key, none, sig, work);
            } else if which == 0x52 {
                total = total + secp256k1.recover(key, sig, out, work);
            } else if which == 0x56 {
                total = total + secp256k1.verify(key, pk, sig, work);
            }
            n = n + 1;
        }
    }
    return total;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(fs);
    release(args);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            let text = read_stdin(h, i);
            let w = box_slice(h, secp256k1.work_len(), 0);
            let scratch = box_slice(h, 65, byte_of(0));
            var rc = -999;
            var show = 0;
            borrow text as &tx in {
                let src = buffer.bytes(tx);
                let op = int_of(src[0]);
                let f1 = field_bytes(h, src, 1);
                let f2 = field_bytes(h, src, 2);
                let f3 = field_bytes(h, src, 3);
                borrow f1 as &a1 in {
                    borrow f2 as &a2 in {
                        borrow f3 as &a3 in {
                            borrow mut w as &!ww in {
                                borrow mut scratch as &!ss in {
                                    let b1 = buffer.bytes(a1);
                                    let b2 = buffer.bytes(a2);
                                    let b3 = buffer.bytes(a3);
                                    if op == 'P' {
                                        rc = secp256k1.public_key(b1, contents(ss), contents(ww));
                                        show = 65;
                                    } else if op == 'S' {
                                        rc = secp256k1.sign(b1, b2, b3, contents(ss), contents(ww));
                                        show = 65;
                                    } else if op == 'R' {
                                        rc = secp256k1.recover(b1, b2, contents(ss), contents(ww));
                                        show = 65;
                                    } else if op == 'V' {
                                        rc = secp256k1.verify(b1, b2, b3, contents(ww));
                                    } else if op == 'B' {
                                        rc = bench(b1, int_of(b2[0]) * 65536 + int_of(b2[1]) * 256 + int_of(b2[2]), int_of(b3[0]), contents(ww));
                                    }
                                }
                            }
                        }
                    }
                }
                buffer.drop(h, f1);
                buffer.drop(h, f2);
                buffer.drop(h, f3);
            }
            var answer = buffer.empty(h, 200);
            if rc != 0 {
                answer = buffer.push(h, answer, byte_of('E'));
                answer = buffer.push_nat(h, answer, 0 - rc);
            } else {
                answer = buffer.push_nat(h, answer, 0);
                answer = buffer.push(h, answer, byte_of(' '));
                borrow scratch as &sc in {
                    answer = put_hex(h, answer, contents(sc)[0..show]);
                }
            }
            answer = buffer.push(h, answer, byte_of(10));
            borrow answer as &rx in {
                buffer.write(i, rx);
            }
            buffer.drop(h, answer);
            buffer.drop(h, text);
            unbox_slice(h, w);
            unbox_slice(h, scratch);
        }
    }
    release(heap);
    release(io);
    return 0;
}
