// A whole-file read by path: the program tests/commands/filesystem.cho asks `cancho authority --output json` about (`docs/file-handles.md` section 4.1). Never run.
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(args);
    release(heap);
    release(ffi);
    release(io);
    region a {
        var buffer = alloc_slice[a](8, byte_of(0));
        borrow fs as &c in {
            fs_read(c, "/tmp/cancho-authority.txt", buffer);
        }
    }
    release(fs);
    return 0;
}
