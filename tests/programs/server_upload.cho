edition 5;

// `http.server`'s streaming request bodies on the socket path (`docs/http-server.md` §12): the same
// calls `tests/packages/http_server_body_test.cho` makes on a byte-fed server, made on one with
// sockets, so `step`, `settle` and `wait` are exercised too.
//
//     server_upload <port> <buffer size> <max body> <head ms> <body ms> [lazy]
//
// With `lazy` (1) the program calls `next` only every tenth time round its loop: what `wait` recorded for a connection (a refusal found
// while reading) waits for the visit after the next `wait`, which may bring more bytes for that connection.
//
//     POST /upload   held, told to go ahead, its body taken as it comes; answered `n=<bytes> c=<checksum>`
//     POST /slow     the same, but only 50 bytes are taken every 20 ms (the client is made to wait: back-pressure)
//     POST /early    answered `early` as soon as its first piece is taken, whatever is still to come
//     POST /refuse   refused with a 413 at once, whatever it says about its body, and no `100`
//     anything else  answered at once with `n=<body length> c=<checksum>`; a streaming one is refused 404
//
// The checksum of a body is `c = (c * 131 + byte) mod 1000000007`, byte by byte.

import std.buffer;
import std.bytes;
import std.http;
import http.server;

fn number_of[&t](text: &t [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(text) {
        n = n * 10 + (int_of(text[i]) - 48);
        i = i + 1;
    }
    return n;
}

fn checksum[&t](c: int, text: &t [byte]) -> [] int {
    var sum = c;
    var i = 0;
    while i < len(text) {
        sum = (sum * 131 + int_of(text[i])) % 1000000007;
        i = i + 1;
    }
    return sum;
}

// `n=<count> c=<sum>` as the body of a 200.
fn tally[&h](heap: &!h Heap, count: int, sum: int) -> [heap] buffer.Buffer {
    var text = buffer.append(heap, buffer.empty(heap, 32), "n=");
    text = buffer.push_nat(heap, text, count);
    text = buffer.append(heap, text, " c=");
    text = buffer.push_nat(heap, text, sum);
    var out = buffer.empty(heap, 128);
    borrow text as &tb in {
        out = server.reply_as(heap, out, 200, "text/plain", buffer.bytes(tb), true, "");
    }
    buffer.drop(heap, text);
    return out;
}

// Per slot, five words: the ticket + 1 (0: none), the bytes taken, their checksum, the mode (0 upload, 1 slow, 2 early) and, for a
// slow one, when it last took anything (ms).
fn pull_all[&h, &s, &u](heap: &!h Heap, srv: &!s server.Server, up: &!u [int], slot: int, now: int) -> [heap, conn_write, poll] int {
    let at = 5 * slot;
    let ticket = up[at] - 1;
    var going = true;
    if up[at + 3] == 1 && now - up[at + 4] < 20 {
        going = false;
    }
    while going && up[at] != 0 {
        let part = server.body_part(srv, ticket);
        var n = len(part);
        if up[at + 3] == 1 && n > 50 {
            n = 50;
        }
        if n > 0 && up[at + 3] == 1 {
            up[at + 4] = now;
        }
        if n > 0 {
            up[at + 2] = checksum(up[at + 2], part[0..n]);
            up[at + 1] = up[at + 1] + n;
            server.body_take(srv, ticket, n);
            if up[at + 3] == 2 {
                let out = server.reply_as(heap, buffer.empty(heap, 128), 200, "text/plain", "early", true, "");
                borrow out as &ob in {
                    server.answer(srv, ticket, buffer.bytes(ob));
                }
                buffer.drop(heap, out);
                up[at] = 0;
            }
            if up[at + 3] == 1 {
                going = false;
            }
        } else {
            going = false;
            let state = server.body_state(srv, ticket);
            if state == 1 {
                let out = tally(heap, up[at + 1], up[at + 2]);
                borrow out as &ob in {
                    server.answer(srv, ticket, buffer.bytes(ob));
                }
                buffer.drop(heap, out);
                up[at] = 0;
            } else if state < 0 {
                up[at] = 0;
            }
        }
    }
    return 0;
}

fn handle[&h, &s, &u](heap: &!h Heap, srv: &!s server.Server, up: &!u [int]) -> [heap, conn_write, poll] int {
    var mode = 0 - 1;
    var refuse = false;
    var whole = false;
    let path = http.path(server.head(srv), server.parsed(srv));
    if server.streaming(srv) {
        if bytes.equal(path, "/upload") {
            mode = 0;
        } else if bytes.equal(path, "/slow") {
            mode = 1;
        } else if bytes.equal(path, "/early") {
            mode = 2;
        } else {
            refuse = true;
        }
    } else {
        whole = true;
    }
    if mode >= 0 {
        let ticket = server.hold(srv);
        let at = 5 * server.ticket_slot(ticket);
        up[at] = ticket + 1;
        up[at + 1] = 0;
        up[at + 2] = 0;
        up[at + 3] = mode;
        up[at + 4] = 0;
        server.proceed(srv, ticket);
    } else if refuse {
        let out = server.failure(heap, buffer.empty(heap, 64), 413, "refused", true);
        borrow out as &ob in {
            server.respond(srv, buffer.bytes(ob));
        }
        buffer.drop(heap, out);
    } else if whole {
        let out = tally(heap, len(server.body(srv)), checksum(0, server.body(srv)));
        borrow out as &ob in {
            server.respond(srv, buffer.bytes(ob));
        }
        buffer.drop(heap, out);
    }
    return 0;
}

fn run[&h, &k, &l](heap: &!h Heap, clock: &k Clock, listener: &!l Listener, size: int, max_body: int, head_ms: int, body_ms: int, lazy: int) -> [heap, conn_accept, conn_read, conn_write, poll, clock] int {
    match poller_new() {
        Polling::Ok(p) => {
            var srv = server.open(heap, p, listener, size, 0, 9);
            var set = 0 - 1;
            borrow mut srv as &!sw in {
                set = server.limits(sw, max_body, size, head_ms, body_ms);
            }
            if set != 0 {
                server.close(heap, srv);
                return 5;
            }
            let up = box_slice(heap, 5 * 1024, 0);
            var round = 0;
            while true {
                srv = server.wait(heap, srv, clock, listener, 20);
                let now = clock_ms(clock);
                round = round + 1;
                borrow mut srv as &!sw in {
                    borrow mut up as &!uw in {
                        var more = lazy == 0 || round % 10 == 0;
                        while more {
                            if server.next(heap, sw) < 0 {
                                more = false;
                            } else {
                                handle(heap, sw, contents(uw));
                            }
                        }
                        var s = 0;
                        while s < 1024 {
                            if contents(uw)[5 * s] != 0 {
                                pull_all(heap, sw, contents(uw), s, now);
                            }
                            s = s + 1;
                        }
                    }
                }
            }
            server.close(heap, srv);
            unbox_slice(heap, up);
            return 0;
        }
        Polling::Failed(e) => {
            return 4;
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(fs);
    release(ffi);
    var status = 2;
    var port = 0 - 1;
    var size = 16384;
    var max_body = 1000000;
    var head_ms = 1000;
    var body_ms = 1000;
    var lazy = 0;
    borrow args as &g in {
        if arg_count(g) > 6 {
            lazy = number_of(arg(g, 6));
        }
        if arg_count(g) > 5 {
            port = number_of(arg(g, 1));
            size = number_of(arg(g, 2));
            max_body = number_of(arg(g, 3));
            head_ms = number_of(arg(g, 4));
            body_ms = number_of(arg(g, 5));
        }
    }
    if port > 0 {
        status = 3;
        borrow net as &nn in {
            match tcp_listen(nn, port, 1024, 0) {
                Listening::Ok(l) => {
                    var listener = l;
                    borrow mut listener as &!lh in {
                        listener_nonblocking(lh);
                        borrow mut heap as &!h in {
                            borrow clock as &c in {
                                status = run(h, c, lh, size, max_body, head_ms, body_ms, lazy);
                            }
                        }
                    }
                    listener_close(listener);
                }
                Listening::Failed(e) => {
                    status = 3;
                }
            }
        }
    }
    release(net);
    release(clock);
    release(args);
    release(io);
    release(heap);
    return status;
}
