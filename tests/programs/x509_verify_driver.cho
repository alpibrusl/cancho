// `docs/x509-verify.md` §6: `packages/x509`'s verifier driven from
// standard input, one line at a time.
//
//     S <PEM bundle in hex>
//         the store becomes that bundle's roots; answers
//         `<roots> <skipped> <bytes used>`, or `<code> <tag>`
//     V <now> <max intermediates> <host in hex, or -> <cert hex> ...
//         the chain, leaf first, against the store; answers `<code> <tag>`
//     C <now> <max intermediates> <purpose> <cert hex> ...
//         `verify_chain`, no name (`docs/x509-verify.md` §10); answers
//         `<code> <tag>`, and on 0 the leaf's subject in hex and its SAN
//         entries through `san_next`, `<decimal tag>:<hex>` joined by commas
//         (`-` for none); on a refusal, ` left-behind` if the leaf's view
//         still holds a subject or a SAN
//     N 0 0 <host in hex, or -> <leaf hex>
//         `verify_name` alone, over the leaf's own view
import std.buffer;
import std.io;
import x509;
import x509_verify;

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

fn nibble(c: int) -> [] int {
    if c >= 97 {
        return c - 87;
    }
    return c - 48;
}

fn field_end[&s](s: &s [byte], at: int, e: int) -> [] int {
    var k = at;
    while k < e && int_of(s[k]) != 32 {
        k = k + 1;
    }
    return k;
}

fn number[&s](s: &s [byte], at: int, e: int) -> [] int {
    var n = 0;
    var k = at;
    var sign = 1;
    if k < e && int_of(s[k]) == 45 {
        sign = -1;
        k = k + 1;
    }
    while k < e {
        n = n * 10 + int_of(s[k]) - 48;
        k = k + 1;
    }
    return sign * n;
}

// Hex `s[at..e]` into `out` from `to`; the bytes written.
fn unhex[&s, &o](s: &s [byte], at: int, e: int, out: &!o [byte], to: int) -> [] int {
    var k = 0;
    while at + 2 * k + 1 < e {
        out[to + k] = byte_of(nibble(int_of(s[at + 2 * k])) * 16 + nibble(int_of(s[at + 2 * k + 1])));
        k = k + 1;
    }
    return k;
}

fn tag_line[&i](io: &!i Io, code: int) -> [io_write] int {
    io.print_int(io, code);
    io.space(io);
    io.write_all(io, x509_verify.refusal_tag(code));
    io.newline(io);
    return 0;
}

fn hex_out[&i, &b](io: &!i Io, b: &b [byte]) -> [io_write] int {
    var k = 0;
    while k < len(b) {
        let hi = int_of(b[k]) >> 4;
        let lo = int_of(b[k]) & 15;
        var c = 48 + hi;
        if hi > 9 {
            c = 87 + hi;
        }
        putchar(io, c);
        c = 48 + lo;
        if lo > 9 {
            c = 87 + lo;
        }
        putchar(io, c);
        k = k + 1;
    }
    return 0;
}

// `verify_chain`'s answer, and on 0 what the program is given: the
// subject and the SAN entries.
fn chain_line[&i, &d, &v](io: &!i Io, code: int, leaf: &d [byte], view: &v [int]) -> [io_write] int {
    io.print_int(io, code);
    io.space(io);
    io.write_all(io, x509_verify.refusal_tag(code));
    if code == 0 {
        io.space(io);
        hex_out(io, leaf[view[x509.subject_start()]..view[x509.subject_end()]]);
        io.space(io);
        var any = false;
        region r {
            let entry = alloc_slice[r](3, 0);
            var at = x509_verify.san_next(leaf, view, 0, entry);
            while at != 0 {
                if any {
                    putchar(io, 44);
                }
                any = true;
                io.print_int(io, entry[0]);
                putchar(io, 58);
                hex_out(io, leaf[entry[1]..entry[2]]);
                at = x509_verify.san_next(leaf, view, at, entry);
            }
        }
        if !any {
            putchar(io, 45);
        }
    } else {
        // A refusal must leave no identity behind (§10.3): anything
        // still readable is printed, and the recorded answers have none.
        region r {
            let entry = alloc_slice[r](3, 0);
            if view[x509.subject_end()] != 0 || x509_verify.san_next(leaf, view, 0, entry) != 0 {
                io.write_all(io, " left-behind");
            }
        }
    }
    io.newline(io);
    return 0;
}

// One `V`, `C` or `N` line (`mode`), `s[at..e]` after the letter.
fn verify_line[&h, &i, &s, &t](heap: &!h Heap, io: &!i Io, mode: int, s: &s [byte], at: int, e: int, store: &t [byte]) -> [heap, io_write] int {
    var p = at;
    var f = field_end(s, p, e);
    let now = number(s, p, f);
    p = f + 1;
    f = field_end(s, p, e);
    let max = number(s, p, f);
    p = f + 1;
    f = field_end(s, p, e);
    let host_at = p;
    let host_end = f;
    p = f + 1;
    // Count the certificates.
    var n = 0;
    var q = p;
    while q < e {
        n = n + 1;
        q = field_end(s, q, e) + 1;
    }
    let certs = box_slice(heap, (e - p) / 2 + 1, byte_of(0));
    let ranges = box_slice(heap, 2 * n, 0);
    let host = box_slice(heap, (host_end - host_at) / 2 + 1, byte_of(0));
    var hn = 0;
    var cb = certs;
    var rb = ranges;
    var hb = host;
    borrow mut hb as &!hw in {
        if mode != 67 && !(host_end - host_at == 1 && int_of(s[host_at]) == 45) {
            hn = unhex(s, host_at, host_end, contents(hw), 0);
        }
    }
    borrow mut cb as &!cw in {
        borrow mut rb as &!rw in {
            let c = contents(cw);
            let r = contents(rw);
            var used = 0;
            var k = 0;
            q = p;
            while k < n {
                let fe = field_end(s, q, e);
                r[2 * k] = used;
                used = used + unhex(s, q, fe, c, used);
                r[2 * k + 1] = used;
                q = fe + 1;
                k = k + 1;
            }
        }
    }
    var code = 0;
    borrow cb as &cr in {
        borrow rb as &rr in {
            borrow hb as &hr in {
                if mode == 86 {
                    code = x509_verify.verify(store, contents(cr), contents(rr), contents(hr)[0..hn], now, max);
                    tag_line(io, code);
                } else {
                    region v {
                        let view = alloc_slice[v](x509.view_len(), 0);
                        let r = contents(rr);
                        let leaf = contents(cr)[r[0]..r[1]];
                        if mode == 67 {
                            let purpose = number(s, host_at, host_end);
                            code = x509_verify.verify_chain(store, contents(cr), r, now, max, purpose, view);
                            chain_line(io, code, leaf, view);
                        } else {
                            code = x509.parse(leaf, view);
                            if code == 0 {
                                code = x509_verify.verify_name(leaf, view, contents(hr)[0..hn]);
                            }
                            tag_line(io, code);
                        }
                    }
                }
            }
        }
    }
    unbox_slice(heap, cb);
    unbox_slice(heap, rb);
    unbox_slice(heap, hb);
    return 0;
}

fn run[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read, io_write] int {
    var text = buffer.empty(heap, 4096);
    text = read_stdin(heap, io, text);
    var store = box_slice(heap, 4194304, byte_of(0));
    var store_used = 0;
    borrow text as &b in {
        let s = buffer.bytes(b);
        var at = 0;
        while at < len(s) {
            var e = at;
            while e < len(s) && int_of(s[e]) != 10 {
                e = e + 1;
            }
            if e - at >= 2 && int_of(s[at]) == 83 {
                let pem = box_slice(heap, (e - at) / 2 + 1, byte_of(0));
                var pb = pem;
                var pn = 0;
                borrow mut pb as &!pw in {
                    pn = unhex(s, at + 2, e, contents(pw), 0);
                }
                region r {
                    let info = alloc_slice[r](2, 0);
                    var roots = 0;
                    borrow pb as &pr in {
                        borrow mut store as &!sw in {
                            roots = x509_verify.store_load(contents(pr)[0..pn], contents(sw), info);
                        }
                    }
                    if roots < 0 {
                        store_used = 0;
                        tag_line(io, roots);
                    } else {
                        store_used = info[0];
                        io.print_int(io, roots);
                        io.space(io);
                        io.print_int(io, info[1]);
                        io.space(io);
                        io.print_int(io, info[0]);
                        io.newline(io);
                    }
                }
                unbox_slice(heap, pb);
            } else if e - at >= 2 && (int_of(s[at]) == 86 || int_of(s[at]) == 67 || int_of(s[at]) == 78) {
                borrow store as &sr in {
                    verify_line(heap, io, int_of(s[at]), s, at + 2, e, contents(sr)[0..store_used]);
                }
            }
            at = e + 1;
        }
    }
    unbox_slice(heap, store);
    buffer.drop(heap, text);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(args);
    release(ffi);
    release(fs);
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            run(h, i);
        }
    }
    release(heap);
    release(io);
    return 0;
}
