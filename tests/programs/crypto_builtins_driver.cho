edition 7;

// `docs/crypto-builtins.md` §7, `docs/gcm-wide.md` §6: the hardware AES and
// GHASH builtins, driven from standard input. One case per line, byte
// strings in lowercase hex, `-` for an empty one:
//
//     H                                       hw_aes_gcm(): 1 or 0
//     A <rounds> <keys> <block>               aes_encrypt_block: the block out
//     C <rounds> <keys> <nonce> <counter> <data>
//                                             aes_ctr32: data XOR keystream
//     P <h>                                   ghash_powers: the 128-byte table
//     T <rounds> <keys> <h> <nonce> <aad> <text>
//                                             gcm_tag: the tag (the table is
//                                             ghash_powers(h)'s)
//     D <rounds> <keys> <h> <nonce> <aad> <text> <tag>
//                                             gcm_tag_diff: 0 or 1
//     X <rounds> <keys> <h> <nonce> <aad> <text> <tag>
//                                             the same traps' cases, with the
//                                             table one byte short
//
// and one line out per case. All but `H` are only sent when `H` said 1.
import std.buffer;
import std.io;

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

fn nibble(c: int) -> [] int {
    if c >= 97 {
        return c - 87;
    }
    return c - 48;
}

fn field_end[&s](s: &s [byte], at: int) -> [] int {
    var e = at;
    while e < len(s) && int_of(s[e]) != 32 && int_of(s[e]) != 10 {
        e = e + 1;
    }
    return e;
}

fn hex_into[&s, &o](s: &s [byte], at: int, o: &!o [byte]) -> [] int {
    var i = 0;
    while i < len(o) {
        o[i] = byte_of(nibble(int_of(s[at + i * 2])) * 16 + nibble(int_of(s[at + i * 2 + 1])));
        i = i + 1;
    }
    return 0;
}

fn decimal[&s](s: &s [byte], at: int, end: int) -> [] int {
    var n = 0;
    var i = at;
    while i < end {
        n = n * 10 + int_of(s[i]) - 48;
        i = i + 1;
    }
    return n;
}

fn print_hex[&i, &d](io: &!i Io, d: &d [byte]) -> [io_write] int {
    let digits = "0123456789abcdef";
    var n = 0;
    while n < len(d) {
        let b = int_of(d[n]);
        io.write_all(io, digits[b >> 4..(b >> 4) + 1]);
        io.write_all(io, digits[b & 15..(b & 15) + 1]);
        n = n + 1;
    }
    io.newline(io);
    return 0;
}

// The hex field `[at, end)`, which is `-` for no bytes.
fn hex_len[&s](s: &s [byte], at: int, end: int) -> [] int {
    if end - at == 1 && int_of(s[at]) == 45 {
        return 0;
    }
    return (end - at) / 2;
}

fn hex_field[&s, &o](s: &s [byte], at: int, end: int, o: &!o [byte]) -> [] int {
    if hex_len(s, at, end) > 0 {
        hex_into(s, at, o);
    }
    return 0;
}

// One case, the line starting at `at`; answers where the next line starts.
fn one[&i, &s](io: &!i Io, s: &s [byte], at: int) -> [io_write] int {
    let op = int_of(s[at]);
    if op == 72 {
        if hw_aes_gcm() {
            io.write_all(io, "1");
        } else {
            io.write_all(io, "0");
        }
        io.newline(io);
        return at + 2;
    }
    var line_end = at;
    while int_of(s[line_end]) != 10 {
        line_end = line_end + 1;
    }
    region r {
        // Where each field starts and ends (at most eight).
        let starts = alloc_slice[r](8, 0);
        let ends = alloc_slice[r](8, 0);
        var n = 0;
        var f = at + 2;
        while f <= line_end && n < 8 {
            starts[n] = f;
            ends[n] = field_end(s, f);
            f = ends[n] + 1;
            n = n + 1;
        }
        if op == 65 {
            let rounds = decimal(s, starts[0], ends[0]);
            let keys = alloc_slice[r](hex_len(s, starts[1], ends[1]), byte_of(0));
            hex_field(s, starts[1], ends[1], keys);
            let block = alloc_slice[r](hex_len(s, starts[2], ends[2]), byte_of(0));
            hex_field(s, starts[2], ends[2], block);
            let out = alloc_slice[r](16, byte_of(0));
            aes_encrypt_block(keys, rounds, block, out);
            print_hex(io, out);
        } else if op == 67 {
            let rounds = decimal(s, starts[0], ends[0]);
            let keys = alloc_slice[r](hex_len(s, starts[1], ends[1]), byte_of(0));
            hex_field(s, starts[1], ends[1], keys);
            let nonce = alloc_slice[r](hex_len(s, starts[2], ends[2]), byte_of(0));
            hex_field(s, starts[2], ends[2], nonce);
            let counter = decimal(s, starts[3], ends[3]);
            let data = alloc_slice[r](hex_len(s, starts[4], ends[4]), byte_of(0));
            hex_field(s, starts[4], ends[4], data);
            let out = alloc_slice[r](len(data), byte_of(0));
            aes_ctr32(keys, rounds, nonce, counter, data, out);
            if len(out) == 0 {
                io.write_all(io, "-");
                io.newline(io);
            } else {
                print_hex(io, out);
            }
        } else if op == 80 {
            let h = alloc_slice[r](hex_len(s, starts[0], ends[0]), byte_of(0));
            hex_field(s, starts[0], ends[0], h);
            let table = alloc_slice[r](128, byte_of(0));
            ghash_powers(h, table);
            print_hex(io, table);
        } else {
            let rounds = decimal(s, starts[0], ends[0]);
            let keys = alloc_slice[r](hex_len(s, starts[1], ends[1]), byte_of(0));
            hex_field(s, starts[1], ends[1], keys);
            let h = alloc_slice[r](hex_len(s, starts[2], ends[2]), byte_of(0));
            hex_field(s, starts[2], ends[2], h);
            let nonce = alloc_slice[r](hex_len(s, starts[3], ends[3]), byte_of(0));
            hex_field(s, starts[3], ends[3], nonce);
            let aad = alloc_slice[r](hex_len(s, starts[4], ends[4]), byte_of(0));
            hex_field(s, starts[4], ends[4], aad);
            let text = alloc_slice[r](hex_len(s, starts[5], ends[5]), byte_of(0));
            hex_field(s, starts[5], ends[5], text);
            var table_len = 128;
            if op == 88 {
                table_len = 127;
            }
            let table = alloc_slice[r](128, byte_of(0));
            ghash_powers(h, table);
            if op == 84 {
                let tag = alloc_slice[r](16, byte_of(0));
                gcm_tag(keys, rounds, table, nonce, aad, text, tag);
                print_hex(io, tag);
            } else {
                let tag = alloc_slice[r](hex_len(s, starts[6], ends[6]), byte_of(0));
                hex_field(s, starts[6], ends[6], tag);
                let diff = gcm_tag_diff(keys, rounds, table[0..table_len], nonce, aad, text, tag);
                if diff == 0 {
                    io.write_all(io, "0");
                } else {
                    io.write_all(io, "1");
                }
                io.newline(io);
            }
        }
    }
    return line_end + 1;
}

fn cases[&i, &s](io: &!i Io, s: &s [byte]) -> [io_write] int {
    var at = 0;
    while at < len(s) {
        at = one(io, s, at);
    }
    return 0;
}

fn run[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read, io_write] int {
    var text = buffer.empty(heap, 4096);
    text = read_stdin(heap, io, text);
    borrow text as &b in {
        cases(io, buffer.bytes(b));
    }
    buffer.drop(heap, text);
    return 0;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(fs);
    release(args);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            run(h, i);
        }
    }
    release(heap);
    release(io);
    return 0;
}
