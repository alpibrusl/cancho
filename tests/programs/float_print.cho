// `docs/float-printing.md` §3.4 and `docs/floating-point.md` §4.1: the
// differential driver for `std.fmt.float_into` and `float_of_bits`.
//
// Reads one JSON array of integers on standard input, each the 64 bits of a
// double as a signed `int`, and prints for each one line: `float_into` of
// `float_of_bits(n)`. `float_text.rs` and `scripts/float_differential.py`
// write the array and compare every line with Python's `repr` and Rust's
// `{:e}`, as exact decimal rationals.
edition 7;

import std.buffer;
import std.fmt;
import std.io;
import std.json;

fn read_stdin[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_read] buffer.Buffer {
    var out = text;
    var c = getchar(io);
    while c >= 0 {
        out = buffer.push(heap, out, byte_of(c));
        c = getchar(io);
    }
    return out;
}

fn show[&i](io: &!i Io, x: float) -> [io_write] int {
    region a {
        let buf = alloc_slice[a](24, byte_of(0));
        let n = fmt.float_into(buf, x);
        io.write_all(io, buf[0..n]);
        io.newline(io);
    }
    return 0;
}

fn report[&i, &s, &t](io: &!i Io, src: &s [byte], tape: &t [int], nodes: int) -> [io_write] int {
    var j = 1;
    while j < nodes {
        show(io, float_of_bits(json.to_int(src, tape, j)));
        j = json.skip(tape, j);
    }
    return 0;
}

fn run[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read, io_write] int {
    var text = buffer.empty(heap, 4096);
    text = read_stdin(heap, io, text);
    var status = 0;
    borrow text as &b in {
        let src = buffer.bytes(b);
        let tape = box_slice(heap, json.tape_len(src), 0);
        borrow mut tape as &!w in {
            let nodes = json.parse(src, contents(w));
            if nodes < 0 {
                status = 1;
            } else {
                report(io, src, contents(w), nodes);
            }
        }
        unbox_slice(heap, tape);
    }
    buffer.drop(heap, text);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    release(args);
    release(fs);
    release(ffi);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            status = run(h, i);
        }
    }
    release(heap);
    release(io);
    return status;
}
