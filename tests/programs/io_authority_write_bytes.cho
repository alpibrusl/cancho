// The same two bytes through `write_bytes`: the program tests/commands/io.cho asks `cancho authority --output json` about (`docs/bulk-io.md` section 3.2), whose report must be exactly that of io_authority_putchar.cho. Never run.
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(args);
    release(heap);
    release(fs);
    release(ffi);
    borrow mut io as &!i in {
        write_bytes(i, "hi");
    }
    release(io);
    return 0;
}
