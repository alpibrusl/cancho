// `std.json`'s parser and reader, run by `cancho test --std tests/lex/json_parse_test.cho`.
import std.json;
import std.test;
import std.bytes;
import std.buffer;

// Parse `src`, answer its error code (0 when it parsed) and check where it stopped.
fn error_of[&s](src: &s [byte]) -> [] int {
    var code = 0 - 1;
    region a {
        let tape = alloc_slice[a](json.tape_len(src), 0);
        let nodes = json.parse(src, tape);
        if nodes < 0 {
            code = json.error_code(nodes);
        } else {
            code = 0;
        }
    }
    return code;
}

fn position_of[&s](src: &s [byte]) -> [] int {
    var at = 0 - 1;
    region a {
        let tape = alloc_slice[a](json.tape_len(src), 0);
        let nodes = json.parse(src, tape);
        if nodes < 0 {
            at = json.error_position(nodes);
        }
    }
    return at;
}

fn nodes_of[&s](src: &s [byte]) -> [] int {
    var count = 0 - 1;
    region a {
        let tape = alloc_slice[a](json.tape_len(src), 0);
        count = json.parse(src, tape);
    }
    return count;
}

fn test_scalars_parse_to_one_node_each() -> [] int {
    test.assert_eq(nodes_of("null"), 1);
    test.assert_eq(nodes_of("true"), 1);
    test.assert_eq(nodes_of("false"), 1);
    test.assert_eq(nodes_of("0"), 1);
    test.assert_eq(nodes_of("-12.5e3"), 1);
    test.assert_eq(nodes_of("\"hi\""), 1);
    test.assert_eq(nodes_of("  \t\r\n 7 \n"), 1);
    return 0;
}

fn test_containers_count_every_node() -> [] int {
    test.assert_eq(nodes_of("[]"), 1);
    test.assert_eq(nodes_of("{}"), 1);
    test.assert_eq(nodes_of("[1,2,3]"), 4);
    test.assert_eq(nodes_of("{\"a\":1,\"b\":2}"), 5);
    test.assert_eq(nodes_of("[[],[[]],{}]"), 5);
    test.assert_eq(nodes_of("{\"a\":{\"b\":[1,{\"c\":null}]}}"), 9);
    return 0;
}

fn test_kinds_and_navigation() -> [] int {
    let doc = "{\"name\":\"Ada\",\"age\":36,\"pi\":3.5,\"tags\":[\"x\",true,null],\"empty\":{}}";
    region a {
        let tape = alloc_slice[a](json.tape_len(doc), 0);
        let nodes = json.parse(doc, tape);
        test.assert_eq(nodes, 14);
        test.assert(json.is_object(tape, 0));
        test.assert_eq(json.count(tape, 0), 5);
        let name = json.get(doc, tape, 0, "name");
        test.assert(json.is_string(tape, name));
        test.assert(json.string_equals(doc, tape, name, "Ada"));
        test.assert(!json.string_equals(doc, tape, name, "Ad"));
        test.assert(!json.string_equals(doc, tape, name, "Adam"));
        let age = json.get(doc, tape, 0, "age");
        test.assert(json.is_int(tape, age));
        test.assert(json.is_number(tape, age));
        test.assert_eq(json.to_int(doc, tape, age), 36);
        let pi = json.get(doc, tape, 0, "pi");
        test.assert(!json.is_int(tape, pi));
        test.assert(json.is_number(tape, pi));
        test.assert(json.to_float(doc, tape, pi) == 3.5);
        let tags = json.get(doc, tape, 0, "tags");
        test.assert(json.is_array(tape, tags));
        test.assert_eq(json.count(tape, tags), 3);
        test.assert(json.string_equals(doc, tape, json.at(tape, tags, 0), "x"));
        test.assert(json.to_bool(tape, json.at(tape, tags, 1)));
        test.assert(json.is_null(tape, json.at(tape, tags, 2)));
        test.assert_eq(json.at(tape, tags, 3), 0 - 1);
        test.assert_eq(json.at(tape, tags, 0 - 1), 0 - 1);
        let empty = json.get(doc, tape, 0, "empty");
        test.assert(json.is_object(tape, empty));
        test.assert_eq(json.count(tape, empty), 0);
        // `skip` steps over a whole subtree.
        test.assert_eq(json.skip(tape, 0), nodes);
        test.assert_eq(json.skip(tape, tags), tags + 4);
        test.assert_eq(json.skip(tape, age), age + 1);
    }
    return 0;
}

fn test_a_missing_key_or_wrong_kind_answers_the_default() -> [] int {
    let doc = "{\"a\":1}";
    region a {
        let tape = alloc_slice[a](json.tape_len(doc), 0);
        json.parse(doc, tape);
        let missing = json.get(doc, tape, 0, "b");
        test.assert_eq(missing, 0 - 1);
        // Every accessor takes -1 and answers its zero value.
        test.assert_eq(json.to_int(doc, tape, missing), 0);
        test.assert(json.to_float(doc, tape, missing) == 0.0);
        test.assert(!json.to_bool(tape, missing));
        test.assert(!json.is_object(tape, missing));
        test.assert_eq(json.count(tape, missing), 0);
        test.assert_eq(json.get(doc, tape, missing, "a"), 0 - 1);
        // A key looked up in a non-object.
        test.assert_eq(json.get(doc, tape, json.get(doc, tape, 0, "a"), "a"), 0 - 1);
        test.assert_eq(json.string_length(doc, tape, 0), 0 - 1);
    }
    return 0;
}

fn test_duplicate_keys_take_the_first() -> [] int {
    let doc = "{\"k\":1,\"k\":2}";
    region a {
        let tape = alloc_slice[a](json.tape_len(doc), 0);
        json.parse(doc, tape);
        test.assert_eq(json.to_int(doc, tape, json.get(doc, tape, 0, "k")), 1);
    }
    return 0;
}

fn test_a_key_with_an_escape_is_found_by_its_decoded_text() -> [] int {
    let doc = "{\"caf\\u00e9\":1,\"a\\nb\":2}";
    region a {
        let tape = alloc_slice[a](json.tape_len(doc), 0);
        json.parse(doc, tape);
        test.assert_eq(json.to_int(doc, tape, json.get(doc, tape, 0, "café")), 1);
        test.assert_eq(json.to_int(doc, tape, json.get(doc, tape, 0, "a\nb")), 2);
        test.assert_eq(json.get(doc, tape, 0, "cafe"), 0 - 1);
    }
    return 0;
}

fn test_each_malformed_document_has_its_own_error() -> [] int {
    // 1 syntax, 2 end, 3 control, 4 escape, 5 number, 6 utf8, 7 depth, 8 full, 9 trailing
    test.assert_eq(error_of(""), 2);
    test.assert_eq(error_of("   "), 2);
    test.assert_eq(error_of("["), 2);
    test.assert_eq(error_of("[1"), 2);
    test.assert_eq(error_of("[1,"), 2);
    test.assert_eq(error_of("{\"a\""), 2);
    test.assert_eq(error_of("{\"a\":"), 2);
    test.assert_eq(error_of("\"abc"), 2);
    test.assert_eq(error_of("[1,]"), 1);
    test.assert_eq(error_of("{\"a\":1,}"), 1);
    test.assert_eq(error_of("{\"a\" 1}"), 1);
    test.assert_eq(error_of("{a:1}"), 1);
    test.assert_eq(error_of("{1:1}"), 1);
    test.assert_eq(error_of("[1 2]"), 1);
    test.assert_eq(error_of("tru"), 1);
    test.assert_eq(error_of("nul"), 1);
    test.assert_eq(error_of("'a'"), 1);
    test.assert_eq(error_of("NaN"), 1);
    test.assert_eq(error_of("Infinity"), 1);
    test.assert_eq(error_of("// c\n1"), 1);
    test.assert_eq(error_of("+1"), 1);
    test.assert_eq(error_of(".5"), 1);
    test.assert_eq(error_of("-"), 5);
    test.assert_eq(error_of("1."), 5);
    test.assert_eq(error_of("1e"), 5);
    test.assert_eq(error_of("1e+"), 5);
    test.assert_eq(error_of("-.5"), 5);
    test.assert_eq(error_of("\"a\tb\""), 3);
    test.assert_eq(error_of("\"\\x\""), 4);
    test.assert_eq(error_of("\"\\u12\""), 4);
    test.assert_eq(error_of("\"\\u12g4\""), 4);
    test.assert_eq(error_of("\"\\ud800\""), 4);
    test.assert_eq(error_of("\"\\udc00\""), 4);
    test.assert_eq(error_of("\"\\ud800x\""), 4);
    test.assert_eq(error_of("\"\\ud800\\u0041\""), 4);
    test.assert_eq(error_of("1 2"), 9);
    test.assert_eq(error_of("{} x"), 9);
    test.assert_eq(error_of("01"), 9);
    test.assert_eq(error_of("[0 1]"), 1);
    return 0;
}

fn test_the_error_position_is_where_it_went_wrong() -> [] int {
    test.assert_eq(position_of("[1,]"), 3);
    test.assert_eq(position_of("{\"a\":}"), 5);
    test.assert_eq(position_of("[1 2]"), 3);
    test.assert_eq(position_of("1 2"), 2);
    test.assert_eq(position_of("\"a\tb\""), 2);
    test.assert_eq(position_of("[true, nope]"), 7);
    test.assert_eq(position_of("[1,2"), 4);
    return 0;
}

fn test_unescaped_utf8_is_validated() -> [] int {
    // "é" is c3 a9; a lone continuation or a truncated sequence is refused.
    test.assert_eq(error_of("\"é\""), 0);
    test.assert_eq(error_of("\"日本語\""), 0);
    test.assert_eq(error_of("\"😀\""), 0);
    return 0;
}

fn test_invalid_utf8_bytes_are_refused[&h](heap: &!h Heap) -> [heap] int {
    // Bytes no literal can spell, built in a buffer.
    var b = buffer.empty(heap, 16);
    b = buffer.push(heap, b, byte_of('"'));
    b = buffer.push(heap, b, byte_of(0xc3));
    b = buffer.push(heap, b, byte_of('"'));
    var code = 0;
    borrow b as &r in {
        code = error_of(buffer.bytes(r));
    }
    buffer.drop(heap, b);
    test.assert_eq(code, 6);

    var overlong = buffer.empty(heap, 16);
    overlong = buffer.push(heap, overlong, byte_of('"'));
    overlong = buffer.push(heap, overlong, byte_of(0xc0));
    overlong = buffer.push(heap, overlong, byte_of(0x80));
    overlong = buffer.push(heap, overlong, byte_of('"'));
    var overlong_code = 0;
    borrow overlong as &r in {
        overlong_code = error_of(buffer.bytes(r));
    }
    buffer.drop(heap, overlong);
    test.assert_eq(overlong_code, 6);

    var surrogate = buffer.empty(heap, 16);
    surrogate = buffer.push(heap, surrogate, byte_of('"'));
    surrogate = buffer.push(heap, surrogate, byte_of(0xed));
    surrogate = buffer.push(heap, surrogate, byte_of(0xa0));
    surrogate = buffer.push(heap, surrogate, byte_of(0x80));
    surrogate = buffer.push(heap, surrogate, byte_of('"'));
    var surrogate_code = 0;
    borrow surrogate as &r in {
        surrogate_code = error_of(buffer.bytes(r));
    }
    buffer.drop(heap, surrogate);
    test.assert_eq(surrogate_code, 6);
    return 0;
}

fn test_nesting_is_limited_not_recursed_into() -> [] int {
    // 128 deep is allowed; 129 is a refusal, not a stack overflow.
    var deep = 0;
    region a {
        let ok = alloc_slice[a](300, byte_of('['));
        var i = 128;
        while i < 300 {
            ok[i] = byte_of(']');
            i = i + 1;
        }
        let short = ok[0..256];
        test.assert_eq(error_of(short), 0);
        let over = alloc_slice[a](400, byte_of('['));
        var j = 129;
        while j < 400 {
            over[j] = byte_of(']');
            j = j + 1;
        }
        deep = error_of(over[0..258]);
    }
    test.assert_eq(deep, 7);
    return 0;
}

fn test_a_tape_that_is_too_small_is_reported_not_overrun() -> [] int {
    let doc = "[1,2,3,4,5]";
    var code = 0;
    region a {
        let tape = alloc_slice[a](9, 0);
        code = json.error_code(json.parse(doc, tape));
    }
    test.assert_eq(code, 8);
    return 0;
}

fn test_strings_decode_to_utf8() -> [] int {
    let doc = "\"a\\n\\t\\\"\\\\\\/\\u00e9\\u65e5\\ud83d\\ude00z\"";
    region a {
        let tape = alloc_slice[a](json.tape_len(doc), 0);
        json.parse(doc, tape);
        test.assert(!json.string_plain(tape, 0));
        // a, newline, tab, quote, backslash, slash, e-acute (2), nichi (3), grinning face (4), z
        test.assert_eq(json.string_length(doc, tape, 0), 1 + 1 + 1 + 1 + 1 + 1 + 2 + 3 + 4 + 1);
        let out = alloc_slice[a](32, byte_of(0));
        let n = json.string_into(doc, tape, 0, out);
        test.assert_eq(n, 16);
        test.assert(bytes.equal(out[0..n], "a\n\t\"\\/é日😀z"));
        let tiny = alloc_slice[a](5, byte_of(0));
        test.assert_eq(json.string_into(doc, tape, 0, tiny), 0 - 1);
    }
    return 0;
}

fn test_a_plain_string_is_a_view_of_the_source() -> [] int {
    let doc = "[\"plain\",\"esc\\n\"]";
    region a {
        let tape = alloc_slice[a](json.tape_len(doc), 0);
        json.parse(doc, tape);
        let first = json.at(tape, 0, 0);
        let second = json.at(tape, 0, 1);
        test.assert(json.string_plain(tape, first));
        test.assert(!json.string_plain(tape, second));
        test.assert(bytes.equal(json.string_view(doc, tape, first), "plain"));
        test.assert_eq(len(json.string_view(doc, tape, 0)), 0);
    }
    return 0;
}

fn test_integers_saturate_and_say_so() -> [] int {
    let doc = "[0,-0,42,-42,9223372036854775807,-9223372036854775808,9223372036854775808,-9223372036854775809,99999999999999999999999,12.0,1e3]";
    let min = 0 - 9223372036854775807 - 1;
    region a {
        let tape = alloc_slice[a](json.tape_len(doc), 0);
        json.parse(doc, tape);
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 0)), 0);
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 1)), 0);
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 2)), 42);
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 3)), 0 - 42);
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 4)), 9223372036854775807);
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 5)), min);
        test.assert(json.fits_int(doc, tape, json.at(tape, 0, 4)));
        test.assert(json.fits_int(doc, tape, json.at(tape, 0, 5)));
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 6)), 9223372036854775807);
        test.assert(!json.fits_int(doc, tape, json.at(tape, 0, 6)));
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 7)), min);
        test.assert(!json.fits_int(doc, tape, json.at(tape, 0, 7)));
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 8)), 9223372036854775807);
        // A float node truncates toward zero; it is never an exact int.
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 9)), 12);
        test.assert(!json.fits_int(doc, tape, json.at(tape, 0, 9)));
        test.assert_eq(json.to_int(doc, tape, json.at(tape, 0, 10)), 1000);
    }
    return 0;
}

fn test_floats_are_read_correctly_rounded() -> [] int {
    let doc = "[0.1,0.2,0.3,1e22,1e23,5e-324,1.7976931348623157e308,1e309,-1e400,1e-400,9007199254740993,0.000001,123456789.123456789,2.2250738585072014e-308]";
    region a {
        let tape = alloc_slice[a](json.tape_len(doc), 0);
        json.parse(doc, tape);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 0)) == 0.1);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 1)) == 0.2);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 2)) == 0.3);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 3)) == 1.0e22);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 4)) == 1.0e23);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 5)) == 5.0e-324);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 6)) == 1.7976931348623157e308);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 7)) == 1.0 / 0.0);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 8)) == 0.0 - 1.0 / 0.0);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 9)) == 0.0);
        // 2^53 + 1 is halfway between two floats and goes to the even one.
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 10)) == 9007199254740992.0);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 11)) == 0.000001);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 12)) == 123456789.123456789);
        test.assert(json.to_float(doc, tape, json.at(tape, 0, 13)) == 2.2250738585072014e-308);
    }
    return 0;
}

fn test_negative_zero_keeps_its_sign() -> [] int {
    let doc = "[-0.0,0.0,-0]";
    region a {
        let tape = alloc_slice[a](json.tape_len(doc), 0);
        json.parse(doc, tape);
        test.assert_eq(bits_of(json.to_float(doc, tape, json.at(tape, 0, 0))), bits_of(0.0 * (0.0 - 1.0)));
        test.assert_eq(bits_of(json.to_float(doc, tape, json.at(tape, 0, 1))), 0);
        test.assert_eq(bits_of(json.to_float(doc, tape, json.at(tape, 0, 2))), bits_of(0.0 * (0.0 - 1.0)));
    }
    return 0;
}
