edition 7;
module tty_test;

// tty.cho -- `conformance/tty.rs` (deleted), in cancho (`docs/gate.md` G4): the serial-port verbs (docs/tty.md sections 3 and 5): a missing device is a value, a device that is not a terminal is refused by tcsetattr, a speed with no rate is EINVAL before the port is touched, and (Linux) a pseudo-terminal takes a standard rate and the speed and raw flags land on the line, read back with stty. tests/programs/tty_probe.cho opens a path under /dev and configures it; tty.sh prints the answers.
//
//     cancho build tests/commands/tty.cho tests/support/harness.cho --std -o EXE && EXE CANCHO [--compiler NAME] [--cache DIR]
//
// Run from the root of the repository. Prints `ok: tty` or what is wrong, and exits 0 or 1. One backend (LLVM) and one compiler: the Cranelift leg of the Rust test went with D2.

import std.buffer;
import std.io as console;
import harness;

fn run[&h, &i, &a, &x, &c, &f](heap: &!h Heap, io: &!i Io, args: &a Args, exec: &x Exec(""), clock: &c Clock, fs: &f Fs("")) -> [heap, io_write, err_write, args, exec(""), clock, poll, fs_read(""), file_read] int {
    if arg_count(args) < 2 {
        console.error_all(io, "usage: tty CANCHO [--compiler NAME] [--cache DIR]\n");
        return 2;
    }
    var report = harness.probe_transcript(heap, exec, clock, fs, arg(args, 1), harness.option(args, "--compiler"), harness.option(args, "--cache"), "tty", "tests/programs/tty_probe.cho", "tests/commands/tty.sh", "tests/commands/tty.expected", buffer.empty(heap, 64));
    var status = 0;
    borrow report as &rb in {
        if len(buffer.bytes(rb)) > 0 {
            console.error_all(io, buffer.bytes(rb));
            status = 1;
        } else {
            console.write_all(io, "ok: tty\n");
        }
    }
    buffer.drop(heap, report);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow exec as &x in {
                    borrow clock as &c in {
                        borrow fs as &f in {
                            status = run(h, i, a, x, c, f);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(args);
    release(heap);
    release(io);
    return status;
}
