edition 7;
module ecdh_test;

// ecdh.cho -- `conformance/ecdh.rs` (deleted), in cancho (`docs/gate.md` G4): `std.ecdh` (`docs/ecdh.md` section 4): every case of Wycheproof's P-256 and P-384 ECDH files with raw points, NIST CAVP's KAS validity cases for those curves, the scalar's edges, every refusal with its own tag (`tests/vectors/ecdh_cases.txt`), and `std.bigmod`'s powers at every limb boundary (`tests/vectors/bigmod_powers.txt`). All through `tests/programs/ecdh_driver.cho` and `bigmod_driver.cho`; the files are read line by line (`harness.cr_rows`), not as JSON.
//
//     cancho build tests/commands/ecdh.cho tests/support/harness.cho --std -o EXE && EXE CANCHO [--compiler NAME] [--cache DIR]
//
// Run from the root of the repository. Prints `ok: ecdh` or what is wrong, and exits 0 or 1. One backend (LLVM): the Cranelift legs went with D2.

import std.buffer;
import std.bytes;
import std.io as console;
import harness;

// `text` without its leading zero digits.
fn trimmed[&t](text: &t [byte]) -> [] &t [byte] {
    var at = 0;
    while at < len(text) && text[at] == byte_of('0') {
        at = at + 1;
    }
    return text[at..len(text)];
}

// Wycheproof's `ecdh_secp{256,384}r1_ecpoint_test.json`, every case: a valid one gives its shared secret (`0 ok SECRET`); an invalid one (a point off the curve, out of range, or badly encoded) is
// refused, with the tag the counts name. The one `acceptable` case of a file is a compressed point, refused: TLS 1.3 sends points uncompressed (RFC 8446 section 4.2.8.2).
fn wycheproof[&h, &x, &c, &f, &p, &t, &k](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), exe: &p [byte], report: buffer.Buffer, curve: int, path: &t [byte], total: int, valid: int, counts: &k [byte]) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    var acc = report;
    let harness.Contents { data, failed } = harness.read_file(heap, fs, path);
    if failed != 0 {
        acc = harness.failure(heap, acc, "ecdh", "wycheproof", "a Wycheproof file cannot be read", path);
    }
    var input = buffer.empty(heap, 1 << 17);
    var want = buffer.empty(heap, 1 << 17);
    var verdicts = buffer.empty(heap, 1 << 12);
    borrow data as &db in {
        let rows = harness.cr_rows(heap, buffer.bytes(db), "public private shared result");
        borrow rows as &rb in {
            let all = buffer.bytes(rb);
            var pos = 0;
            while pos < len(all) {
                let line = harness.cr_line_at(all, pos);
                pos = pos + len(line) + 1;
                input = buffer.append(heap, input, "S ");
                input = buffer.push_nat(heap, input, curve);
                input = buffer.push(heap, input, byte_of(' '));
                input = harness.cr_pad(heap, input, trimmed(harness.cr_cell_of(line, 2)), curve / 4);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.append(heap, input, harness.cr_cell_of(line, 1));
                input = buffer.push(heap, input, byte_of('\n'));
                let result = harness.cr_cell_of(line, 4);
                if bytes.equal(result, "valid") {
                    want = buffer.append(heap, want, "0 ok ");
                    want = buffer.append(heap, want, harness.cr_cell_of(line, 3));
                } else {
                    want = buffer.append(heap, want, "refused");
                }
                want = buffer.push(heap, want, byte_of('\n'));
                verdicts = buffer.push(heap, buffer.append(heap, verdicts, result), byte_of('\n'));
            }
        }
        buffer.drop(heap, rows);
    }
    buffer.drop(heap, data);
    borrow input as &ib in {
        if bytes.count_byte(buffer.bytes(ib), 10) != total {
            acc = harness.failure(heap, acc, "ecdh", "wycheproof", "the file has a different number of cases than recorded", path);
        }
        let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "ecdh", "wycheproof");
        acc = more;
        var got = buffer.empty(heap, 1 << 12);
        var tags = buffer.empty(heap, 1 << 12);
        borrow said as &sb in {
            let all = buffer.bytes(sb);
            var pos = 0;
            while pos < len(all) {
                let answer = harness.trim_end(harness.cr_line_at(all, pos));
                pos = pos + len(harness.cr_line_at(all, pos)) + 1;
                if len(answer) > 0 && answer[0] == byte_of('-') {
                    got = buffer.append(heap, got, "refused\n");
                    tags = buffer.push(heap, buffer.append(heap, tags, harness.cr_word(answer, 2)), byte_of('\n'));
                } else {
                    got = buffer.push(heap, buffer.append(heap, got, answer), byte_of('\n'));
                }
            }
        }
        borrow got as &gb in {
            borrow want as &wb in {
                acc = harness.cr_same(heap, acc, "ecdh", "wycheproof", buffer.bytes(gb), buffer.bytes(wb));
            }
        }
        borrow tags as &tb in {
            if len(buffer.bytes(tb)) > 0 {
                acc = harness.cr_counts(heap, acc, "ecdh", "wycheproof-refusals", buffer.bytes(tb), counts);
            }
        }
        borrow verdicts as &vb in {
            if harness.cr_count(buffer.bytes(vb), "valid") != valid {
                acc = harness.failure(heap, acc, "ecdh", "wycheproof", "the file has a different number of valid cases than recorded", path);
            }
        }
        buffer.drop(heap, tags);
        buffer.drop(heap, got);
        buffer.drop(heap, said);
    }
    buffer.drop(heap, input);
    buffer.drop(heap, want);
    buffer.drop(heap, verdicts);
    return acc;
}

// The reason in a CAVP result `F (5 - ...)`: the number after the parenthesis (-1 for a result that has none).
fn reason_of[&t](result: &t [byte]) -> [] int {
    if len(result) < 4 {
        return 0 - 1;
    }
    return harness.cr_number(result[3..len(result)]);
}

// The cases of the KAS validity file: `K CURVE dsIUT` and `S CURVE dsIUT 04 QsCAVSx QsCAVSy` for each, two lines to a case, the P-256 (`EC`) and P-384 (`ED`) sections only.
fn cavp_input[&h, &t](heap: &!h Heap, rows: &t [byte]) -> [heap] buffer.Buffer {
    var input = buffer.empty(heap, 1 << 15);
    var pos = 0;
    while pos < len(rows) {
        let line = harness.cr_line_at(rows, pos);
        pos = pos + len(line) + 1;
        let header = harness.cr_cell_of(line, 1);
        var curve = 0;
        if bytes.starts_with(header, "EC - ") {
            curve = 256;
        } else if bytes.starts_with(header, "ED - ") {
            curve = 384;
        }
        if curve != 0 {
            input = buffer.append(heap, input, "K ");
            input = buffer.push_nat(heap, input, curve);
            input = buffer.push(heap, input, byte_of(' '));
            input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 2)), byte_of('\n'));
            input = buffer.append(heap, input, "S ");
            input = buffer.push_nat(heap, input, curve);
            input = buffer.push(heap, input, byte_of(' '));
            input = buffer.append(heap, input, harness.cr_cell_of(line, 2));
            input = buffer.append(heap, input, " 04");
            input = buffer.append(heap, input, harness.cr_cell_of(line, 3));
            input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 4)), byte_of('\n'));
        }
    }
    return input;
}

// What one case comes to, as the check it is caught by: `want` and `got` each get a line.
fn cavp_case[&h, &l, &k, &z](heap: &!h Heap, want: buffer.Buffer, got: buffer.Buffer, line: &l [byte], key: &k [byte], z: &z [byte]) -> [heap] (buffer.Buffer, buffer.Buffer) {
    var w = want;
    var g = got;
    let result = harness.cr_cell_of(line, 8);
    let reason = reason_of(result);
    var iut = buffer.append(heap, buffer.empty(heap, 256), "0 ok 04");
    iut = buffer.append(heap, iut, harness.cr_cell_of(line, 5));
    iut = buffer.append(heap, iut, harness.cr_cell_of(line, 6));
    var secret = buffer.append(heap, buffer.empty(heap, 256), "0 ok ");
    secret = buffer.append(heap, secret, harness.cr_cell_of(line, 7));
    borrow iut as &ib in {
        borrow secret as &sb in {
            if result[0] == byte_of('P') {
                w = buffer.append(heap, w, "pass\n");
                if bytes.equal(key, buffer.bytes(ib)) && bytes.equal(z, buffer.bytes(sb)) {
                    g = buffer.append(heap, g, "pass\n");
                } else {
                    g = buffer.append(heap, g, "the key or Z differs from the file's\n");
                }
            } else if reason == 1 || reason == 2 {
                w = buffer.append(heap, w, "ecdh-point-not-on-curve\n");
                g = buffer.push(heap, buffer.append(heap, g, harness.cr_word(z, 2)), byte_of('\n'));
            } else if reason >= 5 && reason <= 7 {
                w = buffer.append(heap, w, "the key differs\n");
                if bytes.starts_with(key, "0 ok ") && !bytes.equal(key, buffer.bytes(ib)) {
                    g = buffer.append(heap, g, "the key differs\n");
                } else {
                    g = buffer.append(heap, g, "the key does not differ\n");
                }
            } else if reason == 8 {
                w = buffer.append(heap, w, "Z differs\n");
                if bytes.starts_with(z, "0 ok ") && !bytes.equal(z, buffer.bytes(sb)) {
                    g = buffer.append(heap, g, "Z differs\n");
                } else {
                    g = buffer.append(heap, g, "Z does not differ\n");
                }
            } else {
                w = buffer.append(heap, w, "a reason the test knows\n");
                g = buffer.append(heap, g, "an unexpected reason\n");
            }
        }
    }
    buffer.drop(heap, iut);
    buffer.drop(heap, secret);
    return (w, g);
}

// NIST CAVP's KAS validity test (static unified, Z only), its P-256 and P-384 sections (`tests/vectors/cavp/README.md`). For a case marked `P`, the IUT's public key is its private key times G (the
// answer to `K`), and Z is the private key times the CAVS's public key (the answer to `S`). Each `F` case is caught by the check its reason names: the CAVS's key refused as off the curve (1, 2); the
// IUT's public key not that of its private key (5, 6, 7); Z not the shared secret (8). 60 cases, 36 of them passing.
fn cavp[&h, &x, &c, &f, &p](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), exe: &p [byte], report: buffer.Buffer) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    var acc = report;
    let harness.Contents { data, failed } = harness.read_file(heap, fs, "tests/vectors/cavp/KASValidityTest_ECCStaticUnified_NOKC_ZZOnly_resp.fax");
    if failed != 0 {
        acc = harness.failure(heap, acc, "ecdh", "cavp", "the KAS validity file cannot be read", "");
    }
    var rows = buffer.empty(heap, 0);
    borrow data as &db in {
        buffer.drop(heap, rows);
        rows = harness.cr_rows(heap, buffer.bytes(db), "[ dsIUT QsCAVSx QsCAVSy QsIUTx QsIUTy Z Result");
    }
    buffer.drop(heap, data);
    var want = buffer.empty(heap, 1 << 12);
    var got = buffer.empty(heap, 1 << 12);
    var input = buffer.empty(heap, 0);
    borrow rows as &rb in {
        buffer.drop(heap, input);
        input = cavp_input(heap, buffer.bytes(rb));
    }
    borrow input as &ib in {
        if bytes.count_byte(buffer.bytes(ib), 10) != 120 {
            acc = harness.failure(heap, acc, "ecdh", "cavp", "the file should have 60 cases in P-256 and P-384", "");
        }
        let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "ecdh", "cavp");
        acc = more;
        borrow said as &sb in {
            borrow rows as &rb in {
                let all = buffer.bytes(rb);
                let answers = buffer.bytes(sb);
                var pos = 0;
                var apos = 0;
                var cases = 0;
                var passes = 0;
                while pos < len(all) && len(answers) > 0 {
                    let line = harness.cr_line_at(all, pos);
                    pos = pos + len(line) + 1;
                    let header = harness.cr_cell_of(line, 1);
                    if bytes.starts_with(header, "EC - ") || bytes.starts_with(header, "ED - ") {
                        let key = harness.trim_end(harness.cr_line_at(answers, apos));
                        apos = apos + len(harness.cr_line_at(answers, apos)) + 1;
                        let z = harness.trim_end(harness.cr_line_at(answers, apos));
                        apos = apos + len(harness.cr_line_at(answers, apos)) + 1;
                        let (w, g) = cavp_case(heap, want, got, line, key, z);
                        want = w;
                        got = g;
                        cases = cases + 1;
                        if harness.cr_cell_of(line, 8)[0] == byte_of('P') {
                            passes = passes + 1;
                        }
                    }
                }
                if cases != 60 || passes != 36 {
                    acc = harness.failure(heap, acc, "ecdh", "cavp", "the file should have 60 cases, 36 of them passing", "");
                }
            }
        }
        buffer.drop(heap, said);
    }
    borrow got as &gb in {
        borrow want as &wb in {
            acc = harness.cr_same(heap, acc, "ecdh", "cavp", buffer.bytes(gb), buffer.bytes(wb));
        }
    }
    buffer.drop(heap, got);
    buffer.drop(heap, want);
    buffer.drop(heap, input);
    buffer.drop(heap, rows);
    return acc;
}

// The scalar's edges (1 gives G, n - 1 gives -G, 0 and n are refused, on both curves) and every refusal the driver can reach, each with its own tag: `tests/vectors/ecdh_cases.txt`, `case | answer without its code`.
fn cases[&h, &x, &c, &f, &p](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), exe: &p [byte], report: buffer.Buffer) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    var acc = report;
    let harness.Contents { data, failed } = harness.read_file(heap, fs, "tests/vectors/ecdh_cases.txt");
    if failed != 0 {
        acc = harness.failure(heap, acc, "ecdh", "cases", "tests/vectors/ecdh_cases.txt cannot be read", "");
    }
    var input = buffer.empty(heap, 0);
    var want = buffer.empty(heap, 0);
    borrow data as &db in {
        buffer.drop(heap, input);
        buffer.drop(heap, want);
        input = harness.column(heap, buffer.bytes(db), 1);
        want = harness.column(heap, buffer.bytes(db), 2);
    }
    buffer.drop(heap, data);
    borrow input as &ib in {
        let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "ecdh", "cases");
        acc = more;
        var tail = buffer.empty(heap, 0);
        borrow said as &sb in {
            buffer.drop(heap, tail);
            tail = harness.cr_from(heap, buffer.bytes(sb), 2);
        }
        borrow tail as &tb in {
            borrow want as &wb in {
                acc = harness.cr_same(heap, acc, "ecdh", "cases", buffer.bytes(tb), buffer.bytes(wb));
            }
        }
        buffer.drop(heap, tail);
        buffer.drop(heap, said);
    }
    buffer.drop(heap, input);
    buffer.drop(heap, want);
    return acc;
}

// `std.bigmod`'s constant-time reduction (`docs/ecdh.md` section 2), through `pow_mod` at moduli whose length is a multiple of 30 or 64 bits, where a sum or a Montgomery product reaches the carry
// limb: `tests/vectors/bigmod_powers.txt`, 400 cases `n e a | answer`, each answered `0 answer`, through `tests/programs/bigmod_driver.cho`.
fn bigmod[&h, &x, &c, &f, &b, &e](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), bin: &b [byte], env: &e [byte], report: buffer.Buffer) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    let exe = "/tmp/cancho-ecdh-bigmod-driver";
    let (built, ok) = harness.cr_build(heap, exec, clock, bin, "tests/programs/bigmod_driver.cho\0", exe, env, report, "ecdh");
    var acc = built;
    if ok {
        let harness.Contents { data, failed } = harness.read_file(heap, fs, "tests/vectors/bigmod_powers.txt");
        if failed != 0 {
            acc = harness.failure(heap, acc, "ecdh", "bigmod", "tests/vectors/bigmod_powers.txt cannot be read", "");
        }
        var input = buffer.empty(heap, 0);
        var want = buffer.empty(heap, 0);
        borrow data as &db in {
            buffer.drop(heap, input);
            buffer.drop(heap, want);
            input = harness.column(heap, buffer.bytes(db), 1);
            want = harness.column(heap, buffer.bytes(db), 2);
        }
        buffer.drop(heap, data);
        borrow input as &ib in {
            if bytes.count_byte(buffer.bytes(ib), 10) != 400 {
                acc = harness.failure(heap, acc, "ecdh", "bigmod", "the file should have 400 cases", "");
            }
            let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "ecdh", "bigmod");
            acc = more;
            var tail = buffer.empty(heap, 0);
            borrow said as &sb in {
                buffer.drop(heap, tail);
                tail = harness.cr_from(heap, buffer.bytes(sb), 2);
            }
            borrow tail as &tb in {
                borrow want as &wb in {
                    acc = harness.cr_same(heap, acc, "ecdh", "bigmod", buffer.bytes(tb), buffer.bytes(wb));
                }
            }
            buffer.drop(heap, tail);
            buffer.drop(heap, said);
        }
        buffer.drop(heap, input);
        buffer.drop(heap, want);
    }
    return acc;
}

fn check[&h, &x, &c, &f, &b, &e](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), bin: &b [byte], env: &e [byte]) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    let exe = "/tmp/cancho-ecdh-driver";
    let (report, built) = harness.cr_build(heap, exec, clock, bin, "tests/programs/ecdh_driver.cho\0", exe, env, buffer.empty(heap, 64), "ecdh");
    var acc = report;
    if built {
        acc = wycheproof(heap, exec, clock, fs, exe, acc, 256, "tests/vectors/wycheproof/ecdh_secp256r1_ecpoint_test.json", 355, 330, "ecdh-point-encoding 9\necdh-point-not-on-curve 9\necdh-point-range 7\n");
        acc = wycheproof(heap, exec, clock, fs, exe, acc, 384, "tests/vectors/wycheproof/ecdh_secp384r1_ecpoint_test.json", 790, 771, "ecdh-point-encoding 3\necdh-point-not-on-curve 9\necdh-point-range 7\n");
        acc = cavp(heap, exec, clock, fs, exe, acc);
        acc = cases(heap, exec, clock, fs, exe, acc);
    }
    acc = bigmod(heap, exec, clock, fs, bin, env, acc);
    return acc;
}

fn run[&h, &i, &a, &x, &c, &f](heap: &!h Heap, io: &!i Io, args: &a Args, exec: &x Exec(""), clock: &c Clock, fs: &f Fs("")) -> [heap, io_write, err_write, args, exec(""), clock, poll, fs_read(""), file_read] int {
    if arg_count(args) < 2 {
        console.error_all(io, "usage: ecdh CANCHO [--compiler NAME] [--cache DIR]\n");
        return 2;
    }
    let env = harness.base_env(heap, harness.option(args, "--compiler"), harness.option(args, "--cache"));
    var report = buffer.empty(heap, 0);
    borrow env as &eb in {
        buffer.drop(heap, report);
        report = check(heap, exec, clock, fs, arg(args, 1), buffer.bytes(eb));
    }
    buffer.drop(heap, env);
    var status = 0;
    borrow report as &rb in {
        if len(buffer.bytes(rb)) > 0 {
            console.error_all(io, buffer.bytes(rb));
            status = 1;
        } else {
            console.write_all(io, "ok: ecdh\n");
        }
    }
    buffer.drop(heap, report);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow exec as &x in {
                    borrow clock as &c in {
                        borrow fs as &f in {
                            status = run(h, i, a, x, c, f);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(args);
    release(heap);
    release(io);
    return status;
}
