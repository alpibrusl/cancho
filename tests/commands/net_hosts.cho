edition 7;
module net_hosts_test;

// net_hosts.cho -- `conformance/net_hosts.rs` (deleted), in cancho (`docs/gate.md` G4): `docs/net-bounds.md` section 2.3, edition 10: the host half of a `Net` bound is matched exactly, or as `*.suffix` for
// one label. Before edition 10 it is a prefix (`127.0.0.1` admits `127.0.0.10`), and that is unchanged.
//
// The names are IP literals, so no resolver is asked: a name the bound admits is dialled (a refused connection is an answer, `Dialed::Failed`), and a name it does not admit traps (the program is
// killed by a signal). `*.0.0.1` stands for a one-label suffix because `127.0.0.1` is `127` ahead of `.0.0.1`. The program is `tests/programs/net_hosts_dialer.tmpl` with the edition, the bound and
// the name filled in.
//
//     cancho build tests/commands/net_hosts.cho tests/support/harness.cho --std -o EXE && EXE CANCHO [--compiler NAME] [--cache DIR]
//
// Run from the root of the repository. Prints `ok: net_hosts` or what is wrong, and exits 0 or 1. One backend (LLVM): the Cranelift leg of the Rust test, and its "the backends agree" check, went
// with D2.

import std.buffer;
import std.bytes;
import std.io as console;
import harness;

// One dial: the template filled for `edition`, `bound` and `name`, built and run; it is killed by a signal exactly when `trap`.
fn case[&h, &x, &c, &f, &b, &v, &d, &t, &e, &g, &n](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), bin: &b [byte], env: &v [byte], dir: &d [byte], template: &t [byte], edition: &e [byte], bound: &g [byte], name: &n [byte], trap: bool, report: buffer.Buffer) -> [heap, exec(""), clock, poll, fs_write("")] buffer.Buffer {
    var rep = report;
    var label = buffer.append(heap, buffer.empty(heap, 64), "edition ");
    label = buffer.append(heap, label, edition);
    label = buffer.append(heap, label, " bound ");
    label = buffer.append(heap, label, bound);
    label = buffer.append(heap, label, " name ");
    label = buffer.append(heap, label, name);
    let source = harness.fill(heap, template, edition, bound, name, "");
    borrow label as &lb in {
        borrow source as &sb in {
            let harness.Ended { out, err, kind, code } = harness.build_text(heap, exec, clock, fs, bin, env, dir, "dial", buffer.bytes(sb), "");
            if kind != 0 {
                borrow err as &rb in {
                    rep = harness.failure(heap, rep, "net_hosts", buffer.bytes(lb), "should build, but the compiler said", buffer.bytes(rb));
                }
            } else {
                var exe = harness.joined(heap, dir, "dial");
                borrow exe as &eb in {
                    let k2 = harness.exit_kind(heap, exec, clock, buffer.bytes(eb));
                    if trap && k2 != 1 {
                        rep = harness.failure(heap, rep, "net_hosts", buffer.bytes(lb), "the bound should refuse this name (the program is killed by a signal)", "");
                    } else if !trap && k2 != 0 {
                        rep = harness.failure(heap, rep, "net_hosts", buffer.bytes(lb), "the bound should admit this name (the dial runs through)", "");
                    }
                }
                buffer.drop(heap, exe);
            }
            buffer.drop(heap, out);
            buffer.drop(heap, err);
        }
    }
    buffer.drop(heap, source);
    buffer.drop(heap, label);
    return rep;
}

fn cases[&h, &x, &c, &f, &b, &v, &d, &t](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), bin: &b [byte], env: &v [byte], dir: &d [byte], t: &t [byte]) -> [heap, exec(""), clock, poll, fs_write("")] buffer.Buffer {
    var r = buffer.empty(heap, 64);
    // Before edition 10 a host bound is a prefix: `127.0.0.1` admits `127.0.0.10`, the defect edition 10 closes.
    r = case(heap, exec, clock, fs, bin, env, dir, t, "9", "127.0.0.1:9", "127.0.0.10", false, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "9", "127.0.0.1:9", "127.0.0.1", false, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "9", "127.0.0.1:9", "127.0.0.2", true, r);
    // From edition 10 it is exact: a longer name is a different host, and so is a shorter one.
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "127.0.0.1:9", "127.0.0.1", false, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "127.0.0.1:9", "127.0.0.10", true, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "127.0.0.1:9", "127.0.0.", true, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "127.0.0.1:9", "127.0.0.2", true, r);
    // A wildcard is exactly one label ahead of its suffix.
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "*.0.0.1:9", "127.0.0.1", false, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "*.0.0.1:9", "7.0.0.1", false, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "*.0.0.1:9", "5.127.0.0.1", true, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "*.0.0.1:9", ".0.0.1", true, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "*.0.0.1:9", "0.0.1", true, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "*.0.0.1:9", "127.0.0.2", true, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", "*.0.0.1:9", "127.0.0.10", true, r);
    // An empty host half still admits every name, in every edition.
    r = case(heap, exec, clock, fs, bin, env, dir, t, "9", ":9", "127.0.0.1", false, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "9", ":9", "127.0.0.10", false, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", ":9", "127.0.0.1", false, r);
    r = case(heap, exec, clock, fs, bin, env, dir, t, "10", ":9", "127.0.0.10", false, r);
    return r;
}

fn check[&h, &x, &c, &f, &b, &m, &k](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), bin: &b [byte], compiler: &m [byte], cache: &k [byte]) -> [heap, exec(""), clock, poll, fs_read(""), file_read, fs_write("")] buffer.Buffer {
    let env = harness.base_env(heap, compiler, cache);
    var report = buffer.empty(heap, 64);
    let dir = harness.scratch_dir(heap, exec, clock, "cancho-net-hosts");
    let harness.Contents { data, failed } = harness.read_file(heap, fs, "tests/programs/net_hosts_dialer.tmpl");
    borrow dir as &db in {
        borrow env as &eb in {
            borrow data as &tb in {
                if len(buffer.bytes(db)) == 0 || failed != 0 {
                    report = harness.failure(heap, report, "net_hosts", "setup", "should make a scratch directory and read the template", "");
                } else {
                    buffer.drop(heap, report);
                    report = cases(heap, exec, clock, fs, bin, buffer.bytes(eb), buffer.bytes(db), buffer.bytes(tb));
                }
            }
        }
        if len(buffer.bytes(db)) > 0 {
            harness.remove_tree(heap, exec, clock, buffer.bytes(db));
        }
    }
    buffer.drop(heap, data);
    buffer.drop(heap, dir);
    buffer.drop(heap, env);
    return report;
}

fn run[&h, &i, &a, &x, &c, &f](heap: &!h Heap, io: &!i Io, args: &a Args, exec: &x Exec(""), clock: &c Clock, fs: &f Fs("")) -> [heap, io_write, err_write, args, exec(""), clock, poll, fs_read(""), file_read, fs_write("")] int {
    if arg_count(args) < 2 {
        console.error_all(io, "usage: net_hosts CANCHO [--compiler NAME] [--cache DIR]\n");
        return 2;
    }
    let report = check(heap, exec, clock, fs, arg(args, 1), harness.option(args, "--compiler"), harness.option(args, "--cache"));
    var status = 0;
    borrow report as &rb in {
        if len(buffer.bytes(rb)) > 0 {
            console.error_all(io, buffer.bytes(rb));
            status = 1;
        } else {
            console.write_all(io, "ok: net_hosts\n");
        }
    }
    buffer.drop(heap, report);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow exec as &x in {
                    borrow clock as &c in {
                        borrow fs as &f in {
                            status = run(h, i, a, x, c, f);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(args);
    release(heap);
    release(io);
    return status;
}
