edition 7;
module directory_modes_test;

// directory_modes.cho -- `conformance/directory_modes.rs` (deleted), in cancho (`docs/gate.md` G4): permission bits beneath a directory (`docs/directory-listing.md` section 3.5, issue #243): `dir_mode` on one component and `dir_own_mode` on the opened directory itself, edition 7. The probe
// `tests/programs/directory_modes_probe.cho` prints the directory's own bits and each name's (nine read/write/execute bits, set-user-id, sticky, a directory, a symbolic link, a missing name and two that are not one component); `directory_modes.sh` makes the tree and prints what
// the probe said and what is on disk; `directory_modes.expected` is what that must be.
//
//     cancho build tests/commands/directory_modes.cho tests/support/harness.cho --std -o EXE && EXE CANCHO [--compiler NAME] [--cache DIR]
//
// Run from the root of the repository. Prints `ok: directory_modes` or what is wrong, and exits 0 or 1. One backend (LLVM) and one compiler: the Cranelift leg of the Rust test went with D2.

import std.buffer;
import std.io as console;
import harness;

fn run[&h, &i, &a, &x, &c, &f](heap: &!h Heap, io: &!i Io, args: &a Args, exec: &x Exec(""), clock: &c Clock, fs: &f Fs("")) -> [heap, io_write, err_write, args, exec(""), clock, poll, fs_read(""), file_read] int {
    if arg_count(args) < 2 {
        console.error_all(io, "usage: directory_modes CANCHO [--compiler NAME] [--cache DIR]\n");
        return 2;
    }
    let report = harness.probe_transcript(heap, exec, clock, fs, arg(args, 1), harness.option(args, "--compiler"), harness.option(args, "--cache"), "directory_modes", "tests/programs/directory_modes_probe.cho", "tests/commands/directory_modes.sh", "tests/commands/directory_modes.expected", buffer.empty(heap, 64));
    var status = 0;
    borrow report as &rb in {
        if len(buffer.bytes(rb)) > 0 {
            console.error_all(io, buffer.bytes(rb));
            status = 1;
        } else {
            console.write_all(io, "ok: directory_modes\n");
        }
    }
    buffer.drop(heap, report);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow exec as &x in {
                    borrow clock as &c in {
                        borrow fs as &f in {
                            status = run(h, i, a, x, c, f);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(args);
    release(heap);
    release(io);
    return status;
}
