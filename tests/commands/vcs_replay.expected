ok a_declaration_goes_into_a_file_the_branch_changed_too
| {
|   "command": "replay",
|   "ok": false,
|   "refused": {
|     "base": "pub fn twice(n: int) -> [] int {\n    return n + n;\n}",
|     "change": "pub fn twice(n: int) -> [] int {\n    return n * 2;\n}",
|     "declaration": "fn a.twice",
|     "intent": {
|       "model": "m1",
|       "prompt": "twice by multiplying",
|       "session": "s1"
|     },
|     "message": "the branch changed this declaration too",
|     "onto": "pub fn twice(n: int) -> [] int {\n    return n << 1;\n}",
|     "path": "a.cho",
|     "tag": "replay-conflict"
|   }
| }
ok a_declaration_the_branch_changed_too_is_a_conflict_with_both_bodies
