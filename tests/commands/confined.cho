edition 7;
module confined_test;

// confined.cho -- `dirs.confined.open_file` (`packages/confined`) (`docs/directory-nlink.md`): a file is opened beneath a directory handle following no link, and a file with more than one
// name is refused. `tests/programs/confined_probe.cho` prints `NAME opened` or `NAME err ERRNO`; `confined.sh` makes a tree with a file that has two names, at the top
// and in a subdirectory; `confined.expected` is what the probe must print.
//
//     cancho build tests/commands/confined.cho tests/support/harness.cho --std -o EXE && EXE CANCHO [--compiler NAME] [--cache DIR]
//
// Run from the root of the repository. Prints `ok: confined` or what is wrong, and exits 0 or 1. One backend (LLVM) and one compiler: the compiler in cancho.

import std.buffer;
import std.io as console;
import harness;

fn run[&h, &i, &a, &x, &c, &f](heap: &!h Heap, io: &!i Io, args: &a Args, exec: &x Exec(""), clock: &c Clock, fs: &f Fs("")) -> [heap, io_write, err_write, args, exec(""), clock, poll, fs_read(""), file_read] int {
    if arg_count(args) < 2 {
        console.error_all(io, "usage: confined CANCHO [--compiler NAME] [--cache DIR]\n");
        return 2;
    }
    let report = harness.probe_transcript(heap, exec, clock, fs, arg(args, 1), harness.option(args, "--compiler"), harness.option(args, "--cache"), "confined", "tests/programs/confined_probe.cho\0packages/confined/confined.cho", "tests/commands/confined.sh", "tests/commands/confined.expected", buffer.empty(heap, 64));
    var status = 0;
    borrow report as &rb in {
        if len(buffer.bytes(rb)) > 0 {
            console.error_all(io, buffer.bytes(rb));
            status = 1;
        } else {
            console.write_all(io, "ok: confined\n");
        }
    }
    buffer.drop(heap, report);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow exec as &x in {
                    borrow clock as &c in {
                        borrow fs as &f in {
                            status = run(h, i, a, x, c, f);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(args);
    release(heap);
    release(io);
    return status;
}
