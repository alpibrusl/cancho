== a refusal before the body sends no 100, and the faults are refused with their rules
< HTTP/1.1 413 Content Too Large
< Content-Type: application/json
< Content-Length: 19
< Connection: keep-alive
= {"error":"refused"}
< HTTP/1.1 200 OK
< Content-Type: text/plain
< Content-Length: 7
< Connection: keep-alive
= n=0 c=0
< HTTP/1.1 413 Content Too Large
< Content-Type: application/json
< Content-Length: 19
< Connection: keep-alive
ends 2: yes
< HTTP/1.1 413 Content Too Large
< Content-Type: application/json
< Content-Length: 34
< Connection: close
< X-Rule: body.too-large
= {"error":"request body too large"}
ends 3: yes
< HTTP/1.1 417 Expectation Failed
< Content-Type: application/json
< Content-Length: 30
< Connection: close
< X-Rule: expect.unsupported
= {"error":"expectation failed"}
< HTTP/1.1 400 Bad Request
< Content-Type: application/json
< Content-Length: 26
< Connection: close
< X-Rule: body.chunk-size
= {"error":"bad chunk size"}
ends 1: yes
< HTTP/1.1 400 Bad Request
< Content-Type: application/json
< Content-Length: 29
< Connection: close
< X-Rule: body.chunk-framing
= {"error":"bad chunk framing"}
ends 1: yes
< HTTP/1.1 400 Bad Request
< Content-Type: application/json
< Content-Length: 29
< Connection: close
< X-Rule: body.trailer
= {"error":"bad chunk trailer"}
ends 1: yes
< HTTP/1.1 413 Content Too Large
< Content-Type: application/json
< Content-Length: 34
< Connection: close
< X-Rule: body.too-large
= {"error":"request body too large"}
ends 1: yes
< HTTP/1.1 200 OK
< Content-Type: text/plain
< Content-Length: 5
< Connection: keep-alive
= early
ends 1: yes
< HTTP/1.1 200 OK
< Content-Type: text/plain
< Content-Length: 7
< Connection: keep-alive
= n=0 c=0
