edition 7;
module directory_links_test;

// directory_links.cho -- slice 2 of `docs/directory-links.md`: `dir_symlink` and `dir_readlink` (section 4), edition 12. The probe
// `tests/programs/directory_links_probe.cho` makes and reads the links it is told to and prints `ok`, `ok N TEXT` or `err ERRNO`; `directory_links.sh` runs it under `umask 022` against a tree it makes and prints what
// the probe said and what is on disk; `directory_links.expected` is what that must be.
//
//     cancho build tests/commands/directory_links.cho tests/support/harness.cho --std -o EXE && EXE CANCHO [--compiler NAME] [--cache DIR]
//
// Run from the root of the repository. Prints `ok: directory_links` or what is wrong, and exits 0 or 1. One backend (LLVM) and one compiler: no Cranelift leg (D2).

import std.buffer;
import std.io as console;
import harness;

fn run[&h, &i, &a, &x, &c, &f](heap: &!h Heap, io: &!i Io, args: &a Args, exec: &x Exec(""), clock: &c Clock, fs: &f Fs("")) -> [heap, io_write, err_write, args, exec(""), clock, poll, fs_read(""), file_read] int {
    if arg_count(args) < 2 {
        console.error_all(io, "usage: directory_links CANCHO [--compiler NAME] [--cache DIR]\n");
        return 2;
    }
    let report = harness.probe_transcript(heap, exec, clock, fs, arg(args, 1), harness.option(args, "--compiler"), harness.option(args, "--cache"), "directory_links", "tests/programs/directory_links_probe.cho", "tests/commands/directory_links.sh", "tests/commands/directory_links.expected", buffer.empty(heap, 64));
    var status = 0;
    borrow report as &rb in {
        if len(buffer.bytes(rb)) > 0 {
            console.error_all(io, buffer.bytes(rb));
            status = 1;
        } else {
            console.write_all(io, "ok: directory_links\n");
        }
    }
    buffer.drop(heap, report);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow exec as &x in {
                    borrow clock as &c in {
                        borrow fs as &f in {
                            status = run(h, i, a, x, c, f);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(args);
    release(heap);
    release(io);
    return status;
}
