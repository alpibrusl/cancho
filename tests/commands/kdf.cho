edition 7;
module kdf_test;

// kdf.cho -- `conformance/kdf.rs` (deleted), in cancho (`docs/gate.md` G4): `std.crypto`'s SHA-2 family, `std.hmac` and `std.hkdf` (`docs/hkdf.md` section 4): the HMAC, HKDF and TLS 1.3 key-schedule vectors, every case of the byte-oriented CAVP SHA-2 files, a message past 64 KiB and pieces that straddle every block boundary, every Wycheproof HMAC and HKDF case, every refusal with its own tag, and a prepared key giving what the key gives. All through `tests/programs/kdf_driver.cho`; the files are read line by line (`harness.cr_rows`), not as JSON.
//
//     cancho build tests/commands/kdf.cho tests/support/harness.cho --std -o EXE && EXE CANCHO [--compiler NAME] [--cache DIR]
//
// Run from the root of the repository. Prints `ok: kdf` or what is wrong, and exits 0 or 1. One backend (LLVM): the Cranelift legs went with D2.

import std.buffer;
import std.bytes;
import std.io as console;
import harness;

// The cases of the byte-oriented CAVP files `Len = n / Msg = hex / MD = hex`: `H alg msg` for each, and `0 ok MD` for what it should answer (a message of length 0 is empty whatever the file's `Msg`).
fn sha_file[&h, &t](heap: &!h Heap, text: &t [byte], alg: int, inputs: buffer.Buffer, wants: buffer.Buffer) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var input = inputs;
    var want = wants;
    var n = 0;
    let rows = harness.cr_rows(heap, text, "Len Msg MD");
    borrow rows as &rb in {
        let all = buffer.bytes(rb);
        var pos = 0;
        while pos < len(all) {
            let line = harness.cr_line_at(all, pos);
            pos = pos + len(line) + 1;
            input = buffer.append(heap, input, "H ");
            input = buffer.push_nat(heap, input, alg);
            input = buffer.push(heap, input, byte_of(' '));
            if bytes.equal(harness.cr_cell_of(line, 1), "0") {
                input = buffer.push(heap, input, byte_of('-'));
            } else {
                input = buffer.append(heap, input, harness.cr_cell_of(line, 2));
            }
            input = buffer.push(heap, input, byte_of('\n'));
            want = buffer.push(heap, buffer.append(heap, buffer.append(heap, want, "0 ok "), harness.cr_cell_of(line, 3)), byte_of('\n'));
            n = n + 1;
        }
    }
    buffer.drop(heap, rows);
    return (input, want, n);
}

// The Monte Carlo test of a CAVP file: `C alg seed`, answered with the 100 checkpoints, joined by commas.
fn monte_file[&h, &t](heap: &!h Heap, text: &t [byte], alg: int, inputs: buffer.Buffer, wants: buffer.Buffer) -> [heap] (buffer.Buffer, buffer.Buffer, int) {
    var input = inputs;
    var want = wants;
    var n = 0;
    let rows = harness.cr_rows(heap, text, "Seed MD");
    borrow rows as &rb in {
        let all = buffer.bytes(rb);
        var pos = 0;
        while pos < len(all) {
            let line = harness.cr_line_at(all, pos);
            pos = pos + len(line) + 1;
            if n == 0 {
                input = buffer.append(heap, input, "C ");
                input = buffer.push_nat(heap, input, alg);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 1)), byte_of('\n'));
                want = buffer.append(heap, want, "0 ok ");
            } else {
                want = buffer.push(heap, want, byte_of(','));
            }
            want = buffer.append(heap, want, harness.cr_cell_of(line, 2));
            n = n + 1;
        }
    }
    want = buffer.push(heap, want, byte_of('\n'));
    buffer.drop(heap, rows);
    return (input, want, n);
}

// Every case of the byte-oriented CAVP response files: short and long messages, and the Monte Carlo test's 100 checkpoints. 65 short and 64 long messages for SHA-256, 129 and 128 for SHA-384 and
// SHA-512's short file: the counts `docs/hkdf.md` section 4.1 states.
fn cavp[&h, &x, &c, &f, &p](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), exe: &p [byte], report: buffer.Buffer) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    var acc = report;
    var input = buffer.empty(heap, 1 << 20);
    var want = buffer.empty(heap, 1 << 20);
    var file = 1;
    while file <= 8 {
        var path = buffer.append(heap, buffer.empty(heap, 96), "tests/vectors/cavp/");
        path = buffer.append(heap, path, bytes.field("SHA256ShortMsg SHA256LongMsg SHA384ShortMsg SHA384LongMsg SHA512ShortMsg SHA256Monte SHA384Monte SHA512Monte", 32, file));
        path = buffer.append(heap, path, ".rsp");
        var alg = 256;
        if file == 3 || file == 4 || file == 7 {
            alg = 384;
        } else if file == 5 || file == 8 {
            alg = 512;
        }
        borrow path as &pb in {
            let harness.Contents { data, failed } = harness.read_file(heap, fs, buffer.bytes(pb));
            if failed != 0 {
                acc = harness.failure(heap, acc, "kdf", "cavp", "a CAVP file cannot be read", buffer.bytes(pb));
            }
            borrow data as &db in {
                var cases = 0;
                var expected = 100;
                if file <= 5 {
                    let (i, w, n) = sha_file(heap, buffer.bytes(db), alg, input, want);
                    input = i;
                    want = w;
                    cases = n;
                    if file == 1 {
                        expected = 65;
                    } else if file == 2 {
                        expected = 64;
                    } else if file == 3 || file == 5 {
                        expected = 129;
                    } else {
                        expected = 128;
                    }
                } else {
                    let (i, w, n) = monte_file(heap, buffer.bytes(db), alg, input, want);
                    input = i;
                    want = w;
                    cases = n;
                }
                if cases != expected {
                    acc = harness.failure(heap, acc, "kdf", "cavp", "a CAVP file has a different number of cases than the document states", buffer.bytes(pb));
                }
            }
            buffer.drop(heap, data);
        }
        buffer.drop(heap, path);
        file = file + 1;
    }
    borrow input as &ib in {
        let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "kdf", "cavp");
        acc = more;
        borrow said as &sb in {
            borrow want as &wb in {
                acc = harness.cr_same(heap, acc, "kdf", "cavp", buffer.bytes(sb), buffer.bytes(wb));
            }
        }
        buffer.drop(heap, said);
    }
    buffer.drop(heap, input);
    buffer.drop(heap, want);
    return acc;
}

// Every length from 0 to 300 bytes, one-shot and in pieces of 1, 7, 63, 64, 65, 127, 128 and 129: the streamed digest must be the one-shot one, whatever the boundaries. 3 hashes * 301 lengths * 9
// cases, the message of `n` bytes being the bytes `(i * 131 + n) % 256`.
fn pieces[&h, &x, &c, &p](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, exe: &p [byte], report: buffer.Buffer) -> [heap, exec(""), clock, poll] buffer.Buffer {
    var acc = report;
    var input = buffer.empty(heap, 1 << 22);
    var alg_at = 1;
    while alg_at <= 3 {
        var alg = 256;
        if alg_at == 2 {
            alg = 384;
        } else if alg_at == 3 {
            alg = 512;
        }
        var n = 0;
        while n <= 300 {
            var msg = buffer.empty(heap, 2 * n + 1);
            var i = 0;
            while i < n {
                msg = harness.cr_hex_byte(heap, msg, (i * 131 + n) % 256);
                i = i + 1;
            }
            if n == 0 {
                msg = buffer.push(heap, msg, byte_of('-'));
            }
            borrow msg as &mb in {
                input = buffer.append(heap, input, "H ");
                input = buffer.push(heap, buffer.push_nat(heap, input, alg), byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, buffer.bytes(mb)), byte_of('\n'));
                var piece_at = 1;
                while piece_at <= 8 {
                    let piece = harness.cr_word("1 7 63 64 65 127 128 129", piece_at);
                    input = buffer.append(heap, input, "U ");
                    input = buffer.push(heap, buffer.push_nat(heap, input, alg), byte_of(' '));
                    input = buffer.push(heap, buffer.append(heap, input, piece), byte_of(' '));
                    input = buffer.push(heap, buffer.append(heap, input, buffer.bytes(mb)), byte_of('\n'));
                    piece_at = piece_at + 1;
                }
            }
            buffer.drop(heap, msg);
            n = n + 1;
        }
        alg_at = alg_at + 1;
    }
    borrow input as &ib in {
        let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "kdf", "pieces");
        acc = more;
        var got = buffer.empty(heap, 1 << 12);
        borrow said as &sb in {
            let answers = buffer.bytes(sb);
            var apos = 0;
            var base = answers[0..0];
            var k = 0;
            while apos < len(answers) {
                let answer = harness.trim_end(harness.cr_line_at(answers, apos));
                apos = apos + len(harness.cr_line_at(answers, apos)) + 1;
                if k % 9 == 0 {
                    base = answer;
                    got = harness.cr_expect(heap, got, bytes.starts_with(answer, "0 ok"), answer);
                } else {
                    got = harness.cr_expect(heap, got, bytes.equal(answer, base), answer);
                }
                k = k + 1;
            }
            if k != 3 * 301 * 9 {
                acc = harness.failure(heap, acc, "kdf", "pieces", "should have 3 * 301 * 9 answers", "");
            }
        }
        borrow got as &gb in {
            acc = harness.cr_all_ok(heap, acc, "kdf", "pieces", buffer.bytes(gb));
        }
        buffer.drop(heap, got);
        buffer.drop(heap, said);
    }
    buffer.drop(heap, input);
    return acc;
}

// Wycheproof's HMAC-SHA256/384 and HKDF-SHA256/384 files, every case. A truncated tag is compared with the front of the full one; a modified tag must differ from it; an output size over
// `255 * hash_len` must be refused with `hkdf-length-too-large`. `valid` and `invalid` are the numbers of cases of each kind the file has.
fn wycheproof_file[&h, &x, &c, &f, &p, &t](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), exe: &p [byte], report: buffer.Buffer, path: &t [byte], hl: int, hmac: bool, valid: int, invalid: int) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    var acc = report;
    let harness.Contents { data, failed } = harness.read_file(heap, fs, path);
    if failed != 0 {
        acc = harness.failure(heap, acc, "kdf", "wycheproof", "a Wycheproof file cannot be read", path);
    }
    var input = buffer.empty(heap, 1 << 17);
    var verdicts = buffer.empty(heap, 1 << 12);
    var shapes = buffer.empty(heap, 1 << 12);
    var rows = buffer.empty(heap, 0);
    borrow data as &db in {
        buffer.drop(heap, rows);
        if hmac {
            rows = harness.cr_rows(heap, buffer.bytes(db), "key msg tag result");
        } else {
            rows = harness.cr_rows(heap, buffer.bytes(db), "ikm salt info size okm result");
        }
    }
    buffer.drop(heap, data);
    borrow rows as &rb in {
        let all = buffer.bytes(rb);
        var pos = 0;
        while pos < len(all) {
            let line = harness.cr_line_at(all, pos);
            pos = pos + len(line) + 1;
            if hmac {
                input = buffer.append(heap, input, "M ");
                input = buffer.push_nat(heap, input, hl);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.push_nat(heap, input, hl);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 1)), byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 2)), byte_of('\n'));
                verdicts = buffer.push(heap, buffer.append(heap, verdicts, harness.cr_cell_of(line, 4)), byte_of('\n'));
                shapes = buffer.push(heap, buffer.append(heap, shapes, harness.cr_undash(harness.cr_cell_of(line, 3))), byte_of('\n'));
            } else {
                input = buffer.append(heap, input, "K ");
                input = buffer.push_nat(heap, input, hl);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 2)), byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 1)), byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 3)), byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 4)), byte_of('\n'));
                verdicts = buffer.push(heap, buffer.append(heap, verdicts, harness.cr_cell_of(line, 6)), byte_of('\n'));
                shapes = buffer.push(heap, buffer.append(heap, shapes, harness.cr_undash(harness.cr_cell_of(line, 5))), byte_of('\n'));
            }
        }
    }
    buffer.drop(heap, rows);
    borrow input as &ib in {
        let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "kdf", "wycheproof");
        acc = more;
        var got = buffer.empty(heap, 1 << 12);
        borrow said as &sb in {
            borrow verdicts as &vb in {
                borrow shapes as &hb in {
                    let answers = buffer.bytes(sb);
                    var apos = 0;
                    var vpos = 0;
                    var hpos = 0;
                    while apos < len(answers) {
                        let answer = harness.trim_end(harness.cr_line_at(answers, apos));
                        apos = apos + len(harness.cr_line_at(answers, apos)) + 1;
                        let verdict = harness.cr_line_at(buffer.bytes(vb), vpos);
                        vpos = vpos + len(verdict) + 1;
                        let shape = harness.cr_line_at(buffer.bytes(hb), hpos);
                        hpos = hpos + len(shape) + 1;
                        let valid_case = bytes.equal(verdict, "valid");
                        if hmac {
                            got = harness.cr_expect(heap, got, bytes.equal(harness.cr_word(answer, 1), "0") && bytes.starts_with(harness.cr_word(answer, 3), shape) == valid_case, answer);
                        } else if valid_case {
                            var want = buffer.append(heap, buffer.empty(heap, 256), "0 ok ");
                            want = buffer.append(heap, want, shape);
                            borrow want as &wb in {
                                got = harness.cr_expect(heap, got, bytes.equal(answer, buffer.bytes(wb)), answer);
                            }
                            buffer.drop(heap, want);
                        } else {
                            got = harness.cr_expect(heap, got, bytes.equal(harness.cr_word(answer, 2), "hkdf-length-too-large"), answer);
                        }
                    }
                }
                if harness.cr_count(buffer.bytes(vb), "valid") != valid || bytes.count_byte(buffer.bytes(vb), 10) != valid + invalid {
                    acc = harness.failure(heap, acc, "kdf", "wycheproof", "the file has a different number of valid and invalid cases than recorded", path);
                }
            }
        }
        borrow got as &gb in {
            acc = harness.cr_all_ok(heap, acc, "kdf", "wycheproof", buffer.bytes(gb));
        }
        buffer.drop(heap, got);
        buffer.drop(heap, said);
    }
    buffer.drop(heap, input);
    buffer.drop(heap, verdicts);
    buffer.drop(heap, shapes);
    return acc;
}

// A refusal table `case | tag`: each case is refused with its own tag and writes nothing (its output is all zeros), and a case whose tag is `ok` is answered `0`.
fn refusals[&h, &x, &c, &f, &p, &t, &n](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), exe: &p [byte], report: buffer.Buffer, path: &t [byte], name: &n [byte]) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    var acc = report;
    let harness.Contents { data, failed } = harness.read_file(heap, fs, path);
    if failed != 0 {
        acc = harness.failure(heap, acc, "kdf", name, "a vector file cannot be read", path);
    }
    var input = buffer.empty(heap, 0);
    var want = buffer.empty(heap, 0);
    borrow data as &db in {
        buffer.drop(heap, input);
        buffer.drop(heap, want);
        input = harness.column(heap, buffer.bytes(db), 1);
        want = harness.column(heap, buffer.bytes(db), 2);
    }
    buffer.drop(heap, data);
    borrow input as &ib in {
        let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "kdf", name);
        acc = more;
        var got = buffer.empty(heap, 1 << 10);
        borrow said as &sb in {
            borrow want as &wb in {
                let answers = buffer.bytes(sb);
                let tags = buffer.bytes(wb);
                var apos = 0;
                var tpos = 0;
                while apos < len(answers) {
                    let answer = harness.trim_end(harness.cr_line_at(answers, apos));
                    apos = apos + len(harness.cr_line_at(answers, apos)) + 1;
                    let tag = harness.cr_line_at(tags, tpos);
                    tpos = tpos + len(tag) + 1;
                    if bytes.equal(tag, "ok") {
                        got = harness.cr_expect(heap, got, bytes.equal(harness.cr_word(answer, 1), "0"), answer);
                    } else {
                        got = harness.cr_expect(heap, got, answer[0] == byte_of('-') && bytes.equal(harness.cr_word(answer, 2), tag) && harness.cr_zeros(harness.cr_word(answer, 3)), answer);
                    }
                }
            }
        }
        borrow got as &gb in {
            acc = harness.cr_all_ok(heap, acc, "kdf", name, buffer.bytes(gb));
        }
        buffer.drop(heap, got);
        buffer.drop(heap, said);
    }
    buffer.drop(heap, input);
    buffer.drop(heap, want);
    return acc;
}

// `docs/hkdf.md` section 9: a prepared key gives what the key gives. Every HMAC, Expand-Label and Derive-Secret row of the vector table, and every Wycheproof HMAC case, again under `hmac.prepare` and
// `hkdf.prepare`; the driver also checks that a tag made by `mac_prepared` and one streamed after `init_prepared` in pieces are equal, and that a prepared secret gives the same label twice.
fn prepared_rows[&h, &x, &c, &f, &p](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), exe: &p [byte], report: buffer.Buffer) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    var acc = report;
    let harness.Contents { data, failed } = harness.read_file(heap, fs, "tests/vectors/kdf.txt");
    if failed != 0 {
        acc = harness.failure(heap, acc, "kdf", "prepared", "tests/vectors/kdf.txt cannot be read", "");
    }
    var input = buffer.empty(heap, 1 << 14);
    var want = buffer.empty(heap, 1 << 14);
    borrow data as &db in {
        let all = buffer.bytes(db);
        var pos = 0;
        var n = 0;
        while pos < len(all) {
            let line = harness.cr_line_at(all, pos);
            pos = pos + len(line) + 1;
            if len(harness.trim_end(line)) > 0 && line[0] != byte_of('#') {
                let case = harness.cr_cell_of(line, 2);
                var op = 0;
                if case[0] == byte_of('M') {
                    // `M HL OUT KEY MSG` -> `P HL OUT PIECE KEY MSG`
                    input = buffer.append(heap, input, "P ");
                    input = buffer.push(heap, buffer.append(heap, input, harness.cr_word(case, 2)), byte_of(' '));
                    input = buffer.push(heap, buffer.append(heap, input, harness.cr_word(case, 3)), byte_of(' '));
                    input = buffer.push(heap, buffer.push_nat(heap, input, 1 + n % 70), byte_of(' '));
                    input = buffer.push(heap, buffer.append(heap, input, harness.cr_word(case, 4)), byte_of(' '));
                    input = buffer.push(heap, buffer.append(heap, input, harness.cr_word(case, 5)), byte_of('\n'));
                    op = 1;
                } else if case[0] == byte_of('L') {
                    input = buffer.push(heap, buffer.append(heap, buffer.append(heap, input, "Q"), case[1..len(case)]), byte_of('\n'));
                    op = 1;
                } else if case[0] == byte_of('D') {
                    input = buffer.push(heap, buffer.append(heap, buffer.append(heap, input, "R"), case[1..len(case)]), byte_of('\n'));
                    op = 1;
                }
                if op == 1 {
                    want = buffer.push(heap, buffer.append(heap, buffer.append(heap, want, "0 ok "), harness.cr_cell_of(line, 3)), byte_of('\n'));
                }
                n = n + 1;
            }
        }
    }
    buffer.drop(heap, data);
    borrow input as &ib in {
        if bytes.count_byte(buffer.bytes(ib), 10) != 12 + 13 + 21 {
            acc = harness.failure(heap, acc, "kdf", "prepared", "the table should have 12 M, 13 L and 21 D rows", "");
        }
        let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "kdf", "prepared");
        acc = more;
        borrow said as &sb in {
            borrow want as &wb in {
                acc = harness.cr_same(heap, acc, "kdf", "prepared", buffer.bytes(sb), buffer.bytes(wb));
            }
        }
        buffer.drop(heap, said);
    }
    buffer.drop(heap, input);
    buffer.drop(heap, want);
    return acc;
}

// Every Wycheproof HMAC case under `hmac.prepare` with a piece size of `1 + tcId % 129`, then the plain `mac` of the same: the two tags must be the same.
fn prepared_hmac[&h, &x, &c, &f, &p, &t](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), exe: &p [byte], report: buffer.Buffer, path: &t [byte], hl: int) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    var acc = report;
    let harness.Contents { data, failed } = harness.read_file(heap, fs, path);
    if failed != 0 {
        acc = harness.failure(heap, acc, "kdf", "prepared-hmac", "a Wycheproof file cannot be read", path);
    }
    var input = buffer.empty(heap, 1 << 17);
    borrow data as &db in {
        let rows = harness.cr_rows(heap, buffer.bytes(db), "tcId key msg tag result");
        borrow rows as &rb in {
            let all = buffer.bytes(rb);
            var pos = 0;
            while pos < len(all) {
                let line = harness.cr_line_at(all, pos);
                pos = pos + len(line) + 1;
                input = buffer.append(heap, input, "P ");
                input = buffer.push_nat(heap, input, hl);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.push_nat(heap, input, hl);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.push_nat(heap, input, 1 + harness.cr_number(harness.cr_cell_of(line, 1)) % 129);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 2)), byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 3)), byte_of('\n'));
                input = buffer.append(heap, input, "M ");
                input = buffer.push_nat(heap, input, hl);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.push_nat(heap, input, hl);
                input = buffer.push(heap, input, byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 2)), byte_of(' '));
                input = buffer.push(heap, buffer.append(heap, input, harness.cr_cell_of(line, 3)), byte_of('\n'));
            }
        }
        buffer.drop(heap, rows);
    }
    buffer.drop(heap, data);
    borrow input as &ib in {
        let (more, said) = harness.cr_ask(heap, exec, clock, exe, buffer.bytes(ib), acc, "kdf", "prepared-hmac");
        acc = more;
        var got = buffer.empty(heap, 1 << 12);
        borrow said as &sb in {
            let answers = buffer.bytes(sb);
            var apos = 0;
            while apos < len(answers) {
                let prepared = harness.trim_end(harness.cr_line_at(answers, apos));
                apos = apos + len(harness.cr_line_at(answers, apos)) + 1;
                let plain = harness.trim_end(harness.cr_line_at(answers, apos));
                apos = apos + len(harness.cr_line_at(answers, apos)) + 1;
                got = harness.cr_expect(heap, got, bytes.equal(prepared, plain) && bytes.starts_with(prepared, "0 ok "), prepared);
            }
        }
        borrow got as &gb in {
            acc = harness.cr_all_ok(heap, acc, "kdf", "prepared-hmac", buffer.bytes(gb));
        }
        buffer.drop(heap, got);
        buffer.drop(heap, said);
    }
    buffer.drop(heap, input);
    return acc;
}

fn check[&h, &x, &c, &f, &b, &e](heap: &!h Heap, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), bin: &b [byte], env: &e [byte]) -> [heap, exec(""), clock, poll, fs_read(""), file_read] buffer.Buffer {
    let exe = "/tmp/cancho-kdf-driver";
    let (report, built) = harness.cr_build(heap, exec, clock, bin, "tests/programs/kdf_driver.cho\0", exe, env, buffer.empty(heap, 64), "kdf");
    var acc = report;
    if built {
        // RFC 4231, RFC 5869, pyca, RFC 8448, ACVP, OpenSSL: 62 vectors.
        acc = harness.cr_table(heap, exec, clock, fs, exe, acc, "kdf", "tests/vectors/kdf.txt", "vectors", "0 ok ", 62);
        acc = cavp(heap, exec, clock, fs, exe, acc);
        acc = harness.cr_two_columns(heap, exec, clock, fs, exe, acc, "kdf", "tests/vectors/kdf_long.txt", "long", 1);
        acc = pieces(heap, exec, clock, exe, acc);
        acc = wycheproof_file(heap, exec, clock, fs, exe, acc, "tests/vectors/wycheproof/hmac_sha256_test.json", 32, true, 66, 108);
        acc = wycheproof_file(heap, exec, clock, fs, exe, acc, "tests/vectors/wycheproof/hmac_sha384_test.json", 48, true, 66, 108);
        acc = wycheproof_file(heap, exec, clock, fs, exe, acc, "tests/vectors/wycheproof/hkdf_sha256_test.json", 32, false, 83, 3);
        acc = wycheproof_file(heap, exec, clock, fs, exe, acc, "tests/vectors/wycheproof/hkdf_sha384_test.json", 48, false, 80, 3);
        acc = refusals(heap, exec, clock, fs, exe, acc, "tests/vectors/kdf_cases.txt", "refusals");
        acc = prepared_rows(heap, exec, clock, fs, exe, acc);
        acc = prepared_hmac(heap, exec, clock, fs, exe, acc, "tests/vectors/wycheproof/hmac_sha256_test.json", 32);
        acc = prepared_hmac(heap, exec, clock, fs, exe, acc, "tests/vectors/wycheproof/hmac_sha384_test.json", 48);
        acc = refusals(heap, exec, clock, fs, exe, acc, "tests/vectors/kdf_prepared_cases.txt", "prepared-refusals");
    }
    return acc;
}

fn run[&h, &i, &a, &x, &c, &f](heap: &!h Heap, io: &!i Io, args: &a Args, exec: &x Exec(""), clock: &c Clock, fs: &f Fs("")) -> [heap, io_write, err_write, args, exec(""), clock, poll, fs_read(""), file_read] int {
    if arg_count(args) < 2 {
        console.error_all(io, "usage: kdf CANCHO [--compiler NAME] [--cache DIR]\n");
        return 2;
    }
    let env = harness.base_env(heap, harness.option(args, "--compiler"), harness.option(args, "--cache"));
    var report = buffer.empty(heap, 0);
    borrow env as &eb in {
        buffer.drop(heap, report);
        report = check(heap, exec, clock, fs, arg(args, 1), buffer.bytes(eb));
    }
    buffer.drop(heap, env);
    var status = 0;
    borrow report as &rb in {
        if len(buffer.bytes(rb)) > 0 {
            console.error_all(io, buffer.bytes(rb));
            status = 1;
        } else {
            console.write_all(io, "ok: kdf\n");
        }
    }
    buffer.drop(heap, report);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow exec as &x in {
                    borrow clock as &c in {
                        borrow fs as &f in {
                            status = run(h, i, a, x, c, f);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(args);
    release(heap);
    release(io);
    return status;
}
