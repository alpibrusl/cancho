edition 7;
module tls_scripts_test;

// tls_scripts.cho -- the TLS batch of the Rust conformance files (`docs/gate.md` G4, wave 4: tls, tls_auth, tls_client_auth, tls_server, tls_fuzz, tls_pool, tls_echo, tls_echo_fixed, https_hello, and most of conn_peer), run from shell
// scripts the way `script_tests.cho` runs those of waves 2 and 3 (a file of its own only so that batches moved in parallel do not meet in one list). Each name in `list` has a script `tests/commands/NAME.sh` and the
// output it must print, `tests/commands/NAME.expected`; the script gets the compiler (`$1`) and a scratch directory (`$2`), is run from the root of the repository, and prints `ok CHECK` for each check that
// holds; `harness.pr_script` compares. Adding a test is adding its two files and its name here.
//
//     cancho build tests/commands/tls_scripts.cho tests/support/harness.cho --std -o EXE && EXE CANCHO [--compiler NAME] [--cache DIR]
//
// Run from the root of the repository. Prints `ok: tls_scripts (N scripts)` or what is wrong, and exits 0 or 1.

import std.buffer;
import std.bytes;
import std.io as console;
import harness;

fn run[&h, &i, &a, &x, &c, &f](heap: &!h Heap, io: &!i Io, args: &a Args, exec: &x Exec(""), clock: &c Clock, fs: &f Fs("")) -> [heap, io_write, err_write, args, exec(""), clock, poll, fs_read(""), file_read] int {
    if arg_count(args) < 2 {
        console.error_all(io, "usage: tls_scripts CANCHO [--compiler NAME] [--cache DIR]\n");
        return 2;
    }
    // One name per field, each followed by a NUL.
    let list = "tls\0tls_auth\0tls_client_auth\0tls_server\0tls_fuzz\0tls_pool\0tls_echo\0tls_echo_fixed\0https_hello\0conn_peer\0";
    let count = bytes.count_byte(list, 0);
    var report = buffer.empty(heap, 64);
    var at = 1;
    while at <= count {
        let name = bytes.field(list, 0, at);
        var script = harness.joined(heap, "tests/commands", name);
        script = buffer.append(heap, script, ".sh");
        var expected = harness.joined(heap, "tests/commands", name);
        expected = buffer.append(heap, expected, ".expected");
        borrow script as &sb in {
            borrow expected as &eb in {
                report = harness.pr_script(heap, exec, clock, fs, arg(args, 1), harness.option(args, "--compiler"), harness.option(args, "--cache"), name, buffer.bytes(sb), buffer.bytes(eb), report);
            }
        }
        buffer.drop(heap, script);
        buffer.drop(heap, expected);
        at = at + 1;
    }
    var status = 0;
    borrow report as &rb in {
        if len(buffer.bytes(rb)) > 0 {
            console.error_all(io, buffer.bytes(rb));
            status = 1;
        } else {
            console.write_all(io, "ok: tls_scripts\n");
        }
    }
    buffer.drop(heap, report);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow exec as &x in {
                    borrow clock as &c in {
                        borrow fs as &f in {
                            status = run(h, i, a, x, c, f);
                        }
                    }
                }
            }
        }
    }
    release(fs);
    release(exec);
    release(clock);
    release(args);
    release(heap);
    release(io);
    return status;
}
