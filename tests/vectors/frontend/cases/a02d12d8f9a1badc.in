  res struct Ticket { fd: int, }  fn open(n: int) -> [] Ticket { return Ticket { fd: n };
 }  fn close(f: Ticket) -> [] int { let Ticket { fd } = f;
 return fd;
 }  fn frozen() -> [] int { var f = open(7);
 borrow f as &r in { defer close(f);
 } return close(f);
 }  fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args } = split(world);
 release(args);
 release(ffi);
 release(fs);
 release(heap);
 release(io);
 return 0;
 } 