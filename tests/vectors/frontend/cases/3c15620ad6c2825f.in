  edition 9;
 fn drop_it(child: Child) -> [] int { return child_release(child);
 } fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
 release(io);
 release(ffi);
 release(fs);
 release(heap);
 release(args);
 release(net);
 release(clock);
 release(signals);
 release(tty);
 release(exec);
 return 0;
 } 