  struct Cell { value: int, count: int, }  res struct Rc { held: Box[Cell], }  res struct Two { first: Rc, second: Rc, }  fn clone(rc: Rc) -> [] Two { let Rc { held } = rc;
 return Two { first: Rc { held: held }, second: Rc { held: held } };
 }  fn drain[&h](heap: &!h Heap, rc: Rc) -> [heap] int { let Rc { held } = rc;
 return unbox(heap, held).value;
 }  fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args } = split(world);
 release(args);
 release(ffi);
 release(fs);
 release(io);
  var status = 0;
 borrow mut heap as &!h in { let one = Rc { held: box(h, Cell { value: 1, count: 2 }) };
 let Two { first, second } = clone(one);
 status = drain(h, first) + drain(h, second);
 } release(heap);
 return status;
 } 