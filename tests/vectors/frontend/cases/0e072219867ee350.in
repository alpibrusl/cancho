//~ ERROR takes 1 argument, but 2 were given


// `docs/function-values.md` §4.2: a call through a value is checked
// against the value's own type exactly as a named call is checked


fn double(x: int) -> [] int {
    return x + x;
}

fn main() -> [] int {
    let h = double;
    return h(1, 2);
}
