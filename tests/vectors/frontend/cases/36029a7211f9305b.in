 edition 5;
 fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args, net, clock } = split(world);
 release(ffi);
 release(fs);
 release(heap);
 release(args);
 release(clock);
 let (a, b) = narrow(net, "127.0.0.1:80", "127.0.0.1:8080");
 release(a);
 release(b);
 borrow mut io as &!i in { putchar(i, '0');
 putchar(i, 10);
 } release(io);
 return 0;
 } 