  fn stash[&h](heap: &!h Heap, n: int) -> [] Box[int] { return box(heap, n);
 }  fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args } = split(world);
 release(args);
 release(ffi);
 release(fs);
 release(io);
  var status = 0;
 borrow mut heap as &!h in { let b = stash(h, 41);
 status = unbox(h, b);
 } release(heap);
 return status - 41;
 } 