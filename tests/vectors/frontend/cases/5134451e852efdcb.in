  edition 5;
 fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args, net, clock } = split(world);
 release(io);
 release(ffi);
 release(fs);
 release(heap);
 release(args);
 release(clock);
 let a = narrow(net, "127.0.0.1:80");
 let b = narrow(a, "127.0.0.1:8080");
 release(b);
 return 0;
 } 