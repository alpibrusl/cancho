 import std.io;
  fn both[&a, &b](p: &!a [int], q: &!b [int]) -> [] int { p[0] = 1;
 q[0] = 2;
 return p[0];
 }  fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args } = split(world);
 release(args);
 release(ffi);
 release(fs);
 release(heap);
  var answer = 0;
 region r { var s = alloc_slice[r](4, 0);
 answer = both(s, s);
 }  borrow mut io as &!i in { io.print_int(i, answer);
 io.newline(i);
 } release(io);
 return 0;
 } 