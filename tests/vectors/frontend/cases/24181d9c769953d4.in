  res struct Vec[T] { held: Box[[T]], used: int, }  fn empty[T, &h](heap: &!h Heap, capacity: int, fill: T) -> [heap] Vec[T] { return Vec { held: box_slice(heap, capacity, fill), used: 0 };
 }  fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args } = split(world);
 release(args);
 release(ffi);
 release(fs);
 release(heap);
 release(io);
 return 0;
 } 