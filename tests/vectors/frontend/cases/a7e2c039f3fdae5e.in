 import std.io;
  fn label[&i, &s](io: &!i Io, name: &s [byte], value: int) -> [io_write] int { io.write_all(io, name);
 io.space(io);
 io.print_int(io, value);
 io.newline(io);
 return 0;
 }  fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args } = split(world);
 release(args);
 release(heap);
 release(fs);
 release(ffi);
  borrow mut io as &!i in { label(i, "and", 12 & 10);
 label(i, "or", 12 | 3);
 label(i, "xor", 12 ^ 10);
 label(i, "not", ~0);
 label(i, "shl", 1 << 4);
 label(i, "shr", 0 - 8 >> 1);
 var sign = 0;
 if 1 << 63 < 0 { sign = 1;
 } label(i, "sign", sign);
  let b = byte_of(0xff - 0xf2 + 0xf0);
 label(i, "mask", int_of(b) & 15);
  var tight = 0;
 if 12 & 10 == 8 { tight = 1;
 } label(i, "tight", tight);
 }  release(io);
 return 0;
 } 