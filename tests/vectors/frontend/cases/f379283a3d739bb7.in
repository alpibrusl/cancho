  fn shout[&i](io: &!i Io) -> [io_write] int { return putchar(io, 33);
 }  fn caller[&i](io: &!i Io) -> [] int { return shout(io);
 }  fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args } = split(world);
 release(args);
 release(ffi);
 release(fs);
 release(heap);
 release(io);
 return 0;
 } 