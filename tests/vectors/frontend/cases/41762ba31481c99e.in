  struct Node { value: int, }  fn escape_borrow[&q](b: Box[Node], fallback: &q Node) -> [] &q Node { borrow b as &r in { return contents(r);
 } }  fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args } = split(world);
 release(args);
 release(heap);
 release(ffi);
 release(fs);
 release(io);
 return 0;
 } 