  edition 9;
 fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
 release(io);
 release(ffi);
 release(fs);
 release(heap);
 release(args);
 release(net);
 release(clock);
 release(signals);
 release(exec);
 release(tty);
 return byte_mask64("0123456789012345678901234567890123456789012345678901234567890123", 0, 44);
 } 