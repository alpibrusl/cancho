  edition 5;
  fn one(x: int) -> [] int { return x;
 }  fn two(x: int) -> [] int { return x + 1;
 }  fn main(world: World) -> [conc] int { let Split { io, ffi, fs, heap, args, net, clock } = split(world);
 release(ffi);
 release(fs);
 release(args);
 release(net);
 release(clock);
 release(io);
 release(heap);
 let f = one;
 let g = two;
 let a = spawn(1, f);
 let b = spawn(1, g);
 return join(a) + join(b) - 3;
 } 