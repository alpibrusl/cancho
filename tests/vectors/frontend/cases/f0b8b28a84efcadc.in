module fmt.text;
   pub fn write_all[&r, &i](io: &!i Io, s: &r [byte]) -> [io_write] int { var n = 0;
 while n < len(s) { putchar(io, int_of(s[n]));
 n = n + 1;
 } return len(s);
 }  pub fn print_nat[&i](io: &!i Io, n: int) -> [io_write] int { if n >= 10 { print_nat(io, n / 10);
 } return putchar(io, '0' + n % 10);
 }  pub fn newline[&i](io: &!i Io) -> [io_write] int { return putchar(io, 10);
 } 