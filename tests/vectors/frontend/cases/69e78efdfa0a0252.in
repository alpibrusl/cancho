 import std.io;
  fn main(world: World) -> [] int { let Split { io, ffi, fs, heap, args } = split(world);
 release(args);
 release(heap);
 release(fs);
 release(ffi);
  var first = 0;
 var second = 0;
 var third = 0;
  region a { let s = alloc_slice[a](4, 11);
 first = s[0];
 } region b { let s = alloc_slice[b](4, 22);
 second = s[0];
 } region c { let outer = alloc_slice[c](2, 3);
 region d { let inner = alloc_slice[d](2, 4);
 third = outer[0] + inner[0];
 } } region e { let s = alloc_slice[e](1, 0);
 third = third + s[0];
 }  borrow mut io as &!i in { io.write_all(i, "first ");
 io.print_int(i, first);
 io.newline(i);
 io.write_all(i, "second ");
 io.print_int(i, second);
 io.newline(i);
 io.write_all(i, "nested-then-sibling ");
 io.print_int(i, third);
 io.newline(i);
 }  release(io);
 return 0;
 } 