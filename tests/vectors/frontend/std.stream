    c = shr56(h7, l7);
    let (h8, l8) = field25519_51.mac(0, c, a4, a4);
    let (h8, l8) = field25519_51.mac(h8, l8, m4, 4294967295);
    let r3 = l8 & 72057594037927935;
    c = shr56(h8, l8);
    let r4 = c;
    os[0] = r0 & 268435455;
    os[1] = r0 >> 28;
    os[2] = r1 & 268435455;
    os[3] = r1 >> 28;
    os[4] = r2 & 268435455;
    os[5] = r2 >> 28;
    os[6] = r3 & 268435455;
    os[7] = r3 >> 28;
    os[8] = r4 & 268435455;
    os[9] = r4 >> 28;
    return 0;
}

