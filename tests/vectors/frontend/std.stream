        q = q - 1;
    }
    let mask = 16777215;
    let t0 = (mant & mask) << shift;
    let n0 = t0 & mask;
    let t1 = ((mant >> 24 & mask) << shift) + (t0 >> 24);
    let n1 = t1 & mask;
    let t2 = (mant >> 48 << shift) + (t1 >> 24);
    let n2 = t2 & mask;
    let n3 = t2 >> 24;

    var k = 0;
    var r = 0.0;
    region a {
        let limbs = alloc_slice[a](9, 0);
        var carry = 0;
        var s = 0 - 8;
        while s <= 0 {
            let t = carry + n0 * pio2_limb(q - 1 - s) + n1 * pio2_limb(q - s) + n2 * pio2_limb(q + 1 - s) + n3 * pio2_limb(q + 2 - s);
            limbs[s + 8] = t & mask;
            carry = t >> 24;
            s = s + 1;
        }
        let up = limbs[7] >> 23;
        k = (limbs[8] & 3) + up & 3;
        var owed = 0;
        var f = 0.0;
