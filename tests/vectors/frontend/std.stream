module std.crc;

// `std.crc` — the checksums a cancho program has been asked for by
// name, each gated against the standard catalogue's published check
// value for `"123456789"` (#352).
//
// Two askers cleared `CONTRIBUTING.md`'s bar, and they want four
// polynomials:
//
//   * **CRC-16/XMODEM** — Redis Cluster's hash slot is
//     `crc16(key) mod 16384` (with `{hash tag}` handling), so a
//     cluster-aware client must agree with the server byte for byte
//     (cancho-cache's cluster-lite epic).
//   * **CRC-64/XZ** (the ECMA-182 polynomial, reflected, init and xorout
//     all ones) — the catalogue's CRC-64 a snapshot or replication format
//     wants.
//   * **CRC-64/REDIS** (the "Jones" polynomial 0xad93d23594c935a9,
//     reflected, init and xorout 0) — what Redis's own `crc64` computes
//     (`crc64(0, "123456789", 9) == 0xe9c6d914c4b8d9ca`, from Redis's
//     test), so an RDB or a replication payload checks byte for byte.
//   * **CRC-32/IEEE** — a log or snapshot record check. cancho-log has
//     its own private `crc.cho`, a *Castagnoli* CRC-32C, which stays
//     where it is: that is a different polynomial, not a second copy of
//     this one.
//
// All four are reflected-or-not as their standard says, table-driven
// where a table earns its 2 KiB, and incremental (`start`/`update`/
// `finish`) beside a one-call `of` — a snapshot is checksummed in slices
// across turns of an event loop, so the state has to survive between
// them.
//
// **A checksum's width is a mask, not a type.** `int` is 64-bit and
// signed, and `>>` is arithmetic (`docs/bitwise.md` §2): a state whose
// top bit is set would sign-extend under `>>` and read back wrong.
// CRC-16 and CRC-32 stay under 2^31 by masking, so their `>>` is logical
// for free. CRC-64 cannot — its state genuinely uses the top bit, and
// the mask `0xffffffffffffffff` is not a literal a 64-bit signed
// language can write. Its state is therefore held as **two 32-bit
// halves**, every intermediate of which is under 2^56 and every shift
// logical by construction. The table is stored the same way, as two
// 256-entry statics; that is not an optimisation but the design.
//
// No imports: a checksum is shifts and xors, and a module with nothing
// to depend on publishes first (`docs/package-system.md`).

// ---- CRC-16/XMODEM (CCITT-FALSE family: poly 0x1021, init 0, no
//      reflection, no final xor) ---------------------------------------------
//
// Sixteen bits, non-reflected: the byte loop is eight shift-and-condition
// steps, and a 256-entry table for it costs more than the loop. This is
// the exact loop Redis's own `crc16` reference implements for
// `CLUSTER KEYSLOT`.

// The state before any byte: XMODEM starts at 0.
pub fn crc16_start() -> [] int {
    return 0;
}

// Feed `data` into a running CRC-16/XMODEM state.
pub fn crc16_update[&b](state: int, data: &b [byte]) -> [] int {
    var c = state & 0xffff;
    var i = 0;
    while i < len(data) {
        c = c ^ int_of(data[i]) << 8;
        var k = 0;
        while k < 8 {
            if c & 0x8000 != 0 {
                c = c << 1 ^ 0x1021;
            } else {
                c = c << 1;
            }
            c = c & 0xffff;
            k = k + 1;
        }
        i = i + 1;
    }
    return c;
}

// The checksum of a state (XMODEM has no final xor).
pub fn crc16_finish(state: int) -> [] int {
    return state & 0xffff;
}

// The checksum of `data` in one call.
pub fn crc16_of[&b](data: &b [byte]) -> [] int {
    return crc16_finish(crc16_update(crc16_start(), data));
}

// ---- CRC-32/IEEE (reflected, poly 0xedb88320, init and xorout all ones) ----

static crc32_table: [int] {
    let t = alloc_slice[static](256, 0);
    var i = 0;
    while i < 256 {
        var c = i;
        var k = 0;
        while k < 8 {
            if c & 1 == 1 {
                c = c >> 1 ^ 0xedb88320;
            } else {
                c = c >> 1;
            }
            c = c & 0xffffffff;
            k = k + 1;
        }
        t[i] = c;
        i = i + 1;
    }
    return t;
}

// The state before any byte: IEEE starts at all ones.
pub fn crc32_start() -> [] int {
    return 0xffffffff;
}

// Feed `data` into a running CRC-32/IEEE state.
pub fn crc32_update[&b](state: int, data: &b [byte]) -> [] int {
    var c = state & 0xffffffff;
    var i = 0;
    while i < len(data) {
        c = c >> 8 ^ crc32_table[(c ^ int_of(data[i])) & 0xff];
        c = c & 0xffffffff;
        i = i + 1;
    }
    return c;
}

// The checksum of a state: the complement, masked to the width.
pub fn crc32_finish(state: int) -> [] int {
    return (state ^ 0xffffffff) & 0xffffffff;
}

// The checksum of `data` in one call.
pub fn crc32_of[&b](data: &b [byte]) -> [] int {
    return crc32_finish(crc32_update(crc32_start(), data));
}

// ---- CRC-64: two reflected polynomials, one machinery -----------------------
//
// CRC-64/XZ (ECMA-182, reflected poly 0xc96c5795d7870f42, init and xorout
// all ones) and CRC-64/REDIS ("Jones", reflected poly 0x95ac9329ac4bc9b5,
// init and xorout 0) differ in the polynomial and the two constants,
// nothing else.
//
// The state is two 32-bit halves, `hi` and `lo`, each always in
// [0, 2^32): no intermediate reaches a sign bit, every `>>` is logical,
// and no 64-bit mask is needed. The update, derived from the one-word
// form `crc = table[(crc ^ b) & 0xff] ^ (crc >> 8)`:
//
//   idx = (lo ^ b) & 0xff                — the byte meets the low half
//   shr = (lo >> 8) | (hi << 24)         — the logical `crc >> 8`, under 2^56
//   lo  = table_lo[idx] ^ (shr & 0xffffffff)
//   hi  = table_hi[idx] ^ (shr >> 32)
//
// The table is stored as the same two halves. The one-word entry is built
// in halves too, for the same reason the state is: the 64-bit entry uses
// the top bit, `>>` is arithmetic, and the 64-bit mask is not a literal
// this language can write. Each entry is two 32-bit words through all
// eight steps -- the shift moves a bit from `hi` into `lo`'s top, then the
// halves xor their own half of the polynomial (`phi` above, `plo` below).
// `tests/accept/crc_check_values.cho` checks both polynomials against the
// catalogue's and Redis's values.

static crc64_table_lo: [int] {
    let t = alloc_slice[static](256, 0);
    var i = 0;
    while i < 256 {
        var chi = 0;
        var clo = i;
        var k = 0;
        while k < 8 {
            if clo & 1 == 1 {
                clo = (clo >> 1 | (chi & 1) << 31) ^ 0xd7870f42;
                chi = chi >> 1 ^ 0xc96c5795;
            } else {
                clo = clo >> 1 | (chi & 1) << 31;
                chi = chi >> 1;
            }
            k = k + 1;
        }
        t[i] = clo;
        i = i + 1;
    }
    return t;
}

static crc64_table_hi: [int] {
    let t = alloc_slice[static](256, 0);
    var i = 0;
    while i < 256 {
        var chi = 0;
        var clo = i;
        var k = 0;
        while k < 8 {
            if clo & 1 == 1 {
                clo = (clo >> 1 | (chi & 1) << 31) ^ 0xd7870f42;
                chi = chi >> 1 ^ 0xc96c5795;
            } else {
                clo = clo >> 1 | (chi & 1) << 31;
                chi = chi >> 1;
            }
            k = k + 1;
        }
        t[i] = chi;
        i = i + 1;
    }
    return t;
}

static crc64_redis_table_lo: [int] {
    let t = alloc_slice[static](256, 0);
    var i = 0;
    while i < 256 {
        var chi = 0;
        var clo = i;
        var k = 0;
        while k < 8 {
            if clo & 1 == 1 {
                clo = (clo >> 1 | (chi & 1) << 31) ^ 0xac4bc9b5;
                chi = chi >> 1 ^ 0x95ac9329;
            } else {
                clo = clo >> 1 | (chi & 1) << 31;
                chi = chi >> 1;
            }
            k = k + 1;
        }
        t[i] = clo;
        i = i + 1;
    }
    return t;
}

static crc64_redis_table_hi: [int] {
    let t = alloc_slice[static](256, 0);
    var i = 0;
    while i < 256 {
        var chi = 0;
        var clo = i;
        var k = 0;
        while k < 8 {
            if clo & 1 == 1 {
                clo = (clo >> 1 | (chi & 1) << 31) ^ 0xac4bc9b5;
                chi = chi >> 1 ^ 0x95ac9329;
            } else {
                clo = clo >> 1 | (chi & 1) << 31;
                chi = chi >> 1;
            }
            k = k + 1;
        }
        t[i] = chi;
        i = i + 1;
    }
    return t;
}

// ---- CRC-64/XZ ---------------------------------------------------------------

// The state before any byte: XZ starts at all ones, which in halves is
// two all-ones 32-bit words.
pub fn crc64_start() -> [] (int, int) {
    return (0xffffffff, 0xffffffff);
}

// Feed `data` into a running CRC-64/XZ state, in halves.
pub fn crc64_update[&b](state: (int, int), data: &b [byte]) -> [] (int, int) {
    var hi = state.0;
    var lo = state.1;
    var i = 0;
    while i < len(data) {
        let idx = (lo ^ int_of(data[i])) & 0xff;
        let shr = lo >> 8 | hi << 24;
        lo = crc64_table_lo[idx] ^ shr & 0xffffffff;
        hi = crc64_table_hi[idx] ^ shr >> 32;
        i = i + 1;
    }
    return (hi, lo);
}

// The checksum of a state: each half complemented. The answer is the
// pair; a caller that wants it as one number combines the halves
// itself, because `hi * 4294967296 + lo` is a 64-bit value the caller
// may legitimately want to keep in halves too.
pub fn crc64_finish(state: (int, int)) -> [] (int, int) {
    return (state.0 ^ 0xffffffff, state.1 ^ 0xffffffff);
}

// The checksum of `data` in one call.
pub fn crc64_of[&b](data: &b [byte]) -> [] (int, int) {
    return crc64_finish(crc64_update(crc64_start(), data));
}

// ---- CRC-64/REDIS (the "Jones" polynomial; init and xorout 0) ------------------

// The state before any byte: Redis starts at 0.
pub fn crc64_redis_start() -> [] (int, int) {
    return (0, 0);
}

// Feed `data` into a running CRC-64/REDIS state, in halves.
pub fn crc64_redis_update[&b](state: (int, int), data: &b [byte]) -> [] (int, int) {
    var hi = state.0;
    var lo = state.1;
    var i = 0;
    while i < len(data) {
        let idx = (lo ^ int_of(data[i])) & 0xff;
        let shr = lo >> 8 | hi << 24;
        lo = crc64_redis_table_lo[idx] ^ shr & 0xffffffff;
        hi = crc64_redis_table_hi[idx] ^ shr >> 32;
        i = i + 1;
    }
    return (hi, lo);
}

// The checksum of a state (Redis has no final xor).
pub fn crc64_redis_finish(state: (int, int)) -> [] (int, int) {
    return state;
}

// The checksum of `data` in one call.
pub fn crc64_redis_of[&b](data: &b [byte]) -> [] (int, int) {
    return crc64_redis_finish(crc64_redis_update(crc64_redis_start(), data));
}
FILE 28520
edition 9;
module std.crypto;

// `std.crypto` — SHA-256 and SHA-512 (`docs/crypto.md`, `docs/sha512.md`).
//
// FIPS 180-4. SHA-256 is 32-bit modular arithmetic expressed as masked
// 64-bit `int` (`docs/crypto.md` §2): every word this code touches lives
// in `[0, 0xffffffff]`, `mask32` reduces `mod 2^32` at the point the spec
// says to, and the checked `+` underneath never traps because the
// largest sum this code ever forms — five 32-bit terms — is nowhere
// near the 64-bit ceiling. SHA-512 needs no such mask: its word *is*
// this language's `int` width, and `wrapping_add` does the `mod 2^64`
// reduction directly — but that width match is what exposes a real gap,
// a logical right shift, that SHA-256's narrower word never could
// (`docs/sha512.md` §2).

static sha256_h0: [int] {
    let h = alloc_slice[static](8, 0);
    h[0] = 0x6a09e667;
    h[1] = 0xbb67ae85;
    h[2] = 0x3c6ef372;
    h[3] = 0xa54ff53a;
    h[4] = 0x510e527f;
    h[5] = 0x9b05688c;
    h[6] = 0x1f83d9ab;
    h[7] = 0x5be0cd19;
    return h;
}

static sha256_k: [int] {
    let k = alloc_slice[static](64, 0);
    k[0] = 0x428a2f98;
    k[1] = 0x71374491;
    k[2] = 0xb5c0fbcf;
    k[3] = 0xe9b5dba5;
    k[4] = 0x3956c25b;
    k[5] = 0x59f111f1;
    k[6] = 0x923f82a4;
    k[7] = 0xab1c5ed5;
    k[8] = 0xd807aa98;
    k[9] = 0x12835b01;
    k[10] = 0x243185be;
    k[11] = 0x550c7dc3;
    k[12] = 0x72be5d74;
    k[13] = 0x80deb1fe;
    k[14] = 0x9bdc06a7;
    k[15] = 0xc19bf174;
    k[16] = 0xe49b69c1;
    k[17] = 0xefbe4786;
    k[18] = 0x0fc19dc6;
    k[19] = 0x240ca1cc;
    k[20] = 0x2de92c6f;
    k[21] = 0x4a7484aa;
    k[22] = 0x5cb0a9dc;
    k[23] = 0x76f988da;
    k[24] = 0x983e5152;
    k[25] = 0xa831c66d;
    k[26] = 0xb00327c8;
    k[27] = 0xbf597fc7;
    k[28] = 0xc6e00bf3;
    k[29] = 0xd5a79147;
    k[30] = 0x06ca6351;
    k[31] = 0x14292967;
    k[32] = 0x27b70a85;
    k[33] = 0x2e1b2138;
    k[34] = 0x4d2c6dfc;
    k[35] = 0x53380d13;
    k[36] = 0x650a7354;
    k[37] = 0x766a0abb;
    k[38] = 0x81c2c92e;
    k[39] = 0x92722c85;
    k[40] = 0xa2bfe8a1;
    k[41] = 0xa81a664b;
    k[42] = 0xc24b8b70;
    k[43] = 0xc76c51a3;
    k[44] = 0xd192e819;
    k[45] = 0xd6990624;
    k[46] = 0xf40e3585;
    k[47] = 0x106aa070;
    k[48] = 0x19a4c116;
    k[49] = 0x1e376c08;
    k[50] = 0x2748774c;
    k[51] = 0x34b0bcb5;
    k[52] = 0x391c0cb3;
    k[53] = 0x4ed8aa4a;
    k[54] = 0x5b9cca4f;
    k[55] = 0x682e6ff3;
    k[56] = 0x748f82ee;
    k[57] = 0x78a5636f;
    k[58] = 0x84c87814;
    k[59] = 0x8cc70208;
    k[60] = 0x90befffa;
    k[61] = 0xa4506ceb;
    k[62] = 0xbef9a3f7;
    k[63] = 0xc67178f2;
    return k;
}

fn mask32(x: int) -> [] int {
    return x & 0xffffffff;
}

// A 32-bit rotate built out of two opposite shifts and a masked `|` —
// this language has no dedicated rotate operator (`docs/crypto.md` §2).
fn rotr32(x: int, n: int) -> [] int {
    return mask32(x >> n | x << 32 - n);
}

// The 32-bit bitwise complement of a value already confined to
// `[0, 0xffffffff]`: an XOR with the mask rather than `~` (which flips
// all 64 bits, not 32). It was `0xffffffff - x`, the same value, but a
// checked subtraction is an overflow test on a hashed key's words, and
// an XOR is not (`docs/crypto.md` §2, `docs/hkdf.md` §3).
fn not32(x: int) -> [] int {
    return x ^ 0xffffffff;
}

// The software path's compression (`docs/sha256-builtin.md` §5): one
// 64-byte block, already loaded as sixteen words into the schedule
// (`load256`, or from the partial block), folded into `state`'s eight running 32-bit words, held as
// `int`s in `[0, 0xffffffff]`. The schedule lives in the state
// (`state[74..138]`), not in an arena of its own: an arena is a
// `malloc`, and one per block was most of the cost of a short message
// (`docs/hkdf.md` §6). The additions are `wrapping_add`
// under the mask, not a checked `+`: none can overflow, and a checked
// one would emit an overflow test on the words of a hashed key, which
// `docs/hkdf.md` §3 does not want (`docs/crypto.md` §2 says what
// changed).
fn compress[&st](state: &!st [int]) -> [] int {
    var t = 16;
    while t < 64 {
        let s0 = rotr32(state[74 + t - 15], 7) ^ rotr32(state[74 + t - 15], 18) ^ state[74 + t - 15] >> 3;
        let s1 = rotr32(state[74 + t - 2], 17) ^ rotr32(state[74 + t - 2], 19) ^ state[74 + t - 2] >> 10;
        state[74 + t] = mask32(wrapping_add(wrapping_add(state[74 + t - 16], s0), wrapping_add(state[74 + t - 7], s1)));
        t = t + 1;
    }

    var wa = state[0];
    var wb = state[1];
    var wc = state[2];
    var wd = state[3];
    var we = state[4];
    var wf = state[5];
    var wg = state[6];
    var wh = state[7];

    t = 0;
    while t < 64 {
        let s1 = rotr32(we, 6) ^ rotr32(we, 11) ^ rotr32(we, 25);
        let ch = we & wf ^ not32(we) & wg;
        let temp1 = mask32(wrapping_add(wrapping_add(wrapping_add(wh, s1), wrapping_add(ch, sha256_k[t])), state[74 + t]));
        let s0 = rotr32(wa, 2) ^ rotr32(wa, 13) ^ rotr32(wa, 22);
        let maj = wa & wb ^ wa & wc ^ wb & wc;
        let temp2 = mask32(wrapping_add(s0, maj));

        wh = wg;
        wg = wf;
        wf = we;
        we = mask32(wrapping_add(wd, temp1));
        wd = wc;
        wc = wb;
        wb = wa;
        wa = mask32(wrapping_add(temp1, temp2));

        t = t + 1;
    }

    state[0] = mask32(wrapping_add(state[0], wa));
    state[1] = mask32(wrapping_add(state[1], wb));
    state[2] = mask32(wrapping_add(state[2], wc));
    state[3] = mask32(wrapping_add(state[3], wd));
    state[4] = mask32(wrapping_add(state[4], we));
    state[5] = mask32(wrapping_add(state[5], wf));
    state[6] = mask32(wrapping_add(state[6], wg));
    state[7] = mask32(wrapping_add(state[7], wh));
    return 0;
}

// The streaming interface (`docs/hkdf.md` §2). A state is a `[int]` of
// `sha256_state_len()` words (`docs/sha256-builtin.md` §5):
//
//     0..8     the eight running words
//     8..24    the partial block, as sixteen big-endian words; every
//              byte past the ones waiting is zero
//     24       the number of bytes hashed so far
//     25       the number waiting in the partial block
//     26..74   not used, and zero: the length did not move, so neither
//              did anything laid out around a state (the TLS slot's
//              transcripts)
//     74..138  the 64-word message schedule of the software path
//
// Nothing the size of the message is ever allocated, which is what lets
// a message of any length be hashed: the one-shot `sha256` below used to
// copy the whole padded message into one arena and trapped at 64 KiB
// (`docs/crypto.md` §4). And nothing is allocated per call at all: the
// buffer and the schedule are the caller's (`docs/hkdf.md` §6).
pub fn sha256_state_len() -> [] int {
    return 138;
}

fn clear_block[&st](state: &!st [int]) -> [] int {
    var k = 8;
    while k < 24 {
        state[k] = 0;
        k = k + 1;
    }
    return 0;
}

pub fn sha256_init[&st](state: &!st [int]) -> [] int {
    var i = 0;
    while i < 8 {
        state[i] = sha256_h0[i];
        i = i + 1;
    }
    clear_block(state);
    state[24] = 0;
    state[25] = 0;
    return 0;
}

// The eight running words of a state with no byte waiting, into
// `words[0..8]`: what `std.hmac` keeps of a key's two padded blocks
// (`docs/hkdf.md` §9). With bytes waiting the words are not a resumable
// point, and it answers -1 and writes nothing.
pub fn sha256_save[&st, &w](state: &st [int], words: &!w [int]) -> [] int {
    if state[25] != 0 {
        return -1;
    }
    var i = 0;
    while i < 8 {
        words[i] = state[i];
        i = i + 1;
    }
    return 0;
}

// A state that goes on from `words` (what `sha256_save` wrote) after
// `bytes` bytes, a multiple of 64, were hashed.
pub fn sha256_resume[&st, &w](state: &!st [int], words: &w [int], bytes: int) -> [] int {
    var i = 0;
    while i < 8 {
        state[i] = words[i];
        i = i + 1;
    }
    clear_block(state);
    state[24] = bytes;
    state[25] = 0;
    return 0;
}

// The sixteen big-endian words of `block` into the schedule.
fn load256[&st, &b](state: &!st [int], block: &b [byte]) -> [] int {
    var t = 0;
    while t < 16 {
        let i = t * 4;
        state[74 + t] = int_of(block[i]) << 24 | int_of(block[i + 1]) << 16 | int_of(block[i + 2]) << 8 | int_of(block[i + 3]);
        t = t + 1;
    }
    return 0;
}

// The whole 64-byte blocks of `data`, straight from the caller's bytes:
// on the CPU's SHA-256 instructions where it has them
// (`docs/sha256-builtin.md` §5), in software otherwise. Which one is a
// question about the CPU, not the data, so the branch is public.
fn compress_bytes[&st, &d](state: &!st [int], data: &d [byte]) -> [] int {
    if hw_sha256() {
        return sha256_blocks(state[0..8], data);
    }
    var at = 0;
    while at < len(data) {
        load256(state, data[at..at + 64]);
        compress(state);
        at = at + 64;
    }
    return 0;
}

// The partial block, full, compressed the same two ways; then cleared for
// the next one, which is also what keeps the bytes past the waiting ones
// zero.
fn compress_block[&st](state: &!st [int]) -> [] int {
    if hw_sha256() {
        sha256_block_words(state[0..8], state[8..24]);
    } else {
        var t = 0;
        while t < 16 {
            state[74 + t] = state[8 + t];
            t = t + 1;
        }
        compress(state);
    }
    return clear_block(state);
}

// One byte into the partial block, at byte `have` of it.
fn put_byte[&st](state: &!st [int], have: int, b: int) -> [] int {
    let w = 8 + (have >> 2);
    state[w] = state[w] | b << 24 - ((have & 3) << 3);
    return 0;
}

// Feeds `data`. Whole blocks are compressed straight from `data`; only a
// partial block is copied, into the state's.
pub fn sha256_update[&st, &d](state: &!st [int], data: &d [byte]) -> [] int {
    let n = len(data);
    state[24] = state[24] + n;
    var have = state[25];
    var at = 0;
    if have > 0 {
        while have < 64 && at < n {
            put_byte(state, have, int_of(data[at]));
            have = have + 1;
            at = at + 1;
        }
        if have == 64 {
            compress_block(state);
            have = 0;
        }
    }
    let whole = n - at >> 6 << 6;
    if whole > 0 {
        compress_bytes(state, data[at..at + whole]);
        at = at + whole;
    }
    while at < n {
        put_byte(state, have, int_of(data[at]));
        have = have + 1;
        at = at + 1;
    }
    state[25] = have;
    return 0;
}

// The padding (FIPS 180-4 §5.1.1) — `0x80`, zeros, the bit length in
// the last eight bytes, one block more if there is no room — compressed,
// leaving the digest as the eight running words. The bytes past the
// waiting ones are already zero. `std.hmac` feeds those words to its
// outer hash with `sha256_update_words` and never writes them as bytes
// (`docs/hkdf.md` §9).
pub fn sha256_finish[&st](state: &!st [int]) -> [] int {
    let have = state[25];
    put_byte(state, have, 0x80);
    if have >= 56 {
        compress_block(state);
    }
    let bit_len = state[24] * 8;
    state[22] = bit_len >> 32 & 0xffffffff;
    state[23] = bit_len & 0xffffffff;
    compress_block(state);
    state[25] = 0;
    return 0;
}

// `sha256_finish`, and the digest into `digest[0..32]`. The state is
// spent: `sha256_init` it again to reuse it.
pub fn sha256_final[&st, &o](state: &!st [int], digest: &!o [byte]) -> [] int {
    sha256_finish(state);
    var w = 0;
    while w < 8 {
        let word = state[w];
        digest[w * 4] = byte_of(word >> 24 & 0xff);
        digest[w * 4 + 1] = byte_of(word >> 16 & 0xff);
        digest[w * 4 + 2] = byte_of(word >> 8 & 0xff);
        digest[w * 4 + 3] = byte_of(word & 0xff);
        w = w + 1;
    }
    return 0;
}

// Feeds the 32-bit big-endian words `words` (four bytes each), to a state
// whose waiting bytes are a whole number of words (-1 and nothing fed
// otherwise): another hash's digest, as `sha256_finish` left it.
pub fn sha256_update_words[&st, &w](state: &!st [int], words: &w [int]) -> [] int {
    var have = state[25];
    if have & 3 != 0 {
        return -1;
    }
    state[24] = state[24] + 4 * len(words);
    var i = 0;
    while i < len(words) {
        state[8 + (have >> 2)] = words[i];
        have = have + 4;
        if have == 64 {
            compress_block(state);
            have = 0;
        }
        i = i + 1;
    }
    state[25] = have;
    return 0;
}

// `message`, hashed into `digest` — a caller-provided, unique-referenced
// output buffer of at least 32 bytes, the same "write into what the
// caller passed" shape `std.bignum`'s `add_into`/`copy` already use
// (`docs/crypto.md` §4). A shorter `digest` traps on the ordinary bounds
// check every other out-of-range write in this language already gets.
pub fn sha256[&s, &o](message: &s [byte], digest: &!o [byte]) -> [] int {
    region st {
        let state = alloc_slice[st](138, 0);
        sha256_init(state);
        sha256_update(state, message);
        sha256_final(state, digest);
    }
    return 0;
}

// SHA-512 (`docs/sha512.md`). Unlike SHA-256's words, a SHA-512 word
// *is* this language's `int` width, so there is no room to mask a
// result into a narrower range the way `mask32` does — the reduction
// `mod 2^64` is exactly what `wrapping_add` already computes, bit for
// bit, on the full 64 bits.

static sha512_h0: [int] {
    let h = alloc_slice[static](8, 0);
    h[0] = 0x6a09e667 << 32 | 0xf3bcc908;
    h[1] = 0xbb67ae85 << 32 | 0x84caa73b;
    h[2] = 0x3c6ef372 << 32 | 0xfe94f82b;
    h[3] = 0xa54ff53a << 32 | 0x5f1d36f1;
    h[4] = 0x510e527f << 32 | 0xade682d1;
    h[5] = 0x9b05688c << 32 | 0x2b3e6c1f;
    h[6] = 0x1f83d9ab << 32 | 0xfb41bd6b;
    h[7] = 0x5be0cd19 << 32 | 0x137e2179;
    return h;
}

static sha512_k: [int] {
    let k = alloc_slice[static](80, 0);
