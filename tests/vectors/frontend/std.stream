// ceil for the small numbers used here
fn ceil_int(v: float) -> [] int {
    let t = truncate(v);
    if float_of(t) < v {
        return t + 1;
    }
    return t;
}

// Weed the digits so that they are the closest to w among the shortest in the interval, or say that this cannot be told (false): Loitsch's `RoundWeed`, every comparison unsigned.
fn round_weed[&d](digits: &!d [int], length: int, dist: int, unsafe_i: int, rest0: int, ten_kappa: int, unit: int) -> [] bool {
    var rest = rest0;
    let small = wrapping_sub(dist, unit);
    let big = wrapping_add(dist, unit);
    var go = true;
    while go {
        if ult(rest, small) && !ult(wrapping_sub(unsafe_i, rest), ten_kappa) {
            let rt = wrapping_add(rest, ten_kappa);
            if ult(rt, small) || !ult(wrapping_sub(small, rest), wrapping_sub(rt, small)) {
                digits[length - 1] = digits[length - 1] - 1;
                rest = rt;
            } else {
                go = false;
            }
        } else {
            go = false;
        }
    }
    if ult(rest, big) && !ult(wrapping_sub(unsafe_i, rest), ten_kappa) {
        let rt = wrapping_add(rest, ten_kappa);
        if ult(rt, big) || ult(wrapping_sub(rt, big), wrapping_sub(big, rest)) {
            return false;
        }
    }
    let two_unit = wrapping_mul(2, unit);
    let four_unit = wrapping_mul(4, unit);
    return !ult(rest, two_unit) && !ult(wrapping_sub(unsafe_i, four_unit), rest);
}

// The shortest digits of the scaled interval: answers (length, kappa, ok), the digits in `digits`.
fn digit_gen[&d](low_f: int, w_f: int, high_f: int, e: int, digits: &!d [int]) -> [] (int, int, bool) {
    var unit = 1;
    let too_low = wrapping_sub(low_f, 1);
    let too_high = wrapping_add(high_f, 1);
    var unsafe_i = wrapping_sub(too_high, too_low);
    let shift = 0 - e;
    let one = 1 << shift;
    var integrals = lsr(too_high, shift);
    var fractionals = too_high & one - 1;
    // the biggest power of ten not above the integral part
    var divisor = 0;
    var kappa = 0;
    if integrals > 0 {
        divisor = 1;
        kappa = 1;
        while divisor * 10 <= integrals {
            divisor = divisor * 10;
            kappa = kappa + 1;
        }
    }
    var length = 0;
    while kappa > 0 {
        let digit = integrals / divisor;
        digits[length] = digit;
        length = length + 1;
        integrals = integrals % divisor;
        kappa = kappa - 1;
        let rest = wrapping_add(integrals << shift, fractionals);
        if ult(rest, unsafe_i) {
            let ok = round_weed(digits, length, wrapping_sub(too_high, w_f), unsafe_i, rest, divisor << shift, unit);
            return (length, kappa, ok);
        }
        divisor = divisor / 10;
    }
    var more = true;
    while more {
        fractionals = wrapping_mul(fractionals, 10);
        unit = unit * 10;
        unsafe_i = wrapping_mul(unsafe_i, 10);
        let digit = lsr(fractionals, shift);
        digits[length] = digit;
        length = length + 1;
        fractionals = fractionals & one - 1;
        kappa = kappa - 1;
        if ult(fractionals, unsafe_i) {
            let ok = round_weed(digits, length, wrapping_mul(wrapping_sub(too_high, w_f), unit), unsafe_i, fractionals, one, unit);
            return (length, kappa, ok);
        }
        if length >= 20 {
            more = false;
        }
    }
    return (length, kappa, false);
}

// `x` positive, finite. Answers (d, k) with x = d * 10^k, d the shortest digits, or (-1, 0).
fn grisu(x: float) -> [] (int, int) {
    let bits = bits_of(x);
    let raw = bits & 0xfffffffffffff;
    let ex = bits >> 52 & 0x7ff;
    var f = raw;
    var e = 0 - 1074;
    if ex != 0 {
        f = raw | 1 << 52;
        e = ex - 1075;
    }
    let lower_closer = raw == 0 && ex > 1;
    // w, normalized
    var wf = f;
    var we = e;
    while wf & 1 << 62 == 0 && wf & 1 << 63 == 0 {
        wf = wf << 1;
        we = we - 1;
    }
    if wf & 1 << 63 == 0 {
        wf = wf << 1;
        we = we - 1;
    }
    // m_plus, normalized
    var pf = (f << 1) + 1;
    var pe = e - 1;
    while pf & 1 << 63 == 0 {
        pf = pf << 1;
        pe = pe - 1;
    }
    var mf = (f << 1) - 1;
    var me = e - 1;
    if lower_closer {
        mf = (f << 2) - 1;
        me = e - 2;
    }
    mf = mf << me - pe;
    me = pe;
    // the cached power of ten that brings the product's exponent into [-60, -32]
    let min_exp = 0 - 60 - (we + 64);
    let k = ceil_int(float_of(min_exp + 63) * 0.30102999566398114);
    let index = (348 + k - 1) / 8 + 1;
    let cf = cached_f[index];
    let ce = cached_e[index];
    let mk = 0 - 348 + 8 * index;
    let sw = mul_f(wf, cf);
    let sp = mul_f(pf, cf);
    let sm = mul_f(mf, cf);
    let se = we + ce + 64;
    var result = (0 - 1, 0);
    region a {
        let digits = alloc_slice[a](24, 0);
        let (length, kappa, ok) = digit_gen(sm, sw, sp, se, digits);
        if ok && length > 0 && length <= 17 {
            var d = 0;
            var j = 0;
            while j < length {
                d = d * 10 + digits[j];
                j = j + 1;
            }
            result = (d, kappa - mk);
        }
    }
    return result;
}

// ---- a precision (`float-printing.md` §10) -------------------------------------------------------------------------------------------------

// Write `x` into `out` with exactly `prec` digits after the point, and answer
// how many bytes that took (`prec == 0` writes no point). The value is the
// exact binary value of `x`, rounded half to even at `prec` places: `0.125`
// with two places is `0.12`, `2.5` with none is `2`, `0.375` with two is
// `0.38`. A negative value that rounds to zero keeps its sign (`-0.00`), as
// does `-0.0`; `NaN`, `inf` and `-inf` are written as they are whatever
// `prec` is. Answers -1 if `out` is too short or `prec` is negative, and
// refuses a `prec` the buffer cannot hold (`prec > len(out) - 2`) before any
// work is done.
//
// With `x = m * 2^e` the number printed is `N = round(R / S)` for integers
// `R` and `S`: `R = m * 2^e * 10^prec`, `S = 1` for a non-negative `e`, else
// `R = m * 10^prec`, `S = 2^-e`. There is no division: `S` is scaled by ten
// while the next scaling still fits under `R`, which gives `q`, the number of
// digits of `R / S`, and then each digit is at most nine subtractions
// (§3.2). What is left over is `frac(R / S) = r / S`, so `2r` against `S`
// decides the rounding, and a carry through nines may make the number one
// digit longer. The point goes `prec` digits from the right.
pub fn float_fixed_into[&o](out: &!o [byte], x: float, prec: int) -> [] int {
    if prec < 0 || prec > 0 && prec > len(out) - 2 {
        return 0 - 1;
    }
    if is_nan(x) {
        return put(out, 0, "NaN");
    }
    let bits = bits_of(x);
    var at = 0;
    if bits < 0 {
        at = put(out, 0, "-");
        if at < 0 {
            return 0 - 1;
        }
    }
    if bits & 0x7fffffffffffffff == 0x7ff0000000000000 {
        return put(out, at, "inf");
    }

    let m = mantissa(bits);
    let e = exponent_of(bits);
    // How wide R and S can get, in bits: m * 2^e (or m), times 10^prec at
    // 3.33 bits a place, or 2^-e; four limbs of slack for scaling S by ten.
    var wide = 54;
    if e > 0 {
        wide = 54 + e;
    }
    if 0 - e + 2 > wide {
        wide = 0 - e + 2;
    }
    let n = (wide + 4 * prec) / 32 + 4;

    var written = 0 - 1;
    region a {
        let r = alloc_slice[a](n, 0);
        let s = alloc_slice[a](n, 0);
        let t = alloc_slice[a](n, 0);
        // The digits of N: at most 309 before the point, `prec` after, and
        // one more if a carry runs through all of them.
        let digits = alloc_slice[a](prec + 330, 0);

        bignum.set(r, m);
        bignum.set(s, 1);
        if e >= 0 {
            bignum.shift_left(r, e);
            bignum.mul_pow10(r, prec);
        } else {
            bignum.mul_pow10(r, prec);
            bignum.shift_left(s, 0 - e);
        }

        // S becomes S * 10^(q-1), the largest such that it is still at most
        // R, or S itself if R is smaller: R / S is then in [1, 10) or below 1.
        var q = 1;
        var scaling = true;
        while scaling {
            bignum.copy(t, s);
            bignum.mul_small(t, 10);
            if bignum.compare(t, r) <= 0 {
                bignum.copy(s, t);
                q = q + 1;
            } else {
                scaling = false;
            }
        }

        var i = 0;
        while i < q {
            var d = 0;
            while bignum.compare(r, s) >= 0 {
                bignum.subtract(r, s);
                d = d + 1;
            }
            digits[i] = d;
            if i + 1 < q {
                bignum.mul_small(r, 10);
            }
            i = i + 1;
        }

        // What is left is below S: its double against S is the rounding.
        bignum.copy(t, r);
        bignum.mul_small(t, 2);
        let c = bignum.compare(t, s);
        if c > 0 || c == 0 && digits[q - 1] % 2 == 1 {
            var j = q - 1;
            var carrying = true;
            while carrying && j >= 0 {
                if digits[j] == 9 {
                    digits[j] = 0;
                    j = j - 1;
                } else {
                    digits[j] = digits[j] + 1;
                    carrying = false;
                }
            }
            if carrying {
                var k = q;
                while k > 0 {
                    digits[k] = digits[k - 1];
                    k = k - 1;
                }
                digits[0] = 1;
                q = q + 1;
            }
        }

        // N has q digits; `prec` of them follow the point, with zeros in
        // front when there are fewer.
        var whole = 1;
        if q > prec {
            whole = q - prec;
        }
        var total = at + whole;
        if prec > 0 {
            total = total + 1 + prec;
        }
        if total <= len(out) {
            var p = at;
            if q > prec {
                var w = 0;
                while w < whole {
                    p = put_digit(out, p, digits[w]);
                    w = w + 1;
                }
            } else {
                p = put_digit(out, p, 0);
            }
            if prec > 0 {
                p = put(out, p, ".");
                var f = 0;
                while f < prec {
                    // Fraction digit f is digit (whole + f) of N, or a zero
                    // while that is before N's first digit.
                    var d = 0;
                    if q > prec {
                        d = digits[whole + f];
                    } else if f >= prec - q {
                        d = digits[f - (prec - q)];
                    }
                    p = put_digit(out, p, d);
                    f = f + 1;
                }
            }
            written = p;
        }
    }
    return written;
}
