// GENERATED by `scripts/p256_tables.py`; do not edit. `python3 scripts/p256_tables.py --check` fails
// when this file is not what the script prints.
//
// `std.p256_comb` -- the generator's tables for `std.p256_pt` (`docs/p256-fast.md` §6, §7): affine
// points, x then y, each coordinate in Montgomery form (x * 2^280 mod p) as ten limbs of 28 bits,
// least significant first. A `static` is evaluated while compiling and is read-only data in the
// binary (`docs/compile-time-data.md`): nothing is built when a program runs.
//
// - `comb`: (j + 1) * 16^i * G, i in 0..64, j in 0..7, at word (8 i + j) * 20: the multiples a
//   signed four-bit digit selects, 65 positions of 8.
// - `odd`: (2k + 1) * 2^(65 j) * G, j in 0..3, k in 0..31, at word 640 j + 20 k: the odd multiples
//   to 63 G (j = 0), and of 2^65 G, 2^130 G and 2^195 G for the verification against a key's
//   table (`docs/p256-fast.md` §11).

// The static bodies hold their own literal and decode it inline: a function they called would be
// emitted into every program built with `--std` (`modules::std_declarations_cost_nothing_unless_called`).
// A hex digit's value: `(c >> 6) * 9 + (c & 15)` is 0 to 9 for '0' to '9' and 10 to 15 for 'a' to 'f'.
pub static comb: [int] {
    let t = alloc_slice[static](10400, 0);
    let s = "";
    var i = 0;
    while i < 10400 {
        var v = 0;
        var j = 0;
        while j < 7 {
            let c = int_of(s[7 * i + j]);
            v = v * 16 + (c >> 6) * 9 + (c & 15);
            j = j + 1;
        }
        t[i] = v;
        i = i + 1;
    }
    return t;
}

pub static odd: [int] {
    let t = alloc_slice[static](2560, 0);
    let s = "";
    var i = 0;
    while i < 2560 {
        var v = 0;
        var j = 0;
        while j < 7 {
            let c = int_of(s[7 * i + j]);
            v = v * 16 + (c >> 6) * 9 + (c & 15);
            j = j + 1;
        }
        t[i] = v;
        i = i + 1;
    }
    return t;
}

// Word `i` of `comb` (another module reaches a static through a function).
pub fn comb_at(i: int) -> [] int {
    return comb[i];
}

// Word `i` of `odd`.
pub fn odd_at(i: int) -> [] int {
    return odd[i];
}

// The 20 words of a `comb` point at word `at`, as a slice (its length is known, so reading it
// costs no bounds check per word).
pub fn comb_row(at: int) -> [] &static [int] {
    return comb[at..at + 20];
}

// The 20 words of an `odd` point at word `at`.
pub fn odd_row(at: int) -> [] &static [int] {
    return odd[at..at + 20];
}
