// `log1p` of a form that keeps the small answer's digits below it, and
// `log(|x|) + ln 2` past 2^28, where `x^2 + 1` would overflow for no benefit.
pub fn asinh(x: float) -> [] float {
    if is_nan(x) {
        return x;
