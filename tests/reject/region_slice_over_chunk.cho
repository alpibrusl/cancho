//~ ERROR a region holds 65536 bytes
//~ RULE region-chunk-exceeded

// `docs/region-limit.md` §2: a region is one 65,536-byte chunk, and 8193
// ints are 65,544 bytes, so this passed `check` and died at run time with
// no message until the size of a constant allocation was checked. The
// remedy is the heap (`box_slice`), which has no such limit.

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(args);
    release(ffi);
    release(fs);
    release(heap);
    release(io);
    var n = 0;
    region r {
        let t = alloc_slice[r](8193, 0);
        n = len(t);
    }
    return n;
}
