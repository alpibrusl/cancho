//~ ERROR `verbose` performs `args`, which its row [] does not declare; narrow
//~ RULE effect-not-declared

fn verbose[&a](args: &a Args) -> [] bool {
    return arg_count(args) > 1;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(ffi);
    release(fs);
    release(heap);
    release(io);
    var loud = false;
    borrow args as &a in {
        loud = verbose(a);
    }
    release(args);
    if loud {
        return 1;
    }
    return 0;
}
