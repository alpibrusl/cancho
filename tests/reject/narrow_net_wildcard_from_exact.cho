//~ ERROR cannot be narrowed
//~ RULE capability-not-narrowable

// `*.0.0.1` admits more hosts than `127.0.0.1`, so an exact host cannot be narrowed to a wildcard. (`docs/net-bounds.md` §2.3.)

edition 10;
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(clock);
    release(signals); release(exec); release(tty);
    let a = narrow(net, "127.0.0.1:9");
    let b = narrow(a, "*.0.0.1:9");
    release(b);
    return 0;
}
