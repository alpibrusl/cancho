//~ ERROR expected `fn(int) -> [] int`, found `fn(int) -> [] bool`
//~ RULE type-mismatch
// `docs/function-signatures.md` 2.2: the result is compared too. `apply` answers what its `f` answers as an `int`.

fn positive(x: int) -> [] bool {
    return x > 0;
}

fn apply(f: fn(int) -> [] int, x: int) -> [] int {
    return f(x);
}

fn main(world: World) -> [] int {
    release(world);
    return apply(positive, 5);
}
