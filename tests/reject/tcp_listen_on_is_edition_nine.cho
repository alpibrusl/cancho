//~ ERROR `tcp_listen_on` is not a function in this program
//~ RULE not-a-function
// `docs/native-sockets.md` §12.2: `tcp_listen_on` is edition 9. An older file may declare its own,
// so to it the name is not a builtin at all (`editions.md` §7).
edition 8;

fn run(bound: Net("8080")) -> [] int {
    var status = 1;
    borrow bound as &n in {
        match tcp_listen_on(n, "127.0.0.1", 8080, 8, 0) {
            Listening::Ok(l) => { listener_close(l); status = 0; }
            Listening::Failed(e) => { }
        }
    }
    release(bound);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(clock);
    release(signals); release(exec); release(tty);
    let bound = narrow(net, "8080");
    return run(bound);
}
