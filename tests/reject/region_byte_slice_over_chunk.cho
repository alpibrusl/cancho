//~ ERROR a region holds 65536 bytes
//~ RULE region-chunk-exceeded

// `docs/region-limit.md` §2: the size is bytes, not elements. 65,537
// bytes is one over; the same count of ints would be eight times over.

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(args);
    release(ffi);
    release(fs);
    release(heap);
    release(io);
    var n = 0;
    region r {
        let t = alloc_slice[r](65537, byte_of(0));
        n = len(t);
    }
    return n;
}
