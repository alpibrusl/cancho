//~ ERROR cannot be narrowed
//~ RULE capability-not-narrowable

// `*.0.0.1` is one label ahead of `.0.0.1`; `*.127.0.0.1` is one label ahead of a longer suffix, which is a different set and not a subset of it. (`docs/net-bounds.md` §2.3.)

edition 10;
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(clock);
    release(signals); release(exec); release(tty);
    let a = narrow(net, "*.0.0.1:9");
    let b = narrow(a, "*.127.0.0.1:9");
    release(b);
    return 0;
}
