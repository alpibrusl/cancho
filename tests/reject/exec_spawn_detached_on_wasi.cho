//~ ERROR processes and pipes do not exist on `wasm32-wasip1`
//~ RULE unsupported-on-target
//~ TARGET wasm32-wasip1

// `docs/processes.md` §4.11: WebAssembly has no processes to start, detached
// or not.

edition 9;
fn start[&x](exec: &x Exec("/bin")) -> [exec("/bin"), exec_detached] int {
    match exec_spawn_detached(exec, "/bin/true", "", "", Stdio::Null, Stdio::Null, Stdio::Null) {
        Spawned::Ok(child) => { return child_release(child); }
        Spawned::Failed(e) => { return e; }
    }
}
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(net); release(clock); release(signals); release(tty);
    let bin = narrow(exec, "/bin");
    var n = 0;
    borrow bin as &x in { n = start(x); }
    release(bin);
    return n;
}
