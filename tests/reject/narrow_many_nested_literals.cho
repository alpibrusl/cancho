//~ ERROR are nested
//~ RULE capability-not-narrowable

// One literal inside another. The inner child grants nothing the outer one does not; lending a narrower view of a held path is a separate design (section 9, question 2).
// (`docs/narrowing-into-several.md` section 5.)

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(io); release(ffi); release(heap); release(args);
    let (a, b) = narrow(fs, "/var/lib/app", "/var/lib/app/cache");
    release(a); release(b);
    return 0;
}
