//~ ERROR processes and pipes do not exist on `wasm32-wasip1`
//~ RULE unsupported-on-target
//~ TARGET wasm32-wasip1

// `docs/processes.md` §4.13: WebAssembly has no `Exec`, so nothing can ask whether a program is inside its bound.
// (`fs_covers` is not refused: `Fs` exists there, and the question is the one `open_read` is asked.)

edition 9;

fn allowed[&x](exec: &x Exec("/bin")) -> [] bool {
    return exec_covers(exec, "/bin/true");
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(net);
    release(clock);
    release(signals);
    release(tty);
    let bin = narrow(exec, "/bin");
    var yes = false;
    borrow bin as &x in {
        yes = allowed(x);
    }
    release(bin);
    if yes {
        return 0;
    }
    return 1;
}
