//~ ERROR is not a borrowed `Exec`
//~ RULE capability-misused

// `docs/processes.md` §4.14: the capability is the borrowed `Exec`.

edition 9;
fn start[&x, &d](fs: &x Fs(""), dir: &d Dir) -> [] int {
    match exec_spawn_under(fs, dir, "w", "", "", Stdio::Null, Stdio::Null, Stdio::Null) {
        Spawned::Ok(c) => {
            match child_wait(c) {
                Exited::Code(n) => { return n; }
                Exited::Signaled(s) => { return 1; }
                Exited::Failed(e) => { return 1; }
            }
        }
        Spawned::Failed(e) => { return e; }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(net); release(clock); release(signals); release(tty);
    release(exec);
    return 0;
}
