//~ ERROR narrow(signals, "TERM,INT")
//~ RULE capability-not-narrowable

// `Signals` narrows to a set in one capability (`docs/signals.md` section 2.1).
// (`docs/narrowing-into-several.md` section 5.)

edition 6;
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(net); release(clock);
    let (a, b) = narrow(signals, "TERM", "INT");
    release(a); release(b);
    return 0;
}
