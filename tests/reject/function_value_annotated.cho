//~ ERROR expected `fn(int) -> [] int`, found `fn(bool) -> [] int`
//~ RULE type-mismatch
// `docs/function-signatures.md` 2: the comparison is where types are compared, not where functions are called: a `let` that writes the type holds the function to it.

fn takes_bool(b: bool) -> [] int {
    if b {
        return 1;
    }
    return 0;
}

fn main(world: World) -> [] int {
    release(world);
    let f: fn(int) -> [] int = takes_bool;
    return f(5);
}
