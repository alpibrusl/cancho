//~ ERROR performs `dir_symlink`, which its row
//~ RULE effect-not-declared

// `docs/directory-links.md` §4, D2: making a link is not writing a file. A
// function that borrows a `Dir` and declares `dir_write` still has to say
// `dir_symlink` to make one, so an authority report shows who could.

edition 12;

fn link[&d](dir: &d Dir) -> [dir_write] int {
    match dir_symlink(dir, "out", "target") {
        Done::Ok(n) => {
            return n;
        }
        Done::Failed(e) => {
            return 0 - e;
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty, camera, mic, speaker } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(out); release(ports); release(clock); release(signals); release(exec); release(tty); release(camera); release(mic); release(speaker);
    return 0;
}
