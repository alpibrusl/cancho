//~ ERROR expected `fn(&!i Io, int) -> [] int`, found `fn(&!i Io, int) -> [io_write] int`
//~ RULE type-mismatch
// `docs/function-signatures.md` 2.3: the row is part of the type. `apply` declares `[]` because the type of its `f` says `[]`; a function that writes passed for it would write under a row
// that says nothing is written.

fn loud[&i](io: &!i Io, x: int) -> [io_write] int {
    write_bytes(io, "x\n");
    return x;
}

fn apply[&i](io: &!i Io, f: fn(&!i Io, int) -> [] int, x: int) -> [] int {
    return f(io, x);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    var r = 0;
    borrow mut io as &!i in {
        r = apply(i, loud, 5);
    }
    release(io);
    return r;
}
