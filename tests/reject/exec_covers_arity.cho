//~ ERROR `exec_covers` takes 2 arguments
//~ RULE arity-mismatch

// `docs/processes.md` §4.13: the capability and the path, and nothing else.

edition 9;
fn allowed[&x](exec: &x Exec("/bin")) -> [] bool {
    return exec_covers(exec);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(net);
    release(clock);
    release(signals);
    release(tty);
    release(exec);
    return 0;
}
