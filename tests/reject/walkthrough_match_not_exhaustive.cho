//~ ERROR this `match` does not cover `Shape::Rect`
//~ RULE match-not-exhaustive

enum Shape { Circle(int), Rect(int, int) }

fn area(s: Shape) -> [] int {
    match s {
        Shape::Circle(r) => { return r * r * 3; }
    }
    return 0;
}

fn main(world: World) -> [] int {
    release(world);
    return area(Shape::Circle(2));
}
