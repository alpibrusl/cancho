//~ ERROR performs `udp_send`, which its row [] does not declare
//~ RULE effect-not-declared

// `docs/udp.md` §4: replying to a sender is sending, so it carries the same
// path-free label (`udp_send`) as any other datagram send, and a function
// that borrows a `Udp` to reply must declare it.

edition 5;
fn reply[&c, &b](sock: &!c Udp, bytes: &b [byte], ticket: int) -> [] int {
    match udp_send_to(sock, bytes, ticket) {
        Sent::Wrote(n) => {
            return n;
        }
        Sent::Again => {
            return 0;
        }
        Sent::Failed(e) => {
            return 0 - 1;
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(clock);
    release(net);
    return 0;
}
