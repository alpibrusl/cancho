//~ ERROR `child_release` is not a function in this program
//~ RULE not-a-function

// `docs/processes.md` §4.11: `child_release`, `child_pid` and
// `exec_spawn_detached` are edition 9, so an edition-7 file that declares or
// calls them by those names is unchanged (`docs/editions.md` §5).

edition 7;
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(net); release(clock); release(signals);
    borrow exec as &x in {
        match exec_spawn(x, "/bin/true", "", "", Stdio::Null, Stdio::Null, Stdio::Null) {
            Spawned::Ok(child) => { child_release(child); }
            Spawned::Failed(e) => { }
        }
    }
    release(exec);
    return 0;
}
