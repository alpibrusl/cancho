//~ ERROR threads do not exist on `wasm32-wasip1`
//~ RULE unsupported-on-target
//~ TARGET wasm32-wasip1

// A program that is fine for the host and refused for WebAssembly: WASI
// preview 1 has no threads. Without this check it *built* for wasm and
// trapped the moment `spawn` ran (`docs/wasm.md`, W0.2); now the refusal
// names the function that reaches it and no code generator is involved.
//
// The same file passes `cancho check` with no `--target`, which is the
// point of the rule: it is a property of the target, not of the program.

edition 4;

fn worker(x: int) -> [] int {
    return x * 2;
}

fn main(world: World) -> [conc] int {
    let Split { io, ffi, fs, heap, args, net } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(net);

    let w = worker;
    let h = spawn(21, w);
    return join(h) - 42;
}
