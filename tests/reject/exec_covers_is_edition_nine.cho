//~ ERROR `exec_covers` is not a function in this program
//~ RULE not-a-function

// `docs/processes.md` §4.13: `exec_covers` is edition 9, so an edition-7 file that calls (or declares) a function by
// that name is unchanged (`docs/editions.md` §5, §6.4).

edition 7;
fn allowed[&x](exec: &x Exec("/bin")) -> [] bool {
    return exec_covers(exec, "/bin/true");
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    return 0;
}
