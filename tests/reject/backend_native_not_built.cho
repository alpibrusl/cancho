//~ ERROR The backend that was asked for cannot build this program
//~ RULE unsupported-by-backend
//~ BACKEND native --host linux
// `docs/native-backend.md` sections 8 and 13: `--backend native` is cancho's own backend, and it writes code for AArch64 (Linux, and no system). For another
// machine, here Linux on x86-64 whatever machine the gate runs on, it refuses every program by this rule and writes nothing. The same file passes
// `cancho check` with no `--backend`, or with `--backend llvm`: the refusal is the backend's, not the program's.
fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    return 0;
}
