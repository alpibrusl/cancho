//~ ERROR `0x1000..0x2000` and `0x1ff8..0x3000` share an address: the capabilities one `narrow` makes hold nothing in common
//~ RULE capability-not-narrowable
// `docs/mmio.md` 3: two capabilities cut from one share no address, so no register has two holders.
edition 13;

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty, camera, mic, speaker, mmio } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(out); release(ports); release(clock);
    release(signals); release(exec); release(tty); release(camera); release(mic); release(speaker);
    let (a, b) = narrow(mmio, "0x1000..0x2000", "0x1ff8..0x3000");
    release(a);
    release(b);
    return 0;
}
