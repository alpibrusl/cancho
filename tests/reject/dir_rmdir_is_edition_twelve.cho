//~ ERROR `dir_rmdir` is not a function in this program
//~ RULE not-a-function

// `docs/directory-links.md` §3 and §5: `dir_rmdir` is edition 12. An older
// file may already declare its own `dir_rmdir`, so to it the name is not a
// builtin at all (`editions.md` §7).

edition 11;

fn remove[&d](dir: &d Dir) -> [dir_write] int {
    match dir_rmdir(dir, "out") {
        Done::Ok(n) => {
            return n;
        }
        Done::Failed(e) => {
            return 0 - e;
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty } = split(world);
    release(io); release(ffi); release(fs); release(heap); release(args); release(out); release(ports); release(clock); release(signals); release(exec); release(tty);
    return 0;
}
