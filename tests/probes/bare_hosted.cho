edition 14;

// bare_hosted.cho -- a program for a machine with no system (`docs/freestanding.md` 5) that has, in a function nothing calls, a builtin that needs one. It builds for
// `aarch64-none-elf`: what is refused there is a call the program reaches. tests/commands/freestanding.sh builds it, and builds it again with the call reached.

fn say[&i](io: &!i Io, c: int) -> [io_write] int {
    return putchar(io, c);
}

fn double(x: int) -> [] int {
    return x * 2;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty, camera, mic, speaker, mmio, cpu } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(out);
    release(ports);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    release(camera);
    release(mic);
    release(speaker);
    release(mmio);
    release(cpu);
    return double(21) - 42;
}
