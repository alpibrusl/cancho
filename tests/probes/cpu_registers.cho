    cpu_write(cpu, "icc_sgi1r_el1", sum);
    cpu_write(cpu, "icc_asgi1r_el1", sum);
    return sum;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, out, ports, clock, signals, exec, tty, camera, mic, speaker, mmio, cpu } = split(world);
    release(io);
    release(ffi);
    release(fs);
    release(heap);
    release(args);
    release(out);
    release(ports);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    release(camera);
    release(mic);
    release(speaker);
    release(mmio);
    var r = 0;
    borrow mut cpu as &!c in {
        r = all(c);
    }
    release(cpu);
    return r;
}
