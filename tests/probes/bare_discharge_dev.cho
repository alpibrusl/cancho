edition 13;
module probe_dev;

// bare_discharge_dev.cho -- the system of tests/probes/bare_discharge_own.cho (`docs/bare-system.md` 12): what the program writes goes to a device at 0x1000, so `out`
// and `err` have an `mmio` of their own, which the function that lends performs. There is no `key`: nothing here answers `io_read`. `used[0]` is how many bytes were
// written, `used[1]` how many times a stream was flushed.

pub fn out[&c, &u, &p](con: &!c Mmio("0x1000..0x1010"), used: &!u [int], p: &p [byte]) -> [mmio("0x1000..0x1010")] int {
    var i = 0;
    while i < len(p) {
        mmio_write8(con, 4096, int_of(p[i]));
        used[0] = used[0] + 1;
        i = i + 1;
    }
    return i;
}

pub fn err[&c, &u, &p](con: &!c Mmio("0x1000..0x1010"), used: &!u [int], p: &p [byte]) -> [mmio("0x1000..0x1010")] int {
    return out(con, used, p);
}

pub fn flush[&c, &u](con: &!c Mmio("0x1000..0x1010"), used: &!u [int]) -> [] int {
    used[1] = used[1] + 1;
    return 0;
}

pub fn arguments[&c, &u](con: &!c Mmio("0x1000..0x1010"), used: &!u [int]) -> [] int {
    return 1;
}

pub fn argument[&c, &u, &t](con: &!c Mmio("0x1000..0x1010"), used: &!u [int], n: int, into: &!t [byte]) -> [] int {
    if len(into) > 0 {
        into[0] = byte_of('p');
        return 1;
    }
    return 0;
}
