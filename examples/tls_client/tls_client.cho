// `tls_client` -- a real TLS handshake and round trip, and the first
// program here that links a library beyond libc.
//
//     tls_client <address> <port> <message>
//
// Connects over IPv4 (the same "no names" limit `examples/fetch/`
// documents -- nothing here can resolve one), performs a real TLS
// handshake, sends `<message>` followed by a newline, and writes
// whatever comes back to standard output.
//
// `docs/opaque-pointers.md` §1 grounded the nine OpenSSL calls this
// needs against the real header and a live handshake, and built the
// type that lets a handle like `SSL_CTX *` cross at all (`c_ptr`,
// §3) -- but its own §5 could not compile this program: `cancho
// build` had no way to ask for `-lssl -lcrypto`. `docs/foreign-linking.md`
// is that gap, closed. This is what it unblocks:
//
//     cancho build tls_client.cho --std -l ssl -l crypto -o tls_client
//
// **What this program does not attempt**, on purpose, per
// `docs/opaque-pointers.md` §3's own list: no certificate
// verification. A client SSL context's default verify mode is
// `SSL_VERIFY_NONE` (nothing here calls `SSL_CTX_set_verify` to
// change it), so this connects to whatever answers on the address
// given, self-signed or not -- exactly right for exercising the
// handshake and the link step this document is about, and exactly
// wrong for anything that has to trust who it is talking to.
// `docs/opaque-pointers.md` §3's "does not solve certificate
// verification's own trust story" stays true here too; a real client
// is a second, separate slice.

edition 3;

import std.bytes;
import std.io;
// `docs/many-files.md`: a program is a set of files, and each is in a
// module -- so the raw socket stays on edition 1 in its own file
// (`socket.cho`, whose own header says why) while this one uses `c_ptr`.
import socket;

// ---------------------------------------------------------------------
// OpenSSL: `docs/opaque-pointers.md` §1's nine calls, `c_ptr` for every
// handle
// ---------------------------------------------------------------------

extern fn TLS_client_method[&f](ffi: &f Ffi("libc")) -> [ffi("libc")] c_ptr;

extern fn SSL_CTX_new[&f](ffi: &f Ffi("libc"), method: c_ptr) -> [ffi("libc")] c_ptr;

extern fn SSL_new[&f](ffi: &f Ffi("libc"), ctx: c_ptr) -> [ffi("libc")] c_ptr;

// A C `int` result is declared `c_int`, which sign-extends it once at the boundary. Declared `int`, a failing `SSL_connect` (which
// answers -1) was read as 4294967295, the `<= 0` test below was false, and the program went on to write its request to a session
// that never existed. (Against a server that accepts and closes it is still killed by SIGPIPE, now by OpenSSL's own write of a fatal
// alert; `docs/tls-nonblocking.md` section 2.) Found by `examples/tls_nb/gaps/g13_int_vs_c_int.cho`.
extern fn SSL_set_fd[&f](ffi: &f Ffi("libc"), ssl: c_ptr, fd: int) -> [ffi("libc")] c_int;

extern fn SSL_connect[&f](ffi: &f Ffi("libc"), ssl: c_ptr) -> [ffi("libc")] c_int;

// `buf` crosses as a pointer and a length, exactly the way `write`/`read`
// already do (`docs/strings.md` §6) -- `SSL_write`/`SSL_read`'s own `num`
// parameter is that length, so it needs no separate `int` argument here.
extern fn SSL_write[&f, &b](ffi: &f Ffi("libc"), ssl: c_ptr, buf: &b [byte]) -> [ffi("libc")] c_int;

extern fn SSL_read[&f, &b](ffi: &f Ffi("libc"), ssl: c_ptr, buf: &!b [byte]) -> [ffi("libc")] c_int;

extern fn SSL_shutdown[&f](ffi: &f Ffi("libc"), ssl: c_ptr) -> [ffi("libc")] c_int;

extern fn SSL_free[&f](ffi: &f Ffi("libc"), ssl: c_ptr) -> [ffi("libc")] int;

extern fn SSL_CTX_free[&f](ffi: &f Ffi("libc"), ctx: c_ptr) -> [ffi("libc")] int;

// ---------------------------------------------------------------------
// The command line and the address -- unchanged from `examples/fetch/`
// ---------------------------------------------------------------------

fn octets_of[&t, &o](text: &t [byte], out: &!o [byte]) -> [] bool {
    var octet = 0;
    var digits = 0;
    var filled = 0;
    var i = 0;
    while i < len(text) {
        let c = int_of(text[i]);
        if c == '.' {
            if digits == 0 || filled == 3 {
                return false;
            }
            out[filled] = byte_of(octet);
            filled = filled + 1;
            octet = 0;
            digits = 0;
        } else {
            let digit = bytes.digit_of(c);
            if digit < 0 || digits == 3 {
                return false;
            }
            octet = octet * 10 + digit;
            if octet > 255 {
                return false;
            }
            digits = digits + 1;
        }
        i = i + 1;
    }
    if digits == 0 || filled != 3 {
        return false;
    }
    out[3] = byte_of(octet);
    return true;
}

fn port_of[&a](text: &a [byte]) -> [] int {
    if len(text) == 0 || len(text) > 5 {
        return 0 - 1;
    }
    var value = 0;
    var i = 0;
    while i < len(text) {
        let digit = bytes.digit_of(int_of(text[i]));
        if digit < 0 {
            return 0 - 1;
        }
        value = value * 10 + digit;
        i = i + 1;
    }
    if value < 1 || value > 65535 {
        return 0 - 1;
    }
    return value;
}

// ---------------------------------------------------------------------
// TLS
// ---------------------------------------------------------------------

// The handshake, the write, and the read, in one function rather than
// three: `c_ptr` is only a recognized type name in an `extern fn`'s own
// parameter and return position (`docs/opaque-pointers.md` §4 --
// `c_int`'s precedent, kept), never in an ordinary function's signature,
// so `ssl` has to stay a local binding inferred from an extern call's
// return, never a parameter or return type of a helper of its own.
//
// Answers a status this program's own vocabulary, not `errno`'s: 4 for
// a handshake that never got a connection to speak of (every one of
// `SSL_CTX_new`/`SSL_new`/`SSL_connect` fails this way, and none of them
// says more without `SSL_get_error`'s reason codes, which nothing here
// needs yet), 5 for a write, 6 for a read, 0 for a full round trip.
fn tls_exchange[&f, &i, &m](libc: &f Ffi("libc"), io: &!i Io, fd: int, message: &m [byte]) -> [ffi("libc"), io_write] int {
    let method = TLS_client_method(libc);
    if method == null_ptr() {
        return 4;
    }
    let ctx = SSL_CTX_new(libc, method);
    if ctx == null_ptr() {
        return 4;
    }
    let ssl = SSL_new(libc, ctx);
    // `ctx` is not owned by this program (`docs/opaque-pointers.md` §3:
    // `c_ptr` is `val`, not linear) -- `SSL_new` keeps its own reference,
    // so it is freed here rather than carried any further.
    SSL_CTX_free(libc, ctx);
    if ssl == null_ptr() {
        return 4;
    }
    if SSL_set_fd(libc, ssl, fd) <= 0 {
        SSL_free(libc, ssl);
        return 4;
    }
    if SSL_connect(libc, ssl) <= 0 {
        SSL_free(libc, ssl);
        return 4;
    }

    var status = 0;
    region scratch {
        let request = alloc_slice[scratch](len(message) + 1, byte_of(0));
        var at = 0;
        while at < len(message) {
            request[at] = message[at];
            at = at + 1;
        }
        request[len(message)] = byte_of('\n');

        var sent = 0;
        var failed = false;
        while sent < len(request) && !failed {
            let n = SSL_write(libc, ssl, request[sent..len(request)]);
            if n <= 0 {
                failed = true;
            } else {
                sent = sent + n;
            }
        }
        if failed {
            status = 5;
        } else {
            // `docs/opaque-pointers.md` §6's own finding applies here
            // too: a fixed-size reply buffer is enough because this
            // program's own test server (an echo that reverses one
            // line) never sends back more than it was sent.
            let reply = alloc_slice[scratch](4096, byte_of(0));
            let got = SSL_read(libc, ssl, reply);
            if got <= 0 {
                status = 6;
            } else {
                io.write_all(io, reply[0..got]);
            }
        }
    }
    // Reached on every path past the handshake, success or failure: a
    // shutdown/free that only ran when nothing had gone wrong would
    // leak the handle on the write- and read-failure paths.
    SSL_shutdown(libc, ssl);
    SSL_free(libc, ssl);
    return status;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net } = split(world);
    release(fs);
    release(heap);
    release(net);

    let libc = narrow(ffi, "libc");
    var status = 2;
    borrow mut io as &!i in {
        borrow libc as &f in {
            borrow args as &g in {
                if arg_count(g) != 4 {
                    io.error_all(i, "usage: tls_client <address> <port> <message>\n");
                } else {
                    region scratch {
                        let octets = alloc_slice[scratch](4, byte_of(0));
                        let port = port_of(arg(g, 2));
                        if !octets_of(arg(g, 1), octets) {
                            io.error_all(i, "tls_client: the address must be four decimal octets; there is no name resolution\n");
                        } else if port < 0 {
                            io.error_all(i, "tls_client: the port must be 1..65535\n");
                        } else {
                            let fd = socket.open(f, octets, port);
                            if fd < 0 {
                                io.error_all(i, "tls_client: could not connect\n");
                                status = 3;
                            } else {
                                status = tls_exchange(f, i, fd, arg(g, 3));
                                if status == 4 {
                                    io.error_all(i, "tls_client: the TLS handshake failed\n");
                                } else if status == 5 {
                                    io.error_all(i, "tls_client: the TLS write failed\n");
                                } else if status == 6 {
                                    io.error_all(i, "tls_client: the TLS read failed\n");
                                }
                                socket.close_fd(f, fd);
                            }
                        }
                    }
                }
            }
        }
    }
    release(libc);
    release(args);
    release(io);
    return status;
}
