edition 7;

// cli.cho -- the `cancho` command line, written in cancho (`docs/cli-in-cancho.md`, issue #485).
//
// The first slice is `fmt [--check] FILE...`: each file is read, printed (`printing.cho`) into memory through the sink, formatted
// (`formatting.cho`), and the three checks of `docs/formatting.md` section 4 are run on the result before it is written over the file. The
// output and the exit status are those of `cancho fmt`:
//
//     formatted PATH         the file was rewritten                       would reformat PATH   (with --check, nothing is written)
//     PATH: not formatted: WHY   on the standard error, for a file that fails a check; ERR RULE FROM TO for one that does not parse
//
// Exit status 0, 1 if a file was refused (or, with `--check`, would change), 2 for a usage or an environment error.

import std.buffer;
import std.bytes;
import std.io as console;
import std.process;
import selfhost.ast;
import selfhost.printing;
import selfhost.jsonprint;
import selfhost.driver;
import selfhost.formatting;
import selfhost.rules;
import selfhost.lexcore as lc;
import selfhost.filewrite;
import selfhost.walk;
import selfhost.guidelines;
import selfhost.commandtree;
import selfhost.diagnose;
import selfhost.stdorder;
import selfhost.testscan;
import selfhost.satisfytext;
import selfhost.clibase;
import selfhost.clifmt;
import selfhost.cliprog;
import selfhost.clitest;
import selfhost.projfile;
import selfhost.cliproject;
import selfhost.clivcs;
import selfhost.clilock;
import selfhost.clifetch;
import selfhost.clipublish;
import selfhost.clisync;
import selfhost.clidir;

fn run[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_read, io_write, err_write, args, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec(""), clock, poll] int {
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "fmt") {
        return clifmt.fmt_command(heap, io, args, fs);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "check") {
        return cliprog.program_command(heap, io, args, fs, exec, clock, false, false, false, false, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "install") {
        return cliproject.install_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 3 && bytes.equal(arg(args, 1), "vcs") && bytes.equal(arg(args, 2), "log") {
        return clivcs.log_command(heap, io, args, fs);
    }
    if arg_count(args) >= 3 && bytes.equal(arg(args, 1), "vcs") && bytes.equal(arg(args, 2), "lock") {
        return clilock.lock_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 3 && bytes.equal(arg(args, 1), "vcs") && bytes.equal(arg(args, 2), "fetch") {
        return clifetch.fetch_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 3 && bytes.equal(arg(args, 1), "vcs") && bytes.equal(arg(args, 2), "resolve") {
        return clifetch.resolve_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 3 && bytes.equal(arg(args, 1), "vcs") && bytes.equal(arg(args, 2), "publish") {
        return clidir.publish_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 3 && bytes.equal(arg(args, 1), "vcs") && bytes.equal(arg(args, 2), "sync") {
        return clisync.sync_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "add") {
        return cliproject.add_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "build") && cliproject.wants_project(heap, io, args, fs, exec, clock, false) {
        return cliproject.build_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "build") {
        return cliprog.program_command(heap, io, args, fs, exec, clock, false, false, true, false, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "run") {
        return cliprog.program_command(heap, io, args, fs, exec, clock, false, false, true, true, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "test") && cliproject.wants_project(heap, io, args, fs, exec, clock, true) {
        return cliproject.test_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "test") {
        return clitest.test_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "satisfy") {
        return clitest.satisfy_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "authority-reached") {
        return cliprog.program_command(heap, io, args, fs, exec, clock, false, false, false, false, true);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "layout") {
        return cliprog.program_command(heap, io, args, fs, exec, clock, false, true, false, false, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "ids") {
        return cliprog.program_command(heap, io, args, fs, exec, clock, true, false, false, false, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "print") {
        return clifmt.one_file_command(heap, io, args, fs, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "ingest") {
        return clifmt.one_file_command(heap, io, args, fs, true);
    }
    if arg_count(args) >= 2 && (bytes.equal(arg(args, 1), "--help") || bytes.equal(arg(args, 1), "-h") || bytes.equal(arg(args, 1), "help")) {
        clibase.show(heap, io, commandtree.usage(heap, buffer.empty(heap, 12000)));
        return 0;
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "introspect") {
        return clifmt.tree_command(heap, io, args, fs, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "skill") {
        return clifmt.tree_command(heap, io, args, fs, true);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "agent-guidelines") {
        if arg_count(args) > 2 {
            console.error_all(io, "usage: `agent-guidelines` takes no arguments\n");
            return 2;
        }
        clibase.show(heap, io, guidelines.print(heap, buffer.empty(heap, 40000)));
        return 0;
    }
    console.error_all(io, "usage: cancho (fmt [--check] PATH... | print [--output json] FILE | ingest FILE | agent-guidelines)\n");
    return 2;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow fs as &f in {
                    borrow exec as &x in {
                        borrow clock as &k in {
                            status = run(h, i, a, f, x, k);
                        }
                    }
                }
            }
        }
    }
    release(clock);
    release(exec);
    release(fs);
    release(args);
    release(heap);
    release(io);
    return status;
}
