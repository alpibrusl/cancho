edition 7;

// cli.cho -- the `cancho` command line, written in cancho (`docs/cli-in-cancho.md`, issue #485).
//
// The first slice is `fmt [--check] FILE...`: each file is read, printed (`printing.cho`) into memory through the sink, formatted
// (`formatting.cho`), and the three checks of `docs/formatting.md` section 4 are run on the result before it is written over the file. The
// output and the exit status are those of `cancho fmt`:
//
//     formatted PATH         the file was rewritten                       would reformat PATH   (with --check, nothing is written)
//     PATH: not formatted: WHY   on the standard error, for a file that fails a check; ERR RULE FROM TO for one that does not parse
//
// Exit status 0, 1 if a file was refused (or, with `--check`, would change), 2 for a usage or an environment error.

import std.buffer;
import std.bytes;
import std.io as console;
import std.process;
import selfhost.ast;
import selfhost.printing;
import selfhost.jsonprint;
import selfhost.driver;
import selfhost.formatting;
import selfhost.rules;
import selfhost.lexcore as lc;
import selfhost.filewrite;
import selfhost.walk;
import selfhost.guidelines;
import selfhost.commandtree;
import selfhost.diagnose;
import selfhost.stdorder;
import selfhost.testscan;
import selfhost.satisfytext;

// The canonical text of a program, or why there is none: status 0, 1 (the first refusal, at `from` to `to`), 2 (it does not fit the room).
res struct Text {
    shown: buffer.Buffer,
    ok: int,
    rule: int,
    from: int,
    to: int,
}

// `how` is 0 to have the canonical text in the answer, 1 to have it written to the standard output, 2 to have the tree as JSON written there.
fn print_text[&h, &i, &x](heap: &!h Heap, io: &!i Io, src: &x [byte], how: int) -> [heap, io_write] Text {
    var out = buffer.empty(heap, len(src) + 64);
    var status = 0;
    var rule = 0;
    var from = 0;
    var to = 0;
    // The room the code would be written in has 200 integers a token; a long string literal is one token and as many bytes, so the count
    // is raised by the length of the text, which makes the room enough for the printed text of anything but a degenerate layout.
    let tokens = ast.count_tokens(src) + len(src) / 100 + 1;
    let state = box_slice(heap, ast.size_for(tokens, 1) + ast.emit_size(tokens), 0);
    borrow mut state as &!b in {
        let st = contents(b);
        ast.layout_emit(st, tokens, 1);
        ast.set_file(st, 0, 0, len(src));
        if ast.parse(st, src) != 0 {
            status = 1;
            rule = st[3];
            from = st[4];
            to = st[5];
        } else if how == 1 {
            // The printer's own refusal (3) has said what it has to say.
            if printing.print(io, st, src) != 0 {
                status = 3;
            }
        } else if how == 2 {
            if jsonprint.print(io, st, src) != 0 {
                status = 3;
            }
        } else {
            // The printer writes into the room the compiler would write code in, one byte to an integer (`sink.cho`).
            st[53] = 1;
            printing.print(io, st, src);
            if st[55] != 0 {
                status = 2;
            } else {
                var k = 0;
                while k < st[54] {
                    out = buffer.push(heap, out, byte_of(st[st[43] + k]));
                    k = k + 1;
                }
            }
        }
    }
    unbox_slice(heap, state);
    return Text { shown: out, ok: status, rule: rule, from: from, to: to };
}

// What came of formatting: the text, or, with a status, the sentence for `PATH: not formatted: ` (1) or the line for a file that does not
// parse (2).
res struct Made {
    out: buffer.Buffer,
    code: int,
}

fn sentence[&h](heap: &!h Heap, why: &static [byte]) -> [heap] buffer.Buffer {
    return buffer.append(heap, buffer.empty(heap, 64), why);
}

fn refusal_text[&h](heap: &!h Heap, rule: int, from: int, to: int) -> [heap] buffer.Buffer {
    var line = buffer.append(heap, buffer.empty(heap, 64), "ERR ");
    line = buffer.append(heap, line, rules.rule_tag(rule));
    line = buffer.append(heap, line, " ");
    line = buffer.push_nat(heap, line, from);
    line = buffer.append(heap, line, " ");
    line = buffer.push_nat(heap, line, to);
    return line;
}

// One pass of the formatter: the printer, then the aligner.
fn format_once[&h, &i, &x](heap: &!h Heap, io: &!i Io, src: &x [byte]) -> [heap, io_write] Made {
    let printed = print_text(heap, io, src, 0);
    let Text { shown, ok, rule, from, to } = printed;
    if ok == 1 {
        buffer.drop(heap, shown);
        return Made { out: refusal_text(heap, rule, from, to), code: 2 };
    }
    if ok == 2 {
        buffer.drop(heap, shown);
        return Made { out: sentence(heap, "the canonical rendering does not fit in memory"), code: 1 };
    }
    var answer = buffer.empty(heap, 0);
    var failed = 0;
    borrow shown as &p in {
        let bytes_of = buffer.bytes(p);
        let area = box_slice(heap, formatting.size_for(len(src), len(bytes_of)), 0);
        borrow mut area as &!b in {
            let m = contents(b);
            formatting.layout(m, len(src), len(bytes_of));
            let formatted = formatting.format(heap, m, src, bytes_of);
            let formatting.Formatted { text, status } = formatted;
            let made = text;
            failed = status;
            if status == 0 {
                borrow made as &w in {
                    buffer.drop(heap, answer);
                    answer = formatting.finish(heap, buffer.bytes(w));
                }
                buffer.drop(heap, made);
            } else {
                buffer.drop(heap, answer);
                answer = made;
            }
        }
        unbox_slice(heap, area);
    }
    buffer.drop(heap, shown);
    if failed != 0 {
        // The line is `CANNOT <sentence>`: the sentence is what `fmt` reports.
        var why = buffer.empty(heap, 64);
        borrow answer as &w in {
            let all = buffer.bytes(w);
            why = buffer.append(heap, why, all[7..len(all)]);
        }
        buffer.drop(heap, answer);
        return Made { out: why, code: 1 };
    }
    return Made { out: answer, code: 0 };
}

// The canonical text of a program as a `Made`: the text, or a status that is not 0.
fn canon_of[&h, &i, &x](heap: &!h Heap, io: &!i Io, src: &x [byte]) -> [heap, io_write] Made {
    let printed = print_text(heap, io, src, 0);
    let Text { shown, ok, rule, from, to } = printed;
    return Made { out: shown, code: ok };
}

// Do `first` and `b` print as the same text?
fn alike_to[&h, &i, &x, &y](heap: &!h Heap, io: &!i Io, first: &x [byte], b: &y [byte]) -> [heap, io_write] int {
    let second = canon_of(heap, io, b);
    let Made { out, code } = second;
    var verdict = 0;
    if code != 0 {
        verdict = 1;
    } else {
        borrow out as &pb in {
            if !bytes.equal(first, buffer.bytes(pb)) {
                verdict = 2;
            }
        }
    }
    buffer.drop(heap, out);
    return verdict;
}

// 0 if `a` and `b` print as the same text, 1 if `b` does not parse, 2 if they print differently.
fn alike[&h, &i, &x, &y](heap: &!h Heap, io: &!i Io, a: &x [byte], b: &y [byte]) -> [heap, io_write] int {
    let first = canon_of(heap, io, a);
    let Made { out, code } = first;
    var verdict = 0;
    if code != 0 {
        verdict = 2;
    } else {
        borrow out as &pa in {
            verdict = alike_to(heap, io, buffer.bytes(pa), b);
        }
    }
    buffer.drop(heap, out);
    return verdict;
}

fn comments_alike[&h, &x, &y](heap: &!h Heap, a: &x [byte], b: &y [byte]) -> [heap] bool {
    let c1 = formatting.comments_of(heap, a);
    let c2 = formatting.comments_of(heap, b);
    var verdict = false;
    borrow c1 as &p in {
        borrow c2 as &q in {
            verdict = bytes.equal(buffer.bytes(p), buffer.bytes(q));
        }
    }
    buffer.drop(heap, c1);
    buffer.drop(heap, c2);
    return verdict;
}

// Does formatting `formatted` give `formatted`?
fn fixed_point[&h, &i, &x](heap: &!h Heap, io: &!i Io, formatted: &x [byte]) -> [heap, io_write] bool {
    let again = format_once(heap, io, formatted);
    let Made { out, code } = again;
    var verdict = false;
    if code == 0 {
        borrow out as &n in {
            verdict = bytes.equal(buffer.bytes(n), formatted);
        }
    }
    buffer.drop(heap, out);
    return verdict;
}

fn reason(why: int) -> [] &static [byte] {
    if why == 1 {
        return "the formatted text does not parse; the file is left as it is";
    }
    if why == 2 {
        return "the formatted text means something other than the original; the file is left as it is";
    }
    if why == 3 {
        return "formatting would lose, duplicate or reorder a comment; the file is left as it is";
    }
    return "formatting its own output changes it again; the formatter is not a fixed point on this file, which is a bug in the formatter, not in the file";
}

// The formatted text of `src`, once the three checks of `docs/formatting.md` section 4 hold for it: it prints as `src` does, it holds the same
// comments, and formatting it again changes nothing. A status of 1 says why not (a sentence), 2 that `src` does not parse.
fn format_source[&h, &i, &x](heap: &!h Heap, io: &!i Io, src: &x [byte]) -> [heap, io_write] Made {
    let once = format_once(heap, io, src);
    let Made { out, code } = once;
    if code != 0 {
        return Made { out: out, code: code };
    }
    var why = 0;
    borrow out as &t in {
        let formatted = buffer.bytes(t);
        why = alike(heap, io, src, formatted);
        if why == 0 && !comments_alike(heap, src, formatted) {
            why = 3;
        }
        if why == 0 && !fixed_point(heap, io, formatted) {
            why = 4;
        }
    }
    if why != 0 {
        buffer.drop(heap, out);
        return Made { out: sentence(heap, reason(why)), code: 1 };
    }
    return Made { out: out, code: 0 };
}

// ------------------------------------------------------------------ files ---

// All of the file at `path`: 0 and the bytes, or the errno (at least 1) and nothing.
res struct Contents {
    bytes: buffer.Buffer,
    failed: int,
}

fn read_file[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), file_read] Contents {
    var out = buffer.empty(heap, 4096);
    var trouble = 0;
    match open_read(fs, path) {
        Opened::Failed(reason) => {
            trouble = reason;
            if trouble == 0 {
                trouble = 1;
            }
        }
        Opened::Ok(opened) => {
            var file = opened;
            var chunk = buffer.empty(heap, 65536);
            borrow mut file as &!handle in {
                var going = true;
                while going {
                    var got = 0;
                    borrow mut chunk as &!c in {
                        match file_read(handle, buffer.room(c)) {
                            Read::Got(n) => {
                                got = n;
                                buffer.filled(c, n);
                            }
                            Read::End => {
                                going = false;
                            }
                            Read::Failed(reason) => {
                                going = false;
                                trouble = reason;
                                if trouble == 0 {
                                    trouble = 1;
                                }
                            }
                        }
                    }
                    if got > 0 {
                        borrow chunk as &c in {
                            out = buffer.append(heap, out, buffer.bytes(c));
                        }
                        borrow mut chunk as &!c in {
                            buffer.clear(c);
                        }
                    }
                }
            }
            buffer.drop(heap, chunk);
            file_close(file);
        }
    }
    return Contents { bytes: out, failed: trouble };
}

fn say[&h, &i, &p](heap: &!h Heap, io: &!i Io, head: &static [byte], path: &p [byte]) -> [heap, io_write] int {
    var line = buffer.append(heap, buffer.empty(heap, 64), head);
    line = buffer.append(heap, line, path);
    line = buffer.push(heap, line, byte_of('\n'));
    borrow line as &l in {
        buffer.write(io, l);
    }
    buffer.drop(heap, line);
    return 0;
}

// An error line on the standard error: `PATH: WHAT\n`.
fn complain[&h, &i, &p, &w](heap: &!h Heap, io: &!i Io, path: &p [byte], what: &w [byte]) -> [heap, err_write] int {
    var line = buffer.append(heap, buffer.empty(heap, 64), path);
    line = buffer.append(heap, line, ": ");
    line = buffer.append(heap, line, what);
    line = buffer.push(heap, line, byte_of('\n'));
    borrow line as &l in {
        console.error_all(io, buffer.bytes(l));
    }
    buffer.drop(heap, line);
    return 0;
}

fn spells_check[&p](arg: &p [byte]) -> [] bool {
    return bytes.equal(arg, "--check");
}

// One file: 0 if it needs nothing or was written, 1 if it was refused or (under `--check`) would change, 2 on an environment error.
fn format_file[&h, &i, &f, &p](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), path: &p [byte], check: bool) -> [heap, io_write, err_write, fs_read(""), fs_write(""), file_read, file_write] int {
    let read = read_file(heap, fs, path);
    let Contents { bytes, failed } = read;
    if failed != 0 {
        complain(heap, io, path, "cannot read the file");
        buffer.drop(heap, bytes);
        return 2;
    }
    var status = 0;
    borrow bytes as &src in {
        let done = format_source(heap, io, buffer.bytes(src));
        let Made { out, code } = done;
        if code == 2 {
            borrow out as &line in {
                console.error_all(io, buffer.bytes(line));
                console.error_all(io, "\n");
            }
            status = 1;
        } else if code == 1 {
            var what = buffer.append(heap, buffer.empty(heap, 64), "not formatted: ");
            borrow out as &why in {
                what = buffer.append(heap, what, buffer.bytes(why));
            }
            borrow what as &w in {
                complain(heap, io, path, buffer.bytes(w));
            }
            buffer.drop(heap, what);
            status = 1;
        } else {
            borrow out as &t in {
                if !bytes.equal(buffer.bytes(t), buffer.bytes(src)) {
                    if check {
                        say(heap, io, "would reformat ", path);
                        status = 1;
                    } else {
                        let e = filewrite.store(fs, path, buffer.bytes(t));
                        if e != 0 {
                            complain(heap, io, path, "cannot write the file");
                            status = 2;
                        } else {
                            say(heap, io, "formatted ", path);
                        }
                    }
                }
            }
        }
        buffer.drop(heap, out);
    }
    buffer.drop(heap, bytes);
    return status;
}

// Every path after `fmt` that is not `--check`, with the directories among them replaced by the files beneath them.
fn fmt_files[&h, &a, &f](heap: &!h Heap, args: &a Args, fs: &f Fs("")) -> [heap, args, fs_read(""), dir_read] buffer.Buffer {
    var found = buffer.empty(heap, 256);
    var n = 2;
    while n < arg_count(args) {
        if !spells_check(arg(args, n)) {
            found = walk.collect(heap, fs, arg(args, n), found);
        }
        n = n + 1;
    }
    return found;
}

fn fmt_command[&h, &i, &a, &f](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs("")) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), dir_read, file_read, file_write] int {
    var check = false;
    var n = 2;
    while n < arg_count(args) {
        if spells_check(arg(args, n)) {
            check = true;
        }
        n = n + 1;
    }
    if arg_count(args) - 2 - check_flags(args) == 0 {
        console.error_all(io, "usage: cancho fmt [--check] PATH...\n");
        return 2;
    }
    let found = fmt_files(heap, args, fs);
    var status = 0;
    borrow found as &list in {
        let all = buffer.bytes(list);
        var at = 0;
        while at < len(all) && status != 2 {
            var end = at;
            while lc.at(all, end) != 0 {
                end = end + 1;
            }
            let one = format_file(heap, io, fs, all[at..end], check);
            if one > status {
                status = one;
            }
            at = end + 1;
        }
    }
    buffer.drop(heap, found);
    return status;
}

// How many of the arguments are `--check`.
fn check_flags[&a](args: &a Args) -> [args] int {
    var count = 0;
    var n = 2;
    while n < arg_count(args) {
        if spells_check(arg(args, n)) {
            count = count + 1;
        }
        n = n + 1;
    }
    return count;
}

// `print [--output json] FILE` and `ingest FILE`: the one file, read whole. `print` writes the canonical text of the program (or its tree
// as JSON) to the standard output and `ingest` the canonical text of the program a JSON tree stands for; a file that is refused is
// reported as `PATH: ERR RULE FROM TO` on the standard error (print) or `ERR RULE FROM TO` on the standard output (ingest), status 1.
fn one_file_command[&h, &i, &a, &f](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), ingest: bool) -> [heap, io_write, err_write, args, fs_read(""), file_read] int {
    var json = false;
    var path = "";
    var files = 0;
    var n = 2;
    while n < arg_count(args) {
        if bytes.equal(arg(args, n), "--output") {
            n = n + 1;
            if n < arg_count(args) && bytes.equal(arg(args, n), "json") && !ingest {
                json = true;
            } else {
                console.error_all(io, "usage: only `--output json` of `print` is available\n");
                return 2;
            }
        } else {
            path = arg(args, n);
            files = files + 1;
        }
        n = n + 1;
    }
    if files != 1 {
        console.error_all(io, "usage: cancho print [--output json] FILE | cancho ingest FILE\n");
        return 2;
    }
    let read = read_file(heap, fs, path);
    let Contents { bytes, failed } = read;
    var status = 0;
    if failed != 0 {
        complain(heap, io, path, "cannot read the file");
        status = 2;
    } else {
        borrow bytes as &src in {
            if ingest {
                status = driver.ingest_run(heap, io, buffer.bytes(src));
            } else {
                var how = 1;
                if json {
                    how = 2;
                }
                let printed = print_text(heap, io, buffer.bytes(src), how);
                let Text { shown, ok, rule, from, to } = printed;
                if ok == 1 {
                    let line = refusal_text(heap, rule, from, to);
                    borrow line as &l in {
                        complain(heap, io, path, buffer.bytes(l));
                    }
                    buffer.drop(heap, line);
                }
                if ok != 0 {
                    status = 1;
                }
                buffer.drop(heap, shown);
            }
        }
    }
    buffer.drop(heap, bytes);
    return status;
}

// A text built in a buffer, written to the standard output; the buffer is spent.
fn show[&h, &i](heap: &!h Heap, io: &!i Io, text: buffer.Buffer) -> [heap, io_write] int {
    borrow text as &t in {
        buffer.write(io, t);
    }
    return buffer.drop(heap, text);
}

// A bad command line: what is wrong, then the usage, on the standard error. Status 2.
fn usage_error[&h, &i, &w](heap: &!h Heap, io: &!i Io, why: &w [byte]) -> [heap, err_write] int {
    console.error_all(io, why);
    console.error_all(io, "\n\n");
    let text = commandtree.usage(heap, buffer.empty(heap, 12000));
    borrow text as &t in {
        console.error_all(io, buffer.bytes(t));
    }
    buffer.drop(heap, text);
    console.error_all(io, "\n");
    return 2;
}

// The form of an answer named by `--output`: 0 text, 1 json, 2 table, or -1.
fn form_of[&r](word: &r [byte]) -> [] int {
    if bytes.equal(word, "text") {
        return 0;
    }
    if bytes.equal(word, "json") {
        return 1;
    }
    if bytes.equal(word, "table") {
        return 2;
    }
    return 0 - 1;
}

fn bad_form[&h, &i, &w](heap: &!h Heap, io: &!i Io, word: &w [byte]) -> [heap, err_write] int {
    var why = buffer.append(heap, buffer.empty(heap, 96), "Invalid output format: '");
    why = buffer.append(heap, why, word);
    why = buffer.append(heap, why, "'. Use text, json, or table.");
    var status = 2;
    borrow why as &w2 in {
        status = usage_error(heap, io, buffer.bytes(w2));
    }
    buffer.drop(heap, why);
    return status;
}

// `introspect` and `skill` (`docs/agent-cli.md`): the command tree, and a skill file made from it, in the form `--output` names. `skill` with a
// path writes the file there and says so.
fn tree_command[&h, &i, &a, &f](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), skill: bool) -> [heap, io_write, err_write, args, fs_write(""), file_write] int {
    var form = 0;
    var path = 0 - 1;
    var n = 2;
    while n < arg_count(args) {
        let word = arg(args, n);
        if bytes.equal(word, "--output") {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`--output` needs a form");
            }
            form = form_of(arg(args, n));
            if form < 0 {
                return bad_form(heap, io, arg(args, n));
            }
        } else if len(word) >= 9 && lc.spells(word, 0, 9, "--output=") {
            form = form_of(word[9..len(word)]);
            if form < 0 {
                return bad_form(heap, io, word[9..len(word)]);
            }
        } else if path < 0 {
            path = n;
        }
        n = n + 1;
    }
    if !skill {
        if form == 1 {
            show(heap, io, commandtree.introspect_json(heap, buffer.empty(heap, 20000)));
            return 0;
        }
        if form == 2 {
            show(heap, io, commandtree.introspect_table(heap, buffer.empty(heap, 20000)));
            return 0;
        }
        show(heap, io, commandtree.introspect_text(heap, buffer.empty(heap, 20000)));
        return 0;
    }
    let text = commandtree.skill_text(heap, buffer.empty(heap, 20000));
    var status = 0;
    if path >= 0 {
        borrow text as &t in {
            if filewrite.store(fs, arg(args, path), buffer.bytes(t)) != 0 {
                complain(heap, io, arg(args, path), "cannot write the file");
                status = 3;
            }
        }
    }
    if form == 1 {
        // The answer is the JSON envelope, with the file's path where the Rust command writes it, or `null`.
        var answer = commandtree.skill_json_head(heap, buffer.empty(heap, 20000));
        if path < 0 {
            answer = buffer.append(heap, answer, "null");
        } else {
            answer = diagnose.json_string(heap, answer, arg(args, path));
        }
        answer = commandtree.skill_json_tail(heap, answer);
        if status == 0 {
            show(heap, io, answer);
        } else {
            buffer.drop(heap, answer);
        }
        buffer.drop(heap, text);
        return status;
    }
    if path < 0 {
        show(heap, io, text);
        return 0;
    }
    buffer.drop(heap, text);
    if status == 0 {
        say(heap, io, "Skill file written to ", arg(args, path));
    }
    return status;
}

// Does `word` take the argument after it? (the flags of `check`)
fn takes_value[&w](word: &w [byte], build: bool) -> [] bool {
    if bytes.equal(word, "--output") || bytes.equal(word, "--host") || bytes.equal(word, "--backend") || bytes.equal(word, "--std-dir") {
        return true;
    }
    return build && (bytes.equal(word, "-o") || bytes.equal(word, "--emit") || bytes.equal(word, "-l") || bytes.equal(word, "-L") || bytes.equal(word, "--clang"));
}

// The `k`th name of a list of names, each followed by a NUL.
fn name_at[&n](names: &n [byte], k: int) -> [] &n [byte] {
    var at = 0;
    var seen = 0;
    while seen < k && at < len(names) {
        if lc.at(names, at) == 0 {
            seen = seen + 1;
        }
        at = at + 1;
    }
    var end = at;
    while end < len(names) && lc.at(names, end) != 0 {
        end = end + 1;
    }
    return names[at..end];
}

// What is said of the first refusal `rule` at `from` to `to`, or of none: the answer of `check`, and its status.
fn report_check[&h, &i, &y, &l, &n](heap: &!h Heap, io: &!i Io, names: &y [byte], laid: &l [byte], lens: &n [int], json: bool, refused: int, rule: int, from: int, to: int) -> [heap, io_write, err_write] int {
    if refused == 0 {
        if json {
            console.write_all(io, "{\n  \"refused\": []\n}\n");
        }
        return 0;
    }
    if rule == rules.r_skip() {
        // The compiler in cancho has no judgement to give of this program: the construct at this place is one it has no code for.
        let place = diagnose.locate(laid, lens, from);
        var why = buffer.append(heap, buffer.empty(heap, 128), name_at(names, place.file));
        why = buffer.push(heap, why, byte_of(':'));
        why = buffer.push_nat(heap, why, place.line);
        why = buffer.push(heap, why, byte_of(':'));
        why = buffer.push_nat(heap, why, place.column);
        why = buffer.append(heap, why, ": this command line cannot judge the program: the compiler in cancho has no code for what is here\n");
        borrow why as &t in {
            console.error_all(io, buffer.bytes(t));
        }
        buffer.drop(heap, why);
        return 3;
    }
    // A refusal about the program as a whole (no `main`) has no place; it is given at the first file.
    let located = !(rule == rules.r_program_shape() && from == 0 && to == 0);
    var which = 0;
    if located {
        which = diagnose.locate(laid, lens, from).file;
    }
    let path = name_at(names, which);
    if json {
        var out = buffer.append(heap, buffer.empty(heap, 512), "{\n  \"refused\": [\n");
        out = diagnose.entry(heap, out, path, laid, lens, rule, from, located);
        out = buffer.append(heap, out, "\n  ]\n}\n");
        show(heap, io, out);
    } else {
        var out = buffer.empty(heap, 512);
        if located {
            out = diagnose.render(heap, out, path, laid, lens, rule, from, to);
        } else {
            out = diagnose.render_program(heap, out, path, rule);
        }
        out = buffer.push(heap, out, byte_of('\n'));
        borrow out as &t in {
            console.error_all(io, buffer.bytes(t));
        }
        buffer.drop(heap, out);
    }
    return 1;
}

// The program `tool` started with the arguments in `list` (each followed by a NUL) and waited for, its standard output (or, with `err`,
// its standard error) written to the file at `log`: its exit status, 128 and the signal if it was killed, or 255 if it did not run.
fn spawn_to[&x, &f, &c, &l, &p](exec: &x Exec(""), fs: &f Fs(""), tool: &c [byte], list: &l [byte], log: &p [byte], err: bool) -> [exec(""), fs_write("")] int {
    match open_write(fs, log) {
        Opened::Failed(e) => {
            return 255;
        }
        Opened::Ok(file) => {
            if err {
                match exec_spawn(exec, tool, list, "PATH=/usr/bin:/bin\0", Stdio::Null, Stdio::Null, Stdio::File(file)) {
                    Spawned::Ok(child) => {
                        match child_wait(child) {
                            Exited::Code(n) => {
                                return n;
                            }
                            Exited::Signaled(s) => {
                                return 128 + s;
                            }
                            Exited::Failed(e) => {
                                return 255;
                            }
                        }
                    }
                    Spawned::Failed(e) => {
                        return 255;
                    }
                }
            } else {
                match exec_spawn(exec, tool, list, "PATH=/usr/bin:/bin\0", Stdio::Null, Stdio::File(file), Stdio::Null) {
                    Spawned::Ok(child) => {
                        match child_wait(child) {
                            Exited::Code(n) => {
                                return n;
                            }
                            Exited::Signaled(s) => {
                                return 128 + s;
                            }
                            Exited::Failed(e) => {
                                return 255;
                            }
                        }
                    }
                    Spawned::Failed(e) => {
                        return 255;
                    }
                }
            }
        }
    }
}

// What the machine is, for the code to be written for it: 1 for macOS, 2 for Linux on aarch64, 0 otherwise. A program cannot ask, so `uname -sm` is
// run, its answer written to the file at `note` and read back.
fn detect_host[&h, &x, &f, &p](heap: &!h Heap, exec: &x Exec(""), fs: &f Fs(""), note: &p [byte]) -> [heap, exec(""), fs_read(""), fs_write(""), file_read] int {
    var host = 0;
    if spawn_to(exec, fs, "/usr/bin/uname", "-sm\0", note, false) == 0 {
        let read = read_file(heap, fs, note);
        let Contents { bytes, failed } = read;
        if failed == 0 {
            borrow bytes as &t in {
                let said = buffer.bytes(t);
                if len(said) >= 6 && lc.spells(said, 0, 6, "Darwin") {
                    host = 1;
                } else if len(said) >= 5 && lc.spells(said, 0, 5, "Linux") && contains(said, "aarch64") {
                    host = 2;
                }
            }
        }
        buffer.drop(heap, bytes);
    }
    fs_remove(fs, note);
    return host;
}

// Is `word` somewhere in `text`?
fn contains[&t, &w](text: &t [byte], word: &w [byte]) -> [] bool {
    var at = 0;
    while at + len(word) <= len(text) {
        if lc.spells(text, at, at + len(word), word) {
            return true;
        }
        at = at + 1;
    }
    return false;
}

// The name of a file without the directories before it and the `.cho` after it.
fn stem[&p](path: &p [byte]) -> [] &p [byte] {
    var from = 0;
    var k = 0;
    while k < len(path) {
        if lc.at(path, k) == '/' {
            from = k + 1;
        }
        k = k + 1;
    }
    var to = len(path);
    if to - from > 4 && lc.spells(path, to - 4, to, ".cho") {
        to = to - 4;
    }
    return path[from..to];
}

// The module `ir` made into the executable (or, `obj`, the object file) at `out`, by `clang`: the text is written to `out.ll`, `clang` reads
// it with the libraries and the paths after `-l` and `-L` in the arguments, and what is left over is taken away. 0, or 3 with what `clang` said.
fn make_binary[&h, &i, &a, &f, &x, &r, &o, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), ir: &r [byte], out: &o [byte], clang: &c [byte], obj: bool) -> [heap, err_write, args, fs_read(""), fs_write(""), file_read, file_write, exec("")] int {
    var ll = buffer.append(heap, buffer.empty(heap, len(out) + 8), out);
    ll = buffer.append(heap, ll, ".ll");
    var log = buffer.append(heap, buffer.empty(heap, len(out) + 16), out);
    log = buffer.append(heap, log, ".clang.log");
    var status = 0;
    borrow ll as &lp in {
        borrow log as &gp in {
            status = filewrite.store(fs, buffer.bytes(lp), ir);
            if status != 0 {
                complain(heap, io, buffer.bytes(lp), "cannot write the file");
                status = 3;
            } else {
                var list = buffer.append(heap, buffer.empty(heap, 256), "-O2\0-Wno-override-module\0");
                list = buffer.append(heap, list, buffer.bytes(lp));
                list = buffer.append(heap, list, "\0-o\0");
                list = buffer.append(heap, list, out);
                list = buffer.push(heap, list, byte_of(0));
                if obj {
                    list = buffer.append(heap, list, "-c\0");
                }
                var n = 2;
                while n + 1 < arg_count(args) {
                    if bytes.equal(arg(args, n), "-l") || bytes.equal(arg(args, n), "-L") {
                        list = buffer.append(heap, list, arg(args, n));
                        list = buffer.append(heap, list, arg(args, n + 1));
                        list = buffer.push(heap, list, byte_of(0));
                        n = n + 1;
                    }
                    n = n + 1;
                }
                borrow list as &l in {
                    status = spawn_to(exec, fs, clang, buffer.bytes(l), buffer.bytes(gp), true);
                }
                buffer.drop(heap, list);
                if status != 0 {
                    let said = read_file(heap, fs, buffer.bytes(gp));
                    let Contents { bytes, failed } = said;
                    if failed == 0 {
                        borrow bytes as &t in {
                            console.error_all(io, buffer.bytes(t));
                        }
                    }
                    buffer.drop(heap, bytes);
                    console.error_all(io, "clang did not make the program\n");
                    status = 3;
                }
                fs_remove(fs, buffer.bytes(lp));
            }
            fs_remove(fs, buffer.bytes(gp));
        }
    }
    buffer.drop(heap, ll);
    buffer.drop(heap, log);
    return status;
}

// How a child that was run came to an end, as the status of `run`: its own status, or 3 with the reason.
// How a program that was run ended, as `kind` and `value`: 0 it answered `value`, 1 it was killed by the signal `value`, 2 it did not finish in time, 3 it wrote
// too much, 4 it could not be watched, 5 it did not start (which has been said).
res struct Captured {
    out: buffer.Buffer,
    err: buffer.Buffer,
    kind: int,
    value: int,
}

fn kind_of(ran: process.Ran) -> [] (int, int) {
    match ran {
        process.Ran::Code(n) => {
            return (0, n);
        }
        process.Ran::Signaled(s) => {
            return (1, s);
        }
        process.Ran::TimedOut => {
            return (2, 0);
        }
        process.Ran::TooMuch => {
            return (3, 0);
        }
        process.Ran::Failed(e) => {
            return (4, 0);
        }
    }
}

// The status `run` ends with for a program that ended as `kind` and `n`.
fn ended[&i](io: &!i Io, kind: int, n: int) -> [err_write] int {
    if kind == 0 {
        return n;
    }
    if kind == 2 {
        console.error_all(io, "the program did not finish in the time `run` allows\n");
    }
    if kind == 3 {
        console.error_all(io, "the program wrote more than `run` keeps\n");
    }
    if kind == 4 {
        console.error_all(io, "the program could not be watched\n");
    }
    // A signal is not said, as in the Rust command; the status is 3 for all that is not an answer.
    return 3;
}

// The program at `exe` run with `argv` (each argument followed by a NUL, after its own name) and `input` on its standard input and nothing else (its
// environment is a `PATH`). What the standard library's `capture_both` is: nothing is written while the program runs, and it keeps at most 64 MiB of
// each stream and runs for at most a day.
fn run_capture[&h, &i, &x, &c, &p, &n, &v](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, exe: &p [byte], input: &n [byte], argv: &v [byte]) -> [heap, err_write, exec(""), clock, poll] Captured {
    var named = buffer.empty(heap, len(exe) + 3);
    if len(exe) > 0 && lc.at(exe, 0) != '/' && lc.at(exe, 0) != '.' {
        // A name with no directory is looked for in `PATH` by the system; this one is in the directory the command was run in.
        named = buffer.append(heap, buffer.append(heap, named, "./"), exe);
    } else {
        named = buffer.append(heap, named, exe);
    }
    var out = buffer.empty(heap, 0);
    var err = buffer.empty(heap, 0);
    var kind = 5;
    var code = 0;
    match process.channels_with_errors() {
        process.ChannelsWithErrors::Failed(e) => {
            console.error_all(io, "cannot make the pipes to run the program with\n");
        }
        process.ChannelsWithErrors::Ok(to_child, child_in, from_child, child_out, from_errors, child_errors) => {
            borrow named as &np in {
                match exec_spawn(exec, buffer.bytes(np), argv, "PATH=/usr/bin:/bin\0", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Pipe(child_errors)) {
                    Spawned::Failed(e) => {
                        process.close(to_child, from_child);
                        pipe_close(from_errors);
                        console.error_all(io, "cannot start the program\n");
                    }
                    Spawned::Ok(child) => {
                        let (got, errors, ran) = process.capture_both(heap, clock, child, to_child, from_child, from_errors, input, 67108864, 67108864, 86400000);
                        buffer.drop(heap, out);
                        buffer.drop(heap, err);
                        out = got;
                        err = errors;
                        let (k, m) = kind_of(ran);
                        kind = k;
                        code = m;
                    }
                }
            }
        }
    }
    buffer.drop(heap, named);
    return Captured { out: out, err: err, kind: kind, value: code };
}

// The program at `exe` run with `input` on its standard input, and its standard output and standard error written, when it is over, to ours. Its own
// status, or 3.
fn run_built[&h, &i, &x, &c, &p, &n](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, exe: &p [byte], input: &n [byte]) -> [heap, io_write, err_write, exec(""), clock, poll] int {
    let Captured { out, err, kind, value } = run_capture(heap, io, exec, clock, exe, input, "");
    borrow out as &o in {
        buffer.write(io, o);
    }
    borrow err as &e in {
        console.error_all(io, buffer.bytes(e));
    }
    buffer.drop(heap, out);
    buffer.drop(heap, err);
    return ended(io, kind, value);
}

// The file at `path`, or, for the extra one, `extra` itself.
fn read_or_extra[&h, &f, &p, &e](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], is_extra: bool, extra: &e [byte]) -> [heap, fs_read(""), file_read] Contents {
    if is_extra {
        return Contents { bytes: buffer.append(heap, buffer.empty(heap, len(extra) + 1), extra), failed: 0 };
    }
    return read_file(heap, fs, path);
}

// A program read: its files' names (each followed by a NUL), the stream `driver.run_many` reads, the files laid end to end with a NUL between, the
// length of each, and a status (0, or 2 for a file that could not be read, which has been said). `extra` is the text of one more file, named
// `extra_name`, that goes last (the runner `test` writes); nothing if it is empty.
res struct Loaded {
    names: buffer.Buffer,
    raw: buffer.Buffer,
    laid: buffer.Buffer,
    lens: Box[[int]],
    count: int,
    read_status: int,
}

fn load_program[&h, &i, &a, &f, &e, &m](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), build: bool, run: bool, std_dir: int, extra: &e [byte], extra_name: &m [byte]) -> [heap, err_write, args, fs_read(""), file_read] Loaded {
    // The names: the files, then the standard library, then the extra file.
    var names = buffer.empty(heap, 256);
    var n = 2;
    while n < arg_count(args) {
        let word = arg(args, n);
        if takes_value(word, build) {
            n = n + 1;
        } else if !(run && bytes.equal(word, "--stdin")) {
            names = buffer.append(heap, buffer.append(heap, names, word), "\0");
        }
        n = n + 1;
    }
    if std_dir >= 0 {
        // The files of the standard library, in the order `--std` adds them, found in the directory.
        let order = stdorder.names(heap, buffer.empty(heap, 600));
        borrow order as &o in {
            let all = buffer.bytes(o);
            var at = 0;
            var end = 0;
            while at < len(all) {
                end = at;
                while lc.at(all, end) != 0 {
                    end = end + 1;
                }
                names = buffer.append(heap, names, arg(args, std_dir));
                if len(arg(args, std_dir)) > 0 && lc.at(arg(args, std_dir), len(arg(args, std_dir)) - 1) != '/' {
                    names = buffer.push(heap, names, byte_of('/'));
                }
                names = buffer.append(heap, names, all[at..end]);
                names = buffer.append(heap, names, ".cho\0");
                at = end + 1;
            }
        }
        buffer.drop(heap, order);
    }
    if len(extra) > 0 {
        names = buffer.append(heap, buffer.append(heap, names, extra_name), "\0");
    }
    var count = 0;
    borrow names as &nm in {
        var k = 0;
        while k < buffer.size(nm) {
            if lc.at(buffer.bytes(nm), k) == 0 {
                count = count + 1;
            }
            k = k + 1;
        }
    }
    var raw = buffer.empty(heap, 65536);
    var laid = buffer.empty(heap, 65536);
    let lens = box_slice(heap, count, 0);
    var status = 0;
    var which = 0;
    borrow names as &nm in {
        while which < count && status == 0 {
            let path = name_at(buffer.bytes(nm), which);
            let read = read_or_extra(heap, fs, path, len(extra) > 0 && which == count - 1, extra);
            let Contents { bytes, failed } = read;
            if failed != 0 {
                complain(heap, io, path, "cannot read the file");
                status = 2;
            } else {
                borrow bytes as &src in {
                    borrow mut lens as &!lb in {
                        contents(lb)[which] = buffer.size(src);
                    }
                    raw = buffer.append(heap, raw, "FILE ");
                    raw = buffer.push_nat(heap, raw, buffer.size(src));
                    raw = buffer.push(heap, raw, byte_of('\n'));
                    raw = buffer.append(heap, raw, buffer.bytes(src));
                    laid = buffer.append(heap, laid, buffer.bytes(src));
                    laid = buffer.push(heap, laid, byte_of(0));
                }
            }
            buffer.drop(heap, bytes);
            which = which + 1;
        }
    }
    return Loaded { names: names, raw: raw, laid: laid, lens: lens, count: count, read_status: status };
}

// `check [--output json] [--host H] [--std-dir DIR] FILE...` (`docs/cli-in-cancho.md` section 12) and `ids [--host H] [--std-dir DIR] FILE...` (section 13):
// the program is the files, in order, and then the `.cho` files of DIR (the standard library, which this command line does not carry: it is
// where `--std` of the Rust command finds it). It is checked and its code is written and thrown away, as `cancho build` would, by the build of
// the compiler in cancho (`driver.run_many`, mode 5); `ids` then writes the identity of every declaration (mode 9). The target is the one `--host`
// names (linux, darwin or linux-aarch64; the default is linux): a program cannot ask what it runs on.
fn program_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, ids: bool, layout: bool, build: bool, run: bool) -> [heap, io_read, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, exec(""), clock, poll] int {
    var json = false;
    var forward = false;
    var host = 0;
    var host_given = false;
    var out_at = 0 - 1;
    var obj = false;
    var clang_at = 0 - 1;
    var std_dir = 0 - 1;
    var files = 0;
    var n = 2;
    while n < arg_count(args) {
        let word = arg(args, n);
        if bytes.equal(word, "--output") {
            n = n + 1;
            if !ids && !layout && !build && n < arg_count(args) && bytes.equal(arg(args, n), "json") {
                json = true;
            } else {
                return usage_error(heap, io, "`--output` needs a form: json (of `check`)");
            }
        } else if bytes.equal(word, "--host") {
            n = n + 1;
            host_given = true;
            if n < arg_count(args) && bytes.equal(arg(args, n), "linux") {
                host = 0;
            } else if n < arg_count(args) && bytes.equal(arg(args, n), "darwin") {
                host = 1;
            } else if n < arg_count(args) && bytes.equal(arg(args, n), "linux-aarch64") {
                host = 2;
            } else {
                return usage_error(heap, io, "`--host` needs linux, darwin or linux-aarch64");
            }
        } else if bytes.equal(word, "--std-dir") {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`--std-dir` needs a directory");
            }
            std_dir = n;
        } else if bytes.equal(word, "--backend") {
            n = n + 1;
            if ids || layout || n >= arg_count(args) || !bytes.equal(arg(args, n), "llvm") {
                return usage_error(heap, io, "`--backend`: only llvm is available in `check` of this command line");
            }
        } else if build && bytes.equal(word, "-o") {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`-o` needs a path");
            }
            out_at = n;
        } else if build && bytes.equal(word, "--emit") {
            n = n + 1;
            if n < arg_count(args) && bytes.equal(arg(args, n), "obj") {
                obj = true;
            } else if n >= arg_count(args) || !bytes.equal(arg(args, n), "exe") {
                return usage_error(heap, io, "`--emit` needs exe or obj");
            }
        } else if build && (bytes.equal(word, "-l") || bytes.equal(word, "-L")) {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`-l` and `-L` need a value");
            }
        } else if run && bytes.equal(word, "--stdin") {
            forward = true;
        } else if build && bytes.equal(word, "--clang") {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`--clang` needs a path");
            }
            clang_at = n;
        } else if bytes.equal(word, "--std") || bytes.equal(word, "--target") {
            return usage_error(heap, io, "`--std` and `--target` are not available in this command line: `--std-dir DIR` adds the standard library from DIR");
        } else {
            files = files + 1;
        }
        n = n + 1;
    }
    if files == 0 {
        return usage_error(heap, io, "no file given");
    }
    let loaded = load_program(heap, io, args, fs, build, run, std_dir, "", "");
    let Loaded { names, raw, laid, lens, count, read_status } = loaded;
    var status = read_status;
    // Where a build is to write: `-o`, or the stem of the first file (and `.o` for an object file).
    var target = buffer.empty(heap, 64);
    if build && status == 0 {
        if out_at >= 0 {
            target = buffer.append(heap, target, arg(args, out_at));
        } else {
            borrow names as &nm in {
                target = buffer.append(heap, target, stem(name_at(buffer.bytes(nm), 0)));
            }
            if obj {
                target = buffer.append(heap, target, ".o");
            }
            if run {
                // The program `run` makes is next to where it is run, and taken away.
                target = buffer.append(heap, target, ".cancho-run");
            }
        }
        if !host_given {
            borrow target as &tp in {
                var note = buffer.append(heap, buffer.empty(heap, len(buffer.bytes(tp)) + 8), buffer.bytes(tp));
                note = buffer.append(heap, note, ".host");
                borrow note as &np in {
                    host = detect_host(heap, exec, fs, buffer.bytes(np));
                }
                buffer.drop(heap, note);
            }
        }
    }
    if status == 0 {
        borrow raw as &r in {
            var mode = 5;
            if ids {
                mode = 10;
            }
            if layout {
                mode = 12;
            }
            let built = driver.run_many(heap, io, buffer.bytes(r), mode, host);
            borrow built as &b in {
                borrow laid as &lt in {
                    borrow mut lens as &!lb in {
                        borrow names as &nm in {
                            status = report_check(heap, io, buffer.bytes(nm), buffer.bytes(lt), contents(lb), json, b.status, b.rule, b.from, b.to);
                        }
                    }
                }
                if status == 0 && layout {
                    buffer.write(io, b.ir);
                }
                if status == 0 && build {
                    var clang = "/usr/bin/clang";
                    if clang_at >= 0 {
                        clang = arg(args, clang_at);
                    }
                    borrow target as &tp in {
                        status = make_binary(heap, io, args, fs, exec, buffer.bytes(b.ir), buffer.bytes(tp), clang, obj);
                        if status == 0 && run {
                            var input = buffer.empty(heap, 0);
                            if forward {
                                buffer.drop(heap, input);
                                input = lc.slurp(heap, io);
                            }
                            borrow input as &ip in {
                                status = run_built(heap, io, exec, clock, buffer.bytes(tp), buffer.bytes(ip));
                            }
                            buffer.drop(heap, input);
                            fs_remove(fs, buffer.bytes(tp));
                        }
                    }
                }
            }
            driver.discard(heap, built);
            if status == 0 && ids {
                status = driver.discard(heap, driver.run_many(heap, io, buffer.bytes(r), 9, host));
            }
        }
    }
    buffer.drop(heap, raw);
    buffer.drop(heap, laid);
    buffer.drop(heap, names);
    buffer.drop(heap, target);
    unbox_slice(heap, lens);
    return status;
}

// What is said, on the standard error, of a program `test` cannot run: `status` is what `testscan.cho` answered (2 a `main` of the root module, at
// `at`; 3 a test of the shape `why` says it is not, named `named`; 4 two modules that end in the same word, `named` being the word and the two
// paths, each followed by a NUL). Status 2.
fn test_refusal[&h, &i, &y, &l, &n, &m](heap: &!h Heap, io: &!i Io, names: &y [byte], laid: &l [byte], lens: &n [int], status: int, why: int, at: int, named: &m [byte]) -> [heap, err_write] int {
    var out = buffer.empty(heap, 512);
    if status == 4 {
        var first = 0;
        while lc.at(named, first) != 0 {
            first = first + 1;
        }
        var second = first + 1;
        while lc.at(named, second) != 0 {
            second = second + 1;
        }
        var third = second + 1;
        while lc.at(named, third) != 0 {
            third = third + 1;
        }
        out = buffer.append(heap, out, "two test modules, `");
        out = buffer.append(heap, out, named[first + 1..second]);
        out = buffer.append(heap, out, "` and `");
        out = buffer.append(heap, out, named[second + 1..third]);
        out = buffer.append(heap, out, "`, both end in `");
        out = buffer.append(heap, out, named[0..first]);
        out = buffer.append(heap, out, "`; the runner imports each by its last segment\n");
    } else {
        out = buffer.append(heap, out, name_at(names, diagnose.locate(laid, lens, at).file));
        if status == 2 {
            out = buffer.append(heap, out, ": `cancho test` supplies its own `main`; a file it runs must not declare one\n");
        } else {
            out = buffer.append(heap, out, ": `");
            out = buffer.append(heap, out, named);
            out = buffer.append(heap, out, "` looks like a test but ");
            out = buffer.append(heap, out, testscan.reason(why));
            out = buffer.append(heap, out, "\n\na test is `fn test_x[regions](caps) -> [row] int` with no type parameters, where each parameter is a unique `Heap` or `Io` reference (`docs/testing.md` §3); it answers 0 to pass\n");
        }
    }
    borrow out as &t in {
        console.error_all(io, buffer.bytes(t));
    }
    buffer.drop(heap, out);
    return 2;
}

// How a test that did not pass ended, as a sentence (`kind` and `value` are those of `Captured`).
fn describe[&h](heap: &!h Heap, out: buffer.Buffer, kind: int, value: int) -> [heap] buffer.Buffer {
    var text = out;
    if kind == 1 {
        // `std.signals` has no bit for the fault signals, and says 0 for them: the trap every checked operation ends with is the one a test is most
        // likely to have ended with, and it is what is said; a SIGSEGV or a SIGABRT is said to be the same.
        var signal = 4;
        if value > 0 {
            signal = 1;
            var bit = value;
            while bit > 1 {
                bit = bit / 2;
                signal = signal + 1;
            }
        }
        text = buffer.push_nat(heap, buffer.append(heap, text, "trapped: killed by signal "), signal);
        if signal == 4 {
            text = buffer.append(heap, text, " (SIGILL, the trap every checked operation ends with)");
        } else if signal == 11 {
            text = buffer.append(heap, text, " (SIGSEGV)");
        } else if signal == 6 {
            text = buffer.append(heap, text, " (SIGABRT)");
        }
    } else if kind == 0 {
        text = buffer.append(heap, buffer.push_nat(heap, buffer.append(heap, text, "returned "), value), ", and a test answers 0 to pass");
    } else {
        text = buffer.append(heap, text, "ended without a status");
    }
    return text;
}

// The program at `exe` run with the number `index` as its argument and nothing on its standard input.
fn run_numbered[&h, &i, &x, &c, &p](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, exe: &p [byte], index: int) -> [heap, err_write, exec(""), clock, poll] Captured {
    let argv = buffer.push(heap, buffer.push_nat(heap, buffer.empty(heap, 16), index), byte_of(0));
    var got = Captured { out: buffer.empty(heap, 0), err: buffer.empty(heap, 0), kind: 5, value: 0 };
    borrow argv as &av in {
        let Captured { out, err, kind, value } = got;
        buffer.drop(heap, out);
        buffer.drop(heap, err);
        got = run_capture(heap, io, exec, clock, exe, "", buffer.bytes(av));
    }
    buffer.drop(heap, argv);
    return got;
}

// Run each of `tests` (a label, a call and a path, each followed by a NUL, for each) as the program at `exe` with its number as the argument, and say
// how it went as `cancho test` does (`docs/cli-in-cancho.md` section 16). 0 if all passed, else 4.
fn run_tests[&h, &i, &x, &c, &p, &t](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, exe: &p [byte], tests: &t [byte]) -> [heap, io_write, err_write, exec(""), clock, poll] int {
    var total = 0;
    var k = 0;
    while k < len(tests) {
        if lc.at(tests, k) == 0 {
            total = total + 1;
        }
        k = k + 1;
    }
    total = total / 3;
    console.write_all(io, "running ");
    var shown = buffer.push_nat(heap, buffer.empty(heap, 16), total);
    shown = buffer.append(heap, shown, " test");
    if total != 1 {
        shown = buffer.push(heap, shown, byte_of('s'));
    }
    shown = buffer.push(heap, shown, byte_of('\n'));
    borrow shown as &sh in {
        buffer.write(io, sh);
    }
    buffer.drop(heap, shown);
    var report = buffer.empty(heap, 256);
    var failed = 0;
    var index = 0;
    var at = 0;
    while at < len(tests) {
        var label_end = at;
        while lc.at(tests, label_end) != 0 {
            label_end = label_end + 1;
        }
        var call_end = label_end + 1;
        while lc.at(tests, call_end) != 0 {
            call_end = call_end + 1;
        }
        var path_end = call_end + 1;
        while lc.at(tests, path_end) != 0 {
            path_end = path_end + 1;
        }
        let label = tests[at..label_end];
        let got = run_numbered(heap, io, exec, clock, exe, index);
        let Captured { out, err, kind, value } = got;
        console.write_all(io, "test ");
        console.write_all(io, label);
        if kind == 0 && value == 0 {
            console.write_all(io, " ... ok\n");
        } else {
            console.write_all(io, " ... FAILED\n");
            failed = failed + 1;
            report = buffer.append(heap, buffer.append(heap, buffer.append(heap, report, "\n---- "), label), " ----\n");
            report = buffer.push(heap, describe(heap, report, kind, value), byte_of('\n'));
            borrow out as &o in {
                if buffer.size(o) > 0 {
                    report = buffer.append(heap, report, "stdout:\n");
                    report = buffer.push(heap, buffer.append(heap, report, buffer.bytes(o)), byte_of('\n'));
                }
            }
            borrow err as &e in {
                if buffer.size(e) > 0 {
                    report = buffer.append(heap, report, "stderr:\n");
                    report = buffer.push(heap, buffer.append(heap, report, buffer.bytes(e)), byte_of('\n'));
                }
            }
        }
        buffer.drop(heap, out);
        buffer.drop(heap, err);
        index = index + 1;
        at = path_end + 1;
    }
    var tail = buffer.empty(heap, 64);
    if failed == 0 {
        tail = buffer.push_nat(heap, buffer.append(heap, tail, "\ntest result: ok. "), total);
        tail = buffer.append(heap, tail, " passed; 0 failed\n");
    } else {
        borrow report as &rp in {
            console.write_all(io, "\nfailures:\n");
            buffer.write(io, rp);
        }
        tail = buffer.push_nat(heap, buffer.append(heap, tail, "\ntest result: FAILED. "), total - failed);
        tail = buffer.push_nat(heap, buffer.append(heap, tail, " passed; "), failed);
        tail = buffer.append(heap, tail, " failed\n");
    }
    borrow tail as &tl in {
        buffer.write(io, tl);
    }
    buffer.drop(heap, tail);
    buffer.drop(heap, report);
    if failed == 0 {
        return 0;
    }
    return 4;
}

// The program of the files, the standard library (from the directory `std_dir` names, if it is not negative) and the runner for `tests` (what
// `testscan.cho` found), built, and its tests run (`run_tests`). `host_in`, `host_given` and `clang_at` are as in `program_command`.
fn test_program[&h, &i, &a, &f, &x, &c, &t](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, std_dir: int, host_in: int, host_given: bool, clang_at: int, tests: &t [byte]) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, exec(""), clock, poll] int {
    var host = host_in;
    var status = 0;
    let source = testscan.runner(heap, tests);
    borrow source as &sp in {
        let loaded = load_program(heap, io, args, fs, true, false, std_dir, buffer.bytes(sp), "runner_main.cho");
        let Loaded { names, raw, laid, lens, count, read_status } = loaded;
        status = read_status;
        var exe = buffer.empty(heap, 64);
        if status == 0 {
            borrow names as &nm in {
                exe = buffer.append(heap, exe, stem(name_at(buffer.bytes(nm), 0)));
            }
            exe = buffer.append(heap, exe, ".cancho-test");
            if !host_given {
                borrow exe as &ep in {
                    var note = buffer.append(heap, buffer.empty(heap, len(buffer.bytes(ep)) + 8), buffer.bytes(ep));
                    note = buffer.append(heap, note, ".host");
                    borrow note as &np in {
                        host = detect_host(heap, exec, fs, buffer.bytes(np));
                    }
                    buffer.drop(heap, note);
                }
            }
            borrow raw as &r in {
                let built = driver.run_many(heap, io, buffer.bytes(r), 5, host);
                borrow built as &b in {
                    borrow laid as &lt in {
                        borrow mut lens as &!lb in {
                            borrow names as &nm in {
                                status = report_check(heap, io, buffer.bytes(nm), buffer.bytes(lt), contents(lb), false, b.status, b.rule, b.from, b.to);
                            }
                        }
                    }
                    if status == 0 {
                        var clang = "/usr/bin/clang";
                        if clang_at >= 0 {
                            clang = arg(args, clang_at);
                        }
                        borrow exe as &ep in {
                            status = make_binary(heap, io, args, fs, exec, buffer.bytes(b.ir), buffer.bytes(ep), clang, false);
                            if status == 0 {
                                status = run_tests(heap, io, exec, clock, buffer.bytes(ep), tests);
                                fs_remove(fs, buffer.bytes(ep));
                            }
                        }
                    }
                }
                driver.discard(heap, built);
            }
        }
        buffer.drop(heap, exe);
        buffer.drop(heap, raw);
        buffer.drop(heap, laid);
        buffer.drop(heap, names);
        unbox_slice(heap, lens);
    }
    buffer.drop(heap, source);
    return status;
}

// The tests `testscan.cho` finds in the stream `scan` (the files, or one of them), and a status: 0 (the tests are `found`, with the label, the call and the path of each,
// each followed by a NUL), or what has been said (1 a refusal, 2 a file or a test that `test` cannot run). `names`, `laid` and `lens` are those of the program the stream is
// from, which say where.
res struct Found {
    found: buffer.Buffer,
    how: int,
}

fn scan_tests[&h, &i, &r, &y, &l, &n](heap: &!h Heap, io: &!i Io, scan: &r [byte], names: &y [byte], laid: &l [byte], lens: &!n [int]) -> [heap, io_write, err_write] Found {
    var tests = buffer.empty(heap, 0);
    let scanned = driver.run_many(heap, io, scan, 11, 0);
    var status = 0;
    borrow scanned as &sc in {
        status = sc.status;
        if sc.status == 0 {
            buffer.drop(heap, tests);
            tests = buffer.append(heap, buffer.empty(heap, buffer.size(sc.ir) + 1), buffer.bytes(sc.ir));
        } else if sc.status == 1 {
            status = report_check(heap, io, names, laid, lens, false, 1, sc.rule, sc.from, sc.to);
        } else {
            status = test_refusal(heap, io, names, laid, lens, sc.status, sc.rule, sc.from, buffer.bytes(sc.ir));
        }
    }
    driver.discard(heap, scanned);
    return Found { found: tests, how: status };
}

// `test [--host H] [--std-dir DIR] [--backend llvm] [--clang PATH] [-l LIB] [-L DIR] FILE...` (`docs/cli-in-cancho.md` section 16): the tests of the
// files (`testscan.cho`) are found, one program is built of the files and the runner that is written for them, and each test is run as a process of
// its own (the runner takes the number of the test as its argument), with the report of `cancho test`. Exit status 0 if all passed, 4 if one did not,
// 1 for a refusal, 2 for a usage error or a program with no tests, 3 for what could not be done. The program is built next to the first file, as `run`
// does, and taken away.
fn test_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, exec(""), clock, poll] int {
    var host = 0;
    var host_given = false;
    var clang_at = 0 - 1;
    var std_dir = 0 - 1;
    var files = 0;
    var n = 2;
    while n < arg_count(args) {
        let word = arg(args, n);
        if bytes.equal(word, "--host") {
            n = n + 1;
            host_given = true;
            if n < arg_count(args) && bytes.equal(arg(args, n), "linux") {
                host = 0;
            } else if n < arg_count(args) && bytes.equal(arg(args, n), "darwin") {
                host = 1;
            } else if n < arg_count(args) && bytes.equal(arg(args, n), "linux-aarch64") {
                host = 2;
            } else {
                return usage_error(heap, io, "`--host` needs linux, darwin or linux-aarch64");
            }
        } else if bytes.equal(word, "--std-dir") {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`--std-dir` needs a directory");
            }
            std_dir = n;
        } else if bytes.equal(word, "--backend") {
            n = n + 1;
            if n >= arg_count(args) || !bytes.equal(arg(args, n), "llvm") {
                return usage_error(heap, io, "`--backend`: only llvm is available in this command line");
            }
        } else if bytes.equal(word, "-l") || bytes.equal(word, "-L") {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`-l` and `-L` need a value");
            }
        } else if bytes.equal(word, "--clang") {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`--clang` needs a path");
            }
            clang_at = n;
        } else if bytes.equal(word, "--std") || bytes.equal(word, "--target") {
            return usage_error(heap, io, "`--std` and `--target` are not available in this command line: `--std-dir DIR` adds the standard library from DIR");
        } else if bytes.equal(word, "-o") || bytes.equal(word, "--emit") || bytes.equal(word, "--output") {
            return usage_error(heap, io, "`test` does not take `-o`, `--emit` or `--output`");
        } else {
            files = files + 1;
        }
        n = n + 1;
    }
    if files == 0 {
        return usage_error(heap, io, "no file given");
    }
    // The files alone are read, and their tests found.
    let first = load_program(heap, io, args, fs, true, false, 0 - 1, "", "");
    let Loaded { names, raw, laid, lens, count, read_status } = first;
    var status = read_status;
    var tests = buffer.empty(heap, 0);
    if status == 0 {
        borrow raw as &r in {
            borrow laid as &lt in {
                borrow names as &nm in {
                    borrow mut lens as &!lb in {
                        let Found { found, how } = scan_tests(heap, io, buffer.bytes(r), buffer.bytes(nm), buffer.bytes(lt), contents(lb));
                        buffer.drop(heap, tests);
                        tests = found;
                        status = how;
                    }
                }
            }
        }
    }
    buffer.drop(heap, raw);
    buffer.drop(heap, laid);
    buffer.drop(heap, names);
    unbox_slice(heap, lens);
    var none = false;
    borrow tests as &tz in {
        none = buffer.size(tz) == 0;
    }
    if status == 0 && none {
        console.error_all(io, "no `test_*` functions found in the files given\n\n`cancho test` runs the functions named `test_*` (`docs/testing.md` §3); a run that found none is not a pass\n");
        status = 2;
    }
    if status != 0 {
        buffer.drop(heap, tests);
        return status;
    }
    borrow tests as &tt in {
        status = test_program(heap, io, args, fs, exec, clock, std_dir, host, host_given, clang_at, buffer.bytes(tt));
    }
    buffer.drop(heap, tests);
    return status;
}

// `satisfy [--host H] [--std-dir DIR] [--clang PATH] CONTRACT CANDIDATE` (`docs/cli-in-cancho.md` section 18): the two files (and the library) are checked as one program; the tests
// are those of the contract alone (`testscan.cho`), and there must be some; the contract must call something the candidate declares (by name, in its text, `satisfytext.calls_any`);
// then the tests are run as `test` runs them. Satisfied is status 0 and the identity of the signature of each function of the candidate; a test that fails is 4.
fn satisfy_pair[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, std_dir: int, host_in: int, host_given: bool, clang_at: int) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, exec(""), clock, poll] int {
    let loaded = load_program(heap, io, args, fs, true, false, std_dir, "", "");
    let Loaded { names, raw, laid, lens, count, read_status } = loaded;
    var status = read_status;
    var candidate = buffer.empty(heap, 0);
    var whole = buffer.empty(heap, 0);
    var tests = buffer.empty(heap, 0);
    var provided = buffer.empty(heap, 0);
    var joined = buffer.empty(heap, 0);
    var calls = true;
    borrow raw as &r in {
        borrow laid as &lt in {
            borrow names as &nm in {
                borrow mut lens as &!lb in {
                    if status == 0 {
                        // The pair, and the library, as one program: nothing is asked of it but that it checks.
                        let checked = driver.run_many(heap, io, buffer.bytes(r), 10, host_in);
                        borrow checked as &b in {
                            status = report_check(heap, io, buffer.bytes(nm), buffer.bytes(lt), contents(lb), false, b.status, b.rule, b.from, b.to);
                        }
                        driver.discard(heap, checked);
                    }
                    if status == 0 {
                        let Found { found, how } = scan_tests(heap, io, satisfytext.record(buffer.bytes(r), 0), buffer.bytes(nm), buffer.bytes(lt), contents(lb));
                        buffer.drop(heap, tests);
                        tests = found;
                        status = how;
                    }
                    if status == 0 {
                        let listed = driver.run_many(heap, io, satisfytext.record(buffer.bytes(r), 1), 13, host_in);
                        borrow listed as &lg in {
                            buffer.drop(heap, candidate);
                            candidate = buffer.append(heap, buffer.empty(heap, buffer.size(lg.ir) + 1), buffer.bytes(lg.ir));
                        }
                        driver.discard(heap, listed);
                        let all = driver.run_many(heap, io, buffer.bytes(r), 13, host_in);
                        borrow all as &lg in {
                            buffer.drop(heap, whole);
                            whole = buffer.append(heap, buffer.empty(heap, buffer.size(lg.ir) + 1), buffer.bytes(lg.ir));
                        }
                        driver.discard(heap, all);
                        borrow candidate as &cb in {
                            buffer.drop(heap, provided);
                            provided = satisfytext.provided(heap, buffer.bytes(cb), false);
                            buffer.drop(heap, joined);
                            joined = satisfytext.provided(heap, buffer.bytes(cb), true);
                        }
                        borrow provided as &pv in {
                            if len(buffer.bytes(pv)) > 0 {
                                calls = satisfytext.calls_any(heap, buffer.bytes(lt)[0..contents(lb)[0]], buffer.bytes(pv));
                            }
                        }
                    }
                }
            }
        }
    }
    buffer.drop(heap, raw);
    buffer.drop(heap, laid);
    buffer.drop(heap, names);
    unbox_slice(heap, lens);
    var none = false;
    borrow tests as &tz in {
        none = buffer.size(tz) == 0;
    }
    if status == 0 && none {
        status = usage_error(heap, io, "the contract declares no `test_*` functions; a contract that tests nothing cannot be satisfied");
    }
    if status == 0 && !calls {
        var why = buffer.append(heap, buffer.empty(heap, 256), "the contract never calls anything the candidate declares (");
        borrow joined as &jn in {
            why = buffer.append(heap, why, buffer.bytes(jn));
        }
        why = buffer.append(heap, why, "); a contract that does not exercise the candidate is satisfied by every candidate");
        borrow why as &wy in {
            status = usage_error(heap, io, buffer.bytes(wy));
        }
        buffer.drop(heap, why);
    }
    if status == 0 {
        borrow tests as &tt in {
            status = test_program(heap, io, args, fs, exec, clock, std_dir, host_in, host_given, clang_at, buffer.bytes(tt));
        }
        if status == 0 {
            console.write_all(io, "satisfied\n");
            borrow whole as &wl in {
                borrow candidate as &cd in {
                    var at = 0;
                    let list = buffer.bytes(wl);
                    while at < len(list) {
                        let m = satisfytext.module_end(list, at);
                        let n = satisfytext.name_end(list, at);
                        let h = satisfytext.identity_end(list, at);
                        if satisfytext.has_entry(buffer.bytes(cd), list[at..m], list[m + 1..n]) {
                            console.write_all(io, "  ");
                            console.write_all(io, list[at..m]);
                            if m > at {
                                console.write_all(io, "::");
                            }
                            console.write_all(io, " sig ");
                            console.write_all(io, list[m + 1..n]);
                            console.write_all(io, "\n    sig_id ");
                            console.write_all(io, list[n + 1..h]);
                            console.write_all(io, "\n");
                        }
                        at = h + 1;
                    }
                }
            }
        } else if status == 4 {
            console.write_all(io, "not satisfied: see the test failures above\n");
        }
    }
    buffer.drop(heap, candidate);
    buffer.drop(heap, whole);
    buffer.drop(heap, tests);
    buffer.drop(heap, provided);
    buffer.drop(heap, joined);
    return status;
}

fn satisfy_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, exec(""), clock, poll] int {
    var host = 0;
    var host_given = false;
    var clang_at = 0 - 1;
    var std_dir = 0 - 1;
    var files = 0;
    var n = 2;
    while n < arg_count(args) {
        let word = arg(args, n);
        if bytes.equal(word, "--host") {
            n = n + 1;
            host_given = true;
            if n < arg_count(args) && bytes.equal(arg(args, n), "linux") {
                host = 0;
            } else if n < arg_count(args) && bytes.equal(arg(args, n), "darwin") {
                host = 1;
            } else if n < arg_count(args) && bytes.equal(arg(args, n), "linux-aarch64") {
                host = 2;
            } else {
                return usage_error(heap, io, "`--host` needs linux, darwin or linux-aarch64");
            }
        } else if bytes.equal(word, "--std-dir") {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`--std-dir` needs a directory");
            }
            std_dir = n;
        } else if bytes.equal(word, "--clang") {
            n = n + 1;
            if n >= arg_count(args) {
                return usage_error(heap, io, "`--clang` needs a path");
            }
            clang_at = n;
        } else if bytes.equal(word, "--std") {
            return usage_error(heap, io, "`--std` is not available in this command line: `--std-dir DIR` adds the standard library from DIR");
        } else if len(word) > 0 && lc.at(word, 0) == '-' {
            let why = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), "unknown `satisfy` option `"), word), "`");
            var said = 0;
            borrow why as &wy in {
                said = usage_error(heap, io, buffer.bytes(wy));
            }
            buffer.drop(heap, why);
            return said;
        } else {
            files = files + 1;
        }
        n = n + 1;
    }
    if files != 2 {
        return usage_error(heap, io, "`cancho satisfy <contract.cho> <candidate.cho> [--std]` — exactly two files");
    }
    return satisfy_pair(heap, io, args, fs, exec, clock, std_dir, host, host_given, clang_at);
}

fn run[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_read, io_write, err_write, args, fs_read(""), fs_write(""), dir_read, file_read, file_write, exec(""), clock, poll] int {
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "fmt") {
        return fmt_command(heap, io, args, fs);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "check") {
        return program_command(heap, io, args, fs, exec, clock, false, false, false, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "build") {
        return program_command(heap, io, args, fs, exec, clock, false, false, true, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "run") {
        return program_command(heap, io, args, fs, exec, clock, false, false, true, true);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "test") {
        return test_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "satisfy") {
        return satisfy_command(heap, io, args, fs, exec, clock);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "layout") {
        return program_command(heap, io, args, fs, exec, clock, false, true, false, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "ids") {
        return program_command(heap, io, args, fs, exec, clock, true, false, false, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "print") {
        return one_file_command(heap, io, args, fs, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "ingest") {
        return one_file_command(heap, io, args, fs, true);
    }
    if arg_count(args) >= 2 && (bytes.equal(arg(args, 1), "--help") || bytes.equal(arg(args, 1), "-h") || bytes.equal(arg(args, 1), "help")) {
        show(heap, io, commandtree.usage(heap, buffer.empty(heap, 12000)));
        return 0;
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "introspect") {
        return tree_command(heap, io, args, fs, false);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "skill") {
        return tree_command(heap, io, args, fs, true);
    }
    if arg_count(args) >= 2 && bytes.equal(arg(args, 1), "agent-guidelines") {
        if arg_count(args) > 2 {
            console.error_all(io, "usage: `agent-guidelines` takes no arguments\n");
            return 2;
        }
        show(heap, io, guidelines.print(heap, buffer.empty(heap, 40000)));
        return 0;
    }
    console.error_all(io, "usage: cancho (fmt [--check] PATH... | print [--output json] FILE | ingest FILE | agent-guidelines)\n");
    return 2;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);
    release(ffi);
    release(net);
    release(signals);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow fs as &f in {
                    borrow exec as &x in {
                        borrow clock as &k in {
                            status = run(h, i, a, f, x, k);
                        }
                    }
                }
            }
        }
    }
    release(clock);
    release(exec);
    release(fs);
    release(args);
    release(heap);
    release(io);
    return status;
}
