// ingester.cho -- `cancho ingest`, written in cancho: the program (issue #485).
//
// Reads JSON on standard input (what `jsonprinter.cho` writes) and writes the canonical text of the program it stands for, or `ERR rule-tag
// start end` with a span in the JSON if it is refused (`ingest-json`, `ingest-node`, `ingest-arity`). The oracle is `cancho ingest`.
//
//     cancho run examples/selfhost/ingester.cho examples/selfhost/driver.cho ... --std < f.json

import selfhost.driver;

fn main(world: World) -> [] int {
    return driver.drive(world, 8, false);
}
