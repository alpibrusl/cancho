module selfhost.codes;

// codes.cho -- which builtins the code is written for, by the number `exprs.builtin_call` gives each: 1 `putchar` to 17
// `child_wait` (the runtime and the files), 18 to 30 the float ones (`floatcode.cho`), 136 `child_pid`, 137 `child_release` and 138 `child_kill_group`.

import selfhost.lexcore as lc;

pub fn builtin_code[&x](text: &x [byte], from: int, to: int) -> [] int {
    if lc.spells(text, from, to, "putchar") {
        return 1;
    }
    if lc.spells(text, from, to, "write_bytes") {
        return 2;
    }
    if lc.spells(text, from, to, "int_of") {
        return 3;
    }
    if lc.spells(text, from, to, "byte_of") {
        return 4;
    }
    if lc.spells(text, from, to, "wrapping_add") {
        return 5;
    }
    if lc.spells(text, from, to, "wrapping_sub") {
        return 6;
    }
    if lc.spells(text, from, to, "wrapping_mul") {
        return 7;
    }
    if lc.spells(text, from, to, "copy_into") {
        return 8;
    }
    if lc.spells(text, from, to, "index_of_byte") {
        return 9;
    }
    if lc.spells(text, from, to, "getchar") {
        return 10;
    }
    if lc.spells(text, from, to, "write_err") {
        return 11;
    }
    if lc.spells(text, from, to, "arg_count") {
        return 12;
    }
    if lc.spells(text, from, to, "arg") {
        return 13;
    }
    if lc.spells(text, from, to, "file_write") {
        return 14;
    }
    if lc.spells(text, from, to, "file_read") {
        return 15;
    }
    if lc.spells(text, from, to, "file_close") {
        return 16;
    }
    if lc.spells(text, from, to, "file_pwrite") {
        return 111;
    }
    if lc.spells(text, from, to, "file_pread") {
        return 112;
    }
    if lc.spells(text, from, to, "file_sync") {
        return 113;
    }
    if lc.spells(text, from, to, "file_truncate") {
        return 114;
    }
    if lc.spells(text, from, to, "file_size") {
        return 115;
    }
    if lc.spells(text, from, to, "file_lock") {
        return 116;
    }
    if lc.spells(text, from, to, "child_wait") {
        return 17;
    }
    if lc.spells(text, from, to, "child_pid") {
        return 136;
    }
    if lc.spells(text, from, to, "child_release") {
        return 137;
    }
    if lc.spells(text, from, to, "float_of") {
        return 18;
    }
    if lc.spells(text, from, to, "truncate") {
        return 19;
    }
    if lc.spells(text, from, to, "bits_of") {
        return 20;
    }
    if lc.spells(text, from, to, "float_of_bits") {
        return 21;
    }
    if lc.spells(text, from, to, "is_nan") {
        return 22;
    }
    if lc.spells(text, from, to, "sqrt") {
        return 23;
    }
    if lc.spells(text, from, to, "f32_of") {
        return 24;
    }
    if lc.spells(text, from, to, "float_of32") {
        return 25;
    }
    if lc.spells(text, from, to, "bits_of32") {
        return 26;
    }
    if lc.spells(text, from, to, "f32_of_bits") {
        return 27;
    }
    if lc.spells(text, from, to, "sqrt32") {
        return 28;
    }
    if lc.spells(text, from, to, "f32_of_int") {
        return 29;
    }
    if lc.spells(text, from, to, "int_of_f32") {
        return 30;
    }
    if lc.spells(text, from, to, "null_ptr") {
        return 31;
    }
    return 0;
}

// The sockets and the clock, which `exprs.net_call` writes: 32 `bind`, 33 `connect`, 34 `listen`, 35 `accept`,
// 36 `tcp_listen`, 37 `tcp_connect`, 38 `tcp_accept`, 39 `conn_read`, 40 `conn_write`, 41 `conn_nonblocking`,
// 42 `listener_nonblocking`, 43 `conn_nodelay`, 44 `conn_close`, 45 `listener_close`, 46 `clock_ms`,
// 47 `clock_unix_ms`, 93 to 105 the poller and the hand-over of a connection (see `netcode.cho`), 48 `pipe_open`, 49 `pipe_read`, 50 `pipe_write`, 51 `pipe_close`, 52 `child_end_close`,
// 53 `pipe_nonblocking`, then the directories: 54 `open_dir`, 55 `dir_enter`, 56 `dir_open_read`, 57 `dir_open_new`,
// 58 `dir_open_append`, 59 `dir_rename`, 60 `dir_rename_new`, 61 `dir_remove`, 62 `dir_sync`, 63 `dir_close`, 64 `dir_list`,
// 65 `dir_next`, 66 `dir_list_close`, 67 `dir_stat`, 68 `dir_mode`, 69 `dir_own_mode`, 139 `dir_mkdir`, 140 `dir_open_new_mode`; 0 for another name.
pub fn net_code[&x](text: &x [byte], from: int, to: int) -> [] int {
    if lc.spells(text, from, to, "bind") {
        return 32;
    }
    if lc.spells(text, from, to, "connect") {
        return 33;
    }
    if lc.spells(text, from, to, "listen") {
        return 34;
    }
    if lc.spells(text, from, to, "accept") {
        return 35;
    }
    if lc.spells(text, from, to, "tcp_listen_on") {
        return 128;
    }
    if lc.spells(text, from, to, "tcp_listen") {
        return 36;
    }
    if lc.spells(text, from, to, "tcp_connect") {
        return 37;
    }
    if lc.spells(text, from, to, "tcp_accept") {
        return 38;
    }
    if lc.spells(text, from, to, "conn_read") {
        return 39;
    }
    if lc.spells(text, from, to, "conn_write") {
        return 40;
    }
    if lc.spells(text, from, to, "conn_nonblocking") {
        return 41;
    }
    if lc.spells(text, from, to, "listener_nonblocking") {
        return 42;
    }
    if lc.spells(text, from, to, "conn_nodelay") {
        return 43;
    }
    if lc.spells(text, from, to, "conn_close") {
        return 44;
    }
    if lc.spells(text, from, to, "listener_close") {
        return 45;
    }
    if lc.spells(text, from, to, "clock_ms") {
        return 46;
    }
    if lc.spells(text, from, to, "clock_unix_ms") {
        return 47;
    }
    if lc.spells(text, from, to, "pipe_open") {
        return 48;
    }
    if lc.spells(text, from, to, "pipe_read") {
        return 49;
    }
    if lc.spells(text, from, to, "pipe_write") {
        return 50;
    }
    if lc.spells(text, from, to, "pipe_close") {
        return 51;
    }
    if lc.spells(text, from, to, "child_end_close") {
        return 52;
    }
    if lc.spells(text, from, to, "pipe_nonblocking") {
        return 53;
    }
    if lc.spells(text, from, to, "open_dir") {
        return 54;
    }
    if lc.spells(text, from, to, "dir_enter") {
        return 55;
    }
    if lc.spells(text, from, to, "dir_open_read") {
        return 56;
    }
    if lc.spells(text, from, to, "dir_open_new") {
        return 57;
    }
    if lc.spells(text, from, to, "dir_open_append") {
        return 58;
    }
    if lc.spells(text, from, to, "dir_rename") {
        return 59;
    }
    if lc.spells(text, from, to, "dir_rename_new") {
        return 60;
    }
    if lc.spells(text, from, to, "dir_remove") {
        return 61;
    }
    if lc.spells(text, from, to, "dir_sync") {
        return 62;
    }
    if lc.spells(text, from, to, "dir_close") {
        return 63;
    }
    if lc.spells(text, from, to, "dir_list") {
        return 64;
    }
    if lc.spells(text, from, to, "dir_next") {
        return 65;
    }
    if lc.spells(text, from, to, "dir_list_close") {
        return 66;
    }
    if lc.spells(text, from, to, "dir_stat") {
        return 67;
    }
    if lc.spells(text, from, to, "dir_mode") {
        return 68;
    }
    if lc.spells(text, from, to, "dir_own_mode") {
        return 69;
    }
    if lc.spells(text, from, to, "dir_open_new_mode") {
        return 140;
    }
    if lc.spells(text, from, to, "dir_mkdir") {
        return 139;
    }
    if lc.spells(text, from, to, "tty_open") {
        return 122;
    }
    if lc.spells(text, from, to, "tty_configure") {
        return 123;
    }
    if lc.spells(text, from, to, "tty_read") {
        return 124;
    }
    if lc.spells(text, from, to, "tty_write") {
        return 125;
    }
    if lc.spells(text, from, to, "tty_flush_input") {
        return 126;
    }
    if lc.spells(text, from, to, "tty_close") {
        return 44;
    }
    if lc.spells(text, from, to, "udp_connect") {
        return 129;
    }
    if lc.spells(text, from, to, "udp_bind") {
        return 130;
    }
    if lc.spells(text, from, to, "udp_recv_from") {
        return 132;
    }
    if lc.spells(text, from, to, "udp_recv") {
        return 131;
    }
    if lc.spells(text, from, to, "udp_send_to") {
        return 133;
    }
    if lc.spells(text, from, to, "udp_peer") {
        return 134;
    }
    if lc.spells(text, from, to, "udp_local_port") {
        return 135;
    }
    if lc.spells(text, from, to, "udp_send") {
        return 40;
    }
    if lc.spells(text, from, to, "udp_nonblocking") {
        return 41;
    }
    if lc.spells(text, from, to, "udp_close") {
        return 44;
    }
    if lc.spells(text, from, to, "child_kill") {
        return 127;
    }
    if lc.spells(text, from, to, "child_kill_group") {
        return 138;
    }
    if lc.spells(text, from, to, "signals_watch") {
        return 119;
    }
    if lc.spells(text, from, to, "signals_pending") {
        return 120;
    }
    if lc.spells(text, from, to, "signals_close") {
        return 121;
    }
    if lc.spells(text, from, to, "poller_new") {
        return 93;
    }
    if lc.spells(text, from, to, "poller_add_listener") {
        return 94;
    }
    if lc.spells(text, from, to, "poller_add_signals") {
        return 94;
    }
    if lc.spells(text, from, to, "poller_add_conn") {
        return 95;
    }
    if lc.spells(text, from, to, "poller_add_udp") {
        return 95;
    }
    if lc.spells(text, from, to, "poller_add_pipe") {
        return 95;
    }
    if lc.spells(text, from, to, "poller_add_tty") {
        return 95;
    }
    if lc.spells(text, from, to, "poller_modify") {
        return 96;
    }
    if lc.spells(text, from, to, "poller_remove") {
        return 97;
    }
    if lc.spells(text, from, to, "poller_wait") {
        return 98;
    }
    if lc.spells(text, from, to, "poller_add_child") {
        return 99;
    }
    if lc.spells(text, from, to, "conn_detach") {
        return 101;
    }
    if lc.spells(text, from, to, "udp_detach") {
        return 102;
    }
    if lc.spells(text, from, to, "conn_attach") {
        return 103;
    }
    if lc.spells(text, from, to, "udp_attach") {
        return 104;
    }
    if lc.spells(text, from, to, "poller_close") {
        return 105;
    }
    if lc.spells(text, from, to, "flush_out") {
        return 106;
    }
    if lc.spells(text, from, to, "read_bytes") {
        return 107;
    }
    if lc.spells(text, from, to, "conn_connect_status") {
        return 108;
    }
    if lc.spells(text, from, to, "conn_peer") {
        return 109;
    }
    if lc.spells(text, from, to, "tcp_connect_start") {
        return 110;
    }
    return 0;
}

// The builtins on words, which `exprs.builtin_call` writes through `wordcode.cho`: 70 `trap`, 71 `copy_within`,
// 72 `value_barrier`, 73 `mul_wide`, 74 `add_carry`, 75 `sub_borrow`, 76 `load_le64`, 77 `byte_mask64`,
// 78 `trailing_zeros`, 79 `leading_zeros`, 80 `popcount`; 0 for another name.
pub fn word_code[&x](text: &x [byte], from: int, to: int) -> [] int {
    if lc.spells(text, from, to, "trap") {
        return 70;
    }
    if lc.spells(text, from, to, "copy_within") {
        return 71;
    }
    if lc.spells(text, from, to, "value_barrier") {
        return 72;
    }
    if lc.spells(text, from, to, "mul_wide") {
        return 73;
    }
    if lc.spells(text, from, to, "add_carry") {
        return 74;
    }
    if lc.spells(text, from, to, "sub_borrow") {
        return 75;
    }
    if lc.spells(text, from, to, "load_le64") {
        return 76;
    }
    if lc.spells(text, from, to, "byte_mask64") {
        return 77;
    }
    if lc.spells(text, from, to, "trailing_zeros") {
        return 78;
    }
    if lc.spells(text, from, to, "leading_zeros") {
        return 79;
    }
    if lc.spells(text, from, to, "popcount") {
        return 80;
    }
    if lc.spells(text, from, to, "fork_heap") {
        return 81;
    }
    if lc.spells(text, from, to, "fork_clock") {
        return 82;
    }
    return 0;
}

// The hardware AES and GHASH builtins, which `exprs.builtin_call` writes through `cryptocode.cho`: 83 `hw_aes_gcm`,
// 84 `aes_encrypt_block`, 85 `aes_ctr32`, 86 `ghash_update`, 87 `ghash_powers`, 88 `gcm_tag`, 89 `gcm_tag_diff`, 90 `hw_sha256`, 91 `sha256_blocks`, 92 `sha256_block_words`; 0 for
// another name.
pub fn crypto_code[&x](text: &x [byte], from: int, to: int) -> [] int {
    if lc.spells(text, from, to, "hw_aes_gcm") {
        return 83;
    }
    if lc.spells(text, from, to, "aes_encrypt_block") {
        return 84;
    }
    if lc.spells(text, from, to, "aes_ctr32") {
        return 85;
    }
    if lc.spells(text, from, to, "ghash_update") {
        return 86;
    }
    if lc.spells(text, from, to, "ghash_powers") {
        return 87;
    }
    if lc.spells(text, from, to, "gcm_tag") {
        return 88;
    }
    if lc.spells(text, from, to, "gcm_tag_diff") {
        return 89;
    }
    if lc.spells(text, from, to, "hw_sha256") {
        return 90;
    }
    if lc.spells(text, from, to, "sha256_blocks") {
        return 91;
    }
    if lc.spells(text, from, to, "sha256_block_words") {
        return 92;
    }
    return 0;
}
