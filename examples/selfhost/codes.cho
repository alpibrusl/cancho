module selfhost.codes;

// codes.cho -- which builtins the code is written for, by the number `exprs.builtin_call` gives each: 1 `putchar` to 17
// `child_wait` (the runtime and the files), 18 to 30 the float ones (`floatcode.cho`).

import selfhost.lexcore as lc;

pub fn builtin_code[&x](text: &x [byte], from: int, to: int) -> [] int {
    if lc.spells(text, from, to, "putchar") {
        return 1;
    }
    if lc.spells(text, from, to, "write_bytes") {
        return 2;
    }
    if lc.spells(text, from, to, "int_of") {
        return 3;
    }
    if lc.spells(text, from, to, "byte_of") {
        return 4;
    }
    if lc.spells(text, from, to, "wrapping_add") {
        return 5;
    }
    if lc.spells(text, from, to, "wrapping_sub") {
        return 6;
    }
    if lc.spells(text, from, to, "wrapping_mul") {
        return 7;
    }
    if lc.spells(text, from, to, "copy_into") {
        return 8;
    }
    if lc.spells(text, from, to, "index_of_byte") {
        return 9;
    }
    if lc.spells(text, from, to, "getchar") {
        return 10;
    }
    if lc.spells(text, from, to, "write_err") {
        return 11;
    }
    if lc.spells(text, from, to, "arg_count") {
        return 12;
    }
    if lc.spells(text, from, to, "arg") {
        return 13;
    }
    if lc.spells(text, from, to, "file_write") {
        return 14;
    }
    if lc.spells(text, from, to, "file_read") {
        return 15;
    }
    if lc.spells(text, from, to, "file_close") {
        return 16;
    }
    if lc.spells(text, from, to, "child_wait") {
        return 17;
    }
    if lc.spells(text, from, to, "float_of") {
        return 18;
    }
    if lc.spells(text, from, to, "truncate") {
        return 19;
    }
    if lc.spells(text, from, to, "bits_of") {
        return 20;
    }
    if lc.spells(text, from, to, "float_of_bits") {
        return 21;
    }
    if lc.spells(text, from, to, "is_nan") {
        return 22;
    }
    if lc.spells(text, from, to, "sqrt") {
        return 23;
    }
    if lc.spells(text, from, to, "f32_of") {
        return 24;
    }
    if lc.spells(text, from, to, "float_of32") {
        return 25;
    }
    if lc.spells(text, from, to, "bits_of32") {
        return 26;
    }
    if lc.spells(text, from, to, "f32_of_bits") {
        return 27;
    }
    if lc.spells(text, from, to, "sqrt32") {
        return 28;
    }
    if lc.spells(text, from, to, "f32_of_int") {
        return 29;
    }
    if lc.spells(text, from, to, "int_of_f32") {
        return 30;
    }
    if lc.spells(text, from, to, "null_ptr") {
        return 31;
    }
    return 0;
}

// The sockets and the clock, which `exprs.net_call` writes: 32 `bind`, 33 `connect`, 34 `listen`, 35 `accept`,
// 36 `tcp_listen`, 37 `tcp_connect`, 38 `tcp_accept`, 39 `conn_read`, 40 `conn_write`, 41 `conn_nonblocking`,
// 42 `listener_nonblocking`, 43 `conn_nodelay`, 44 `conn_close`, 45 `listener_close`, 46 `clock_ms`,
// 47 `clock_unix_ms`, 48 `pipe_open`, 49 `pipe_read`, 50 `pipe_write`, 51 `pipe_close`, 52 `child_end_close`,
// 53 `pipe_nonblocking`; 0 for another name.
pub fn net_code[&x](text: &x [byte], from: int, to: int) -> [] int {
    if lc.spells(text, from, to, "bind") {
        return 32;
    }
    if lc.spells(text, from, to, "connect") {
        return 33;
    }
    if lc.spells(text, from, to, "listen") {
        return 34;
    }
    if lc.spells(text, from, to, "accept") {
        return 35;
    }
    if lc.spells(text, from, to, "tcp_listen") {
        return 36;
    }
    if lc.spells(text, from, to, "tcp_connect") {
        return 37;
    }
    if lc.spells(text, from, to, "tcp_accept") {
        return 38;
    }
    if lc.spells(text, from, to, "conn_read") {
        return 39;
    }
    if lc.spells(text, from, to, "conn_write") {
        return 40;
    }
    if lc.spells(text, from, to, "conn_nonblocking") {
        return 41;
    }
    if lc.spells(text, from, to, "listener_nonblocking") {
        return 42;
    }
    if lc.spells(text, from, to, "conn_nodelay") {
        return 43;
    }
    if lc.spells(text, from, to, "conn_close") {
        return 44;
    }
    if lc.spells(text, from, to, "listener_close") {
        return 45;
    }
    if lc.spells(text, from, to, "clock_ms") {
        return 46;
    }
    if lc.spells(text, from, to, "clock_unix_ms") {
        return 47;
    }
    if lc.spells(text, from, to, "pipe_open") {
        return 48;
    }
    if lc.spells(text, from, to, "pipe_read") {
        return 49;
    }
    if lc.spells(text, from, to, "pipe_write") {
        return 50;
    }
    if lc.spells(text, from, to, "pipe_close") {
        return 51;
    }
    if lc.spells(text, from, to, "child_end_close") {
        return 52;
    }
    if lc.spells(text, from, to, "pipe_nonblocking") {
        return 53;
    }
    return 0;
}
