    part_0(io);
    part_1(io);
    part_2(io);
    part_3(io);
    part_4(io);
    part_5(io);
    part_6(io);
    part_7(io);
    part_8(io);
    part_9(io);
    part_10(io);
    part_11(io);
    part_12(io);
    part_13(io);
    part_14(io);
    part_15(io);
    part_16(io);
    part_17(io);
    part_18(io);
    part_19(io);
    part_20(io);
    part_21(io);
    part_22(io);
    part_23(io);
    part_24(io);
    part_25(io);
    return 0;
}
