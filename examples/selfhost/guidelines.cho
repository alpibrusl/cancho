edition 7;
module selfhost.guidelines;

// guidelines.cho -- the text of `AGENTS.md`, for `cancho agent-guidelines` (`docs/cli-in-cancho.md`).
// GENERATED by the test `selfhost::guidelines_module_is_the_text_of_agents_md`: change `AGENTS.md`, then run it with CANCHO_REGENERATE=1.

import std.io as console;

fn part_0[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "# Writing cancho\n");
    console.write_all(io, "\n");
    console.write_all(io, "> The entry point this repository did not have. `docs/` is **90,000\n");
    console.write_all(io, "> words across 42 documents** and none of them is a first page, so an\n");
    console.write_all(io, "> agent asked to write cancho had the choice of reading all of it or\n");
    console.write_all(io, "> guessing. This is the short version, and every rule in it is here\n");
    console.write_all(io, "> because something in this repository got it wrong first.\n");
    console.write_all(io, ">\n");
    console.write_all(io, "> `cancho agent-guidelines` prints this file. The compiler carries it,\n");
    console.write_all(io, "> so a checkout is not required to read it.\n");
    console.write_all(io, ">\n");
    console.write_all(io, "> **Every checked code block below is run by the test suite.** The ones\n");
    console.write_all(io, "> marked `cancho` must compile; the ones marked `cancho-refused` must\n");
    console.write_all(io, "> be refused, with the rule they name. A guideline that stops being true\n");
    console.write_all(io, "> is a red build, not a stale paragraph.\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "## 0. The loop\n");
    console.write_all(io, "\n");
    console.write_all(io, "```sh\n");
    console.write_all(io, "cancho check src/*.cho --std               # does it type-check?\n");
    console.write_all(io, "cancho check src/*.cho --std --output json # …and which rule, as data\n");
    console.write_all(io, "cancho authority src/*.cho --std           # what can it reach?\n");
    console.write_all(io, "cancho run src/*.cho --std                 # build and run in one step\n");
    console.write_all(io, "cancho fmt --check src/ tests/            # is it canonical? (`fmt src/` rewrites; docs/formatting.md)\n");
    console.write_all(io, "cancho test tests/*.cho --std              # run every `fn test_*`; exit 4 if one failed (docs/testing.md)\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "`check` reports **every** independent refusal, not the first. On a\n");
    console.write_all(io, "failure, read the `rule` field rather than the sentence: it is a stable\n");
    console.write_all(io, "name, there are 58 of them, and `docs/agent-errors.md` is the contract.\n");
    console.write_all(io, "One of them, `internal`, is the compiler's own failure, not your\n");
    console.write_all(io, "program's (`docs/internal-errors.md`).\n");
    console.write_all(io, "\n");
    console.write_all(io, "`cancho skill` and `cancho introspect` are how *this* page and the\n");
    console.write_all(io, "full command surface stay the same age: both are generated from one\n");
    console.write_all(io, "registration (`src/acli.rs`), not copied by hand, so a new command\n");
    console.write_all(io, "cannot ship without them (`docs/agent-cli.md`). Their \"Exit codes\" /\n");
    console.write_all(io, "\"Output format\" sections are the ACLI SDK's own generic template,\n");
    return 0;
}

fn part_1[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "though, not this binary's -- the real exit codes are at the top of\n");
    console.write_all(io, "`main.rs` and in `docs/agent-errors.md`.\n");
    console.write_all(io, "\n");
    console.write_all(io, "**Do not regenerate a body because it was refused.** Every rule below\n");
    console.write_all(io, "names what to change.\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "## 1. Ownership moves, and there is no `&mut self`\n");
    console.write_all(io, "\n");
    console.write_all(io, "`std.buffer`, `std.vec` and `std.list` take their resource **by value**\n");
    console.write_all(io, "and hand it back. A loop that fills one moves it round and round:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "import std.buffer;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn collect[&h, &i](heap: &!h Heap, io: &!i Io) -> [heap, io_read] buffer.Buffer {\n");
    console.write_all(io, "    var out = buffer.empty(heap, 64);\n");
    console.write_all(io, "    var c = getchar(io);\n");
    console.write_all(io, "    while c >= 0 {\n");
    console.write_all(io, "        // The shape that repeats everywhere: take it, hand it back.\n");
    console.write_all(io, "        out = buffer.push(heap, out, byte_of(c));\n");
    console.write_all(io, "        c = getchar(io);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return out;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args);\n");
    console.write_all(io, "    borrow mut heap as &!h in {\n");
    console.write_all(io, "        borrow mut io as &!i in {\n");
    console.write_all(io, "            let text = collect(h, i);\n");
    console.write_all(io, "            buffer.drop(h, text);\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap); release(io);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    return 0;
}

fn part_2[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "\n");
    console.write_all(io, "`out = f(h, out, x)` is three tokens longer than `f(&mut out, x)` every\n");
    console.write_all(io, "single time, and it is the cost of linearity stated honestly\n");
    console.write_all(io, "(`docs/porting.md` §9.2 — six sites in one program).\n");
    console.write_all(io, "\n");
    console.write_all(io, "**A function that owns a resource and can fail must hand it back on the\n");
    console.write_all(io, "failing path too.** `read_file` answers `(Buffer, int)` for exactly that\n");
    console.write_all(io, "reason: a tuple is not elegant, and it is not something you can forget\n");
    console.write_all(io, "to write.\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "## 2. A `res` value is consumed exactly once, on every path\n");
    console.write_all(io, "\n");
    console.write_all(io, "This is the largest family of refusals in the suite after plain type\n");
    console.write_all(io, "errors — 19 fixtures. Four ways to get it wrong:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE linear-value-unconsumed\n");
    console.write_all(io, "\n");
    console.write_all(io, "// Nothing consumes `heap` before the block ends.\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(io); release(ffi); release(fs); release(args);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "The others: using one after it has moved (`linear-use-after-move`, 8\n");
    console.write_all(io, "fixtures), consuming it in one branch and not another, and taking a\n");
    console.write_all(io, "field out of it instead of taking the whole value apart.\n");
    console.write_all(io, "\n");
    console.write_all(io, "**A capability is a `res` value like any other.** `main` owns what\n");
    console.write_all(io, "`split` hands it and must `release` each one; a helper **borrows**.\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "## 3. Own or borrow, and the row follows\n");
    console.write_all(io, "\n");
    console.write_all(io, "> Owning discharges. Borrowing declares.\n");
    return 0;
}

fn part_3[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "\n");
    console.write_all(io, "`main` owns its capabilities, so its row is `[]` — that is not a gap,\n");
    console.write_all(io, "it is the parameter list saying something stronger. A function handed\n");
    console.write_all(io, "`&!i Io` says `[io_write]`, because that is what it did with it.\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "import std.io;\n");
    console.write_all(io, "\n");
    console.write_all(io, "// Borrowed, so the row is exact.\n");
    console.write_all(io, "fn greet[&i](io: &!i Io) -> [io_write] int {\n");
    console.write_all(io, "    return io.write_all(io, \"hello\\n\");\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "// Owns, so the row is empty.\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(heap); release(args);\n");
    console.write_all(io, "    borrow mut io as &!i in { greet(i); }\n");
    console.write_all(io, "    release(io);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "### 3.1 Narrow the body, never widen the row\n");
    console.write_all(io, "\n");
    console.write_all(io, "An effect row is **exact in both directions**: a label the body performs\n");
    console.write_all(io, "must appear, and a label that appears must be performed.\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE effect-not-declared\n");
    console.write_all(io, "\n");
    console.write_all(io, "import std.io;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn greet[&i](io: &!i Io) -> [] int {\n");
    console.write_all(io, "    return io.write_all(io, \"hello\\n\");\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(heap); release(args);\n");
    return 0;
}

fn part_4[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    borrow mut io as &!i in { greet(i); }\n");
    console.write_all(io, "    release(io);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "The fix is `[io_write]` here, because that is what the body does. Where\n");
    console.write_all(io, "a row is wider than the body, **narrow the body** — do not widen the\n");
    console.write_all(io, "row to make the checker stop. `cancho authority` prints the union of\n");
    console.write_all(io, "what a program reaches, and a row that over-declares makes that report\n");
    console.write_all(io, "a lie.\n");
    console.write_all(io, "\n");
    console.write_all(io, "Labels: `io_read`, `io_write`, `err_write`, `fs_read(p)`, `fs_write(p)`,\n");
    console.write_all(io, "`heap`, `args`, `ffi(lib)`.\n");
    console.write_all(io, "\n");
    console.write_all(io, "### 3.2 Knowing you were asked to stop is a capability, not `Ffi(\"libc\")`\n");
    console.write_all(io, "\n");
    console.write_all(io, "`edition 6;` adds `Signals`, the eighth field of `Split`. Narrow it to the\n");
    console.write_all(io, "signals you claim, and the row says which: `signals(\"INT,TERM\")`, which\n");
    console.write_all(io, "`cancho authority` prints and which keeps the report bounded (the\n");
    console.write_all(io, "`sigblock`/`signal` workaround through `Ffi(\"libc\")` made it `UNBOUNDED`).\n");
    console.write_all(io, "`signals_pending` answers a bitmask of what arrived since the last call and\n");
    console.write_all(io, "never waits; `poller_add_signals` makes the claim something a `Poller`\n");
    console.write_all(io, "wakes for; `signals_close` ends it, and after it the next signal ends the\n");
    console.write_all(io, "process, which is \"a second signal kills at once\". Claim before the first\n");
    console.write_all(io, "`spawn` (`docs/signals.md`).\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "edition 6;\n");
    console.write_all(io, "import std.signals as sg;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn stopped[&w](watch: &!w SignalWatch) -> [signals_read] bool {\n");
    console.write_all(io, "    return sg.any(signals_pending(watch), sg.stop_signals());\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args, net, clock, signals } = split(world);\n");
    console.write_all(io, "    release(io); release(ffi); release(fs); release(heap); release(args);\n");
    console.write_all(io, "    release(net); release(clock);\n");
    console.write_all(io, "    let claim = narrow(signals, \"INT,TERM\");\n");
    return 0;
}

fn part_5[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    var status = 1;\n");
    console.write_all(io, "    borrow claim as &s in {\n");
    console.write_all(io, "        match signals_watch(s) {\n");
    console.write_all(io, "            Watching::Ok(w) => {\n");
    console.write_all(io, "                var watch = w;\n");
    console.write_all(io, "                borrow mut watch as &!wh in {\n");
    console.write_all(io, "                    if !stopped(wh) { status = 0; }\n");
    console.write_all(io, "                }\n");
    console.write_all(io, "                signals_close(watch);\n");
    console.write_all(io, "            }\n");
    console.write_all(io, "            Watching::Failed(e) => { status = 2; }\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(claim);\n");
    console.write_all(io, "    return status;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "### 3.3 Foreign code: say which library, and read which symbols\n");
    console.write_all(io, "\n");
    console.write_all(io, "`Ffi` is the one capability whose label does not bound what it authorises, so a program that calls C reports `bounded: false`. What it reports *with* that is exact:\n");
    console.write_all(io, "`cancho authority` lists every foreign symbol the program can reach as `scope:symbol` (`unbounded_by`, one per line in `--output json`, so a CI pin diffs an added symbol as one added\n");
    console.write_all(io, "line). A foreign function borrows **exactly one** `Ffi`, naming **one** library (anything else is `foreign-declaration`: a declaration with no capability used to be accepted and\n");
    console.write_all(io, "reported `bounded: true`). A program that calls two libraries narrows to a **set**, written in any order and answered alphabetically, and lends each function only what it needs:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "edition 5;\n");
    console.write_all(io, "\n");
    console.write_all(io, "extern fn labs[&f](ffi: &f Ffi(\"libc\"), n: int) -> [ffi(\"libc\")] int;\n");
    console.write_all(io, "extern fn pthread_self[&f](ffi: &f Ffi(\"libpthread\")) -> [ffi(\"libpthread\")] int;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn magnitude[&f](ffi: &f Ffi(\"libc\"), n: int) -> [ffi(\"libc\")] int {\n");
    console.write_all(io, "    return labs(ffi, n);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args, net, clock } = split(world);\n");
    console.write_all(io, "    release(io); release(fs); release(heap); release(args); release(net); release(clock);\n");
    console.write_all(io, "    let native = narrow(ffi, \"libpthread,libc\");\n");
    console.write_all(io, "    var status = 1;\n");
    return 0;
}

fn part_6[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    borrow native as &f in {\n");
    console.write_all(io, "        if magnitude(f, 0 - 7) == 7 && pthread_self(f) != 0 { status = 0; }\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(native);\n");
    console.write_all(io, "    return status;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "The library in `Ffi(\"...\")` is a **claim** the declaration makes; the symbol is the fact. A set is not a text prefix (`Ffi(\"libc\")` no longer narrows to `Ffi(\"libcrypto\")`), and a\n");
    console.write_all(io, "malformed one is `foreign-scope` (`docs/foreign-authority.md`).\n");
    console.write_all(io, "\n");
    console.write_all(io, "### 3.4 Two paths: narrow into several\n");
    console.write_all(io, "\n");
    console.write_all(io, "A program that reads two unrelated files (entropy from `/dev/urandom` and a certificate directory) cannot hold one `Fs` for both without holding `Fs(\"\")`, and then its report says\n");
    console.write_all(io, "`fs_read(\"\")`, which is every file. `narrow` takes one literal or several. With several it consumes the `Fs` (or `Exec`) and answers a **tuple**, one capability narrowed to each literal,\n");
    console.write_all(io, "in the order written; each helper then borrows the one it needs and declares one label:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "fn entropy[&f, &o](fs: &f Fs(\"/dev/urandom\"), out: &!o [byte]) -> [fs_read(\"/dev/urandom\")] int {\n");
    console.write_all(io, "    return fs_read(fs, \"/dev/urandom\", out);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn trust[&f, &o](fs: &f Fs(\"/etc/ssl/certs/ca-certificates.crt\"), out: &!o [byte]) -> [fs_read(\"/etc/ssl/certs/ca-certificates.crt\")] int {\n");
    console.write_all(io, "    return fs_read(fs, \"/etc/ssl/certs/ca-certificates.crt\", out);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(io); release(ffi); release(heap); release(args);\n");
    console.write_all(io, "    let (rng, ca) = narrow(fs, \"/dev/urandom\", \"/etc/ssl/certs/ca-certificates.crt\");\n");
    console.write_all(io, "    var got = 0;\n");
    console.write_all(io, "    region r {\n");
    console.write_all(io, "        let seed = alloc_slice[r](32, byte_of(0));\n");
    console.write_all(io, "        let pem = alloc_slice[r](4096, byte_of(0));\n");
    console.write_all(io, "        borrow rng as &x in { got = got + entropy(x, seed); }\n");
    console.write_all(io, "        borrow ca as &y in { got = got + trust(y, pem); }\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(rng);\n");
    console.write_all(io, "    release(ca);\n");
    console.write_all(io, "    return 0;\n");
    return 0;
}

fn part_7[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "The report names those two paths and nothing under the filesystem else. The literals must be **unrelated**: two equal, or one inside another, is `capability-not-narrowable` (the inner\n");
    console.write_all(io, "one grants nothing the outer does not), as is a literal that does not extend the capability's own path. A path chosen at run time cannot be a literal; the narrowest form for it is a\n");
    console.write_all(io, "fixed *directory* and a run-time name beneath it (`examples/tls_echo_fixed`). `Ffi` and `Signals` narrow to a *set* in one capability (`narrow(ffi, \"libc,libm\")`), and more than one\n");
    console.write_all(io, "literal on them, or on `Net`, is refused. [`docs/narrowing-into-several.md`](docs/narrowing-into-several.md) has the rule and its limits.\n");
    console.write_all(io, "\n");
    console.write_all(io, "### 3.5 A serial port is a capability, not a termios escape hatch\n");
    console.write_all(io, "\n");
    console.write_all(io, "Edition 8. A serial device is reached through `Tty`, which narrows by a\n");
    console.write_all(io, "device-path prefix exactly as `Fs` does — the same prefix rule, the same\n");
    console.write_all(io, "`narrow` forms, and the same refusal for an empty literal. The port\n");
    console.write_all(io, "handle is `Port`, a `res` value with one descriptor leaf (`Udp`'s shape),\n");
    console.write_all(io, "and the verbs are `tty_open`, `tty_configure` (raw mode, 8N1, a speed —\n");
    console.write_all(io, "one call, no mode algebra), `tty_read` (never blocks; the poller is the\n");
    console.write_all(io, "waiting story), `tty_write`, `tty_flush_input` and `tty_close`, plus\n");
    console.write_all(io, "`poller_add_tty`:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "edition 8;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn ping[&t, &b](tty: &t Tty(\"/dev\"), bus: &b [byte]) -> [tty_open(\"/dev\"), tty_read, tty_write] int {\n");
    console.write_all(io, "    match tty_open(tty, \"/dev/ttyACM0\") {\n");
    console.write_all(io, "        TtyOpened::Ok(port) => {\n");
    console.write_all(io, "            var got = 0 - 1;\n");
    console.write_all(io, "            borrow mut port as &!p in {\n");
    console.write_all(io, "                if tty_configure(p, 1000000) == 0 {\n");
    console.write_all(io, "                    region r {\n");
    console.write_all(io, "                        let reply = alloc_slice[r](16, byte_of(0));\n");
    console.write_all(io, "                        tty_write(p, bus);\n");
    console.write_all(io, "                        got = tty_read(p, reply);\n");
    console.write_all(io, "                    }\n");
    console.write_all(io, "                }\n");
    console.write_all(io, "            }\n");
    console.write_all(io, "            tty_close(port);\n");
    console.write_all(io, "            return got;\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "        TtyOpened::Failed(errno) => { return 0 - 1; }\n");
    console.write_all(io, "    }\n");
    return 0;
}

fn part_8[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);\n");
    console.write_all(io, "    release(io); release(ffi); release(fs); release(heap); release(args);\n");
    console.write_all(io, "    release(net); release(clock); release(signals); release(exec);\n");
    console.write_all(io, "    region r {\n");
    console.write_all(io, "        let bus = alloc_slice[r](1, byte_of(0));\n");
    console.write_all(io, "        let device = narrow(tty, \"/dev\");\n");
    console.write_all(io, "        borrow device as &t in { ping(t, bus); }\n");
    console.write_all(io, "        release(device);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "The termios layout, the octal B-constants and the macOS `IOSSIOSPEED`\n");
    console.write_all(io, "two-step are the backend's, written once in Rust — not nine `extern fn`\n");
    console.write_all(io, "declarations carrying a per-platform ABI in program source, which is\n");
    console.write_all(io, "what the robot's spike measured and the whole reason the capability\n");
    console.write_all(io, "exists ([`docs/tty.md`](docs/tty.md)). The report answers `tty_open(\"/dev\")`\n");
    console.write_all(io, "with the prefix and **no `foreign` line**: a program that moves a robot\n");
    console.write_all(io, "can be `bounded: true`.\n");
    console.write_all(io, "\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "### 3.6 A path outside the bound traps; ask first with `exec_covers` and `fs_covers`\n");
    console.write_all(io, "\n");
    console.write_all(io, "`exec_spawn` under `Exec(\"/opt/x\")` and every `Fs(\"/data\")` operation **trap** (the process ends with `SIGILL`, no\n");
    console.write_all(io, "value) when the path is outside the bound, has a `..` in it, or is 4096 bytes or more. That is the backstop. A\n");
    console.write_all(io, "program that has to turn a denied path into a recorded refusal and keep running (a supervisor, a policy layer) asks\n");
    console.write_all(io, "first, with the capability it is about to use (edition 9):\n");
    console.write_all(io, "\n");
    console.write_all(io, "* `exec_covers(exec, path)` and `fs_covers(fs, path)` answer a `bool`: `true` exactly when the operation would not\n");
    console.write_all(io, "  trap, by the same check the operation runs, so there is no second copy of the rule to keep in step. They have no\n");
    console.write_all(io, "  row: asking touches nothing, and `cancho authority` shows the same report with or without the question.\n");
    console.write_all(io, "* `true` is not \"it exists\" or \"it is allowed to run\": `/opt/x/missing` is covered and `exec_spawn` answers\n");
    console.write_all(io, "  `Spawned::Failed(ENOENT)`. The check is on the text of the path (no symlinks are followed, nothing is\n");
    console.write_all(io, "  normalised), and `true..x` is outside because the rule is two dots in a row, not a path component.\n");
    return 0;
}

fn part_9[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "* Do not write your own `starts_with` over the bound. It will agree with the runtime until the first `/opt/xevil`,\n");
    console.write_all(io, "  `a/../b` or 4096-byte path. `docs/processes.md` §4.13 has the rule.\n");
    console.write_all(io, "\n");
    console.write_all(io, "### 3.7 A directory given at deployment: `Dir`, and `exec_spawn_under`\n");
    console.write_all(io, "\n");
    console.write_all(io, "`narrow` takes a literal, so a directory chosen when the program is installed cannot be in a capability's type, and a function over `Fs(\"/x\")` fixes `/x`. What takes its place is a handle:\n");
    console.write_all(io, "\n");
    console.write_all(io, "* **Files.** Open the directory once, `open_dir(fs, arg(g, 1))`, and write the library over `&Dir` (`std.dirs.open_file`, `dir_open_new`, `dir_rename`, ...). It is generic in the directory, its row is `dir_read`/`dir_write` with no\n");
    console.write_all(io, "  path, and no link is followed. The opener's report still says `fs_read(\"\")`: the path is not known to the program.\n");
    console.write_all(io, "* **Programs** (edition 9). `exec_spawn_under(exec, dir, \"worker.sh\", args, env, stdin, stdout, stderr)` starts the program the name names *in that directory*, which is also the child's working directory. It needs the `Exec` that\n");
    console.write_all(io, "  bounds nothing (a narrowed one is `capability-misused`: a run-time directory cannot be shown to lie under a literal), and its row is `exec_under`, so the report says \"programs of a directory I was given\" and not `exec(\"\")`. The name\n");
    console.write_all(io, "  is relative and has no `..` (`a/b` is fine); an empty one, a rooted one, `..` or 4096 bytes **trap**, so a supervisor asks first: `len(name) > 0 && name[0] != '/' && exec_covers(exec, name)`.\n");
    console.write_all(io, "* Neither narrows a *prefix the type can show*, and the kernel follows a link inside the directory (`docs/processes.md` §4.14).\n");
    console.write_all(io, "\n");
    console.write_all(io, "## 4. A reference may not outlive its region\n");
    console.write_all(io, "\n");
    console.write_all(io, "11 fixtures. A region is an arena, a `borrow` block, or a caller's\n");
    console.write_all(io, "region parameter, and nothing that points into one may leave it:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE reference-escapes-region\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn leak() -> [] &static [byte] {\n");
    console.write_all(io, "    region a {\n");
    console.write_all(io, "        let bytes = alloc_slice[a](4, byte_of(65));\n");
    console.write_all(io, "        return bytes;\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(io); release(ffi); release(fs); release(heap); release(args);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "Take the region as a parameter instead — `fn f[&r](…) -> [] &r [byte]`\n");
    console.write_all(io, "— so the caller decides how long it lives.\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    return 0;
}

fn part_10[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "\n");
    console.write_all(io, "## 5. `res` and `val`, and what a container may hold\n");
    console.write_all(io, "\n");
    console.write_all(io, "An arena and a boxed slice hold `val` data **only**: the fill is copied\n");
    console.write_all(io, "into every element, and freeing the run is one `free` that runs nothing,\n");
    console.write_all(io, "so a linear obligation put inside would be dropped rather than\n");
    console.write_all(io, "discharged. 11 fixtures.\n");
    console.write_all(io, "\n");
    console.write_all(io, "`std.vec` is `Vec[T: val]`, honestly. **`std.list` is the collection\n");
    console.write_all(io, "that holds resources**, and the difference is the *shape* rather than\n");
    console.write_all(io, "the generics — `docs/collections.md`.\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "## 6. Five things that cost this repository a compile each\n");
    console.write_all(io, "\n");
    console.write_all(io, "Not rules so much as facts. Each was found by writing a program, and\n");
    console.write_all(io, "each is a checked block below the table — **because the table itself was\n");
    console.write_all(io, "wrong once.**\n");
    console.write_all(io, "\n");
    console.write_all(io, "> **Corrected (#63).** This section shipped with a sixth row saying\n");
    console.write_all(io, "> *\"there is no unary minus; write `0 - x`.\"* There is one: `UnOp::Neg`\n");
    console.write_all(io, "> is in the AST, `-x` parses, and it works on `int` and `float` alike —\n");
    console.write_all(io, "> `examples/newton.cho` had been using it since before that row was\n");
    console.write_all(io, "> written. The claim came from a golden-hash fixture that used `0 - a`,\n");
    console.write_all(io, "> and reading a fixture is not reading the language.\n");
    console.write_all(io, ">\n");
    console.write_all(io, "> The checked code blocks in this document are run by the suite. This\n");
    console.write_all(io, "> table was not, which is exactly why the wrong thing survived in it. It\n");
    console.write_all(io, "> is now.\n");
    console.write_all(io, "\n");
    console.write_all(io, "| | |\n");
    console.write_all(io, "|---|---|\n");
    console.write_all(io, "| **An arena is one 64 KiB chunk (65,536 bytes: 8,192 `int`s or 65,536 `byte`s in all), and exhaustion traps** | Not an error — SIGILL, with a line on stderr naming the cause; a constant size past the chunk is refused at `check` (`region-chunk-exceeded`, `docs/region-limit.md`). **Big data goes on the heap, in a `box_slice`.** `examples/cut/` sized a line buffer to what fit beside its bitmap, and `line-reading.md` §2 is what that cost: a longer line was silently truncated and the program answered the wrong field. **Use `std.buffer` on the heap when the size is not known** |\n");
    console.write_all(io, "| **`alloc_slice` already yields a reference** | A slice *is* a reference. `borrow mut` on one is a reference to a reference, and the refusal says `expected [byte], found &!a [byte]` |\n");
    console.write_all(io, "| **A struct field cannot be `[T]`** | *\"`[T]` has no size of its own.\"* Use a reference, or keep the slice beside the struct rather than in it |\n");
    console.write_all(io, "| **Six escapes, and no `\\x` or `\\u`** | `\\n \\r \\t \\\\ \\\" \\0`. A source file is already UTF-8, so `\"café 日 😀\"` needs none — `docs/strings.md` §8 |\n");
    console.write_all(io, "| **A character is written as one: `'a'` is 97** | A third spelling of an integer, not a type — so `'0' + n % 10`, and `byte_of('\\n')` where a `byte` is wanted. Same six escapes with `\\'` for `\\\"`, and non-ASCII is refused — `docs/character-literals.md` |\n");
    console.write_all(io, "| **`len` is a builtin and may not be redeclared** | Nor may any other prelude name. `std.buffer` calls its length `size` for this reason |\n");
    console.write_all(io, "\n");
    return 0;
}

fn part_11[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "Each of those, in a program the suite compiles:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "fn facts(x: float) -> [] float {\n");
    console.write_all(io, "    // Unary minus exists, on `int` and `float` alike -- see the\n");
    console.write_all(io, "    // correction above.\n");
    console.write_all(io, "    let negated = -x;\n");
    console.write_all(io, "    // `sqrt` is a builtin and needs no capability: it is one\n");
    console.write_all(io, "    // instruction, so it reaches no library, and its row is `[]`\n");
    console.write_all(io, "    // (`docs/float-math.md` §3).\n");
    console.write_all(io, "    return negated + sqrt(4.0);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(io); release(ffi); release(fs); release(args);\n");
    console.write_all(io, "\n");
    console.write_all(io, "    // Six escapes and no `\\x`; a source file is already UTF-8, so a\n");
    console.write_all(io, "    // literal says what it means rather than spelling it out.\n");
    console.write_all(io, "    let text = \"café 日 😀\";\n");
    console.write_all(io, "    var size = len(text);\n");
    console.write_all(io, "\n");
    console.write_all(io, "    // `alloc_slice` already yields a reference: no `borrow mut`.\n");
    console.write_all(io, "    region a {\n");
    console.write_all(io, "        let room = alloc_slice[a](16, byte_of(0));\n");
    console.write_all(io, "        size = size + len(room);\n");
    console.write_all(io, "        // A character literal is an `int`, so it adds to one directly and\n");
    console.write_all(io, "        // needs `byte_of` to become a byte -- the same conversion a\n");
    console.write_all(io, "        // number needed, with an argument that can be read.\n");
    console.write_all(io, "        room[0] = byte_of('0' + size % 10);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap);\n");
    console.write_all(io, "\n");
    console.write_all(io, "    if facts(2.0) < 0.0 {\n");
    console.write_all(io, "        return size;\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    return 0;
}

fn part_12[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE unsized-type\n");
    console.write_all(io, "\n");
    console.write_all(io, "// A struct field cannot be `[T]`: it has no size of its own.\n");
    console.write_all(io, "struct Holder { bytes: [byte] }\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(io); release(ffi); release(fs); release(heap); release(args);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "## 7. Use the library\n");
    console.write_all(io, "\n");
    console.write_all(io, "`std.bytes`, `std.io`, `std.math`, `std.buffer`, `std.option`,\n");
    console.write_all(io, "`std.result`, `std.list`, `std.vec`, `std.fmt`, `std.fmt32` (`f32` text,\n");
    console.write_all(io, "edition 6), `std.bignum`, `std.utf8`, `std.flags`, `std.crypto`, `std.ed25519`, `std.json`,\n");
    console.write_all(io, "`std.map`, `std.http`, `std.route`, `std.test`. Pass `--std` and write the `import` — there is no prelude.\n");
    console.write_all(io, "\n");
    console.write_all(io, "`std.json` parses into a **tape** you provide (`docs/json.md`) rather than\n");
    console.write_all(io, "building a tree, and writes through a `Writer` you move from call to\n");
    console.write_all(io, "call, like a `Buffer`:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "import std.buffer;\n");
    console.write_all(io, "import std.json;\n");
    console.write_all(io, "\n");
    console.write_all(io, "// Read `age` from a request body; answer `{\"next_age\":N}`, or `{\"error\":...}`.\n");
    console.write_all(io, "fn reply[&h, &s](heap: &!h Heap, body: &s [byte]) -> [heap] buffer.Buffer {\n");
    console.write_all(io, "    var w = json.writer(heap, 64);\n");
    console.write_all(io, "    region a {\n");
    console.write_all(io, "        let tape = alloc_slice[a](json.tape_len(body), 0);\n");
    console.write_all(io, "        let nodes = json.parse(body, tape);\n");
    console.write_all(io, "        w = json.begin_object(heap, w);\n");
    console.write_all(io, "        if nodes < 0 {\n");
    console.write_all(io, "            w = json.put_key(heap, w, \"error\");\n");
    console.write_all(io, "            w = json.put_string(heap, w, json.error_message(json.error_code(nodes)));\n");
    return 0;
}

fn part_13[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "        } else {\n");
    console.write_all(io, "            w = json.put_key(heap, w, \"next_age\");\n");
    console.write_all(io, "            w = json.put_int(heap, w, json.to_int(body, tape, json.get(body, tape, 0, \"age\")) + 1);\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "        w = json.end_object(heap, w);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return json.finish(w);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io);\n");
    console.write_all(io, "    borrow mut heap as &!h in {\n");
    console.write_all(io, "        let ok = reply(h, \"{\\\"age\\\": 41}\");\n");
    console.write_all(io, "        let bad = reply(h, \"{\\\"age\\\": }\");\n");
    console.write_all(io, "        buffer.drop(h, ok);\n");
    console.write_all(io, "        buffer.drop(h, bad);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "A parse error is a value (`nodes < 0`), and a writer misused -- a key\n");
    console.write_all(io, "outside an object, a value with no key -- is a trap, not bad JSON.\n");
    console.write_all(io, "\n");
    console.write_all(io, "`std.http` parses one request head into an integer table you provide and\n");
    console.write_all(io, "`std.route` maps a method and path to an id you chose (`docs/http.md`);\n");
    console.write_all(io, "you `match` on the id, so there is no handler registry:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "import std.buffer;\n");
    console.write_all(io, "import std.http;\n");
    console.write_all(io, "import std.route;\n");
    console.write_all(io, "\n");
    console.write_all(io, "// One request in, one response out: 200 with the `:id` segment, 404, 405 or 400.\n");
    console.write_all(io, "fn handle[&h, &r, &q](heap: &!h Heap, router: &r route.Router, request: &q [byte]) -> [heap] buffer.Buffer {\n");
    console.write_all(io, "    let table = box_slice(heap, http.slots(32), 0);\n");
    console.write_all(io, "    let params = box_slice(heap, 2 * route.most_params(router), 0);\n");
    console.write_all(io, "    var out = buffer.empty(heap, 256);\n");
    return 0;
}

fn part_14[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    borrow mut table as &!tw in {\n");
    console.write_all(io, "        borrow mut params as &!pw in {\n");
    console.write_all(io, "            let t = contents(tw);\n");
    console.write_all(io, "            let p = contents(pw);\n");
    console.write_all(io, "            let n = http.parse(request, t);\n");
    console.write_all(io, "            if n < 0 {\n");
    console.write_all(io, "                out = http.respond_head(heap, out, 400, \"text/plain\", 0, false);\n");
    console.write_all(io, "            } else {\n");
    console.write_all(io, "                let path = http.path(request, t);\n");
    console.write_all(io, "                let id = route.find(router, http.method(request, t), path, p);\n");
    console.write_all(io, "                if id == 1 {\n");
    console.write_all(io, "                    let who = path[p[0]..p[1]];\n");
    console.write_all(io, "                    out = http.respond_head(heap, out, 200, \"text/plain\", len(who), http.keeps_alive(t));\n");
    console.write_all(io, "                    out = buffer.append(heap, out, who);\n");
    console.write_all(io, "                } else if id == 0 - 2 {\n");
    console.write_all(io, "                    out = http.respond_head(heap, out, 405, \"text/plain\", 0, false);\n");
    console.write_all(io, "                } else {\n");
    console.write_all(io, "                    out = http.respond_head(heap, out, 404, \"text/plain\", 0, false);\n");
    console.write_all(io, "                }\n");
    console.write_all(io, "            }\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    unbox_slice(heap, params);\n");
    console.write_all(io, "    unbox_slice(heap, table);\n");
    console.write_all(io, "    return out;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io);\n");
    console.write_all(io, "    borrow mut heap as &!h in {\n");
    console.write_all(io, "        var router = route.empty(h);\n");
    console.write_all(io, "        router = route.add(h, router, \"GET\", \"/users/:id\", 1);\n");
    console.write_all(io, "        borrow router as &r in {\n");
    console.write_all(io, "            let ok = handle(h, r, \"GET /users/42 HTTP/1.1\\r\\nHost: x\\r\\n\\r\\n\");\n");
    console.write_all(io, "            let wrong = handle(h, r, \"DELETE /users/42 HTTP/1.1\\r\\nHost: x\\r\\n\\r\\n\");\n");
    console.write_all(io, "            buffer.drop(h, ok);\n");
    console.write_all(io, "            buffer.drop(h, wrong);\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "        route.drop(h, router);\n");
    return 0;
}

fn part_15[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "An incomplete head is a value too (`http.is_incomplete`): read more and call\n");
    console.write_all(io, "`parse` again. A request that is ambiguous about where its body ends --\n");
    console.write_all(io, "obsolete line folding, two different `Content-Length`s, a `Transfer-Encoding`\n");
    console.write_all(io, "beside a length -- is refused, not guessed at.\n");
    console.write_all(io, "\n");
    console.write_all(io, "**A function earns its way into `std` by a program asking for it**, and\n");
    console.write_all(io, "that is how most of these arrived — `std.crypto` is named as the one\n");
    console.write_all(io, "exception in `docs/crypto.md`'s own header. If you need something that\n");
    console.write_all(io, "is not there, write it in your program first; it moves into the library\n");
    console.write_all(io, "when a\n");
    console.write_all(io, "*second* program needs it.\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "### 7.1 `Option`, `Result`, loops and text: what a program that returns an error needs\n");
    console.write_all(io, "\n");
    console.write_all(io, "Four facts a model gets wrong when it brings habits from another language.\n");
    console.write_all(io, "Each is a checked block, so none of this can go stale.\n");
    console.write_all(io, "\n");
    console.write_all(io, "**`Option` and `Result` are enums you import, and you build a value with\n");
    console.write_all(io, "its variant, qualified by the module.** There are no `ok()`, `err()` or\n");
    console.write_all(io, "`some()` functions. The type is written with the module too:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "import std.option;\n");
    console.write_all(io, "import std.result;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn halve(n: int) -> [] result.Result[int, &static [byte]] {\n");
    console.write_all(io, "    if n < 0 {\n");
    console.write_all(io, "        return result.Result::Err(\"negative\");\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return result.Result::Ok(n / 2);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    return 0;
}

fn part_16[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "fn first_over(a: int, b: int, limit: int) -> [] option.Option[int] {\n");
    console.write_all(io, "    if a > limit {\n");
    console.write_all(io, "        return option.Option::Some(a);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    if b > limit {\n");
    console.write_all(io, "        return option.Option::Some(b);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return option.Option::None;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(heap);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "You take a value apart with `match`, and **every arm returns or assigns**:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "import std.option;\n");
    console.write_all(io, "import std.result;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn halve(n: int) -> [] result.Result[int, &static [byte]] {\n");
    console.write_all(io, "    if n < 0 {\n");
    console.write_all(io, "        return result.Result::Err(\"negative\");\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return result.Result::Ok(n / 2);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn halved_or_zero(n: int) -> [] int {\n");
    console.write_all(io, "    match halve(n) {\n");
    console.write_all(io, "        result.Result::Ok(v) => { return v; }\n");
    console.write_all(io, "        result.Result::Err(_) => { return 0; }\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(heap);\n");
    return 0;
}

fn part_17[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    return halved_or_zero(10) - 5;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "The helper-function spelling is refused, with the rule that says the name\n");
    console.write_all(io, "is not a function:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE not-a-function\n");
    console.write_all(io, "import std.result;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn halve(n: int) -> [] result.Result[int, &static [byte]] {\n");
    console.write_all(io, "    return result.ok(n / 2);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(heap);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "**There is no `break` and no `continue`.** Put the stop in the loop's\n");
    console.write_all(io, "condition, with a flag:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "fn index_of[&r](s: &r [byte], c: int) -> [] int {\n");
    console.write_all(io, "    var i = 0;\n");
    console.write_all(io, "    var found = 0 - 1;\n");
    console.write_all(io, "    while i < len(s) && found < 0 {\n");
    console.write_all(io, "        if int_of(s[i]) == c {\n");
    console.write_all(io, "            found = i;\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "        i = i + 1;\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return found;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    return 0;
}

fn part_18[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(heap);\n");
    console.write_all(io, "    return index_of(\"abc\", 98) - 1;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE unknown-name\n");
    console.write_all(io, "fn first_space[&r](s: &r [byte]) -> [] int {\n");
    console.write_all(io, "    var i = 0;\n");
    console.write_all(io, "    while i < len(s) {\n");
    console.write_all(io, "        if int_of(s[i]) == 32 {\n");
    console.write_all(io, "            break;\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "        i = i + 1;\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return i;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(heap);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "**There is no string type: text is bytes, and a `byte` is not an `int`.**\n");
    console.write_all(io, "`&r [byte]` is a string you read (`len(s)`, `s[i]`); a `Buffer` is text you\n");
    console.write_all(io, "build, and it is a resource, so you return it or drop it. Compare an\n");
    console.write_all(io, "element with `int_of`, and build with `append`, `push` and `push_nat`:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "import std.buffer;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn is_digit(c: int) -> [] bool {\n");
    console.write_all(io, "    return c >= 48 && c <= 57;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn digits_then_unit[&h, &r](heap: &!h Heap, s: &r [byte]) -> [heap] buffer.Buffer {\n");
    console.write_all(io, "    var out = buffer.empty(heap, 16);\n");
    console.write_all(io, "    var i = 0;\n");
    return 0;
}

fn part_19[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    var n = 0;\n");
    console.write_all(io, "    while i < len(s) && is_digit(int_of(s[i])) {\n");
    console.write_all(io, "        n = n * 10 + (int_of(s[i]) - 48);\n");
    console.write_all(io, "        i = i + 1;\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    out = buffer.append(heap, out, \"n=\");\n");
    console.write_all(io, "    out = buffer.push_nat(heap, out, n);\n");
    console.write_all(io, "    out = buffer.push(heap, out, byte_of(10));\n");
    console.write_all(io, "    return out;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io);\n");
    console.write_all(io, "    var shown = 0;\n");
    console.write_all(io, "    borrow mut heap as &!h in {\n");
    console.write_all(io, "        let text = digits_then_unit(h, \"42s\");\n");
    console.write_all(io, "        // Read it in a borrow that ends before the drop.\n");
    console.write_all(io, "        borrow text as &t in {\n");
    console.write_all(io, "            shown = buffer.size(t);\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "        buffer.drop(h, text);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap);\n");
    console.write_all(io, "    return shown - 5;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "A byte compared with an integer literal is the refusal a model meets first:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE type-mismatch\n");
    console.write_all(io, "fn is_zero[&r](s: &r [byte]) -> [] bool {\n");
    console.write_all(io, "    return s[0] == 48;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(heap);\n");
    console.write_all(io, "    return 0;\n");
    return 0;
}

fn part_20[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "The second refusal is the one that repeats: a function wants text to read\n");
    console.write_all(io, "(`&r [byte]`) and you hold a `Buffer`. A `Buffer` is not a slice, so\n");
    console.write_all(io, "passing it is `expected [byte], found Buffer`, and writing it again the\n");
    console.write_all(io, "same way is refused again. Borrow the buffer, take its contents with\n");
    console.write_all(io, "`buffer.bytes`, and pass that:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE type-mismatch\n");
    console.write_all(io, "import std.buffer;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn first[&r](s: &r [byte]) -> [] int {\n");
    console.write_all(io, "    return int_of(s[0]);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io);\n");
    console.write_all(io, "    var got = 0;\n");
    console.write_all(io, "    borrow mut heap as &!h in {\n");
    console.write_all(io, "        var b = buffer.empty(h, 4);\n");
    console.write_all(io, "        b = buffer.push(h, b, byte_of(7));\n");
    console.write_all(io, "        got = first(b);\n");
    console.write_all(io, "        buffer.drop(h, b);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap);\n");
    console.write_all(io, "    return got;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "import std.buffer;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn first[&r](s: &r [byte]) -> [] int {\n");
    console.write_all(io, "    return int_of(s[0]);\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    return 0;
}

fn part_21[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    let Split { io, ffi, fs, heap, args } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io);\n");
    console.write_all(io, "    var got = 0;\n");
    console.write_all(io, "    borrow mut heap as &!h in {\n");
    console.write_all(io, "        var b = buffer.empty(h, 4);\n");
    console.write_all(io, "        b = buffer.push(h, b, byte_of(7));\n");
    console.write_all(io, "        borrow b as &t in {\n");
    console.write_all(io, "            got = first(buffer.bytes(t));\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "        buffer.drop(h, b);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap);\n");
    console.write_all(io, "    return got - 7;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "### 7.2 Lists and owned bytes (edition 5 or later)\n");
    console.write_all(io, "\n");
    console.write_all(io, "A collection of strings is a `std.list` of owned byte boxes. Four facts, each\n");
    console.write_all(io, "a checked block. The examples say `edition 7;`, whose `Split` has nine fields;\n");
    console.write_all(io, "`copy_into` needs edition 5 or later, and a file that does not say so does not\n");
    console.write_all(io, "see the name.\n");
    console.write_all(io, "\n");
    console.write_all(io, "**An owned string is a `Box` of bytes.** Make one with `box_slice`, fill it\n");
    console.write_all(io, "through a unique borrow with `copy_into`, read it through a borrow with\n");
    console.write_all(io, "`contents`, and free it with `unbox_slice`:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "edition 7;\n");
    console.write_all(io, "fn copy_of[&h, &r](heap: &!h Heap, s: &r [byte]) -> [heap] Box[[byte]] {\n");
    console.write_all(io, "    let b = box_slice(heap, len(s), byte_of(0));\n");
    console.write_all(io, "    borrow mut b as &!w in {\n");
    console.write_all(io, "        copy_into(contents(w), s);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return b;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    return 0;
}

fn part_22[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(net); release(clock); release(signals); release(exec);\n");
    console.write_all(io, "    var n = 0;\n");
    console.write_all(io, "    borrow mut heap as &!h in {\n");
    console.write_all(io, "        let b = copy_of(h, \"abc\");\n");
    console.write_all(io, "        borrow b as &r in {\n");
    console.write_all(io, "            n = len(contents(r));\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "        unbox_slice(h, b);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap);\n");
    console.write_all(io, "    return n - 3;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "**A list is `list.List::Empty` or `list.List::Cons(head, rest)`, where `rest`\n");
    console.write_all(io, "is a `Box` of the rest.** `list.push` adds to the **front**; `list.length`\n");
    console.write_all(io, "counts; there is no `list.empty()`, `list.nil()` or `list.new()`, and no\n");
    console.write_all(io, "`Nil` variant. You read a list through a reference with `match`, stepping to\n");
    console.write_all(io, "the rest with `contents(rest)`, and you free it with a loop you write\n");
    console.write_all(io, "(`unbox(heap, rest)`), because only the owner of an element knows how to end\n");
    console.write_all(io, "one:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho\n");
    console.write_all(io, "edition 7;\n");
    console.write_all(io, "import std.list;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn copy_of[&h, &r](heap: &!h Heap, s: &r [byte]) -> [heap] Box[[byte]] {\n");
    console.write_all(io, "    let b = box_slice(heap, len(s), byte_of(0));\n");
    console.write_all(io, "    borrow mut b as &!w in {\n");
    console.write_all(io, "        copy_into(contents(w), s);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    return b;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn free_all[&h](heap: &!h Heap, fields: list.List[Box[Box[[byte]]]]) -> [heap] int {\n");
    console.write_all(io, "    match fields {\n");
    console.write_all(io, "        list.List::Empty => { return 0; }\n");
    console.write_all(io, "        list.List::Cons(field, rest) => {\n");
    console.write_all(io, "            unbox_slice(heap, unbox(heap, field));\n");
    return 0;
}

fn part_23[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "            return 1 + free_all(heap, unbox(heap, rest));\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn total_len[&l](fields: &l list.List[Box[Box[[byte]]]]) -> [] int {\n");
    console.write_all(io, "    match fields {\n");
    console.write_all(io, "        list.List::Empty => { return 0; }\n");
    console.write_all(io, "        list.List::Cons(field, rest) => {\n");
    console.write_all(io, "            return len(contents(contents(field))) + total_len(contents(rest));\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(net); release(clock); release(signals); release(exec);\n");
    console.write_all(io, "    var n = 0;\n");
    console.write_all(io, "    borrow mut heap as &!h in {\n");
    console.write_all(io, "        var fields: list.List[Box[Box[[byte]]]] = list.List::Empty;\n");
    console.write_all(io, "        fields = list.push(h, fields, box(h, copy_of(h, \"bc\")));\n");
    console.write_all(io, "        fields = list.push(h, fields, box(h, copy_of(h, \"a\")));\n");
    console.write_all(io, "        borrow fields as &r in {\n");
    console.write_all(io, "            n = total_len(r) + list.length(r);\n");
    console.write_all(io, "        }\n");
    console.write_all(io, "        free_all(h, fields);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap);\n");
    console.write_all(io, "    return n - 5;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "**A list of strings is `List[Box[Box[[byte]]]]`, one `Box` more than it looks\n");
    console.write_all(io, "like it needs.** A plain `List[Box[[byte]]]` type-checks and then fails to\n");
    console.write_all(io, "compile once it is walked through a reference (the compiler cannot bind a\n");
    console.write_all(io, "payload wider than one leaf: alpibrusl/cancho#461), so each field is a `Box`\n");
    console.write_all(io, "holding the `Box` of bytes, as in the block above (`box(h, copy_of(h, ..))`\n");
    console.write_all(io, "to wrap, `contents(contents(field))` to read).\n");
    console.write_all(io, "\n");
    console.write_all(io, "The names a model brings from other languages are refused, each with the rule\n");
    return 0;
}

fn part_24[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "that tells it so:\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE not-a-function\n");
    console.write_all(io, "edition 7;\n");
    console.write_all(io, "import std.list;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(net); release(clock); release(signals); release(exec);\n");
    console.write_all(io, "    var n = 0;\n");
    console.write_all(io, "    borrow mut heap as &!h in {\n");
    console.write_all(io, "        var fields: list.List[Box[Box[[byte]]]] = list.nil();\n");
    console.write_all(io, "        n = list.length(fields);\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "    release(heap);\n");
    console.write_all(io, "    return n;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "```cancho-refused\n");
    console.write_all(io, "//~ RULE unknown-name\n");
    console.write_all(io, "edition 7;\n");
    console.write_all(io, "import std.list;\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn count[&l](fields: &l list.List[int]) -> [] int {\n");
    console.write_all(io, "    match fields {\n");
    console.write_all(io, "        list.List::Nil => { return 0; }\n");
    console.write_all(io, "        list.List::Cons(_, rest) => { return 1 + count(contents(rest)); }\n");
    console.write_all(io, "    }\n");
    console.write_all(io, "}\n");
    console.write_all(io, "\n");
    console.write_all(io, "fn main(world: World) -> [] int {\n");
    console.write_all(io, "    let Split { io, ffi, fs, heap, args, net, clock, signals, exec } = split(world);\n");
    console.write_all(io, "    release(ffi); release(fs); release(args); release(io); release(net); release(clock); release(signals); release(exec); release(heap);\n");
    console.write_all(io, "    return 0;\n");
    console.write_all(io, "}\n");
    console.write_all(io, "```\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    return 0;
}

fn part_25[&i](io: &!i Io) -> [io_write] int {
    console.write_all(io, "\n");
    console.write_all(io, "## 8. What this language does not have\n");
    console.write_all(io, "\n");
    console.write_all(io, "Saying these plainly saves a cycle: no borrow checker (regions instead),\n");
    console.write_all(io, "no traits, no closures or function values, no `break` or `continue`, no string type (§7.1), no `comptime` beyond\n");
    console.write_all(io, "`static` and constant folding, no async, no generics over effects, no\n");
    console.write_all(io, "warnings — a diagnostic is a refusal.\n");
    console.write_all(io, "\n");
    console.write_all(io, "`int` is 64-bit and **traps** on overflow rather than wrapping;\n");
    console.write_all(io, "`wrapping_add` and its two siblings are how you ask for wraparound when\n");
    console.write_all(io, "that is the intent.\n");
    console.write_all(io, "\n");
    console.write_all(io, "---\n");
    console.write_all(io, "\n");
    console.write_all(io, "## 9. Where to read more\n");
    console.write_all(io, "\n");
    console.write_all(io, "| | |\n");
    console.write_all(io, "|---|---|\n");
    console.write_all(io, "| The rules of the type system | `docs/linearity-and-effects.md` |\n");
    console.write_all(io, "| What a refusal means, as data | `docs/agent-errors.md` |\n");
    console.write_all(io, "| The CLI as data, not a doc that can drift | `docs/agent-cli.md` |\n");
    console.write_all(io, "| What a program can reach, and how it is reported | `docs/reach.md`, `docs/authority.md` |\n");
    console.write_all(io, "| Which collection holds a resource | `docs/collections.md` |\n");
    console.write_all(io, "| Everything else | `docs/README.md` indexes all 42, with a one-line status each |\n");
    return 0;
}

