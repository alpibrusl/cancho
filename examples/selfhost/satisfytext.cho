edition 7;
module selfhost.satisfytext;

// satisfytext.cho -- the pieces of `cancho satisfy` that are text and nothing else (`docs/cli-in-cancho.md` section 18): the records of a stream of files, the entries of
// the listing of a program's functions (`identity.listing`), and the syntactic check that a contract calls what a candidate declares (`satisfy_cli.rs`, `calls_any`).

import std.buffer;
import selfhost.lexcore as lc;

// The `k`th file of a stream (`FILE n`, a newline, and `n` bytes, for each) with its header, or nothing if there is none.
pub fn record[&r](raw: &r [byte], k: int) -> [] &r [byte] {
    var at = 0;
    var seen = 0;
    while at < len(raw) {
        var p = at;
        while p < len(raw) && lc.at(raw, p) != '\n' {
            p = p + 1;
        }
        var size = 0;
        var q = at + 5;
        while q < p {
            size = size * 10 + lc.at(raw, q) - '0';
            q = q + 1;
        }
        let end = p + 1 + size;
        if seen == k {
            if end > len(raw) {
                return raw[at..len(raw)];
            }
            return raw[at..end];
        }
        seen = seen + 1;
        at = end;
    }
    return raw[len(raw)..len(raw)];
}

// The end of the NUL- or newline-ended field that starts at `at`.
fn field_end[&l](list: &l [byte], at: int) -> [] int {
    var p = at;
    while p < len(list) && lc.at(list, p) != 0 && lc.at(list, p) != '\n' {
        p = p + 1;
    }
    return p;
}

// The module of the entry that starts at `at` of a listing, its name, its identity, and where the next entry is, as the four ends: the module is `at` to `m`, the name
// `m + 1` to `n`, the identity `n + 1` to `h`, and the next entry starts at `h + 1`. Answers `m`; the others are `field_end` of the one before.
pub fn module_end[&l](list: &l [byte], at: int) -> [] int {
    return field_end(list, at);
}

pub fn name_end[&l](list: &l [byte], at: int) -> [] int {
    return field_end(list, module_end(list, at) + 1);
}

pub fn identity_end[&l](list: &l [byte], at: int) -> [] int {
    return field_end(list, name_end(list, at) + 1);
}

// Does the listing `list` have an entry for the function `name` of the module `home`?
pub fn has_entry[&l, &a, &b](list: &l [byte], home: &a [byte], name: &b [byte]) -> [] bool {
    var at = 0;
    while at < len(list) {
        let m = module_end(list, at);
        let n = name_end(list, at);
        let h = identity_end(list, at);
        if lc.spells(list, at, m, home) && m - at == len(home) && lc.spells(list, m + 1, n, name) && n - m - 1 == len(name) {
            return true;
        }
        at = h + 1;
    }
    return false;
}

fn is_ident(c: int) -> [] bool {
    return c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_';
}

fn is_space(c: int) -> [] bool {
    return c == ' ' || c == 9 || c == 10 || c == 12 || c == 13;
}

// `text` with its comments and its string literals set aside (a comment goes to the end of its line, which is kept; a literal becomes one space).
fn code_of[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] buffer.Buffer {
    var code = buffer.empty(heap, len(text));
    var i = 0;
    while i < len(text) {
        let c = lc.at(text, i);
        if c == '/' && lc.at(text, i + 1) == '/' {
            i = i + 2;
            while i < len(text) && lc.at(text, i) != 10 {
                i = i + 1;
            }
            if i < len(text) {
                code = buffer.push(heap, code, byte_of(10));
                i = i + 1;
            }
        } else if c == 34 {
            i = i + 1;
            var closed = false;
            while i < len(text) && !closed {
                if lc.at(text, i) == 92 {
                    i = i + 2;
                } else if lc.at(text, i) == 34 {
                    closed = true;
                    i = i + 1;
                } else {
                    i = i + 1;
                }
            }
            code = buffer.push(heap, code, byte_of(' '));
        } else {
            code = buffer.push(heap, code, text[i]);
            i = i + 1;
        }
    }
    return code;
}

// Does the contract `text` call, as `name(`, one of `names` (each followed by a NUL)? A declaration `fn name(` is not a call.
pub fn calls_any[&h, &t, &n](heap: &!h Heap, text: &t [byte], names: &n [byte]) -> [heap] bool {
    let code = code_of(heap, text);
    var found = false;
    borrow code as &cb in {
        let c = buffer.bytes(cb);
        var previous_at = 0;
        var previous_end = 0;
        var i = 0;
        while i < len(c) && !found {
            if is_ident(lc.at(c, i)) {
                let start = i;
                while i < len(c) && is_ident(lc.at(c, i)) {
                    i = i + 1;
                }
                var j = i;
                while j < len(c) && is_space(lc.at(c, j)) {
                    j = j + 1;
                }
                let after_fn = previous_end - previous_at == 2 && lc.spells(c, previous_at, previous_end, "fn");
                if !after_fn && j < len(c) && lc.at(c, j) == '(' {
                    var k = 0;
                    while k < len(names) && !found {
                        let e = field_end(names, k);
                        if e - k == i - start && lc.spells(c, start, i, names[k..e]) {
                            found = true;
                        }
                        k = e + 1;
                    }
                }
                previous_at = start;
                previous_end = i;
            } else {
                i = i + 1;
            }
        }
    }
    buffer.drop(heap, code);
    return found;
}

// `a` against `b` byte by byte: -1, 0 or 1.
pub fn compare[&a, &b](x: &a [byte], y: &b [byte]) -> [] int {
    var i = 0;
    while i < len(x) && i < len(y) {
        if lc.at(x, i) != lc.at(y, i) {
            if lc.at(x, i) < lc.at(y, i) {
                return 0 - 1;
            }
            return 1;
        }
        i = i + 1;
    }
    if len(x) == len(y) {
        return 0;
    }
    if len(x) < len(y) {
        return 0 - 1;
    }
    return 1;
}

// The functions of the listing that are not tests, each once, in the order of their modules and then their names (as a set of pairs is ordered), by name: each followed by a
// NUL, or, with `joined`, with `, ` between them.
pub fn provided[&h, &l](heap: &!h Heap, list: &l [byte], joined: bool) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 64);
    var last_at = 0 - 1;
    var first = true;
    var more = true;
    while more {
        var best = 0 - 1;
        var at = 0;
        while at < len(list) {
            let m = module_end(list, at);
            let n = name_end(list, at);
            let h = identity_end(list, at);
            var after_last = true;
            if last_at >= 0 {
                let lm = module_end(list, last_at);
                let ln = name_end(list, last_at);
                let by_module = compare(list[at..m], list[last_at..lm]);
                after_last = by_module > 0 || by_module == 0 && compare(list[m + 1..n], list[lm + 1..ln]) > 0;
            }
            if !(n - m - 1 >= 5 && lc.spells(list, m + 1, m + 6, "test_")) && after_last {
                var smaller = best < 0;
                if !smaller {
                    let bm = module_end(list, best);
                    let bn = name_end(list, best);
                    let by_module = compare(list[at..m], list[best..bm]);
                    smaller = by_module < 0 || by_module == 0 && compare(list[m + 1..n], list[bm + 1..bn]) < 0;
                }
                if smaller {
                    best = at;
                }
            }
            at = h + 1;
        }
        if best < 0 {
            more = false;
        } else {
            let m = module_end(list, best);
            let n = name_end(list, best);
            if joined && !first {
                out = buffer.append(heap, out, ", ");
            }
            out = buffer.append(heap, out, list[m + 1..n]);
            if !joined {
                out = buffer.push(heap, out, byte_of(0));
            }
            first = false;
            last_at = best;
        }
    }
    return out;
}
