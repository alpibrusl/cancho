// parser.cho -- the cancho parser, written in cancho: the program.
//
// Stages 2 and 3a of the self-hosting spike (`docs/self-hosting.md` section 6, epic #295).
// Reads a source file on standard input and writes the syntax tree `ast.cho` builds as the
// listing `crates/cancho-syntax/examples/dump_ast.rs` writes from the Rust AST, or the one line
// `ERR rule-tag start end` if the Rust parser would have refused it.
//
//     cancho run examples/selfhost/parser.cho examples/selfhost/driver.cho examples/selfhost/listing.cho \
//         examples/selfhost/pass1.cho examples/selfhost/ast.cho examples/selfhost/kinds.cho \
//         examples/selfhost/lexcore.cho examples/selfhost/tables.cho --std < f.cho

import selfhost.driver;

fn main(world: World) -> [] int {
    return driver.drive(world, 0, false);
}
