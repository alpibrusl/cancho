 %3 = load i32, ptr %i, align 4\n  %idxprom = sext i32 %3 to i64\n  %arrayidx = getelementptr inbounds [30 x [2 x i64]], ptr @ttyrt_rates, i64 0, i64 %idxprom\n  %arrayidx2 = getelementptr inbounds [2 x i64], ptr %arrayidx, i64 0, i64 0\n  %4 = load i64, ptr %arrayidx2, align 8\n  %5 = load i64, ptr %speed.addr, align 8\n  %cmp3 = icmp eq i64 %4, %5\n  br i1 %cmp3, label %if.then, label %if.end\n\nif.then:                                          ; preds = %for.body\n  %6 = load i32, ptr %i, align 4\n  %idxprom5 = sext i32 %6 to i64\n  %arrayidx6 = getelementptr inbounds [30 x [2 x i64]], ptr @ttyrt_rates, i64 0, i64 %idxprom5\n  %arrayidx7 = getelementptr inbounds [2 x i64], ptr %arrayidx6, i64 0, i64 1\n  %7 = load i64, ptr %arrayidx7, align 8\n  store i64 %7, ptr %bits, align 8\n  br label %if.end\n\nif.end:                                           ; preds = %if.then, %for.body\n  br label %for.inc\n\nfor.inc:                                          ; preds = %if.end\n  %8 = load i32, ptr %i, align 4\n  %inc = add nsw i32 %8, 1\n  store i32 %inc, ptr %i, align 4\n  br label %for.cond\n\nfor.end:                                          ; preds = %for.cond\n  %9 = load i64, ptr %bits, align 8\n  %cmp8 = icmp slt i64 %9, 0\n  br i1 %cmp8, label %if.then10, label %if.end11\n\nif.then10:                                        ; preds = %for.end\n  store i64 22, ptr %retval, align 8\n  br label %return\n\nif.end11:                                         ; preds = %for.end\n  store i32 0, ptr %i12, align 4\n  br label %for.cond13\n\nfor.cond13:                                       ; preds = %for.inc19, %if.end11\n  %10 = load i32, ptr %i12, align 4\n  %cmp14 = icmp slt i32 %10, 15\n  br i1 %cmp14, label %for.body16, label %for.end21\n\nfor.body16:                                       ; preds = %for.cond13\n  %11 = load i32, ptr %i12, align 4\n  %idxprom17 = sext i32 %11 to i64\n  %arrayidx18 = getelementptr inbounds [15 x i32], ptr %t, i64 0, i64 %idxprom17\n  store i32 0, ptr %arrayidx18, align 4\n  br label %for.inc19\n\nfor.inc19:                                        ; preds = %for.body16\n  %12 = load i32, ptr %i12, align 4\n  %inc20 = add nsw i32 %12, 1\n  store i32 %inc20, ptr %i12, align 4\n  br label %for.cond13\n\nfor.end21:                                        ; preds = %for.cond13\n  %arraydecay = getelementptr inbounds [15 x i32], ptr %t, i64 0, i64 0\n  store ptr %arraydecay, ptr %b, align 8\n  %13 = load i64, ptr %bits, align 8\n  %or = or i64 %13, 2224\n  %conv22 = trunc i64 %or to i32\n  %14 = load ptr, ptr %b, align 8\n  %add.ptr = getelementptr inbounds i8, ptr %14, i64 8\n  store i32 %conv22, ptr %add.ptr, align 4\n  %15 = load i32, ptr %fd, align 4\n  %arraydecay23 = getelementptr inbounds [15 x i32], ptr %t, i64 0, i64 0\n  %call = call i32 @tcsetattr(i32 %15, i32 0, ptr %arraydecay23)\n  %cmp24 = icmp slt i32 %call, 0\n  br i1 %cmp24, label %if.then26, label %if.end29\n\nif.then26:                                        ; preds = %for.end21\n  %call27 = call ptr @cancho_errno_location()\n  %16 = load i32, ptr %call27, align 4\n  %conv28 = sext i32 %16 to i64\n  store i64 %conv28, ptr %retval, align 8\n  br label %return\n\nif.end29:                                         ; preds = %for.end21\n  store i64 0, ptr %retval, align 8\n  br label %return\n\nreturn:                                           ; preds = %if.end29, %if.then26, %if.then10\n  %17 = load i64, ptr %retval, align 8\n  ret i64 %17\n}\n\ndeclare i32 @tcsetattr(i32, i32, ptr)\n\n; Function Attrs: noinline nounwind\ndefine i64 @cancho_tty_read(ptr %port, ptr %p, i64 %n) {\nentry:\n  %port.addr = alloca ptr, align 8\n  %p.addr = alloca ptr, align 8\n  %n.addr = alloca i64, align 8\n  store ptr %port, ptr %port.addr, align 8\n  store ptr %p, ptr %p.addr, align 8\n  store i64 %n, ptr %n.addr, align 8\n  %0 = load ptr, ptr %port.addr, align 8\n  %1 = load i64, ptr %0, align 8\n  %conv = trunc i64 %1 to i32\n  %2 = load ptr, ptr %p.addr, align 8\n  %3 = load i64, ptr %n.addr, align 8\n  %call = call i64 @read(i32 %conv, ptr %2, i64 %3)\n  ret i64 %call\n}\n\n\n; Function Attrs: noinline nounwind\ndefine i64 @cancho_tty_write(ptr %port, ptr %p, i64 %n) {\nentry:\n  %port.addr = alloca ptr, align 8\n  %p.addr = alloca ptr, align 8\n  %n.addr = alloca i64, align 8\n  store ptr %port, ptr %port.addr, align 8\n  store ptr %p, ptr %p.addr, align 8\n  store i64 %n, ptr %n.addr, align 8\n  %0 = load ptr, ptr %port.addr, align 8\n  %1 = load i64, ptr %0, align 8\n  %conv = trunc i64 %1 to i32\n  %2 = load ptr, ptr %p.addr, align 8\n  %3 = load i64, ptr %n.addr, align 8\n  %call = call i64 @write(i32 %conv, ptr %2, i64 %3)\n  ret i64 %call\n}\n\n\n; Function Attrs: noinline nounwind\ndefine i64 @cancho_tty_flush(ptr %port) {\nentry:\n  %port.addr = alloca ptr, align 8\n  store ptr %port, ptr %port.addr, align 8\n  %0 = load ptr, ptr %port.addr, align 8\n  %1 = load i64, ptr %0, align 8\n  %conv = trunc i64 %1 to i32\n  %call = call i32 @tcflush(i32 %conv, i32 0)\n  %conv1 = sext i32 %call to i64\n  ret i64 %conv1\n}\n\ndeclare i32 @tcflush(i32, i32)\n\n\n\n";
}

// The thread that reaps a released child (`runtime/process.ll`).
pub fn process_text() -> [] &static [byte] {
    return "; process.ll -- what a program that lets a child go (`child_release`, docs/processes.md section 4.11) has: the function a thread runs to\n; reap the child, and the call that starts that thread. The same on every system; the pidfd is closed by `@cancho_child_release`.\n\n; The thread: it waits for that one child (its pid is the argument), never for -1, and ends. It installs no handler and takes no signal\n; of its own, so nothing interrupts its wait.\ndefine ptr @cancho_child_reaper(ptr %pid) {\nentry:\n  %status = alloca i64, align 8\n  %n = ptrtoint ptr %pid to i64\n  %p = trunc i64 %n to i32\n  %r = call i32 @waitpid(i32 %p, ptr %status, i32 0)\n  ret ptr null\n}\n\n; child_release: close the child's pidfd, then give its pid to a detached thread with 64 KiB of stack. 0, or the error number of\n; `pthread_create`, in which case the child still runs and is a zombie when it ends until the program does.\ndefine i64 @cancho_child_let_go(i64 %word) {\nentry:\n  call void @cancho_child_release(i64 %word)\n  %low = trunc i64 %word to i32\n  %pid = zext i32 %low to i64\n  %arg = inttoptr i64 %pid to ptr\n  %attr = alloca [128 x i8], align 16\n  %thread = alloca i64, align 8\n  store i64 0, ptr %thread\n  call i32 @pthread_attr_init(ptr %attr)\n  call i32 @pthread_attr_setstacksize(ptr %attr, i64 65536)\n  %status = call i32 @pthread_create(ptr %thread, ptr %attr, ptr @cancho_child_reaper, ptr %arg)\n  call i32 @pthread_attr_destroy(ptr %attr)\n  %failed = icmp ne i32 %status, 0\n  br i1 %failed, label %done, label %detach\ndetach:\n  %id = load ptr, ptr %thread\n  call i32 @pthread_detach(ptr %id)\n  br label %done\ndone:\n  %answer = sext i32 %status to i64\n  ret i64 %answer\n}\ndeclare i32 @pthread_attr_init(ptr)\ndeclare i32 @pthread_attr_setstacksize(ptr, i64)\ndeclare i32 @pthread_attr_destroy(ptr)\ndeclare i32 @pthread_detach(ptr)\n";
}

// The per-thread stack of region chunks (`cancho-codegen-llvm`'s `region_cache`).
pub fn region_text(darwin: bool) -> [] &static [byte] {
    if darwin {
        return "; region_darwin.ll -- the per-thread stack of region chunks, as `cancho-codegen-llvm` writes it for this system.\n; GENERATED by `crypto/tests.rs`; `UPDATE_SELFHOST_TABLES=1 cargo test -p cancho-codegen-llvm selfhost_region` rewrites it.\ndeclare i32 @pthread_key_create(ptr, ptr)\ndeclare ptr @pthread_getspecific(i64)\ndeclare i32 @pthread_setspecific(i64, ptr)\n@cancho_region_key = internal global i64 0\ndeclare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n\ndefine internal ptr @cancho_region_take() {\nentry:\n  %k1 = load i64, ptr @cancho_region_key\n  %nokey = icmp eq i64 %k1, 0\n  br i1 %nokey, label %fresh, label %lookup\nlookup:\n  %kw = sub i64 %k1, 1\n  %key = add i64 %kw, 0\n  %c = call ptr @pthread_getspecific(i64 %key)\n  %nostack = icmp eq ptr %c, null\n  br i1 %nostack, label %fresh, label %count\ncount:\n  %n = load i64, ptr %c\n  %empty = icmp eq i64 %n, 0\n  br i1 %empty, label %fresh, label %pop\npop:\n  %m = sub i64 %n, 1\n  store i64 %m, ptr %c\n  %at = getelementptr i64, ptr %c, i64 %n\n  %p = load ptr, ptr %at\n  ret ptr %p\nfresh:\n  %q = call ptr @malloc(i64 65536)\n  ret ptr %q\n}\n\ndefine internal void @cancho_region_give(ptr %base, ptr %end) {\nentry:\n  %b = ptrtoint ptr %base to i64\n  %e = ptrtoint ptr %end to i64\n  %used = sub i64 %e, %b\n  call void @llvm.memset.p0.i64(ptr %base, i8 0, i64 %used, i1 false)\n  %k1 = load i64, ptr @cancho_region_key\n  %nokey = icmp eq i64 %k1, 0\n  br i1 %nokey, label %release, label %lookup\nlookup:\n  %kw = sub i64 %k1, 1\n  %key = add i64 %kw, 0\n  %c = call ptr @pthread_getspecific(i64 %key)\n  %nostack = icmp eq ptr %c, null\n  br i1 %nostack, label %make, label %have\nmake:\n  %made = call ptr @malloc(i64 136)\n  %nomem = icmp eq ptr %made, null\n  br i1 %nomem, label %release, label %fresh\nfresh:\n  store i64 0, ptr %made\n  %set = call i32 @pthread_setspecific(i64 %key, ptr %made)\n  %setok = icmp eq i32 %set, 0\n  br i1 %setok, label %push, label %unmade\nunmade:\n  call void @free(ptr %made)\n  br label %release\nhave:\n  br label %push\npush:\n  %s = phi ptr [ %c, %have ], [ %made, %fresh ]\n  %n = load i64, ptr %s\n  %full = icmp sge i64 %n, 16\n  br i1 %full, label %release, label %keep\nkeep:\n  %n1 = add i64 %n, 1\n  %at = getelementptr i64, ptr %s, i64 %n1\n  store ptr %base, ptr %at\n  store i64 %n1, ptr %s\n  ret void\nrelease:\n  call void @free(ptr %base)\n  ret void\n}\n\ndefine internal void @cancho_region_drop(ptr %s) {\nentry:\n  %n = load i64, ptr %s\n  br label %head\nhead:\n  %i = phi i64 [ 1, %entry ], [ %next, %body ]\n  %more = icmp sle i64 %i, %n\n  br i1 %more, label %body, label %done\nbody:\n  %at = getelementptr i64, ptr %s, i64 %i\n  %p = load ptr, ptr %at\n  call void @free(ptr %p)\n  %next = add i64 %i, 1\n  br label %head\ndone:\n  call void @free(ptr %s)\n  ret void\n}\n\ndefine internal void @cancho_region_init() {\nentry:\n  %slot = alloca i64\n  store i64 0, ptr %slot\n  %status = call i32 @pthread_key_create(ptr %slot, ptr @cancho_region_drop)\n  %ok = icmp eq i32 %status, 0\n  br i1 %ok, label %set, label %done\nset:\n  %key = load i64, ptr %slot\n  %plus = add i64 %key, 1\n  store i64 %plus, ptr @cancho_region_key\n  br label %done\ndone:\n  ret void\n}\n\n";
    }
    return "; region_linux.ll -- the per-thread stack of region chunks, as `cancho-codegen-llvm` writes it for this system.\n; GENERATED by `crypto/tests.rs`; `UPDATE_SELFHOST_TABLES=1 cargo test -p cancho-codegen-llvm selfhost_region` rewrites it.\ndeclare i32 @pthread_key_create(ptr, ptr)\ndeclare ptr @pthread_getspecific(i32)\ndeclare i32 @pthread_setspecific(i32, ptr)\n@cancho_region_key = internal global i64 0\ndeclare void @llvm.memset.p0.i64(ptr, i8, i64, i1)\n\ndefine internal ptr @cancho_region_take() {\nentry:\n  %k1 = load i64, ptr @cancho_region_key\n  %nokey = icmp eq i64 %k1, 0\n  br i1 %nokey, label %fresh, label %lookup\nlookup:\n  %kw = sub i64 %k1, 1\n  %key = trunc i64 %kw to i32\n  %c = call ptr @pthread_getspecific(i32 %key)\n  %nostack = icmp eq ptr %c, null\n  br i1 %nostack, label %fresh, label %count\ncount:\n  %n = load i64, ptr %c\n  %empty = icmp eq i64 %n, 0\n  br i1 %empty, label %fresh, label %pop\npop:\n  %m = sub i64 %n, 1\n  store i64 %m, ptr %c\n  %at = getelementptr i64, ptr %c, i64 %n\n  %p = load ptr, ptr %at\n  ret ptr %p\nfresh:\n  %q = call ptr @malloc(i64 65536)\n  ret ptr %q\n}\n\ndefine internal void @cancho_region_give(ptr %base, ptr %end) {\nentry:\n  %b = ptrtoint ptr %base to i64\n  %e = ptrtoint ptr %end to i64\n  %used = sub i64 %e, %b\n  call void @llvm.memset.p0.i64(ptr %base, i8 0, i64 %used, i1 false)\n  %k1 = load i64, ptr @cancho_region_key\n  %nokey = icmp eq i64 %k1, 0\n  br i1 %nokey, label %release, label %lookup\nlookup:\n  %kw = sub i64 %k1, 1\n  %key = trunc i64 %kw to i32\n  %c = call ptr @pthread_getspecific(i32 %key)\n  %nostack = icmp eq ptr %c, null\n  br i1 %nostack, label %make, label %have\nmake:\n  %made = call ptr @malloc(i64 136)\n  %nomem = icmp eq ptr %made, null\n  br i1 %nomem, label %release, label %fresh\nfresh:\n  store i64 0, ptr %made\n  %set = call i32 @pthread_setspecific(i32 %key, ptr %made)\n  %setok = icmp eq i32 %set, 0\n  br i1 %setok, label %push, label %unmade\nunmade:\n  call void @free(ptr %made)\n  br label %release\nhave:\n  br label %push\npush:\n  %s = phi ptr [ %c, %have ], [ %made, %fresh ]\n  %n = load i64, ptr %s\n  %full = icmp sge i64 %n, 16\n  br i1 %full, label %release, label %keep\nkeep:\n  %n1 = add i64 %n, 1\n  %at = getelementptr i64, ptr %s, i64 %n1\n  store ptr %base, ptr %at\n  store i64 %n1, ptr %s\n  ret void\nrelease:\n  call void @free(ptr %base)\n  ret void\n}\n\ndefine internal void @cancho_region_drop(ptr %s) {\nentry:\n  %n = load i64, ptr %s\n  br label %head\nhead:\n  %i = phi i64 [ 1, %entry ], [ %next, %body ]\n  %more = icmp sle i64 %i, %n\n  br i1 %more, label %body, label %done\nbody:\n  %at = getelementptr i64, ptr %s, i64 %i\n  %p = load ptr, ptr %at\n  call void @free(ptr %p)\n  %next = add i64 %i, 1\n  br label %head\ndone:\n  call void @free(ptr %s)\n  ret void\n}\n\ndefine internal void @cancho_region_init() {\nentry:\n  %slot = alloca i64\n  store i64 0, ptr %slot\n  %status = call i32 @pthread_key_create(ptr %slot, ptr @cancho_region_drop)\n  %ok = icmp eq i32 %status, 0\n  br i1 %ok, label %set, label %done\nset:\n  %key = load i64, ptr %slot\n  %plus = add i64 %key, 1\n  store i64 %plus, ptr @cancho_region_key\n  br label %done\ndone:\n  ret void\n}\n\n";
}

// The hardware AES and GHASH functions, written by `cancho-codegen-llvm` for each target: `target` is 1 for
// Darwin on aarch64, 2 for Linux on aarch64, 0 for Linux on x86-64.
pub fn crypto_text(target: int) -> [] &static [byte] {
    if target == 1 {
        return "; crypto_aarch64_darwin.ll -- the hardware AES and GHASH functions, as `cancho-codegen-llvm` writes them for this target.\n; GENERATED by `crypto/tests.rs`; `UPDATE_SELFHOST_TABLES=1 cargo test -p cancho-codegen-llvm selfhost_runtime` rewrites it.\ndeclare i32 @sysctlbyname(ptr, ptr, ptr, ptr, i64)\n@cancho_hw_cache = internal global i8 0\n@cancho_aes_name = private unnamed_addr constant [25 x i8] c\"hw.optional.arm.FEAT_AES\\00\"\n@cancho_pmull_name = private unnamed_addr constant [27 x i8] c\"hw.optional.arm.FEAT_PMULL\\00\"\ndefine internal i8 @cancho_hw_aes_gcm() {\nentry:\n%cached = load atomic i8, ptr @cancho_hw_cache monotonic, align 1\n%known = icmp ne i8 %cached, 0\nbr i1 %known, label %answer, label %ask\nask:\n%aes = alloca i32\n  %pmull = alloca i32\n  %size = alloca i64\n  store i32 0, ptr %aes\n  store i32 0, ptr %pmull\n  store i64 4, ptr %size\n  %s1 = call i32 @sysctlbyname(ptr @cancho_aes_name, ptr %aes, ptr %size, ptr null, i64 0)\n  store i64 4, ptr %size\n  %s2 = call i32 @sysctlbyname(ptr @cancho_pmull_name, ptr %pmull, ptr %size, ptr null, i64 0)\n  %a = load i32, ptr %aes\n  %p = load i32, ptr %pmull\n  %r1 = icmp eq i32 %s1, 0\n  %r2 = icmp eq i32 %s2, 0\n  %h1 = icmp ne i32 %a, 0\n  %h2 = icmp ne i32 %p, 0\n  %b1 = and i1 %r1, %r2\n  %b2 = and i1 %h1, %h2\n  %has = and i1 %b1, %b2\n%fresh = select i1 %has, i8 2, i8 1\nstore atomic i8 %fresh, ptr @cancho_hw_cache monotonic, align 1\nbr label %answer\nanswer:\n%value = phi i8 [ %cached, %entry ], [ %fresh, %ask ]\n%yes = icmp eq i8 %value, 2\n%result = zext i1 %yes to i8\nret i8 %result\n}\ndefine internal <2 x i64> @cancho_aes1(ptr %rk, i64 %rounds, <2 x i64> %b0) alwaysinline \"target-features\"=\"+aes,+neon\" {\nentry:\n  %lim = sub i64 %rounds, 1\n  br label %loop\nloop:\n  %i = phi i64 [ 0, %entry ], [ %i1, %body ]\n  %s0 = phi <2 x i64> [ %b0, %entry ], [ %n0, %body ]\n  %more = icmp ult i64 %i, %lim\n  br i1 %more, label %body, label %end\nbody:\n  %off = shl i64 %i, 4\