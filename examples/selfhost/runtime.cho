// The address of `errno`, which each target keeps under its own name.
pub fn errno_location(darwin: bool) -> [] &static [byte] {
    if darwin {
        return "define ptr @cancho_errno_location() {\nentry:\n  %p = call ptr @__error()\n  ret ptr %p\n}\ndeclare ptr @__error()\n\n";
    }
    return "define ptr @cancho_errno_location() {\nentry:\n  %p = call ptr @__errno_location()\n  ret ptr %p\n}\ndeclare ptr @__errno_location()\n\n";
}
