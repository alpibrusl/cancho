module selfhost.lookup;

// lookup.cho -- names the expressions look up: a variant of an enum, a field given twice, a static or a function of a
// module, the arms of a prelude enum, and which expressions the code is written for.

import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.kinds;
import selfhost.pass1;
import selfhost.builtins;

// The Variant node of the enum `item` called like token `name`, or -1.
pub fn variant_named[&s, &x](st: &!s [int], text: &x [byte], item: int, name: int) -> [] int {
    var v = ast.get(st, item, 8);
    while v >= 0 {
        if ast.same(st, text, ast.get(st, v, 4), name) {
            return v;
        }
        v = ast.next(st, v);
    }
    return 0 - 1;
}

// Is a field called `name` written in the literal's fields before `stop`?
pub fn given_before[&s, &x](st: &!s [int], text: &x [byte], first: int, stop: int, name: int) -> [] bool {
    var f = first;
    while f != stop {
        if ast.same(st, text, ast.get(st, f, 4), name) {
            return true;
        }
        f = ast.next(st, f);
    }
    return false;
}

// The `static` item of the current module called like token `name`, or -1.
pub fn static_named[&s, &x](st: &!s [int], text: &x [byte], name: int) -> [] int {
    var it = st[15];
    while it >= 0 {
        if ast.is_kind(st, it, kinds.NK::IStatic) && ast.same(st, text, ast.get(st, it, 4), name) && ast.get(st, it, 13) == st[22] {
            return it;
        }
        it = ast.next(st, it);
    }
    return 0 - 1;
}

// Is `name` a static of the current function's module, a function of any module, or a builtin?
pub fn names_something[&s, &x](st: &!s [int], text: &x [byte], name: int) -> [] bool {
    var it = st[15];
    while it >= 0 {
        if ast.is_kind(st, it, kinds.NK::IStatic) && ast.same(st, text, ast.get(st, it, 4), name) && ast.get(st, it, 13) == st[22] {
            return true;
        }
        if ast.is_kind(st, it, kinds.NK::IFn) && ast.same(st, text, ast.get(st, it, 4), name) {
            return true;
        }
        it = ast.next(st, it);
    }
    return pass1.builtin_named(st, text, name);
}

// The arm of the prelude enum `index` called like token `name`, as its number among all arms, or -1.
pub fn prelude_arm_named[&s, &x](st: &!s [int], text: &x [byte], index: int, name: int) -> [] int {
    let first = builtins.prelude_arm_first(index);
    var k = 0;
    while k < builtins.prelude_arm_count(index) {
        if lc.spells(text, ast.tstart(st, name), ast.tend(st, name), builtins.arm_name(first + k)) {
            return first + k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

// The expressions the code can be written for so far: whole numbers and booleans, names, the
// operators, and calls.
pub fn writes_code[&s](st: &!s [int], id: int) -> [] bool {
    if ast.is_kind(st, id, kinds.NK::EInt) || ast.is_kind(st, id, kinds.NK::EFloat) || ast.is_kind(st, id, kinds.NK::EBool) || ast.is_kind(st, id, kinds.NK::EName) || ast.is_kind(st, id, kinds.NK::ECall) || ast.is_kind(st, id, kinds.NK::EStr) || ast.is_kind(st, id, kinds.NK::EIndex) || ast.is_kind(st, id, kinds.NK::EStructLit) || ast.is_kind(st, id, kinds.NK::EField) || ast.is_kind(st, id, kinds.NK::EVariant) || ast.is_kind(st, id, kinds.NK::EAllocSlice) || ast.is_kind(st, id, kinds.NK::ESlice) || ast.is_kind(st, id, kinds.NK::EAlloc) || ast.is_kind(st, id, kinds.NK::ETuple) || ast.is_kind(st, id, kinds.NK::ETupleField) {
        return true;
    }
    if ast.is_kind(st, id, kinds.NK::EUnary) {
        return true;
    }
    if ast.is_kind(st, id, kinds.NK::EBinary) {
        return true;
    }
    return false;
}

// Is the expression free of calls, so that it may be written later than where it stands without a difference a
// program could see? Literals, names, fields and variants of those.
pub fn pure[&s](st: &!s [int], id: int) -> [] bool {
    if ast.is_kind(st, id, kinds.NK::EInt) || ast.is_kind(st, id, kinds.NK::EBool) || ast.is_kind(st, id, kinds.NK::EFloat) || ast.is_kind(st, id, kinds.NK::EName) || ast.is_kind(st, id, kinds.NK::EStr) {
        return true;
    }
    if ast.is_kind(st, id, kinds.NK::EField) {
        return pure(st, ast.get(st, id, 4));
    }
    if ast.is_kind(st, id, kinds.NK::EVariant) {
        var arg = ast.get(st, id, 7);
        var left = ast.get(st, id, 8);
        while left > 0 {
            if !pure(st, arg) {
                return false;
            }
            arg = ast.next(st, arg);
            left = left - 1;
        }
        return true;
    }
    return false;
}
