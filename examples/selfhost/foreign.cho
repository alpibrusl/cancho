module selfhost.foreign;

// foreign.cho -- foreign declarations in the cancho checker, written in cancho.
//
// Stage 3b of the self-hosting spike (`docs/self-hosting.md` section 6, epic #295): a port of
// the loop of `collect_declarations` (`crates/cancho-ir/src/lib.rs`) that handles every
// `extern fn`, which runs between the type declarations and the statics. An `extern fn`
// names a C symbol, and the checker's whole concern is that what crosses the boundary is what
// C can name (an `int`, a `bool`, an opaque pointer, a borrowed capability, a `[byte]` slice),
// and that the capability it borrows is what authorises the effects its row declares.
//
// The checks, in the order the Rust checker makes them: the name is not a builtin's, nor
// another foreign function's in the module, nor a symbol another binds; the region
// parameters; every parameter's type and then the result's, resolved (`c_ptr` and, for the
// result, `c_int` are names only a foreign signature has); what crosses; the capabilities
// the parameters borrow, which discharge a set of labels; an `Ffi` narrowed to nothing; the
// row and what is discharged, which must be the same set; and exactly one library.
//
// What owning a capability discharges is data, generated into `tables.cho` from
// `discharged_by`: a list of labels per prelude type, each plain, narrowed to the literal the
// type is written with, or narrowed to the empty string.

import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.kinds;
import selfhost.rules;
import selfhost.tables;
import selfhost.pass1;

// -------------------------------------------------- the strings of a row ---

// The character at `at` of a string literal's interior and where the next one starts: an
// escape is one character.
struct Dc {
    c: int,
    next: int,
}

fn decode_at[&x](text: &x [byte], at: int) -> [] Dc {
    let c = lc.at(text, at);
    if c != '\\' {
        return Dc { c: c, next: at + 1 };
    }
    let e = lc.at(text, at + 1);
    var out = e;
    if e == 'n' {
        out = 10;
    }
    if e == 'r' {
        out = 13;
    }
    if e == 't' {
        out = 9;
    }
    if e == '0' {
        out = 0;
    }
    return Dc { c: out, next: at + 2 };
}

// Do the string literals at tokens `a` and `b` say the same thing, escapes read?
fn lit_equal[&s, &x](st: &!s [int], text: &x [byte], a: int, b: int) -> [] bool {
    var i = ast.tstart(st, a) + 1;
    var j = ast.tstart(st, b) + 1;
    let ie = ast.tend(st, a) - 1;
    let je = ast.tend(st, b) - 1;
    while i < ie && j < je {
        let x = decode_at(text, i);
        let y = decode_at(text, j);
        if x.c != y.c {
            return false;
        }
        i = x.next;
        j = y.next;
    }
    return i >= ie && j >= je;
}

fn lit_empty[&s](st: &!s [int], tok: int) -> [] bool {
    return ast.tend(st, tok) - ast.tstart(st, tok) == 2;
}

// Is the name `[a, ae)` before `[b, be)` in byte order?
fn bytes_less[&x](text: &x [byte], a: int, ae: int, b: int, be: int) -> [] bool {
    var i = 0;
    while a + i < ae && b + i < be {
        let x = lc.at(text, a + i);
        let y = lc.at(text, b + i);
        if x != y {
            return x < y;
        }
        i = i + 1;
    }
    return ae - a < be - b;
}

// Is `da`, a string a row narrows `ffi` to, the canonical spelling of the library set `lit` names:
// the names sorted, once each, joined by commas? The Rust checker canonicalises the capability's
// type and compares labels as written, so `ffi("libssl,libc")` is not `ffi("libc,libssl")`.
fn canon_equal[&s, &x](st: &!s [int], text: &x [byte], lit: int, da: int) -> [] bool {
    let from = ast.tstart(st, da) + 1;
    let to = ast.tend(st, da) - 1;
    let lfrom = ast.tstart(st, lit) + 1;
    let lto = ast.tend(st, lit) - 1;
    if lfrom == lto {
        return from == to;
    }
    if from == to {
        return false;
    }
    var j = from;
    while j < to {
        if lc.at(text, j) == '\\' {
            return false;
        }
        j = j + 1;
    }
    var lnames = 1;
    j = lfrom;
    while j < lto {
        if lc.at(text, j) == ',' {
            lnames = lnames + 1;
        }
        j = j + 1;
    }
    var count = 0;
    var prev = 0 - 1;
    var prev_end = 0 - 1;
    var start = from;
    while start <= to {
        var end = start;
        while end < to && lc.at(text, end) != ',' {
            end = end + 1;
        }
        var found = false;
        var ls = lfrom;
        while ls <= lto && !found {
            var le = ls;
            while le < lto && lc.at(text, le) != ',' {
                le = le + 1;
            }
            if le - ls == end - start && lc.spells(text, ls, le, text[start..end]) {
                found = true;
            }
            ls = le + 1;
        }
        if !found {
            return false;
        }
        if prev >= 0 && !bytes_less(text, prev, prev_end, start, end) {
            return false;
        }
        prev = start;
        prev_end = end;
        count = count + 1;
        start = end + 1;
    }
    return count == lnames;
}

// ------------------------------------------------------------ the rows ---

// The token of the name of label `k` of the row whose `[` is token `open`, or -1.
fn row_name[&s](st: &!s [int], open: int, k: int) -> [] int {
    var at = open + 1;
    var seen = 0;
    while !pass1.is_code(st, at, lc.Tok::RBracket) {
        if seen == k {
            return at;
        }
        at = at + 1;
        if pass1.is_code(st, at, lc.Tok::LParen) {
            at = at + 3;
        }
        if pass1.is_code(st, at, lc.Tok::Comma) {
            at = at + 1;
        }
        seen = seen + 1;
    }
    return 0 - 1;
}

// The token of the string a label is narrowed to, or -1.
fn row_arg[&s](st: &!s [int], name: int) -> [] int {
    if pass1.is_code(st, name + 1, lc.Tok::LParen) {
        return name + 2;
    }
    return 0 - 1;
}

// How many labels a generated list has, and where entry `k` starts and ends.
fn spec_count[&r](spec: &r [byte]) -> [] int {
    if len(spec) == 0 {
        return 0;
    }
    var n = 1;
    var i = 0;
    while i < len(spec) {
        if int_of(spec[i]) == ' ' {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

fn spec_start[&r](spec: &r [byte], k: int) -> [] int {
    var at = 0;
    var seen = 0;
    while seen < k {
        while int_of(spec[at]) != ' ' {
            at = at + 1;
        }
        at = at + 1;
        seen = seen + 1;
    }
    return at;
}

fn spec_end[&r](spec: &r [byte], start: int) -> [] int {
    var at = start;
    while at < len(spec) && int_of(spec[at]) != ' ' {
        at = at + 1;
    }
    return at;
}

// 0 for a plain label, 1 for one narrowed to the literal of the type (`name*`), 2 for one narrowed
// to the empty string (`name=`).
fn spec_kind[&r](spec: &r [byte], start: int, end: int) -> [] int {
    if int_of(spec[end - 1]) == '*' {
        return 1;
    }
    if int_of(spec[end - 1]) == '=' {
        return 2;
    }
    return 0;
}

// The type a parameter borrows, if it is a reference to a prelude type: the node of that type.
fn borrowed[&s](st: &!s [int], param: int) -> [] int {
    let ty = ast.get(st, param, 5);
    if !ast.is_kind(st, ty, kinds.NK::TRef) {
        return 0 - 1;
    }
    let inner = ast.get(st, ty, 6);
    if ast.is_kind(st, inner, kinds.NK::TName) && ast.get(st, inner, 8) == 2 {
        return inner;
    }
    return 0 - 1;
}

// Does owning `inner` discharge labels at all? A narrowed capability does only with the literal it
// is narrowed to.
fn discharges[&s](st: &!s [int], inner: int) -> [] bool {
    if tables.prelude_arity(ast.get(st, inner, 9)) == 0 {
        return true;
    }
    return ast.get(st, inner, 7) >= 1 && ast.is_kind(st, ast.get(st, inner, 6), kinds.NK::TLit);
}

// The literal token a borrowed capability is narrowed to, or -1.
fn narrowed_to[&s](st: &!s [int], inner: int) -> [] int {
    if ast.get(st, inner, 7) >= 1 && ast.is_kind(st, ast.get(st, inner, 6), kinds.NK::TLit) {
        return ast.get(st, ast.get(st, inner, 6), 4);
    }
    return 0 - 1;
}

// Does the label `[from, to)` narrowed to `arg` (a string token, or -1) match the generated entry
// of kind `kind`, for a capability narrowed to `lit` (`def` is its prelude type)?
fn arg_matches[&s, &x](st: &!s [int], text: &x [byte], kind: int, def: int, lit: int, arg: int) -> [] bool {
    if kind == 0 {
        return arg < 0;
    }
    if arg < 0 {
        return false;
    }
    if kind == 2 {
        return lit_empty(st, arg);
    }
    if def == tables.prelude_ffi() {
        return canon_equal(st, text, lit, arg);
    }
    return lit_equal(st, text, lit, arg);
}

// Does owning what the parameters of `ext` borrow discharge the label whose name is token `name`,
// narrowed to the string token `arg` (or -1)?
fn discharged[&s, &x](st: &!s [int], text: &x [byte], ext: int, name: int, arg: int) -> [] bool {
    var p = ast.get(st, ext, 7);
    while p >= 0 {
        let inner = borrowed(st, p);
        if inner >= 0 && discharges(st, inner) {
            let def = ast.get(st, inner, 9);
            let spec = tables.prelude_labels(def);
            var k = 0;
            while k < spec_count(spec) {
                let start = spec_start(spec, k);
                let end = spec_end(spec, start);
                let kind = spec_kind(spec, start, end);
                var name_end = end;
                if kind != 0 {
                    name_end = end - 1;
                }
                if lc.spells(text, ast.tstart(st, name), ast.tend(st, name), spec[start..name_end]) {
                    if arg_matches(st, text, kind, def, narrowed_to(st, inner), arg) {
                        return true;
                    }
                }
                k = k + 1;
            }
        }
        p = ast.next(st, p);
    }
    return false;
}

// ------------------------------------------------------------ the checks ---

fn is_name[&s, &x](st: &!s [int], text: &x [byte], ty: int, spelled: &static [byte]) -> [] bool {
    return ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 4) < 0 && ast.get(st, ty, 7) == 0 && pass1.is_word(st, text, ast.get(st, ty, 5), spelled);
}

// What crosses the boundary as a parameter: an `int`, a `bool`, an opaque pointer, a borrowed
// capability, or a borrowed `[byte]`.
fn crosses[&s, &x](st: &!s [int], text: &x [byte], ty: int) -> [] bool {
    if is_name(st, text, ty, "c_ptr") {
        return true;
    }
    if ast.is_kind(st, ty, kinds.NK::TName) {
        return ast.get(st, ty, 8) == 0 && (ast.get(st, ty, 10) == 1 || ast.get(st, ty, 10) == 5);
    }
    if ast.is_kind(st, ty, kinds.NK::TRef) {
        let inner = ast.get(st, ty, 6);
        if ast.is_kind(st, inner, kinds.NK::TName) && ast.get(st, inner, 8) == 2 && tables.prelude_capability(ast.get(st, inner, 9)) {
            return true;
        }
        if ast.is_kind(st, inner, kinds.NK::TSlice) {
            let element = ast.get(st, inner, 6);
            return ast.is_kind(st, element, kinds.NK::TName) && ast.get(st, element, 8) == 0 && ast.get(st, element, 10) == 2;
        }
    }
    return false;
}

fn returns_ok[&s, &x](st: &!s [int], text: &x [byte], ty: int) -> [] bool {
    if is_name(st, text, ty, "c_int") || is_name(st, text, ty, "c_ptr") {
        return true;
    }
    return ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 0 && (ast.get(st, ty, 10) == 1 || ast.get(st, ty, 10) == 5);
}

fn check_extern[&s, &x](st: &!s [int], text: &x [byte], it: int) -> [] int {
    let from = ast.nstart(st, it);
    let to = ast.nend(st, it);
    let name = ast.get(st, it, 4);
    let unit_of = ast.get(st, it, 13);
    let edition = ast.get(st, it, 14);
    let dp = ast.get(st, it, 6);
    let row = ast.get(st, it, 9);
    if pass1.builtin_name(st, text, name, edition) {
        ast.fail(st, rules.r_foreign_declaration(), from, to);
        return 0;
    }
    var other = st[15];
    while other != it && ast.ok(st) {
        if ast.is_kind(st, other, kinds.NK::IExtern) && ast.get(st, other, 13) == unit_of && ast.same(st, text, ast.get(st, other, 4), name) {
            ast.fail(st, rules.r_duplicate_declaration(), from, to);
        }
        other = ast.next(st, other);
    }
    other = st[15];
    while other != it && ast.ok(st) {
        if ast.is_kind(st, other, kinds.NK::IExtern) && ast.same(st, text, ast.get(st, other, 4), name) {
            ast.fail(st, rules.r_foreign_declaration(), from, to);
        }
        other = ast.next(st, other);
    }
    pass1.check_region_names(st, text, dp, from, to);
    var param = ast.get(st, it, 7);
    while param >= 0 && ast.ok(st) {
        let ty = ast.get(st, param, 5);
        if !is_name(st, text, ty, "c_ptr") {
            pass1.resolve(st, text, ty, unit_of, edition, dp, true, false);
        }
        param = ast.next(st, param);
    }
    let ret = ast.get(st, it, 10);
    if !is_name(st, text, ret, "c_int") && !is_name(st, text, ret, "c_ptr") {
        pass1.resolve(st, text, ret, unit_of, edition, dp, true, false);
    }
    if !ast.ok(st) {
        return 0;
    }
    // What crosses the boundary is what C can name.
    param = ast.get(st, it, 7);
    while param >= 0 && ast.ok(st) {
        if !crosses(st, text, ast.get(st, param, 5)) {
            ast.fail(st, rules.r_foreign_boundary_type(), from, to);
        }
        param = ast.next(st, param);
    }
    if ast.ok(st) && !returns_ok(st, text, ret) {
        ast.fail(st, rules.r_foreign_boundary_type(), from, to);
    }
    // A foreign function is reached through the capability that names its library, not the root.
    param = ast.get(st, it, 7);
    while param >= 0 && ast.ok(st) {
        let inner = borrowed(st, param);
        if inner >= 0 && ast.get(st, inner, 9) == tables.prelude_ffi() {
            let lit = narrowed_to(st, inner);
            if lit >= 0 && lit_empty(st, lit) {
                ast.fail(st, rules.r_foreign_declaration(), from, to);
            }
        }
        param = ast.next(st, param);
    }
    // The row and what the borrowed capabilities discharge are the same set.
    var k = 0;
    while ast.ok(st) && row_name(st, row, k) >= 0 {
        let label = row_name(st, row, k);
        if !discharged(st, text, it, label, row_arg(st, label)) {
            ast.fail(st, rules.r_effect_not_declared(), from, to);
        }
        k = k + 1;
    }
    param = ast.get(st, it, 7);
    while param >= 0 && ast.ok(st) {
        let inner = borrowed(st, param);
        if inner >= 0 && discharges(st, inner) {
            let def = ast.get(st, inner, 9);
            let spec = tables.prelude_labels(def);
            var e = 0;
            while e < spec_count(spec) && ast.ok(st) {
                let start = spec_start(spec, e);
                let end = spec_end(spec, start);
                let kind = spec_kind(spec, start, end);
                var name_end = end;
                if kind != 0 {
                    name_end = end - 1;
                }
                // The generated entries live in `tables.cho`, not in `text`: compare by spelling.
                if !declares_entry(st, text, row, spec, start, name_end, kind, def, narrowed_to(st, inner)) {
                    ast.fail(st, rules.r_effect_not_declared(), from, to);
                }
                e = e + 1;
            }
        }
        param = ast.next(st, param);
    }
    // Exactly one `Ffi`, naming one library.
    var scopes = 0;
    var scope = 0 - 1;
    param = ast.get(st, it, 7);
    while param >= 0 && ast.ok(st) {
        let inner = borrowed(st, param);
        if inner >= 0 && ast.get(st, inner, 9) == tables.prelude_ffi() && narrowed_to(st, inner) >= 0 {
            scopes = scopes + 1;
            scope = narrowed_to(st, inner);
        }
        param = ast.next(st, param);
    }
    if ast.ok(st) && scopes != 1 {
        ast.fail(st, rules.r_foreign_declaration(), from, to);
    }
    if ast.ok(st) {
        var j = ast.tstart(st, scope) + 1;
        while j < ast.tend(st, scope) - 1 {
            if lc.at(text, j) == ',' {
                ast.fail(st, rules.r_foreign_declaration(), from, to);
            }
            j = j + 1;
        }
    }
    return 0;
}

// Does the row declare the generated label `spec[start..name_end]` of this `kind`?
fn declares_entry[&s, &x, &r](st: &!s [int], text: &x [byte], row: int, spec: &r [byte], start: int, name_end: int, kind: int, def: int, lit: int) -> [] bool {
    var k = 0;
    while row_name(st, row, k) >= 0 {
        let name = row_name(st, row, k);
        if lc.spells(text, ast.tstart(st, name), ast.tend(st, name), spec[start..name_end]) {
            if arg_matches(st, text, kind, def, lit, row_arg(st, name)) {
                return true;
            }
        }
        k = k + 1;
    }
    return false;
}

// Every `extern fn` of the program, in order.
pub fn check_externs[&s, &x](st: &!s [int], text: &x [byte]) -> [] int {
    var it = st[15];
    while it >= 0 && ast.ok(st) {
        if ast.is_kind(st, it, kinds.NK::IExtern) {
            check_extern(st, text, it);
        }
        it = ast.next(st, it);
    }
    return 0;
}
