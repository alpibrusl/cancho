module selfhost.instances;

// instances.cho -- the generic functions a program calls, one copy for each type they are called at.
//
// A function with type parameters is not compiled where it is declared: a call to it knows what the
// parameters are (the checker solved them), so the call asks for an *instance*, the function at those types,
// and gets a name for it; the driver compiles the instances after the other functions, each with its parameters
// standing for the types asked, and a call from an instance can ask for more.
//
// Types cross from one function to another as codes, because each function has a table of types of its own:
// 1 to 7 a scalar; 20, the declaration, how many arguments, and them, a struct or an enum; 21 and 22 the
// run and the single value on the heap; 23 and 24 a tuple of two and of three; 25, the prelude type and the
// token of the literal it was narrowed to (one more than it, 0 for none). A reference has no code, so a call
// whose type arguments hold one is not compiled.
//
// The room is a region of the state after the statics' (`ast.inst_region`): 0 how many instances, 1 where
// the next code goes, 3 to 10 the arguments of the instance being compiled as types of the function's own
// table (`types.env_arg`), 11 the cursor of a decode; then four slots an instance (the declaration, where its
// codes start, how many arguments) and the codes.

import selfhost.ast;
import selfhost.types;
import selfhost.lexcore as lc;
import std.buffer;

fn base[&s](st: &!s [int]) -> [] int {
    return st[62] + ast.const_region();
}

fn table_at[&s](st: &!s [int]) -> [] int {
    return base(st) + 16;
}

fn codes_at[&s](st: &!s [int]) -> [] int {
    return base(st) + 16 + 4096;
}

fn codes_cap() -> [] int {
    return 65536;
}

pub fn count[&s](st: &!s [int]) -> [] int {
    return st[base(st)];
}

// The declaration of instance `k`.
pub fn item_of[&s](st: &!s [int], k: int) -> [] int {
    return st[table_at(st) + 4 * k];
}

fn put_code[&s](st: &!s [int], code: int) -> [] bool {
    let top = st[base(st) + 1];
    if top >= codes_cap() {
        return false;
    }
    st[codes_at(st) + top] = code;
    st[base(st) + 1] = top + 1;
    return true;
}

// The code of a type that is known all the way down, written after the last; false if it has none.
fn encode[&s](st: &!s [int], ty: int) -> [] bool {
    let t = types.resolve_type(st, ty);
    if t >= 1 && t < types.first_table() {
        return put_code(st, t);
    }
    if types.is_named(st, t) {
        var n = 0;
        if types.named_arg(st, t, 0) != 0 {
            n = 1;
        }
        if types.named_arg(st, t, 1) != 0 {
            n = 2;
        }
        if !put_code(st, 20) || !put_code(st, types.named_item(st, t)) || !put_code(st, n) {
            return false;
        }
        var k = 0;
        while k < n {
            if !encode(st, types.named_arg(st, t, k)) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }
    if types.is_boxslice(st, t) {
        return put_code(st, 21) && encode(st, types.boxslice_element(st, t));
    }
    if types.is_box(st, t) {
        return put_code(st, 22) && encode(st, types.box_inner(st, t));
    }
    if types.is_tuple(st, t) {
        let n = types.tuple_size(st, t);
        if n > 3 || !put_code(st, 21 + n) {
            return false;
        }
        var k = 0;
        while k < n {
            if !encode(st, types.tuple_part(st, t, k)) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }
    if types.is_prelude(st, t) {
        return put_code(st, 25) && put_code(st, types.prelude_index(st, t)) && put_code(st, types.prelude_lit_tok(st, t) + 1);
    }
    return false;
}

// The type the codes at position `at` of the stream are, in the table of the function being compiled; the
// position after them is left in the region's slot 11.
fn decode[&s](st: &!s [int], at: int) -> [] int {
    let code = st[codes_at(st) + at];
    st[base(st) + 11] = at + 1;
    if code >= 1 && code < types.first_table() {
        return code;
    }
    if code == 20 {
        let item = st[codes_at(st) + at + 1];
        let n = st[codes_at(st) + at + 2];
        var a = 0;
        var b = 0;
        var next = at + 3;
        if n >= 1 {
            a = decode(st, next);
            next = st[base(st) + 11];
        }
        if n == 2 {
            b = decode(st, next);
            next = st[base(st) + 11];
        }
        st[base(st) + 11] = next;
        if n == 0 {
            return types.make_named(st, item);
        }
        return types.make_named_args(st, item, a, b);
    }
    if code == 21 {
        let element = decode(st, at + 1);
        return types.make_boxslice(st, element);
    }
    if code == 22 {
        let inner = decode(st, at + 1);
        return types.make_box(st, inner);
    }
    if code == 23 || code == 24 {
        let a = decode(st, at + 1);
        let b = decode(st, st[base(st) + 11]);
        var c = 0;
        if code == 24 {
            c = decode(st, st[base(st) + 11]);
        }
        return types.make_tuple(st, code - 21, a, b, c);
    }
    if code == 25 {
        let index = st[codes_at(st) + at + 1];
        let lit = st[codes_at(st) + at + 2];
        st[base(st) + 11] = at + 3;
        if lit > 0 {
            return types.make_prelude_lit(st, index, lit - 1);
        }
        return types.make_prelude(st, index);
    }
    return 0;
}

// The instance of function `item` at the types `tvars` to `tvars + n - 1` of the function being compiled have
// come to be: its number, or -1 if a type has no code, there is no room, or n is more than 4.
pub fn request[&s](st: &!s [int], item: int, tvars: int, n: int) -> [] int {
    if n > 4 {
        return 0 - 1;
    }
    let start = st[base(st) + 1];
    var k = 0;
    while k < n {
        if !encode(st, tvars + k) {
            st[base(st) + 1] = start;
            return 0 - 1;
        }
        k = k + 1;
    }
    let end = st[base(st) + 1];
    var j = 0;
    while j < st[base(st)] {
        let row = table_at(st) + 4 * j;
        if st[row] == item && st[row + 2] == end - start && same_codes(st, st[row + 1], start, end - start) {
            st[base(st) + 1] = start;
            return j;
        }
        j = j + 1;
    }
    let made = st[base(st)];
    if made >= 1024 {
        st[base(st) + 1] = start;
        return 0 - 1;
    }
    let row = table_at(st) + 4 * made;
    st[row] = item;
    st[row + 1] = start;
    st[row + 2] = end - start;
    st[row + 3] = n;
    st[base(st)] = made + 1;
    return made;
}

fn same_codes[&s](st: &!s [int], a: int, b: int, length: int) -> [] bool {
    var i = 0;
    while i < length {
        if st[codes_at(st) + a + i] != st[codes_at(st) + b + i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// Compile instance `k` next: the arguments are decoded into the function's own table once it has one
// (`load_env`).
pub fn begin[&s](st: &!s [int], k: int) -> [] int {
    st[63] = k + 1;
    return 0;
}

pub fn end[&s](st: &!s [int]) -> [] int {
    st[63] = 0;
    return 0;
}

pub fn load_env[&s](st: &!s [int]) -> [] int {
    let row = table_at(st) + 4 * (st[63] - 1);
    var at = st[row + 1];
    var k = 0;
    while k < st[row + 3] {
        st[base(st) + 3 + k] = decode(st, at);
        at = st[base(st) + 11];
        k = k + 1;
    }
    return 0;
}

// ------------------------------------------------------------------- types of variables ---
//
// `var x = list.List::Empty;` has the type of what comes after it. A function with one is compiled twice: the first
// time only to learn the types (`infer`), when a literal that is still unsolved is let be and the types it comes to
// are written down after the function (`settle`); the second time they are the type the literal is expected to be
// (`var_hint`). They are rows of the table with a negative declaration: `-(node * 4096 + instance) - 1`.

fn key_of[&s](st: &!s [int], node: int) -> [] int {
    return 0 - (node * 4096 + st[63]) - 1;
}

// Is the function being compiled one with a literal whose type was not known where it stands?
pub fn wants_inference[&s](st: &!s [int]) -> [] bool {
    return st[base(st) + 14] != 0;
}

pub fn want_inference[&s](st: &!s [int]) -> [] int {
    st[base(st) + 14] = 1;
    return 0;
}

// Start (1) or end (0) the pass that only learns the types; the flag asking for it is cleared at either.
pub fn infer[&s](st: &!s [int], on: int) -> [] int {
    st[base(st) + 13] = on;
    st[base(st) + 14] = 0;
    return 0;
}

pub fn inferring[&s](st: &!s [int]) -> [] bool {
    return st[base(st) + 13] != 0;
}

// The variable declared at `node` has the type `ty`, which is written down when the function is done.
pub fn note_var[&s](st: &!s [int], node: int, ty: int) -> [] int {
    let made = st[base(st)];
    if made >= 1024 {
        return 0;
    }
    let row = table_at(st) + 4 * made;
    st[row] = key_of(st, node);
    st[row + 1] = 0 - 1;
    st[row + 2] = 0;
    st[row + 3] = ty;
    st[base(st)] = made + 1;
    return 0;
}

// The types noted in the pass that learned them, as codes; one that is not known all the way down is dropped.
pub fn settle[&s](st: &!s [int]) -> [] int {
    var j = 0;
    while j < st[base(st)] {
        let row = table_at(st) + 4 * j;
        if st[row] < 0 && st[row + 1] == 0 - 1 {
            let start = st[base(st) + 1];
            if encode(st, st[row + 3]) {
                st[row + 1] = start;
                st[row + 2] = st[base(st) + 1] - start;
            } else {
                st[base(st) + 1] = start;
                st[row + 1] = 0;
                st[row + 2] = 0;
            }
        }
        j = j + 1;
    }
    return 0;
}

// The type the variable declared at `node` came to in the pass that learned it, or 0.
pub fn var_hint[&s](st: &!s [int], node: int) -> [] int {
    var j = 0;
    while j < st[base(st)] {
        let row = table_at(st) + 4 * j;
        if st[row] == key_of(st, node) && st[row + 2] > 0 {
            return decode(st, st[row + 1]);
        }
        j = j + 1;
    }
    return 0;
}

// ------------------------------------------------------------------- names of instances ---

// How many type arguments instance `k` has.
pub fn type_arg_count[&s](st: &!s [int], k: int) -> [] int {
    return st[table_at(st) + 4 * k + 3];
}

// The type at `at` of the codes, written as the Rust command writes it (`Unifier::display`) and added to `out`; the position after it is left in the region's slot 11. A type
// this does not know how to write is written `?`.
fn show[&h, &s, &x](heap: &!h Heap, out: buffer.Buffer, st: &!s [int], text: &x [byte], at: int) -> [heap] buffer.Buffer {
    var b = out;
    let code = st[codes_at(st) + at];
    st[base(st) + 11] = at + 1;
    if code == 1 {
        return buffer.append(heap, b, "int");
    }
    if code == 2 {
        return buffer.append(heap, b, "byte");
    }
    if code == 3 {
        return buffer.append(heap, b, "float");
    }
    if code == 4 {
        return buffer.append(heap, b, "f32");
    }
    if code == 5 {
        return buffer.append(heap, b, "bool");
    }
    if code == 6 {
        return buffer.append(heap, b, "()");
    }
    if code == 20 {
        let item = st[codes_at(st) + at + 1];
        let n = st[codes_at(st) + at + 2];
        b = buffer.append(heap, b, text[ast.tstart(st, ast.get(st, item, 4))..ast.tend(st, ast.get(st, item, 4))]);
        var next = at + 3;
        if n > 0 {
            b = buffer.push(heap, b, byte_of('['));
            var k = 0;
            while k < n {
                if k > 0 {
                    b = buffer.append(heap, b, ", ");
                }
                b = show(heap, b, st, text, next);
                next = st[base(st) + 11];
                k = k + 1;
            }
            b = buffer.push(heap, b, byte_of(']'));
        }
        st[base(st) + 11] = next;
        return b;
    }
    if code == 21 {
        b = buffer.append(heap, b, "Box[[");
        b = show(heap, b, st, text, at + 1);
        return buffer.append(heap, b, "]]");
    }
    if code == 22 {
        b = buffer.append(heap, b, "Box[");
        b = show(heap, b, st, text, at + 1);
        return buffer.push(heap, b, byte_of(']'));
    }
    if code == 23 || code == 24 {
        b = buffer.push(heap, b, byte_of('('));
        b = show(heap, b, st, text, at + 1);
        b = buffer.append(heap, b, ", ");
        b = show(heap, b, st, text, st[base(st) + 11]);
        if code == 24 {
            b = buffer.append(heap, b, ", ");
            b = show(heap, b, st, text, st[base(st) + 11]);
        }
        return buffer.push(heap, b, byte_of(')'));
    }
    if code == 25 {
        st[base(st) + 11] = at + 3;
    }
    return buffer.push(heap, b, byte_of('?'));
}

// `$` and the type of each argument of instance `k`, as `instance_name` of the Rust code writes them: the type as it is displayed, with `[`, `]`, a space and `,` written `_`.
pub fn name_suffix[&h, &s, &x](heap: &!h Heap, out: buffer.Buffer, st: &!s [int], text: &x [byte], k: int) -> [heap] buffer.Buffer {
    var b = out;
    let row = table_at(st) + 4 * k;
    var at = st[row + 1];
    var n = 0;
    while n < st[row + 3] {
        var shown = show(heap, buffer.empty(heap, 16), st, text, at);
        at = st[base(st) + 11];
        b = buffer.push(heap, b, byte_of('$'));
        borrow shown as &sb in {
            let t = buffer.bytes(sb);
            var i = 0;
            while i < len(t) {
                let c = lc.at(t, i);
                if c == '[' || c == ']' || c == ' ' || c == ',' {
                    b = buffer.push(heap, b, byte_of('_'));
                } else {
                    b = buffer.push(heap, b, t[i]);
                }
                i = i + 1;
            }
        }
        buffer.drop(heap, shown);
        n = n + 1;
    }
    return b;
}

// ------------------------------------------------------------------- labels with an argument (`cancho authority`) ---
//
// The header has, in slot 12, how many performances of a label with an argument the function being checked has marked and not yet followed. The rows are in a region of their own after the `defer`'s
// (`ast.auth_region`): how many, then three slots each: the function, the label (the number of the builtin effect) and the token of the literal that is its argument (-1 for the empty one, which is a
// capability that was not narrowed).

fn auth_at[&s](st: &!s [int]) -> [] int {
    return base(st) + 16 + 4096 + 65536 + 256 + 1100;
}

pub fn pending_reset[&s](st: &!s [int]) -> [] int {
    st[base(st) + 12] = 0;
    return 0;
}

pub fn pending_add[&s](st: &!s [int], n: int) -> [] int {
    st[base(st) + 12] = st[base(st) + 12] + n;
    return 0;
}

pub fn pending[&s](st: &!s [int]) -> [] int {
    return st[base(st) + 12];
}

// The function `item` performs the label `label` with the argument whose literal is the token `lit`. False if there is no room for one more.
pub fn note_label[&s](st: &!s [int], item: int, label: int, lit: int) -> [] bool {
    let count = st[auth_at(st)];
    var k = 0;
    while k < count {
        let row = auth_at(st) + 1 + 3 * k;
        if st[row] == item && st[row + 1] == label && st[row + 2] == lit {
            return true;
        }
        k = k + 1;
    }
    if count >= 8192 {
        return false;
    }
    let row = auth_at(st) + 1 + 3 * count;
    st[row] = item;
    st[row + 1] = label;
    st[row + 2] = lit;
    st[auth_at(st)] = count + 1;
    return true;
}

pub fn label_rows[&s](st: &!s [int]) -> [] int {
    return st[auth_at(st)];
}

pub fn label_item[&s](st: &!s [int], k: int) -> [] int {
    return st[auth_at(st) + 1 + 3 * k];
}

pub fn label_name[&s](st: &!s [int], k: int) -> [] int {
    return st[auth_at(st) + 2 + 3 * k];
}

pub fn label_literal[&s](st: &!s [int], k: int) -> [] int {
    return st[auth_at(st) + 3 + 3 * k];
}
