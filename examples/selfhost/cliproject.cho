edition 7;
module selfhost.cliproject;

// cliproject.cho -- the project file in the command line in cancho (`docs/cli-in-cancho.md` section 20, `project.rs`): `install`, `build` and `test` with no files
// (`docs/package-system.md` section 8). The file is read by `projfile.cho`; the programs are built and the sets of tests run as `build` and `test` do with files. What
// needs `vcs` (a dependency, so `install` of one, `add`) is not here, and is a status 3.

import std.buffer;
import std.bytes;
import std.io as console;
import selfhost.lexcore as lc;
import selfhost.driver;
import selfhost.walk;
import selfhost.satisfytext;
import selfhost.version;
import selfhost.projfile;
import selfhost.filewrite;
import selfhost.cliorigin;
import selfhost.clistore;
import selfhost.clibase;
import selfhost.cliprog;
import selfhost.clitest;

// The directory the command was run in, as the system says it: `/bin/pwd` with no environment to tell it a logical one, as the Rust command asks the system for it.
fn current_directory[&h, &i, &x, &c](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock) -> [heap, err_write, exec(""), clock, poll] buffer.Buffer {
    let got = cliprog.run_capture(heap, io, exec, clock, "/bin/pwd", "", "");
    let cliprog.Captured { out, err, kind, value } = got;
    var text = buffer.empty(heap, 64);
    if kind == 0 && value == 0 {
        borrow out as &o in {
            let said = buffer.bytes(o);
            var end = len(said);
            while end > 0 && lc.at(said, end - 1) == 10 {
                end = end - 1;
            }
            text = buffer.append(heap, text, said[0..end]);
        }
    }
    buffer.drop(heap, out);
    buffer.drop(heap, err);
    return text;
}

// `path` with its last `up` components taken off (`/a/b/c` and 1 is `/a/b`; it never goes above `/`).
fn ancestor[&h, &p](heap: &!h Heap, path: &p [byte], up: int) -> [heap] buffer.Buffer {
    var end = len(path);
    var left = up;
    while left > 0 && end > 1 {
        end = end - 1;
        while end > 1 && lc.at(path, end - 1) != '/' {
            end = end - 1;
        }
        if end > 1 {
            end = end - 1;
        }
        left = left - 1;
    }
    return buffer.append(heap, buffer.empty(heap, end + 1), path[0..end]);
}

// `entry` beneath the directory `root`: the entry itself if it is an absolute path.
fn beneath[&h, &r, &e](heap: &!h Heap, root: &r [byte], entry: &e [byte]) -> [heap] buffer.Buffer {
    if len(entry) > 0 && lc.at(entry, 0) == '/' {
        return buffer.append(heap, buffer.empty(heap, len(entry) + 1), entry);
    }
    var b = buffer.append(heap, buffer.empty(heap, len(root) + len(entry) + 2), root);
    if len(root) == 0 || lc.at(root, len(root) - 1) != '/' {
        b = buffer.push(heap, b, byte_of('/'));
    }
    return buffer.append(heap, b, entry);
}

// The project the command was run beneath: the number of directories up from the current one that holds `cancho.toml` (-1 if none does) and its text.
pub res struct Found {
    body: buffer.Buffer,
    level: int,
}

// Looks for `cancho.toml` in `cwd` (an absolute path: a `..` in a path is a trap) and in the directories above, as far as 64 of them.
pub fn find_project[&h, &f, &w](heap: &!h Heap, fs: &f Fs(""), cwd: &w [byte]) -> [heap, fs_read(""), file_read] Found {
    var up = 0;
    while up < 64 {
        let dir = ancestor(heap, cwd, up);
        var path = buffer.empty(heap, 0);
        borrow dir as &db in {
            buffer.drop(heap, path);
            path = beneath(heap, buffer.bytes(db), "cancho.toml");
        }
        buffer.drop(heap, dir);
        var found = false;
        var text = buffer.empty(heap, 0);
        borrow path as &pb in {
            let read = clibase.read_file(heap, fs, buffer.bytes(pb));
            let clibase.Contents { bytes, failed } = read;
            if failed == 0 {
                found = true;
                buffer.drop(heap, text);
                text = bytes;
            } else {
                buffer.drop(heap, bytes);
            }
        }
        buffer.drop(heap, path);
        if found {
            return Found { body: text, level: up };
        }
        buffer.drop(heap, text);
        up = up + 1;
    }
    return Found { body: buffer.empty(heap, 0), level: 0 - 1 };
}

// A project, read: its records (`projfile.cho`), the directory that holds its file and the path of the file, both absolute, and a status (0, or what has been said).
pub res struct Project {
    records: buffer.Buffer,
    root: buffer.Buffer,
    file: buffer.Buffer,
    status: int,
}

// One line on the standard error: `head`, `middle` and `tail`, and a newline.
fn say_error[&h, &i, &a, &b, &c](heap: &!h Heap, io: &!i Io, head: &a [byte], middle: &b [byte], tail: &c [byte]) -> [heap, err_write] int {
    var line = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.empty(heap, 128), head), middle), tail);
    line = buffer.push(heap, line, byte_of(10));
    borrow line as &lb in {
        console.error_all(io, buffer.bytes(lb));
    }
    buffer.drop(heap, line);
    return 0;
}

// The project the command was run beneath, read: `no cancho.toml` (status 1) if there is none; a file that is not a project file is 1, one that `load` refuses is 1, and one
// this command line does not read is 3.
pub fn load[&h, &i, &f, &x, &c](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, err_write, fs_read(""), file_read, exec(""), clock, poll] Project {
    let cwd = current_directory(heap, io, exec, clock);
    var text = buffer.empty(heap, 0);
    var up = 0 - 1;
    borrow cwd as &cb in {
        let looked = find_project(heap, fs, buffer.bytes(cb));
        let Found { body, level } = looked;
        buffer.drop(heap, text);
        text = body;
        up = level;
    }
    if up < 0 {
        borrow cwd as &cb in {
            var m = buffer.append(heap, buffer.empty(heap, 128), "no `cancho.toml` in `");
            m = buffer.append(heap, m, buffer.bytes(cb));
            borrow m as &mb in {
                say_error(heap, io, buffer.bytes(mb), "", "` or any directory above it (docs/package-system.md §8)");
            }
            buffer.drop(heap, m);
        }
        buffer.drop(heap, text);
        buffer.drop(heap, cwd);
        return Project { records: buffer.empty(heap, 0), root: buffer.empty(heap, 0), file: buffer.empty(heap, 0), status: 1 };
    }
    var root = buffer.empty(heap, 0);
    borrow cwd as &cb in {
        buffer.drop(heap, root);
        root = ancestor(heap, buffer.bytes(cb), up);
    }
    buffer.drop(heap, cwd);
    var file = buffer.empty(heap, 0);
    borrow root as &rb in {
        buffer.drop(heap, file);
        file = beneath(heap, buffer.bytes(rb), "cancho.toml");
    }
    var recs = buffer.empty(heap, 0);
    var result = 0;
    borrow text as &tb in {
        let parsed = projfile.parse(heap, buffer.bytes(tb));
        let projfile.Parsed { records, status, why } = parsed;
        buffer.drop(heap, recs);
        recs = records;
        borrow file as &fb in {
            borrow why as &wb in {
                if status == 1 {
                    say_error(heap, io, "`", buffer.bytes(fb), "` is not a project file: ");
                    console.error_all(io, buffer.bytes(wb));
                    console.error_all(io, "\n");
                    result = 1;
                } else if status == 2 {
                    var head = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), "`"), buffer.bytes(fb));
                    borrow head as &hb in {
                        say_error(heap, io, buffer.bytes(hb), "`: ", buffer.bytes(wb));
                    }
                    buffer.drop(heap, head);
                    result = 1;
                } else if status == 3 {
                    var head = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), "`"), buffer.bytes(fb));
                    borrow head as &hb in {
                        say_error(heap, io, buffer.bytes(hb), "`: cannot judge: ", buffer.bytes(wb));
                    }
                    buffer.drop(heap, head);
                    result = 3;
                }
            }
        }
        buffer.drop(heap, why);
    }
    buffer.drop(heap, text);
    return Project { records: recs, root: root, file: file, status: result };
}

// ----------------------------------------------------------------------------------------------------------------------------- the commands ---

pub fn is_file[&f, &p](fs: &f Fs(""), path: &p [byte]) -> [fs_read("")] bool {
    if walk.dotdot(path) {
        return false;
    }
    match open_read(fs, path) {
        Opened::Ok(file) => {
            file_close(file);
            return true;
        }
        Opened::Failed(reason) => {
            return false;
        }
    }
}

// The start of the record that follows the one at `at` in `recs`.
fn after_record[&r](recs: &r [byte], at: int) -> [] int {
    var p = at;
    while p < len(recs) && lc.at(recs, p) != 2 {
        p = p + 1;
    }
    return p + 1;
}

// The files of a program or of a set of tests named `name`: each entry of `sources` (separated by a byte 1) beneath `root` that is a file, or every `.cho` directly in it if
// it is a directory; each once, in the order of paths, each followed by a NUL. If an entry is neither, or holds no `.cho` file, it has been said and the answer is empty and
// `broken` is 1.
pub res struct Sources {
    listed: buffer.Buffer,
    broken: int,
}

fn sources_of[&h, &i, &f, &r, &n, &s](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), root: &r [byte], name: &n [byte], sources: &s [byte]) -> [heap, err_write, fs_read(""), dir_read] Sources {
    var found = buffer.empty(heap, 128);
    var bad = 0;
    var at = 0;
    while at <= len(sources) && bad == 0 && len(sources) > 0 {
        var end = at;
        while end < len(sources) && lc.at(sources, end) != 1 {
            end = end + 1;
        }
        let entry = sources[at..end];
        let path = beneath(heap, root, entry);
        borrow path as &pb in {
            if walk.is_directory(fs, buffer.bytes(pb)) {
                var before = 0;
                borrow found as &fz in {
                    before = buffer.size(fz);
                }
                found = walk.direct(heap, fs, buffer.bytes(pb), found);
                var grown = false;
                borrow found as &fz in {
                    grown = buffer.size(fz) != before;
                }
                if !grown {
                    say_error(heap, io, "`", name, "`: ");
                    var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), "`"), entry);
                    borrow m as &mb in {
                        say_error(heap, io, buffer.bytes(mb), "` holds no `.cho` file", "");
                    }
                    buffer.drop(heap, m);
                    bad = 1;
                }
            } else if is_file(fs, buffer.bytes(pb)) {
                found = buffer.push(heap, buffer.append(heap, found, buffer.bytes(pb)), byte_of(0));
            } else {
                var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 64), "`"), entry);
                borrow m as &mb in {
                    say_error(heap, io, "`", name, "`: ");
                    say_error(heap, io, buffer.bytes(mb), "` is not a file or directory", "");
                }
                buffer.drop(heap, m);
                bad = 1;
            }
        }
        buffer.drop(heap, path);
        at = end + 1;
    }
    if bad != 0 {
        buffer.drop(heap, found);
        return Sources { listed: buffer.empty(heap, 0), broken: 1 };
    }
    var ordered = buffer.empty(heap, 0);
    borrow found as &fb in {
        buffer.drop(heap, ordered);
        ordered = projfile.sorted_paths(heap, buffer.bytes(fb));
    }
    buffer.drop(heap, found);
    return Sources { listed: ordered, broken: 0 };
}

// A project that was written for a compiler (`[package] cancho`) is checked against the commit this command line was built from (`version.cho`, stamped by `scripts/stamp-version.sh`;
// the Rust command stamps it at build time): the same commit is accepted, any other is refused unless `ignore`, which says so and goes on. An unstamped build (`unknown`) cannot be
// checked and says that. 0, or 1.
fn check_compiler[&h, &i, &r](heap: &!h Heap, io: &!i Io, recs: &r [byte], ignore: bool) -> [heap, err_write] int {
    let name_end = projfile.field_end(recs, 2, len(recs));
    if lc.at(recs, name_end + 1) != '1' {
        return 0;
    }
    let from = name_end + 3;
    var stop = from;
    while stop < len(recs) && lc.at(recs, stop) != 2 {
        stop = stop + 1;
    }
    let want = recs[from..stop];
    if bytes.equal(want, version.rev()) {
        return 0;
    }
    if ignore {
        var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 128), "note: this project was written for cancho "), want);
        m = buffer.append(heap, m, "; this is ");
        m = buffer.append(heap, m, version.rev());
        m = buffer.append(heap, m, " (--ignore-compiler-rev)");
        borrow m as &mb in {
            say_error(heap, io, buffer.bytes(mb), "", "");
        }
        buffer.drop(heap, m);
        return 0;
    }
    var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 256), "this project was written for cancho "), want);
    if bytes.equal(version.rev(), "unknown") {
        m = buffer.append(heap, m, ", and this compiler does not know which commit it was built from, so it cannot be checked (build it from a git checkout, or with CANCHO_REV set)");
    } else {
        m = buffer.append(heap, m, ", and this compiler is ");
        m = buffer.append(heap, m, version.rev());
    }
    borrow m as &mb in {
        say_error(heap, io, buffer.bytes(mb), "; install that compiler, change `[package] cancho` after checking the sources against this one, or pass --ignore-compiler-rev", "");
    }
    buffer.drop(heap, m);
    return 1;
}

// A dependency is fetched by `vcs`, which this command line does not carry: the first one (in the order of names) is said, and the status is 3.
// What the installing of the dependencies of a project gave: the files in `build/deps` (each followed by a NUL, in the order of paths), and the status (0, or what has been said).
res struct Installed {
    deps_files: buffer.Buffer,
    outcome: int,
}

// `more` added to the paths `collected` (each followed by a NUL), each once, in the order of paths.
fn merged_paths[&h, &m](heap: &!h Heap, collected: buffer.Buffer, more: &m [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 0);
    borrow collected as &ob in {
        let both = buffer.append(heap, buffer.append(heap, buffer.empty(heap, buffer.size(ob) + len(more) + 1), buffer.bytes(ob)), more);
        borrow both as &bb in {
            out = projfile.replaced(heap, out, projfile.sorted_paths(heap, buffer.bytes(bb)));
        }
        buffer.drop(heap, both);
    }
    buffer.drop(heap, collected);
    return out;
}

// The dependency `name` fetched from the store directory `store` into `deps`: what it wrote (in `deps_files`) and the status, the words said.
fn fetch_one[&h, &i, &x, &c, &f, &k, &s, &t, &d, &n, &g, &v, &p](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), cache: &k [byte], std_path: &s [byte], store: &t [byte], deps: &d [byte], name: &n [byte], git: &g [byte], rev: &v [byte], path: &p [byte]) -> [heap, io_write, err_write, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] Installed {
    let fetched = clistore.fetch_store(heap, io, exec, clock, fs, cache, std_path, store, deps);
    let clistore.Fetched { files, why, status, needs_std } = fetched;
    var short_end = len(rev);
    if short_end > 12 {
        short_end = 12;
    }
    if status == 0 {
        var count = 0;
        borrow files as &fb in {
            var k = 0;
            while k < buffer.size(fb) {
                if lc.at(buffer.bytes(fb), k) == 0 {
                    count = count + 1;
                }
                k = k + 1;
            }
        }
        console.write_all(io, "installed ");
        console.write_all(io, name);
        console.write_all(io, " (");
        console.write_all(io, rev[0..short_end]);
        console.write_all(io, "): ");
        let shown = buffer.push_nat(heap, buffer.empty(heap, 16), count);
        borrow shown as &nb in {
            console.write_all(io, buffer.bytes(nb));
        }
        buffer.drop(heap, shown);
        console.write_all(io, " file(s)\n");
        buffer.drop(heap, why);
        return Installed { deps_files: files, outcome: 0 };
    }
    var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 128), "dependency `"), name);
    if status == 4 {
        m = buffer.append(heap, buffer.append(heap, buffer.append(heap, m, "`: nothing is published at `"), path), "` in ");
        m = buffer.append(heap, buffer.append(heap, buffer.append(heap, m, git), " ("), rev[0..short_end]);
        m = buffer.push(heap, m, byte_of(')'));
    } else {
        m = buffer.append(heap, m, "`: ");
        borrow why as &tb in {
            m = buffer.append(heap, m, buffer.bytes(tb));
        }
    }
    borrow m as &mb in {
        say_error(heap, io, "", buffer.bytes(mb), "");
    }
    buffer.drop(heap, m);
    buffer.drop(heap, why);
    var result = status;
    if status == 4 {
        result = 1;
    }
    return Installed { deps_files: files, outcome: result };
}

// `install_all` (`project.rs`, `docs/package-system.md` section 8.3): `build/deps` is cleared and made, then for each dependency its commit is made a directory by the
// origin cache (`cache_given` is `--cache`, or nothing), its store fetched into `build/deps` and every pin of it, and of the stores it requires, checked (`clistore.fetch_store`;
// a source that imports `std` needs `std_path`). Nothing is asked of the network when there is no dependency.
fn install_all[&h, &i, &x, &c, &f, &r, &d, &k, &s](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), root: &r [byte], recs: &d [byte], cache_given: &k [byte], std_path: &s [byte]) -> [heap, io_write, err_write, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] Installed {
    let deps = beneath(heap, root, "build/deps");
    var collected = buffer.empty(heap, 0);
    var result = 0;
    borrow deps as &db in {
        let gone = cliorigin.tool(heap, io, exec, clock, "/bin/rm", "-rf", buffer.bytes(db));
        if !cliorigin.tool(heap, io, exec, clock, "/bin/mkdir", "-p", buffer.bytes(db)) {
            say_error(heap, io, "cannot create `", buffer.bytes(db), "`");
            result = 3;
        }
        var cache = buffer.empty(heap, 0);
        var at = 0;
        while at < len(recs) && result == 0 {
            if lc.at(recs, at) == 'D' {
                var cached = false;
                borrow cache as &cb in {
                    cached = buffer.size(cb) > 0;
                }
                if !cached {
                    cache = projfile.replaced(heap, cache, cliorigin.cache_root(heap, io, exec, clock, cache_given));
                }
                let name_at = at + 2;
                let name_end = projfile.field_end(recs, name_at, len(recs));
                let git_at = name_end + 1;
                let git_end = projfile.field_end(recs, git_at, len(recs));
                let rev_at = git_end + 1;
                let rev_end = projfile.field_end(recs, rev_at, len(recs));
                let path_at = rev_end + 1;
                var path_end = path_at;
                while path_end < len(recs) && lc.at(recs, path_end) != 0 && lc.at(recs, path_end) != 2 {
                    path_end = path_end + 1;
                }
                borrow cache as &cb in {
                    let got = cliorigin.ensure(heap, io, exec, clock, fs, buffer.bytes(cb), recs[git_at..git_end], recs[rev_at..rev_end], recs[path_at..path_end]);
                    let cliorigin.Checkout { dir, why, status } = got;
                    borrow why as &wb in {
                        if buffer.size(wb) > 0 {
                            say_error(heap, io, "", buffer.bytes(wb), "");
                            result = 3;
                        }
                    }
                    buffer.drop(heap, why);
                    if result == 0 {
                        borrow dir as &sb in {
                            let one = fetch_one(heap, io, exec, clock, fs, buffer.bytes(cb), std_path, buffer.bytes(sb), buffer.bytes(db), recs[name_at..name_end], recs[git_at..git_end], recs[rev_at..rev_end], recs[path_at..path_end]);
                            let Installed { deps_files, outcome } = one;
                            result = outcome;
                            borrow deps_files as &fb in {
                                collected = merged_paths(heap, collected, buffer.bytes(fb));
                            }
                            buffer.drop(heap, deps_files);
                        }
                    }
                    buffer.drop(heap, dir);
                }
            }
            at = after_record(recs, at);
        }
        buffer.drop(heap, cache);
    }
    buffer.drop(heap, deps);
    return Installed { deps_files: collected, outcome: result };
}

// The options of `build` and `test` in a project: `--ignore-compiler-rev`, the name after `only_flag`, `--compiler PATH` (accepted and not used), and, of this command line, `--std-dir DIR`,
// `--host H` and `--clang PATH`. Each is the index of its argument, or -1; `ignore` is 0 or 1; `bad` is the status of a bad one (it has been said).
pub res struct Options {
    ignore: bool,
    only: int,
    std_dir: int,
    host: int,
    host_given: bool,
    clang_at: int,
    cache_at: int,
    bad: int,
}

fn options[&h, &i, &a](heap: &!h Heap, io: &!i Io, args: &a Args, only_flag: &static [byte]) -> [heap, err_write, args] Options {
    var ignore = false;
    var only = 0 - 1;
    var std_dir = 0 - 1;
    var host = 0;
    var host_given = false;
    var clang_at = 0 - 1;
    var cache_at = 0 - 1;
    var bad = 0;
    var n = 2;
    while n < arg_count(args) && bad == 0 {
        let word = arg(args, n);
        if bytes.equal(word, "--ignore-compiler-rev") {
            ignore = true;
        } else if bytes.equal(word, "--cache") {
            n = n + 1;
            if n >= arg_count(args) || len(arg(args, n)) == 0 || lc.at(arg(args, n), 0) != '/' {
                bad = clibase.usage_error(heap, io, "`--cache` needs an absolute directory");
            } else {
                cache_at = n;
            }
        } else if bytes.equal(word, only_flag) {
            n = n + 1;
            if n >= arg_count(args) {
                var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 32), "`"), only_flag);
                m = buffer.append(heap, m, "` needs a name");
                borrow m as &mb in {
                    bad = clibase.usage_error(heap, io, buffer.bytes(mb));
                }
                buffer.drop(heap, m);
            } else {
                only = n;
            }
        } else if bytes.equal(word, "--compiler") && bytes.equal(only_flag, "--bin") {
            n = n + 1;
            if n >= arg_count(args) {
                bad = clibase.usage_error(heap, io, "`--compiler` needs a path");
            }
        } else if bytes.equal(word, "--std-dir") {
            n = n + 1;
            if n >= arg_count(args) {
                bad = clibase.usage_error(heap, io, "`--std-dir` needs a directory");
            } else {
                std_dir = n;
            }
        } else if bytes.equal(word, "--clang") {
            n = n + 1;
            if n >= arg_count(args) {
                bad = clibase.usage_error(heap, io, "`--clang` needs a path");
            } else {
                clang_at = n;
            }
        } else if bytes.equal(word, "--host") {
            n = n + 1;
            host_given = true;
            if n < arg_count(args) && bytes.equal(arg(args, n), "linux") {
                host = 0;
            } else if n < arg_count(args) && bytes.equal(arg(args, n), "darwin") {
                host = 1;
            } else if n < arg_count(args) && bytes.equal(arg(args, n), "linux-aarch64") {
                host = 2;
            } else {
                bad = clibase.usage_error(heap, io, "`--host` needs linux, darwin or linux-aarch64");
            }
        } else {
            var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 32), "unexpected `"), word);
            m = buffer.push(heap, m, byte_of('`'));
            borrow m as &mb in {
                bad = clibase.usage_error(heap, io, buffer.bytes(mb));
            }
            buffer.drop(heap, m);
        }
        n = n + 1;
    }
    return Options { ignore: ignore, only: only, std_dir: std_dir, host: host, host_given: host_given, clang_at: clang_at, cache_at: cache_at, bad: bad };
}

// Does `build` (with `test` false) or `test` (with `test` true) with these arguments mean the project, and not the files it is given? When the arguments are only flags (those
// of `options`, and no file) and a `cancho.toml` is here or above.
pub fn wants_project[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, test: bool) -> [heap, err_write, args, fs_read(""), file_read, exec(""), clock, poll] bool {
    var n = 2;
    while n < arg_count(args) {
        let word = arg(args, n);
        if bytes.equal(word, "--ignore-compiler-rev") {
            n = n + 1;
        } else if bytes.equal(word, "--std-dir") || bytes.equal(word, "--clang") || bytes.equal(word, "--host") || bytes.equal(word, "--cache") {
            n = n + 2;
        } else if !test && (bytes.equal(word, "--bin") || bytes.equal(word, "--compiler")) {
            n = n + 2;
        } else if test && bytes.equal(word, "--test") {
            n = n + 2;
        } else {
            return false;
        }
    }
    let cwd = current_directory(heap, io, exec, clock);
    var above = 0 - 1;
    borrow cwd as &cb in {
        let looked = find_project(heap, fs, buffer.bytes(cb));
        let Found { body, level } = looked;
        buffer.drop(heap, body);
        above = level;
    }
    buffer.drop(heap, cwd);
    return above >= 0;
}

// `install_all` with the options of the command line: `--cache DIR` (or none) and `--std-dir DIR` (or none).
fn install_for[&h, &i, &x, &c, &f, &r, &d, &a](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), root: &r [byte], recs: &d [byte], args: &a Args, cache_at: int, std_dir: int) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] Installed {
    var cache = "";
    if cache_at >= 0 {
        cache = arg(args, cache_at);
    }
    var std_path = "";
    if std_dir >= 0 {
        std_path = arg(args, std_dir);
    }
    return install_all(heap, io, exec, clock, fs, root, recs, cache, std_path);
}

// `install` (`docs/package-system.md` section 8.3): the project is read and the compiler checked; it has nothing to fetch if it has no dependency, and one that has is a status 3.
pub fn install_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    var ignore = false;
    var std_dir = 0 - 1;
    var cache_at = 0 - 1;
    var n = 2;
    while n < arg_count(args) {
        if bytes.equal(arg(args, n), "--ignore-compiler-rev") {
            ignore = true;
        } else if bytes.equal(arg(args, n), "--std-dir") && n + 1 < arg_count(args) {
            n = n + 1;
            std_dir = n;
        } else if bytes.equal(arg(args, n), "--cache") && n + 1 < arg_count(args) && len(arg(args, n + 1)) > 0 && lc.at(arg(args, n + 1), 0) == '/' {
            n = n + 1;
            cache_at = n;
        } else {
            var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), "`install` takes no argument but `--ignore-compiler-rev`, found `"), arg(args, n));
            m = buffer.push(heap, m, byte_of('`'));
            var said = 0;
            borrow m as &mb in {
                said = clibase.usage_error(heap, io, buffer.bytes(mb));
            }
            buffer.drop(heap, m);
            return said;
        }
        n = n + 1;
    }
    let project = load(heap, io, fs, exec, clock);
    let Project { records, root, file, status } = project;
    var result = status;
    if result == 0 {
        borrow records as &rb in {
            result = check_compiler(heap, io, buffer.bytes(rb), ignore);
            if result == 0 {
                borrow root as &rtb in {
                    let installed = install_for(heap, io, exec, clock, fs, buffer.bytes(rtb), buffer.bytes(rb), args, cache_at, std_dir);
                    let Installed { deps_files, outcome } = installed;
                    result = outcome;
                    buffer.drop(heap, deps_files);
                }
            }
        }
    }
    buffer.drop(heap, records);
    buffer.drop(heap, root);
    buffer.drop(heap, file);
    return result;
}

// ------------------------------------------------------------------------------------------------------------------------------------------ add ---

// The words of an `add` command line: where (in the arguments) the name, the url, `--rev`, `--ref`, `--path`, `--cache` and `--std-dir` values are (-1 if not given), how
// many words are not options, whether `--ignore-compiler-rev` was given, and `bad` (the status of a usage error that has been said).
pub res struct Adding {
    name_at: int,
    url_at: int,
    rev_at: int,
    ref_at: int,
    path_at: int,
    cache_at: int,
    std_dir: int,
    words: int,
    ignore: bool,
    bad: int,
}

fn add_arguments[&h, &i, &a](heap: &!h Heap, io: &!i Io, args: &a Args) -> [heap, err_write, args] Adding {
    var name_at = 0 - 1;
    var url_at = 0 - 1;
    var rev_at = 0 - 1;
    var ref_at = 0 - 1;
    var path_at = 0 - 1;
    var cache_at = 0 - 1;
    var std_dir = 0 - 1;
    var words = 0;
    var ignore = false;
    var bad = 0;
    var n = 2;
    while n < arg_count(args) && bad == 0 {
        let word = arg(args, n);
        let valued = bytes.equal(word, "--rev") || bytes.equal(word, "--ref") || bytes.equal(word, "--path") || bytes.equal(word, "--cache") || bytes.equal(word, "--std-dir");
        if bytes.equal(word, "--ignore-compiler-rev") {
            ignore = true;
        } else if valued && n + 1 >= arg_count(args) {
            var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 32), "`"), word);
            m = buffer.append(heap, m, "` needs a value");
            borrow m as &mb in {
                bad = clibase.usage_error(heap, io, buffer.bytes(mb));
            }
            buffer.drop(heap, m);
        } else if bytes.equal(word, "--rev") {
            n = n + 1;
            rev_at = n;
        } else if bytes.equal(word, "--ref") {
            n = n + 1;
            ref_at = n;
        } else if bytes.equal(word, "--path") {
            n = n + 1;
            path_at = n;
        } else if bytes.equal(word, "--cache") {
            n = n + 1;
            if len(arg(args, n)) == 0 || lc.at(arg(args, n), 0) != '/' {
                bad = clibase.usage_error(heap, io, "`--cache` needs an absolute directory");
            } else {
                cache_at = n;
            }
        } else if bytes.equal(word, "--std-dir") {
            n = n + 1;
            std_dir = n;
        } else if len(word) > 0 && lc.at(word, 0) == '-' {
            bad = clibase.unknown_option(heap, io, word);
        } else {
            if words == 0 {
                name_at = n;
            } else if words == 1 {
                url_at = n;
            }
            words = words + 1;
        }
        n = n + 1;
    }
    return Adding { name_at: name_at, url_at: url_at, rev_at: rev_at, ref_at: ref_at, path_at: path_at, cache_at: cache_at, std_dir: std_dir, words: words, ignore: ignore, bad: bad };
}

// Is there a dependency called `name` in the records?
fn has_dependency[&r, &n](recs: &r [byte], name: &n [byte]) -> [] bool {
    var at = 0;
    while at < len(recs) {
        if lc.at(recs, at) == 'D' {
            let from = at + 2;
            let to = projfile.field_end(recs, from, len(recs));
            if to - from == len(name) && bytes.equal(recs[from..to], name) {
                return true;
            }
        }
        at = after_record(recs, at);
    }
    return false;
}

// A quote, a backslash or a control character: nothing that would need escaping in the file.
fn needs_escape[&t](text: &t [byte]) -> [] bool {
    var at = 0;
    while at < len(text) {
        let c = lc.at(text, at);
        if c == '"' || c == 92 || c < 32 || c == 127 {
            return true;
        }
        at = at + 1;
    }
    return false;
}

// The stores a directory of a repository holds one level down, for the message of `add` that says the path was not one: `PATH/NAME`, each followed by a NUL, in order.
fn stores_below[&h, &f, &d, &p](heap: &!h Heap, fs: &f Fs(""), dir: &d [byte], shown: &p [byte]) -> [heap, fs_read(""), dir_read] buffer.Buffer {
    var found = buffer.empty(heap, 0);
    let names = walk.subdirectories(heap, fs, dir, buffer.empty(heap, 0));
    borrow names as &nb in {
        let all = buffer.bytes(nb);
        var at = 0;
        while at < len(all) {
            let end = projfile.field_end(all, at, len(all));
            let inner = cliorigin.joined(heap, dir, all[at..end]);
            borrow inner as &ib in {
                let manifest = cliorigin.joined(heap, buffer.bytes(ib), "manifest.json");
                borrow manifest as &mb in {
                    if is_file(fs, buffer.bytes(mb)) {
                        var trimmed = len(shown);
                        while trimmed > 0 && lc.at(shown, trimmed - 1) == '/' {
                            trimmed = trimmed - 1;
                        }
                        found = buffer.append(heap, buffer.append(heap, buffer.append(heap, buffer.append(heap, found, shown[0..trimmed]), "/"), all[at..end]), "\0");
                    }
                }
                buffer.drop(heap, manifest);
            }
            buffer.drop(heap, inner);
            at = end + 1;
        }
    }
    buffer.drop(heap, names);
    var ordered = buffer.empty(heap, 0);
    borrow found as &fb in {
        ordered = projfile.replaced(heap, ordered, projfile.sorted_paths(heap, buffer.bytes(fb)));
    }
    buffer.drop(heap, found);
    return ordered;
}

// The project loaded again and installed (after `add` wrote the file): 0, or what has been said.
fn reinstall[&h, &i, &x, &c, &f, &a](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), args: &a Args, cache_at: int, std_dir: int) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    let project = load(heap, io, fs, exec, clock);
    let Project { records, root, file, status } = project;
    var result = status;
    if result == 0 {
        borrow records as &rb in {
            borrow root as &rtb in {
                let installed = install_for(heap, io, exec, clock, fs, buffer.bytes(rtb), buffer.bytes(rb), args, cache_at, std_dir);
                let Installed { deps_files, outcome } = installed;
                result = outcome;
                buffer.drop(heap, deps_files);
            }
        }
    }
    buffer.drop(heap, records);
    buffer.drop(heap, root);
    buffer.drop(heap, file);
    return result;
}

// `add NAME GIT-URL [--rev HASH | --ref NAME] [--path DIR]` (`docs/package-system.md` section 8.3): a dependency added to the project. A `--ref` (default `HEAD`) is resolved
// once and the hash is what is written; the store is fetched and checked before the file is touched; the table is appended to `cancho.toml` (so that its comments survive) and
// the project installed, and the file is put back if the install fails.
pub fn add_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    let given = add_arguments(heap, io, args);
    let Adding { name_at, url_at, rev_at, ref_at, path_at, cache_at, std_dir, words, ignore, bad } = given;
    if bad != 0 {
        return bad;
    }
    if words != 2 {
        return clibase.usage_error(heap, io, "`add` needs a name and a git url: `cancho add <name> <git-url>`");
    }
    let name = arg(args, name_at);
    let url = arg(args, url_at);
    if !projfile.name_ok(name) {
        var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), "`"), name);
        m = buffer.append(heap, m, "` is not a dependency name (letters, digits, `-`, `_`, `.`)");
        var said = 0;
        borrow m as &mb in {
            said = clibase.usage_error(heap, io, buffer.bytes(mb));
        }
        buffer.drop(heap, m);
        return said;
    }
    let project = load(heap, io, fs, exec, clock);
    let Project { records, root, file, status } = project;
    var result = status;
    if result == 0 {
        borrow records as &rb in {
            result = check_compiler(heap, io, buffer.bytes(rb), ignore);
            if result == 0 && has_dependency(buffer.bytes(rb), name) {
                var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), "`cancho.toml` already has a dependency `"), name);
                m = buffer.append(heap, m, "`; edit its `rev` to move it");
                borrow m as &mb in {
                    say_error(heap, io, "", buffer.bytes(mb), "");
                }
                buffer.drop(heap, m);
                result = 1;
            }
        }
    }
    buffer.drop(heap, records);
    if result == 0 {
        borrow root as &rtb in {
            borrow file as &flb in {
                result = add_dependency(heap, io, exec, clock, fs, args, buffer.bytes(rtb), buffer.bytes(flb), name, url, rev_at, ref_at, path_at, cache_at, std_dir);
            }
        }
    }
    buffer.drop(heap, root);
    buffer.drop(heap, file);
    return result;
}

// The rest of `add`, once the project is known and the name is free.
fn add_dependency[&h, &i, &x, &c, &f, &a, &r, &p, &n, &u](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), args: &a Args, root: &r [byte], file: &p [byte], name: &n [byte], url: &u [byte], rev_at: int, ref_at: int, path_at: int, cache_at: int, std_dir: int) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    if rev_at >= 0 && ref_at >= 0 {
        return clibase.usage_error(heap, io, "give `--rev` or `--ref`, not both");
    }
    var rev = buffer.empty(heap, 0);
    if rev_at >= 0 {
        rev = buffer.append(heap, rev, arg(args, rev_at));
    } else {
        var reference = "HEAD";
        if ref_at >= 0 {
            reference = arg(args, ref_at);
        }
        let resolved = cliorigin.resolve_ref(heap, io, exec, clock, url, reference);
        let cliorigin.Step { said, failure } = resolved;
        var failed = false;
        borrow failure as &fb in {
            if buffer.size(fb) > 0 {
                say_error(heap, io, "", buffer.bytes(fb), "");
                failed = true;
            }
        }
        buffer.drop(heap, failure);
        if failed {
            buffer.drop(heap, said);
            buffer.drop(heap, rev);
            return 3;
        }
        borrow said as &sb in {
            console.write_all(io, reference);
            console.write_all(io, " is ");
            console.write_all(io, buffer.bytes(sb));
            console.write_all(io, "\n");
        }
        rev = projfile.replaced(heap, rev, said);
    }
    var path = ".cancho-vcs";
    if path_at >= 0 {
        path = arg(args, path_at);
    }
    var status = 0;
    if needs_escape(url) {
        status = clibase.usage_error(heap, io, "the git url cannot contain a quote, a backslash or a control character");
    } else if needs_escape(path) {
        status = clibase.usage_error(heap, io, "the path cannot contain a quote, a backslash or a control character");
    }
    if status == 0 {
        borrow rev as &rvb in {
            status = add_checked(heap, io, exec, clock, fs, args, root, file, name, url, buffer.bytes(rvb), path, cache_at, std_dir);
        }
    }
    buffer.drop(heap, rev);
    return status;
}

// The origin `url`, `rev`, `path` made a directory and checked to be a store, the dependency written and installed.
fn add_checked[&h, &i, &x, &c, &f, &a, &r, &p, &n, &u, &v, &q](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), args: &a Args, root: &r [byte], file: &p [byte], name: &n [byte], url: &u [byte], rev: &v [byte], path: &q [byte], cache_at: int, std_dir: int) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    let bad = cliorigin.invalid(heap, url, rev, path);
    var refused = false;
    borrow bad as &bb in {
        if buffer.size(bb) > 0 {
            say_error(heap, io, "", buffer.bytes(bb), "");
            refused = true;
        }
    }
    buffer.drop(heap, bad);
    if refused {
        return 1;
    }
    var cache_given = "";
    if cache_at >= 0 {
        cache_given = arg(args, cache_at);
    }
    let cache = cliorigin.cache_root(heap, io, exec, clock, cache_given);
    var outcome = 0;
    borrow cache as &cb in {
        let got = cliorigin.ensure(heap, io, exec, clock, fs, buffer.bytes(cb), url, rev, path);
        let cliorigin.Checkout { dir, why, status } = got;
        borrow why as &wb in {
            if buffer.size(wb) > 0 {
                say_error(heap, io, "", buffer.bytes(wb), "");
                outcome = 3;
            }
        }
        buffer.drop(heap, why);
        if outcome == 0 {
            borrow dir as &db in {
                outcome = add_written(heap, io, exec, clock, fs, args, root, file, name, url, rev, path, buffer.bytes(db), cache_at, std_dir);
            }
        }
        buffer.drop(heap, dir);
    }
    buffer.drop(heap, cache);
    return outcome;
}

// The store directory `store` of the origin checked to be one, the dependency appended to the file (which is put back if the install fails) and installed.
fn add_written[&h, &i, &x, &c, &f, &a, &r, &p, &n, &u, &v, &q, &s](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), args: &a Args, root: &r [byte], file: &p [byte], name: &n [byte], url: &u [byte], rev: &v [byte], path: &q [byte], store: &s [byte], cache_at: int, std_dir: int) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    let manifest = cliorigin.joined(heap, store, "manifest.json");
    var is_store = false;
    borrow manifest as &mb in {
        is_store = is_file(fs, buffer.bytes(mb));
    }
    buffer.drop(heap, manifest);
    if !is_store {
        var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 160), "`"), path);
        m = buffer.append(heap, buffer.append(heap, buffer.append(heap, m, "` in "), url), " is not a store");
        let stores = stores_below(heap, fs, store, path);
        borrow stores as &sb in {
            let all = buffer.bytes(sb);
            if len(all) > 0 {
                m = buffer.append(heap, m, "; it holds stores at: ");
                var at = 0;
                var first = true;
                while at < len(all) {
                    let end = projfile.field_end(all, at, len(all));
                    if !first {
                        m = buffer.append(heap, m, ", ");
                    }
                    m = buffer.append(heap, m, all[at..end]);
                    first = false;
                    at = end + 1;
                }
                m = buffer.append(heap, m, ". Pick one with --path");
            }
        }
        buffer.drop(heap, stores);
        borrow m as &mb in {
            say_error(heap, io, "", buffer.bytes(mb), "");
        }
        buffer.drop(heap, m);
        return 1;
    }
    let read = clibase.read_file(heap, fs, file);
    let clibase.Contents { bytes, failed } = read;
    if failed != 0 {
        buffer.drop(heap, bytes);
        say_error(heap, io, "cannot read `", file, "`");
        return 3;
    }
    var after = buffer.append(heap, buffer.empty(heap, 0), "");
    borrow bytes as &bb in {
        let before = buffer.bytes(bb);
        after = buffer.append(heap, after, before);
        if len(before) > 0 && lc.at(before, len(before) - 1) != 10 {
            after = buffer.push(heap, after, byte_of(10));
        }
    }
    after = buffer.append(heap, buffer.append(heap, buffer.append(heap, after, "\n[dependencies."), name), "]\ngit = \"");
    after = buffer.append(heap, buffer.append(heap, buffer.append(heap, after, url), "\"\nrev = \""), rev);
    after = buffer.append(heap, buffer.append(heap, buffer.append(heap, after, "\"\npath = \""), path), "\"\n");
    var wrote = false;
    borrow after as &ab in {
        wrote = filewrite.store(fs, file, buffer.bytes(ab)) == 0;
    }
    buffer.drop(heap, after);
    var result = 0;
    if !wrote {
        say_error(heap, io, "cannot write `", file, "`");
        result = 3;
    } else {
        result = reinstall(heap, io, exec, clock, fs, args, cache_at, std_dir);
        if result == 0 {
            console.write_all(io, "added ");
            console.write_all(io, name);
            console.write_all(io, " (");
            var short_end = len(rev);
            if short_end > 12 {
                short_end = 12;
            }
            console.write_all(io, rev[0..short_end]);
            console.write_all(io, ") to cancho.toml\n");
        } else {
            borrow bytes as &bb in {
                let put_back = filewrite.store(fs, file, buffer.bytes(bb));
            }
        }
    }
    buffer.drop(heap, bytes);
    return result;
}

// A program of the project built: the files `files` (names, each followed by a NUL) and the library if `with_std` (from the directory `std_path`) made into the executable at `out`
// by the compiler in cancho and `clang`. 0, or what has been said.
fn build_files[&h, &i, &a, &f, &x, &l, &s, &o, &k](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), files: &l [byte], with_std: bool, std_path: &s [byte], host_in: int, host_given: bool, out: &o [byte], clang: &k [byte]) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, exec("")] int {
    let loaded = cliprog.load_files(heap, io, fs, buffer.append(heap, buffer.empty(heap, len(files) + 1), files), with_std, std_path, "", "");
    let cliprog.Loaded { names, raw, laid, lens, count, read_status } = loaded;
    var status = read_status;
    if status == 0 {
        var host = host_in;
        if !host_given {
            var note = buffer.append(heap, buffer.append(heap, buffer.empty(heap, len(out) + 8), out), ".host");
            borrow note as &np in {
                host = cliprog.detect_host(heap, exec, fs, buffer.bytes(np));
            }
            buffer.drop(heap, note);
        }
        borrow raw as &r in {
            let built = driver.run_many(heap, io, buffer.bytes(r), 5, host);
            borrow built as &b in {
                borrow laid as &lt in {
                    borrow mut lens as &!lb in {
                        borrow names as &nm in {
                            status = clibase.report_check(heap, io, buffer.bytes(nm), buffer.bytes(lt), contents(lb), false, b.status, b.rule, b.from, b.to);
                        }
                    }
                }
                if status == 0 {
                    status = cliprog.make_binary(heap, io, args, fs, exec, buffer.bytes(b.ir), out, clang, false);
                }
            }
            driver.discard(heap, built);
        }
    }
    buffer.drop(heap, raw);
    buffer.drop(heap, laid);
    buffer.drop(heap, names);
    unbox_slice(heap, lens);
    return status;
}

// The directory `path` is in (`/a/b` for `/a/b/c`), made, with those above it, by `/bin/mkdir -p`. 0, or 3 (said).
fn make_parent[&h, &i, &x, &c, &p](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, path: &p [byte]) -> [heap, err_write, exec(""), clock, poll] int {
    var end = len(path);
    while end > 0 && lc.at(path, end - 1) != '/' {
        end = end - 1;
    }
    if end <= 1 {
        return 0;
    }
    var argv = buffer.append(heap, buffer.empty(heap, end + 8), "-p\0");
    argv = buffer.push(heap, buffer.append(heap, argv, path[0..end - 1]), byte_of(0));
    var status = 3;
    borrow argv as &ab in {
        let got = cliprog.run_capture(heap, io, exec, clock, "/bin/mkdir", "", buffer.bytes(ab));
        let cliprog.Captured { out, err, kind, value } = got;
        if kind == 0 && value == 0 {
            status = 0;
        } else {
            say_error(heap, io, "cannot create `", path[0..end - 1], "`");
        }
        buffer.drop(heap, out);
        buffer.drop(heap, err);
    }
    buffer.drop(heap, argv);
    return status;
}

// Does the project have a program (`kind` B) or a set of tests (`kind` T) named `name`, or, with a negative `name_len`, how many has it? (The count is the answer.)
fn count_of[&r, &n](recs: &r [byte], kind: int, name: &n [byte], named: bool) -> [] int {
    var count = 0;
    var at = 0;
    while at < len(recs) {
        if lc.at(recs, at) == kind {
            let ns = at + 2;
            let ne = projfile.field_end(recs, ns, len(recs));
            if !named || ne - ns == len(name) && lc.spells(recs, ns, ne, name) {
                count = count + 1;
            }
        }
        at = after_record(recs, at);
    }
    return count;
}

// `build` with no files (`docs/package-system.md` section 8.3): every program of the project (`--bin NAME` one), each built from its sources. A program that says `std = true`
// needs `--std-dir DIR` in this command line. 0, or the status of the first that failed.
pub fn build_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    let opts = options(heap, io, args, "--bin");
    let Options { ignore, only, std_dir, host, host_given, clang_at, cache_at, bad } = opts;
    if bad != 0 {
        return bad;
    }
    let project = load(heap, io, fs, exec, clock);
    let Project { records, root, file, status } = project;
    var result = status;
    var dep_files = buffer.empty(heap, 0);
    borrow records as &rb in {
        let recs = buffer.bytes(rb);
        if result == 0 {
            result = check_compiler(heap, io, recs, ignore);
        }
        if result == 0 && count_of(recs, 'B', "", false) == 0 {
            console.error_all(io, "`cancho.toml` has no [[bin]] to build\n");
            result = 1;
        }
        if result == 0 && only >= 0 && count_of(recs, 'B', arg(args, only), true) == 0 {
            say_error(heap, io, "`cancho.toml` has no [[bin]] named `", arg(args, only), "`");
            result = 1;
        }
        if result == 0 {
            borrow root as &rtb in {
                let installed = install_for(heap, io, exec, clock, fs, buffer.bytes(rtb), recs, args, cache_at, std_dir);
                let Installed { deps_files, outcome } = installed;
                result = outcome;
                dep_files = projfile.replaced(heap, dep_files, deps_files);
            }
        }
        var at = 0;
        while at < len(recs) && result == 0 {
            if lc.at(recs, at) == 'B' {
                let ns = at + 2;
                let ne = projfile.field_end(recs, ns, len(recs));
                let name = recs[ns..ne];
                let std_flag = lc.at(recs, ne + 1) == '1';
                let has_out = lc.at(recs, ne + 3) == '1';
                let out_at = ne + 5;
                let out_end = projfile.field_end(recs, out_at, len(recs));
                var stop = out_end;
                while stop < len(recs) && lc.at(recs, stop) != 2 {
                    stop = stop + 1;
                }
                let sources = recs[out_end + 1..stop];
                var wanted = only < 0;
                if only >= 0 {
                    wanted = bytes.equal(arg(args, only), name);
                }
                if wanted {
                    borrow root as &root_b in {
                        let found = sources_of(heap, io, fs, buffer.bytes(root_b), name, sources);
                        let Sources { listed, broken } = found;
                        if broken != 0 {
                            result = 1;
                        } else {
                            var entry = buffer.empty(heap, 0);
                            if has_out {
                                entry = buffer.append(heap, entry, recs[out_at..out_end]);
                            } else {
                                entry = buffer.append(heap, buffer.append(heap, entry, "build/"), name);
                            }
                            var out = buffer.empty(heap, 0);
                            borrow entry as &eb in {
                                buffer.drop(heap, out);
                                out = beneath(heap, buffer.bytes(root_b), buffer.bytes(eb));
                            }
                            buffer.drop(heap, entry);
                            borrow out as &ob in {
                                result = make_parent(heap, io, exec, clock, buffer.bytes(ob));
                                if result == 0 {
                                    var std_path = buffer.empty(heap, 0);
                                    if std_dir >= 0 {
                                        std_path = buffer.append(heap, std_path, arg(args, std_dir));
                                    }
                                    var clang = buffer.append(heap, buffer.empty(heap, 32), "/usr/bin/clang");
                                    if clang_at >= 0 {
                                        buffer.drop(heap, clang);
                                        clang = buffer.append(heap, buffer.empty(heap, 32), arg(args, clang_at));
                                    }
                                    var inputs = buffer.empty(heap, 0);
                                    borrow listed as &ib in {
                                        borrow dep_files as &dfb in {
                                            inputs = projfile.replaced(heap, inputs, buffer.append(heap, buffer.append(heap, buffer.empty(heap, buffer.size(ib) + buffer.size(dfb) + 1), buffer.bytes(ib)), buffer.bytes(dfb)));
                                        }
                                    }
                                    borrow inputs as &pb in {
                                        borrow std_path as &sb in {
                                            borrow clang as &kb in {
                                                result = build_files(heap, io, args, fs, exec, buffer.bytes(pb), std_flag, buffer.bytes(sb), host, host_given, buffer.bytes(ob), buffer.bytes(kb));
                                            }
                                        }
                                    }
                                    buffer.drop(heap, inputs);
                                    buffer.drop(heap, std_path);
                                    buffer.drop(heap, clang);
                                }
                                if result == 0 {
                                    console.write_all(io, "built ");
                                    console.write_all(io, buffer.bytes(ob));
                                    console.write_all(io, "\n");
                                }
                            }
                            buffer.drop(heap, out);
                        }
                        buffer.drop(heap, listed);
                    }
                }
            }
            at = after_record(recs, at);
        }
    }
    buffer.drop(heap, dep_files);
    buffer.drop(heap, records);
    buffer.drop(heap, root);
    buffer.drop(heap, file);
    return result;
}

// `test` with no files (`docs/package-system.md` section 8.3): every set of tests of the project (`--test NAME` one), each under a heading `== test NAME`. The sets all run; 0 if
// every one passed, else the status of the first that did not. A set that cannot be made ready (a source that is not there, a `std = true` with no `--std-dir`) is said and ends the run.
pub fn test_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    let opts = options(heap, io, args, "--test");
    let Options { ignore, only, std_dir, host, host_given, clang_at, cache_at, bad } = opts;
    if bad != 0 {
        return bad;
    }
    let project = load(heap, io, fs, exec, clock);
    let Project { records, root, file, status } = project;
    var result = status;
    var first = 0;
    var dep_files = buffer.empty(heap, 0);
    borrow records as &rb in {
        let recs = buffer.bytes(rb);
        if result == 0 {
            result = check_compiler(heap, io, recs, ignore);
        }
        if result == 0 && count_of(recs, 'T', "", false) == 0 {
            console.error_all(io, "`cancho.toml` has no [[test]] to run\n");
            result = 1;
        }
        if result == 0 && only >= 0 && count_of(recs, 'T', arg(args, only), true) == 0 {
            say_error(heap, io, "`cancho.toml` has no [[test]] named `", arg(args, only), "`");
            result = 1;
        }
        if result == 0 {
            borrow root as &rtb in {
                let installed = install_for(heap, io, exec, clock, fs, buffer.bytes(rtb), recs, args, cache_at, std_dir);
                let Installed { deps_files, outcome } = installed;
                result = outcome;
                dep_files = projfile.replaced(heap, dep_files, deps_files);
            }
        }
        var at = 0;
        while at < len(recs) && result == 0 {
            if lc.at(recs, at) == 'T' {
                let ns = at + 2;
                let ne = projfile.field_end(recs, ns, len(recs));
                let name = recs[ns..ne];
                let std_flag = lc.at(recs, ne + 1) == '1';
                var stop = ne + 3;
                while stop < len(recs) && lc.at(recs, stop) != 2 {
                    stop = stop + 1;
                }
                let sources = recs[ne + 3..stop];
                var wanted = only < 0;
                if only >= 0 {
                    wanted = bytes.equal(arg(args, only), name);
                }
                if wanted {
                    borrow root as &root_b in {
                        let found = sources_of(heap, io, fs, buffer.bytes(root_b), name, sources);
                        let Sources { listed, broken } = found;
                        if broken != 0 {
                            result = 1;
                        } else {
                            console.write_all(io, "== test ");
                            console.write_all(io, name);
                            console.write_all(io, "\n");
                            var std_path = buffer.empty(heap, 0);
                            if std_dir >= 0 {
                                std_path = buffer.append(heap, std_path, arg(args, std_dir));
                            }
                            var clang = buffer.append(heap, buffer.empty(heap, 32), "/usr/bin/clang");
                            if clang_at >= 0 {
                                buffer.drop(heap, clang);
                                clang = buffer.append(heap, buffer.empty(heap, 32), arg(args, clang_at));
                            }
                            var ran = 0;
                            var inputs = buffer.empty(heap, 0);
                            borrow listed as &ib in {
                                borrow dep_files as &dfb in {
                                    inputs = projfile.replaced(heap, inputs, buffer.append(heap, buffer.append(heap, buffer.empty(heap, buffer.size(ib) + buffer.size(dfb) + 1), buffer.bytes(ib)), buffer.bytes(dfb)));
                                }
                            }
                            borrow inputs as &pb in {
                                borrow std_path as &sb in {
                                    borrow clang as &kb in {
                                        ran = clitest.test_set(heap, io, args, fs, exec, clock, buffer.bytes(pb), std_flag, buffer.bytes(sb), host, host_given, buffer.bytes(kb));
                                    }
                                }
                            }
                            buffer.drop(heap, inputs);
                            buffer.drop(heap, std_path);
                            buffer.drop(heap, clang);
                            if ran != 0 && first == 0 {
                                first = ran;
                            }
                            if ran != 0 && ran != 4 {
                                result = ran;
                            }
                        }
                        buffer.drop(heap, listed);
                    }
                }
            }
            at = after_record(recs, at);
        }
    }
    buffer.drop(heap, dep_files);
    buffer.drop(heap, records);
    buffer.drop(heap, root);
    buffer.drop(heap, file);
    if result == 0 {
        return first;
    }
    return result;
}
