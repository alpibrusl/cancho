edition 9;
module selfhost.vcsstorectl;

// vcsstorectl.cho -- `vcsstore.cho` as a command, for checking it against a store the Rust command wrote and for the crash-free races of
// `examples/selfhost/test.sh` (`docs/vcs-native.md` section 6). Not a user command: `cancho vcs` is built on `vcsstore.cho`, not on this.
//
//   init DIR [BRANCH]                    make DIR/.cancho/vcs                        prints `created` or `exists`
//   put DIR KIND < FILE                  store the bytes of standard input           prints the id
//   get DIR KIND ID                      the object's bytes on standard output       (nothing else is printed)
//   status ROOT                          the working copy at ROOT against HEAD, as the `status` document
//   restore ROOT PATH                    make PATH of the working copy at ROOT what HEAD's tree has (`vcsworktree.materialize`), or delete it if the tree
//                                        has no such path (`vcsworktree.remove_path`); prints `ok`
//   head DIR                             the change HEAD is at (or `absent`)
//   resolve DIR REV                      the id a revision names: HEAD, @, an id or a prefix of one, a branch or tag, any of them with ~N
//   ref-read DIR NAME                    the id a ref holds                          prints the id, or `absent`
//   ref-cas DIR NAME EXPECT NEW NOTE NOW move a ref: EXPECT is `any`, `absent` or an id; NOW is the time in seconds
//
// DIR is the `.cancho/vcs` directory (the repository root for `init`). A refusal prints `refused TAG` and exits 1; an io failure `refused io ERRNO`, exit 3.

import std.io as console;
import std.buffer;
import std.bytes;
import selfhost.vcsobj;
import selfhost.vcsrepo;
import selfhost.vcsstatus;
import selfhost.vcsworktree;
import selfhost.vcsscan;
import selfhost.vcsstore;
import selfhost.lexcore as lc;

fn number[&t](text: &t [byte]) -> [] int {
    var n = 0;
    var i = 0;
    while i < len(text) {
        n = n * 10 + (int_of(text[i]) - 48);
        i = i + 1;
    }
    return n;
}

fn say_refusal[&i](io: &!i Io, status: int, errno: int) -> [io_write] int {
    console.write_all(io, "refused ");
    console.write_all(io, vcsstatus.tag(status));
    if status == 10 {
        console.write_all(io, " ");
        console.print_int(io, errno);
    }
    console.newline(io);
    if status == 10 {
        return 3;
    }
    return 1;
}

// What the command did with the answer of the store: the id or bytes it holds are printed (or written), the refusal said.
fn answered[&h, &i](heap: &!h Heap, io: &!i Io, done: vcsstore.Object, quiet: bool) -> [heap, io_write] int {
    let vcsstore.Object { bytes, status, errno } = done;
    var code = 0;
    if status == 0 {
        borrow bytes as &b in {
            if quiet {
                buffer.write(io, b);
            } else {
                buffer.write(io, b);
                console.newline(io);
            }
        }
    } else if status == 2 {
        console.write_all(io, "absent");
        console.newline(io);
        code = 0;
    } else {
        code = say_refusal(io, status, errno);
    }
    buffer.drop(heap, bytes);
    return code;
}

fn failed_answer[&h](heap: &!h Heap) -> [heap] vcsstore.Object {
    return vcsstore.Object { bytes: buffer.empty(heap, 0), status: 0, errno: 0 };
}

// `log DIR [--limit N] [REV]` and `show DIR [REV]`: the document, or the refusal document, as the Rust command prints them.
fn document[&h, &i, &a, &d, &s](heap: &!h Heap, io: &!i Io, args: &a Args, vcs: &d Dir, scratch: &!s [int], log: bool) -> [heap, io_write, args, dir_read, dir_write, file_read] int {
    var spec = "";
    var have = false;
    var limit = 0 - 1;
    var k = 3;
    while k < arg_count(args) {
        if bytes.equal(arg(args, k), "--limit") && k + 1 < arg_count(args) {
            limit = number(arg(args, k + 1));
            k = k + 2;
        } else {
            spec = arg(args, k);
            have = true;
            k = k + 1;
        }
    }
    var command = "show";
    var answer = failed_answer(heap);
    if log {
        command = "log";
        let (old, os, oe) = vcsstore.parts(answer);
        buffer.drop(heap, old);
        answer = vcsrepo.log_command(heap, vcs, scratch, spec, have, limit);
    } else {
        let (old, os, oe) = vcsstore.parts(answer);
        buffer.drop(heap, old);
        answer = vcsrepo.show_command(heap, vcs, scratch, spec);
    }
    let (doc, status, errno) = vcsstore.parts(answer);
    var code = 0;
    if status == 0 {
        borrow doc as &db in {
            buffer.write(io, db);
        }
    } else if status >= 18 && status <= 22 {
        borrow doc as &cb in {
            let refusal = vcsrepo.refusal_document(heap, command, status, spec, buffer.bytes(cb));
            borrow refusal as &rb in {
                buffer.write(io, rb);
            }
            buffer.drop(heap, refusal);
        }
        code = 1;
    } else {
        code = say_refusal(io, status, errno);
    }
    buffer.drop(heap, doc);
    return code;
}

// `status ROOT`: the status document of the working copy at ROOT (the store is ROOT/.cancho/vcs).
fn status_of[&h, &i, &r](heap: &!h Heap, io: &!i Io, root: &r Dir) -> [heap, io_write, dir_read, dir_write, file_read] int {
    var code = 0;
    match vcsstore.enter_vcs(root) {
        DirOpened::Ok(opened) => {
            var vcs = opened;
            let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
            borrow vcs as &vd in {
                borrow mut scratch as &!s in {
                    code = answered(heap, io, vcsstatus.status_command(heap, root, vd, contents(s)), true);
                }
            }
            unbox_slice(heap, scratch);
            dir_close(vcs);
        }
        DirOpened::Failed(e) => {
            code = say_refusal(io, 10, e);
        }
    }
    return code;
}

// `restore`, with HEAD's tree in `tree`: the entry `path` is written as the tree has it, or the path is deleted if the tree has none.
fn restore_entry[&h, &i, &r, &d, &s, &t, &p](heap: &!h Heap, io: &!i Io, root: &r Dir, vcs: &d Dir, scratch: &!s [int], tree: &t [byte], path: &p [byte]) -> [heap, io_write, dir_read, dir_write, dir_symlink, file_read, file_write] int {
    var at = 0;
    var found = 0 - 1;
    while at < len(tree) {
        let end = vcsscan.line_end(tree, at);
        if bytes.equal(tree[at + 72..end], path) {
            found = at;
        }
        at = end + 1;
    }
    var status = 0;
    var errno = 0;
    if found < 0 {
        let (s0, e0) = vcsworktree.remove_path(heap, root, path);
        status = s0;
        errno = e0;
    } else {
        var mode = 0;
        if bytes.equal(tree[found..found + 6], "100755") {
            mode = 1;
        } else if bytes.equal(tree[found..found + 6], "120000") {
            mode = 2;
        }
        let blob = vcsstore.get(heap, vcs, scratch, "blob", tree[found + 7..found + 71]);
        let (text, bs, be) = vcsstore.parts(blob);
        if bs != 0 {
            status = bs;
            errno = be;
        } else {
            borrow text as &tb in {
                let (s0, e0) = vcsworktree.materialize(heap, root, mode, path, buffer.bytes(tb));
                status = s0;
                errno = e0;
            }
        }
        buffer.drop(heap, text);
    }
    if status != 0 {
        return say_refusal(io, status, errno);
    }
    console.write_all(io, "ok");
    console.newline(io);
    return 0;
}

// `restore ROOT PATH`: HEAD's change, its tree, then `restore_entry`.
fn restore_path[&h, &i, &r, &p](heap: &!h Heap, io: &!i Io, root: &r Dir, path: &p [byte]) -> [heap, io_write, dir_read, dir_write, dir_symlink, file_read, file_write] int {
    var code = 0;
    match vcsstore.enter_vcs(root) {
        DirOpened::Ok(opened) => {
            var vcs = opened;
            let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
            borrow vcs as &vd in {
                borrow mut scratch as &!s in {
                    let head = vcsrepo.head_change(heap, vd);
                    let (change, hs, he) = vcsstore.parts(head);
                    if hs != 0 {
                        code = say_refusal(io, hs, he);
                    } else {
                        borrow change as &cb in {
                            let found = vcsrepo.tree_id_of(heap, vd, contents(s), buffer.bytes(cb));
                            let (tid, ts, te) = vcsstore.parts(found);
                            if ts != 0 {
                                code = say_refusal(io, ts, te);
                            } else {
                                borrow tid as &ib in {
                                    let read = vcsrepo.tree_text(heap, vd, contents(s), buffer.bytes(ib));
                                    let (tree, xs, xe) = vcsstore.parts(read);
                                    if xs != 0 {
                                        code = say_refusal(io, xs, xe);
                                    } else {
                                        borrow tree as &xb in {
                                            code = restore_entry(heap, io, root, vd, contents(s), buffer.bytes(xb), path);
                                        }
                                    }
                                    buffer.drop(heap, tree);
                                }
                            }
                            buffer.drop(heap, tid);
                        }
                    }
                    buffer.drop(heap, change);
                }
            }
            unbox_slice(heap, scratch);
            dir_close(vcs);
        }
        DirOpened::Failed(e) => {
            code = say_refusal(io, 10, e);
        }
    }
    return code;
}

fn command[&h, &i, &a, &d](heap: &!h Heap, io: &!i Io, args: &a Args, vcs: &d Dir) -> [heap, io_read, io_write, args, dir_read, dir_write, file_read, file_write] int {
    let verb = arg(args, 1);
    let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
    var code = 0;
    borrow mut scratch as &!s in {
        if bytes.equal(verb, "put") {
            let raw = lc.slurp(heap, io);
            borrow raw as &r in {
                code = answered(heap, io, vcsstore.put(heap, vcs, contents(s), arg(args, 3), buffer.bytes(r), 1), false);
            }
            buffer.drop(heap, raw);
        } else if bytes.equal(verb, "get") {
            code = answered(heap, io, vcsstore.get(heap, vcs, contents(s), arg(args, 3), arg(args, 4)), true);
        } else if bytes.equal(verb, "log") || bytes.equal(verb, "show") {
            code = document(heap, io, args, vcs, contents(s), bytes.equal(verb, "log"));
        } else if bytes.equal(verb, "head") {
            code = answered(heap, io, vcsrepo.head_change(heap, vcs), false);
        } else if bytes.equal(verb, "resolve") {
            code = answered(heap, io, vcsrepo.resolve(heap, vcs, contents(s), arg(args, 3)), false);
        } else if bytes.equal(verb, "ref-read") {
            code = answered(heap, io, vcsstore.read_ref(heap, vcs, arg(args, 3)), false);
        } else if bytes.equal(verb, "ref-cas") {
            var kind = vcsstore.expect_id();
            if bytes.equal(arg(args, 4), "any") {
                kind = vcsstore.expect_any();
            } else if bytes.equal(arg(args, 4), "absent") {
                kind = vcsstore.expect_absent();
            }
            code = answered(heap, io, vcsstore.update_ref(heap, vcs, arg(args, 3), kind, arg(args, 4), arg(args, 5), arg(args, 6), number(arg(args, 7))), false);
        } else {
            console.write_all(io, "usage: init|put|get|ref-read|ref-cas DIR ...");
            console.newline(io);
            code = 2;
        }
    }
    unbox_slice(heap, scratch);
    return code;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    release(tty);
    var code = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow fs as &f in {
                    if arg_count(a) < 3 {
                        console.write_all(i, "usage: init|put|get|ref-read|ref-cas DIR ...");
                        console.newline(i);
                        code = 2;
                    } else {
                        match open_dir(f, arg(a, 2)) {
                            DirOpened::Ok(opened) => {
                                var vcs = opened;
                                borrow vcs as &d in {
                                    if bytes.equal(arg(a, 1), "init") {
                                        var branch = "main";
                                        if arg_count(a) > 3 {
                                            branch = arg(a, 3);
                                        }
                                        let made = vcsstore.init(h, d, branch);
                                        let vcsstore.Object { bytes, status, errno } = made;
                                        buffer.drop(h, bytes);
                                        if status != 0 {
                                            code = say_refusal(i, status, errno);
                                        } else if errno == 1 {
                                            console.write_all(i, "created");
                                            console.newline(i);
                                        } else {
                                            console.write_all(i, "exists");
                                            console.newline(i);
                                        }
                                    } else if bytes.equal(arg(a, 1), "status") {
                                        code = status_of(h, i, d);
                                    } else if bytes.equal(arg(a, 1), "restore") && arg_count(a) > 3 {
                                        code = restore_path(h, i, d, arg(a, 3));
                                    } else {
                                        code = command(h, i, a, d);
                                    }
                                }
                                dir_close(vcs);
                            }
                            DirOpened::Failed(e) => {
                                console.write_all(i, "refused io ");
                                console.print_int(i, e);
                                console.newline(i);
                                code = 3;
                            }
                        }
                    }
                }
            }
        }
    }
    release(args);
    release(fs);
    release(heap);
    release(io);
    return code;
}
