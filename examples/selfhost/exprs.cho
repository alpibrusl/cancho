module selfhost.exprs;

// exprs.cho -- the expressions of a function body: what each comes to, its type and, in compile
// mode, the code for it (`emit.cho`).
//
// Split from `body.cho` for its length; see there for what the port checks.

import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.kinds;
import selfhost.rules;
import selfhost.pass1;
import selfhost.types;
import selfhost.emit;
import selfhost.fold;
import selfhost.floats;
import selfhost.floatcode;
import selfhost.codes;
import selfhost.threadcode;
import selfhost.externcode;
import selfhost.netcode;
import selfhost.lookup;
import selfhost.ex;
import selfhost.wordcode;
import selfhost.cryptocode;
import selfhost.instances;
import selfhost.scope;
import selfhost.prims;
import selfhost.builtins;
import selfhost.signatures;
import selfhost.effects;
import selfhost.tables;
import selfhost.atoms;
import selfhost.filecode;
import selfhost.narrowing;
import selfhost.allocs;

// ---------------------------------------------------------- expressions ---

pub fn expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    if emit.on(st) && !lookup.writes_code(st, id) {
        return ex.skip(st, from, to);
    }
    if ast.is_kind(st, id, kinds.NK::EInt) {
        return ex.constant(ast.get(st, id, 4));
    }
    if ast.is_kind(st, id, kinds.NK::EFloat) {
        var width = 3;
        if ast.get(st, id, 4) != 0 {
            width = 4;
        }
        // The `f32` suffix is edition 6's, and refused here and not in the parser, which does not
        // know the edition.
        if width == 4 && st[23] < 6 {
            ast.fail(st, rules.r_literal_form(), from, to);
            return ex.nothing();
        }
        if emit.on(st) {
            let bits = floats.literal_bits(st, text, from, to, width == 4);
            if !floats.literal_ok(st) {
                return ex.skip(st, from, to);
            }
            return ex.Ex { ty: width, known: true, value: bits, reg: 0 - 1, reg2: 0 - 1 };
        }
        return ex.plain(width);
    }
    if ast.is_kind(st, id, kinds.NK::EBool) {
        if emit.on(st) {
            return ex.Ex { ty: 5, known: true, value: ast.get(st, id, 4), reg: 0 - 1, reg2: 0 - 1 };
        }
        return ex.plain(5);
    }
    if ast.is_kind(st, id, kinds.NK::EStr) {
        // A literal is a shared slice of bytes in the `static` region.
        let literal = types.make_ref(st, false, types.static_region(), types.make_slice(st, 2));
        if emit.on(st) {
            let n = emit.string_constant(st, text, ast.get(st, id, 4));
            return ex.in_slice(literal, 0 - 2 - n, 0 - 1, st[59]);
        }
        return ex.plain(literal);
    }
    if ast.is_kind(st, id, kinds.NK::EName) {
        return atoms.name_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EIndex) {
        return index_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::ESlice) {
        return subslice_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EUnary) {
        return unary_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EBinary) {
        return binary_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::ECall) {
        return call_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EStructLit) {
        return struct_lit(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EField) {
        return field_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EVariant) {
        return variant_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EAllocSlice) {
        return alloc_slice_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EAlloc) {
        return alloc_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::ETuple) && emit.on(st) {
        return tuple_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::ETupleField) && emit.on(st) {
        return tuple_field_expr(st, text, id);
    }
    return ex.skip(st, from, to);
}

// `Enum::Variant(a, b)`: a value of a plain enum, each payload of the declared type.
pub fn variant_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let target = pass1.resolve_module(st, text, st[22], ast.get(st, id, 4));
    if target < 0 {
        ast.fail(st, rules.r_module_not_imported(), from, to);
        return ex.nothing();
    }
    let found = pass1.lookup(st, text, ast.get(st, id, 5), target, st[23]);
    if found < 0 {
        ast.fail(st, rules.r_not_an_enum(), from, to);
        return ex.nothing();
    }
    if found < pass1.user_base() {
        if emit.on(st) && builtins.prelude_arm_count(found) > 0 {
            return prelude_variant(st, text, id, found);
        }
        return ex.skip(st, from, to);
    }
    let item = found - pass1.user_base();
    if !ast.is_kind(st, item, kinds.NK::IEnum) {
        ast.fail(st, rules.r_not_an_enum(), from, to);
        return ex.nothing();
    }
    let variant = lookup.variant_named(st, text, item, ast.get(st, id, 6));
    if variant < 0 {
        ast.fail(st, rules.r_unknown_name(), from, to);
        return ex.nothing();
    }
    if target != st[22] && !pass1.def_public(st, found) {
        ast.fail(st, rules.r_not_public(), from, to);
        return ex.nothing();
    }
    if !emit.on(st) && !scope.enum_plain(st, item) {
        return ex.skip(st, from, to);
    }
    if ast.get(st, id, 8) != ast.get(st, variant, 6) {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return ex.nothing();
    }
    let nparams = pass1.count_params(st, ast.get(st, item, 7), false);
    if nparams > 0 {
        return variant_generic(st, text, id, item, variant, nparams);
    }
    let whole = types.make_named(st, item);
    if emit.on(st) && !scope.enum_codable(st, whole) {
        return ex.skip(st, from, to);
    }
    var acc = 0 - 1;
    if emit.on(st) {
        acc = emit.insert_at(st, whole, acc, 0, 1, true, emit.variant_position(st, item, variant), 0 - 1);
    }
    var arg = ast.get(st, id, 7);
    var want = ast.get(st, variant, 5);
    var left = ast.get(st, id, 8);
    var k = 0;
    while left > 0 && ast.ok(st) {
        let v = expr(st, text, arg);
        if ast.ok(st) {
            scope.expect(st, text, scope.node_val(st, want, whole), v.ty, ast.nstart(st, arg), ast.nend(st, arg));
            if emit.on(st) && ast.ok(st) {
                acc = ex.put(st, whole, acc, emit.payload_index(st, item, variant, k), scope.node_val(st, want, whole), v);
            }
        }
        arg = ast.next(st, arg);
        want = ast.next(st, want);
        left = left - 1;
        k = k + 1;
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    if emit.on(st) {
        return ex.in_reg(whole, acc);
    }
    return ex.plain(whole);
}

// `Option::Some(5)`, `Option::None`: a value of a declaration with type parameters. The parameters are variables
// that the payloads, or the type the context expects, solve; the code is written once they are, so up to four
// payloads are evaluated first. Only the code is written for it.
pub fn variant_generic[&s, &x](st: &!s [int], text: &x [byte], id: int, item: int, variant: int, nparams: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let count = ast.get(st, id, 8);
    if !emit.on(st) || nparams > 2 || count > 12 {
        return ex.skip(st, from, to);
    }
    let whole = types.fresh_named(st, item, nparams);
    let expected = types.hint(st);
    types.set_hint(st, 0);
    if expected != 0 && types.is_named(st, types.shallow(st, expected)) && types.named_item(st, types.shallow(st, expected)) == item {
        scope.expect(st, text, expected, whole, from, to);
    }
    // The payloads wait on the argument stack until the parameters are solved.
    let base = st[52];
    var arg = ast.get(st, id, 7);
    var want = ast.get(st, variant, 5);
    var k = 0;
    while k < count && ast.ok(st) {
        let v = expr(st, text, arg);
        if ast.ok(st) {
            scope.expect(st, text, scope.node_val(st, want, whole), v.ty, ast.nstart(st, arg), ast.nend(st, arg));
            emit.push_arg(st, v.ty, v.known, v.value, v.reg);
        }
        if types.is_slice_ref(st, v.ty) {
            return ex.skip(st, from, to);
        }
        arg = ast.next(st, arg);
        want = ast.next(st, want);
        k = k + 1;
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    if !scope.enum_codable(st, whole) && !instances.inferring(st) {
        return ex.skip(st, from, to);
    }
    var acc = emit.insert_at(st, whole, 0 - 1, 0, 1, true, emit.variant_position(st, item, variant), 0 - 1);
    want = ast.get(st, variant, 5);
    k = 0;
    while k < count {
        let at = st[51] + 4 * (base + k);
        acc = emit.insert_at(st, whole, acc, emit.payload_index(st, item, variant, k), scope.node_val(st, want, whole), st[at + 1] != 0, st[at + 2], st[at + 3]);
        want = ast.next(st, want);
        k = k + 1;
    }
    st[52] = base;
    return ex.in_reg(whole, acc);
}

// `alloc_slice[a](count, fill)`: `count` copies of `fill` in the arena `a`, a unique reference to a slice
// of them for as long as the block. The arena first, then the count, then the fill, which must be
// a value that copies: an arena frees memory and runs nothing.
pub fn alloc_slice_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let area = ast.get(st, id, 4);
    let count = ast.get(st, id, 5);
    let fill = ast.get(st, id, 6);
    var in_static = false;
    if pass1.is_word(st, text, area, "static") {
        if st[60] == 0 {
            ast.fail(st, rules.r_reference_escapes_region(), from, to);
            return ex.nothing();
        }
        in_static = true;
    }
    var arena = 0 - 1;
    if !in_static {
        arena = scope.arena_block(st, text, area);
    }
    if arena < 0 && !in_static {
        ast.fail(st, rules.r_region_not_in_scope(), from, to);
        return ex.nothing();
    }
    let c = expr(st, text, count);
    if ast.ok(st) {
        scope.expect(st, text, 1, c.ty, ast.nstart(st, count), ast.nend(st, count));
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    let f = expr(st, text, fill);
    if !ast.ok(st) {
        return ex.nothing();
    }
    return allocs.finish_slice(st, text, from, to, fill, arena, in_static, c, f);
}

// `narrow(cap, "prefix")` (1), `open_read` (2), `open_write` (3), `open_append` (4), `open_new` (5),
// `open_rw` (6), `exec_spawn` (7), `exec_spawn_in` (10), `exec_spawn_detached` (13), `exec_covers` (14), `fs_covers` (15), `exec_spawn_under` (16) and `exec_spawn_detached_under` (17): the
// builtins whose type or whose check is in the literal a capability was narrowed to (`filecode.capability_which` numbers them).
// In compile mode only.
pub fn capability_call[&s, &x](st: &!s [int], text: &x [byte], id: int, which: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let nargs = ast.get(st, id, 7);
    var arg = ast.get(st, id, 6);
    if which == 1 {
        if nargs < 2 {
            ast.fail(st, rules.r_arity_mismatch(), from, to);
            return ex.nothing();
        }
        if !narrowing.literals(st, arg, nargs) {
            return ex.nothing();
        }
        if nargs > 4 {
            return ex.skip(st, from, to);
        }
        let c = expr(st, text, arg);
        if !ast.ok(st) {
            return ex.nothing();
        }
        let lit = ast.next(st, arg);
        let verdict = narrowing.refused(st, text, c.ty, lit, nargs, from, to);
        if verdict == 1 {
            return ex.nothing();
        }
        if verdict == 2 {
            return ex.skip(st, from, to);
        }
        if !ast.is_kind(st, lit, kinds.NK::EStr) {
            return ex.skip(st, from, to);
        }
        let index = types.prelude_index(st, c.ty);
        let first = types.make_prelude_lit(st, index, ast.get(st, lit, 4));
        if nargs == 2 {
            return ex.in_reg(first, 0 - 1);
        }
        // Several literals: a tuple of the capabilities narrowed to each, which are nothing in the code.
        let second_lit = ast.next(st, lit);
        let second = types.make_prelude_lit(st, index, ast.get(st, second_lit, 4));
        if nargs == 3 {
            return ex.in_reg(types.make_pair(st, first, second), 0 - 1);
        }
        let third = types.make_prelude_lit(st, index, ast.get(st, ast.next(st, second_lit), 4));
        return ex.in_reg(types.make_triple(st, first, second, third), 0 - 1);
    }
    if which == 14 || which == 15 {
        // `exec_covers(exec, path)` and `fs_covers(fs, path)` (`docs/processes.md` 4.13): whether the path is under the
        // bound, by the rule the operations trap on (`cancho_path_covers`). Nothing is performed.
        if nargs != 2 {
            ast.fail(st, rules.r_arity_mismatch(), from, to);
            return ex.nothing();
        }
        let c = expr(st, text, arg);
        arg = ast.next(st, arg);
        let path = expr(st, text, arg);
        if !ast.ok(st) {
            return ex.nothing();
        }
        if !scope.slice_codable(st, path.ty) {
            return ex.skip(st, from, to);
        }
        ex.push_value(st, path);
        atoms.push_bound(st, text, c.ty, netcode.prelude_named(filecode.covered_capability(which)), from, to);
        return ex.in_reg(5, filecode.path_covers(st));
    }
    if which == 11 || which == 12 {
        // `fs_remove(fs, path)` and `fs_rename(fs, from, to)`: the paths under the prefix of the capability.
        if nargs != which - 9 {
            ast.fail(st, rules.r_arity_mismatch(), from, to);
            return ex.nothing();
        }
        let c = expr(st, text, arg);
        arg = ast.next(st, arg);
        let first = expr(st, text, arg);
        var second = ex.nothing();
        if which == 12 {
            second = expr(st, text, ast.next(st, arg));
        }
        if !ast.ok(st) {
            return ex.nothing();
        }
        if !scope.slice_codable(st, first.ty) || which == 12 && !scope.slice_codable(st, second.ty) {
            return ex.skip(st, from, to);
        }
        ex.push_value(st, first);
        if which == 12 {
            ex.push_value(st, second);
        }
        atoms.push_prefix(st, text, c.ty, netcode.prelude_named("Fs"), from, to);
        let v = filecode.on_path(st, which == 12);
        let done = types.make_prelude(st, netcode.prelude_named("Done"));
        return ex.in_reg(done, filecode.answer_enum(st, done, 0, v));
    }
    if which == 8 || which == 9 {
        // `fs_read(fs, path, into)` and `fs_write(fs, path, bytes)`: a file opened, read or written once and closed.
        if nargs != 3 {
            ast.fail(st, rules.r_arity_mismatch(), from, to);
            return ex.nothing();
        }
        let c = expr(st, text, arg);
        arg = ast.next(st, arg);
        let path = expr(st, text, arg);
        arg = ast.next(st, arg);
        let bytes = expr(st, text, arg);
        if !ast.ok(st) {
            return ex.nothing();
        }
        if !scope.slice_codable(st, path.ty) || !scope.slice_codable(st, bytes.ty) {
            return ex.skip(st, from, to);
        }
        ex.push_value(st, path);
        atoms.push_prefix(st, text, c.ty, netcode.prelude_named("Fs"), from, to);
        ex.push_value(st, bytes);
        return ex.in_reg(1, filecode.fs_once(st, which == 9));
    }
    if which <= 6 {
        if nargs != 2 {
            ast.fail(st, rules.r_arity_mismatch(), from, to);
            return ex.nothing();
        }
        let c = expr(st, text, arg);
        arg = ast.next(st, arg);
        let path = expr(st, text, arg);
        if !ast.ok(st) {
            return ex.nothing();
        }
        if !scope.slice_codable(st, path.ty) {
            return ex.skip(st, from, to);
        }
        ex.push_value(st, path);
        atoms.push_prefix(st, text, c.ty, netcode.prelude_named("Fs"), from, to);
        let v = filecode.open_path(st, which - 2);
        let opened = types.make_prelude(st, tables.prelude_opened());
        return ex.in_reg(opened, filecode.answer_enum(st, opened, 0, v));
    }
    var inside = 7;
    if filecode.in_dir(which) {
        inside = 8;
    }
    if nargs != inside {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return ex.nothing();
    }
    let c = expr(st, text, arg);
    arg = ast.next(st, arg);
    var dir = ex.nothing();
    if filecode.in_dir(which) {
        // `exec_spawn_in(exec, dir, ...)`: the child starts in the directory the handle is of.
        dir = expr(st, text, arg);
        if ast.ok(st) && !(types.is_ref(st, dir.ty) && types.is_prelude(st, types.ref_inner(st, dir.ty)) && types.prelude_index(st, types.ref_inner(st, dir.ty)) == netcode.prelude_named("Dir")) {
            // The directory is lent, not given.
            ast.fail(st, rules.r_type_mismatch(), ast.nstart(st, arg), ast.nend(st, arg));
            return ex.nothing();
        }
        arg = ast.next(st, arg);
    }
    let path = expr(st, text, arg);
    arg = ast.next(st, arg);
    let args = expr(st, text, arg);
    arg = ast.next(st, arg);
    let env = expr(st, text, arg);
    arg = ast.next(st, arg);
    let s0 = expr(st, text, arg);
    arg = ast.next(st, arg);
    let s1 = expr(st, text, arg);
    arg = ast.next(st, arg);
    let s2 = expr(st, text, arg);
    if !ast.ok(st) {
        return ex.nothing();
    }
    if !scope.slice_codable(st, path.ty) || !scope.slice_codable(st, args.ty) || !scope.slice_codable(st, env.ty) || !types.is_penum(st, s0.ty) || !types.is_penum(st, s1.ty) || !types.is_penum(st, s2.ty) {
        return ex.skip(st, from, to);
    }
    ex.push_value(st, path);
    if filecode.under(which) {
        atoms.push_under(st, text, c.ty, from, to);
    } else {
        atoms.push_prefix(st, text, c.ty, netcode.prelude_named("Exec"), from, to);
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    ex.push_value(st, args);
    ex.push_value(st, env);
    // Each stream: its tag, the end of a channel the child is given and the file it is given.
    let stdio = tables.prelude_stdio();
    let first = builtins.prelude_arm_first(stdio);
    var k = 0;
    while k < 3 {
        var one = s0;
        if k == 1 {
            one = s1;
        }
        if k == 2 {
            one = s2;
        }
        emit.push_arg(st, 1, false, 0, emit.extract_field(st, one.ty, one.reg, 0));
        emit.push_arg(st, 1, false, 0, emit.extract_field(st, one.ty, one.reg, emit.penum_payload_index(st, stdio, first + 1, 0)));
        emit.push_arg(st, 1, false, 0, emit.extract_field(st, one.ty, one.reg, emit.penum_payload_index(st, stdio, first + 2, 0)));
        k = k + 1;
    }
    if filecode.in_dir(which) {
        emit.push_arg(st, 7, false, 0, dir.reg);
    } else {
        emit.push_arg(st, 7, false, 0, 0 - 1);
    }
    // A child of `exec_spawn_detached` leads a session of its own, and is the act after which it can outlive the program.
    let detached = filecode.spawn_bits(which);
    if which == 13 || which == 17 {
        effects.perform_named(st, "exec_detached");
    }
    emit.push_arg(st, 1, true, detached, 0 - 1);
    let v = filecode.spawn_process(st);
    let spawned = types.make_prelude(st, tables.prelude_spawned());
    return ex.in_reg(spawned, filecode.answer_enum(st, spawned, 3, v));
}

// `box_slice(heap, count, fill)` (1), `unbox_slice(heap, box)` (2) and `contents(box_ref)` (3), of
// whole numbers, bytes and booleans: compile mode only, so a function that has one is not checked.
pub fn heap_call[&s, &x](st: &!s [int], text: &x [byte], id: int, which: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    var wanted = 3;
    if which == 2 || which == 4 || which == 5 {
        wanted = 2;
    }
    if which == 3 {
        wanted = 1;
    }
    if ast.get(st, id, 7) != wanted {
        return ex.skip(st, from, to);
    }
    var arg = ast.get(st, id, 6);
    if which == 3 {
        let r = expr(st, text, arg);
        if !ast.ok(st) {
            return ex.nothing();
        }
        if types.is_ref(st, r.ty) && types.is_box(st, types.ref_inner(st, r.ty)) {
            // One value on the heap: the box is a pointer in the slot the reference points at, and
            // the reference to what it holds is that pointer.
            let held = types.box_inner(st, types.ref_inner(st, r.ty));
            let p = emit.load_through(st, 7, r.reg);
            return ex.in_reg(types.make_ref(st, types.ref_unique(st, r.ty), types.ref_region(st, r.ty), held), p);
        }
        if !types.is_ref(st, r.ty) || !types.is_boxslice(st, types.ref_inner(st, r.ty)) || !scope.aggregate_codable(st, types.ref_inner(st, r.ty)) {
            return ex.skip(st, from, to);
        }
        let boxed = types.ref_inner(st, r.ty);
        let p = emit.heap_view(st, boxed, r.reg);
        let slice = types.make_ref(st, types.ref_unique(st, r.ty), types.ref_region(st, r.ty), types.make_slice(st, types.boxslice_element(st, boxed)));
        return ex.in_slice(slice, p, st[59], 0);
    }
    let h = expr(st, text, arg);
    if !ast.ok(st) {
        return ex.nothing();
    }
    if !atoms.is_heap_ref(st, h.ty) {
        // Allocating is reached through the uniquely borrowed `Heap` that authorises it.
        ast.fail(st, rules.r_capability_misused(), from, to);
        return ex.nothing();
    }
    arg = ast.next(st, arg);
    if which == 4 {
        // `box(heap, v)`: the value on the heap.
        let v = expr(st, text, arg);
        if !ast.ok(st) {
            return ex.nothing();
        }
        return allocs.finish_box(st, from, to, v);
    }
    if which == 5 {
        // `unbox(heap, b)`: the value the box holds, which is freed.
        let b = expr(st, text, arg);
        if !ast.ok(st) {
            return ex.nothing();
        }
        return allocs.finish_unbox(st, from, to, arg, b);
    }
    if which == 2 {
        let b = expr(st, text, arg);
        if !ast.ok(st) {
            return ex.nothing();
        }
        return allocs.finish_free(st, from, to, b);
    }
    let count = arg;
    let fill = ast.next(st, arg);
    let c = expr(st, text, count);
    if ast.ok(st) {
        scope.expect(st, text, 1, c.ty, ast.nstart(st, count), ast.nend(st, count));
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    let f = expr(st, text, fill);
    if !ast.ok(st) {
        return ex.nothing();
    }
    return allocs.finish_box_slice(st, from, to, fill, c, f);
}

// `Spawned::Ok(child)`, `Stdio::Null`: a value of a prelude enum, each payload of the type the arm names.
pub fn prelude_variant[&s, &x](st: &!s [int], text: &x [byte], id: int, index: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let arm = lookup.prelude_arm_named(st, text, index, ast.get(st, id, 6));
    if arm < 0 {
        ast.fail(st, rules.r_unknown_name(), from, to);
        return ex.nothing();
    }
    let whole = types.make_prelude(st, index);
    let at = builtins.arm_type_start(arm);
    if ast.get(st, id, 8) != builtins.field_type(at) {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return ex.nothing();
    }
    var acc = emit.insert_at(st, whole, 0 - 1, 0, 1, true, arm - builtins.prelude_arm_first(index), 0 - 1);
    var cursor = at + 1;
    var arg = ast.get(st, id, 7);
    var j = 0;
    while j < builtins.field_type(at) && ast.ok(st) {
        let param = prims.decode(st, true, cursor, 0 - 1, false);
        cursor = st[53];
        let v = expr(st, text, arg);
        if ast.ok(st) {
            if param == 0 {
                return ex.skip(st, from, to);
            }
            scope.expect(st, text, param, v.ty, ast.nstart(st, arg), ast.nend(st, arg));
            if ast.ok(st) && !types.is_erased(st, param) {
                acc = emit.insert_at(st, whole, acc, emit.penum_payload_index(st, index, arm, j), param, v.known, v.value, v.reg);
            }
        }
        arg = ast.next(st, arg);
        j = j + 1;
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    return ex.in_reg(whole, acc);
}

// `(a, b)`, `(a, b, c)` and tuples of up to eight parts: an aggregate of the parts, in the code. Parts that are slices
// of a tuple of more than three, or that have nothing in the code beside others that have, have no code.
pub fn tuple_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let n = ast.get(st, id, 5);
    if n < 2 {
        // `(e)` is grouping, and neither `(e,)` nor `()` is a tuple.
        ast.fail(st, rules.r_pattern_shape(), from, to);
        return ex.nothing();
    }
    if n > 8 {
        return ex.skip(st, from, to);
    }
    var a = ex.nothing();
    var b = ex.nothing();
    var c = ex.nothing();
    let first = st[52];
    var arg = ast.get(st, id, 4);
    var k = 0;
    while k < n && ast.ok(st) {
        let one = expr(st, text, arg);
        if n > 3 && ast.ok(st) {
            if types.is_slice_ref(st, one.ty) {
                return ex.skip(st, from, to);
            }
            emit.push_arg(st, one.ty, one.known, one.value, one.reg);
        }
        if k == 0 {
            a = one;
        } else if k == 1 {
            b = one;
        } else if k == 2 {
            c = one;
        }
        arg = ast.next(st, arg);
        k = k + 1;
    }
    if !ast.ok(st) {
        st[52] = first;
        return ex.nothing();
    }
    var whole = 0;
    if n > 3 {
        whole = types.make_many(st, n);
        k = 0;
        while k < n {
            types.set_part(st, whole, k, ex.pushed(st, n - k).ty);
            k = k + 1;
        }
    } else {
        var tc = 0;
        if n == 3 {
            tc = c.ty;
        }
        whole = types.make_tuple(st, n, a.ty, b.ty, tc);
    }
    if types.is_erased(st, whole) {
        st[52] = first;
        return ex.in_reg(whole, 0 - 1);
    }
    if !scope.tuple_codable(st, whole) {
        st[52] = first;
        return ex.skip(st, from, to);
    }
    var acc = 0 - 1;
    if n > 3 {
        k = 0;
        while k < n {
            let part = ex.pushed(st, n - k);
            acc = ex.put(st, whole, acc, k, part.ty, part);
            k = k + 1;
        }
        st[52] = first;
        return ex.in_reg(whole, acc);
    }
    acc = ex.put(st, whole, acc, 0, a.ty, a);
    acc = ex.put(st, whole, acc, 1, b.ty, b);
    if n == 3 {
        acc = ex.put(st, whole, acc, 2, c.ty, c);
    }
    return ex.in_reg(whole, acc);
}

// `t.0`: a part of a tuple; through a reference, a `val` one is copied out and a `res` one is borrowed.
pub fn tuple_field_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let b = expr(st, text, ast.get(st, id, 4));
    if !ast.ok(st) {
        return ex.nothing();
    }
    var held = b.ty;
    if types.is_ref(st, held) {
        held = types.ref_inner(st, held);
    } else if emit.on(st) && scope.is_res_type(st, held) {
        // A component cannot be read out of a value that must be ended.
        scope.note(st, rules.r_linear_value_taken_apart(), ast.nstart(st, ast.get(st, id, 4)), ast.nend(st, ast.get(st, id, 4)));
    }
    let k = ast.get(st, id, 5);
    if !types.is_tuple(st, held) {
        ast.fail(st, rules.r_not_a_tuple(), ast.nstart(st, ast.get(st, id, 4)), ast.nend(st, ast.get(st, id, 4)));
        return ex.nothing();
    }
    if k >= types.tuple_size(st, held) {
        ast.fail(st, rules.r_unknown_name(), from, to);
        return ex.nothing();
    }
    let pt = types.tuple_part(st, held, k);
    if types.is_erased(st, held) {
        return ex.in_reg(pt, 0 - 1);
    }
    if !scope.tuple_codable(st, held) {
        return ex.skip(st, from, to);
    }
    if types.is_ref(st, b.ty) {
        let address = emit.field_address(st, held, b.reg, k);
        if scope.is_res_type(st, pt) {
            return ex.in_reg(types.make_ref(st, types.ref_unique(st, b.ty), types.ref_region(st, b.ty), pt), address);
        }
        return ex.take_through(st, pt, address);
    }
    return ex.take(st, held, b.reg, k, pt);
}

// `alloc[a](v)`: a value stored in the arena `a`, a unique reference to it for as long as the block. The arena
// first, then the value, which must be one that copies.
pub fn alloc_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let area = ast.get(st, id, 4);
    let value = ast.get(st, id, 5);
    // Only the code is written for it: in the other modes it is, as it was, `SKIP`.
    if !emit.on(st) || pass1.is_word(st, text, area, "static") {
        return ex.skip(st, from, to);
    }
    let arena = scope.arena_block(st, text, area);
    if arena < 0 {
        ast.fail(st, rules.r_region_not_in_scope(), from, to);
        return ex.nothing();
    }
    let v = expr(st, text, value);
    if !ast.ok(st) {
        return ex.nothing();
    }
    if scope.is_res_type(st, v.ty) {
        // An arena reclaims memory and runs nothing: a linear obligation put in one would be dropped.
        ast.fail(st, rules.r_mode_bound_violated(), ast.nstart(st, value), ast.nend(st, value));
        return ex.nothing();
    }
    if types.is_erased(st, v.ty) || v.ty < 1 || types.is_slice_ref(st, v.ty) || !(v.ty <= 6 || scope.aggregate_codable(st, v.ty) || types.is_ref(st, v.ty)) {
        return ex.skip(st, from, to);
    }
    let result = types.make_ref(st, true, types.block_region(arena), v.ty);
    return ex.in_reg(result, emit.arena_value(st, arena, v.ty, v.known, v.value, v.reg));
}

// `Name { a: x, b: y }`: every field, once, in declaration order, each of the declared type.
pub fn struct_lit[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let target = pass1.resolve_module(st, text, st[22], ast.get(st, id, 4));
    if target < 0 {
        ast.fail(st, rules.r_module_not_imported(), from, to);
        return ex.nothing();
    }
    let found = pass1.lookup(st, text, ast.get(st, id, 5), target, st[23]);
    if found < 0 {
        ast.fail(st, rules.r_not_a_struct(), from, to);
        return ex.nothing();
    }
    if found < pass1.user_base() {
        if tables.prelude_capability(found) {
            // A capability or a handle has no literal form: authority comes from the `World` and from nowhere else.
            ast.fail(st, rules.r_capability_misused(), from, to);
            return ex.nothing();
        }
        return ex.skip(st, from, to);
    }
    let item = found - pass1.user_base();
    if !ast.is_kind(st, item, kinds.NK::IStruct) {
        ast.fail(st, rules.r_not_a_struct(), from, to);
        return ex.nothing();
    }
    if target != st[22] && !pass1.def_public(st, found) {
        ast.fail(st, rules.r_not_public(), from, to);
        return ex.nothing();
    }
    let nparams = pass1.count_params(st, ast.get(st, item, 7), false);
    if nparams > 0 {
        return struct_generic(st, text, id, item, nparams);
    }
    if !emit.on(st) && !scope.struct_plain(st, item) {
        return ex.skip(st, from, to);
    }
    if emit.on(st) && !scope.struct_codable(st, types.make_named(st, item)) {
        return ex.skip(st, from, to);
    }
    let first = ast.get(st, id, 6);
    var init = first;
    var previous = 0 - 1;
    var acc = 0 - 1;
    while init >= 0 && ast.ok(st) {
        let name = ast.get(st, init, 4);
        let value = ast.get(st, init, 5);
        let index = scope.field_index(st, text, item, name);
        if index < 0 {
            ast.fail(st, rules.r_unknown_name(), from, to);
        } else if lookup.given_before(st, text, first, init, name) {
            ast.fail(st, rules.r_duplicate_declaration(), from, to);
        } else if index < previous {
            ast.fail(st, rules.r_field_order(), ast.nstart(st, value), ast.nend(st, value));
        } else {
            previous = index;
            let v = expr(st, text, value);
            if ast.ok(st) {
                scope.expect(st, text, scope.field_type(st, types.make_named(st, item), index), v.ty, ast.nstart(st, value), ast.nend(st, value));
                if emit.on(st) && ast.ok(st) {
                    acc = ex.put(st, types.make_named(st, item), acc, index, scope.field_type(st, types.make_named(st, item), index), v);
                }
            }
        }
        init = ast.next(st, init);
    }
    var decl = ast.get(st, item, 8);
    while decl >= 0 && ast.ok(st) {
        if !lookup.given_before(st, text, first, 0 - 1, ast.get(st, decl, 4)) {
            ast.fail(st, rules.r_missing_field(), from, to);
        }
        decl = ast.next(st, decl);
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    if emit.on(st) {
        return ex.in_reg(types.make_named(st, item), acc);
    }
    return ex.plain(types.make_named(st, item));
}

// A struct literal of a declaration with type parameters: the parameters are variables the values, or the type
// expected, solve; up to four fields, all given, in the order declared. Without code, only the values are judged.
pub fn struct_generic[&s, &x](st: &!s [int], text: &x [byte], id: int, item: int, nparams: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    if nparams > 2 {
        return ex.skip(st, from, to);
    }
    let whole = types.fresh_named(st, item, nparams);
    let expected = types.hint(st);
    types.set_hint(st, 0);
    if expected != 0 && types.is_named(st, types.shallow(st, expected)) && types.named_item(st, types.shallow(st, expected)) == item {
        scope.expect(st, text, expected, whole, from, to);
    }
    let first = ast.get(st, id, 6);
    var init = first;
    var previous = 0 - 1;
    var count = 0;
    let base = st[52];
    while init >= 0 && ast.ok(st) {
        let name = ast.get(st, init, 4);
        let value = ast.get(st, init, 5);
        let index = scope.field_index(st, text, item, name);
        if index < 0 {
            ast.fail(st, rules.r_unknown_name(), from, to);
        } else if lookup.given_before(st, text, first, init, name) {
            ast.fail(st, rules.r_duplicate_declaration(), from, to);
        } else if index < previous {
            ast.fail(st, rules.r_field_order(), ast.nstart(st, value), ast.nend(st, value));
        } else if index > 15 {
            return ex.skip(st, from, to);
        } else {
            previous = index;
            let v = expr(st, text, value);
            if ast.ok(st) {
                scope.expect(st, text, scope.field_type(st, whole, index), v.ty, ast.nstart(st, value), ast.nend(st, value));
            }
            if types.is_slice_ref(st, v.ty) {
                return ex.skip(st, from, to);
            }
            if emit.on(st) {
                emit.push_arg(st, v.ty, v.known, v.value, v.reg);
            }
            count = count + 1;
        }
        init = ast.next(st, init);
    }
    var decl = ast.get(st, item, 8);
    while decl >= 0 && ast.ok(st) {
        if !lookup.given_before(st, text, first, 0 - 1, ast.get(st, decl, 4)) {
            ast.fail(st, rules.r_missing_field(), from, to);
        }
        decl = ast.next(st, decl);
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    if !emit.on(st) {
        return ex.plain(whole);
    }
    if !scope.struct_codable(st, whole) {
        return ex.skip(st, from, to);
    }
    var acc = 0 - 1;
    var index = 0;
    while index < count {
        let at = st[51] + 4 * (base + index);
        acc = emit.insert_field(st, whole, acc, index, st[at + 1] != 0, st[at + 2], st[at + 3]);
        index = index + 1;
    }
    st[52] = base;
    return ex.in_reg(whole, acc);
}

// `base.name`: a field of a struct, or of a reference to one, copied out.
pub fn field_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let base = ast.get(st, id, 4);
    let b = expr(st, text, base);
    if !ast.ok(st) {
        return ex.nothing();
    }
    var held = b.ty;
    if types.is_ref(st, held) {
        held = types.ref_inner(st, held);
    } else if emit.on(st) && scope.is_res_type(st, held) {
        // A field cannot be read out of a value that must be ended.
        scope.note(st, rules.r_linear_value_taken_apart(), ast.nstart(st, base), ast.nend(st, base));
    }
    if types.is_prelude(st, held) {
        return ex.skip(st, from, to);
    }
    if !types.is_named(st, held) {
        ast.fail(st, rules.r_unknown_name(), ast.nstart(st, base), ast.nend(st, base));
        return ex.nothing();
    }
    let item = types.named_item(st, held);
    if !ast.is_kind(st, item, kinds.NK::IStruct) {
        ast.fail(st, rules.r_match_on_a_non_enum(), ast.nstart(st, base), ast.nend(st, base));
        return ex.nothing();
    }
    let index = scope.field_index(st, text, item, ast.get(st, id, 5));
    if index < 0 {
        ast.fail(st, rules.r_unknown_name(), from, to);
        return ex.nothing();
    }
    if emit.on(st) {
        let ft = scope.field_type(st, held, index);
        if types.is_erased(st, ft) {
            if types.is_ref(st, b.ty) && types.is_prelude(st, ft) {
                // A capability held by a struct is borrowed through the reference to the struct.
                return ex.in_reg(types.make_ref(st, types.ref_unique(st, b.ty), types.ref_region(st, b.ty), ft), 0 - 1);
            }
            return ex.in_reg(ft, 0 - 1);
        }
        if !scope.struct_codable(st, held) {
            return ex.skip(st, from, to);
        }
        if types.is_ref(st, b.ty) {
            let address = emit.field_address(st, held, b.reg, index);
            if scope.is_res_type(st, ft) {
                // A field that must be consumed is not copied out of a reference: it is borrowed, for
                // as long as, and as uniquely as, the reference it was reached through.
                return ex.in_reg(types.make_ref(st, types.ref_unique(st, b.ty), types.ref_region(st, b.ty), ft), address);
            }
            return ex.take_through(st, ft, address);
        }
        return ex.take(st, held, b.reg, index, ft);
    }
    return ex.plain(scope.field_type(st, held, index));
}

pub fn unary_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let op = ast.get(st, id, 4);
    let operand_id = ast.get(st, id, 5);
    let operand = expr(st, text, operand_id);
    if !ast.ok(st) {
        return ex.nothing();
    }
    let of = ast.nstart(st, operand_id);
    let ot = ast.nend(st, operand_id);
    if op == 3 {
        // `*r`: what a reference points at, copied. A slice is not a value to copy.
        if !types.is_ref(st, operand.ty) {
            ast.fail(st, rules.r_not_a_reference(), of, ot);
            return ex.nothing();
        }
        if scope.is_res_type(st, types.ref_inner(st, operand.ty)) {
            // `*` would copy it and leave two values where one obligation is owed.
            ast.fail(st, rules.r_linear_value_taken_apart(), of, ot);
            return ex.nothing();
        }
        if types.is_slice(st, types.ref_inner(st, operand.ty)) || types.is_prelude(st, types.ref_inner(st, operand.ty)) {
            return ex.skip(st, from, to);
        }
        if emit.on(st) {
            let inner = types.ref_inner(st, operand.ty);
            if !types.is_plain(inner) && !scope.aggregate_codable(st, inner) {
                return ex.skip(st, from, to);
            }
            return ex.in_reg(inner, emit.load_through(st, inner, operand.reg));
        }
        return ex.plain(types.ref_inner(st, operand.ty));
    }
    if op == 0 {
        if operand.ty != 1 && operand.ty != 3 && operand.ty != 4 {
            ast.fail(st, rules.r_operator_type_mismatch(), of, ot);
            return ex.nothing();
        }
        if operand.known && operand.ty == 1 {
            if operand.value == fold.smallest() {
                ast.fail(st, rules.r_constant_traps(), from, to);
                return ex.nothing();
            }
            return ex.constant(0 - operand.value);
        }
        if emit.on(st) && operand.ty != 1 {
            return ex.in_reg(operand.ty, floatcode.float_negate(st, operand.ty, operand.known, operand.value, operand.reg));
        }
        if emit.on(st) {
            return ex.in_reg(operand.ty, emit.checked(st, 1, true, 0, 0 - 1, operand.known, operand.value, operand.reg));
        }
        return ex.plain(operand.ty);
    }
    if op == 1 {
        scope.expect(st, text, 5, operand.ty, of, ot);
        if emit.on(st) && ast.ok(st) {
            return ex.in_reg(5, emit.not(st, operand.known, operand.value, operand.reg));
        }
        return ex.plain(5);
    }
    scope.expect(st, text, 1, operand.ty, of, ot);
    if operand.known {
        return ex.constant(~operand.value);
    }
    if emit.on(st) && ast.ok(st) {
        return ex.in_reg(1, emit.bit_not(st, operand.known, operand.value, operand.reg));
    }
    return ex.plain(1);
}

pub fn binary_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let op = ast.get(st, id, 4);
    let lhs_id = ast.get(st, id, 5);
    let rhs_id = ast.get(st, id, 6);
    let lf = ast.nstart(st, lhs_id);
    let lt = ast.nend(st, lhs_id);
    let l = expr(st, text, lhs_id);
    if !ast.ok(st) {
        return ex.nothing();
    }
    // `&&` and `||` do not compute their right side when the left has decided: its code is written
    // between the two, in blocks of its own.
    var short = 0 - 1;
    if emit.on(st) && op <= 1 {
        short = emit.label(st);
        emit.short_begin(st, short, op == 0, l.known, l.value, l.reg);
    }
    let r = expr(st, text, rhs_id);
    if !ast.ok(st) {
        return ex.nothing();
    }
    var short_reg = 0 - 1;
    if short >= 0 {
        short_reg = emit.short_end(st, short, r.known, r.value, r.reg);
    }
    // Both sides agree first, then the operator says what it accepts. (Two function values are of one type, and no operator
    // accepts it.)
    if (op == 2 || op == 3) && (types.is_fnval(st, l.ty) || types.is_fnptr(st, l.ty)) && (types.is_fnval(st, r.ty) || types.is_fnptr(st, r.ty)) {
        ast.fail(st, rules.r_operator_type_mismatch(), lf, lt);
        return ex.nothing();
    }
    scope.expect(st, text, l.ty, r.ty, ast.nstart(st, rhs_id), ast.nend(st, rhs_id));
    if !ast.ok(st) {
        return ex.nothing();
    }
    let operand = l.ty;
    let arithmetic = operand == 1 || operand == 3 || operand == 4;
    if op >= 13 && op <= 16 {
        if !arithmetic {
            ast.fail(st, rules.r_operator_type_mismatch(), lf, lt);
            return ex.nothing();
        }
    }
    if op == 17 || op >= 8 && op <= 12 {
        scope.expect(st, text, 1, operand, lf, lt);
    }
    if op == 0 || op == 1 {
        scope.expect(st, text, 5, operand, lf, lt);
    }
    if op >= 4 && op <= 7 {
        if !arithmetic {
            ast.fail(st, rules.r_operator_type_mismatch(), lf, lt);
            return ex.nothing();
        }
    }
    // `==` and `!=` compare two scalars, and nothing else.
    if op == 2 || op == 3 {
        if (operand < 1 || operand > 5) && operand != 7 {
            ast.fail(st, rules.r_operator_type_mismatch(), lf, lt);
            return ex.nothing();
        }
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    // A comparison and a short-circuit answer a `bool`; the rest answer their operand.
    var result = operand;
    if op <= 7 {
        result = 5;
    }
    if l.known && r.known && operand == 1 {
        let f = fold.fold_int(op, l.value, r.value);
        if f.trapped {
            ast.fail(st, rules.r_constant_traps(), from, to);
            return ex.nothing();
        }
        if result == 1 {
            return ex.constant(f.value);
        }
    }
    if short_reg >= 0 {
        return ex.in_reg(5, short_reg);
    }
    if emit.on(st) {
        return ex.in_reg(result, atoms.binary_code(st, op, operand, l, r));
    }
    return ex.plain(result);
}

// `s[i]`: one element of a slice. The base is checked first, then the index.
pub fn index_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let base = ast.get(st, id, 4);
    let index = ast.get(st, id, 5);
    let b = expr(st, text, base);
    if !ast.ok(st) {
        return ex.nothing();
    }
    let e = scope.element(st, b.ty, ast.nstart(st, base), ast.nend(st, base));
    if !ast.ok(st) {
        return ex.nothing();
    }
    let i = expr(st, text, index);
    if ast.ok(st) {
        scope.expect(st, text, 1, i.ty, ast.nstart(st, index), ast.nend(st, index));
    }
    if emit.on(st) && ast.ok(st) {
        if !scope.element_ok(st, e) {
            return ex.skip(st, ast.nstart(st, id), ast.nend(st, id));
        }
        let address = emit.element_address(st, e, b.reg, b.reg2 < 0, b.value, b.reg2, i.known, i.value, i.reg);
        return ex.in_reg(e, emit.load_through(st, e, address));
    }
    return ex.plain(e);
}

// `s[a..b]`: a shorter run of the same slice, in the same region and as unique or shared.
pub fn subslice_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let base = ast.get(st, id, 4);
    let start = ast.get(st, id, 5);
    let end = ast.get(st, id, 6);
    let b = expr(st, text, base);
    if !ast.ok(st) {
        return ex.nothing();
    }
    let e = scope.element(st, b.ty, ast.nstart(st, base), ast.nend(st, base));
    if !ast.ok(st) {
        return ex.nothing();
    }
    let a = expr(st, text, start);
    if ast.ok(st) {
        scope.expect(st, text, 1, a.ty, ast.nstart(st, start), ast.nend(st, start));
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    let z = expr(st, text, end);
    if ast.ok(st) {
        scope.expect(st, text, 1, z.ty, ast.nstart(st, end), ast.nend(st, end));
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    let narrowed = types.make_ref(st, types.ref_unique(st, b.ty), types.ref_region(st, b.ty), types.make_slice(st, e));
    if emit.on(st) {
        if !scope.element_ok(st, e) {
            return ex.skip(st, ast.nstart(st, id), ast.nend(st, id));
        }
        let at = emit.subslice(st, e, b.reg, b.reg2 < 0, b.value, b.reg2, a.known, a.value, a.reg, z.known, z.value, z.reg);
        return ex.in_slice(narrowed, at, st[59], 0);
    }
    return ex.plain(narrowed);
}

// `len(s)`: how many elements a slice has.
pub fn len_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    if ast.get(st, id, 7) != 1 {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return ex.nothing();
    }
    let arg = ast.get(st, id, 6);
    let a = expr(st, text, arg);
    if ast.ok(st) {
        scope.element(st, a.ty, ast.nstart(st, arg), ast.nend(st, arg));
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    if emit.on(st) {
        if a.reg2 >= 0 {
            return ex.in_reg(1, a.reg2);
        }
        return ex.constant(a.value);
    }
    return ex.plain(1);
}

pub fn builtin_call[&s, &x](st: &!s [int], text: &x [byte], id: int, b: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let start = signatures.builtin_sig_start(b);
    if signatures.builtin_sig(start) != 0 || !effects.perform(st, b) {
        return ex.skip(st, from, to);
    }
    // The builtins code is written for so far: 1 `putchar`, 2 `write_bytes`, 3 `int_of`, 4 `byte_of`.
    var written = 0;
    if emit.on(st) {
        let at = ast.get(st, id, 5);
        written = codes.builtin_code(text, ast.tstart(st, at), ast.tend(st, at));
        if written == 0 {
            written = codes.word_code(text, ast.tstart(st, at), ast.tend(st, at));
        }
        if written == 0 {
            written = codes.crypto_code(text, ast.tstart(st, at), ast.tend(st, at));
        }
        if written == 0 {
            return ex.skip(st, from, to);
        }
        if written == 31 {
            // The null handle: a pointer that is not anywhere.
            return ex.in_reg(7, 0 - 1);
        }
    }
    var last = ex.nothing();
    var fresh = 0 - 1;
    var made = 0;
    while made < builtins.builtin_regions(b) {
        let r = types.fresh_region(st);
        if made == 0 {
            fresh = r;
        }
        made = made + 1;
    }
    let wanted = signatures.builtin_sig(start + 1);
    if wanted != ast.get(st, id, 7) {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return ex.nothing();
    }
    var cursor = start + 2;
    var arg = ast.get(st, id, 6);
    var k = 0;
    while k < wanted && ast.ok(st) {
        let param = prims.decode(st, false, cursor, fresh, false);
        cursor = st[53];
        let a = expr(st, text, arg);
        if ast.ok(st) {
            if param == 0 {
                ex.skip(st, from, to);
            } else {
                scope.expect(st, text, param, a.ty, ast.nstart(st, arg), ast.nend(st, arg));
                if written != 0 && written != 3 && written != 4 && (written < 18 || written >= 70) && written != 83 && written != 90 {
                    ex.push_value(st, a);
                }
                last = a;
            }
        }
        arg = ast.next(st, arg);
        k = k + 1;
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    var result = prims.decode(st, false, cursor, fresh, false);
    if result == 0 && written >= 73 && written <= 75 {
        // A pair of words.
        result = types.make_pair(st, 1, 1);
    }
    if result == 0 {
        return ex.skip(st, from, to);
    }
    if written == 1 {
        return ex.in_reg(result, emit.put_char(st));
    }
    if written == 2 {
        return ex.in_reg(result, emit.write_slice(st));
    }
    if written == 3 {
        return ex.in_reg(result, emit.widen(st, last.known, last.value, last.reg));
    }
    if written == 4 {
        if last.known && last.value >= 0 && last.value <= 255 {
            // A byte worked out in the text stays one, so `box_slice(heap, n, byte_of(0))` is `calloc`.
            return ex.Ex { ty: result, known: true, value: last.value, reg: 0 - 1, reg2: 0 - 1 };
        }
        return ex.in_reg(result, emit.truncate_to_byte(st, last.known, last.value, last.reg));
    }
    if written == 136 || written == 137 {
        // `child_pid(&child)` and `child_release(child)`: a thread of the runtime reaps a child that is let go.
        if written == 137 {
            st[55] = st[55] | 64;
            return ex.in_reg(result, filecode.let_go_child(st));
        }
        return ex.in_reg(result, filecode.pid_of_child(st));
    }
    if written >= 111 {
        // An operation on an open file: the count, or minus the errno, made into the enum the signature says.
        let v = filecode.on_handle(st, written);
        return ex.in_reg(result, filecode.answer_enum(st, result, ast.flag(written == 112), v));
    }
    if written >= 83 {
        st[55] = st[55] | 4;
        if written == 83 {
            return ex.in_reg(5, cryptocode.hardware(st));
        }
        if written == 89 {
            return ex.in_reg(1, cryptocode.tag(st, true));
        }
        if written == 90 {
            return ex.in_reg(5, cryptocode.hardware_sha(st));
        }
        if written == 91 || written == 92 {
            if written == 92 {
                return ex.constant(cryptocode.sha_block_words(st));
            }
            return ex.constant(cryptocode.sha_blocks(st));
        }
        var done = 0;
        if written == 84 {
            done = cryptocode.encrypt_block(st);
        } else if written == 85 {
            done = cryptocode.ctr32(st);
        } else if written == 86 {
            done = cryptocode.ghash_update(st);
        } else if written == 87 {
            done = cryptocode.ghash_powers(st);
        } else {
            done = cryptocode.tag(st, false);
        }
        return ex.constant(done);
    }
    if written >= 70 {
        return atoms.word_builtin(st, written, result);
    }
    if written >= 18 && written <= 30 {
        return ex.in_reg(result, floatcode.float_builtin(st, written, last.known, last.value, last.reg));
    }
    if written >= 5 && written <= 7 {
        return ex.in_reg(result, emit.plain_arith(st, written - 5));
    }
    if written == 8 {
        return ex.in_reg(result, emit.bulk_copy(st));
    }
    if written == 9 {
        return ex.in_reg(result, emit.find_byte(st));
    }
    if written == 10 {
        return ex.in_reg(result, emit.stdin_char(st));
    }
    if written == 11 {
        return ex.in_reg(result, emit.stderr_write(st));
    }
    if written == 12 {
        return ex.in_reg(result, filecode.command_count(st));
    }
    if written == 13 {
        let p = filecode.command_arg(st);
        return ex.in_slice(result, p, st[59], 0);
    }
    if written == 14 || written == 15 {
        let v = filecode.fd_transfer(st, written == 15);
        return ex.in_reg(result, filecode.answer_enum(st, result, written - 14, v));
    }
    if written == 16 {
        return ex.in_reg(result, filecode.fd_close(st));
    }
    if written == 17 {
        let v = filecode.wait_child(st);
        return ex.in_reg(result, filecode.answer_enum(st, result, 2, v));
    }
    return ex.plain(result);
}

// A call of a foreign function, in compile mode: its arguments against the declaration, then the call.
pub fn extern_call[&s, &x](st: &!s [int], text: &x [byte], id: int, it: int) -> [] ex.Ex {
    effects.mark_arg(st);
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let rk = externcode.return_kind(st, text, ast.get(st, it, 10));
    if rk == 0 {
        return ex.skip(st, from, to);
    }
    if ast.get(st, it, 8) != ast.get(st, id, 7) {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return ex.nothing();
    }
    let dp = ast.get(st, it, 6);
    var fresh = 0 - 1;
    var made = 0;
    while made < pass1.count_params(st, dp, true) {
        let r = types.fresh_region(st);
        if made == 0 {
            fresh = r;
        }
        made = made + 1;
    }
    var param = ast.get(st, it, 7);
    var arg = ast.get(st, id, 6);
    let first_arg = st[52];
    while param >= 0 && ast.ok(st) {
        let ty = ast.get(st, param, 5);
        let kind = externcode.param_kind(st, text, ty);
        if kind < 0 {
            return ex.skip(st, from, to);
        }
        let a = expr(st, text, arg);
        if ast.ok(st) {
            var expected = 7;
            if kind != 4 {
                expected = atoms.callee_type(st, text, ty, dp, fresh, 0 - 1);
            }
            scope.expect(st, text, expected, a.ty, ast.nstart(st, arg), ast.nend(st, arg));
        }
        if ast.ok(st) && kind == 3 {
            emit.push_arg(st, 2, false, 0, externcode.byte_of_bool(st, a.known, a.value, a.reg));
        } else if ast.ok(st) && kind == 5 {
            ex.push_value(st, a);
        } else if ast.ok(st) && kind > 0 {
            emit.push_arg(st, a.ty, a.known, a.value, a.reg);
        }
        param = ast.next(st, param);
        arg = ast.next(st, arg);
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    let answer = externcode.call(st, text, it, rk, st[52] - first_arg);
    if rk == 3 {
        return ex.in_reg(7, answer);
    }
    if rk == 4 {
        return ex.in_reg(5, answer);
    }
    return ex.in_reg(1, answer);
}

// The sockets and the clock (the numbers of `codes.net_code`, the shape of each in `netcode.cho`): the arguments are
// evaluated and pushed, the capability that was narrowed to a bound is the first of some and is not pushed, and the
// bound goes after the others.
pub fn net_call[&s, &x](st: &!s [int], text: &x [byte], id: int, number: int) -> [] ex.Ex {
    let which = netcode.canonical(number);
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let nargs = ast.get(st, id, 7);
    // `tcp_listen_on(net, host, port, backlog, flags)` is `tcp_listen` with the address of its literal.
    let listen_on = number == 128;
    var expected = netcode.arity(which);
    if listen_on {
        expected = expected + 1;
    }
    if nargs != expected {
        return ex.skip(st, from, to);
    }
    var host = 0;
    if netcode.needs_dirs(which) {
        st[55] = st[55] | 2;
    } else if which >= 122 && which <= 126 {
        st[55] = st[55] | 16;
    } else if which >= 119 && which <= 121 {
        st[55] = st[55] | 8;
    } else if which != 44 && which != 127 && which != 138 {
        // (`child_kill`, 127, and `child_kill_group`, 138, are in the runtime every module has.)
        st[55] = st[55] | 1;
    }
    let holds_bound = netcode.holds_bound(which);
    let leads = netcode.leading(which);
    var cap = 0;
    var arg = ast.get(st, id, 6);
    let first_arg = st[52];
    var k = 0;
    while k < nargs && ast.ok(st) {
        let a = expr(st, text, arg);
        if ast.ok(st) && k == 0 && leads {
            cap = a.ty;
        } else if ast.ok(st) && listen_on && k == 1 {
            // The address is a literal, so the authority report can say which one; and a dotted quad.
            if !ast.is_kind(st, arg, kinds.NK::EStr) {
                ast.fail(st, rules.r_listen_host(), ast.nstart(st, arg), ast.nend(st, arg));
                return ex.nothing();
            }
            host = netcode.ipv4(st, text, ast.get(st, arg, 4));
            if host < 0 {
                ast.fail(st, rules.r_listen_host(), ast.nstart(st, arg), ast.nend(st, arg));
                return ex.nothing();
            }
        } else if ast.ok(st) && !types.is_erased(st, a.ty) {
            ex.push_value(st, a);
        }
        arg = ast.next(st, arg);
        k = k + 1;
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    if narrowing.listen_refused(st, text, which, listen_on, cap, host, from, to) || narrowing.dial_refused(st, which, cap, from, to) {
        return ex.nothing();
    }
    if holds_bound {
        atoms.push_call_bound(st, text, cap, which, from, to);
    }
    if which == 119 {
        emit.push_arg(st, 1, true, netcode.signal_bits(st, text, cap), 0 - 1);
    }
    if which == 36 {
        // The address a listener binds (0, every interface, for `tcp_listen`).
        emit.push_arg(st, 1, true, host, 0 - 1);
    }
    netcode.extras(st, which);
    let n = st[52] - first_arg;
    if netcode.slots(which) == 0 {
        return ex.in_reg(1, netcode.call_int(st, netcode.function(which), n));
    }
    let index = netcode.prelude_named(netcode.enum_name(which));
    if index < 0 {
        return ex.skip(st, from, to);
    }
    let ty = types.make_prelude(st, index);
    return ex.in_reg(ty, netcode.answer(st, ty, netcode.slots(which), netcode.call_out(st, netcode.function(which), n)));
}

// `spawn(payload, f)` and `join(t)`. The payload and what `f` returns are one value each of no more than one
// pointer's worth: a whole number, a byte, a boolean, a reference, or a capability (nothing in the code).
pub fn thread_call[&s, &x](st: &!s [int], text: &x [byte], id: int, spawning: bool) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    var arg = ast.get(st, id, 6);
    if spawning {
        // Real concurrency entering the program's authority surface; `join` performs nothing of its own.
        effects.perform_named(st, "conc");
    }
    if !spawning {
        if ast.get(st, id, 7) != 1 {
            return ex.skip(st, from, to);
        }
        let t = expr(st, text, arg);
        if !ast.ok(st) {
            return ex.nothing();
        }
        if !types.is_thread(st, t.ty) {
            return ex.skip(st, from, to);
        }
        // Joining a handle named by a binding, or a `spawn` joined where it is made, ends its lease.
        if ast.is_kind(st, arg, kinds.NK::EName) && scope.find(st, text, ast.get(st, arg, 4)) >= 0 {
            scope.lease_join(st, scope.slot_of(st, scope.find(st, text, ast.get(st, arg, 4))));
        } else if ast.is_kind(st, arg, kinds.NK::ECall) {
            scope.lease_join_now(st);
        }
        let result = types.thread_result(st, t.ty);
        return ex.in_reg(result, threadcode.join_thread(st, result, t.reg));
    }
    if ast.get(st, id, 7) != 2 {
        return ex.skip(st, from, to);
    }
    let payload = expr(st, text, arg);
    if !ast.ok(st) {
        return ex.nothing();
    }
    arg = ast.next(st, arg);
    let f = expr(st, text, arg);
    if !ast.ok(st) {
        return ex.nothing();
    }
    if !types.is_fnval(st, f.ty) {
        return ex.skip(st, from, to);
    }
    let item = types.fnval_item(st, f.ty);
    // `body` only runs because this call caused it to: what its row says is performed here, less what the borrowed capabilities of
    // the function being checked already authorise (the Rust checker's `spawn`, `docs/threads.md` 2).
    effects.perform_call(st, text, item);
    let result = scope.lower_type(st, text, ast.get(st, item, 10), ast.get(st, item, 6), 0 - 1);
    let carried = types.is_erased(st, payload.ty) || types.is_ref(st, payload.ty) && !types.is_slice_ref(st, payload.ty) || payload.ty == 1 || payload.ty == 2 || payload.ty == 5 || types.is_handle(st, payload.ty);
    let returned = types.is_erased(st, result) || types.is_ref(st, result) && !types.is_slice_ref(st, result) || result == 1 || result == 2 || result == 5;
    if types.is_ref(st, payload.ty) && types.ref_unique(st, payload.ty) && ast.is_kind(st, ast.get(st, id, 6), kinds.NK::EName) && scope.find(st, text, ast.get(st, ast.get(st, id, 6), 4)) >= 0 {
        // A `&!` given to a thread is lent to it until the handle is joined.
        scope.lease_spawn(st, scope.find(st, text, ast.get(st, ast.get(st, id, 6), 4)), from, to);
    }
    if narrowing.cannot_cross(st, payload.ty) || narrowing.cannot_cross(st, result) {
        // More than one leaf: not something to give a real thread, or to take back from one, yet.
        ast.fail(st, rules.r_thread_payload_type(), from, to);
        return ex.nothing();
    }
    if !carried || !returned {
        return ex.skip(st, from, to);
    }
    return ex.in_reg(types.make_thread(st, payload.ty, result), threadcode.spawn_thread(st, payload.ty, payload.known, payload.value, payload.reg, f.reg));
}

pub fn call_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let qualifier = ast.get(st, id, 4);
    let callee = ast.get(st, id, 5);
    let nargs = ast.get(st, id, 7);
    // Only an unqualified name can be a local.
    if qualifier < 0 {
        let local = scope.find(st, text, callee);
        if local >= 0 {
            if emit.on(st) && types.is_fnval(st, scope.binding_type(st, local)) {
                // A function held in a name: the call is to the function it holds.
                scope.use_slot(st, local, from, to);
                return call_item(st, text, id, types.fnval_item(st, scope.binding_type(st, local)));
            }
            if emit.on(st) && types.is_fnptr(st, scope.binding_type(st, local)) {
                // A function held by its type: the call is through the pointer.
                scope.use_slot(st, local, from, to);
                return call_pointer(st, text, id, local);
            }
            ast.fail(st, rules.r_not_a_function(), from, to);
            return ex.nothing();
        }
    }
    let unit_of = st[22];
    let target = pass1.resolve_module(st, text, unit_of, qualifier);
    if target < 0 {
        ast.fail(st, rules.r_module_not_imported(), from, to);
        return ex.nothing();
    }
    // `len` is a builtin of every edition, and is checked before anything else is looked up.
    if pass1.is_word(st, text, callee, "len") {
        return len_expr(st, text, id);
    }
    // A builtin performs its labels whichever way the code for it is written below (the general path records them too,
    // and a label recorded twice is one).
    if emit.on(st) && qualifier < 0 {
        let named = prims.builtin_at(st, text, callee, st[23]);
        if named >= 0 {
            effects.perform(st, named);
        }
    }
    // `release(world)` ends a capability: no code, and `0` if the answer is wanted.
    if emit.on(st) && qualifier < 0 && pass1.is_word(st, text, callee, "release") {
        if nargs != 1 {
            return ex.skip(st, from, to);
        }
        let given = expr(st, text, ast.get(st, id, 6));
        if !ast.ok(st) {
            return ex.nothing();
        }
        if !types.is_prelude(st, given.ty) || !narrowing.released_only(st, types.prelude_index(st, given.ty)) {
            // It is not a capability, and so has nothing to release.
            ast.fail(st, rules.r_capability_misused(), ast.nstart(st, ast.get(st, id, 6)), ast.nend(st, ast.get(st, id, 6)));
            return ex.nothing();
        }
        return ex.constant(0);
    }
    // `split(world)`: the parts of the `World`, which are nothing in the code.
    if emit.on(st) && qualifier < 0 && pass1.is_word(st, text, callee, "split") {
        if nargs != 1 {
            return ex.skip(st, from, to);
        }
        let given = expr(st, text, ast.get(st, id, 6));
        if !ast.ok(st) {
            return ex.nothing();
        }
        if !types.is_prelude(st, given.ty) {
            return ex.skip(st, from, to);
        }
        return ex.in_reg(types.make_prelude(st, builtins.split_for(st[23])), 0 - 1);
    }
    // Capabilities narrowed by a literal, files and processes: only the code is written for them.
    if emit.on(st) && qualifier < 0 {
        let which = filecode.capability_which(st, text, callee);
        if which > 0 {
            return capability_call(st, text, id, which);
        }
    }
    // Threads: only the code is written for them, in compile mode.
    if emit.on(st) && qualifier < 0 {
        if pass1.is_word(st, text, callee, "spawn") {
            return thread_call(st, text, id, true);
        }
        if pass1.is_word(st, text, callee, "join") {
            return thread_call(st, text, id, false);
        }
    }
    // The heap: only the code is written for it, in compile mode; a `box_slice` is judged without it (a `res` fill is refused).
    if (emit.on(st) || pass1.is_word(st, text, callee, "box_slice")) && qualifier < 0 {
        if pass1.is_word(st, text, callee, "box_slice") {
            return heap_call(st, text, id, 1);
        }
        if pass1.is_word(st, text, callee, "unbox_slice") {
            return heap_call(st, text, id, 2);
        }
        if pass1.is_word(st, text, callee, "contents") {
            return heap_call(st, text, id, 3);
        }
        if pass1.is_word(st, text, callee, "box") {
            return heap_call(st, text, id, 4);
        }
        if pass1.is_word(st, text, callee, "unbox") {
            return heap_call(st, text, id, 5);
        }
    }
    // A builtin the file's edition can name comes first, then a foreign function: not checked.
    let known = prims.builtin_at(st, text, callee, st[23]);
    if known >= 0 {
        if emit.on(st) && codes.net_code(text, ast.tstart(st, callee), ast.tend(st, callee)) > 0 {
            return net_call(st, text, id, codes.net_code(text, ast.tstart(st, callee), ast.tend(st, callee)));
        }
        if emit.on(st) && ast.get(st, id, 7) == 1 && codes.word_code(text, ast.tstart(st, callee), ast.tend(st, callee)) >= 81 {
            // `fork_heap(parent)` and `fork_clock(clock)`: a new capability, which is nothing in the code.
            let parent = expr(st, text, ast.get(st, id, 6));
            if !ast.ok(st) {
                return ex.nothing();
            }
            if codes.word_code(text, ast.tstart(st, callee), ast.tend(st, callee)) == 81 && !atoms.is_heap_ref(st, parent.ty) {
                ast.fail(st, rules.r_capability_misused(), from, to);
                return ex.nothing();
            }
            var index = scope.heap_index();
            if codes.word_code(text, ast.tstart(st, callee), ast.tend(st, callee)) == 82 {
                // Nothing is performed: the Rust checker gives `fork_clock` no effect (`Builtin::effects`), and the parent already holds
                // the authority (`docs/parallelism.md` 9.1). Reading the clock is `clock_ms`, which performs `clock`.
                index = netcode.prelude_named("Clock");
            } else {
                effects.perform_named(st, "heap");
            }
            return ex.in_reg(types.make_prelude(st, index), 0 - 1);
        }
        return builtin_call(st, text, id, known);
    }
    var it = st[15];
    while it >= 0 {
        if ast.is_kind(st, it, kinds.NK::IExtern) && ast.get(st, it, 13) == target && ast.same(st, text, ast.get(st, it, 4), callee) {
            if emit.on(st) {
                return extern_call(st, text, id, it);
            }
            return ex.skip(st, from, to);
        }
        it = ast.next(st, it);
    }
    var found = 0 - 1;
    it = st[15];
    while it >= 0 && found < 0 {
        if ast.is_kind(st, it, kinds.NK::IFn) && ast.get(st, it, 13) == target && ast.same(st, text, ast.get(st, it, 4), callee) {
            found = it;
        }
        it = ast.next(st, it);
    }
    if found < 0 {
        ast.fail(st, rules.r_not_a_function(), from, to);
        return ex.nothing();
    }
    if target != unit_of && ast.get(st, found, 5) == 0 {
        ast.fail(st, rules.r_not_public(), from, to);
        return ex.nothing();
    }
    return call_item(st, text, id, found);
}

// The call `id` to the function `found`: its arguments against the signature, then the code.
// A reference a function lends, to a capability (a pointer to nothing in the code) or to a handle or another value
// it holds: a pointer.
fn lent[&s](st: &!s [int], ty: int) -> [] bool {
    return types.is_ref(st, ty) && !types.is_slice_ref(st, ty) && (types.is_erased(st, types.ref_inner(st, ty)) || types.is_handle(st, types.ref_inner(st, ty)));
}

// A call of the function in the name `local`, of type `fn(A, B) -> R`.
fn call_pointer[&s, &x](st: &!s [int], text: &x [byte], id: int, local: int) -> [] ex.Ex {
    effects.perform_pointer(st, text, local);
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let ty = scope.binding_type(st, local);
    let n = types.fnptr_count(st, ty);
    if ast.get(st, id, 7) != n {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return ex.nothing();
    }
    let first_arg = st[52];
    var arg = ast.get(st, id, 6);
    var k = 0;
    while k < n && ast.ok(st) {
        let a = expr(st, text, arg);
        if ast.ok(st) {
            scope.expect(st, text, types.fnptr_param(st, ty, k), a.ty, ast.nstart(st, arg), ast.nend(st, arg));
            if ast.ok(st) && !types.is_erased(st, a.ty) {
                ex.push_value(st, a);
            }
        }
        arg = ast.next(st, arg);
        k = k + 1;
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    let result = types.fnptr_ret(st, ty);
    if !types.is_plain(result) && !scope.aggregate_codable(st, result) && !scope.slice_codable(st, result) {
        return ex.skip(st, from, to);
    }
    let pointer = emit.load(st, ty, scope.slot_of(st, local));
    let answer = emit.call_pointer(st, pointer, result, st[52] - first_arg);
    if types.is_slice_ref(st, result) {
        return ex.in_slice(result, answer, st[59], 0);
    }
    return ex.in_reg(result, answer);
}

pub fn call_item[&s, &x](st: &!s [int], text: &x [byte], id: int, found: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let nargs = ast.get(st, id, 7);
    // A callee that is generic, declares effects, or has a type this slice does not handle.
    if !atoms.plain_function(st, text, found) {
        return ex.skip(st, from, to);
    }
    if emit.on(st) && pass1.count_params(st, ast.get(st, found, 6), false) > 2 {
        return ex.skip(st, from, to);
    }
    // What the callee's row says it performs, the caller performs.
    effects.perform_call(st, text, found);
    // Each type and region parameter of the callee is a variable here, which the arguments solve.
    let callee_dp = ast.get(st, found, 6);
    var tvars = 0 - 1;
    var tmade = 0;
    while tmade < pass1.count_params(st, callee_dp, false) {
        let v = types.fresh_tvar(st);
        if tmade == 0 {
            tvars = v;
        }
        tmade = tmade + 1;
    }
    var fresh = 0 - 1;
    var made = 0;
    while made < pass1.count_params(st, callee_dp, true) {
        let r = types.fresh_region(st);
        if made == 0 {
            fresh = r;
        }
        made = made + 1;
    }
    if ast.get(st, found, 8) != nargs {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return ex.nothing();
    }
    var param = ast.get(st, found, 7);
    var arg = ast.get(st, id, 6);
    let first_arg = st[52];
    while param >= 0 && ast.ok(st) {
        if emit.on(st) && tmade > 0 && ast.is_kind(st, arg, kinds.NK::EVariant) && lookup.pure(st, arg) {
            // `Option::None`, `Result::Err(e)` as an argument waits for the others to say what its type is: a mark
            // for it is pushed, and the value is written below.
            emit.push_arg(st, 0 - 7, false, param, arg);
        } else {
            if emit.on(st) && ast.is_kind(st, arg, kinds.NK::EVariant) {
                types.set_hint(st, atoms.callee_type(st, text, ast.get(st, param, 5), callee_dp, fresh, tvars));
            }
            let a = expr(st, text, arg);
            types.set_hint(st, 0);
            if ast.ok(st) {
                scope.expect(st, text, atoms.callee_type(st, text, ast.get(st, param, 5), callee_dp, fresh, tvars), a.ty, ast.nstart(st, arg), ast.nend(st, arg));
                if emit.on(st) && !types.is_erased(st, a.ty) {
                    ex.push_value(st, a);
                }
            }
        }
        param = ast.next(st, param);
        arg = ast.next(st, arg);
    }
    var slot = first_arg;
    while emit.on(st) && ast.ok(st) && slot < st[52] {
        let at = st[51] + 4 * slot;
        if st[at] == 0 - 7 {
            let waiting = st[at + 3];
            types.set_hint(st, atoms.callee_type(st, text, ast.get(st, st[at + 2], 5), callee_dp, fresh, tvars));
            let a = expr(st, text, waiting);
            types.set_hint(st, 0);
            if ast.ok(st) {
                scope.expect(st, text, atoms.callee_type(st, text, ast.get(st, st[at + 2], 5), callee_dp, fresh, tvars), a.ty, ast.nstart(st, waiting), ast.nend(st, waiting));
            }
            if ast.ok(st) && !types.is_erased(st, a.ty) {
                st[at] = a.ty;
                st[at + 1] = ast.flag(a.known);
                st[at + 2] = a.value;
                st[at + 3] = a.reg;
            } else {
                st[at] = 1;
                st[at + 1] = 1;
                st[at + 2] = 0;
                st[at + 3] = 0 - 1;
            }
        }
        slot = slot + 1;
    }
    // What the callee's `where` clauses demand of the regions the arguments solved.
    var k = 0;
    while ast.ok(st) && pass1.nth_outlive(st, callee_dp, k) >= 0 {
        let inner = pass1.nth_outlive(st, callee_dp, k);
        let got_inner = types.resolve_region(st, fresh + pass1.param_index(st, text, callee_dp, true, inner));
        let got_outer = types.resolve_region(st, fresh + pass1.param_index(st, text, callee_dp, true, inner + 2));
        if !types.outlives(st, text, got_outer, got_inner) {
            ast.fail(st, rules.r_reference_escapes_region(), from, to);
        }
        k = k + 1;
    }
    // Every type argument has to be settled by the arguments.
    var position = 0;
    while ast.ok(st) && position < tmade {
        if types.is_tvar(st, types.shallow(st, tvars + position)) {
            ast.fail(st, rules.r_ambiguous_type(), from, to);
        } else if pass1.param_bounded(st, callee_dp, position) && scope.is_res_type(st, types.resolve_type(st, tvars + position)) {
            // `T: val` promises the callee only works for copyable types, and the call site is where it is kept.
            ast.fail(st, rules.r_mode_bound_violated(), from, to);
        }
        position = position + 1;
    }
    if !ast.ok(st) {
        return ex.nothing();
    }
    let result = types.resolve_type(st, atoms.callee_type(st, text, ast.get(st, found, 10), callee_dp, fresh, tvars));
    if emit.on(st) {
        if !types.is_plain(result) && !scope.aggregate_codable(st, result) && !scope.slice_codable(st, result) && !lent(st, result) && !types.is_erased(st, result) {
            return ex.skip(st, from, to);
        }
        var inst = 0;
        if tmade > 0 {
            let made_at = instances.request(st, found, tvars, tmade);
            if made_at < 0 {
                return ex.skip(st, from, to);
            }
            inst = made_at + 1;
        }
        let answer = emit.call(st, found, inst, result, st[52] - first_arg);
        if types.is_slice_ref(st, result) {
            return ex.in_slice(result, answer, st[59], 0);
        }
        return ex.in_reg(result, answer);
    }
    return ex.plain(result);
}
