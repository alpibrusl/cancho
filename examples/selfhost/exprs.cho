module selfhost.exprs;

// exprs.cho -- the expressions of a function body: what each comes to, its type and, in compile
// mode, the code for it (`emit.cho`).
//
// Split from `body.cho` for its length; see there for what the port checks.

import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.kinds;
import selfhost.rules;
import selfhost.pass1;
import selfhost.types;
import selfhost.emit;
import selfhost.fold;
import selfhost.floats;
import selfhost.floatcode;
import selfhost.threadcode;
import selfhost.instances;
import selfhost.scope;
import selfhost.prims;
import selfhost.builtins;
import selfhost.signatures;
import selfhost.effects;
import selfhost.tables;

// What an expression came to: its type, and whether it is a known integer (a literal, or a
// literal operation that folded) and which.
pub struct Ex {
    ty: int,
    known: bool,
    value: int,
    reg: int,
    reg2: int,
}

pub fn plain(ty: int) -> [] Ex {
    return Ex { ty: ty, known: false, value: 0, reg: 0 - 1, reg2: 0 - 1 };
}

pub fn constant(value: int) -> [] Ex {
    return Ex { ty: 1, known: true, value: value, reg: 0 - 1, reg2: 0 - 1 };
}

pub fn nothing() -> [] Ex {
    return Ex { ty: 0, known: false, value: 0, reg: 0 - 1, reg2: 0 - 1 };
}

// A value in the temporary `reg` of the code being written.
pub fn in_reg(ty: int, reg: int) -> [] Ex {
    return Ex { ty: ty, known: false, value: 0, reg: reg, reg2: 0 - 1 };
}

// A reference to a slice in the code: the pointer (a temporary, or `-2 - n` for the global of a
// string literal) and the length, a temporary or, if `reg2` is -1, the constant `length`.
pub fn in_slice(ty: int, reg: int, reg2: int, length: int) -> [] Ex {
    return Ex { ty: ty, known: false, value: length, reg: reg, reg2: reg2 };
}

// The operands of a value that has been computed, pushed as arguments of a call: a slice is two.
pub fn push_value[&s](st: &!s [int], a: Ex) -> [] int {
    if types.is_slice_ref(st, a.ty) {
        return emit.push_slice(st, a.reg, a.reg2 < 0, a.value, a.reg2);
    }
    return emit.push_arg(st, a.ty, a.known, a.value, a.reg);
}

// Something the port does not check yet: the function's answer is `SKIP`.
pub fn skip[&s](st: &!s [int], from: int, to: int) -> [] Ex {
    ast.fail(st, rules.r_skip(), from, to);
    return nothing();
}

// ---------------------------------------------------------- expressions ---

pub fn expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    if emit.on(st) && !writes_code(st, id) {
        return skip(st, from, to);
    }
    if ast.is_kind(st, id, kinds.NK::EInt) {
        return constant(ast.get(st, id, 4));
    }
    if ast.is_kind(st, id, kinds.NK::EFloat) {
        var width = 3;
        if ast.get(st, id, 4) != 0 {
            width = 4;
        }
        // The `f32` suffix is edition 6's, and refused here and not in the parser, which does not
        // know the edition.
        if width == 4 && st[23] < 6 {
            ast.fail(st, rules.r_literal_form(), from, to);
            return nothing();
        }
        if emit.on(st) {
            let bits = floats.literal_bits(st, text, from, to, width == 4);
            if !floats.literal_ok(st) {
                return skip(st, from, to);
            }
            return Ex { ty: width, known: true, value: bits, reg: 0 - 1, reg2: 0 - 1 };
        }
        return plain(width);
    }
    if ast.is_kind(st, id, kinds.NK::EBool) {
        if emit.on(st) {
            return Ex { ty: 5, known: true, value: ast.get(st, id, 4), reg: 0 - 1, reg2: 0 - 1 };
        }
        return plain(5);
    }
    if ast.is_kind(st, id, kinds.NK::EStr) {
        // A literal is a shared slice of bytes in the `static` region.
        let literal = types.make_ref(st, false, types.static_region(), types.make_slice(st, 2));
        if emit.on(st) {
            let n = emit.string_constant(st, text, ast.get(st, id, 4));
            return in_slice(literal, 0 - 2 - n, 0 - 1, st[59]);
        }
        return plain(literal);
    }
    if ast.is_kind(st, id, kinds.NK::EName) {
        return name_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EIndex) {
        return index_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::ESlice) {
        return subslice_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EUnary) {
        return unary_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EBinary) {
        return binary_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::ECall) {
        return call_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EStructLit) {
        return struct_lit(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EField) {
        return field_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EVariant) {
        return variant_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EAllocSlice) {
        return alloc_slice_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::EAlloc) {
        return alloc_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::ETuple) && emit.on(st) {
        return tuple_expr(st, text, id);
    }
    if ast.is_kind(st, id, kinds.NK::ETupleField) && emit.on(st) {
        return tuple_field_expr(st, text, id);
    }
    return skip(st, from, to);
}

// `Enum::Variant(a, b)`: a value of a plain enum, each payload of the declared type.
pub fn variant_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let target = pass1.resolve_module(st, text, st[22], ast.get(st, id, 4));
    if target < 0 {
        ast.fail(st, rules.r_module_not_imported(), from, to);
        return nothing();
    }
    let found = pass1.lookup(st, text, ast.get(st, id, 5), target, st[23]);
    if found < 0 {
        ast.fail(st, rules.r_not_an_enum(), from, to);
        return nothing();
    }
    if found < pass1.user_base() {
        if emit.on(st) && builtins.prelude_arm_count(found) > 0 {
            return prelude_variant(st, text, id, found);
        }
        return skip(st, from, to);
    }
    let item = found - pass1.user_base();
    if !ast.is_kind(st, item, kinds.NK::IEnum) {
        ast.fail(st, rules.r_not_an_enum(), from, to);
        return nothing();
    }
    let variant = variant_named(st, text, item, ast.get(st, id, 6));
    if variant < 0 {
        ast.fail(st, rules.r_unknown_name(), from, to);
        return nothing();
    }
    if target != st[22] && !pass1.def_public(st, found) {
        ast.fail(st, rules.r_not_public(), from, to);
        return nothing();
    }
    if !emit.on(st) && !scope.enum_plain(st, item) {
        return skip(st, from, to);
    }
    if ast.get(st, id, 8) != ast.get(st, variant, 6) {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return nothing();
    }
    let nparams = pass1.count_params(st, ast.get(st, item, 7), false);
    if nparams > 0 {
        return variant_generic(st, text, id, item, variant, nparams);
    }
    let whole = types.make_named(st, item);
    if emit.on(st) && !scope.enum_codable(st, whole) {
        return skip(st, from, to);
    }
    var acc = 0 - 1;
    if emit.on(st) {
        acc = emit.insert_at(st, whole, acc, 0, 1, true, emit.variant_position(st, item, variant), 0 - 1);
    }
    var arg = ast.get(st, id, 7);
    var want = ast.get(st, variant, 5);
    var left = ast.get(st, id, 8);
    var k = 0;
    while left > 0 && ast.ok(st) {
        let v = expr(st, text, arg);
        if ast.ok(st) {
            scope.expect(st, text, scope.node_val(st, want, whole), v.ty, ast.nstart(st, arg), ast.nend(st, arg));
            if emit.on(st) && ast.ok(st) {
                acc = emit.insert_at(st, whole, acc, emit.payload_index(st, item, variant, k), scope.node_val(st, want, whole), v.known, v.value, v.reg);
            }
        }
        arg = ast.next(st, arg);
        want = ast.next(st, want);
        left = left - 1;
        k = k + 1;
    }
    if !ast.ok(st) {
        return nothing();
    }
    if emit.on(st) {
        return in_reg(whole, acc);
    }
    return plain(whole);
}

// `Option::Some(5)`, `Option::None`: a value of a declaration with type parameters. The parameters are variables
// that the payloads, or the type the context expects, solve; the code is written once they are, so up to four
// payloads are evaluated first. Only the code is written for it.
pub fn variant_generic[&s, &x](st: &!s [int], text: &x [byte], id: int, item: int, variant: int, nparams: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let count = ast.get(st, id, 8);
    if !emit.on(st) || nparams > 2 || count > 4 {
        return skip(st, from, to);
    }
    let whole = types.fresh_named(st, item, nparams);
    let expected = types.hint(st);
    types.set_hint(st, 0);
    if expected != 0 && types.is_named(st, types.shallow(st, expected)) && types.named_item(st, types.shallow(st, expected)) == item {
        scope.expect(st, text, expected, whole, from, to);
    }
    var e0 = nothing();
    var e1 = nothing();
    var e2 = nothing();
    var e3 = nothing();
    var arg = ast.get(st, id, 7);
    var want = ast.get(st, variant, 5);
    var k = 0;
    while k < count && ast.ok(st) {
        let v = expr(st, text, arg);
        if ast.ok(st) {
            scope.expect(st, text, scope.node_val(st, want, whole), v.ty, ast.nstart(st, arg), ast.nend(st, arg));
        }
        if k == 0 {
            e0 = v;
        } else if k == 1 {
            e1 = v;
        } else if k == 2 {
            e2 = v;
        } else {
            e3 = v;
        }
        arg = ast.next(st, arg);
        want = ast.next(st, want);
        k = k + 1;
    }
    if !ast.ok(st) {
        return nothing();
    }
    if !scope.enum_codable(st, whole) {
        return skip(st, from, to);
    }
    var acc = emit.insert_at(st, whole, 0 - 1, 0, 1, true, emit.variant_position(st, item, variant), 0 - 1);
    want = ast.get(st, variant, 5);
    k = 0;
    while k < count {
        var v = e0;
        if k == 1 {
            v = e1;
        } else if k == 2 {
            v = e2;
        } else if k == 3 {
            v = e3;
        }
        acc = emit.insert_at(st, whole, acc, emit.payload_index(st, item, variant, k), scope.node_val(st, want, whole), v.known, v.value, v.reg);
        want = ast.next(st, want);
        k = k + 1;
    }
    return in_reg(whole, acc);
}

// `alloc_slice[a](count, fill)`: `count` copies of `fill` in the arena `a`, a unique reference to a slice
// of them for as long as the block. The arena first, then the count, then the fill, which must be
// a value that copies: an arena frees memory and runs nothing.
pub fn alloc_slice_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let area = ast.get(st, id, 4);
    let count = ast.get(st, id, 5);
    let fill = ast.get(st, id, 6);
    var in_static = false;
    if pass1.is_word(st, text, area, "static") {
        if st[60] == 0 {
            ast.fail(st, rules.r_reference_escapes_region(), from, to);
            return nothing();
        }
        in_static = true;
    }
    var arena = 0 - 1;
    if !in_static {
        arena = scope.arena_block(st, text, area);
    }
    if arena < 0 && !in_static {
        ast.fail(st, rules.r_region_not_in_scope(), from, to);
        return nothing();
    }
    let c = expr(st, text, count);
    if ast.ok(st) {
        scope.expect(st, text, 1, c.ty, ast.nstart(st, count), ast.nend(st, count));
    }
    if !ast.ok(st) {
        return nothing();
    }
    let f = expr(st, text, fill);
    if !ast.ok(st) {
        return nothing();
    }
    if types.is_prelude(st, f.ty) {
        if tables.prelude_res(types.prelude_index(st, f.ty)) != 0 {
            ast.fail(st, rules.r_mode_bound_violated(), ast.nstart(st, fill), ast.nend(st, fill));
            return nothing();
        }
        return skip(st, from, to);
    }
    if f.ty < 1 || f.ty > 6 && !types.is_named(st, f.ty) && !types.is_ref(st, f.ty) {
        return skip(st, from, to);
    }
    var home = types.static_region();
    if !in_static {
        home = types.block_region(arena);
    }
    let result = types.make_ref(st, true, home, types.make_slice(st, f.ty));
    if emit.on(st) {
        if !types.is_plain(f.ty) {
            return skip(st, from, to);
        }
        var p = 0;
        if in_static {
            p = emit.heap_run(st, f.ty, c.known, c.value, c.reg, f.known, f.value, f.reg);
        } else {
            p = emit.alloc_slice(st, arena, f.ty, c.known, c.value, c.reg, f.known, f.value, f.reg);
        }
        if c.known {
            return in_slice(result, p, 0 - 1, c.value);
        }
        return in_slice(result, p, c.reg, 0);
    }
    return plain(result);
}

// The prefix a capability was narrowed to, as the pointer and the length of its literal pushed on the stack
// of arguments; a capability that was not narrowed is a null and 0, which every path is under.
fn push_prefix[&s, &x](st: &!s [int], text: &x [byte], cap: int) -> [] int {
    var inner = cap;
    if types.is_ref(st, inner) {
        inner = types.ref_inner(st, inner);
    }
    let tok = types.prelude_lit_tok(st, inner);
    if tok < 0 {
        emit.push_arg(st, 7, false, 0, 0 - 1);
        emit.push_arg(st, 1, true, 0, 0 - 1);
        return 0;
    }
    let n = emit.string_constant(st, text, tok);
    emit.push_arg(st, 7, false, 0, 0 - 2 - n);
    emit.push_arg(st, 1, true, st[59], 0 - 1);
    return 0;
}

// `narrow(cap, "prefix")` (1), `open_read` (2), `open_write` (3), `open_append` (4), `open_new` (5),
// `open_rw` (6) and `exec_spawn` (7): the builtins whose type or whose check is in the literal a capability
// was narrowed to. In compile mode only.
pub fn capability_call[&s, &x](st: &!s [int], text: &x [byte], id: int, which: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let nargs = ast.get(st, id, 7);
    var arg = ast.get(st, id, 6);
    if which == 1 {
        if nargs < 2 || nargs > 4 {
            return skip(st, from, to);
        }
        let c = expr(st, text, arg);
        if !ast.ok(st) {
            return nothing();
        }
        let lit = ast.next(st, arg);
        if !types.is_prelude(st, c.ty) || !ast.is_kind(st, lit, kinds.NK::EStr) {
            return skip(st, from, to);
        }
        let index = types.prelude_index(st, c.ty);
        let first = types.make_prelude_lit(st, index, ast.get(st, lit, 4));
        if nargs == 2 {
            return in_reg(first, 0 - 1);
        }
        // Several literals: a tuple of the capabilities narrowed to each, which are nothing in the code.
        let second_lit = ast.next(st, lit);
        let second = types.make_prelude_lit(st, index, ast.get(st, second_lit, 4));
        if nargs == 3 {
            return in_reg(types.make_pair(st, first, second), 0 - 1);
        }
        let third = types.make_prelude_lit(st, index, ast.get(st, ast.next(st, second_lit), 4));
        return in_reg(types.make_triple(st, first, second, third), 0 - 1);
    }
    if which == 8 || which == 9 {
        // `fs_read(fs, path, into)` and `fs_write(fs, path, bytes)`: a file opened, read or written once and closed.
        if nargs != 3 {
            return skip(st, from, to);
        }
        let c = expr(st, text, arg);
        arg = ast.next(st, arg);
        let path = expr(st, text, arg);
        arg = ast.next(st, arg);
        let bytes = expr(st, text, arg);
        if !ast.ok(st) {
            return nothing();
        }
        if !scope.slice_codable(st, path.ty) || !scope.slice_codable(st, bytes.ty) {
            return skip(st, from, to);
        }
        push_value(st, path);
        push_prefix(st, text, c.ty);
        push_value(st, bytes);
        return in_reg(1, emit.fs_once(st, which == 9));
    }
    if which <= 6 {
        if nargs != 2 {
            return skip(st, from, to);
        }
        let c = expr(st, text, arg);
        arg = ast.next(st, arg);
        let path = expr(st, text, arg);
        if !ast.ok(st) {
            return nothing();
        }
        if !scope.slice_codable(st, path.ty) {
            return skip(st, from, to);
        }
        push_value(st, path);
        push_prefix(st, text, c.ty);
        let v = emit.open_path(st, which - 2);
        let opened = types.make_prelude(st, tables.prelude_opened());
        return in_reg(opened, emit.answer_enum(st, opened, 0, v));
    }
    if nargs != 7 {
        return skip(st, from, to);
    }
    let c = expr(st, text, arg);
    arg = ast.next(st, arg);
    let path = expr(st, text, arg);
    arg = ast.next(st, arg);
    let args = expr(st, text, arg);
    arg = ast.next(st, arg);
    let env = expr(st, text, arg);
    arg = ast.next(st, arg);
    let s0 = expr(st, text, arg);
    arg = ast.next(st, arg);
    let s1 = expr(st, text, arg);
    arg = ast.next(st, arg);
    let s2 = expr(st, text, arg);
    if !ast.ok(st) {
        return nothing();
    }
    if !scope.slice_codable(st, path.ty) || !scope.slice_codable(st, args.ty) || !scope.slice_codable(st, env.ty) || !types.is_penum(st, s0.ty) || !types.is_penum(st, s1.ty) || !types.is_penum(st, s2.ty) {
        return skip(st, from, to);
    }
    push_value(st, path);
    push_prefix(st, text, c.ty);
    push_value(st, args);
    push_value(st, env);
    // Each stream: its tag, the end of a channel the child is given and the file it is given.
    let stdio = tables.prelude_stdio();
    let first = builtins.prelude_arm_first(stdio);
    var k = 0;
    while k < 3 {
        var one = s0;
        if k == 1 {
            one = s1;
        }
        if k == 2 {
            one = s2;
        }
        emit.push_arg(st, 1, false, 0, emit.extract_field(st, one.ty, one.reg, 0));
        emit.push_arg(st, 1, false, 0, emit.extract_field(st, one.ty, one.reg, emit.penum_payload_index(st, stdio, first + 1, 0)));
        emit.push_arg(st, 1, false, 0, emit.extract_field(st, one.ty, one.reg, emit.penum_payload_index(st, stdio, first + 2, 0)));
        k = k + 1;
    }
    let v = emit.spawn_process(st);
    let spawned = types.make_prelude(st, tables.prelude_spawned());
    return in_reg(spawned, emit.answer_enum(st, spawned, 0, v));
}

// Is this the `&!x Heap` a heap operation is reached through?
fn is_heap_ref[&s](st: &!s [int], ty: int) -> [] bool {
    return types.is_ref(st, ty) && types.ref_unique(st, ty) && types.is_prelude(st, types.ref_inner(st, ty)) && types.prelude_index(st, types.ref_inner(st, ty)) == scope.heap_index();
}

// `box_slice(heap, count, fill)` (1), `unbox_slice(heap, box)` (2) and `contents(box_ref)` (3), of
// whole numbers, bytes and booleans: compile mode only, so a function that has one is not checked.
pub fn heap_call[&s, &x](st: &!s [int], text: &x [byte], id: int, which: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    var wanted = 3;
    if which == 2 || which == 4 || which == 5 {
        wanted = 2;
    }
    if which == 3 {
        wanted = 1;
    }
    if ast.get(st, id, 7) != wanted {
        return skip(st, from, to);
    }
    var arg = ast.get(st, id, 6);
    if which == 3 {
        let r = expr(st, text, arg);
        if !ast.ok(st) {
            return nothing();
        }
        if types.is_ref(st, r.ty) && types.is_box(st, types.ref_inner(st, r.ty)) {
            // One value on the heap: the box is a pointer in the slot the reference points at, and
            // the reference to what it holds is that pointer.
            let held = types.box_inner(st, types.ref_inner(st, r.ty));
            let p = emit.load_through(st, 7, r.reg);
            return in_reg(types.make_ref(st, types.ref_unique(st, r.ty), types.ref_region(st, r.ty), held), p);
        }
        if !types.is_ref(st, r.ty) || !types.is_boxslice(st, types.ref_inner(st, r.ty)) || !scope.aggregate_codable(st, types.ref_inner(st, r.ty)) {
            return skip(st, from, to);
        }
        let boxed = types.ref_inner(st, r.ty);
        let p = emit.heap_view(st, boxed, r.reg);
        let slice = types.make_ref(st, types.ref_unique(st, r.ty), types.ref_region(st, r.ty), types.make_slice(st, types.boxslice_element(st, boxed)));
        return in_slice(slice, p, st[59], 0);
    }
    let h = expr(st, text, arg);
    if !ast.ok(st) {
        return nothing();
    }
    if !is_heap_ref(st, h.ty) {
        return skip(st, from, to);
    }
    arg = ast.next(st, arg);
    if which == 4 {
        // `box(heap, v)`: the value on the heap.
        let v = expr(st, text, arg);
        if !ast.ok(st) {
            return nothing();
        }
        if types.is_erased(st, v.ty) || v.ty < 1 || !(v.ty <= 6 || scope.aggregate_codable(st, v.ty) || types.is_ref(st, v.ty)) || types.is_slice_ref(st, v.ty) {
            return skip(st, from, to);
        }
        effects.perform_named(st, "heap");
        return in_reg(types.make_box(st, v.ty), emit.box_value(st, v.ty, v.known, v.value, v.reg));
    }
    if which == 5 {
        // `unbox(heap, b)`: the value the box holds, which is freed.
        let b = expr(st, text, arg);
        if !ast.ok(st) {
            return nothing();
        }
        if !types.is_box(st, b.ty) {
            return skip(st, from, to);
        }
        effects.perform_named(st, "heap");
        let held = types.box_inner(st, b.ty);
        return in_reg(held, emit.unbox_value(st, held, b.reg));
    }
    if which == 2 {
        let b = expr(st, text, arg);
        if !ast.ok(st) {
            return nothing();
        }
        if !types.is_boxslice(st, b.ty) || !scope.aggregate_codable(st, b.ty) {
            return skip(st, from, to);
        }
        effects.perform_named(st, "heap");
        return in_reg(1, emit.heap_free(st, b.ty, b.reg));
    }
    let count = arg;
    let fill = ast.next(st, arg);
    let c = expr(st, text, count);
    if ast.ok(st) {
        scope.expect(st, text, 1, c.ty, ast.nstart(st, count), ast.nend(st, count));
    }
    if !ast.ok(st) {
        return nothing();
    }
    let f = expr(st, text, fill);
    if !ast.ok(st) {
        return nothing();
    }
    if !types.is_plain(f.ty) {
        return skip(st, from, to);
    }
    effects.perform_named(st, "heap");
    let boxed = types.make_boxslice(st, f.ty);
    let p = emit.heap_run(st, f.ty, c.known, c.value, c.reg, f.known, f.value, f.reg);
    return in_reg(boxed, emit.make_box(st, boxed, p, c.known, c.value, c.reg));
}

// The arm of the prelude enum `index` called like token `name`, as its number among all arms, or -1.
pub fn prelude_arm_named[&s, &x](st: &!s [int], text: &x [byte], index: int, name: int) -> [] int {
    let first = builtins.prelude_arm_first(index);
    var k = 0;
    while k < builtins.prelude_arm_count(index) {
        if lc.spells(text, ast.tstart(st, name), ast.tend(st, name), builtins.arm_name(first + k)) {
            return first + k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

// `Spawned::Ok(child)`, `Stdio::Null`: a value of a prelude enum, each payload of the type the arm names.
pub fn prelude_variant[&s, &x](st: &!s [int], text: &x [byte], id: int, index: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let arm = prelude_arm_named(st, text, index, ast.get(st, id, 6));
    if arm < 0 {
        ast.fail(st, rules.r_unknown_name(), from, to);
        return nothing();
    }
    let whole = types.make_prelude(st, index);
    let at = builtins.arm_type_start(arm);
    if ast.get(st, id, 8) != builtins.field_type(at) {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return nothing();
    }
    var acc = emit.insert_at(st, whole, 0 - 1, 0, 1, true, arm - builtins.prelude_arm_first(index), 0 - 1);
    var cursor = at + 1;
    var arg = ast.get(st, id, 7);
    var j = 0;
    while j < builtins.field_type(at) && ast.ok(st) {
        let param = prims.decode(st, true, cursor, 0 - 1, false);
        cursor = st[53];
        let v = expr(st, text, arg);
        if ast.ok(st) {
            if param == 0 {
                return skip(st, from, to);
            }
            scope.expect(st, text, param, v.ty, ast.nstart(st, arg), ast.nend(st, arg));
            if ast.ok(st) && !types.is_erased(st, param) {
                acc = emit.insert_at(st, whole, acc, emit.penum_payload_index(st, index, arm, j), param, v.known, v.value, v.reg);
            }
        }
        arg = ast.next(st, arg);
        j = j + 1;
    }
    if !ast.ok(st) {
        return nothing();
    }
    return in_reg(whole, acc);
}

// `(a, b)` and `(a, b, c)`: an aggregate of the parts, in the code. Larger tuples, and parts that are
// slices or have nothing in the code beside others that have, have no code.
pub fn tuple_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let n = ast.get(st, id, 5);
    if n != 2 && n != 3 {
        return skip(st, from, to);
    }
    var vals = nothing();
    var a = nothing();
    var b = nothing();
    var c = nothing();
    var arg = ast.get(st, id, 4);
    var k = 0;
    while k < n && ast.ok(st) {
        let one = expr(st, text, arg);
        if k == 0 {
            a = one;
        } else if k == 1 {
            b = one;
        } else {
            c = one;
        }
        arg = ast.next(st, arg);
        k = k + 1;
    }
    if !ast.ok(st) {
        return nothing();
    }
    var tc = 0;
    if n == 3 {
        tc = c.ty;
    }
    let whole = types.make_tuple(st, n, a.ty, b.ty, tc);
    if types.is_erased(st, whole) {
        return in_reg(whole, 0 - 1);
    }
    if !scope.tuple_codable(st, whole) {
        return skip(st, from, to);
    }
    var acc = emit.insert_at(st, whole, 0 - 1, 0, a.ty, a.known, a.value, a.reg);
    acc = emit.insert_at(st, whole, acc, 1, b.ty, b.known, b.value, b.reg);
    if n == 3 {
        acc = emit.insert_at(st, whole, acc, 2, c.ty, c.known, c.value, c.reg);
    }
    return in_reg(whole, acc);
}

// `t.0`: a part of a tuple; through a reference, a `val` one is copied out and a `res` one is borrowed.
pub fn tuple_field_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let b = expr(st, text, ast.get(st, id, 4));
    if !ast.ok(st) {
        return nothing();
    }
    var held = b.ty;
    if types.is_ref(st, held) {
        held = types.ref_inner(st, held);
    }
    let k = ast.get(st, id, 5);
    if !types.is_tuple(st, held) || k >= types.tuple_size(st, held) {
        return skip(st, from, to);
    }
    let pt = types.tuple_part(st, held, k);
    if types.is_erased(st, held) {
        return in_reg(pt, 0 - 1);
    }
    if !scope.tuple_codable(st, held) {
        return skip(st, from, to);
    }
    if types.is_ref(st, b.ty) {
        let address = emit.field_address(st, held, b.reg, k);
        if scope.is_res_type(st, pt) {
            return in_reg(types.make_ref(st, types.ref_unique(st, b.ty), types.ref_region(st, b.ty), pt), address);
        }
        return in_reg(pt, emit.load_through(st, pt, address));
    }
    return in_reg(pt, emit.extract_field(st, held, b.reg, k));
}

// `alloc[a](v)`: a value stored in the arena `a`, a unique reference to it for as long as the block. The arena
// first, then the value, which must be one that copies.
pub fn alloc_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let area = ast.get(st, id, 4);
    let value = ast.get(st, id, 5);
    // Only the code is written for it: in the other modes it is, as it was, `SKIP`.
    if !emit.on(st) || pass1.is_word(st, text, area, "static") {
        return skip(st, from, to);
    }
    let arena = scope.arena_block(st, text, area);
    if arena < 0 {
        ast.fail(st, rules.r_region_not_in_scope(), from, to);
        return nothing();
    }
    let v = expr(st, text, value);
    if !ast.ok(st) {
        return nothing();
    }
    if types.is_erased(st, v.ty) || v.ty < 1 || types.is_slice_ref(st, v.ty) || !(v.ty <= 6 || scope.aggregate_codable(st, v.ty) || types.is_ref(st, v.ty)) {
        return skip(st, from, to);
    }
    let result = types.make_ref(st, true, types.block_region(arena), v.ty);
    return in_reg(result, emit.arena_value(st, arena, v.ty, v.known, v.value, v.reg));
}

// The Variant node of the enum `item` called like token `name`, or -1.
pub fn variant_named[&s, &x](st: &!s [int], text: &x [byte], item: int, name: int) -> [] int {
    var v = ast.get(st, item, 8);
    while v >= 0 {
        if ast.same(st, text, ast.get(st, v, 4), name) {
            return v;
        }
        v = ast.next(st, v);
    }
    return 0 - 1;
}

// Is a field called `name` written in the literal's fields before `stop`?
pub fn given_before[&s, &x](st: &!s [int], text: &x [byte], first: int, stop: int, name: int) -> [] bool {
    var f = first;
    while f != stop {
        if ast.same(st, text, ast.get(st, f, 4), name) {
            return true;
        }
        f = ast.next(st, f);
    }
    return false;
}

// `Name { a: x, b: y }`: every field, once, in declaration order, each of the declared type.
pub fn struct_lit[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let target = pass1.resolve_module(st, text, st[22], ast.get(st, id, 4));
    if target < 0 {
        ast.fail(st, rules.r_module_not_imported(), from, to);
        return nothing();
    }
    let found = pass1.lookup(st, text, ast.get(st, id, 5), target, st[23]);
    if found < 0 {
        ast.fail(st, rules.r_not_a_struct(), from, to);
        return nothing();
    }
    if found < pass1.user_base() {
        return skip(st, from, to);
    }
    let item = found - pass1.user_base();
    if !ast.is_kind(st, item, kinds.NK::IStruct) {
        ast.fail(st, rules.r_not_a_struct(), from, to);
        return nothing();
    }
    if target != st[22] && !pass1.def_public(st, found) {
        ast.fail(st, rules.r_not_public(), from, to);
        return nothing();
    }
    let nparams = pass1.count_params(st, ast.get(st, item, 7), false);
    if nparams > 0 {
        return struct_generic(st, text, id, item, nparams);
    }
    if !emit.on(st) && !scope.struct_plain(st, item) {
        return skip(st, from, to);
    }
    if emit.on(st) && !scope.struct_codable(st, types.make_named(st, item)) {
        return skip(st, from, to);
    }
    let first = ast.get(st, id, 6);
    var init = first;
    var previous = 0 - 1;
    var acc = 0 - 1;
    while init >= 0 && ast.ok(st) {
        let name = ast.get(st, init, 4);
        let value = ast.get(st, init, 5);
        let index = scope.field_index(st, text, item, name);
        if index < 0 {
            ast.fail(st, rules.r_unknown_name(), from, to);
        } else if given_before(st, text, first, init, name) {
            ast.fail(st, rules.r_duplicate_declaration(), from, to);
        } else if index < previous {
            ast.fail(st, rules.r_field_order(), ast.nstart(st, value), ast.nend(st, value));
        } else {
            previous = index;
            let v = expr(st, text, value);
            if ast.ok(st) {
                scope.expect(st, text, scope.field_type(st, types.make_named(st, item), index), v.ty, ast.nstart(st, value), ast.nend(st, value));
                if emit.on(st) && ast.ok(st) {
                    acc = emit.insert_field(st, types.make_named(st, item), acc, index, v.known, v.value, v.reg);
                }
            }
        }
        init = ast.next(st, init);
    }
    var decl = ast.get(st, item, 8);
    while decl >= 0 && ast.ok(st) {
        if !given_before(st, text, first, 0 - 1, ast.get(st, decl, 4)) {
            ast.fail(st, rules.r_missing_field(), from, to);
        }
        decl = ast.next(st, decl);
    }
    if !ast.ok(st) {
        return nothing();
    }
    if emit.on(st) {
        return in_reg(types.make_named(st, item), acc);
    }
    return plain(types.make_named(st, item));
}

// A struct literal of a declaration with type parameters, in the code only: the parameters are variables the
// values, or the type expected, solve; up to four fields, all given, in the order declared.
pub fn struct_generic[&s, &x](st: &!s [int], text: &x [byte], id: int, item: int, nparams: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    if !emit.on(st) || nparams > 2 {
        return skip(st, from, to);
    }
    let whole = types.fresh_named(st, item, nparams);
    let expected = types.hint(st);
    types.set_hint(st, 0);
    if expected != 0 && types.is_named(st, types.shallow(st, expected)) && types.named_item(st, types.shallow(st, expected)) == item {
        scope.expect(st, text, expected, whole, from, to);
    }
    let first = ast.get(st, id, 6);
    var init = first;
    var previous = 0 - 1;
    var count = 0;
    var e0 = nothing();
    var e1 = nothing();
    var e2 = nothing();
    var e3 = nothing();
    while init >= 0 && ast.ok(st) {
        let name = ast.get(st, init, 4);
        let value = ast.get(st, init, 5);
        let index = scope.field_index(st, text, item, name);
        if index < 0 {
            ast.fail(st, rules.r_unknown_name(), from, to);
        } else if given_before(st, text, first, init, name) {
            ast.fail(st, rules.r_duplicate_declaration(), from, to);
        } else if index < previous {
            ast.fail(st, rules.r_field_order(), ast.nstart(st, value), ast.nend(st, value));
        } else if index > 3 {
            return skip(st, from, to);
        } else {
            previous = index;
            let v = expr(st, text, value);
            if ast.ok(st) {
                scope.expect(st, text, scope.field_type(st, whole, index), v.ty, ast.nstart(st, value), ast.nend(st, value));
            }
            if index == 0 {
                e0 = v;
            } else if index == 1 {
                e1 = v;
            } else if index == 2 {
                e2 = v;
            } else {
                e3 = v;
            }
            count = count + 1;
        }
        init = ast.next(st, init);
    }
    var decl = ast.get(st, item, 8);
    while decl >= 0 && ast.ok(st) {
        if !given_before(st, text, first, 0 - 1, ast.get(st, decl, 4)) {
            ast.fail(st, rules.r_missing_field(), from, to);
        }
        decl = ast.next(st, decl);
    }
    if !ast.ok(st) {
        return nothing();
    }
    if !scope.struct_codable(st, whole) {
        return skip(st, from, to);
    }
    var acc = 0 - 1;
    var index = 0;
    while index < count {
        var v = e0;
        if index == 1 {
            v = e1;
        } else if index == 2 {
            v = e2;
        } else if index == 3 {
            v = e3;
        }
        acc = emit.insert_field(st, whole, acc, index, v.known, v.value, v.reg);
        index = index + 1;
    }
    return in_reg(whole, acc);
}

// `base.name`: a field of a struct, or of a reference to one, copied out.
pub fn field_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let base = ast.get(st, id, 4);
    let b = expr(st, text, base);
    if !ast.ok(st) {
        return nothing();
    }
    var held = b.ty;
    if types.is_ref(st, held) {
        held = types.ref_inner(st, held);
    }
    if types.is_prelude(st, held) {
        return skip(st, from, to);
    }
    if !types.is_named(st, held) {
        ast.fail(st, rules.r_unknown_name(), ast.nstart(st, base), ast.nend(st, base));
        return nothing();
    }
    let item = types.named_item(st, held);
    if !ast.is_kind(st, item, kinds.NK::IStruct) {
        ast.fail(st, rules.r_match_on_a_non_enum(), ast.nstart(st, base), ast.nend(st, base));
        return nothing();
    }
    let index = scope.field_index(st, text, item, ast.get(st, id, 5));
    if index < 0 {
        ast.fail(st, rules.r_unknown_name(), from, to);
        return nothing();
    }
    if emit.on(st) {
        let ft = scope.field_type(st, held, index);
        if !scope.struct_codable(st, held) {
            return skip(st, from, to);
        }
        if types.is_ref(st, b.ty) {
            let address = emit.field_address(st, held, b.reg, index);
            if scope.is_res_type(st, ft) {
                // A field that must be consumed is not copied out of a reference: it is borrowed, for
                // as long as, and as uniquely as, the reference it was reached through.
                return in_reg(types.make_ref(st, types.ref_unique(st, b.ty), types.ref_region(st, b.ty), ft), address);
            }
            return in_reg(ft, emit.load_through(st, ft, address));
        }
        return in_reg(ft, emit.extract_field(st, held, b.reg, index));
    }
    return plain(scope.field_type(st, held, index));
}

// The expressions the code can be written for so far: whole numbers and booleans, names, the
// operators, and calls.
pub fn writes_code[&s](st: &!s [int], id: int) -> [] bool {
    if ast.is_kind(st, id, kinds.NK::EInt) || ast.is_kind(st, id, kinds.NK::EFloat) || ast.is_kind(st, id, kinds.NK::EBool) || ast.is_kind(st, id, kinds.NK::EName) || ast.is_kind(st, id, kinds.NK::ECall) || ast.is_kind(st, id, kinds.NK::EStr) || ast.is_kind(st, id, kinds.NK::EIndex) || ast.is_kind(st, id, kinds.NK::EStructLit) || ast.is_kind(st, id, kinds.NK::EField) || ast.is_kind(st, id, kinds.NK::EVariant) || ast.is_kind(st, id, kinds.NK::EAllocSlice) || ast.is_kind(st, id, kinds.NK::ESlice) || ast.is_kind(st, id, kinds.NK::EAlloc) || ast.is_kind(st, id, kinds.NK::ETuple) || ast.is_kind(st, id, kinds.NK::ETupleField) {
        return true;
    }
    if ast.is_kind(st, id, kinds.NK::EUnary) {
        return true;
    }
    if ast.is_kind(st, id, kinds.NK::EBinary) {
        return true;
    }
    return false;
}

pub fn name_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let name = ast.get(st, id, 4);
    let i = scope.find(st, text, name);
    if i >= 0 {
        scope.use_slot(st, i, from, to);
        if emit.on(st) {
            if types.is_erased(st, scope.binding_type(st, i)) {
                return in_reg(scope.binding_type(st, i), 0 - 1);
            }
            if types.is_slice_ref(st, scope.binding_type(st, i)) {
                let p = emit.load_slice(st, scope.slot_of(st, i));
                return in_slice(scope.binding_type(st, i), p, st[59], 0);
            }
            return in_reg(scope.binding_type(st, i), emit.load(st, scope.binding_type(st, i), scope.slot_of(st, i)));
        }
        return plain(scope.binding_type(st, i));
    }
    // A `static` of this module declared as a slice of scalars is a shared reference to it.
    let table = static_named(st, text, name);
    if table >= 0 {
        let ty = scope.static_type(st, table);
        if ty == 0 {
            return skip(st, from, to);
        }
        if emit.on(st) {
            let element = types.element_of(st, ty);
            if !types.is_plain(element) {
                return skip(st, from, to);
            }
            let p = emit.static_load(st, table);
            return in_slice(ty, p, st[59], 0);
        }
        return plain(ty);
    }
    // A function of this module used as a value: its address, to be given to `spawn`.
    if emit.on(st) {
        var it = st[15];
        while it >= 0 {
            if ast.is_kind(st, it, kinds.NK::IFn) && ast.get(st, it, 13) == st[22] && ast.same(st, text, ast.get(st, it, 4), name) {
                if pass1.count_params(st, ast.get(st, it, 6), false) > 0 || !plain_function(st, text, it) {
                    return skip(st, from, to);
                }
                return in_reg(types.make_fnval(st, it), threadcode.function_pointer(st, it));
            }
            it = ast.next(st, it);
        }
    }
    // A name that is not a local may still be a function used as a value, or a builtin: those are
    // values of types this slice does not check.
    if names_something(st, text, name) {
        return skip(st, from, to);
    }
    ast.fail(st, rules.r_unknown_name(), from, to);
    return nothing();
}

// The `static` item of the current module called like token `name`, or -1.
pub fn static_named[&s, &x](st: &!s [int], text: &x [byte], name: int) -> [] int {
    var it = st[15];
    while it >= 0 {
        if ast.is_kind(st, it, kinds.NK::IStatic) && ast.same(st, text, ast.get(st, it, 4), name) && ast.get(st, it, 13) == st[22] {
            return it;
        }
        it = ast.next(st, it);
    }
    return 0 - 1;
}

// Is `name` a static of the current function's module, a function of any module, or a builtin?
pub fn names_something[&s, &x](st: &!s [int], text: &x [byte], name: int) -> [] bool {
    var it = st[15];
    while it >= 0 {
        if ast.is_kind(st, it, kinds.NK::IStatic) && ast.same(st, text, ast.get(st, it, 4), name) && ast.get(st, it, 13) == st[22] {
            return true;
        }
        if ast.is_kind(st, it, kinds.NK::IFn) && ast.same(st, text, ast.get(st, it, 4), name) {
            return true;
        }
        it = ast.next(st, it);
    }
    return pass1.builtin_named(st, text, name);
}

pub fn unary_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let op = ast.get(st, id, 4);
    let operand_id = ast.get(st, id, 5);
    let operand = expr(st, text, operand_id);
    if !ast.ok(st) {
        return nothing();
    }
    let of = ast.nstart(st, operand_id);
    let ot = ast.nend(st, operand_id);
    if op == 3 {
        // `*r`: what a reference points at, copied. A slice is not a value to copy.
        if !types.is_ref(st, operand.ty) {
            ast.fail(st, rules.r_not_a_reference(), of, ot);
            return nothing();
        }
        if types.is_slice(st, types.ref_inner(st, operand.ty)) || types.is_prelude(st, types.ref_inner(st, operand.ty)) {
            return skip(st, from, to);
        }
        if emit.on(st) {
            let inner = types.ref_inner(st, operand.ty);
            if !types.is_plain(inner) && !scope.aggregate_codable(st, inner) {
                return skip(st, from, to);
            }
            return in_reg(inner, emit.load_through(st, inner, operand.reg));
        }
        return plain(types.ref_inner(st, operand.ty));
    }
    if op == 0 {
        if operand.ty != 1 && operand.ty != 3 && operand.ty != 4 {
            ast.fail(st, rules.r_operator_type_mismatch(), of, ot);
            return nothing();
        }
        if operand.known && operand.ty == 1 {
            if operand.value == fold.smallest() {
                ast.fail(st, rules.r_constant_traps(), from, to);
                return nothing();
            }
            return constant(0 - operand.value);
        }
        if emit.on(st) && operand.ty != 1 {
            return in_reg(operand.ty, floatcode.float_negate(st, operand.ty, operand.known, operand.value, operand.reg));
        }
        if emit.on(st) {
            return in_reg(operand.ty, emit.checked(st, 1, true, 0, 0 - 1, operand.known, operand.value, operand.reg));
        }
        return plain(operand.ty);
    }
    if op == 1 {
        scope.expect(st, text, 5, operand.ty, of, ot);
        if emit.on(st) && ast.ok(st) {
            return in_reg(5, emit.not(st, operand.known, operand.value, operand.reg));
        }
        return plain(5);
    }
    scope.expect(st, text, 1, operand.ty, of, ot);
    if operand.known {
        return constant(~operand.value);
    }
    if emit.on(st) && ast.ok(st) {
        return in_reg(1, emit.bit_not(st, operand.known, operand.value, operand.reg));
    }
    return plain(1);
}

pub fn binary_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let op = ast.get(st, id, 4);
    let lhs_id = ast.get(st, id, 5);
    let rhs_id = ast.get(st, id, 6);
    let lf = ast.nstart(st, lhs_id);
    let lt = ast.nend(st, lhs_id);
    let l = expr(st, text, lhs_id);
    if !ast.ok(st) {
        return nothing();
    }
    // `&&` and `||` do not compute their right side when the left has decided: its code is written
    // between the two, in blocks of its own.
    var short = 0 - 1;
    if emit.on(st) && op <= 1 {
        short = emit.label(st);
        emit.short_begin(st, short, op == 0, l.known, l.value, l.reg);
    }
    let r = expr(st, text, rhs_id);
    if !ast.ok(st) {
        return nothing();
    }
    var short_reg = 0 - 1;
    if short >= 0 {
        short_reg = emit.short_end(st, short, r.known, r.value, r.reg);
    }
    // Both sides agree first, then the operator says what it accepts.
    scope.expect(st, text, l.ty, r.ty, ast.nstart(st, rhs_id), ast.nend(st, rhs_id));
    if !ast.ok(st) {
        return nothing();
    }
    let operand = l.ty;
    let arithmetic = operand == 1 || operand == 3 || operand == 4;
    if op >= 13 && op <= 16 {
        if !arithmetic {
            ast.fail(st, rules.r_operator_type_mismatch(), lf, lt);
            return nothing();
        }
    }
    if op == 17 || op >= 8 && op <= 12 {
        scope.expect(st, text, 1, operand, lf, lt);
    }
    if op == 0 || op == 1 {
        scope.expect(st, text, 5, operand, lf, lt);
    }
    if op >= 4 && op <= 7 {
        if !arithmetic {
            ast.fail(st, rules.r_operator_type_mismatch(), lf, lt);
            return nothing();
        }
    }
    // `==` and `!=` compare two scalars, and nothing else.
    if op == 2 || op == 3 {
        if operand < 1 || operand > 5 {
            ast.fail(st, rules.r_operator_type_mismatch(), lf, lt);
            return nothing();
        }
    }
    if !ast.ok(st) {
        return nothing();
    }
    // A comparison and a short-circuit answer a `bool`; the rest answer their operand.
    var result = operand;
    if op <= 7 {
        result = 5;
    }
    if l.known && r.known && operand == 1 {
        let f = fold.fold_int(op, l.value, r.value);
        if f.trapped {
            ast.fail(st, rules.r_constant_traps(), from, to);
            return nothing();
        }
        if result == 1 {
            return constant(f.value);
        }
    }
    if short_reg >= 0 {
        return in_reg(5, short_reg);
    }
    if emit.on(st) {
        return in_reg(result, binary_code(st, op, operand, l, r));
    }
    return plain(result);
}

// The code for `l op r` on two operands of type `ty`, answering the temporary of the result.
pub fn binary_code[&s](st: &!s [int], op: int, ty: int, l: Ex, r: Ex) -> [] int {
    if ty == 3 || ty == 4 {
        if op >= 13 {
            return floatcode.float_op(st, op, ty, l.known, l.value, l.reg, r.known, r.value, r.reg);
        }
        return floatcode.float_compare(st, op, ty, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    if op >= 13 && op <= 15 {
        return emit.checked(st, op - 13, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    if op == 16 || op == 17 {
        return emit.divide(st, op == 17, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    if op == 11 || op == 12 {
        return emit.shift(st, op == 11, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    if op >= 8 && op <= 10 {
        var kind = 2;
        if op == 10 {
            kind = 0;
        } else if op == 8 {
            kind = 1;
        }
        return emit.bitwise(st, kind, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    return emit.compare(st, op, ty, l.known, l.value, l.reg, r.known, r.value, r.reg);
}

// `s[i]`: one element of a slice. The base is checked first, then the index.
pub fn index_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let base = ast.get(st, id, 4);
    let index = ast.get(st, id, 5);
    let b = expr(st, text, base);
    if !ast.ok(st) {
        return nothing();
    }
    let e = scope.element(st, b.ty, ast.nstart(st, base), ast.nend(st, base));
    if !ast.ok(st) {
        return nothing();
    }
    let i = expr(st, text, index);
    if ast.ok(st) {
        scope.expect(st, text, 1, i.ty, ast.nstart(st, index), ast.nend(st, index));
    }
    if emit.on(st) && ast.ok(st) {
        if !types.is_plain(e) {
            return skip(st, ast.nstart(st, id), ast.nend(st, id));
        }
        let address = emit.element_address(st, e, b.reg, b.reg2 < 0, b.value, b.reg2, i.known, i.value, i.reg);
        return in_reg(e, emit.load_through(st, e, address));
    }
    return plain(e);
}

// `s[a..b]`: a shorter run of the same slice, in the same region and as unique or shared.
pub fn subslice_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let base = ast.get(st, id, 4);
    let start = ast.get(st, id, 5);
    let end = ast.get(st, id, 6);
    let b = expr(st, text, base);
    if !ast.ok(st) {
        return nothing();
    }
    let e = scope.element(st, b.ty, ast.nstart(st, base), ast.nend(st, base));
    if !ast.ok(st) {
        return nothing();
    }
    let a = expr(st, text, start);
    if ast.ok(st) {
        scope.expect(st, text, 1, a.ty, ast.nstart(st, start), ast.nend(st, start));
    }
    if !ast.ok(st) {
        return nothing();
    }
    let z = expr(st, text, end);
    if ast.ok(st) {
        scope.expect(st, text, 1, z.ty, ast.nstart(st, end), ast.nend(st, end));
    }
    if !ast.ok(st) {
        return nothing();
    }
    let narrowed = types.make_ref(st, types.ref_unique(st, b.ty), types.ref_region(st, b.ty), types.make_slice(st, e));
    if emit.on(st) {
        if !types.is_plain(e) {
            return skip(st, ast.nstart(st, id), ast.nend(st, id));
        }
        let at = emit.subslice(st, e, b.reg, b.reg2 < 0, b.value, b.reg2, a.known, a.value, a.reg, z.known, z.value, z.reg);
        return in_slice(narrowed, at, st[59], 0);
    }
    return plain(narrowed);
}

// `len(s)`: how many elements a slice has.
pub fn len_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    if ast.get(st, id, 7) != 1 {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return nothing();
    }
    let arg = ast.get(st, id, 6);
    let a = expr(st, text, arg);
    if ast.ok(st) {
        scope.element(st, a.ty, ast.nstart(st, arg), ast.nend(st, arg));
    }
    if !ast.ok(st) {
        return nothing();
    }
    if emit.on(st) {
        if a.reg2 >= 0 {
            return in_reg(1, a.reg2);
        }
        return constant(a.value);
    }
    return plain(1);
}

// A call to a builtin the table says everything about: it takes what its signature says, as a
// call to a function does, its region parameters made variables the arguments solve. A builtin the
// lowering checks by hand, one that performs an effect (rows are not checked yet) and one with a
// type the checker cannot hold are `SKIP`; and every builtin is while code is being written.
// The number of the float builtin spelled at `from` to `to` of the text (18 to 30, see `emit.float_builtin`), or 0.
fn float_builtin_number[&x](text: &x [byte], from: int, to: int) -> [] int {
    if lc.spells(text, from, to, "float_of") {
        return 18;
    }
    if lc.spells(text, from, to, "truncate") {
        return 19;
    }
    if lc.spells(text, from, to, "bits_of") {
        return 20;
    }
    if lc.spells(text, from, to, "float_of_bits") {
        return 21;
    }
    if lc.spells(text, from, to, "is_nan") {
        return 22;
    }
    if lc.spells(text, from, to, "sqrt") {
        return 23;
    }
    if lc.spells(text, from, to, "f32_of") {
        return 24;
    }
    if lc.spells(text, from, to, "float_of32") {
        return 25;
    }
    if lc.spells(text, from, to, "bits_of32") {
        return 26;
    }
    if lc.spells(text, from, to, "f32_of_bits") {
        return 27;
    }
    if lc.spells(text, from, to, "sqrt32") {
        return 28;
    }
    if lc.spells(text, from, to, "f32_of_int") {
        return 29;
    }
    if lc.spells(text, from, to, "int_of_f32") {
        return 30;
    }
    return 0;
}

pub fn builtin_call[&s, &x](st: &!s [int], text: &x [byte], id: int, b: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let start = signatures.builtin_sig_start(b);
    if signatures.builtin_sig(start) != 0 || !effects.perform(st, b) {
        return skip(st, from, to);
    }
    // The builtins code is written for so far: 1 `putchar`, 2 `write_bytes`, 3 `int_of`, 4 `byte_of`.
    var written = 0;
    if emit.on(st) {
        let at = ast.get(st, id, 5);
        if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "putchar") {
            written = 1;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "write_bytes") {
            written = 2;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "int_of") {
            written = 3;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "byte_of") {
            written = 4;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "wrapping_add") {
            written = 5;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "wrapping_sub") {
            written = 6;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "wrapping_mul") {
            written = 7;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "copy_into") {
            written = 8;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "index_of_byte") {
            written = 9;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "getchar") {
            written = 10;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "write_err") {
            written = 11;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "arg_count") {
            written = 12;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "arg") {
            written = 13;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "file_write") {
            written = 14;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "file_read") {
            written = 15;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "file_close") {
            written = 16;
        } else if lc.spells(text, ast.tstart(st, at), ast.tend(st, at), "child_wait") {
            written = 17;
        } else if float_builtin_number(text, ast.tstart(st, at), ast.tend(st, at)) > 0 {
            written = float_builtin_number(text, ast.tstart(st, at), ast.tend(st, at));
        } else {
            return skip(st, from, to);
        }
    }
    var last = nothing();
    var fresh = 0 - 1;
    var made = 0;
    while made < builtins.builtin_regions(b) {
        let r = types.fresh_region(st);
        if made == 0 {
            fresh = r;
        }
        made = made + 1;
    }
    let wanted = signatures.builtin_sig(start + 1);
    if wanted != ast.get(st, id, 7) {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return nothing();
    }
    var cursor = start + 2;
    var arg = ast.get(st, id, 6);
    var k = 0;
    while k < wanted && ast.ok(st) {
        let param = prims.decode(st, false, cursor, fresh, false);
        cursor = st[53];
        let a = expr(st, text, arg);
        if ast.ok(st) {
            if param == 0 {
                skip(st, from, to);
            } else {
                scope.expect(st, text, param, a.ty, ast.nstart(st, arg), ast.nend(st, arg));
                if written != 0 && written != 3 && written != 4 && written < 18 {
                    push_value(st, a);
                }
                last = a;
            }
        }
        arg = ast.next(st, arg);
        k = k + 1;
    }
    if !ast.ok(st) {
        return nothing();
    }
    let result = prims.decode(st, false, cursor, fresh, false);
    if result == 0 {
        return skip(st, from, to);
    }
    if written == 1 {
        return in_reg(result, emit.put_char(st));
    }
    if written == 2 {
        return in_reg(result, emit.write_slice(st));
    }
    if written == 3 {
        return in_reg(result, emit.widen(st, last.known, last.value, last.reg));
    }
    if written == 4 {
        return in_reg(result, emit.truncate_to_byte(st, last.known, last.value, last.reg));
    }
    if written >= 18 {
        return in_reg(result, floatcode.float_builtin(st, written, last.known, last.value, last.reg));
    }
    if written >= 5 && written <= 7 {
        return in_reg(result, emit.plain_arith(st, written - 5));
    }
    if written == 8 {
        return in_reg(result, emit.bulk_copy(st));
    }
    if written == 9 {
        return in_reg(result, emit.find_byte(st));
    }
    if written == 10 {
        return in_reg(result, emit.stdin_char(st));
    }
    if written == 11 {
        return in_reg(result, emit.stderr_write(st));
    }
    if written == 12 {
        return in_reg(result, emit.command_count(st));
    }
    if written == 13 {
        let p = emit.command_arg(st);
        return in_slice(result, p, st[59], 0);
    }
    if written == 14 || written == 15 {
        let v = emit.fd_transfer(st, written == 15);
        return in_reg(result, emit.answer_enum(st, result, written - 14, v));
    }
    if written == 16 {
        return in_reg(result, emit.fd_close(st));
    }
    if written == 17 {
        let v = emit.wait_child(st);
        return in_reg(result, emit.answer_enum(st, result, 2, v));
    }
    return plain(result);
}

// `spawn(payload, f)` and `join(t)`. The payload and what `f` returns are one value each of no more than one
// pointer's worth: a whole number, a byte, a boolean, a reference, or a capability (nothing in the code).
pub fn thread_call[&s, &x](st: &!s [int], text: &x [byte], id: int, spawning: bool) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    var arg = ast.get(st, id, 6);
    if !spawning {
        if ast.get(st, id, 7) != 1 {
            return skip(st, from, to);
        }
        let t = expr(st, text, arg);
        if !ast.ok(st) {
            return nothing();
        }
        if !types.is_thread(st, t.ty) {
            return skip(st, from, to);
        }
        let result = types.thread_result(st, t.ty);
        return in_reg(result, threadcode.join_thread(st, result, t.reg));
    }
    if ast.get(st, id, 7) != 2 {
        return skip(st, from, to);
    }
    let payload = expr(st, text, arg);
    if !ast.ok(st) {
        return nothing();
    }
    arg = ast.next(st, arg);
    let f = expr(st, text, arg);
    if !ast.ok(st) {
        return nothing();
    }
    if !types.is_fnval(st, f.ty) {
        return skip(st, from, to);
    }
    let item = types.fnval_item(st, f.ty);
    let result = scope.lower_type(st, text, ast.get(st, item, 10), ast.get(st, item, 6), 0 - 1);
    let carried = types.is_erased(st, payload.ty) || types.is_ref(st, payload.ty) && !types.is_slice_ref(st, payload.ty) || payload.ty == 1 || payload.ty == 2 || payload.ty == 5 || types.is_handle(st, payload.ty);
    let returned = types.is_erased(st, result) || types.is_ref(st, result) && !types.is_slice_ref(st, result) || result == 1 || result == 2 || result == 5;
    if !carried || !returned {
        return skip(st, from, to);
    }
    return in_reg(types.make_thread(st, result), threadcode.spawn_thread(st, payload.ty, payload.known, payload.value, payload.reg, f.reg));
}

pub fn call_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let qualifier = ast.get(st, id, 4);
    let callee = ast.get(st, id, 5);
    let nargs = ast.get(st, id, 7);
    // Only an unqualified name can be a local.
    if qualifier < 0 {
        let local = scope.find(st, text, callee);
        if local >= 0 {
            if emit.on(st) && types.is_fnval(st, scope.binding_type(st, local)) {
                // A function held in a name: the call is to the function it holds.
                scope.use_slot(st, local, from, to);
                return call_item(st, text, id, types.fnval_item(st, scope.binding_type(st, local)));
            }
            ast.fail(st, rules.r_not_a_function(), from, to);
            return nothing();
        }
    }
    let unit_of = st[22];
    let target = pass1.resolve_module(st, text, unit_of, qualifier);
    if target < 0 {
        ast.fail(st, rules.r_module_not_imported(), from, to);
        return nothing();
    }
    // `len` is a builtin of every edition, and is checked before anything else is looked up.
    if pass1.is_word(st, text, callee, "len") {
        return len_expr(st, text, id);
    }
    // `release(world)` ends a capability: no code, and `0` if the answer is wanted.
    if emit.on(st) && qualifier < 0 && pass1.is_word(st, text, callee, "release") {
        if nargs != 1 {
            return skip(st, from, to);
        }
        let given = expr(st, text, ast.get(st, id, 6));
        if !ast.ok(st) {
            return nothing();
        }
        if !types.is_prelude(st, given.ty) {
            return skip(st, from, to);
        }
        return constant(0);
    }
    // `split(world)`: the parts of the `World`, which are nothing in the code.
    if emit.on(st) && qualifier < 0 && pass1.is_word(st, text, callee, "split") {
        if nargs != 1 {
            return skip(st, from, to);
        }
        let given = expr(st, text, ast.get(st, id, 6));
        if !ast.ok(st) {
            return nothing();
        }
        if !types.is_prelude(st, given.ty) {
            return skip(st, from, to);
        }
        return in_reg(types.make_prelude(st, builtins.split_for(st[23])), 0 - 1);
    }
    // Capabilities narrowed by a literal, files and processes: only the code is written for them.
    if emit.on(st) && qualifier < 0 {
        if pass1.is_word(st, text, callee, "narrow") {
            return capability_call(st, text, id, 1);
        }
        if pass1.is_word(st, text, callee, "open_read") {
            return capability_call(st, text, id, 2);
        }
        if pass1.is_word(st, text, callee, "open_write") {
            return capability_call(st, text, id, 3);
        }
        if pass1.is_word(st, text, callee, "open_append") {
            return capability_call(st, text, id, 4);
        }
        if pass1.is_word(st, text, callee, "open_new") {
            return capability_call(st, text, id, 5);
        }
        if pass1.is_word(st, text, callee, "open_rw") {
            return capability_call(st, text, id, 6);
        }
        if pass1.is_word(st, text, callee, "exec_spawn") {
            return capability_call(st, text, id, 7);
        }
        if pass1.is_word(st, text, callee, "fs_read") {
            return capability_call(st, text, id, 8);
        }
        if pass1.is_word(st, text, callee, "fs_write") {
            return capability_call(st, text, id, 9);
        }
    }
    // Threads: only the code is written for them, in compile mode.
    if emit.on(st) && qualifier < 0 {
        if pass1.is_word(st, text, callee, "spawn") {
            return thread_call(st, text, id, true);
        }
        if pass1.is_word(st, text, callee, "join") {
            return thread_call(st, text, id, false);
        }
    }
    // The heap: only the code is written for it, in compile mode.
    if emit.on(st) && qualifier < 0 {
        if pass1.is_word(st, text, callee, "box_slice") {
            return heap_call(st, text, id, 1);
        }
        if pass1.is_word(st, text, callee, "unbox_slice") {
            return heap_call(st, text, id, 2);
        }
        if pass1.is_word(st, text, callee, "contents") {
            return heap_call(st, text, id, 3);
        }
        if pass1.is_word(st, text, callee, "box") {
            return heap_call(st, text, id, 4);
        }
        if pass1.is_word(st, text, callee, "unbox") {
            return heap_call(st, text, id, 5);
        }
    }
    // A builtin the file's edition can name comes first, then a foreign function: not checked.
    let known = prims.builtin_at(st, text, callee, st[23]);
    if known >= 0 {
        return builtin_call(st, text, id, known);
    }
    var it = st[15];
    while it >= 0 {
        if ast.is_kind(st, it, kinds.NK::IExtern) && ast.get(st, it, 13) == target && ast.same(st, text, ast.get(st, it, 4), callee) {
            return skip(st, from, to);
        }
        it = ast.next(st, it);
    }
    var found = 0 - 1;
    it = st[15];
    while it >= 0 && found < 0 {
        if ast.is_kind(st, it, kinds.NK::IFn) && ast.get(st, it, 13) == target && ast.same(st, text, ast.get(st, it, 4), callee) {
            found = it;
        }
        it = ast.next(st, it);
    }
    if found < 0 {
        ast.fail(st, rules.r_not_a_function(), from, to);
        return nothing();
    }
    if target != unit_of && ast.get(st, found, 5) == 0 {
        ast.fail(st, rules.r_not_public(), from, to);
        return nothing();
    }
    return call_item(st, text, id, found);
}

// The call `id` to the function `found`: its arguments against the signature, then the code.
pub fn call_item[&s, &x](st: &!s [int], text: &x [byte], id: int, found: int) -> [] Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let nargs = ast.get(st, id, 7);
    // A callee that is generic, declares effects, or has a type this slice does not handle.
    if !plain_function(st, text, found) {
        return skip(st, from, to);
    }
    if emit.on(st) && pass1.count_params(st, ast.get(st, found, 6), false) > 2 {
        return skip(st, from, to);
    }
    // What the callee's row says it performs, the caller performs.
    effects.perform_row(st, effects.row_mask(st, text, found));
    // Each type and region parameter of the callee is a variable here, which the arguments solve.
    let callee_dp = ast.get(st, found, 6);
    var tvars = 0 - 1;
    var tmade = 0;
    while tmade < pass1.count_params(st, callee_dp, false) {
        let v = types.fresh_tvar(st);
        if tmade == 0 {
            tvars = v;
        }
        tmade = tmade + 1;
    }
    var fresh = 0 - 1;
    var made = 0;
    while made < pass1.count_params(st, callee_dp, true) {
        let r = types.fresh_region(st);
        if made == 0 {
            fresh = r;
        }
        made = made + 1;
    }
    if ast.get(st, found, 8) != nargs {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return nothing();
    }
    var param = ast.get(st, found, 7);
    var arg = ast.get(st, id, 6);
    let first_arg = st[52];
    while param >= 0 && ast.ok(st) {
        if emit.on(st) && tmade > 0 && ast.is_kind(st, arg, kinds.NK::EVariant) && ast.get(st, arg, 8) == 0 {
            // `Option::None` as an argument waits for the others to say what its type is: a mark for it
            // is pushed, and the value is written below.
            emit.push_arg(st, 0 - 7, false, param, arg);
        } else {
            let a = expr(st, text, arg);
            if ast.ok(st) {
                scope.expect(st, text, callee_type(st, text, ast.get(st, param, 5), callee_dp, fresh, tvars), a.ty, ast.nstart(st, arg), ast.nend(st, arg));
                if emit.on(st) && !types.is_erased(st, a.ty) {
                    push_value(st, a);
                }
            }
        }
        param = ast.next(st, param);
        arg = ast.next(st, arg);
    }
    var slot = first_arg;
    while emit.on(st) && ast.ok(st) && slot < st[52] {
        let at = st[51] + 4 * slot;
        if st[at] == 0 - 7 {
            let waiting = st[at + 3];
            types.set_hint(st, callee_type(st, text, ast.get(st, st[at + 2], 5), callee_dp, fresh, tvars));
            let a = expr(st, text, waiting);
            types.set_hint(st, 0);
            if ast.ok(st) {
                scope.expect(st, text, callee_type(st, text, ast.get(st, st[at + 2], 5), callee_dp, fresh, tvars), a.ty, ast.nstart(st, waiting), ast.nend(st, waiting));
            }
            if ast.ok(st) && !types.is_erased(st, a.ty) {
                st[at] = a.ty;
                st[at + 1] = ast.flag(a.known);
                st[at + 2] = a.value;
                st[at + 3] = a.reg;
            } else {
                st[at] = 1;
                st[at + 1] = 1;
                st[at + 2] = 0;
                st[at + 3] = 0 - 1;
            }
        }
        slot = slot + 1;
    }
    // What the callee's `where` clauses demand of the regions the arguments solved.
    var k = 0;
    while ast.ok(st) && pass1.nth_outlive(st, callee_dp, k) >= 0 {
        let inner = pass1.nth_outlive(st, callee_dp, k);
        let got_inner = types.resolve_region(st, fresh + pass1.param_index(st, text, callee_dp, true, inner));
        let got_outer = types.resolve_region(st, fresh + pass1.param_index(st, text, callee_dp, true, inner + 2));
        if !types.outlives(st, text, got_outer, got_inner) {
            ast.fail(st, rules.r_reference_escapes_region(), from, to);
        }
        k = k + 1;
    }
    // Every type argument has to be settled by the arguments.
    var position = 0;
    while ast.ok(st) && position < tmade {
        if types.is_tvar(st, types.shallow(st, tvars + position)) {
            ast.fail(st, rules.r_ambiguous_type(), from, to);
        }
        position = position + 1;
    }
    if !ast.ok(st) {
        return nothing();
    }
    let result = types.resolve_type(st, callee_type(st, text, ast.get(st, found, 10), callee_dp, fresh, tvars));
    if emit.on(st) {
        if !types.is_plain(result) && !scope.aggregate_codable(st, result) && !scope.slice_codable(st, result) {
            return skip(st, from, to);
        }
        var inst = 0;
        if tmade > 0 {
            let made_at = instances.request(st, found, tvars, tmade);
            if made_at < 0 {
                return skip(st, from, to);
            }
            inst = made_at + 1;
        }
        let answer = emit.call(st, found, inst, result, st[52] - first_arg);
        if types.is_slice_ref(st, result) {
            return in_slice(result, answer, st[59], 0);
        }
        return in_reg(result, answer);
    }
    return plain(result);
}

// A type written in a callee's declaration, at one call: its type parameters are the variables made
// for the call (the first is `tvars`) and its region parameters the region variables.
pub fn callee_type[&s, &x](st: &!s [int], text: &x [byte], ty: int, dp: int, fresh: int, tvars: int) -> [] int {
    st[31] = tvars;
    let out = scope.lower_type(st, text, ty, dp, fresh);
    st[31] = 0 - 1;
    return out;
}

// A function whose row is plain labels and only types this slice handles: the callees it can call.
// Regions and type parameters are fine.
pub fn plain_function[&s, &x](st: &!s [int], text: &x [byte], fn_item: int) -> [] bool {
    let dp = ast.get(st, fn_item, 6);
    if !emit.on(st) && !effects.plain_row(st, effects.row_mask(st, text, fn_item)) {
        return false;
    }
    // The type parameters stand for variables that are not used again, to see that the types can be written.
    var scratch = 0 - 1;
    var made = 0;
    while emit.on(st) && made < pass1.count_params(st, dp, false) {
        let v = types.fresh_tvar(st);
        if made == 0 {
            scratch = v;
        }
        made = made + 1;
    }
    st[31] = scratch;
    var good = true;
    var param = ast.get(st, fn_item, 7);
    while param >= 0 {
        if scope.lower_type(st, text, ast.get(st, param, 5), dp, 0 - 1) == 0 {
            good = false;
        }
        param = ast.next(st, param);
    }
    if scope.lower_type(st, text, ast.get(st, fn_item, 10), dp, 0 - 1) == 0 {
        good = false;
    }
    st[31] = 0 - 1;
    return good;
}
