module selfhost.types;

// types.cho -- the types of the cancho checker's bodies, written in cancho.
//
// Stage 3d of the self-hosting spike (`docs/self-hosting.md` section 6, epic #295): a port of the
// part of `cancho-types` and `lower/mod.rs` that gives types, regions and the coercions between
// them their meaning: `Unifier::unify`, `unify_regions`, `expect_type`, `outlives`.
//
// A type is an integer. 1 to 6 are the scalars and the unit (`int`, `byte`, `float`, `f32`,
// `bool`, `()`), which are not in the table, so a scalar costs nothing; 8 and up index a table in
// the state of four slots a type: its kind, and what the kind keeps.
//
//     REF    a unique (1) or shared (0), b the region, c the referent
//     SLICE  a the element
//
// A region is an integer too: 0 and up a region parameter of the function being checked, -1 the
// `static` region, and 1000000 and up a variable, which is bound to a region or free
// (`unbound`). The table and the variables are the function's own: `check_function` resets both.
// Only what the first slice of references needs is here: references to scalars and to slices of
// scalars, in regions that are parameters, `static`, or variables a call makes.

import selfhost.ast;
import selfhost.kinds;
import selfhost.rules;
import selfhost.pass1;
import selfhost.tables;
import selfhost.builtins;

pub fn first_table() -> [] int {
    return 8;
}

fn ref_kind() -> [] int {
    return 7;
}

fn slice_kind() -> [] int {
    return 8;
}

fn named_kind() -> [] int {
    return 9;
}

fn param_kind() -> [] int {
    return 10;
}

fn tvar_kind() -> [] int {
    return 11;
}

fn prelude_kind() -> [] int {
    return 12;
}

fn boxslice_kind() -> [] int {
    return 13;
}

fn box_kind() -> [] int {
    return 14;
}

fn pair_kind() -> [] int {
    return 15;
}

fn triple_kind() -> [] int {
    return 16;
}

fn fnval_kind() -> [] int {
    return 17;
}

fn thread_kind() -> [] int {
    return 18;
}

fn fnptr_kind() -> [] int {
    return 19;
}

fn many_kind() -> [] int {
    return 20;
}

fn ext_kind() -> [] int {
    return 21;
}

fn unbound() -> [] int {
    return 0 - 100;
}

// The region of a `borrow` or `region` block, by its number: -2 is the first, -3 the second.
pub fn block_region(id: int) -> [] int {
    return 0 - 2 - id;
}

pub fn is_block(area: int) -> [] bool {
    return area <= 0 - 2;
}

pub fn block_id(area: int) -> [] int {
    return 0 - 2 - area;
}

// Does block `outer` enclose block `inner` (or is it the same)? The blocks keep their enclosing
// block in the state: entry `id` of the table at `st[36]` is its parent, or -1.
pub fn encloses[&s](st: &!s [int], outer: int, inner: int) -> [] bool {
    var current = inner;
    while current >= 0 {
        if current == outer {
            return true;
        }
        current = st[st[36] + 2 * current];
    }
    return false;
}

pub fn static_region() -> [] int {
    return 0 - 1;
}

// The region of a reference held by a struct or an enum: the code is written for programs the Rust compiler has
// accepted, so what a declaration says of regions is not followed, and this one outlives and is outlived by all.
pub fn any_region() -> [] int {
    return 500000;
}

fn var_base() -> [] int {
    return 1000000;
}

// ----------------------------------------------------------------- reset ---

pub fn reset[&s](st: &!s [int]) -> [] int {
    st[24] = first_table();
    st[26] = 0;
    st[29] = 0;
    st[31] = 0 - 1;
    return 0;
}

// ---------------------------------------------------------------- types ---

fn make[&s](st: &!s [int], kind: int, a: int, b: int, c: int) -> [] int {
    let id = st[24];
    let at = st[25] + 4 * (id - first_table());
    st[at] = kind;
    st[at + 1] = a;
    st[at + 2] = b;
    st[at + 3] = c;
    st[24] = id + 1;
    return id;
}

pub fn make_ref[&s](st: &!s [int], unique: bool, area: int, inner: int) -> [] int {
    return make(st, ref_kind(), ast.flag(unique), area, inner);
}

// A struct the file declares, by the node of its declaration.
pub fn make_named[&s](st: &!s [int], item: int) -> [] int {
    return make(st, named_kind(), item, 0, 0);
}

// A struct or an enum with type arguments (one or two): `Option[int]`, `Pair[A, B]`.
pub fn make_named_args[&s](st: &!s [int], item: int, a: int, b: int) -> [] int {
    return make(st, named_kind(), item, a, b);
}

// Argument `k` of a named type, or 0 if it has none there.
pub fn named_arg[&s](st: &!s [int], ty: int, k: int) -> [] int {
    return slot(st, ty, 2 + k);
}

// A rigid type parameter of the function being checked, by its position.
pub fn make_param[&s](st: &!s [int], index: int) -> [] int {
    return make(st, param_kind(), index, 0, 0);
}

// A fresh type variable, unsolved; the types made for the variables of one call are consecutive.
pub fn fresh_tvar[&s](st: &!s [int]) -> [] int {
    let v = st[29];
    st[st[30] + v] = 0;
    st[29] = v + 1;
    return make(st, tvar_kind(), v, 0, 0);
}

pub fn is_tvar[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == tvar_kind();
}

pub fn is_param[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == param_kind();
}

// The position of a rigid type parameter in the declaration's list.
pub fn param_position[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 1);
}

// Follow solved type variables until the head is not a solved variable.
pub fn shallow[&s](st: &!s [int], ty: int) -> [] int {
    var current = ty;
    var go = true;
    while go && is_tvar(st, current) {
        let solved = st[st[30] + slot(st, current, 1)];
        if solved == 0 {
            go = false;
        } else {
            current = solved;
        }
    }
    return current;
}

// Does the unsolved variable `var` occur in `ty`?
fn occurs[&s](st: &!s [int], tv: int, ty: int) -> [] bool {
    let t = shallow(st, ty);
    if is_tvar(st, t) {
        return slot(st, t, 1) == slot(st, tv, 1);
    }
    if is_ref(st, t) {
        return occurs(st, tv, ref_inner(st, t));
    }
    if is_slice(st, t) {
        return occurs(st, tv, slice_element(st, t));
    }
    if is_boxslice(st, t) {
        return occurs(st, tv, boxslice_element(st, t));
    }
    if is_box(st, t) {
        return occurs(st, tv, box_inner(st, t));
    }
    if is_thread(st, t) {
        return occurs(st, tv, thread_result(st, t));
    }
    if is_named(st, t) {
        var j = 0;
        while j < 2 {
            let x = named_arg(st, t, j);
            if x != 0 && occurs(st, tv, x) {
                return true;
            }
            j = j + 1;
        }
    }
    if is_tuple(st, t) {
        var k = 0;
        while k < tuple_size(st, t) {
            if occurs(st, tv, tuple_part(st, t, k)) {
                return true;
            }
            k = k + 1;
        }
    }
    return false;
}

// `ty` with every solved variable replaced by what it stands for, so nothing that leaves a call
// carries a variable.
pub fn resolve_type[&s](st: &!s [int], ty: int) -> [] int {
    let t = shallow(st, ty);
    if is_ref(st, t) {
        return make_ref(st, ref_unique(st, t), slot(st, t, 2), resolve_type(st, ref_inner(st, t)));
    }
    if is_slice(st, t) {
        return make_slice(st, resolve_type(st, slice_element(st, t)));
    }
    if is_boxslice(st, t) {
        return make_boxslice(st, resolve_type(st, boxslice_element(st, t)));
    }
    if is_box(st, t) {
        return make_box(st, resolve_type(st, box_inner(st, t)));
    }
    if is_thread(st, t) {
        var given = thread_payload(st, t);
        if given != 0 {
            given = resolve_type(st, given);
        }
        return make_thread(st, given, resolve_type(st, thread_result(st, t)));
    }
    if is_named(st, t) && named_arg(st, t, 0) != 0 {
        var b = named_arg(st, t, 1);
        if b != 0 {
            b = resolve_type(st, b);
        }
        return make_named_args(st, named_item(st, t), resolve_type(st, named_arg(st, t, 0)), b);
    }
    if is_tuple(st, t) && tuple_size(st, t) > 3 {
        let many = make_many(st, tuple_size(st, t));
        var k = 0;
        while k < tuple_size(st, t) {
            set_part(st, many, k, resolve_type(st, tuple_part(st, t, k)));
            k = k + 1;
        }
        return many;
    }
    if is_tuple(st, t) {
        let c = tuple_size(st, t) == 3;
        if c {
            return make_triple(st, resolve_type(st, tuple_part(st, t, 0)), resolve_type(st, tuple_part(st, t, 1)), resolve_type(st, tuple_part(st, t, 2)));
        }
        return make_pair(st, resolve_type(st, tuple_part(st, t, 0)), resolve_type(st, tuple_part(st, t, 1)));
    }
    return t;
}

// A prelude type without arguments, by its index in `tables.cho`: `World`, so far.
pub fn make_prelude[&s](st: &!s [int], index: int) -> [] int {
    return make(st, prelude_kind(), index, 0, 0);
}

// A prelude type that a capability narrowed to a literal is: the type, and the token of the string
// literal it was narrowed to (`Fs("/tmp")`, `narrow(exec, "/bin")`), kept one more than it is so that
// 0 says there is none. The code uses it to check a path against the prefix.
pub fn make_prelude_lit[&s](st: &!s [int], index: int, tok: int) -> [] int {
    return make(st, prelude_kind(), index, 0, tok + 1);
}

// The token of the literal a prelude type was narrowed to, or -1.
pub fn prelude_lit_tok[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 3) - 1;
}

// The index in `tables.cho` of a prelude type.
pub fn prelude_index[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 1);
}

// `Box[[T]]`, an owned run on the heap: a pointer and a length, one aggregate in the code. Only the
// code is written for it; the checker answers `SKIP` for a function that has one.
pub fn make_boxslice[&s](st: &!s [int], element: int) -> [] int {
    return make(st, boxslice_kind(), element, 0, 0);
}

pub fn is_boxslice[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == boxslice_kind();
}

pub fn boxslice_element[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 1);
}

// The type a resolved type node stands for in a declaration -- a field, a payload -- when code is
// written for it: a whole number, byte or boolean (its tag), a struct or an enum of the file, or a
// `Box[[T]]` of those scalars; else 0.
pub fn node_type[&s](st: &!s [int], node: int, ctx: int) -> [] int {
    if ast.is_kind(st, node, kinds.NK::TTuple) {
        let n = ast.get(st, node, 7);
        if n < 2 || n > 8 {
            return 0;
        }
        var many = 0;
        if n > 3 {
            many = make_many(st, n);
        }
        var part = ast.get(st, node, 6);
        var k = 0;
        var a = 0;
        var b = 0;
        var c = 0;
        while k < n {
            let t = node_type(st, part, ctx);
            if t == 0 {
                return 0;
            }
            if n > 3 {
                set_part(st, many, k, t);
            } else if k == 0 {
                a = t;
            } else if k == 1 {
                b = t;
            } else {
                c = t;
            }
            part = ast.next(st, part);
            k = k + 1;
        }
        if n > 3 {
            return many;
        }
        return make_tuple(st, n, a, b, c);
    }
    if ast.is_kind(st, node, kinds.NK::TRef) {
        // A reference held in a declaration: to a whole number, a byte, a boolean or a struct, or to a run of
        // those.
        let inner = ast.get(st, node, 6);
        var referent = 0;
        if ast.is_kind(st, inner, kinds.NK::TSlice) {
            let element = node_type(st, ast.get(st, inner, 6), ctx);
            if is_plain(element) || is_named(st, element) || is_tuple(st, element) || is_tvar(st, element) {
                referent = make_slice(st, element);
            }
        } else {
            referent = node_type(st, inner, ctx);
        }
        if referent == 0 {
            return 0;
        }
        return make_ref(st, ast.get(st, node, 4) != 0, any_region(), referent);
    }
    if !ast.is_kind(st, node, kinds.NK::TName) {
        return 0;
    }
    let kind = ast.get(st, node, 8);
    if kind == 0 {
        return ast.get(st, node, 10);
    }
    if kind == 1 {
        // A type parameter: of the declaration the node is in (the arguments of the type `ctx`), or of the
        // function being compiled -- the variables of the call whose signature this is, or the instance.
        let k = ast.get(st, node, 9);
        if ctx >= 0 {
            return shallow(st, named_arg(st, shallow(st, ctx), k));
        }
        if st[31] >= 0 {
            return st[31] + k;
        }
        if st[63] > 0 {
            return env_arg(st, k);
        }
        // Rigid in the definition that declares it.
        return make_param(st, k);
    }
    if kind == 3 {
        let item = ast.get(st, node, 9);
        let n = ast.get(st, node, 7);
        if n == 0 {
            return make_named(st, item);
        }
        if n > 2 {
            return 0;
        }
        let head = ast.get(st, node, 6);
        let a = node_type(st, head, ctx);
        var b = 0;
        if n == 2 {
            b = node_type(st, ast.next(st, head), ctx);
        }
        if a == 0 || n == 2 && b == 0 {
            return 0;
        }
        return make_named_args(st, item, a, b);
    }
    if kind == 2 && ast.get(st, node, 9) == tables.prelude_thread() && ast.get(st, node, 7) == 2 {
        // `Thread[T, R]` written in a declaration: what `join` gives back is all the code needs.
        let answer = node_type(st, ast.next(st, ast.get(st, node, 6)), ctx);
        if answer == 0 {
            return 0;
        }
        var given = node_type(st, ast.get(st, node, 6), ctx);
        return make_thread(st, given, answer);
    }
    if kind == 2 && ast.get(st, node, 9) != tables.prelude_box() {
        // A capability or a handle or a prelude enum written in a declaration, narrowed to a literal or not.
        if ast.get(st, node, 7) == 0 {
            return make_prelude(st, ast.get(st, node, 9));
        }
        if ast.get(st, node, 7) == 1 && ast.is_kind(st, ast.get(st, node, 6), kinds.NK::TLit) {
            return make_prelude_lit(st, ast.get(st, node, 9), ast.get(st, ast.get(st, node, 6), 4));
        }
        return 0;
    }
    if kind == 2 && ast.get(st, node, 9) == tables.prelude_box() && ast.get(st, node, 7) == 1 {
        let arg = ast.get(st, node, 6);
        if ast.is_kind(st, arg, kinds.NK::TSlice) {
            let element = node_type(st, ast.get(st, arg, 6), ctx);
            if is_plain(element) || is_named(st, element) || is_tuple(st, element) || is_tvar(st, element) {
                return make_boxslice(st, element);
            }
            return 0;
        }
        // One value on the heap: a pointer, whatever it points at, so a type that holds itself through a
        // box is no recursion for the code.
        let inner = node_type(st, arg, ctx);
        if inner != 0 {
            return make_box(st, inner);
        }
    }
    return 0;
}

// A struct or an enum with its type parameters standing for variables not yet solved: what a literal of
// a generic declaration is until the values it holds, or the type it is expected to be, say.
pub fn fresh_named[&s](st: &!s [int], item: int, n: int) -> [] int {
    let a = fresh_tvar(st);
    var b = 0;
    if n == 2 {
        b = fresh_tvar(st);
    }
    return make_named_args(st, item, a, b);
}

// The type the expression being written is expected to have, if the code knows: set by a `let` that
// says a type and by a `return`, read by a literal of a generic declaration that has nothing else to learn its
// parameters from (`Option::None`). 0 when there is none.
pub fn hint[&s](st: &!s [int]) -> [] int {
    if st[40] == 0 {
        return 0;
    }
    return st[st[62] + ast.const_region() + 12];
}

pub fn set_hint[&s](st: &!s [int], ty: int) -> [] int {
    if st[40] == 0 {
        return 0;
    }
    st[st[62] + ast.const_region() + 12] = ty;
    return 0;
}

// Argument `k` of the instance of a generic function being compiled (`instances.cho` keeps them).
pub fn env_arg[&s](st: &!s [int], k: int) -> [] int {
    return st[st[62] + ast.const_region() + 3 + k];
}

// A function used as a value (`let w = worker;`), in the code only: the function's item. A pointer.
pub fn make_fnval[&s](st: &!s [int], item: int) -> [] int {
    return make(st, fnval_kind(), item, 0, 0);
}

pub fn is_fnval[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == fnval_kind();
}

pub fn fnval_item[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 1);
}

// A function held in a parameter or a name by its type, `fn(A, B) -> R`: a pointer. Its result, how many
// parameters it has (up to three), and the parameters (the one, or a tuple of them). Only the code is written
// for it, in a function that has no type parameters.
pub fn make_fnptr[&s](st: &!s [int], ret: int, n: int, a: int, b: int, c: int) -> [] int {
    var packed = a;
    if n > 1 {
        packed = make_tuple(st, n, a, b, c);
    }
    return make(st, fnptr_kind(), ret, n, packed);
}

pub fn is_fnptr[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == fnptr_kind();
}

pub fn fnptr_ret[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 1);
}

pub fn fnptr_count[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 2);
}

pub fn fnptr_param[&s](st: &!s [int], ty: int, k: int) -> [] int {
    if slot(st, ty, 2) == 1 {
        return slot(st, ty, 3);
    }
    return tuple_part(st, slot(st, ty, 3), k);
}

// `Thread[T, R]` as `spawn` answers it: what the thread returns is all `join` needs. A pointer (the
// `pthread_t`), a value that must be joined.
pub fn make_thread[&s](st: &!s [int], payload: int, result: int) -> [] int {
    return make(st, thread_kind(), result, payload, 0);
}

// What the thread was given (0 when it was not written): the references in it are the thread's to hold, and so the
// handle cannot outlive the block they point into.
pub fn thread_payload[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 2);
}

pub fn is_thread[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == thread_kind();
}

pub fn thread_result[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 1);
}

// `Box[T]`, one value of any type on the heap: a pointer in the code.
pub fn make_box[&s](st: &!s [int], inner: int) -> [] int {
    return make(st, box_kind(), inner, 0, 0);
}

pub fn is_box[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == box_kind();
}

pub fn box_inner[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 1);
}

// A tuple of two or three parts: an anonymous struct, an aggregate in the code. (Larger ones have no code.)
pub fn make_pair[&s](st: &!s [int], a: int, b: int) -> [] int {
    return make(st, pair_kind(), a, b, 0);
}

pub fn make_triple[&s](st: &!s [int], a: int, b: int, c: int) -> [] int {
    return make(st, triple_kind(), a, b, c);
}

pub fn is_tuple[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && (slot(st, ty, 0) == pair_kind() || slot(st, ty, 0) == triple_kind() || slot(st, ty, 0) == many_kind());
}

pub fn tuple_size[&s](st: &!s [int], ty: int) -> [] int {
    if slot(st, ty, 0) == many_kind() {
        return slot(st, ty + 1, 1);
    }
    if slot(st, ty, 0) == triple_kind() {
        return 3;
    }
    return 2;
}

// Part `k` of a tuple. A tuple of more than three has its first three in its entry, and the others in the entries
// that follow, three to an entry after the number of parts.
pub fn tuple_part[&s](st: &!s [int], ty: int, k: int) -> [] int {
    if k >= 3 {
        return slot(st, ty + 1 + (k - 2) / 3, 1 + (k - 2) % 3);
    }
    return slot(st, ty, 1 + k);
}

// A tuple of `n` parts, from four to eight, whose parts are put with `set_part`.
pub fn make_many[&s](st: &!s [int], n: int) -> [] int {
    let id = make(st, many_kind(), 0, 0, 0);
    var j = 0;
    while j < n / 3 {
        var count = 0;
        if j == 0 {
            count = n;
        }
        make(st, ext_kind(), count, 0, 0);
        j = j + 1;
    }
    return id;
}

pub fn set_part[&s](st: &!s [int], ty: int, k: int, part: int) -> [] int {
    var entry = ty;
    var at = 1 + k;
    if k >= 3 {
        entry = ty + 1 + (k - 2) / 3;
        at = 1 + (k - 2) % 3;
    }
    st[st[25] + 4 * (entry - first_table()) + at] = part;
    return 0;
}

// A tuple made of the parts, or 0 if it has none the code is written for.
pub fn make_tuple[&s](st: &!s [int], n: int, a: int, b: int, c: int) -> [] int {
    if n == 2 {
        return make_pair(st, a, b);
    }
    if n == 3 {
        return make_triple(st, a, b, c);
    }
    return 0;
}

// A prelude type that is a handle: a descriptor or a pid, one value of the code.
pub fn is_handle[&s](st: &!s [int], ty: int) -> [] bool {
    return is_prelude(st, ty) && tables.prelude_leaf(prelude_index(st, ty)) == 1;
}

// A prelude enum (`Spawned`, `Opened`, `Read`): a tag and the payloads of its arms, one aggregate.
pub fn is_penum[&s](st: &!s [int], ty: int) -> [] bool {
    return is_prelude(st, ty) && builtins.prelude_arm_count(prelude_index(st, ty)) > 0;
}

// A prelude type that is nothing in the code: a capability, the `World`, a `Split`.
// A scalar the code has a representation for: `int`, `byte`, `float`, `f32` and `bool`.
pub fn is_plain(t: int) -> [] bool {
    return t >= 1 && t <= 5;
}

pub fn is_erased[&s](st: &!s [int], ty: int) -> [] bool {
    if is_tuple(st, ty) {
        var k = 0;
        while k < tuple_size(st, ty) {
            if !is_erased(st, tuple_part(st, ty, k)) {
                return false;
            }
            k = k + 1;
        }
        return true;
    }
    return is_prelude(st, ty) && !is_handle(st, ty) && !is_penum(st, ty);
}

// A reference to a slice: a pointer and a length in the code.
pub fn is_slice_ref[&s](st: &!s [int], ty: int) -> [] bool {
    return is_ref(st, ty) && is_slice(st, ref_inner(st, ty));
}

pub fn is_prelude[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == prelude_kind();
}

pub fn make_slice[&s](st: &!s [int], element: int) -> [] int {
    return make(st, slice_kind(), element, 0, 0);
}

fn slot[&s](st: &!s [int], ty: int, k: int) -> [] int {
    return st[st[25] + 4 * (ty - first_table()) + k];
}

pub fn is_ref[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == ref_kind();
}

pub fn is_slice[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == slice_kind();
}

pub fn is_named[&s](st: &!s [int], ty: int) -> [] bool {
    return ty >= first_table() && slot(st, ty, 0) == named_kind();
}

pub fn named_item[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 1);
}

pub fn ref_unique[&s](st: &!s [int], ty: int) -> [] bool {
    return slot(st, ty, 1) != 0;
}

// The region of a reference, followed through the variables that are bound.
pub fn ref_region[&s](st: &!s [int], ty: int) -> [] int {
    return resolve_region(st, slot(st, ty, 2));
}

pub fn ref_inner[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 3);
}

pub fn slice_element[&s](st: &!s [int], ty: int) -> [] int {
    return slot(st, ty, 1);
}

// The element type of a reference to a slice (`element_of`), or 0 if the type is not one.
pub fn element_of[&s](st: &!s [int], ty: int) -> [] int {
    if is_ref(st, ty) && is_slice(st, ref_inner(st, ty)) {
        return slice_element(st, ref_inner(st, ty));
    }
    return 0;
}

// Does a reference in the type point into a block, a `borrow` or an arena? Nothing of the sort may
// leave the function.
pub fn mentions_block[&s](st: &!s [int], ty: int) -> [] bool {
    var t = resolve_type(st, ty);
    if is_thread(st, t) {
        return thread_payload(st, t) != 0 && mentions_block(st, thread_payload(st, t));
    }
    while is_ref(st, t) || is_slice(st, t) {
        if is_slice(st, t) {
            t = slice_element(st, t);
        } else {
            if is_block(ref_region(st, t)) {
                return true;
            }
            t = ref_inner(st, t);
        }
    }
    return false;
}

// ------------------------------------------------------------- regions ---

pub fn is_var(area: int) -> [] bool {
    return area >= var_base();
}

// A new region variable, free.
pub fn fresh_region[&s](st: &!s [int]) -> [] int {
    let v = st[26];
    st[st[27] + v] = unbound();
    st[26] = v + 1;
    return var_base() + v;
}

// Follow bound variables until the head is not a bound variable.
pub fn resolve_region[&s](st: &!s [int], area: int) -> [] int {
    var current = area;
    var go = true;
    while go && is_var(current) {
        let bound = st[st[27] + (current - var_base())];
        if bound == unbound() {
            go = false;
        } else {
            current = bound;
        }
    }
    return current;
}

// Make two regions one, or say they are different (`unify_regions`): a free variable takes
// the other region, and two regions that are not variables must already be equal.
pub fn unify_regions[&s](st: &!s [int], expected: int, found: int) -> [] bool {
    let a = resolve_region(st, expected);
    let b = resolve_region(st, found);
    if a == b || a == any_region() || b == any_region() {
        return true;
    }
    if is_var(a) {
        st[st[27] + (a - var_base())] = b;
        return true;
    }
    if is_var(b) {
        st[st[27] + (b - var_base())] = a;
        return true;
    }
    return false;
}

// Does the region parameter `from` reach `target` along the function's `where` pairs, in at
// most `fuel` steps? `where a <= b` is the pair that leads from `a` to `b`.
fn reaches[&s, &x](st: &!s [int], text: &x [byte], from: int, target: int, fuel: int) -> [] bool {
    if from == target {
        return true;
    }
    if fuel == 0 {
        return false;
    }
    var k = 0;
    while pass1.nth_outlive(st, st[28], k) >= 0 {
        let inner = pass1.nth_outlive(st, st[28], k);
        if pass1.param_index(st, text, st[28], true, inner) == from {
            let next = pass1.param_index(st, text, st[28], true, inner + 2);
            if reaches(st, text, next, target, fuel - 1) {
                return true;
            }
        }
        k = k + 1;
    }
    return false;
}

// Does region `outer` outlive region `inner` (`outlives`)? A region parameter outlives another
// as the declaration's `where` clauses say, reflexively and transitively; `static` outlives all;
// a variable that is still free outlives nothing but itself.
pub fn outlives[&s, &x](st: &!s [int], text: &x [byte], outer: int, inner: int) -> [] bool {
    if outer == inner || outer == any_region() || inner == any_region() {
        return true;
    }
    if outer == static_region() {
        return true;
    }
    if inner == static_region() {
        return false;
    }
    if is_block(outer) && is_block(inner) {
        return encloses(st, block_id(outer), block_id(inner));
    }
    // A region parameter is open for the whole body, so it outlives every block in it.
    if is_block(inner) && outer >= 0 && !is_var(outer) {
        return true;
    }
    if outer >= 0 && inner >= 0 && !is_var(outer) && !is_var(inner) {
        return reaches(st, text, inner, outer, pass1.count_params(st, st[28], true) + 1);
    }
    return false;
}

// ------------------------------------------------------ equality, coercion ---

// Does `ty` mention a block region that does not enclose `scope`, the innermost block open where
// something was declared (-1 for none)? Answers that region's block, or -1.
pub fn escaping_block[&s](st: &!s [int], ty: int, scope: int) -> [] int {
    let t = shallow(st, ty);
    if is_ref(st, t) {
        let area = ref_region(st, t);
        if is_block(area) && !encloses(st, block_id(area), scope) {
            return block_id(area);
        }
        return escaping_block(st, ref_inner(st, t), scope);
    }
    if is_slice(st, t) {
        return escaping_block(st, slice_element(st, t), scope);
    }
    if is_thread(st, t) && thread_payload(st, t) != 0 {
        return escaping_block(st, thread_payload(st, t), scope);
    }
    return 0 - 1;
}

// What unifying two types came to: 0 they are the same, 1 they mismatch (a `type-mismatch`),
// 2 their regions are different (a `region-mismatch`). A free region variable is bound to the
// region it meets.
pub fn unify[&s](st: &!s [int], want: int, got: int) -> [] int {
    let expected = shallow(st, want);
    let found = shallow(st, got);
    if is_tvar(st, expected) || is_tvar(st, found) {
        if is_tvar(st, expected) && is_tvar(st, found) && slot(st, expected, 1) == slot(st, found, 1) {
            return 0;
        }
        var bound = expected;
        var other = found;
        if !is_tvar(st, expected) {
            bound = found;
            other = expected;
        }
        if occurs(st, bound, other) {
            return 3;
        }
        st[st[30] + slot(st, bound, 1)] = other;
        return 0;
    }
    if expected < first_table() || found < first_table() {
        if expected == found {
            return 0;
        }
        return 1;
    }
    if is_ref(st, expected) && is_ref(st, found) {
        if ref_unique(st, expected) != ref_unique(st, found) {
            return 1;
        }
        if !unify_regions(st, slot(st, expected, 2), slot(st, found, 2)) {
            return 2;
        }
        return unify(st, ref_inner(st, expected), ref_inner(st, found));
    }
    if is_slice(st, expected) && is_slice(st, found) {
        return unify(st, slice_element(st, expected), slice_element(st, found));
    }
    if is_named(st, expected) && is_named(st, found) && named_item(st, expected) == named_item(st, found) {
        // The same declaration: its arguments, where it has any.
        var k = 0;
        while k < 2 {
            let x = named_arg(st, expected, k);
            let y = named_arg(st, found, k);
            if x != 0 && y != 0 {
                let r = unify(st, x, y);
                if r != 0 {
                    return r;
                }
            }
            k = k + 1;
        }
        return 0;
    }
    if is_param(st, expected) && is_param(st, found) && slot(st, expected, 1) == slot(st, found, 1) {
        return 0;
    }
    if is_fnptr(st, expected) && (is_fnval(st, found) || is_fnptr(st, found) && fnptr_count(st, expected) == fnptr_count(st, found)) {
        // A function named where a function of a type is wanted: the code is written for programs the Rust
        // compiler has accepted, so the signatures are not compared.
        if is_fnptr(st, found) {
            var k = 0;
            while k < fnptr_count(st, expected) {
                let r = unify(st, fnptr_param(st, expected, k), fnptr_param(st, found, k));
                if r != 0 {
                    return r;
                }
                k = k + 1;
            }
            return unify(st, fnptr_ret(st, expected), fnptr_ret(st, found));
        }
        return 0;
    }
    if is_prelude(st, expected) && is_prelude(st, found) && slot(st, expected, 1) == slot(st, found, 1) {
        return 0;
    }
    if is_boxslice(st, expected) && is_boxslice(st, found) {
        return unify(st, boxslice_element(st, expected), boxslice_element(st, found));
    }
    if is_thread(st, expected) && is_thread(st, found) {
        return unify(st, thread_result(st, expected), thread_result(st, found));
    }
    if is_box(st, expected) && is_box(st, found) {
        return unify(st, box_inner(st, expected), box_inner(st, found));
    }
    if is_tuple(st, expected) && is_tuple(st, found) && tuple_size(st, expected) == tuple_size(st, found) {
        var k = 0;
        while k < tuple_size(st, expected) {
            let r = unify(st, tuple_part(st, expected, k), tuple_part(st, found, k));
            if r != 0 {
                return r;
            }
            k = k + 1;
        }
        return 0;
    }
    return 1;
}

fn report[&s](st: &!s [int], status: int, from: int, to: int) -> [] int {
    if status == 1 {
        ast.fail(st, rules.r_type_mismatch(), from, to);
    }
    if status == 2 {
        ast.fail(st, rules.r_region_mismatch(), from, to);
    }
    if status == 3 {
        ast.fail(st, rules.r_infinite_type(), from, to);
    }
    return status;
}

// `expect_type`: `found` is usable where `expected` is wanted. Equality, with two coercions on
// top and no others: a reference whose region outlives the expected one is accepted, and a
// unique reference where a shared one is expected, never the reverse. The referent is invariant.
pub fn expect_type[&s, &x](st: &!s [int], text: &x [byte], want: int, got: int, from: int, to: int) -> [] int {
    let expected = shallow(st, want);
    let found = shallow(st, got);
    if is_ref(st, expected) && is_ref(st, found) {
        let want_unique = ref_unique(st, expected);
        let got_unique = ref_unique(st, found);
        if want_unique == got_unique || !want_unique && got_unique {
            let wanted = ref_region(st, expected);
            let given = ref_region(st, found);
            if is_var(wanted) || is_var(given) {
                unify_regions(st, wanted, given);
            } else if !outlives(st, text, given, wanted) {
                ast.fail(st, rules.r_reference_escapes_region(), from, to);
                return 0;
            }
            return report(st, unify(st, ref_inner(st, expected), ref_inner(st, found)), from, to);
        }
    }
    return report(st, unify(st, expected, found), from, to);
}
