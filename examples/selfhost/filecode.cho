module selfhost.filecode;

// filecode.cho -- the code for the operations on an open file that `runtime.ll` has the functions of: a read or a
// write at an offset, the sync, the truncation, the size, the lock, and the removal and renaming of a path under a
// prefix. The arguments are on the argument stack; each call answers one whole number, the count or minus the errno.

import selfhost.emit;
import selfhost.pass1;
import selfhost.prims;

// `file_pwrite(file, at, bytes)` (111), `file_pread(file, at, into)` (112), `file_sync(file)` (113),
// `file_truncate(file, len)` (114), `file_size(file)` (115) and `file_lock(file)` (116). The file is borrowed, so the
// argument is the address of its slot.
pub fn on_handle[&s](st: &!s [int], which: int) -> [] int {
    var n = 1;
    if which == 111 || which == 112 {
        n = 4;
    } else if which == 114 {
        n = 2;
    }
    let fd = emit.start(st);
    emit.str(st, "load i64, ptr ");
    arg_operand(st, n, 7);
    emit.str(st, "\n");
    let r = emit.start(st);
    emit.str(st, "call i64 @cancho_fd_");
    if which == 111 {
        emit.str(st, "pwrite");
    } else if which == 112 {
        emit.str(st, "pread");
    } else if which == 113 {
        emit.str(st, "sync");
    } else if which == 114 {
        emit.str(st, "truncate");
    } else if which == 115 {
        emit.str(st, "size");
    } else {
        emit.str(st, "lock");
    }
    emit.str(st, "(i64 ");
    emit.temp(st, fd);
    if which == 111 || which == 112 {
        emit.str(st, ", ptr ");
        arg_operand(st, 2, 7);
        emit.str(st, ", i64 ");
        arg_operand(st, 1, 1);
        emit.str(st, ", i64 ");
        arg_operand(st, 3, 1);
    } else if which == 114 {
        emit.str(st, ", i64 ");
        arg_operand(st, 1, 1);
    }
    emit.str(st, ")\n");
    st[52] = st[52] - n;
    return r;
}

// `fs_remove(fs, path)` (the path and the prefix, a pointer and a length each) and `fs_rename(fs, from, to)` (the
// two paths, then the prefix).
pub fn on_path[&s](st: &!s [int], renaming: bool) -> [] int {
    let r = emit.start(st);
    if renaming {
        emit.str(st, "call i64 @cancho_fs_rename(ptr ");
        arg_operand(st, 6, 7);
        emit.str(st, ", i64 ");
        arg_operand(st, 5, 1);
        emit.str(st, ", ptr ");
        arg_operand(st, 4, 7);
        emit.str(st, ", i64 ");
        arg_operand(st, 3, 1);
        emit.str(st, ", ptr ");
        arg_operand(st, 2, 7);
        emit.str(st, ", i64 ");
        arg_operand(st, 1, 1);
        emit.str(st, ")\n");
        st[52] = st[52] - 6;
        return r;
    }
    emit.str(st, "call i64 @cancho_fs_unlink(ptr ");
    arg_operand(st, 4, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 3, 1);
    emit.str(st, ", ptr ");
    arg_operand(st, 2, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 1, 1);
    emit.str(st, ")\n");
    st[52] = st[52] - 4;
    return r;
}

// -------------------------------------------------------------- files, processes, arguments ---
//
// What these builtins do is in `runtime.ll`; here is the call and the answer. A call pops the arguments
// the walk pushed (`push_value`): a slice is two, a handle borrowed one (the address of its slot), a
// handle given one.

// The argument `k` from the top of the stack of arguments, printed as an operand of type `ty`.
pub fn arg_operand[&s](st: &!s [int], k: int, ty: int) -> [] int {
    let at = st[51] + 4 * (st[52] - k);
    return emit.operand(st, ty, st[at + 1] != 0, st[at + 2], st[at + 3]);
}

// `arg_count(args)`: argc.
pub fn command_count[&s](st: &!s [int]) -> [] int {
    let n = emit.start(st);
    emit.str(st, "load i64, ptr @cancho_argc\n");
    st[52] = st[52] - 1;
    return n;
}

// `arg(args, n)`: argument n of the command line; the pointer, its length left in `st[59]`.
pub fn command_arg[&s](st: &!s [int]) -> [] int {
    let p = emit.start(st);
    emit.str(st, "call ptr @cancho_arg(i64 ");
    arg_operand(st, 1, 1);
    emit.str(st, ")\n");
    let n = emit.start(st);
    emit.str(st, "call i64 @strlen(ptr ");
    emit.temp(st, p);
    emit.str(st, ")\n");
    st[59] = n;
    st[52] = st[52] - 2;
    return p;
}

// `file_write(file, bytes)` (0) and `file_read(file, into)` (1): the count or minus the errno. The
// handle is borrowed, so the argument is the address of its slot.
pub fn fd_transfer[&s](st: &!s [int], reading: bool) -> [] int {
    let fd = emit.start(st);
    emit.str(st, "load i64, ptr ");
    arg_operand(st, 3, 7);
    emit.str(st, "\n");
    let n = emit.start(st);
    if reading {
        emit.str(st, "call i64 @cancho_fd_read(i64 ");
    } else {
        emit.str(st, "call i64 @cancho_fd_write(i64 ");
    }
    emit.temp(st, fd);
    emit.str(st, ", ptr ");
    arg_operand(st, 2, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 1, 1);
    emit.str(st, ")\n");
    st[52] = st[52] - 3;
    return n;
}

// `file_close(file)`: what `close(2)` answered.
pub fn fd_close[&s](st: &!s [int]) -> [] int {
    let n = emit.start(st);
    emit.str(st, "call i64 @cancho_fd_close(i64 ");
    arg_operand(st, 1, 1);
    emit.str(st, ")\n");
    st[52] = st[52] - 1;
    return n;
}

// `child_wait(child)`: the exit code, 256 and the signal, or minus the errno.
pub fn wait_child[&s](st: &!s [int]) -> [] int {
    let n = emit.start(st);
    emit.str(st, "call i64 @cancho_wait(i64 ");
    arg_operand(st, 1, 1);
    emit.str(st, ")\n");
    st[52] = st[52] - 1;
    return n;
}

// `child_pid(&child)`: the pid, read out of the slot the reference points at.
pub fn pid_of_child[&s](st: &!s [int]) -> [] int {
    let n = emit.start(st);
    emit.str(st, "call i64 @cancho_child_pid(ptr ");
    arg_operand(st, 1, 7);
    emit.str(st, ")\n");
    st[52] = st[52] - 1;
    return n;
}

// `child_release(child)`: the child is let go, and a thread of the runtime reaps it; 0, or the errno of the thread.
pub fn let_go_child[&s](st: &!s [int]) -> [] int {
    let n = emit.start(st);
    emit.str(st, "call i64 @cancho_child_let_go(i64 ");
    arg_operand(st, 1, 1);
    emit.str(st, ")\n");
    st[52] = st[52] - 1;
    return n;
}

// `open_read` (0), `open_write` (1), `open_append` (2), `open_new` (3) and `open_rw` (4): a descriptor or minus the
// errno. The arguments are the path (a pointer and a length) and the prefix (the same).
pub fn open_path[&s](st: &!s [int], mode: int) -> [] int {
    let n = emit.start(st);
    emit.str(st, "call i64 @cancho_open(ptr ");
    arg_operand(st, 4, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 3, 1);
    emit.str(st, ", ptr ");
    arg_operand(st, 2, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 1, 1);
    emit.str(st, ", i64 ");
    emit.nat(st, mode);
    emit.str(st, ")\n");
    st[52] = st[52] - 4;
    return n;
}

// `fs_read` (0) and `fs_write` (1): the path and the prefix (a pointer and a length each) and the bytes.
pub fn fs_once[&s](st: &!s [int], writing: bool) -> [] int {
    let n = emit.start(st);
    emit.str(st, "call i64 @cancho_fs_once(ptr ");
    arg_operand(st, 6, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 5, 1);
    emit.str(st, ", ptr ");
    arg_operand(st, 4, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 3, 1);
    emit.str(st, ", ptr ");
    arg_operand(st, 2, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 1, 1);
    emit.str(st, ", i64 ");
    if writing {
        emit.str(st, "1");
    } else {
        emit.str(st, "0");
    }
    emit.str(st, ")\n");
    st[52] = st[52] - 6;
    return n;
}

// `exec_spawn`: the path, the prefix, the arguments and the environment (a pointer and a length each), then the
// three streams as (tag, the child's end, the file) each, the directory the child starts in (a pointer, or none) and
// whether it leads a session of its own (`exec_spawn_detached`): the pid or minus the errno.
pub fn spawn_process[&s](st: &!s [int]) -> [] int {
    let n = emit.start(st);
    emit.str(st, "call i64 @cancho_spawn(");
    var k = 19;
    while k >= 1 {
        let at = st[51] + 4 * (st[52] - k);
        if k != 19 {
            emit.str(st, ", ");
        }
        // pointers are the first seven of the first eight and the directory; the rest are whole numbers
        if k == 19 || k == 17 || k == 15 || k == 13 || k == 2 {
            emit.str(st, "ptr ");
            emit.operand(st, 7, false, 0, st[at + 3]);
        } else {
            emit.str(st, "i64 ");
            emit.operand(st, 1, st[at + 1] != 0, st[at + 2], st[at + 3]);
        }
        k = k - 1;
    }
    emit.str(st, ")\n");
    st[52] = st[52] - 19;
    return n;
}

// The answer of a builtin as the value of the prelude enum `ty`, from the raw result `v` (a count, a
// descriptor, a pid... or minus the errno): `kind` 0 is `Ok(v)` or `Failed(errno)` (`Opened`, `Done`,
// `Spawned`), 1 a read (`Data(v)` for more than 0, `End` at 0, else `Failed`), 2 an exit status (`Code(v)` below
// 256, `Signaled(v - 256)`, else `Failed`).
pub fn answer_enum[&s](st: &!s [int], ty: int, kind: int, v: int) -> [] int {
    var negative = emit.start(st);
    emit.str(st, "icmp slt i64 ");
    emit.temp(st, v);
    emit.str(st, ", 0\n");
    if kind == 3 {
        // A spawn: a refusal is minus the errno (all ones in the high half); a child whose `pidfd` was refused is a
        // word with the negated errno in the high half, which is a child all the same.
        let high = emit.start(st);
        emit.str(st, "ashr i64 ");
        emit.temp(st, v);
        emit.str(st, ", 32\n");
        negative = emit.start(st);
        emit.str(st, "icmp eq i64 ");
        emit.temp(st, high);
        emit.str(st, ", -1\n");
    }
    let flipped = emit.start(st);
    emit.str(st, "sub i64 0, ");
    emit.temp(st, v);
    emit.str(st, "\n");
    var tag = 0;
    var third = 0 - 1;
    if kind == 0 || kind == 3 {
        tag = emit.start(st);
        emit.str(st, "select i1 ");
        emit.temp(st, negative);
        emit.str(st, ", i64 1, i64 0\n");
    } else if kind == 1 {
        let empty = emit.start(st);
        emit.str(st, "icmp eq i64 ");
        emit.temp(st, v);
        emit.str(st, ", 0\n");
        let middle = emit.start(st);
        emit.str(st, "select i1 ");
        emit.temp(st, empty);
        emit.str(st, ", i64 1, i64 0\n");
        tag = emit.start(st);
        emit.str(st, "select i1 ");
        emit.temp(st, negative);
        emit.str(st, ", i64 2, i64 ");
        emit.temp(st, middle);
        emit.str(st, "\n");
    } else {
        let killed = emit.start(st);
        emit.str(st, "icmp sge i64 ");
        emit.temp(st, v);
        emit.str(st, ", 256\n");
        let middle = emit.start(st);
        emit.str(st, "select i1 ");
        emit.temp(st, killed);
        emit.str(st, ", i64 1, i64 0\n");
        tag = emit.start(st);
        emit.str(st, "select i1 ");
        emit.temp(st, negative);
        emit.str(st, ", i64 2, i64 ");
        emit.temp(st, middle);
        emit.str(st, "\n");
        third = emit.start(st);
        emit.str(st, "sub i64 ");
        emit.temp(st, v);
        emit.str(st, ", 256\n");
    }
    var acc = emit.insert_at(st, ty, 0 - 1, 0, 1, false, 0, tag);
    acc = emit.insert_at(st, ty, acc, 1, 1, false, 0, v);
    if kind == 2 {
        acc = emit.insert_at(st, ty, acc, 2, 1, false, 0, third);
        acc = emit.insert_at(st, ty, acc, 3, 1, false, 0, flipped);
    } else {
        acc = emit.insert_at(st, ty, acc, 2, 1, false, 0, flipped);
    }
    return acc;
}

// Which builtin of `exprs.capability_call` the call named `callee` is, or 0: 1 `narrow`, 2 to 6 `open_read`, `open_write`,
// `open_append`, `open_new` and `open_rw`, 7 `exec_spawn`, 8 `fs_read`, 9 `fs_write`, 10 `exec_spawn_in`, 11 `fs_remove`,
// 12 `fs_rename`, 13 `exec_spawn_detached`, 14 `exec_covers`, 15 `fs_covers`, 16 `exec_spawn_under` and 17 `exec_spawn_detached_under`. The last five are edition 9 and a program
// of an earlier edition may have a function of the name, so they are the builtin only where the edition names it.
pub fn capability_which[&s, &x](st: &!s [int], text: &x [byte], callee: int) -> [] int {
    var which = 0;
    if pass1.is_word(st, text, callee, "narrow") {
        which = 1;
    } else if pass1.is_word(st, text, callee, "open_read") {
        which = 2;
    } else if pass1.is_word(st, text, callee, "open_write") {
        which = 3;
    } else if pass1.is_word(st, text, callee, "open_append") {
        which = 4;
    } else if pass1.is_word(st, text, callee, "open_new") {
        which = 5;
    } else if pass1.is_word(st, text, callee, "open_rw") {
        which = 6;
    } else if pass1.is_word(st, text, callee, "exec_spawn") {
        which = 7;
    } else if pass1.is_word(st, text, callee, "fs_read") {
        which = 8;
    } else if pass1.is_word(st, text, callee, "fs_write") {
        which = 9;
    } else if pass1.is_word(st, text, callee, "exec_spawn_in") {
        which = 10;
    } else if pass1.is_word(st, text, callee, "fs_remove") {
        which = 11;
    } else if pass1.is_word(st, text, callee, "fs_rename") {
        which = 12;
    } else if pass1.is_word(st, text, callee, "exec_spawn_detached") {
        which = 13;
    } else if pass1.is_word(st, text, callee, "exec_covers") {
        which = 14;
    } else if pass1.is_word(st, text, callee, "fs_covers") {
        which = 15;
    } else if pass1.is_word(st, text, callee, "exec_spawn_under") {
        which = 16;
    } else if pass1.is_word(st, text, callee, "exec_spawn_detached_under") {
        which = 17;
    }
    if which >= 13 && prims.builtin_at(st, text, callee, st[23]) < 0 {
        return 0;
    }
    return which;
}

// `exec_spawn_in` (10), `exec_spawn_under` (16) and `exec_spawn_detached_under` (17) take the `Dir` the child starts in.
pub fn in_dir(which: int) -> [] bool {
    return which == 10 || which == 16 || which == 17;
}

// `exec_spawn_under` (16) and `exec_spawn_detached_under` (17): the path is a name beneath the `Dir`.
pub fn under(which: int) -> [] bool {
    return which == 16 || which == 17;
}

// `cancho_spawn`'s flag word: bit 1 is a session of its own (`exec_spawn_detached` 13, and 17), bit 2 a name beneath the
// directory (`cancho_spawn` refuses an empty or rooted one; 16 and 17).
pub fn spawn_bits(which: int) -> [] int {
    if which == 13 {
        return 1;
    }
    if which == 16 {
        return 2;
    }
    if which == 17 {
        return 3;
    }
    return 0;
}

// The capability `exec_covers` (14) or `fs_covers` (15) takes: the name of its prelude type.
pub fn covered_capability(which: int) -> [] &static [byte] {
    if which == 14 {
        return "Exec";
    }
    return "Fs";
}

// `exec_covers` and `fs_covers`: whether the path (a pointer and a length) is under the prefix (the same), an `i1`.
pub fn path_covers[&s](st: &!s [int]) -> [] int {
    let n = emit.start(st);
    emit.str(st, "call i1 @cancho_path_covers(ptr ");
    arg_operand(st, 4, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 3, 1);
    emit.str(st, ", ptr ");
    arg_operand(st, 2, 7);
    emit.str(st, ", i64 ");
    arg_operand(st, 1, 1);
    emit.str(st, ")\n");
    st[52] = st[52] - 4;
    return n;
}
