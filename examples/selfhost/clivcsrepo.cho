edition 9;
module selfhost.clivcsrepo;

// clivcsrepo.cho -- the repository side of `cancho vcs` in the command line in cancho (`docs/vcs-routing.md`, slice R1): `init`, `log`, `show`, `branch`, `status`, `restore` and `switch`. The libraries are `vcsstore.cho` and `vcsrepo.cho`; this module is
// what a person types: the options, finding the repository, the one JSON document on standard output, and the exit status. `clivcs.cho` is the other side of `vcs` (`publish`, `log --store`, ...).
//
// Routing (`docs/vcs-routing.md` D1), as the Rust command's `cmd_vcs`: `log` is the manifest log when `--store` is named or no repository is in reach from the current directory, and the repository log
// otherwise; `init` and `show` are always this module's. Finding the repository (D2): from `--repo PATH` or the current directory, upward, to the first directory that holds `.cancho/vcs/format`.
// **Not the Rust command's:** it resolves links in the start (`canonicalize`); this one takes `--repo PATH` as written (collapsing `a/..`), so a path with a link in it prints another `root` for `init`.
//
// Every command takes `--output json` (the only form), `--repo PATH` and `--dry-run`. `init` takes `[DIR]` and `--branch NAME`; `log` takes `[REV]` and `--limit N`; `show` takes `[REV]`. The options the Rust
// `log` and `show` have and this does not (`log --path|--intent|--session|--issue|--author`, `show --patch`) are said to be missing, with exit 2; they are not read as something else.
//
// A refusal is a document `{"command", "ok": false, "refused": {"message", "tag"}}` and exit 1, an environment failure exit 3 (the Rust command's two). The message is the Rust sentence for `not-a-repository`,
// `bad-revision` (`vcsrepo.refusal_document`) and `bad-argument`; for the tags whose Rust message carries what only the Rust store knows (an object that is damaged, the OS's words for an `io` failure) it is the
// tag's own sentence: the tag and the status agree, the message does not. `status` adds the refusals of the scan (`path-unsupported`, `path-escapes`, `file-too-large`): the Rust message names the path or the link, this one does not.

import std.buffer;
import std.bytes;
import std.io as console;
import selfhost.lexcore as lc;
import selfhost.clibase;
import selfhost.cliproject;
import selfhost.jsonwrite;
import selfhost.vcsobj;
import selfhost.vcsrepo;
import selfhost.vcsrestore;
import selfhost.vcsstatus;
import selfhost.vcsstore;
import selfhost.vcsswitch;
import selfhost.walk;

// ---- the options -------------------------------------------------------------------------------------------------------------

// Where each option's value is: the index of its argument and the offset in it (0 when the value is the next argument, the place after `=` when it is inline), -1 when it was not given. `bad` is 0, or the status of
// a usage error that has been said.
struct Options {
    bad: int,
    repo_at: int,
    repo_off: int,
    branch_at: int,
    branch_off: int,
    limit_at: int,
    limit_off: int,
    rev_at: int,
    name_at: int,
    from_at: int,
    from_off: int,
    expect_at: int,
    expect_off: int,
    dry: bool,
    create: bool,
    detach: bool,
    keep: bool,
    discard: bool,
    positionals: int,
}

// `before`, `what` and `after`, said as a usage error.
fn usage[&h, &i, &w](heap: &!h Heap, io: &!i Io, before: &static [byte], what: &w [byte], after: &static [byte]) -> [heap, err_write] int {
    var message = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 96), before), what);
    message = buffer.append(heap, message, after);
    var status = 0;
    borrow message as &mb in {
        status = clibase.usage_error(heap, io, buffer.bytes(mb));
    }
    buffer.drop(heap, message);
    return status;
}

// The words after `cancho vcs COMMAND`: `command` is 0 for `init`, 1 for `log`, 2 for `show`, 3 for `branch`, 4 for `status`, 5 for `restore` and 6 for `switch`.
fn options_of[&h, &i, &a](heap: &!h Heap, io: &!i Io, args: &a Args, command: int) -> [heap, err_write, args] Options {
    var bad = 0;
    var repo_at = 0 - 1;
    var repo_off = 0;
    var branch_at = 0 - 1;
    var branch_off = 0;
    var limit_at = 0 - 1;
    var limit_off = 0;
    var rev_at = 0 - 1;
    var name_at = 0 - 1;
    var from_at = 0 - 1;
    var from_off = 0;
    var expect_at = 0 - 1;
    var expect_off = 0;
    var dry = false;
    var create = false;
    var detach = false;
    var keep = false;
    var discard = false;
    var positionals = 0;
    var plain_only = false;
    var n = 3;
    while n < arg_count(args) && bad == 0 {
        let word = arg(args, n);
        if plain_only || len(word) < 2 || lc.at(word, 0) != '-' || lc.at(word, 1) != '-' {
            positionals = positionals + 1;
            if rev_at < 0 {
                rev_at = n;
            } else if name_at < 0 {
                name_at = n;
            }
        } else if bytes.equal(word, "--") {
            plain_only = true;
        } else {
            let eq = bytes.find(word, "=");
            var key = word;
            var inline = 0 - 1;
            if eq >= 0 {
                key = word[0..eq];
                inline = eq + 1;
            }
            var takes = 0;
            if bytes.equal(key, "--output") || bytes.equal(key, "--repo") {
                takes = 1;
            } else if bytes.equal(key, "--branch") && command == 0 {
                takes = 1;
            } else if bytes.equal(key, "--limit") && command == 1 {
                takes = 1;
            } else if bytes.equal(key, "--from") && command == 5 {
                takes = 1;
            } else if (bytes.equal(key, "--from") || bytes.equal(key, "--expect")) && command == 3 {
                takes = 1;
            } else if command == 1 && (bytes.equal(key, "--intent") || bytes.equal(key, "--session") || bytes.equal(key, "--issue") || bytes.equal(key, "--path") || bytes.equal(key, "--author")) {
                takes = 2;
            } else if command == 2 && bytes.equal(key, "--patch") {
                takes = 3;
            } else if bytes.equal(key, "--dry-run") {
                takes = 4;
            } else if command == 6 && (bytes.equal(key, "--create") || bytes.equal(key, "--detach") || bytes.equal(key, "--keep") || bytes.equal(key, "--discard")) {
                takes = 5;
            }
            if takes == 0 {
                bad = usage(heap, io, "unknown option `", key, "`");
            } else if takes == 3 {
                bad = usage(heap, io, "`", key, "` is not in this build of `cancho vcs show` (docs/vcs-routing.md D7); the Rust build has it");
            } else if takes == 4 {
                dry = true;
            } else if takes == 5 {
                if bytes.equal(key, "--create") {
                    create = true;
                } else if bytes.equal(key, "--detach") {
                    detach = true;
                } else if bytes.equal(key, "--keep") {
                    keep = true;
                } else {
                    discard = true;
                }
            } else {
                var at = n;
                var off = inline;
                if inline < 0 {
                    if n + 1 >= arg_count(args) {
                        bad = usage(heap, io, "`", key, "` needs a value");
                    } else {
                        n = n + 1;
                        at = n;
                        off = 0;
                    }
                }
                if bad == 0 {
                    if takes == 2 {
                        bad = usage(heap, io, "`", key, "` is not in this build of `cancho vcs log` (docs/vcs-routing.md D7); the Rust build has it");
                    } else if bytes.equal(key, "--output") {
                        let given = arg(args, at);
                        if !bytes.equal(given[off..len(given)], "json") {
                            bad = usage(heap, io, "`--output` is `json`, the only form", "", "");
                        }
                    } else if bytes.equal(key, "--repo") {
                        repo_at = at;
                        repo_off = off;
                    } else if bytes.equal(key, "--branch") {
                        branch_at = at;
                        branch_off = off;
                    } else if bytes.equal(key, "--from") {
                        from_at = at;
                        from_off = off;
                    } else if bytes.equal(key, "--expect") {
                        expect_at = at;
                        expect_off = off;
                    } else {
                        limit_at = at;
                        limit_off = off;
                    }
                }
            }
        }
        n = n + 1;
    }
    return Options { bad: bad, repo_at: repo_at, repo_off: repo_off, branch_at: branch_at, branch_off: branch_off, limit_at: limit_at, limit_off: limit_off, rev_at: rev_at, name_at: name_at, from_at: from_at, from_off: from_off, expect_at: expect_at, expect_off: expect_off, dry: dry, create: create, detach: detach, keep: keep, discard: discard, positionals: positionals };
}

// The value at argument `at`, from `off`.
fn value_of[&a](args: &a Args, at: int, off: int) -> [args] &a [byte] {
    let text = arg(args, at);
    return text[off..len(text)];
}

// `text` as a count the way Rust's `usize::from_str` reads one (digits, with one `+` before them allowed), or -1.
fn count_of[&t](text: &t [byte]) -> [] int {
    var at = 0;
    if len(text) > 0 && lc.at(text, 0) == '+' {
        at = 1;
    }
    if at >= len(text) {
        return 0 - 1;
    }
    var n = 0;
    while at < len(text) {
        let c = lc.at(text, at);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        n = n * 10 + (c - '0');
        if n > 1000000000000 {
            n = 1000000000000;
        }
        at = at + 1;
    }
    return n;
}

// ---- finding the repository --------------------------------------------------------------------------------------------------

// What the directory `path` has: status 0 nothing, 1 a `.cancho/vcs/format` that says `cancho-vcs 1`, 2 one that says something else (its text, trimmed, in `bytes`).
fn probe[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte]) -> [heap, fs_read(""), dir_read, dir_write, file_read] vcsstore.Object {
    var kind = 0;
    var said = buffer.empty(heap, 0);
    match open_dir(fs, path) {
        DirOpened::Ok(r0) => {
            var root = r0;
            borrow root as &rd in {
                match vcsstore.enter_vcs(rd) {
                    DirOpened::Ok(v0) => {
                        var vcs = v0;
                        borrow vcs as &vd in {
                            let read = vcsstore.read_text(heap, vd, "format");
                            let (text, status, errno) = vcsstore.parts(read);
                            if status == 0 {
                                borrow text as &tb in {
                                    if bytes.equal(buffer.bytes(tb), "cancho-vcs 1\n") {
                                        kind = 1;
                                    } else {
                                        kind = 2;
                                        buffer.drop(heap, said);
                                        said = buffer.append(heap, buffer.empty(heap, 32), vcsstore.trimmed(buffer.bytes(tb)));
                                    }
                                }
                            }
                            buffer.drop(heap, text);
                        }
                        dir_close(vcs);
                    }
                    DirOpened::Failed(e) => {
                        kind = 0;
                    }
                }
            }
            dir_close(root);
        }
        DirOpened::Failed(e) => {
            kind = 0;
        }
    }
    return vcsstore.Object { bytes: said, status: kind, errno: 0 };
}

// The first directory at or above `start` (an absolute path) that holds a repository: its path in `bytes` and status 0; or status 1 (none) or 2 (a store of another format, its text in `bytes`).
fn find_root[&h, &f, &s](heap: &!h Heap, fs: &f Fs(""), start: &s [byte]) -> [heap, fs_read(""), dir_read, dir_write, file_read] vcsstore.Object {
    var at = buffer.append(heap, buffer.empty(heap, len(start) + 1), start);
    var up = 0;
    while up < 4096 {
        var kind = 0;
        var said = buffer.empty(heap, 0);
        var above = buffer.empty(heap, 0);
        var top = false;
        borrow at as &ab in {
            let found = probe(heap, fs, buffer.bytes(ab));
            let (text, status, errno) = vcsstore.parts(found);
            kind = status;
            buffer.drop(heap, said);
            said = text;
            top = len(buffer.bytes(ab)) <= 1;
            if kind == 0 && !top {
                buffer.drop(heap, above);
                above = cliproject.ancestor(heap, buffer.bytes(ab), 1);
            }
        }
        if kind == 1 {
            buffer.drop(heap, said);
            buffer.drop(heap, above);
            return vcsstore.Object { bytes: at, status: 0, errno: 0 };
        }
        if kind == 2 {
            buffer.drop(heap, at);
            buffer.drop(heap, above);
            return vcsstore.Object { bytes: said, status: 2, errno: 0 };
        }
        buffer.drop(heap, said);
        if top {
            buffer.drop(heap, above);
            buffer.drop(heap, at);
            return vcsstore.Object { bytes: buffer.empty(heap, 0), status: 1, errno: 0 };
        }
        buffer.drop(heap, at);
        at = above;
        up = up + 1;
    }
    buffer.drop(heap, at);
    return vcsstore.Object { bytes: buffer.empty(heap, 0), status: 1, errno: 0 };
}

// `path` as an absolute path: it as it is when it begins with `/`, else beneath `cwd`; `a/..` pairs collapsed (an `Fs` traps on `..`).
fn absolute[&h, &c, &p](heap: &!h Heap, cwd: &c [byte], path: &p [byte]) -> [heap] buffer.Buffer {
    var joined = cliproject.beneath(heap, cwd, path);
    var made = buffer.empty(heap, 0);
    borrow joined as &jb in {
        buffer.drop(heap, made);
        made = walk.collapse(heap, buffer.bytes(jb));
    }
    buffer.drop(heap, joined);
    return made;
}

// ---- the documents -----------------------------------------------------------------------------------------------------------

// `{"command": COMMAND, "ok": false, "refused": {"message": MESSAGE, "tag": TAG}}`.
fn refusal[&h, &c, &m, &t](heap: &!h Heap, command: &c [byte], message: &m [byte], tag: &t [byte]) -> [heap] buffer.Buffer {
    var b = buffer.push(heap, buffer.empty(heap, 256), byte_of(123));
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 1, true, "command"), command);
    b = buffer.append(heap, vcsrepo.member(heap, b, 1, false, "ok"), "false");
    b = buffer.push(heap, vcsrepo.member(heap, b, 1, false, "refused"), byte_of(123));
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, true, "message"), message);
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, false, "tag"), tag);
    b = buffer.push(heap, jsonwrite.newline(heap, b, 1), byte_of(125));
    return buffer.append(heap, jsonwrite.newline(heap, b, 0), "}\n");
}

// The sentence for a status of the store that this module has no Rust sentence for (see the header).
fn sentence(status: int) -> [] &static [byte] {
    if status == 10 {
        return "an input/output error";
    }
    if status == 3 {
        return "the store holds an object that does not match its id";
    }
    if status == 11 {
        return "the store has no such object";
    }
    if status == 15 {
        return "a lock is held";
    }
    if status == 31 {
        return "a path or a link target the working copy has cannot be recorded";
    }
    if status == 1 {
        return "a path escapes the working copy";
    }
    if status == 13 {
        return "a file is too large";
    }
    if status == 30 {
        return "a link in the working copy cannot be read";
    }
    return "the command was refused";
}

// `answer` (the store's: a document in `bytes` and status 0, or a refusal status) said as `command` says it. `spec` is the revision given, for `bad-revision`.
fn answered[&h, &i, &c, &p](heap: &!h Heap, io: &!i Io, command: &c [byte], answer: vcsstore.Object, spec: &p [byte]) -> [heap, io_write] int {
    let (doc, status, errno) = vcsstore.parts(answer);
    var code = 0;
    if status == 0 {
        borrow doc as &db in {
            buffer.write(io, db);
        }
    } else if status >= 18 && status <= 22 {
        borrow doc as &cb in {
            let said = vcsrepo.refusal_document(heap, command, status, spec, buffer.bytes(cb));
            borrow said as &sb in {
                buffer.write(io, sb);
            }
            buffer.drop(heap, said);
        }
        code = 1;
    } else {
        var tag = vcsstatus.tag(status);
        if status == 10 {
            tag = "io-error";
        }
        let said = refusal(heap, command, sentence(status), tag);
        borrow said as &sb in {
            buffer.write(io, sb);
        }
        buffer.drop(heap, said);
        code = 1;
        if status == 10 {
            code = 3;
        }
    }
    buffer.drop(heap, doc);
    return code;
}

// A refusal that this module makes itself, said.
fn refused[&h, &i, &c, &m, &t](heap: &!h Heap, io: &!i Io, command: &c [byte], message: &m [byte], tag: &t [byte]) -> [heap, io_write] int {
    let said = refusal(heap, command, message, tag);
    borrow said as &sb in {
        buffer.write(io, sb);
    }
    buffer.drop(heap, said);
    return 1;
}

// ---- the commands ------------------------------------------------------------------------------------------------------------

// The repository found upward from `given` (taken from `cwd`): status 0 and its path in `bytes`, or the refusal said (its exit status in `errno`, status 1).
fn locate_from[&h, &i, &f, &c, &g, &n](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), cwd: &c [byte], given: &g [byte], command: &n [byte]) -> [heap, io_write, fs_read(""), dir_read, dir_write, file_read] vcsstore.Object {
    let start = absolute(heap, cwd, given);
    var found = vcsstore.Object { bytes: buffer.empty(heap, 0), status: 1, errno: 0 };
    borrow start as &sb in {
        let (old, os, oe) = vcsstore.parts(found);
        buffer.drop(heap, old);
        found = find_root(heap, fs, buffer.bytes(sb));
    }
    buffer.drop(heap, start);
    let (path, status, errno) = vcsstore.parts(found);
    if status == 0 {
        return vcsstore.Object { bytes: path, status: 0, errno: 0 };
    }
    var code = 1;
    var message = buffer.empty(heap, 96);
    if status == 2 {
        message = buffer.append(heap, message, "unknown store format `");
        borrow path as &pb in {
            message = buffer.append(heap, message, buffer.bytes(pb));
        }
    } else {
        message = buffer.append(heap, message, "no `.cancho/vcs` at or above `");
        message = buffer.append(heap, message, given);
    }
    message = buffer.push(heap, message, byte_of(96));
    borrow message as &mb in {
        code = refused(heap, io, command, buffer.bytes(mb), "not-a-repository");
    }
    buffer.drop(heap, message);
    buffer.drop(heap, path);
    return vcsstore.Object { bytes: buffer.empty(heap, 0), status: 1, errno: code };
}

// The repository the command is run in: `--repo`, or `.`.
fn locate[&h, &i, &a, &f, &c, &n](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), cwd: &c [byte], options: Options, command: &n [byte]) -> [heap, io_write, args, fs_read(""), dir_read, dir_write, file_read] vcsstore.Object {
    if options.repo_at >= 0 {
        return locate_from(heap, io, fs, cwd, value_of(args, options.repo_at, options.repo_off), command);
    }
    return locate_from(heap, io, fs, cwd, ".", command);
}

// ---- the commands ------------------------------------------------------------------------------------------------------------

// `log [REV] [--limit N]` in the repository whose store is `vcs`.
fn log_in[&h, &i, &a, &d](heap: &!h Heap, io: &!i Io, args: &a Args, vcs: &d Dir, options: Options) -> [heap, io_write, args, dir_read, dir_write, file_read] int {
    var spec = "";
    var have = false;
    if options.rev_at >= 0 {
        spec = arg(args, options.rev_at);
        have = true;
    }
    var limit = 0 - 1;
    if options.limit_at >= 0 {
        limit = count_of(value_of(args, options.limit_at, options.limit_off));
        if limit < 0 {
            return refused(heap, io, "log", "`--limit` is a count", "bad-argument");
        }
    }
    let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
    var code = 0;
    borrow mut scratch as &!s in {
        code = answered(heap, io, "log", vcsrepo.log_command(heap, vcs, contents(s), spec, have, limit), spec);
    }
    unbox_slice(heap, scratch);
    return code;
}

// `show [REV]` in the repository whose store is `vcs`.
fn show_in[&h, &i, &a, &d](heap: &!h Heap, io: &!i Io, args: &a Args, vcs: &d Dir, options: Options) -> [heap, io_write, args, dir_read, dir_write, file_read] int {
    var spec = "";
    if options.rev_at >= 0 {
        spec = arg(args, options.rev_at);
    }
    let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
    var code = 0;
    borrow mut scratch as &!s in {
        code = answered(heap, io, "show", vcsrepo.show_command(heap, vcs, contents(s), spec), spec);
    }
    unbox_slice(heap, scratch);
    return code;
}

// `status` in the repository whose working copy is `root` and whose store is `vcs`: HEAD's tree against the files (R4, `vcsstatus.status_command`, which reads links with `dir_readlink`).
fn status_in[&h, &i, &r, &d](heap: &!h Heap, io: &!i Io, root: &r Dir, vcs: &d Dir) -> [heap, io_write, dir_read, dir_write, file_read] int {
    let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
    var code = 0;
    borrow mut scratch as &!s in {
        code = answered(heap, io, "status", vcsstatus.status_command(heap, root, vcs, contents(s)), "");
    }
    unbox_slice(heap, scratch);
    return code;
}

// `lock-held`, said as the Rust command says it: the lock's path, the pid and the age from its text (`PID SINCE`; a pid of 0, which is what this build stamps, or a text that is not that, is `null`).
fn lock_held[&h, &i, &m, &p, &t](heap: &!h Heap, io: &!i Io, command: &m [byte], lock: &p [byte], stamp: &t [byte], now: int) -> [heap, io_write] int {
    let text = vcsstore.trimmed(stamp);
    var sp = bytes.find(text, " ");
    var pid = 0 - 1;
    var since = 0 - 1;
    if sp >= 0 {
        pid = count_of(text[0..sp]);
        since = count_of(vcsstore.trimmed(text[sp + 1..len(text)]));
    }
    if pid == 0 {
        pid = 0 - 1;
    }
    var age = 0 - 1;
    if since >= 0 {
        age = now - since;
        if age < 0 {
            age = 0;
        }
    }
    var message = buffer.push(heap, buffer.empty(heap, 160), byte_of(96));
    message = buffer.push(heap, buffer.append(heap, message, lock), byte_of(96));
    message = buffer.append(heap, message, " is locked by pid ");
    if pid >= 0 {
        message = buffer.push_nat(heap, message, pid);
    } else {
        message = buffer.push(heap, message, byte_of(63));
    }
    message = buffer.append(heap, message, " for ");
    if age >= 0 {
        message = buffer.push_nat(heap, message, age);
    } else {
        message = buffer.push(heap, message, byte_of(63));
    }
    message = buffer.append(heap, message, "s; if that process is gone, run `cancho vcs unlock`");
    var b = buffer.push(heap, buffer.empty(heap, 256), byte_of(123));
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 1, true, "command"), command);
    b = buffer.append(heap, vcsrepo.member(heap, b, 1, false, "ok"), "false");
    b = buffer.push(heap, vcsrepo.member(heap, b, 1, false, "refused"), byte_of(123));
    b = vcsrepo.member(heap, b, 2, true, "age_seconds");
    if age >= 0 {
        b = buffer.push_nat(heap, b, age);
    } else {
        b = buffer.append(heap, b, "null");
    }
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, false, "lock"), lock);
    borrow message as &mb in {
        b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, false, "message"), buffer.bytes(mb));
    }
    buffer.drop(heap, message);
    b = vcsrepo.member(heap, b, 2, false, "pid");
    if pid >= 0 {
        b = buffer.push_nat(heap, b, pid);
    } else {
        b = buffer.append(heap, b, "null");
    }
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, false, "tag"), "lock-held");
    b = buffer.push(heap, jsonwrite.newline(heap, b, 1), byte_of(125));
    b = buffer.append(heap, jsonwrite.newline(heap, b, 0), "}\n");
    let sent = said(heap, io, b);
    return 1;
}

// `path` without a final `/.` (`/a/b/.` is `/a/b`, `/.` is `/`): `absolute` collapses `a/..` but leaves a `.` at the end.
fn dotless[&t](path: &t [byte]) -> [] &t [byte] {
    if len(path) >= 2 && bytes.equal(path[len(path) - 2..len(path)], "/.") {
        if len(path) == 2 {
            return path[0..1];
        }
        return path[0..len(path) - 2];
    }
    return path;
}

// `restore PATH... [--from REV] [--dry-run]` in the repository at `rootpath` (R5, `vcsrestore.restore_command`). The paths are made relative to the root as `rel_path` does in Rust, from the
// current directory `cwd`: `..` collapsed, and a path outside the root is `path-escapes`. A difference from Rust: that refusal is made before `--from` is resolved and before the lock is taken.
fn restore_in[&h, &i, &a, &r, &d, &p, &c, &k](heap: &!h Heap, io: &!i Io, args: &a Args, root: &r Dir, vcs: &d Dir, found: &p [byte], cwd: &c [byte], options: Options, clock: &k Clock) -> [heap, io_write, args, dir_read, dir_write, dir_symlink, file_read, file_write, clock] int {
    // The search for the repository starts at `CWD/.`, so the path it found may end in `/.`; the root is the path without it.
    let rootpath = dotless(found);
    var prefix = buffer.append(heap, buffer.empty(heap, len(rootpath) + 2), rootpath);
    if !bytes.equal(rootpath, "/") {
        prefix = buffer.push(heap, prefix, byte_of(47));
    }
    var selected = buffer.empty(heap, 64);
    var count = 0;
    var code = 0;
    var plain_only = false;
    var n = 3;
    while n < arg_count(args) && code == 0 {
        let word = arg(args, n);
        var positional = false;
        if plain_only || len(word) < 2 || lc.at(word, 0) != '-' || lc.at(word, 1) != '-' {
            positional = true;
        } else if bytes.equal(word, "--") {
            plain_only = true;
        } else if bytes.find(word, "=") < 0 && (bytes.equal(word, "--output") || bytes.equal(word, "--repo") || bytes.equal(word, "--from")) {
            n = n + 1;
        }
        if positional {
            count = count + 1;
            let full = absolute(heap, cwd, word);
            var inside = false;
            borrow full as &fb in {
                borrow prefix as &pb in {
                    let all = dotless(buffer.bytes(fb));
                    if bytes.equal(all, rootpath) {
                        inside = true;
                        selected = buffer.push(heap, selected, byte_of(10));
                    } else if bytes.starts_with(all, buffer.bytes(pb)) {
                        inside = true;
                        selected = buffer.push(heap, buffer.append(heap, selected, all[len(buffer.bytes(pb))..len(all)]), byte_of(10));
                    }
                }
            }
            buffer.drop(heap, full);
            if !inside {
                var message = buffer.push(heap, buffer.empty(heap, 64), byte_of(96));
                message = buffer.append(heap, buffer.push(heap, buffer.append(heap, message, word), byte_of(96)), " is outside the repository");
                borrow message as &mb in {
                    code = refused(heap, io, "restore", buffer.bytes(mb), "path-escapes");
                }
                buffer.drop(heap, message);
            }
        }
        n = n + 1;
    }
    buffer.drop(heap, prefix);
    if code == 0 && count == 0 {
        code = refused(heap, io, "restore", "name the paths to restore (`.` for all)", "nothing-selected");
    }
    if code != 0 {
        buffer.drop(heap, selected);
        return code;
    }
    var spec = "HEAD";
    if options.from_at >= 0 {
        spec = arg(args, options.from_at);
        if options.from_off > 0 {
            spec = spec[options.from_off..len(spec)];
        }
    }
    let now = clock_unix_ms(clock) / 1000;
    let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
    borrow mut scratch as &!s in {
        borrow selected as &sb in {
            let answer = vcsrestore.restore_command(heap, root, vcs, contents(s), spec, buffer.bytes(sb), options.dry, now);
            let (doc, status, errno) = vcsstore.parts(answer);
            if status == 15 {
                var lock = buffer.append(heap, buffer.empty(heap, len(rootpath) + 24), rootpath);
                lock = buffer.append(heap, lock, "/.cancho/vcs/lock");
                borrow doc as &db in {
                    borrow lock as &lb in {
                        code = lock_held(heap, io, "restore", buffer.bytes(lb), buffer.bytes(db), now);
                    }
                }
                buffer.drop(heap, lock);
                buffer.drop(heap, doc);
            } else {
                code = answered(heap, io, "restore", vcsstore.Object { bytes: doc, status: status, errno: errno }, spec);
            }
        }
    }
    unbox_slice(heap, scratch);
    buffer.drop(heap, selected);
    return code;
}

// `dirty-working-copy`: the paths (one to a line) that block the switch.
fn dirty_refusal[&h, &p](heap: &!h Heap, paths: &p [byte]) -> [heap] buffer.Buffer {
    var b = buffer.push(heap, buffer.empty(heap, 256), byte_of(123));
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 1, true, "command"), "switch");
    b = buffer.append(heap, vcsrepo.member(heap, b, 1, false, "ok"), "false");
    b = buffer.push(heap, vcsrepo.member(heap, b, 1, false, "refused"), byte_of(123));
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, true, "message"), "uncommitted changes would be lost or carried; record them, or pass --keep or --discard");
    b = vcsswitch.string_array(heap, vcsrepo.member(heap, b, 2, false, "paths"), paths, 2);
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, false, "tag"), "dirty-working-copy");
    b = buffer.push(heap, jsonwrite.newline(heap, b, 1), byte_of(125));
    return buffer.append(heap, jsonwrite.newline(heap, b, 0), "}\n");
}

// `switch TARGET [--create] [--detach] [--keep] [--discard] [--dry-run]` in the repository at `found` (R6, `vcsswitch.switch_command`).
fn switch_in[&h, &i, &a, &r, &d, &p, &k](heap: &!h Heap, io: &!i Io, args: &a Args, root: &r Dir, vcs: &d Dir, found: &p [byte], options: Options, clock: &k Clock) -> [heap, io_write, args, dir_read, dir_write, dir_symlink, file_read, file_write, clock] int {
    if options.positionals != 1 {
        return refused(heap, io, "switch", "`switch` takes one branch or change", "bad-argument");
    }
    let target = arg(args, options.rev_at);
    let rootpath = dotless(found);
    let now = clock_unix_ms(clock) / 1000;
    var code = 0;
    let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
    borrow mut scratch as &!s in {
        let answer = vcsswitch.switch_command(heap, root, vcs, contents(s), target, options.create, options.detach, options.keep, options.discard, options.dry, now);
        let (doc, status, errno) = vcsstore.parts(answer);
        if status == 15 {
            var lock = buffer.append(heap, buffer.empty(heap, len(rootpath) + 24), rootpath);
            lock = buffer.append(heap, lock, "/.cancho/vcs/lock");
            borrow doc as &db in {
                borrow lock as &lb in {
                    code = lock_held(heap, io, "switch", buffer.bytes(lb), buffer.bytes(db), now);
                }
            }
            buffer.drop(heap, lock);
            buffer.drop(heap, doc);
        } else if status == 32 {
            borrow doc as &db in {
                code = said(heap, io, dirty_refusal(heap, buffer.bytes(db)));
            }
            code = 1;
            buffer.drop(heap, doc);
        } else if status == 14 {
            var refname = buffer.append(heap, buffer.empty(heap, len(target) + 8), "heads/");
            refname = buffer.append(heap, refname, target);
            borrow refname as &rb in {
                borrow doc as &db in {
                    code = said(heap, io, moved_refusal(heap, "switch", buffer.bytes(rb), buffer.bytes(db), "absent", false));
                }
            }
            code = 1;
            buffer.drop(heap, refname);
            buffer.drop(heap, doc);
        } else if status == 16 {
            var message = buffer.append(heap, buffer.empty(heap, 64), "`heads/");
            message = buffer.append(heap, buffer.append(heap, message, target), "` is not a ref name");
            borrow message as &mb in {
                code = refused(heap, io, "switch", buffer.bytes(mb), "bad-ref-name");
            }
            buffer.drop(heap, message);
            buffer.drop(heap, doc);
        } else if status == 33 {
            code = refused(heap, io, "switch", "there is no change to branch from yet", "bad-revision");
            buffer.drop(heap, doc);
        } else {
            code = answered(heap, io, "switch", vcsstore.Object { bytes: doc, status: status, errno: errno }, target);
        }
    }
    unbox_slice(heap, scratch);
    return code;
}

// The child directory `name` of `dir`, made (mode 0755) if it is not there.
fn make_below[&d, &n](dir: &d Dir, name: &n [byte]) -> [dir_read, dir_write] DirOpened {
    match dir_enter(dir, name) {
        DirOpened::Ok(child) => {
            return DirOpened::Ok(child);
        }
        DirOpened::Failed(e) => {
            match dir_mkdir(dir, name, 493) {
                Done::Ok(n) => {
                    return dir_enter(dir, name);
                }
                Done::Failed(e2) => {
                    return DirOpened::Failed(e2);
                }
            }
        }
    }
}

// The directories of `path` from `at` (an absolute path, `.` components skipped, each made if it is not there), then the repository made in the last: `vcsstore.init`'s answer (errno 1 when it made one).
fn init_below[&h, &d, &p, &b](heap: &!h Heap, dir: &d Dir, path: &p [byte], at: int, branch: &b [byte]) -> [heap, dir_read, dir_write, file_read, file_write] vcsstore.Object {
    var from = at;
    while from < len(path) && lc.at(path, from) == '/' {
        from = from + 1;
    }
    if from >= len(path) {
        return vcsstore.init(heap, dir, branch);
    }
    var to = from;
    while to < len(path) && lc.at(path, to) != '/' {
        to = to + 1;
    }
    let name = path[from..to];
    if bytes.equal(name, ".") {
        return init_below(heap, dir, path, to, branch);
    }
    var answer = vcsstore.Object { bytes: buffer.empty(heap, 0), status: 10, errno: 0 };
    match make_below(dir, name) {
        DirOpened::Ok(c0) => {
            var child = c0;
            borrow child as &cd in {
                let (old, os, oe) = vcsstore.parts(answer);
                buffer.drop(heap, old);
                answer = init_below(heap, cd, path, to, branch);
            }
            dir_close(child);
        }
        DirOpened::Failed(e) => {
            let (old, os, oe) = vcsstore.parts(answer);
            buffer.drop(heap, old);
            answer = vcsstore.Object { bytes: buffer.empty(heap, 0), status: 10, errno: e };
        }
    }
    return answer;
}

// The `init` document: `{"branch", "command", "created", "ok", "root"}`, or with `--dry-run` `{"branch", "command", "created": false, "ok", "would_create"}`.
fn init_document[&h, &b, &r](heap: &!h Heap, branch: &b [byte], created: bool, root: &r [byte], dry: bool, would: bool) -> [heap] buffer.Buffer {
    var d = buffer.push(heap, buffer.empty(heap, 192), byte_of(123));
    d = jsonwrite.string(heap, vcsrepo.member(heap, d, 1, true, "branch"), branch);
    d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "command"), "\"init\"");
    if created {
        d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "created"), "true");
    } else {
        d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "created"), "false");
    }
    d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "ok"), "true");
    if dry {
        if would {
            d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "would_create"), "true");
        } else {
            d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "would_create"), "false");
        }
    } else {
        d = jsonwrite.string(heap, vcsrepo.member(heap, d, 1, false, "root"), root);
    }
    return buffer.append(heap, jsonwrite.newline(heap, d, 0), "}\n");
}

// `init [DIR] [--branch NAME]`: the directory (made if it is not there) holds a repository afterwards. `created` is false when one was already there.
fn init_command[&h, &i, &a, &f, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), cwd: &c [byte], options: Options) -> [heap, io_write, args, fs_read(""), dir_read, dir_write, file_read, file_write] int {
    var given = ".";
    if options.rev_at >= 0 {
        given = arg(args, options.rev_at);
    }
    var branch = "main";
    if options.branch_at >= 0 {
        let text = arg(args, options.branch_at);
        branch = text[options.branch_off..len(text)];
    }
    let target = absolute(heap, cwd, given);
    var code = 0;
    borrow target as &tb in {
        if options.dry {
            let found = find_root(heap, fs, buffer.bytes(tb));
            let (text, status, errno) = vcsstore.parts(found);
            buffer.drop(heap, text);
            let said = init_document(heap, branch, false, "", true, status != 0);
            borrow said as &sb in {
                buffer.write(io, sb);
            }
            buffer.drop(heap, said);
        } else {
            match open_dir(fs, "/") {
                DirOpened::Ok(top0) => {
                    var top = top0;
                    var made = vcsstore.Object { bytes: buffer.empty(heap, 0), status: 10, errno: 0 };
                    borrow top as &td in {
                        let (old, os, oe) = vcsstore.parts(made);
                        buffer.drop(heap, old);
                        made = init_below(heap, td, buffer.bytes(tb), 0, branch);
                    }
                    dir_close(top);
                    let (text, status, errno) = vcsstore.parts(made);
                    buffer.drop(heap, text);
                    if status == 0 {
                        let said = init_document(heap, branch, errno == 1, buffer.bytes(tb), false, false);
                        borrow said as &sb in {
                            buffer.write(io, sb);
                        }
                        buffer.drop(heap, said);
                    } else if status == 16 {
                        var message = buffer.append(heap, buffer.empty(heap, 64), "`heads/");
                        message = buffer.append(heap, message, branch);
                        message = buffer.append(heap, message, "` is not a ref name");
                        borrow message as &mb in {
                            code = refused(heap, io, "init", buffer.bytes(mb), "bad-ref-name");
                        }
                        buffer.drop(heap, message);
                    } else {
                        code = answered(heap, io, "init", vcsstore.Object { bytes: buffer.empty(heap, 0), status: status, errno: errno }, "");
                    }
                }
                DirOpened::Failed(e) => {
                    code = answered(heap, io, "init", vcsstore.Object { bytes: buffer.empty(heap, 0), status: 10, errno: e }, "");
                }
            }
        }
    }
    buffer.drop(heap, target);
    return code;
}

// ---- branch ------------------------------------------------------------------------------------------------------------------

// The `ref-moved` refusal: `{"command", "ok": false, "refused": {"current", "expected", "message", "ref", "tag"}}`. `current` is empty when the ref is not there (null); `expected` is `absent` or the id that was expected.
// `delete_ref` says it differently in the Rust command (`refs.rs`): no `expected`, and the message `NAME is not at the expected change`; `deleting` asks for that form.
fn moved_refusal[&h, &c, &r, &u, &e](heap: &!h Heap, command: &c [byte], refname: &r [byte], current: &u [byte], expected: &e [byte], deleting: bool) -> [heap] buffer.Buffer {
    var message = buffer.push(heap, buffer.empty(heap, 128), byte_of(96));
    if deleting {
        message = buffer.append(heap, buffer.append(heap, message, refname), "` is not at the expected change");
    } else {
        message = buffer.append(heap, buffer.append(heap, message, refname), "` is at ");
        if len(current) > 0 {
            message = buffer.append(heap, message, current);
        } else {
            message = buffer.append(heap, message, "nothing");
        }
        message = buffer.append(heap, message, ", not where it was expected");
    }
    var b = buffer.push(heap, buffer.empty(heap, 320), byte_of(123));
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 1, true, "command"), command);
    b = buffer.append(heap, vcsrepo.member(heap, b, 1, false, "ok"), "false");
    b = buffer.push(heap, vcsrepo.member(heap, b, 1, false, "refused"), byte_of(123));
    b = vcsrepo.member(heap, b, 2, true, "current");
    if len(current) > 0 {
        b = jsonwrite.string(heap, b, current);
    } else {
        b = buffer.append(heap, b, "null");
    }
    if !deleting {
        b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, false, "expected"), expected);
    }
    borrow message as &mb in {
        b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, false, "message"), buffer.bytes(mb));
    }
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, false, "ref"), refname);
    b = jsonwrite.string(heap, vcsrepo.member(heap, b, 2, false, "tag"), "ref-moved");
    b = buffer.push(heap, jsonwrite.newline(heap, b, 1), byte_of(125));
    buffer.drop(heap, message);
    return buffer.append(heap, jsonwrite.newline(heap, b, 0), "}\n");
}

// The `branch create` and `branch delete` documents: `branch`, `change` (when there is one), `command`, `created` or `deleted` (`flag_name`), `dry_run` (when it is), `ok`.
fn branch_result[&h, &n, &c, &f](heap: &!h Heap, branch: &n [byte], has_change: bool, change: &c [byte], flag_name: &f [byte], flag: bool, dry: bool) -> [heap] buffer.Buffer {
    var d = buffer.push(heap, buffer.empty(heap, 256), byte_of(123));
    d = jsonwrite.string(heap, vcsrepo.member(heap, d, 1, true, "branch"), branch);
    if has_change {
        d = vcsrepo.quoted(heap, vcsrepo.member(heap, d, 1, false, "change"), change);
    }
    d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "command"), "\"branch\"");
    d = vcsrepo.member(heap, d, 1, false, flag_name);
    if flag {
        d = buffer.append(heap, d, "true");
    } else {
        d = buffer.append(heap, d, "false");
    }
    if dry {
        d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "dry_run"), "true");
    }
    d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "ok"), "true");
    return buffer.append(heap, jsonwrite.newline(heap, d, 0), "}\n");
}

// The `branch list` document: `lines` are `heads/NAME ID`, one to a line; `current` is the branch HEAD is on (without `heads/`), when there is one.
fn branch_list_document[&h, &l, &c](heap: &!h Heap, lines: &l [byte], current: &c [byte], has_current: bool) -> [heap] buffer.Buffer {
    var d = buffer.push(heap, buffer.empty(heap, 256), byte_of(123));
    d = buffer.push(heap, vcsrepo.member(heap, d, 1, true, "branches"), byte_of(91));
    var n = 0;
    var at = 0;
    while at < len(lines) {
        var end = at;
        while end < len(lines) && lc.at(lines, end) != 10 {
            end = end + 1;
        }
        let line = lines[at..end];
        var space = 0;
        while space < len(line) && lc.at(line, space) != 32 {
            space = space + 1;
        }
        let full = line[0..space];
        var from = 0;
        if bytes.starts_with(full, "heads/") {
            from = 6;
        }
        if n > 0 {
            d = buffer.push(heap, d, byte_of(44));
        }
        d = buffer.push(heap, jsonwrite.newline(heap, d, 2), byte_of(123));
        d = vcsrepo.quoted(heap, vcsrepo.member(heap, d, 3, true, "change"), line[space + 1..len(line)]);
        d = jsonwrite.string(heap, vcsrepo.member(heap, d, 3, false, "name"), full[from..len(full)]);
        d = buffer.push(heap, jsonwrite.newline(heap, d, 2), byte_of(125));
        n = n + 1;
        at = end + 1;
    }
    if n > 0 {
        d = jsonwrite.newline(heap, d, 1);
    }
    d = buffer.push(heap, d, byte_of(93));
    d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "command"), "\"branch\"");
    d = vcsrepo.member(heap, d, 1, false, "current");
    if has_current {
        d = jsonwrite.string(heap, d, current);
    } else {
        d = buffer.append(heap, d, "null");
    }
    d = buffer.append(heap, vcsrepo.member(heap, d, 1, false, "ok"), "true");
    return buffer.append(heap, jsonwrite.newline(heap, d, 0), "}\n");
}

// A document said, then dropped.
fn said[&h, &i](heap: &!h Heap, io: &!i Io, document: buffer.Buffer) -> [heap, io_write] int {
    borrow document as &db in {
        buffer.write(io, db);
    }
    buffer.drop(heap, document);
    return 0;
}

// The ref `heads/NAME` of the branch the command names (the second word): status 0 and the ref in `bytes`, or the refusal said (exit status in `errno`, status 1).
fn branch_ref[&h, &i, &a](heap: &!h Heap, io: &!i Io, args: &a Args, options: Options) -> [heap, io_write, args] vcsstore.Object {
    if options.name_at < 0 {
        let code = refused(heap, io, "branch", "this needs a branch name", "bad-argument");
        return vcsstore.Object { bytes: buffer.empty(heap, 0), status: 1, errno: code };
    }
    let name = arg(args, options.name_at);
    var full = buffer.append(heap, buffer.empty(heap, len(name) + 8), "heads/");
    full = buffer.append(heap, full, name);
    var ok = false;
    borrow full as &fb in {
        ok = vcsstore.check_ref_name(buffer.bytes(fb));
    }
    if !ok {
        var message = buffer.push(heap, buffer.empty(heap, 64), byte_of(96));
        borrow full as &fb in {
            message = buffer.append(heap, message, buffer.bytes(fb));
        }
        message = buffer.append(heap, message, "` is not a ref name");
        var code = 1;
        borrow message as &mb in {
            code = refused(heap, io, "branch", buffer.bytes(mb), "bad-ref-name");
        }
        buffer.drop(heap, message);
        buffer.drop(heap, full);
        return vcsstore.Object { bytes: buffer.empty(heap, 0), status: 1, errno: code };
    }
    return vcsstore.Object { bytes: full, status: 0, errno: 0 };
}

// `branch list`: the branches, in the order of the bytes of their names, and the one HEAD is on.
fn branch_list[&h, &i, &d](heap: &!h Heap, io: &!i Io, vcs: &d Dir) -> [heap, io_write, dir_read, dir_write, file_read] int {
    let heads = vcsrepo.head_ref(heap, vcs);
    let (current, hs, he) = vcsstore.parts(heads);
    if hs != 0 && hs != 2 {
        buffer.drop(heap, current);
        return answered(heap, io, "branch", vcsstore.Object { bytes: buffer.empty(heap, 0), status: 3, errno: 0 }, "");
    }
    let listed = vcsstore.list_refs(heap, vcs, "heads");
    let (lines, ls, le) = vcsstore.parts(listed);
    var code = 0;
    if ls != 0 {
        buffer.drop(heap, lines);
        code = answered(heap, io, "branch", vcsstore.Object { bytes: buffer.empty(heap, 0), status: ls, errno: le }, "");
    } else {
        borrow lines as &lb in {
            borrow current as &cb in {
                var name = buffer.bytes(cb);
                if bytes.starts_with(name, "heads/") {
                    name = name[6..len(name)];
                }
                let document = branch_list_document(heap, buffer.bytes(lb), name, hs == 0);
                code = said(heap, io, document);
            }
        }
        buffer.drop(heap, lines);
    }
    buffer.drop(heap, current);
    return code;
}

// The change `spec` names, or the refusal said: status 0 and the id in `bytes`, else status 1 and the exit status in `errno`.
fn resolved[&h, &i, &d, &s, &p](heap: &!h Heap, io: &!i Io, vcs: &d Dir, scratch: &!s [int], spec: &p [byte]) -> [heap, io_write, dir_read, dir_write, file_read] vcsstore.Object {
    let found = vcsrepo.resolve(heap, vcs, scratch, spec);
    let (id, status, errno) = vcsstore.parts(found);
    if status == 0 {
        return vcsstore.Object { bytes: id, status: 0, errno: 0 };
    }
    let code = answered(heap, io, "branch", vcsstore.Object { bytes: id, status: status, errno: errno }, spec);
    return vcsstore.Object { bytes: buffer.empty(heap, 0), status: 1, errno: code };
}

// `branch create NAME [--from REV]`.
fn branch_create[&h, &i, &a, &d, &c](heap: &!h Heap, io: &!i Io, args: &a Args, vcs: &d Dir, options: Options, clock: &c Clock) -> [heap, io_write, args, dir_read, dir_write, file_read, file_write, clock] int {
    let named = branch_ref(heap, io, args, options);
    let (full, ns, ne) = vcsstore.parts(named);
    if ns != 0 {
        buffer.drop(heap, full);
        return ne;
    }
    var spec = "HEAD";
    if options.from_at >= 0 {
        spec = arg(args, options.from_at);
        if options.from_off > 0 {
            spec = spec[options.from_off..len(spec)];
        }
    }
    let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
    var code = 0;
    borrow mut scratch as &!s in {
        let target = resolved(heap, io, vcs, contents(s), spec);
        let (id, ts, te) = vcsstore.parts(target);
        if ts != 0 {
            buffer.drop(heap, id);
            code = te;
        } else {
            borrow full as &fb in {
                borrow id as &ib in {
                    let name = args_name(args, options);
                    let existing = vcsstore.read_ref(heap, vcs, buffer.bytes(fb));
                    let (have, es, ee) = vcsstore.parts(existing);
                    var same = false;
                    borrow have as &hb in {
                        same = es == 0 && bytes.equal(buffer.bytes(hb), buffer.bytes(ib));
                    }
                    buffer.drop(heap, have);
                    if es != 0 && es != 2 {
                        code = answered(heap, io, "branch", vcsstore.Object { bytes: buffer.empty(heap, 0), status: es, errno: ee }, "");
                    } else if same {
                        code = said(heap, io, branch_result(heap, name, true, buffer.bytes(ib), "created", false, false));
                    } else if options.dry {
                        code = said(heap, io, branch_result(heap, name, true, buffer.bytes(ib), "created", false, true));
                    } else {
                        let moved = vcsstore.update_ref(heap, vcs, buffer.bytes(fb), vcsstore.expect_absent(), "", buffer.bytes(ib), "branch create", clock_unix_ms(clock) / 1000);
                        let (current, us, ue) = vcsstore.parts(moved);
                        if us == 0 {
                            code = said(heap, io, branch_result(heap, name, true, buffer.bytes(ib), "created", true, false));
                        } else if us == 14 {
                            borrow current as &mb in {
                                code = said(heap, io, moved_refusal(heap, "branch", buffer.bytes(fb), buffer.bytes(mb), "absent", false));
                            }
                            code = 1;
                        } else {
                            code = answered(heap, io, "branch", vcsstore.Object { bytes: buffer.empty(heap, 0), status: us, errno: ue }, "");
                        }
                        buffer.drop(heap, current);
                    }
                }
            }
            buffer.drop(heap, id);
        }
    }
    unbox_slice(heap, scratch);
    buffer.drop(heap, full);
    return code;
}

// The branch name the command was given, as written (the second word).
fn args_name[&a](args: &a Args, options: Options) -> [args] &a [byte] {
    return arg(args, options.name_at);
}

// `branch delete NAME --expect REV`.
fn branch_delete[&h, &i, &a, &d, &c](heap: &!h Heap, io: &!i Io, args: &a Args, vcs: &d Dir, options: Options, clock: &c Clock) -> [heap, io_write, args, dir_read, dir_write, file_read, file_write, clock] int {
    let named = branch_ref(heap, io, args, options);
    let (full, ns, ne) = vcsstore.parts(named);
    if ns != 0 {
        buffer.drop(heap, full);
        return ne;
    }
    var code = 0;
    var finished = false;
    let name = args_name(args, options);
    // The checked-out branch cannot be deleted.
    let heads = vcsrepo.head_ref(heap, vcs);
    let (headref, hs, he) = vcsstore.parts(heads);
    borrow headref as &hb in {
        borrow full as &fb in {
            if hs == 0 && bytes.equal(buffer.bytes(hb), buffer.bytes(fb)) {
                code = refused(heap, io, "branch", "the checked-out branch cannot be deleted", "ref-protected");
                finished = true;
            }
        }
    }
    buffer.drop(heap, headref);
    // The change it is at: a branch that is not there is deleted already.
    var current = buffer.empty(heap, 0);
    if !finished {
        var cs = 0;
        var ce = 0;
        borrow full as &fb in {
            let existing = vcsstore.read_ref(heap, vcs, buffer.bytes(fb));
            let (id, s2, e2) = vcsstore.parts(existing);
            buffer.drop(heap, current);
            current = id;
            cs = s2;
            ce = e2;
        }
        if cs == 2 {
            code = said(heap, io, branch_result(heap, name, false, "", "deleted", false, false));
            finished = true;
        } else if cs != 0 {
            code = answered(heap, io, "branch", vcsstore.Object { bytes: buffer.empty(heap, 0), status: cs, errno: ce }, "");
            finished = true;
        } else if options.expect_at < 0 {
            code = refused(heap, io, "branch", "deleting a branch needs --expect <change> (the change you believe it is at)", "bad-argument");
            finished = true;
        }
    }
    if !finished {
        var spec = arg(args, options.expect_at);
        if options.expect_off > 0 {
            spec = spec[options.expect_off..len(spec)];
        }
        let scratch = box_slice(heap, vcsobj.scratch_size(), 0);
        borrow mut scratch as &!s in {
            let target = resolved(heap, io, vcs, contents(s), spec);
            let (id, ts, te) = vcsstore.parts(target);
            if ts != 0 {
                code = te;
            } else {
                borrow full as &fb in {
                    borrow id as &ib in {
                        borrow current as &cb in {
                            if options.dry {
                                code = said(heap, io, branch_result(heap, name, true, buffer.bytes(cb), "deleted", false, true));
                            } else {
                                let gone = vcsstore.delete_ref(heap, vcs, buffer.bytes(fb), vcsstore.expect_id(), buffer.bytes(ib), clock_unix_ms(clock) / 1000);
                                let (now_at, gs, ge) = vcsstore.parts(gone);
                                if gs == 0 {
                                    code = said(heap, io, branch_result(heap, name, true, buffer.bytes(cb), "deleted", true, false));
                                } else if gs == 14 {
                                    borrow now_at as &nb in {
                                        code = said(heap, io, moved_refusal(heap, "branch", buffer.bytes(fb), buffer.bytes(nb), buffer.bytes(ib), true));
                                    }
                                    code = 1;
                                } else {
                                    code = answered(heap, io, "branch", vcsstore.Object { bytes: buffer.empty(heap, 0), status: gs, errno: ge }, "");
                                }
                                buffer.drop(heap, now_at);
                            }
                        }
                    }
                }
            }
            buffer.drop(heap, id);
        }
        unbox_slice(heap, scratch);
    }
    buffer.drop(heap, current);
    buffer.drop(heap, full);
    return code;
}

// `branch [list | create NAME | delete NAME]`.
fn branch_in[&h, &i, &a, &d, &c](heap: &!h Heap, io: &!i Io, args: &a Args, vcs: &d Dir, options: Options, clock: &c Clock) -> [heap, io_write, args, dir_read, dir_write, file_read, file_write, clock] int {
    var sub = "list";
    if options.rev_at >= 0 {
        sub = arg(args, options.rev_at);
    }
    if bytes.equal(sub, "list") {
        return branch_list(heap, io, vcs);
    }
    if bytes.equal(sub, "create") {
        return branch_create(heap, io, args, vcs, options, clock);
    }
    if bytes.equal(sub, "delete") {
        return branch_delete(heap, io, args, vcs, options, clock);
    }
    var message = buffer.append(heap, buffer.empty(heap, 64), "`branch ");
    message = buffer.append(heap, message, sub);
    message = buffer.append(heap, message, "`: expected list, create or delete");
    var code = 1;
    borrow message as &mb in {
        code = refused(heap, io, "branch", buffer.bytes(mb), "bad-argument");
    }
    buffer.drop(heap, message);
    return code;
}

// ---- the entry points --------------------------------------------------------------------------------------------------------

// Whether `cancho vcs SUB` is this module's: `init`, `show`, `branch`, `status` and `restore` are; `log` is unless `--store` is named or no repository is in reach of the current directory (the Rust command's rule: `Repo::exists_at(".")`).
pub fn routes[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, err_write, args, fs_read(""), exec(""), clock, poll, dir_read, dir_write, file_read] bool {
    let sub = arg(args, 2);
    if bytes.equal(sub, "init") || bytes.equal(sub, "show") || bytes.equal(sub, "branch") || bytes.equal(sub, "status") || bytes.equal(sub, "restore") || bytes.equal(sub, "switch") {
        return true;
    }
    if !bytes.equal(sub, "log") {
        return false;
    }
    var n = 3;
    while n < arg_count(args) {
        let word = arg(args, n);
        if bytes.equal(word, "--store") || len(word) > 8 && bytes.equal(word[0..8], "--store=") {
            return false;
        }
        n = n + 1;
    }
    let cwd = cliproject.current_directory(heap, io, exec, clock);
    var found = false;
    borrow cwd as &cb in {
        let root = find_root(heap, fs, buffer.bytes(cb));
        let (path, status, errno) = vcsstore.parts(root);
        found = status == 0;
        buffer.drop(heap, path);
    }
    buffer.drop(heap, cwd);
    return found;
}

// `cancho vcs init|log|show|branch|status|restore ...`.
pub fn command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), exec(""), clock, poll, dir_read, dir_write, dir_symlink, file_read, file_write] int {
    let verb = arg(args, 2);
    var which = 2;
    var name = "show";
    if bytes.equal(verb, "init") {
        which = 0;
        name = "init";
    } else if bytes.equal(verb, "log") {
        which = 1;
        name = "log";
    } else if bytes.equal(verb, "branch") {
        which = 3;
        name = "branch";
    } else if bytes.equal(verb, "status") {
        which = 4;
        name = "status";
    } else if bytes.equal(verb, "restore") {
        which = 5;
        name = "restore";
    } else if bytes.equal(verb, "switch") {
        which = 6;
        name = "switch";
    }
    let options = options_of(heap, io, args, which);
    if options.bad != 0 {
        return options.bad;
    }
    let cwd = cliproject.current_directory(heap, io, exec, clock);
    var code = 0;
    borrow cwd as &cb in {
        if which == 0 {
            code = init_command(heap, io, args, fs, buffer.bytes(cb), options);
        } else {
            let located = locate(heap, io, args, fs, buffer.bytes(cb), options, name);
            let (path, status, errno) = vcsstore.parts(located);
            if status != 0 {
                code = errno;
            } else {
                borrow path as &pb in {
                    match open_dir(fs, buffer.bytes(pb)) {
                        DirOpened::Ok(r0) => {
                            var root = r0;
                            borrow root as &rd in {
                                match vcsstore.enter_vcs(rd) {
                                    DirOpened::Ok(v0) => {
                                        var vcs = v0;
                                        borrow vcs as &vd in {
                                            if which == 1 {
                                                code = log_in(heap, io, args, vd, options);
                                            } else if which == 3 {
                                                code = branch_in(heap, io, args, vd, options, clock);
                                            } else if which == 4 {
                                                code = status_in(heap, io, rd, vd);
                                            } else if which == 5 {
                                                code = restore_in(heap, io, args, rd, vd, buffer.bytes(pb), buffer.bytes(cb), options, clock);
                                            } else if which == 6 {
                                                code = switch_in(heap, io, args, rd, vd, buffer.bytes(pb), options, clock);
                                            } else {
                                                code = show_in(heap, io, args, vd, options);
                                            }
                                        }
                                        dir_close(vcs);
                                    }
                                    DirOpened::Failed(e) => {
                                        code = answered(heap, io, name, vcsstore.Object { bytes: buffer.empty(heap, 0), status: 10, errno: e }, "");
                                    }
                                }
                            }
                            dir_close(root);
                        }
                        DirOpened::Failed(e) => {
                            code = answered(heap, io, name, vcsstore.Object { bytes: buffer.empty(heap, 0), status: 10, errno: e }, "");
                        }
                    }
                }
            }
            buffer.drop(heap, path);
        }
    }
    buffer.drop(heap, cwd);
    return code;
}
