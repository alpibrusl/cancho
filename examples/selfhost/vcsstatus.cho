edition 9;
module selfhost.vcsstatus;

// vcsstatus.cho -- the `status` command of `cancho vcs` (`docs/vcs-native.md` section 6, slice b4c), moved out of `vcsrepo.cho` (`docs/vcs-routing.md` R0) so that `vcsrepo.cho` -- HEAD, revisions, `log`
// and `show` -- imports nothing of `vcsscan.cho`: the working copy is read there, with `dir_readlink` (edition 12), and the committed seed does not compile that until it is refreshed.
// What this module answers is what `vcsrepo.cho` answered before the move, byte for byte; the helpers it shares with the other documents are `vcsrepo`'s `pub` ones.

import std.buffer;
import std.bytes;
import selfhost.jsonwrite;
import selfhost.vcsobj;
import selfhost.vcsrepo;
import selfhost.vcsscan;
import selfhost.vcsstore;

// The tag of a status: those of `vcsrepo.tag` (`bad-revision`, and `vcsstore.tag`'s) and `vcsscan.tag`'s (`path-escapes`, `path-unsupported`, and the rest of the scan's).
pub fn tag(status: int) -> [] &static [byte] {
    if status >= 18 && status <= 22 {
        return vcsrepo.tag(status);
    }
    return vcsscan.tag(status);
}

// ---- status ------------------------------------------------------------------------------------------------------------------

// What HEAD says: the branch (without `heads/`) in `bytes` and `has_branch` true, or HEAD detached; the change HEAD is at in `head` (empty if the branch has none).
pub res struct HeadInfo {
    branch: buffer.Buffer,
    has_branch: bool,
    head: buffer.Buffer,
    status: int,
}

pub fn head_parts(h: HeadInfo) -> [] (buffer.Buffer, bool, buffer.Buffer, int) {
    let HeadInfo { branch, has_branch, head, status } = h;
    return (branch, has_branch, head, status);
}

pub fn head_info[&h, &d](heap: &!h Heap, vcs: &d Dir) -> [heap, dir_read, dir_write, file_read] HeadInfo {
    let read = vcsstore.read_text(heap, vcs, "HEAD");
    let (text, status, errno) = vcsstore.parts(read);
    var branch = buffer.empty(heap, 0);
    var head = buffer.empty(heap, 0);
    var has = false;
    var code = status;
    if status == 0 {
        code = 3;
        borrow text as &tb in {
            let t = vcsstore.trimmed(buffer.bytes(tb));
            if bytes.starts_with(t, "ref: refs/") {
                var name = t[10..len(t)];
                if bytes.starts_with(name, "heads/") {
                    branch = buffer.append(heap, branch, name[6..len(name)]);
                } else {
                    branch = buffer.append(heap, branch, name);
                }
                has = true;
                let followed = vcsstore.read_ref(heap, vcs, name);
                let (id, fs, fe) = vcsstore.parts(followed);
                if fs == 0 {
                    buffer.drop(heap, head);
                    head = id;
                    code = 0;
                } else if fs == 2 {
                    buffer.drop(heap, id);
                    code = 0;
                } else {
                    buffer.drop(heap, id);
                    code = fs;
                }
            } else if vcsobj.is_id(t) {
                buffer.drop(heap, head);
                head = buffer.append(heap, buffer.empty(heap, 64), t);
                code = 0;
            }
        }
    }
    buffer.drop(heap, text);
    return HeadInfo { branch: branch, has_branch: has, head: head, status: code };
}

// The `status` document: the branch and change HEAD is at, and the paths whose files differ from HEAD's tree (as `diff_trees` finds them: `added`, `deleted`,
// `modified`, `mode`), with `clean` when there are none. `root` is the working copy's directory, `vcs` the store's.
pub fn status_command[&h, &r, &d, &s](heap: &!h Heap, root: &r Dir, vcs: &d Dir, scratch: &!s [int]) -> [heap, dir_read, dir_write, file_read] vcsstore.Object {
    let info = head_info(heap, vcs);
    let (branch, has_branch, head, status) = head_parts(info);
    if status != 0 {
        buffer.drop(heap, branch);
        buffer.drop(heap, head);
        return vcsrepo.failed(heap, status);
    }
    var old_tree = buffer.empty(heap, 0);
    var code = 0;
    var has_head = false;
    borrow head as &hb in {
        has_head = len(buffer.bytes(hb)) > 0;
        if has_head {
            let ti = vcsrepo.tree_id_of(heap, vcs, scratch, buffer.bytes(hb));
            let (tid, ts, te) = vcsstore.parts(ti);
            if ts != 0 {
                code = ts;
            } else {
                borrow tid as &tb in {
                    let tt = vcsrepo.tree_text(heap, vcs, scratch, buffer.bytes(tb));
                    let (text, xs, xe) = vcsstore.parts(tt);
                    buffer.drop(heap, old_tree);
                    old_tree = text;
                    code = xs;
                }
            }
            buffer.drop(heap, tid);
        }
    }
    var doc = buffer.empty(heap, 0);
    if code == 0 {
        let scanned = vcsscan.scan(heap, root, scratch);
        let (work, ws, we) = vcsstore.parts(scanned);
        if ws != 0 {
            code = ws;
            buffer.drop(heap, work);
        } else {
            borrow old_tree as &ob in {
                borrow work as &wb in {
                    var b = buffer.push(heap, buffer.empty(heap, 256), byte_of(123));
                    b = vcsrepo.member(heap, b, 1, true, "branch");
                    if has_branch {
                        borrow branch as &bb in {
                            b = jsonwrite.string(heap, b, buffer.bytes(bb));
                        }
                    } else {
                        b = buffer.append(heap, b, "null");
                    }
                    let changes = vcsrepo.emit_files(heap, buffer.empty(heap, 16), 1, buffer.bytes(ob), buffer.bytes(wb));
                    var clean = false;
                    borrow changes as &cb in {
                        clean = len(buffer.bytes(cb)) == 2;
                        b = buffer.append(heap, vcsrepo.member(heap, b, 1, false, "changes"), buffer.bytes(cb));
                    }
                    buffer.drop(heap, changes);
                    if clean {
                        b = buffer.append(heap, vcsrepo.member(heap, b, 1, false, "clean"), "true");
                    } else {
                        b = buffer.append(heap, vcsrepo.member(heap, b, 1, false, "clean"), "false");
                    }
                    b = buffer.append(heap, vcsrepo.member(heap, b, 1, false, "command"), "\"status\"");
                    b = vcsrepo.member(heap, b, 1, false, "head");
                    if has_head {
                        borrow head as &hb in {
                            b = vcsrepo.quoted(heap, b, buffer.bytes(hb));
                        }
                    } else {
                        b = buffer.append(heap, b, "null");
                    }
                    b = buffer.append(heap, vcsrepo.member(heap, b, 1, false, "ok"), "true");
                    b = buffer.append(heap, jsonwrite.newline(heap, b, 0), "}\n");
                    buffer.drop(heap, doc);
                    doc = b;
                }
            }
            buffer.drop(heap, work);
        }
    }
    buffer.drop(heap, branch);
    buffer.drop(heap, head);
    buffer.drop(heap, old_tree);
    if code != 0 {
        buffer.drop(heap, doc);
        return vcsrepo.failed(heap, code);
    }
    return vcsstore.Object { bytes: doc, status: 0, errno: 0 };
}
