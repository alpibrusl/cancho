module selfhost.emit;

// emit.cho -- the code the checker writes while it walks a function.
//
// Stage 4 of the self-hosting port (`docs/self-hosting.md` section 6): the checker already visits
// every expression in the order it runs and knows its type, so it writes LLVM IR as it goes, the
// text the Rust backend writes (`cancho-codegen-llvm`), and `clang` does the rest. The Rust
// compiler is the oracle here as everywhere, compared by what the programs do and not by the
// text: both are built from the same source, run, and must agree.
//
// The code goes to one of three buffers of the state, a byte to an int, `st[49]` saying which:
//
//     0 the output, the finished functions, kept
//     1 the body of the function being written
//     2 its `alloca`s, which belong at the top, in the entry block, however late a `let` comes
//
// An operand is a constant (`known`, `value`) or the temporary `%t<reg>`; a type is the checker's
// tag, 1 `int` as `i64` and 5 `bool` as `i1`, which are the only two written so far.

import selfhost.ast;
import selfhost.kinds;
import selfhost.types;
import selfhost.prims;
import selfhost.builtins;

pub fn on[&s](st: &!s [int]) -> [] bool {
    return st[40] != 0;
}

// Write to buffer `target`.
// Has a buffer of the code been written past its end? Each of the four holds `st[50]` bytes, and a byte
// past the end of one is in the next, so an answer of the code is no good once this is true.
pub fn overflowed[&s](st: &!s [int]) -> [] bool {
    return st[44] > st[50] || st[46] > st[50] || st[48] > st[50] || st[57] > st[50];
}

pub fn aim[&s](st: &!s [int], target: int) -> [] int {
    st[49] = target;
    return 0;
}

// Buffer 3, the constants (string literals), keeps its base and length in slots 56 and 57; the
// others in 43 and 44, 45 and 46, 47 and 48.
fn base_slot(t: int) -> [] int {
    if t == 3 {
        return 56;
    }
    return 43 + 2 * t;
}

pub fn put[&s](st: &!s [int], b: int) -> [] int {
    let t = st[49];
    let base = base_slot(t);
    st[st[base] + st[base + 1]] = b;
    st[base + 1] = st[base + 1] + 1;
    return 0;
}

pub fn str[&s](st: &!s [int], s: &static [byte]) -> [] int {
    var i = 0;
    while i < len(s) {
        put(st, int_of(s[i]));
        i = i + 1;
    }
    return 0;
}

// A natural number in decimal.
pub fn nat[&s](st: &!s [int], n: int) -> [] int {
    var scale = 1;
    while n / scale >= 10 {
        scale = scale * 10;
    }
    var rest = n;
    while scale > 0 {
        let digit = rest / scale;
        put(st, '0' + digit);
        rest = rest - digit * scale;
        scale = scale / 10;
    }
    return 0;
}

// An `int` in decimal.
pub fn int[&s](st: &!s [int], n: int) -> [] int {
    if n >= 0 {
        return nat(st, n);
    }
    if n == 0 - 9223372036854775807 - 1 {
        return str(st, "-9223372036854775808");
    }
    put(st, '-');
    return nat(st, 0 - n);
}

// The bytes of `text` from `from` to `to`.
pub fn slice[&s, &x](st: &!s [int], text: &x [byte], from: int, to: int) -> [] int {
    var i = from;
    while i < to {
        put(st, int_of(text[i]));
        i = i + 1;
    }
    return 0;
}

// Append buffer `from` to buffer `to`.
pub fn copy[&s](st: &!s [int], from: int, to: int) -> [] int {
    let keep = st[49];
    st[49] = to;
    var i = 0;
    while i < st[base_slot(from) + 1] {
        put(st, st[st[base_slot(from)] + i]);
        i = i + 1;
    }
    st[49] = keep;
    return 0;
}

pub fn clear[&s](st: &!s [int], target: int) -> [] int {
    st[base_slot(target) + 1] = 0;
    return 0;
}

// A fresh temporary number and a fresh label number, for the function being written.
pub fn fresh[&s](st: &!s [int]) -> [] int {
    let n = st[41];
    st[41] = n + 1;
    return n;
}

pub fn label[&s](st: &!s [int]) -> [] int {
    let n = st[42];
    st[42] = n + 1;
    return n;
}

// ------------------------------------------------------------------ types, operands ---

pub fn llvm_type[&s](st: &!s [int], ty: int) -> [] int {
    if types.is_erased(st, ty) {
        // A capability held in a struct has no value, but the aggregate has a place for it.
        return str(st, "{}");
    }
    if ty == 3 {
        return str(st, "double");
    }
    if ty == 4 {
        return str(st, "float");
    }
    if ty == 5 {
        return str(st, "i1");
    }
    if ty == 2 {
        return str(st, "i8");
    }
    if types.is_slice_ref(st, ty) {
        // Held in an aggregate: the pointer and the length.
        return str(st, "{ ptr, i64 }");
    }
    if ty == 7 || types.is_ref(st, ty) {
        return str(st, "ptr");
    }
    if types.is_boxslice(st, ty) {
        return str(st, "{ ptr, i64 }");
    }
    if types.is_box(st, ty) || types.is_thread(st, ty) || types.is_fnval(st, ty) || types.is_fnptr(st, ty) {
        return str(st, "ptr");
    }
    if types.is_tuple(st, ty) {
        str(st, "{ ");
        var k = 0;
        while k < types.tuple_size(st, ty) {
            if k > 0 {
                str(st, ", ");
            }
            llvm_type(st, types.tuple_part(st, ty, k));
            k = k + 1;
        }
        return str(st, " }");
    }
    if types.is_penum(st, ty) {
        return penum_type(st, types.prelude_index(st, ty));
    }
    if types.is_prelude(st, ty) {
        return str(st, "i64");
    }
    if types.is_named(st, ty) {
        let item = types.named_item(st, ty);
        if ast.is_kind(st, item, kinds.NK::IEnum) {
            return enum_type(st, ty);
        }
        return struct_type(st, ty);
    }
    if types.is_tvar(st, ty) && types.shallow(st, ty) != ty {
        // A type a variable of the call has been solved to.
        return llvm_type(st, types.shallow(st, ty));
    }
    return str(st, "i64");
}

// A plain struct is an LLVM aggregate of its fields, `{ i64, i1 }`: one value, so it is stored,
// loaded, passed and returned like a whole number, and its fields are `insertvalue` and
// `extractvalue` (or an address and a load or store, behind a reference).
pub fn struct_type[&s](st: &!s [int], ty: int) -> [] int {
    str(st, "{ ");
    var f = ast.get(st, types.named_item(st, ty), 8);
    while f >= 0 {
        llvm_type(st, field_scalar(st, f, ty));
        f = ast.next(st, f);
        if f >= 0 {
            str(st, ", ");
        }
    }
    return str(st, " }");
}

// The type of the field declared by node `f`: a scalar tag, a struct or an enum, a box.
pub fn field_scalar[&s](st: &!s [int], f: int, ty: int) -> [] int {
    return types.node_type(st, ast.get(st, f, 5), ty);
}

// The field of `item` at position `index`, by its declaration node.
pub fn field_node[&s](st: &!s [int], item: int, index: int) -> [] int {
    var f = ast.get(st, item, 8);
    var i = 0;
    while i < index {
        f = ast.next(st, f);
        i = i + 1;
    }
    return f;
}

// The aggregate value `acc` (or `undef` when it is -1) of type `ty` with element `index` of type
// `fty` set to the operand.
pub fn insert_at[&s](st: &!s [int], ty: int, acc: int, index: int, fty: int, known: bool, value: int, reg: int) -> [] int {
    if types.is_erased(st, fty) {
        return acc;
    }
    let n = start(st);
    str(st, "insertvalue ");
    llvm_type(st, ty);
    str(st, " ");
    if acc < 0 {
        str(st, "undef");
    } else {
        temp(st, acc);
    }
    str(st, ", ");
    llvm_type(st, fty);
    str(st, " ");
    operand(st, fty, known, value, reg);
    str(st, ", ");
    nat(st, index);
    str(st, "\n");
    return n;
}

// The struct value `acc` (or `undef`) with field `index` set to the operand.
pub fn insert_field[&s](st: &!s [int], ty: int, acc: int, index: int, known: bool, value: int, reg: int) -> [] int {
    let item = types.named_item(st, ty);
    let fty = field_scalar(st, field_node(st, item, index), ty);
    return insert_at(st, ty, acc, index, fty, known, value, reg);
}

// An enum is an aggregate of its tag and, one after the other, the payloads of every variant:
// `{ i64, i64, i1 }` for `A(int)` and `B(bool)`. Only the tag and the payloads of the variant it
// names mean anything. The tag is the variant's position.
pub fn enum_type[&s](st: &!s [int], ty: int) -> [] int {
    str(st, "{ i64");
    var v = ast.get(st, types.named_item(st, ty), 8);
    while v >= 0 {
        var p = ast.get(st, v, 5);
        var n = ast.get(st, v, 6);
        while n > 0 {
            str(st, ", ");
            llvm_type(st, types.node_type(st, p, ty));
            p = ast.next(st, p);
            n = n - 1;
        }
        v = ast.next(st, v);
    }
    return str(st, " }");
}

// A prelude enum is the same aggregate as one of the file: the tag, then the payloads of every arm that
// are anything in the code, one after the other.
pub fn penum_type[&s](st: &!s [int], index: int) -> [] int {
    str(st, "{ i64");
    let first = builtins.prelude_arm_first(index);
    var k = 0;
    while k < builtins.prelude_arm_count(index) {
        let at = builtins.arm_type_start(first + k);
        var cursor = at + 1;
        var j = 0;
        while j < builtins.field_type(at) {
            let t = prims.decode(st, true, cursor, 0 - 1, false);
            cursor = st[53];
            if t != 0 && !types.is_erased(st, t) {
                str(st, ", ");
                llvm_type(st, t);
            }
            j = j + 1;
        }
        k = k + 1;
    }
    return str(st, " }");
}

// The index in the aggregate of payload `j` of arm number `arm` (of all) of the prelude enum `index`.
pub fn penum_payload_index[&s](st: &!s [int], index: int, arm: int, j: int) -> [] int {
    let first = builtins.prelude_arm_first(index);
    var at_index = 1;
    var k = first;
    while k <= arm {
        let at = builtins.arm_type_start(k);
        var cursor = at + 1;
        var i = 0;
        let stop = builtins.field_type(at);
        while i < stop && (k < arm || i < j) {
            let t = prims.decode(st, true, cursor, 0 - 1, false);
            cursor = st[53];
            if t != 0 && !types.is_erased(st, t) {
                at_index = at_index + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    return at_index;
}

// The position of the variant `variant` among those of `item`.
pub fn variant_position[&s](st: &!s [int], item: int, variant: int) -> [] int {
    var v = ast.get(st, item, 8);
    var i = 0;
    while v != variant {
        v = ast.next(st, v);
        i = i + 1;
    }
    return i;
}

// The index in the aggregate of payload `k` of `variant`.
pub fn payload_index[&s](st: &!s [int], item: int, variant: int, k: int) -> [] int {
    var v = ast.get(st, item, 8);
    var at = 1;
    while v != variant {
        at = at + ast.get(st, v, 6);
        v = ast.next(st, v);
    }
    return at + k;
}

// The pointer and the length of a slice reference as the aggregate `{ ptr, i64 }`.
pub fn pack_slice[&s](st: &!s [int], ptr_reg: int, lk: bool, lv: int, lr: int) -> [] int {
    let a = start(st);
    str(st, "insertvalue { ptr, i64 } undef, ptr ");
    operand(st, 7, false, 0, ptr_reg);
    str(st, ", 0\n");
    let b = start(st);
    str(st, "insertvalue { ptr, i64 } ");
    temp(st, a);
    str(st, ", i64 ");
    operand(st, 1, lk, lv, lr);
    str(st, ", 1\n");
    return b;
}

// Part `k` (0 the pointer, 1 the length) of the packed slice `packed`.
pub fn slice_part[&s](st: &!s [int], packed: int, k: int) -> [] int {
    let n = start(st);
    str(st, "extractvalue { ptr, i64 } ");
    temp(st, packed);
    str(st, ", ");
    nat(st, k);
    str(st, "\n");
    return n;
}

// Field `index` of the struct value in register `reg`.
pub fn extract_field[&s](st: &!s [int], ty: int, reg: int, index: int) -> [] int {
    let n = start(st);
    str(st, "extractvalue ");
    llvm_type(st, ty);
    str(st, " ");
    temp(st, reg);
    str(st, ", ");
    nat(st, index);
    str(st, "\n");
    return n;
}

// The address of field `index` of the struct a reference points at.
pub fn field_address[&s](st: &!s [int], ty: int, ptr_reg: int, index: int) -> [] int {
    let n = start(st);
    str(st, "getelementptr ");
    llvm_type(st, ty);
    str(st, ", ptr ");
    temp(st, ptr_reg);
    str(st, ", i32 0, i32 ");
    nat(st, index);
    str(st, "\n");
    return n;
}

// Operand number `k` of the last `n` arguments pushed (a slice is two): a constant or a temporary.
pub fn last_operand[&s](st: &!s [int], n: int, k: int) -> [] int {
    let at = st[51] + 4 * (st[52] - n + k);
    return operand(st, st[at], st[at + 1] != 0, st[at + 2], st[at + 3]);
}

// An operand: a constant or a temporary.
pub fn operand[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int) -> [] int {
    if ty == 7 && !known && reg == 0 - 1 {
        // A pointer that is not anywhere: the prefix of a capability that was not narrowed.
        return str(st, "null");
    }
    if !known && reg == 0 - 1 && types.is_ref(st, ty) {
        // A reference to a capability, which has no place of its own: a pointer to nothing.
        return str(st, "null");
    }
    if reg <= 0 - 2 {
        // A string literal's global, `@str.<n>`, kept as `-2 - n`.
        str(st, "@str.");
        return nat(st, 0 - 2 - reg);
    }
    if !known && reg == 0 - 1 && types.is_named(st, ty) {
        // A struct of capabilities has no value to hold.
        return str(st, "zeroinitializer");
    }
    if known {
        if ty == 5 {
            if value != 0 {
                return str(st, "true");
            }
            return str(st, "false");
        }
        if ty == 3 || ty == 4 {
            // The bits of the double, which an `f32` constant is widened to.
            return hex64(st, value);
        }
        return int(st, value);
    }
    str(st, "%t");
    return nat(st, reg);
}

// `0x` and sixteen hexadecimal digits: how LLVM spells a floating-point constant exactly.
pub fn hex64[&s](st: &!s [int], value: int) -> [] int {
    str(st, "0x");
    var k = 15;
    while k >= 0 {
        let nibble = value >> 4 * k & 15;
        if nibble < 10 {
            put(st, 48 + nibble);
        } else {
            put(st, 55 + nibble);
        }
        k = k - 1;
    }
    return 0;
}

pub fn temp[&s](st: &!s [int], n: int) -> [] int {
    str(st, "%t");
    return nat(st, n);
}

// `  %t<n> = ` for a new temporary, which is answered.
pub fn start[&s](st: &!s [int]) -> [] int {
    let n = fresh(st);
    str(st, "  ");
    temp(st, n);
    str(st, " = ");
    return n;
}

// ---------------------------------------------------------------------- stack slots ---

// A stack slot for the binding declared as number `slot`, in the entry block.
pub fn alloca[&s](st: &!s [int], ty: int, slot: int) -> [] int {
    let keep = st[49];
    st[49] = 2;
    str(st, "  %s");
    nat(st, slot);
    str(st, " = alloca ");
    llvm_type(st, ty);
    str(st, "\n");
    st[49] = keep;
    return 0;
}

// `%t<n> = load` from a slot; answers n.
pub fn load[&s](st: &!s [int], ty: int, slot: int) -> [] int {
    let n = start(st);
    str(st, "load ");
    llvm_type(st, ty);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "\n");
    return n;
}

pub fn store[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int, slot: int) -> [] int {
    str(st, "  store ");
    llvm_type(st, ty);
    str(st, " ");
    operand(st, ty, known, value, reg);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "\n");
    return 0;
}

// A parameter's value into its slot at entry.
pub fn store_param[&s](st: &!s [int], ty: int, index: int, slot: int) -> [] int {
    str(st, "  store ");
    llvm_type(st, ty);
    str(st, " %arg");
    nat(st, index);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "\n");
    return 0;
}

// A pointer to the stack slot of the binding declared as number `slot`, stored in the slot of the
// reference declared as `into`: a reference to a whole number or a boolean.
pub fn store_slot_address[&s](st: &!s [int], into: int, slot: int) -> [] int {
    str(st, "  store ptr %s");
    nat(st, slot);
    str(st, ", ptr %s");
    nat(st, into);
    str(st, "\n");
    return 0;
}

// A reference to a value that has no representation (`Io`, which is nothing in the code) is a
// pointer to a byte of its own; the byte is in the entry block, and the pointer is stored in the
// slot of the reference declared as `into`.
pub fn store_dummy_pointer[&s](st: &!s [int], into: int) -> [] int {
    let n = fresh(st);
    let keep = st[49];
    st[49] = 2;
    str(st, "  %t");
    nat(st, n);
    str(st, " = alloca i8, i64 1\n");
    st[49] = keep;
    str(st, "  store ptr %t");
    nat(st, n);
    str(st, ", ptr %s");
    nat(st, into);
    str(st, "\n");
    return 0;
}

// -------------------------------------------------------------------------- traps ---

// Trap if the `i1` temporary `flag` is set, and go on in a new block otherwise.
pub fn trap_if[&s](st: &!s [int], flag: int) -> [] int {
    let n = label(st);
    str(st, "  br i1 ");
    temp(st, flag);
    str(st, ", label %trap");
    nat(st, n);
    str(st, ", label %ok");
    nat(st, n);
    str(st, "\ntrap");
    nat(st, n);
    str(st, ":\n  call void @llvm.trap()\n  unreachable\nok");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// -------------------------------------------------------------------- arithmetic ---

// `+` (0), `-` (1) or `*` (2) on `int`, trapping on overflow: the intrinsic's pair, its value,
// its flag.
pub fn checked[&s](st: &!s [int], kind: int, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let pair = start(st);
    str(st, "call {i64, i1} @llvm.");
    if kind == 0 {
        str(st, "sadd");
    } else if kind == 1 {
        str(st, "ssub");
    } else {
        str(st, "smul");
    }
    str(st, ".with.overflow.i64(i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", i64 ");
    operand(st, 1, bk, bv, br);
    str(st, ")\n");
    let value = start(st);
    str(st, "extractvalue {i64, i1} ");
    temp(st, pair);
    str(st, ", 0\n");
    let flag = start(st);
    str(st, "extractvalue {i64, i1} ");
    temp(st, pair);
    str(st, ", 1\n");
    trap_if(st, flag);
    return value;
}

// `&` (0), `|` (1), `^` (2): nothing to check.
pub fn bitwise[&s](st: &!s [int], kind: int, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let n = start(st);
    if kind == 0 {
        str(st, "and");
    } else if kind == 1 {
        str(st, "or");
    } else {
        str(st, "xor");
    }
    str(st, " i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", ");
    operand(st, 1, bk, bv, br);
    str(st, "\n");
    return n;
}

// `<<` and `>>`: an amount outside 0..64 traps, and `>>` is arithmetic.
pub fn shift[&s](st: &!s [int], left: bool, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let range = start(st);
    str(st, "icmp uge i64 ");
    operand(st, 1, bk, bv, br);
    str(st, ", 64\n");
    trap_if(st, range);
    let n = start(st);
    if left {
        str(st, "shl");
    } else {
        str(st, "ashr");
    }
    str(st, " i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", ");
    operand(st, 1, bk, bv, br);
    str(st, "\n");
    return n;
}

// `/` and `%`: LLVM's `sdiv` and `srem` are undefined on a zero divisor and on `int::MIN` by -1, so
// both are checked first. `int::MIN / -1` traps; `int::MIN % -1` is 0, reached by a branch because
// a `select` would still evaluate the undefined pair.
pub fn divide[&s](st: &!s [int], remainder: bool, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let zero = start(st);
    str(st, "icmp eq i64 ");
    operand(st, 1, bk, bv, br);
    str(st, ", 0\n");
    trap_if(st, zero);
    let is_min = start(st);
    str(st, "icmp eq i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", -9223372036854775808\n");
    let is_neg1 = start(st);
    str(st, "icmp eq i64 ");
    operand(st, 1, bk, bv, br);
    str(st, ", -1\n");
    let both = start(st);
    str(st, "and i1 ");
    temp(st, is_min);
    str(st, ", ");
    temp(st, is_neg1);
    str(st, "\n");
    if !remainder {
        trap_if(st, both);
        let q = start(st);
        str(st, "sdiv i64 ");
        operand(st, 1, ak, av, ar);
        str(st, ", ");
        operand(st, 1, bk, bv, br);
        str(st, "\n");
        return q;
    }
    let n = label(st);
    str(st, "  br i1 ");
    temp(st, both);
    str(st, ", label %remspecial");
    nat(st, n);
    str(st, ", label %remcompute");
    nat(st, n);
    str(st, "\nremcompute");
    nat(st, n);
    str(st, ":\n");
    let computed = start(st);
    str(st, "srem i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", ");
    operand(st, 1, bk, bv, br);
    str(st, "\n  br label %remend");
    nat(st, n);
    str(st, "\nremspecial");
    nat(st, n);
    str(st, ":\n  br label %remend");
    nat(st, n);
    str(st, "\nremend");
    nat(st, n);
    str(st, ":\n");
    let result = start(st);
    str(st, "phi i64 [ 0, %remspecial");
    nat(st, n);
    str(st, " ], [ ");
    temp(st, computed);
    str(st, ", %remcompute");
    nat(st, n);
    str(st, " ]\n");
    return result;
}

// A comparison, `==` (2) through `>=` (7) by the operator number, on two values of type `ty`: an
// `i1`.
pub fn compare[&s](st: &!s [int], op: int, ty: int, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let n = start(st);
    str(st, "icmp ");
    if op == 2 {
        str(st, "eq");
    } else if op == 3 {
        str(st, "ne");
    } else if op == 4 {
        str(st, "slt");
    } else if op == 5 {
        str(st, "sle");
    } else if op == 6 {
        str(st, "sgt");
    } else {
        str(st, "sge");
    }
    str(st, " ");
    llvm_type(st, ty);
    str(st, " ");
    operand(st, ty, ak, av, ar);
    str(st, ", ");
    operand(st, ty, bk, bv, br);
    str(st, "\n");
    return n;
}

// `!b`.
pub fn not[&s](st: &!s [int], ak: bool, av: int, ar: int) -> [] int {
    let n = start(st);
    str(st, "xor i1 ");
    operand(st, 5, ak, av, ar);
    str(st, ", true\n");
    return n;
}

// `~x`.
pub fn bit_not[&s](st: &!s [int], ak: bool, av: int, ar: int) -> [] int {
    let n = start(st);
    str(st, "xor i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", -1\n");
    return n;
}

// ------------------------------------------------------------------------ control flow ---
//
// Each construct takes one number `n` from `label`, and its blocks are named by it: `then`, `else`,
// `end` for an `if`; `head`, `body`, `end` for a `while`; `scrhs` and `scend` for `&&` and `||`.
// Whatever follows a `ret` is in a block of its own, so the `br` that ends an arm is always in a
// block, and the checker has refused the code that would make it matter.

// The `if` whose condition is the `i1` operand: the branch, and the block of the `then` arm.
pub fn if_begin[&s](st: &!s [int], n: int, known: bool, value: int, reg: int) -> [] int {
    str(st, "  br i1 ");
    operand(st, 5, known, value, reg);
    str(st, ", label %then");
    nat(st, n);
    str(st, ", label %else");
    nat(st, n);
    str(st, "\nthen");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// The end of the `then` arm and the start of the `else` one, which is empty if there is none.
pub fn if_else[&s](st: &!s [int], n: int) -> [] int {
    str(st, "  br label %end");
    nat(st, n);
    str(st, "\nelse");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

pub fn if_end[&s](st: &!s [int], n: int) -> [] int {
    str(st, "  br label %end");
    nat(st, n);
    str(st, "\nend");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// The head of a `while`, where its condition is computed.
pub fn while_head[&s](st: &!s [int], n: int) -> [] int {
    str(st, "  br label %head");
    nat(st, n);
    str(st, "\nhead");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// The branch on the condition, and the block of the body.
pub fn while_cond[&s](st: &!s [int], n: int, known: bool, value: int, reg: int) -> [] int {
    str(st, "  br i1 ");
    operand(st, 5, known, value, reg);
    str(st, ", label %body");
    nat(st, n);
    str(st, ", label %end");
    nat(st, n);
    str(st, "\nbody");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

pub fn while_end[&s](st: &!s [int], n: int) -> [] int {
    str(st, "  br label %head");
    nat(st, n);
    str(st, "\nend");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// `a && b` and `a || b`: the result lives in a stack slot of its own, `%sc<n>`. After `a`, the slot
// holds `a` and `b` is computed only if `a` did not already decide it.
pub fn short_begin[&s](st: &!s [int], n: int, either: bool, known: bool, value: int, reg: int) -> [] int {
    let keep = st[49];
    st[49] = 2;
    str(st, "  %sc");
    nat(st, n);
    str(st, " = alloca i1\n");
    st[49] = keep;
    str(st, "  store i1 ");
    operand(st, 5, known, value, reg);
    str(st, ", ptr %sc");
    nat(st, n);
    str(st, "\n  br i1 ");
    operand(st, 5, known, value, reg);
    if either {
        str(st, ", label %scend");
        nat(st, n);
        str(st, ", label %scrhs");
        nat(st, n);
    } else {
        str(st, ", label %scrhs");
        nat(st, n);
        str(st, ", label %scend");
        nat(st, n);
    }
    str(st, "\nscrhs");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// After `b`: the slot takes it, and the result is the slot, in a temporary.
pub fn short_end[&s](st: &!s [int], n: int, known: bool, value: int, reg: int) -> [] int {
    str(st, "  store i1 ");
    operand(st, 5, known, value, reg);
    str(st, ", ptr %sc");
    nat(st, n);
    str(st, "\n  br label %scend");
    nat(st, n);
    str(st, "\nscend");
    nat(st, n);
    str(st, ":\n");
    let r = start(st);
    str(st, "load i1, ptr %sc");
    nat(st, n);
    str(st, "\n");
    return r;
}

// ------------------------------------------------------------------------- calls ---

// The arguments of the calls being written wait on a stack of four ints each, at `st[52 + ...]`'s
// base `st[51]`, with `st[52]` how many: a call's arguments are known one at a time, and the
// call written once the last is.
pub fn push_arg[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int) -> [] int {
    let at = st[51] + 4 * st[52];
    st[at] = ty;
    st[at + 1] = ast.flag(known);
    st[at + 2] = value;
    st[at + 3] = reg;
    st[52] = st[52] + 1;
    return 0;
}

// The call of `name`, the identifier at token `name` of `text`, to the last `n` arguments pushed,
// returning `ret`; answers the temporary of the result.
pub fn call[&s](st: &!s [int], callee: int, inst: int, ret: int, n: int) -> [] int {
    let result = start(st);
    str(st, "call ");
    ret_type(st, ret);
    str(st, " @lexs_");
    nat(st, callee);
    instance_suffix(st, inst);
    return call_tail(st, result, ret, n);
}

// The call of the function whose address is in the temporary `pointer`.
pub fn call_pointer[&s](st: &!s [int], pointer: int, ret: int, n: int) -> [] int {
    let result = start(st);
    str(st, "call ");
    ret_type(st, ret);
    str(st, " ");
    temp(st, pointer);
    return call_tail(st, result, ret, n);
}

// The arguments of a call, the last `n` pushed, and what comes back.
fn call_tail[&s](st: &!s [int], result: int, ret: int, n: int) -> [] int {
    let first = st[52] - n;
    str(st, "(");
    var i = 0;
    while i < n {
        let at = st[51] + 4 * (first + i);
        if i > 0 {
            str(st, ", ");
        }
        llvm_type(st, st[at]);
        str(st, " ");
        operand(st, st[at], st[at + 1] != 0, st[at + 2], st[at + 3]);
        i = i + 1;
    }
    str(st, ")\n");
    st[52] = first;
    if types.is_slice_ref(st, ret) {
        // A slice comes back as the pair; its two parts, the length left in `st[59]`.
        let p = start(st);
        str(st, "extractvalue { ptr, i64 } ");
        temp(st, result);
        str(st, ", 0\n");
        let len = start(st);
        str(st, "extractvalue { ptr, i64 } ");
        temp(st, result);
        str(st, ", 1\n");
        st[59] = len;
        return p;
    }
    return result;
}

// The type a function answers: a reference to a slice is the pair of its pointer and its length.
pub fn ret_type[&s](st: &!s [int], ty: int) -> [] int {
    if types.is_slice_ref(st, ty) {
        return str(st, "{ ptr, i64 }");
    }
    return llvm_type(st, ty);
}

// `return s;` of a slice: the pair.
pub fn ret_slice[&s](st: &!s [int], p: int, lk: bool, lv: int, lr: int) -> [] int {
    let pair = types.make_boxslice(st, 1);
    let first = insert_at(st, pair, 0 - 1, 0, 7, false, 0, p);
    let both = insert_at(st, pair, first, 1, 1, lk, lv, lr);
    str(st, "  ret { ptr, i64 } ");
    temp(st, both);
    str(st, "\n");
    let n = label(st);
    str(st, "dead");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// `s[a..b]` of a slice (`base`, its length) of `element`: an end past the length traps, and so does a
// start past the end (an inverted range); the address of the first element is answered and the new
// length left in `st[59]`.
pub fn subslice[&s](st: &!s [int], element: int, base: int, lk: bool, lv: int, lr: int, ak: bool, av: int, ar: int, zk: bool, zv: int, zr: int) -> [] int {
    let past = start(st);
    str(st, "icmp ugt i64 ");
    operand(st, 1, zk, zv, zr);
    str(st, ", ");
    operand(st, 1, lk, lv, lr);
    str(st, "\n");
    trap_if(st, past);
    let inverted = start(st);
    str(st, "icmp ugt i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", ");
    operand(st, 1, zk, zv, zr);
    str(st, "\n");
    trap_if(st, inverted);
    let offset = start(st);
    str(st, "mul i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", ");
    stride_text(st, element);
    str(st, "\n");
    let at = start(st);
    str(st, "getelementptr i8, ptr ");
    operand(st, 7, false, 0, base);
    str(st, ", i64 ");
    temp(st, offset);
    str(st, "\n");
    let length = start(st);
    str(st, "sub i64 ");
    operand(st, 1, zk, zv, zr);
    str(st, ", ");
    operand(st, 1, ak, av, ar);
    str(st, "\n");
    st[59] = length;
    return at;
}

// `putchar` of the last two arguments pushed, the second a whole number: the character to the
// standard output, answering the temporary of the C function's result as a whole number.
pub fn put_char[&s](st: &!s [int]) -> [] int {
    let at = st[51] + 4 * (st[52] - 1);
    let narrow = start(st);
    str(st, "trunc i64 ");
    operand(st, st[at], st[at + 1] != 0, st[at + 2], st[at + 3]);
    str(st, " to i32\n");
    let done = start(st);
    str(st, "call i32 @putchar(i32 ");
    temp(st, narrow);
    str(st, ")\n");
    let wide = start(st);
    str(st, "sext i32 ");
    temp(st, done);
    str(st, " to i64\n");
    st[52] = st[52] - 2;
    return wide;
}

// ---------------------------------------------------------------------- statements ---

// `ret` of an operand, then a block of its own for whatever follows, so that every block ends in
// one terminator even when the checker has refused nothing after a `return`.
pub fn ret[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int) -> [] int {
    str(st, "  ret ");
    llvm_type(st, ty);
    str(st, " ");
    if !known && reg == 0 - 1 && types.is_erased(st, ty) {
        // A capability given back: nothing.
        str(st, "zeroinitializer");
    } else {
        operand(st, ty, known, value, reg);
    }
    str(st, "\n");
    let n = label(st);
    str(st, "dead");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// -------------------------------------------------------------------------- arenas ---
//
// A `region a { .. }` is a cell `%ar<n>` (the number of its block) holding the head of a list of the
// allocations made in it; each is a `malloc` with a header that links to the one before, and the end
// of the block frees them all. Both are the two helpers the driver writes, `@cancho_arena_alloc`
// and `@cancho_arena_free`. A `return` inside the block leaves without freeing: the memory is
// handed back when the program ends, which a program of any length would not do.

pub fn arena_open[&s](st: &!s [int], id: int) -> [] int {
    let keep = st[49];
    st[49] = 2;
    str(st, "  %ar");
    nat(st, id);
    str(st, " = alloca ptr\n");
    st[49] = keep;
    str(st, "  store ptr null, ptr %ar");
    nat(st, id);
    str(st, "\n");
    return 0;
}

pub fn arena_close[&s](st: &!s [int], id: int) -> [] int {
    let head = start(st);
    str(st, "load ptr, ptr %ar");
    nat(st, id);
    str(st, "\n  call void @cancho_arena_free(ptr ");
    temp(st, head);
    str(st, ")\n");
    return 0;
}

// The size in bytes of `count` elements: a negative count traps, and so does a size that overflows.
fn slice_bytes[&s](st: &!s [int], element: int, ck: bool, cv: int, cr: int) -> [] int {
    let negative = start(st);
    str(st, "icmp slt i64 ");
    operand(st, 1, ck, cv, cr);
    str(st, ", 0\n");
    trap_if(st, negative);
    if !types.is_plain(element) {
        let size = start(st);
        str(st, "add i64 0, ");
        size_of(st, element);
        str(st, "\n");
        return checked(st, 2, ck, cv, cr, false, 0, size);
    }
    return checked(st, 2, ck, cv, cr, true, stride(st, element), 0 - 1);
}

// `count` copies of the fill written into the run at `p`, by a loop.
fn fill_run[&s](st: &!s [int], p: int, element: int, ck: bool, cv: int, cr: int, fk: bool, fv: int, fr: int) -> [] int {
    let n = label(st);
    let keep = st[49];
    st[49] = 2;
    str(st, "  %fc");
    nat(st, n);
    str(st, " = alloca i64\n");
    st[49] = keep;
    str(st, "  store i64 0, ptr %fc");
    nat(st, n);
    str(st, "\n  br label %fh");
    nat(st, n);
    str(st, "\nfh");
    nat(st, n);
    str(st, ":\n");
    let i = start(st);
    str(st, "load i64, ptr %fc");
    nat(st, n);
    str(st, "\n");
    let more = start(st);
    str(st, "icmp slt i64 ");
    temp(st, i);
    str(st, ", ");
    operand(st, 1, ck, cv, cr);
    str(st, "\n  br i1 ");
    temp(st, more);
    str(st, ", label %fb");
    nat(st, n);
    str(st, ", label %fe");
    nat(st, n);
    str(st, "\nfb");
    nat(st, n);
    str(st, ":\n");
    let offset = start(st);
    str(st, "mul i64 ");
    temp(st, i);
    str(st, ", ");
    stride_text(st, element);
    str(st, "\n");
    let at = start(st);
    str(st, "getelementptr i8, ptr ");
    temp(st, p);
    str(st, ", i64 ");
    temp(st, offset);
    str(st, "\n");
    store_through(st, element, fk, fv, fr, at);
    let next = start(st);
    str(st, "add i64 ");
    temp(st, i);
    str(st, ", 1\n  store i64 ");
    temp(st, next);
    str(st, ", ptr %fc");
    nat(st, n);
    str(st, "\n  br label %fh");
    nat(st, n);
    str(st, "\nfe");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// `alloc_slice[a](count, fill)` of a whole number, a byte or a boolean, in arena `arena`. The pointer.
pub fn alloc_slice[&s](st: &!s [int], arena: int, element: int, ck: bool, cv: int, cr: int, fk: bool, fv: int, fr: int) -> [] int {
    let bytes = slice_bytes(st, element, ck, cv, cr);
    let p = start(st);
    str(st, "call ptr @cancho_arena_alloc(ptr %ar");
    nat(st, arena);
    str(st, ", i64 ");
    temp(st, bytes);
    str(st, ")\n");
    fill_run(st, p, element, ck, cv, cr, fk, fv, fr);
    return p;
}

// -------------------------------------------------------------------------- statics ---
//
// A `static` table is a global `@sd<n>`, the pair of a pointer and a length (`n` the item's node), and
// a function `@sinit<n>` that runs its body and stores the result there. The driver calls every
// `@sinit` before `main`, in the order the items come. The table is `malloc`ed, once, and never freed.

pub fn static_header[&s](st: &!s [int], item: int) -> [] int {
    aim(st, 0);
    str(st, "@sd");
    nat(st, item);
    str(st, " = internal global { ptr, i64 } zeroinitializer\n");
    str(st, "define void @sinit");
    nat(st, item);
    str(st, "(");
    return 0;
}

// A static the code is not written for: a global that is never read and an initialiser that does nothing.
pub fn static_stub[&s](st: &!s [int], item: int) -> [] int {
    aim(st, 0);
    str(st, "@sd");
    nat(st, item);
    str(st, " = internal global { ptr, i64 } zeroinitializer\ndefine void @sinit");
    nat(st, item);
    str(st, "() {\n  ret void\n}\n\n");
    return 0;
}

// `return table;` in a static body: the pair stored in the global, and the function ends.
pub fn static_return[&s](st: &!s [int], item: int, p: int, lk: bool, lv: int, lr: int) -> [] int {
    let pair = types.make_boxslice(st, 1);
    let first = insert_at(st, pair, 0 - 1, 0, 7, false, 0, p);
    let both = insert_at(st, pair, first, 1, 1, lk, lv, lr);
    str(st, "  store { ptr, i64 } ");
    temp(st, both);
    str(st, ", ptr @sd");
    nat(st, item);
    str(st, "\n  ret void\n");
    let n = label(st);
    str(st, "dead");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// The pointer of the table of static item `item`; its length is left in `st[59]`.
pub fn static_load[&s](st: &!s [int], item: int) -> [] int {
    let pair = start(st);
    str(st, "load { ptr, i64 }, ptr @sd");
    nat(st, item);
    str(st, "\n");
    let p = start(st);
    str(st, "extractvalue { ptr, i64 } ");
    temp(st, pair);
    str(st, ", 0\n");
    let n = start(st);
    str(st, "extractvalue { ptr, i64 } ");
    temp(st, pair);
    str(st, ", 1\n");
    st[59] = n;
    return p;
}

// ---------------------------------------------------------------------------- heap ---
//
// `Box[[T]]` is the aggregate `{ ptr, i64 }`, the run and its length, and one value in the code like
// a struct. The run is a `malloc` (trapping when it answers null, as the Rust backend does) and
// `unbox_slice` the `free`.

// The size in bytes of a value of type `ty`, as a constant of the module (the address of the second of an array).
pub fn size_of[&s](st: &!s [int], ty: int) -> [] int {
    str(st, "ptrtoint (ptr getelementptr (");
    llvm_type(st, ty);
    return str(st, ", ptr null, i32 1) to i64)");
}

// `box(heap, v)`: one `malloc` of a value of type `ty`, the value stored there (a null answer traps); the pointer.
pub fn box_value[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int) -> [] int {
    let p = start(st);
    str(st, "call ptr @malloc(i64 ");
    size_of(st, ty);
    str(st, ")\n");
    let none = start(st);
    str(st, "icmp eq ptr ");
    temp(st, p);
    str(st, ", null\n");
    trap_if(st, none);
    store_through(st, ty, known, value, reg, p);
    return p;
}

// `unbox(heap, b)`: the value of type `ty` the box at `b` holds, which is freed.
pub fn unbox_value[&s](st: &!s [int], ty: int, b: int) -> [] int {
    let v = load_through(st, ty, b);
    str(st, "  call void @free(ptr ");
    temp(st, b);
    str(st, ")\n");
    return v;
}

// `alloc[a](v)`: the value of type `ty` stored in the arena `arena`; the pointer.
pub fn arena_value[&s](st: &!s [int], arena: int, ty: int, known: bool, value: int, reg: int) -> [] int {
    let p = start(st);
    str(st, "call ptr @cancho_arena_alloc(ptr %ar");
    nat(st, arena);
    str(st, ", i64 ");
    size_of(st, ty);
    str(st, ")\n");
    store_through(st, ty, known, value, reg, p);
    return p;
}

// `box_slice(heap, count, fill)`: the run, filled. The pointer.
pub fn heap_run[&s](st: &!s [int], element: int, ck: bool, cv: int, cr: int, fk: bool, fv: int, fr: int) -> [] int {
    let bytes = slice_bytes(st, element, ck, cv, cr);
    let p = start(st);
    str(st, "call ptr @malloc(i64 ");
    temp(st, bytes);
    str(st, ")\n");
    let none = start(st);
    str(st, "icmp eq ptr ");
    temp(st, p);
    str(st, ", null\n");
    trap_if(st, none);
    fill_run(st, p, element, ck, cv, cr, fk, fv, fr);
    return p;
}

// The box value of the run at `p` of `count` elements.
pub fn make_box[&s](st: &!s [int], boxed: int, p: int, ck: bool, cv: int, cr: int) -> [] int {
    let first = insert_at(st, boxed, 0 - 1, 0, 7, false, 0, p);
    return insert_at(st, boxed, first, 1, 1, ck, cv, cr);
}

// `unbox_slice(heap, b)`: free the run of the box in register `b`; the number of elements.
pub fn heap_free[&s](st: &!s [int], boxed: int, b: int) -> [] int {
    let p = extract_field(st, boxed, b, 0);
    let n = extract_field(st, boxed, b, 1);
    str(st, "  call void @free(ptr ");
    temp(st, p);
    str(st, ")\n");
    return n;
}

// `contents(b)` of a reference in register `r` to a box: the pointer (a temporary), and the length
// left in `st[59]`.
pub fn heap_view[&s](st: &!s [int], boxed: int, r: int) -> [] int {
    let at = field_address(st, boxed, r, 0);
    let p = load_through(st, 7, at);
    let at_len = field_address(st, boxed, r, 1);
    let n = load_through(st, 1, at_len);
    st[59] = n;
    return p;
}

// ---------------------------------------------------------------------------- match ---
//
// A `match` is a chain of tests of the tag, flat: arm `n` is `ma<n>` when the tag is its variant and
// `mb<n>` (the next test) when it is not; the last arm has no test, since the arms cover everything;
// every arm ends in a branch to `mend<end>`.

// Test the tag in register `tag` against variant position `position`, and open the arm.
pub fn match_test[&s](st: &!s [int], n: int, tag: int, position: int) -> [] int {
    let c = start(st);
    str(st, "icmp eq i64 ");
    temp(st, tag);
    str(st, ", ");
    nat(st, position);
    str(st, "\n  br i1 ");
    temp(st, c);
    str(st, ", label %ma");
    nat(st, n);
    str(st, ", label %mb");
    nat(st, n);
    str(st, "\nma");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// The end of an arm that had a test: on to the next one.
pub fn match_next[&s](st: &!s [int], n: int, end: int) -> [] int {
    str(st, "  br label %mend");
    nat(st, end);
    str(st, "\nmb");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// The end of the last arm, and of the match.
pub fn match_end[&s](st: &!s [int], end: int) -> [] int {
    str(st, "  br label %mend");
    nat(st, end);
    str(st, "\nmend");
    nat(st, end);
    str(st, ":\n");
    return 0;
}

// The tag of the enum the register holds, or the one a reference in the register points at.
pub fn tag_of[&s](st: &!s [int], ty: int, by_ref: bool, reg: int) -> [] int {
    if by_ref {
        let address = field_address(st, ty, reg, 0);
        return load_through(st, 1, address);
    }
    return extract_field(st, ty, reg, 0);
}

// ---------------------------------------------------------------------------- slices ---
//
// A reference to a slice is two values in the code, a pointer and a length: a binding of one has two
// stack slots, `%s<n>_0` and `%s<n>_1`, a parameter two arguments, and an argument two operands. The
// pointer part is a temporary or the global of a string literal (`reg` of `-2 - n`), the length a
// temporary, or the constant `value` when there is no register (`reg2` of -1).

// A binding of a reference to a slice: its two stack slots.
pub fn alloca_slice[&s](st: &!s [int], slot: int) -> [] int {
    let keep = st[49];
    st[49] = 2;
    str(st, "  %s");
    nat(st, slot);
    str(st, "_0 = alloca ptr\n  %s");
    nat(st, slot);
    str(st, "_1 = alloca i64\n");
    st[49] = keep;
    return 0;
}

// Load both parts; answers the temporary of the pointer, and the length's is left in `st[59]`.
pub fn load_slice[&s](st: &!s [int], slot: int) -> [] int {
    let p = start(st);
    str(st, "load ptr, ptr %s");
    nat(st, slot);
    str(st, "_0\n");
    let n = start(st);
    str(st, "load i64, ptr %s");
    nat(st, slot);
    str(st, "_1\n");
    st[59] = n;
    return p;
}

// Store a pointer (a temporary or a global) and a length into the slots of a binding.
pub fn store_slice[&s](st: &!s [int], slot: int, ptr_reg: int, len_known: bool, len_value: int, len_reg: int) -> [] int {
    str(st, "  store ptr ");
    operand(st, 7, false, 0, ptr_reg);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "_0\n  store i64 ");
    operand(st, 1, len_known, len_value, len_reg);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "_1\n");
    return 0;
}

// A parameter that is a reference to a slice: both arguments into the slots.
pub fn store_slice_param[&s](st: &!s [int], index: int, slot: int) -> [] int {
    str(st, "  store ptr %arg");
    nat(st, index);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "_0\n  store i64 %arg");
    nat(st, index + 1);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "_1\n");
    return 0;
}

// The two operands of a slice, pushed as the arguments of a call.
pub fn push_slice[&s](st: &!s [int], ptr_reg: int, len_known: bool, len_value: int, len_reg: int) -> [] int {
    push_arg(st, 7, false, 0, ptr_reg);
    return push_arg(st, 1, len_known, len_value, len_reg);
}

// The text of a string literal as a global of its own, `@str.<n>`: the number answered, the length
// left in `st[59]`. The token includes its quotes; the six escapes are what the lexer allows.
pub fn string_constant[&s, &x](st: &!s [int], text: &x [byte], tok: int) -> [] int {
    let n = st[58];
    st[58] = n + 1;
    // Its length first, so the array can be sized.
    var length = 0;
    var i = ast.tstart(st, tok) + 1;
    let end = ast.tend(st, tok) - 1;
    while i < end {
        if int_of(text[i]) == 92 {
            i = i + 1;
        }
        length = length + 1;
        i = i + 1;
    }
    let keep = st[49];
    st[49] = 3;
    str(st, "@str.");
    nat(st, n);
    str(st, " = private unnamed_addr constant [");
    nat(st, length);
    str(st, " x i8] [");
    var k = 0;
    i = ast.tstart(st, tok) + 1;
    while i < end {
        var c = int_of(text[i]);
        if c == 92 {
            i = i + 1;
            let e = int_of(text[i]);
            if e == 'n' {
                c = 10;
            } else if e == 'r' {
                c = 13;
            } else if e == 't' {
                c = 9;
            } else if e == '0' {
                c = 0;
            } else {
                c = e;
            }
        }
        if k > 0 {
            str(st, ", ");
        }
        str(st, "i8 ");
        nat(st, c);
        k = k + 1;
        i = i + 1;
    }
    str(st, "]\n");
    st[49] = keep;
    st[59] = length;
    return n;
}

// What multiplies an index to give an offset in bytes, as text: the number for a scalar, the size of the type
// otherwise.
fn stride_text[&s](st: &!s [int], ty: int) -> [] int {
    if types.is_plain(ty) {
        return nat(st, stride(st, ty));
    }
    return size_of(st, ty);
}

// Bytes of a slice are one each and whole numbers eight; the other element types are not written yet.
fn stride[&s](st: &!s [int], ty: int) -> [] int {
    if ty == 2 {
        return 1;
    }
    return 8;
}

// The address of element `index` of the slice `(base, length)`, after a bounds check: the temporary
// of the pointer. A negative index is a large one to the unsigned comparison, as in Rust.
pub fn element_address[&s](st: &!s [int], element: int, base_reg: int, len_known: bool, len_value: int, len_reg: int, ik: bool, iv: int, ir: int) -> [] int {
    let outside = start(st);
    str(st, "icmp uge i64 ");
    operand(st, 1, ik, iv, ir);
    str(st, ", ");
    operand(st, 1, len_known, len_value, len_reg);
    str(st, "\n");
    trap_if(st, outside);
    let at = start(st);
    str(st, "mul i64 ");
    operand(st, 1, ik, iv, ir);
    str(st, ", ");
    stride_text(st, element);
    str(st, "\n");
    let p = start(st);
    str(st, "getelementptr i8, ptr ");
    operand(st, 7, false, 0, base_reg);
    str(st, ", i64 ");
    temp(st, at);
    str(st, "\n");
    return p;
}

// A load from an address: of a byte, a whole number or a boolean.
pub fn load_through[&s](st: &!s [int], ty: int, address: int) -> [] int {
    let n = start(st);
    str(st, "load ");
    llvm_type(st, ty);
    str(st, ", ptr ");
    temp(st, address);
    str(st, "\n");
    return n;
}

pub fn store_through[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int, address: int) -> [] int {
    str(st, "  store ");
    llvm_type(st, ty);
    str(st, " ");
    operand(st, ty, known, value, reg);
    str(st, ", ptr ");
    temp(st, address);
    str(st, "\n");
    return 0;
}

// `int_of(byte)` and `byte_of(int)`: a widening and a truncation.
pub fn widen[&s](st: &!s [int], known: bool, value: int, reg: int) -> [] int {
    let n = start(st);
    str(st, "zext i8 ");
    operand(st, 2, known, value, reg);
    str(st, " to i64\n");
    return n;
}

pub fn truncate_to_byte[&s](st: &!s [int], known: bool, value: int, reg: int) -> [] int {
    // `byte_of` traps on a number outside 0 to 255, as the Rust build does; unsigned, one test.
    let outside = start(st);
    str(st, "icmp ugt i64 ");
    operand(st, 1, known, value, reg);
    str(st, ", 255\n");
    trap_if(st, outside);
    let n = start(st);
    str(st, "trunc i64 ");
    operand(st, 1, known, value, reg);
    str(st, " to i8\n");
    return n;
}

// `write_bytes(io, s)`: the slice written to the standard output, a byte at a time through the C
// library's buffer (`putchar` writes to it as well, so the two stay in order); the answer is the
// number of bytes. The function is `@cancho_write_bytes`, written once by the driver.
pub fn write_slice[&s](st: &!s [int]) -> [] int {
    let len_at = st[51] + 4 * (st[52] - 1);
    let ptr_at = st[51] + 4 * (st[52] - 2);
    let n = start(st);
    str(st, "call i64 @cancho_write_bytes(ptr ");
    operand(st, 7, false, 0, st[ptr_at + 3]);
    str(st, ", i64 ");
    operand(st, 1, st[len_at + 1] != 0, st[len_at + 2], st[len_at + 3]);
    str(st, ")\n");
    st[52] = st[52] - 3;
    return n;
}

// The builtins that work on the arguments pushed: `wrapping_add` (0), `wrapping_sub` (1),
// `wrapping_mul` (2) of the last two, with no overflow check.
pub fn plain_arith[&s](st: &!s [int], kind: int) -> [] int {
    let b_at = st[51] + 4 * (st[52] - 1);
    let a_at = st[51] + 4 * (st[52] - 2);
    let n = start(st);
    if kind == 0 {
        str(st, "add");
    } else if kind == 1 {
        str(st, "sub");
    } else {
        str(st, "mul");
    }
    str(st, " i64 ");
    operand(st, 1, st[a_at + 1] != 0, st[a_at + 2], st[a_at + 3]);
    str(st, ", ");
    operand(st, 1, st[b_at + 1] != 0, st[b_at + 2], st[b_at + 3]);
    str(st, "\n");
    st[52] = st[52] - 2;
    return n;
}

// `copy_into(dst, src)`: all of `src` to the front of `dst`, as one `memmove`; a source longer than the room
// traps. The pointer and length of each are the four arguments pushed; answers the length of `src`.
pub fn bulk_copy[&s](st: &!s [int]) -> [] int {
    let to = st[51] + 4 * (st[52] - 4);
    let room = st[51] + 4 * (st[52] - 3);
    let from = st[51] + 4 * (st[52] - 2);
    let count = st[51] + 4 * (st[52] - 1);
    let past = start(st);
    str(st, "icmp sgt i64 ");
    operand(st, 1, st[count + 1] != 0, st[count + 2], st[count + 3]);
    str(st, ", ");
    operand(st, 1, st[room + 1] != 0, st[room + 2], st[room + 3]);
    str(st, "\n");
    trap_if(st, past);
    str(st, "  call ptr @memmove(ptr ");
    operand(st, 7, false, 0, st[to + 3]);
    str(st, ", ptr ");
    operand(st, 7, false, 0, st[from + 3]);
    str(st, ", i64 ");
    operand(st, 1, st[count + 1] != 0, st[count + 2], st[count + 3]);
    str(st, ")\n");
    let answer = start(st);
    str(st, "add i64 0, ");
    operand(st, 1, st[count + 1] != 0, st[count + 2], st[count + 3]);
    str(st, "\n");
    st[52] = st[52] - 4;
    return answer;
}

// `index_of_byte(text, b)`: one `memchr`; the offset of the first match, or -1.
pub fn find_byte[&s](st: &!s [int]) -> [] int {
    let base = st[51] + 4 * (st[52] - 3);
    let length = st[51] + 4 * (st[52] - 2);
    let wanted = st[51] + 4 * (st[52] - 1);
    let widened = start(st);
    str(st, "zext i8 ");
    operand(st, 2, st[wanted + 1] != 0, st[wanted + 2], st[wanted + 3]);
    str(st, " to i32\n");
    let found = start(st);
    str(st, "call ptr @memchr(ptr ");
    operand(st, 7, false, 0, st[base + 3]);
    str(st, ", i32 ");
    temp(st, widened);
    str(st, ", i64 ");
    operand(st, 1, st[length + 1] != 0, st[length + 2], st[length + 3]);
    str(st, ")\n");
    let missing = start(st);
    str(st, "icmp eq ptr ");
    temp(st, found);
    str(st, ", null\n");
    let at = start(st);
    str(st, "ptrtoint ptr ");
    temp(st, found);
    str(st, " to i64\n");
    let origin = start(st);
    str(st, "ptrtoint ptr ");
    operand(st, 7, false, 0, st[base + 3]);
    str(st, " to i64\n");
    let offset = start(st);
    str(st, "sub i64 ");
    temp(st, at);
    str(st, ", ");
    temp(st, origin);
    str(st, "\n");
    let answer = start(st);
    str(st, "select i1 ");
    temp(st, missing);
    str(st, ", i64 -1, i64 ");
    temp(st, offset);
    str(st, "\n");
    st[52] = st[52] - 3;
    return answer;
}

// `getchar(io)`: the next byte of the standard input, or -1 at its end (sign-extended).
pub fn stdin_char[&s](st: &!s [int]) -> [] int {
    let got = start(st);
    str(st, "call i32 @getchar()\n");
    let wide = start(st);
    str(st, "sext i32 ");
    temp(st, got);
    str(st, " to i64\n");
    st[52] = st[52] - 1;
    return wide;
}

// `write_err(io, s)`: the bytes of `s` to the standard error; how many.
pub fn stderr_write[&s](st: &!s [int]) -> [] int {
    let ptr_at = st[51] + 4 * (st[52] - 2);
    let len_at = st[51] + 4 * (st[52] - 1);
    let n = start(st);
    str(st, "call i64 @write(i32 2, ptr ");
    operand(st, 7, false, 0, st[ptr_at + 3]);
    str(st, ", i64 ");
    operand(st, 1, st[len_at + 1] != 0, st[len_at + 2], st[len_at + 3]);
    str(st, ")\n");
    st[52] = st[52] - 3;
    return n;
}

// ----------------------------------------------------------------------- functions ---

// The head of a function goes to the output at once: `define <ret> @lexs_<n>(`, `n` the function's node, which no other function shares, then one
// `header_param` for each parameter and a `header_end`. Its body and `alloca`s wait in their buffers
// until `finish`.
// `i<n>` after a function's name, for the instance `n - 1` of a generic one (`inst` is 0 for the others).
pub fn instance_suffix[&s](st: &!s [int], inst: int) -> [] int {
    if inst > 0 {
        str(st, "i");
        nat(st, inst - 1);
    }
    return 0;
}

pub fn header_start[&s](st: &!s [int], item: int, inst: int, ret_ty: int) -> [] int {
    aim(st, 0);
    str(st, "define ");
    ret_type(st, ret_ty);
    str(st, " @lexs_");
    nat(st, item);
    instance_suffix(st, inst);
    str(st, "(");
    return 0;
}

pub fn header_param[&s](st: &!s [int], ty: int, index: int) -> [] int {
    if index > 0 {
        str(st, ", ");
    }
    llvm_type(st, ty);
    str(st, " %arg");
    nat(st, index);
    return 0;
}

pub fn header_end[&s](st: &!s [int]) -> [] int {
    str(st, ") {\nentry:\n");
    clear(st, 1);
    clear(st, 2);
    st[41] = 0;
    st[42] = 0;
    st[52] = 0;
    aim(st, 1);
    return 0;
}

// The `alloca`s, the body, and an `unreachable` for the end that the checker has shown no path reaches.
pub fn finish[&s](st: &!s [int]) -> [] int {
    copy(st, 2, 0);
    copy(st, 1, 0);
    aim(st, 0);
    str(st, "  unreachable\n}\n\n");
    aim(st, 1);
    return 0;
}
