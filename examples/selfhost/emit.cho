module selfhost.emit;

// emit.cho -- the code the checker writes while it walks a function.
//
// Stage 4 of the self-hosting port (`docs/self-hosting.md` section 6): the checker already visits
// every expression in the order it runs and knows its type, so it writes LLVM IR as it goes, the
// text the Rust backend writes (`cancho-codegen-llvm`), and `clang` does the rest. The Rust
// compiler is the oracle here as everywhere, compared by what the programs do and not by the
// text: both are built from the same source, run, and must agree.
//
// The code goes to one of three buffers of the state, a byte to an int, `st[49]` saying which:
//
//     0 the output, the finished functions, kept
//     1 the body of the function being written
//     2 its `alloca`s, which belong at the top, in the entry block, however late a `let` comes
//
// An operand is a constant (`known`, `value`) or the temporary `%t<reg>`; a type is the checker's
// tag, 1 `int` as `i64` and 5 `bool` as `i1`, which are the only two written so far.

import selfhost.ast;
import selfhost.types;

pub fn on[&s](st: &!s [int]) -> [] bool {
    return st[40] != 0;
}

// Write to buffer `target`.
pub fn aim[&s](st: &!s [int], target: int) -> [] int {
    st[49] = target;
    return 0;
}

// Buffer 3, the constants (string literals), keeps its base and length in slots 56 and 57; the
// others in 43 and 44, 45 and 46, 47 and 48.
fn base_slot(t: int) -> [] int {
    if t == 3 {
        return 56;
    }
    return 43 + 2 * t;
}

pub fn put[&s](st: &!s [int], b: int) -> [] int {
    let t = st[49];
    let base = base_slot(t);
    st[st[base] + st[base + 1]] = b;
    st[base + 1] = st[base + 1] + 1;
    return 0;
}

pub fn str[&s](st: &!s [int], s: &static [byte]) -> [] int {
    var i = 0;
    while i < len(s) {
        put(st, int_of(s[i]));
        i = i + 1;
    }
    return 0;
}

// A natural number in decimal.
pub fn nat[&s](st: &!s [int], n: int) -> [] int {
    var scale = 1;
    while n / scale >= 10 {
        scale = scale * 10;
    }
    var rest = n;
    while scale > 0 {
        let digit = rest / scale;
        put(st, '0' + digit);
        rest = rest - digit * scale;
        scale = scale / 10;
    }
    return 0;
}

// An `int` in decimal.
pub fn int[&s](st: &!s [int], n: int) -> [] int {
    if n >= 0 {
        return nat(st, n);
    }
    if n == 0 - 9223372036854775807 - 1 {
        return str(st, "-9223372036854775808");
    }
    put(st, '-');
    return nat(st, 0 - n);
}

// The bytes of `text` from `from` to `to`.
pub fn slice[&s, &x](st: &!s [int], text: &x [byte], from: int, to: int) -> [] int {
    var i = from;
    while i < to {
        put(st, int_of(text[i]));
        i = i + 1;
    }
    return 0;
}

// Append buffer `from` to buffer `to`.
pub fn copy[&s](st: &!s [int], from: int, to: int) -> [] int {
    let keep = st[49];
    st[49] = to;
    var i = 0;
    while i < st[base_slot(from) + 1] {
        put(st, st[st[base_slot(from)] + i]);
        i = i + 1;
    }
    st[49] = keep;
    return 0;
}

pub fn clear[&s](st: &!s [int], target: int) -> [] int {
    st[base_slot(target) + 1] = 0;
    return 0;
}

// A fresh temporary number and a fresh label number, for the function being written.
pub fn fresh[&s](st: &!s [int]) -> [] int {
    let n = st[41];
    st[41] = n + 1;
    return n;
}

pub fn label[&s](st: &!s [int]) -> [] int {
    let n = st[42];
    st[42] = n + 1;
    return n;
}

// ------------------------------------------------------------------ types, operands ---

pub fn llvm_type[&s](st: &!s [int], ty: int) -> [] int {
    if ty == 5 {
        return str(st, "i1");
    }
    if ty == 2 {
        return str(st, "i8");
    }
    if ty == 7 || types.is_ref(st, ty) {
        return str(st, "ptr");
    }
    return str(st, "i64");
}

// An operand: a constant or a temporary.
pub fn operand[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int) -> [] int {
    if reg <= 0 - 2 {
        // A string literal's global, `@str.<n>`, kept as `-2 - n`.
        str(st, "@str.");
        return nat(st, 0 - 2 - reg);
    }
    if known {
        if ty == 5 {
            if value != 0 {
                return str(st, "true");
            }
            return str(st, "false");
        }
        return int(st, value);
    }
    str(st, "%t");
    return nat(st, reg);
}

fn temp[&s](st: &!s [int], n: int) -> [] int {
    str(st, "%t");
    return nat(st, n);
}

// `  %t<n> = ` for a new temporary, which is answered.
fn start[&s](st: &!s [int]) -> [] int {
    let n = fresh(st);
    str(st, "  ");
    temp(st, n);
    str(st, " = ");
    return n;
}

// ---------------------------------------------------------------------- stack slots ---

// A stack slot for the binding declared as number `slot`, in the entry block.
pub fn alloca[&s](st: &!s [int], ty: int, slot: int) -> [] int {
    let keep = st[49];
    st[49] = 2;
    str(st, "  %s");
    nat(st, slot);
    str(st, " = alloca ");
    llvm_type(st, ty);
    str(st, "\n");
    st[49] = keep;
    return 0;
}

// `%t<n> = load` from a slot; answers n.
pub fn load[&s](st: &!s [int], ty: int, slot: int) -> [] int {
    let n = start(st);
    str(st, "load ");
    llvm_type(st, ty);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "\n");
    return n;
}

pub fn store[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int, slot: int) -> [] int {
    str(st, "  store ");
    llvm_type(st, ty);
    str(st, " ");
    operand(st, ty, known, value, reg);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "\n");
    return 0;
}

// A parameter's value into its slot at entry.
pub fn store_param[&s](st: &!s [int], ty: int, index: int, slot: int) -> [] int {
    str(st, "  store ");
    llvm_type(st, ty);
    str(st, " %arg");
    nat(st, index);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "\n");
    return 0;
}

// A pointer to the stack slot of the binding declared as number `slot`, stored in the slot of the
// reference declared as `into`: a reference to a whole number or a boolean.
pub fn store_slot_address[&s](st: &!s [int], into: int, slot: int) -> [] int {
    str(st, "  store ptr %s");
    nat(st, slot);
    str(st, ", ptr %s");
    nat(st, into);
    str(st, "\n");
    return 0;
}

// A reference to a value that has no representation (`Io`, which is nothing in the code) is a
// pointer to a byte of its own; the byte is in the entry block, and the pointer is stored in the
// slot of the reference declared as `into`.
pub fn store_dummy_pointer[&s](st: &!s [int], into: int) -> [] int {
    let n = fresh(st);
    let keep = st[49];
    st[49] = 2;
    str(st, "  %t");
    nat(st, n);
    str(st, " = alloca i8, i64 1\n");
    st[49] = keep;
    str(st, "  store ptr %t");
    nat(st, n);
    str(st, ", ptr %s");
    nat(st, into);
    str(st, "\n");
    return 0;
}

// -------------------------------------------------------------------------- traps ---

// Trap if the `i1` temporary `flag` is set, and go on in a new block otherwise.
fn trap_if[&s](st: &!s [int], flag: int) -> [] int {
    let n = label(st);
    str(st, "  br i1 ");
    temp(st, flag);
    str(st, ", label %trap");
    nat(st, n);
    str(st, ", label %ok");
    nat(st, n);
    str(st, "\ntrap");
    nat(st, n);
    str(st, ":\n  call void @llvm.trap()\n  unreachable\nok");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// -------------------------------------------------------------------- arithmetic ---

// `+` (0), `-` (1) or `*` (2) on `int`, trapping on overflow: the intrinsic's pair, its value,
// its flag.
pub fn checked[&s](st: &!s [int], kind: int, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let pair = start(st);
    str(st, "call {i64, i1} @llvm.");
    if kind == 0 {
        str(st, "sadd");
    } else if kind == 1 {
        str(st, "ssub");
    } else {
        str(st, "smul");
    }
    str(st, ".with.overflow.i64(i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", i64 ");
    operand(st, 1, bk, bv, br);
    str(st, ")\n");
    let value = start(st);
    str(st, "extractvalue {i64, i1} ");
    temp(st, pair);
    str(st, ", 0\n");
    let flag = start(st);
    str(st, "extractvalue {i64, i1} ");
    temp(st, pair);
    str(st, ", 1\n");
    trap_if(st, flag);
    return value;
}

// `&` (0), `|` (1), `^` (2): nothing to check.
pub fn bitwise[&s](st: &!s [int], kind: int, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let n = start(st);
    if kind == 0 {
        str(st, "and");
    } else if kind == 1 {
        str(st, "or");
    } else {
        str(st, "xor");
    }
    str(st, " i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", ");
    operand(st, 1, bk, bv, br);
    str(st, "\n");
    return n;
}

// `<<` and `>>`: an amount outside 0..64 traps, and `>>` is arithmetic.
pub fn shift[&s](st: &!s [int], left: bool, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let range = start(st);
    str(st, "icmp uge i64 ");
    operand(st, 1, bk, bv, br);
    str(st, ", 64\n");
    trap_if(st, range);
    let n = start(st);
    if left {
        str(st, "shl");
    } else {
        str(st, "ashr");
    }
    str(st, " i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", ");
    operand(st, 1, bk, bv, br);
    str(st, "\n");
    return n;
}

// `/` and `%`: LLVM's `sdiv` and `srem` are undefined on a zero divisor and on `int::MIN` by -1, so
// both are checked first. `int::MIN / -1` traps; `int::MIN % -1` is 0, reached by a branch because
// a `select` would still evaluate the undefined pair.
pub fn divide[&s](st: &!s [int], remainder: bool, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let zero = start(st);
    str(st, "icmp eq i64 ");
    operand(st, 1, bk, bv, br);
    str(st, ", 0\n");
    trap_if(st, zero);
    let is_min = start(st);
    str(st, "icmp eq i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", -9223372036854775808\n");
    let is_neg1 = start(st);
    str(st, "icmp eq i64 ");
    operand(st, 1, bk, bv, br);
    str(st, ", -1\n");
    let both = start(st);
    str(st, "and i1 ");
    temp(st, is_min);
    str(st, ", ");
    temp(st, is_neg1);
    str(st, "\n");
    if !remainder {
        trap_if(st, both);
        let q = start(st);
        str(st, "sdiv i64 ");
        operand(st, 1, ak, av, ar);
        str(st, ", ");
        operand(st, 1, bk, bv, br);
        str(st, "\n");
        return q;
    }
    let n = label(st);
    str(st, "  br i1 ");
    temp(st, both);
    str(st, ", label %remspecial");
    nat(st, n);
    str(st, ", label %remcompute");
    nat(st, n);
    str(st, "\nremcompute");
    nat(st, n);
    str(st, ":\n");
    let computed = start(st);
    str(st, "srem i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", ");
    operand(st, 1, bk, bv, br);
    str(st, "\n  br label %remend");
    nat(st, n);
    str(st, "\nremspecial");
    nat(st, n);
    str(st, ":\n  br label %remend");
    nat(st, n);
    str(st, "\nremend");
    nat(st, n);
    str(st, ":\n");
    let result = start(st);
    str(st, "phi i64 [ 0, %remspecial");
    nat(st, n);
    str(st, " ], [ ");
    temp(st, computed);
    str(st, ", %remcompute");
    nat(st, n);
    str(st, " ]\n");
    return result;
}

// A comparison, `==` (2) through `>=` (7) by the operator number, on two values of type `ty`: an
// `i1`.
pub fn compare[&s](st: &!s [int], op: int, ty: int, ak: bool, av: int, ar: int, bk: bool, bv: int, br: int) -> [] int {
    let n = start(st);
    str(st, "icmp ");
    if op == 2 {
        str(st, "eq");
    } else if op == 3 {
        str(st, "ne");
    } else if op == 4 {
        str(st, "slt");
    } else if op == 5 {
        str(st, "sle");
    } else if op == 6 {
        str(st, "sgt");
    } else {
        str(st, "sge");
    }
    str(st, " ");
    llvm_type(st, ty);
    str(st, " ");
    operand(st, ty, ak, av, ar);
    str(st, ", ");
    operand(st, ty, bk, bv, br);
    str(st, "\n");
    return n;
}

// `!b`.
pub fn not[&s](st: &!s [int], ak: bool, av: int, ar: int) -> [] int {
    let n = start(st);
    str(st, "xor i1 ");
    operand(st, 5, ak, av, ar);
    str(st, ", true\n");
    return n;
}

// `~x`.
pub fn bit_not[&s](st: &!s [int], ak: bool, av: int, ar: int) -> [] int {
    let n = start(st);
    str(st, "xor i64 ");
    operand(st, 1, ak, av, ar);
    str(st, ", -1\n");
    return n;
}

// ------------------------------------------------------------------------ control flow ---
//
// Each construct takes one number `n` from `label`, and its blocks are named by it: `then`, `else`,
// `end` for an `if`; `head`, `body`, `end` for a `while`; `scrhs` and `scend` for `&&` and `||`.
// Whatever follows a `ret` is in a block of its own, so the `br` that ends an arm is always in a
// block, and the checker has refused the code that would make it matter.

// The `if` whose condition is the `i1` operand: the branch, and the block of the `then` arm.
pub fn if_begin[&s](st: &!s [int], n: int, known: bool, value: int, reg: int) -> [] int {
    str(st, "  br i1 ");
    operand(st, 5, known, value, reg);
    str(st, ", label %then");
    nat(st, n);
    str(st, ", label %else");
    nat(st, n);
    str(st, "\nthen");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// The end of the `then` arm and the start of the `else` one, which is empty if there is none.
pub fn if_else[&s](st: &!s [int], n: int) -> [] int {
    str(st, "  br label %end");
    nat(st, n);
    str(st, "\nelse");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

pub fn if_end[&s](st: &!s [int], n: int) -> [] int {
    str(st, "  br label %end");
    nat(st, n);
    str(st, "\nend");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// The head of a `while`, where its condition is computed.
pub fn while_head[&s](st: &!s [int], n: int) -> [] int {
    str(st, "  br label %head");
    nat(st, n);
    str(st, "\nhead");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// The branch on the condition, and the block of the body.
pub fn while_cond[&s](st: &!s [int], n: int, known: bool, value: int, reg: int) -> [] int {
    str(st, "  br i1 ");
    operand(st, 5, known, value, reg);
    str(st, ", label %body");
    nat(st, n);
    str(st, ", label %end");
    nat(st, n);
    str(st, "\nbody");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

pub fn while_end[&s](st: &!s [int], n: int) -> [] int {
    str(st, "  br label %head");
    nat(st, n);
    str(st, "\nend");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// `a && b` and `a || b`: the result lives in a stack slot of its own, `%sc<n>`. After `a`, the slot
// holds `a` and `b` is computed only if `a` did not already decide it.
pub fn short_begin[&s](st: &!s [int], n: int, either: bool, known: bool, value: int, reg: int) -> [] int {
    let keep = st[49];
    st[49] = 2;
    str(st, "  %sc");
    nat(st, n);
    str(st, " = alloca i1\n");
    st[49] = keep;
    str(st, "  store i1 ");
    operand(st, 5, known, value, reg);
    str(st, ", ptr %sc");
    nat(st, n);
    str(st, "\n  br i1 ");
    operand(st, 5, known, value, reg);
    if either {
        str(st, ", label %scend");
        nat(st, n);
        str(st, ", label %scrhs");
        nat(st, n);
    } else {
        str(st, ", label %scrhs");
        nat(st, n);
        str(st, ", label %scend");
        nat(st, n);
    }
    str(st, "\nscrhs");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// After `b`: the slot takes it, and the result is the slot, in a temporary.
pub fn short_end[&s](st: &!s [int], n: int, known: bool, value: int, reg: int) -> [] int {
    str(st, "  store i1 ");
    operand(st, 5, known, value, reg);
    str(st, ", ptr %sc");
    nat(st, n);
    str(st, "\n  br label %scend");
    nat(st, n);
    str(st, "\nscend");
    nat(st, n);
    str(st, ":\n");
    let r = start(st);
    str(st, "load i1, ptr %sc");
    nat(st, n);
    str(st, "\n");
    return r;
}

// ------------------------------------------------------------------------- calls ---

// The arguments of the calls being written wait on a stack of four ints each, at `st[52 + ...]`'s
// base `st[51]`, with `st[52]` how many: a call's arguments are known one at a time, and the
// call written once the last is.
pub fn push_arg[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int) -> [] int {
    let at = st[51] + 4 * st[52];
    st[at] = ty;
    st[at + 1] = ast.flag(known);
    st[at + 2] = value;
    st[at + 3] = reg;
    st[52] = st[52] + 1;
    return 0;
}

// The call of `name`, the identifier at token `name` of `text`, to the last `n` arguments pushed,
// returning `ret`; answers the temporary of the result.
pub fn call[&s, &x](st: &!s [int], text: &x [byte], name: int, ret: int, n: int) -> [] int {
    let first = st[52] - n;
    let result = start(st);
    str(st, "call ");
    llvm_type(st, ret);
    str(st, " @lexs_");
    slice(st, text, ast.tstart(st, name), ast.tend(st, name));
    str(st, "(");
    var i = 0;
    while i < n {
        let at = st[51] + 4 * (first + i);
        if i > 0 {
            str(st, ", ");
        }
        llvm_type(st, st[at]);
        str(st, " ");
        operand(st, st[at], st[at + 1] != 0, st[at + 2], st[at + 3]);
        i = i + 1;
    }
    str(st, ")\n");
    st[52] = first;
    return result;
}

// `putchar` of the last two arguments pushed, the second a whole number: the character to the
// standard output, answering the temporary of the C function's result as a whole number.
pub fn put_char[&s](st: &!s [int]) -> [] int {
    let at = st[51] + 4 * (st[52] - 1);
    let narrow = start(st);
    str(st, "trunc i64 ");
    operand(st, st[at], st[at + 1] != 0, st[at + 2], st[at + 3]);
    str(st, " to i32\n");
    let done = start(st);
    str(st, "call i32 @putchar(i32 ");
    temp(st, narrow);
    str(st, ")\n");
    let wide = start(st);
    str(st, "sext i32 ");
    temp(st, done);
    str(st, " to i64\n");
    st[52] = st[52] - 2;
    return wide;
}

// ---------------------------------------------------------------------- statements ---

// `ret` of an operand, then a block of its own for whatever follows, so that every block ends in
// one terminator even when the checker has refused nothing after a `return`.
pub fn ret[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int) -> [] int {
    str(st, "  ret ");
    llvm_type(st, ty);
    str(st, " ");
    operand(st, ty, known, value, reg);
    str(st, "\n");
    let n = label(st);
    str(st, "dead");
    nat(st, n);
    str(st, ":\n");
    return 0;
}

// ---------------------------------------------------------------------------- slices ---
//
// A reference to a slice is two values in the code, a pointer and a length: a binding of one has two
// stack slots, `%s<n>_0` and `%s<n>_1`, a parameter two arguments, and an argument two operands. The
// pointer part is a temporary or the global of a string literal (`reg` of `-2 - n`), the length a
// temporary, or the constant `value` when there is no register (`reg2` of -1).

// A binding of a reference to a slice: its two stack slots.
pub fn alloca_slice[&s](st: &!s [int], slot: int) -> [] int {
    let keep = st[49];
    st[49] = 2;
    str(st, "  %s");
    nat(st, slot);
    str(st, "_0 = alloca ptr\n  %s");
    nat(st, slot);
    str(st, "_1 = alloca i64\n");
    st[49] = keep;
    return 0;
}

// Load both parts; answers the temporary of the pointer, and the length's is left in `st[59]`.
pub fn load_slice[&s](st: &!s [int], slot: int) -> [] int {
    let p = start(st);
    str(st, "load ptr, ptr %s");
    nat(st, slot);
    str(st, "_0\n");
    let n = start(st);
    str(st, "load i64, ptr %s");
    nat(st, slot);
    str(st, "_1\n");
    st[59] = n;
    return p;
}

// Store a pointer (a temporary or a global) and a length into the slots of a binding.
pub fn store_slice[&s](st: &!s [int], slot: int, ptr_reg: int, len_known: bool, len_value: int, len_reg: int) -> [] int {
    str(st, "  store ptr ");
    operand(st, 7, false, 0, ptr_reg);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "_0\n  store i64 ");
    operand(st, 1, len_known, len_value, len_reg);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "_1\n");
    return 0;
}

// A parameter that is a reference to a slice: both arguments into the slots.
pub fn store_slice_param[&s](st: &!s [int], index: int, slot: int) -> [] int {
    str(st, "  store ptr %arg");
    nat(st, index);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "_0\n  store i64 %arg");
    nat(st, index + 1);
    str(st, ", ptr %s");
    nat(st, slot);
    str(st, "_1\n");
    return 0;
}

// The two operands of a slice, pushed as the arguments of a call.
pub fn push_slice[&s](st: &!s [int], ptr_reg: int, len_known: bool, len_value: int, len_reg: int) -> [] int {
    push_arg(st, 7, false, 0, ptr_reg);
    return push_arg(st, 1, len_known, len_value, len_reg);
}

// The text of a string literal as a global of its own, `@str.<n>`: the number answered, the length
// left in `st[59]`. The token includes its quotes; the six escapes are what the lexer allows.
pub fn string_constant[&s, &x](st: &!s [int], text: &x [byte], tok: int) -> [] int {
    let n = st[58];
    st[58] = n + 1;
    // Its length first, so the array can be sized.
    var length = 0;
    var i = ast.tstart(st, tok) + 1;
    let end = ast.tend(st, tok) - 1;
    while i < end {
        if int_of(text[i]) == 92 {
            i = i + 1;
        }
        length = length + 1;
        i = i + 1;
    }
    let keep = st[49];
    st[49] = 3;
    str(st, "@str.");
    nat(st, n);
    str(st, " = private unnamed_addr constant [");
    nat(st, length);
    str(st, " x i8] [");
    var k = 0;
    i = ast.tstart(st, tok) + 1;
    while i < end {
        var c = int_of(text[i]);
        if c == 92 {
            i = i + 1;
            let e = int_of(text[i]);
            if e == 'n' {
                c = 10;
            } else if e == 'r' {
                c = 13;
            } else if e == 't' {
                c = 9;
            } else if e == '0' {
                c = 0;
            } else {
                c = e;
            }
        }
        if k > 0 {
            str(st, ", ");
        }
        str(st, "i8 ");
        nat(st, c);
        k = k + 1;
        i = i + 1;
    }
    str(st, "]\n");
    st[49] = keep;
    st[59] = length;
    return n;
}

// Bytes of a slice are one each and whole numbers eight; the other element types are not written yet.
fn stride[&s](st: &!s [int], ty: int) -> [] int {
    if ty == 2 {
        return 1;
    }
    return 8;
}

// The address of element `index` of the slice `(base, length)`, after a bounds check: the temporary
// of the pointer. A negative index is a large one to the unsigned comparison, as in Rust.
pub fn element_address[&s](st: &!s [int], element: int, base_reg: int, len_known: bool, len_value: int, len_reg: int, ik: bool, iv: int, ir: int) -> [] int {
    let outside = start(st);
    str(st, "icmp uge i64 ");
    operand(st, 1, ik, iv, ir);
    str(st, ", ");
    operand(st, 1, len_known, len_value, len_reg);
    str(st, "\n");
    trap_if(st, outside);
    let at = start(st);
    str(st, "mul i64 ");
    operand(st, 1, ik, iv, ir);
    str(st, ", ");
    nat(st, stride(st, element));
    str(st, "\n");
    let p = start(st);
    str(st, "getelementptr i8, ptr ");
    operand(st, 7, false, 0, base_reg);
    str(st, ", i64 ");
    temp(st, at);
    str(st, "\n");
    return p;
}

// A load from an address: of a byte, a whole number or a boolean.
pub fn load_through[&s](st: &!s [int], ty: int, address: int) -> [] int {
    let n = start(st);
    str(st, "load ");
    llvm_type(st, ty);
    str(st, ", ptr ");
    temp(st, address);
    str(st, "\n");
    return n;
}

pub fn store_through[&s](st: &!s [int], ty: int, known: bool, value: int, reg: int, address: int) -> [] int {
    str(st, "  store ");
    llvm_type(st, ty);
    str(st, " ");
    operand(st, ty, known, value, reg);
    str(st, ", ptr ");
    temp(st, address);
    str(st, "\n");
    return 0;
}

// `int_of(byte)` and `byte_of(int)`: a widening and a truncation.
pub fn widen[&s](st: &!s [int], known: bool, value: int, reg: int) -> [] int {
    let n = start(st);
    str(st, "zext i8 ");
    operand(st, 2, known, value, reg);
    str(st, " to i64\n");
    return n;
}

pub fn truncate_to_byte[&s](st: &!s [int], known: bool, value: int, reg: int) -> [] int {
    // `byte_of` traps on a number outside 0 to 255, as the Rust build does; unsigned, one test.
    let outside = start(st);
    str(st, "icmp ugt i64 ");
    operand(st, 1, known, value, reg);
    str(st, ", 255\n");
    trap_if(st, outside);
    let n = start(st);
    str(st, "trunc i64 ");
    operand(st, 1, known, value, reg);
    str(st, " to i8\n");
    return n;
}

// `write_bytes(io, s)`: the slice written to the standard output, a byte at a time through the C
// library's buffer (`putchar` writes to it as well, so the two stay in order); the answer is the
// number of bytes. The function is `@cancho_write_bytes`, written once by the driver.
pub fn write_slice[&s](st: &!s [int]) -> [] int {
    let len_at = st[51] + 4 * (st[52] - 1);
    let ptr_at = st[51] + 4 * (st[52] - 2);
    let n = start(st);
    str(st, "call i64 @cancho_write_bytes(ptr ");
    operand(st, 7, false, 0, st[ptr_at + 3]);
    str(st, ", i64 ");
    operand(st, 1, st[len_at + 1] != 0, st[len_at + 2], st[len_at + 3]);
    str(st, ")\n");
    st[52] = st[52] - 3;
    return n;
}

// ----------------------------------------------------------------------- functions ---

// The head of a function goes to the output at once: `define <ret> @lexs_<name>(`, then one
// `header_param` for each parameter and a `header_end`. Its body and `alloca`s wait in their buffers
// until `finish`.
pub fn header_start[&s, &x](st: &!s [int], text: &x [byte], name: int, ret_ty: int) -> [] int {
    aim(st, 0);
    str(st, "define ");
    llvm_type(st, ret_ty);
    str(st, " @lexs_");
    slice(st, text, ast.tstart(st, name), ast.tend(st, name));
    str(st, "(");
    return 0;
}

pub fn header_param[&s](st: &!s [int], ty: int, index: int) -> [] int {
    if index > 0 {
        str(st, ", ");
    }
    llvm_type(st, ty);
    str(st, " %arg");
    nat(st, index);
    return 0;
}

pub fn header_end[&s](st: &!s [int]) -> [] int {
    str(st, ") {\nentry:\n");
    clear(st, 1);
    clear(st, 2);
    st[41] = 0;
    st[42] = 0;
    st[52] = 0;
    aim(st, 1);
    return 0;
}

// The `alloca`s, the body, and an `unreachable` for the end that the checker has shown no path reaches.
pub fn finish[&s](st: &!s [int]) -> [] int {
    copy(st, 2, 0);
    copy(st, 1, 0);
    aim(st, 0);
    str(st, "  unreachable\n}\n\n");
    aim(st, 1);
    return 0;
}
