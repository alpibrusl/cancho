module selfhost.atoms;

// atoms.cho -- the expressions that need no recursion into others: a name, the code of an operator, the
// words of the word builtins, and what makes a function one the code is written for. Split from
// `exprs.cho` for its length.

import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.kinds;
import selfhost.rules;
import selfhost.pass1;
import selfhost.types;
import selfhost.emit;
import selfhost.fold;
import selfhost.floats;
import selfhost.floatcode;
import selfhost.codes;
import selfhost.threadcode;
import selfhost.externcode;
import selfhost.netcode;
import selfhost.lookup;
import selfhost.ex;
import selfhost.wordcode;
import selfhost.cryptocode;
import selfhost.instances;
import selfhost.scope;
import selfhost.prims;
import selfhost.builtins;
import selfhost.signatures;
import selfhost.effects;
import selfhost.tables;

// The prefix a capability was narrowed to, as the pointer and the length of its literal pushed on the stack
// of arguments; a capability that was not narrowed is a null and 0, which every path is under. Using the capability
// performs a label with an argument (the prefix).
pub fn push_prefix[&s, &x](st: &!s [int], text: &x [byte], cap: int, want: int, from: int, to: int) -> [] int {
    effects.mark_arg(st);
    return push_bound(st, text, cap, want, from, to);
}

// The bound a dial (`connect`, `tcp_connect`, `tcp_connect_start`, `udp_connect`) checks. From edition 10 its host half is
// matched exactly (`docs/net-bounds.md` 2.3), which the runtime is told by a byte 1 ahead of the literal.
pub fn push_dial_bound[&s, &x](st: &!s [int], text: &x [byte], cap: int, from: int, to: int) -> [] int {
    effects.mark_arg(st);
    var inner = cap;
    if types.is_ref(st, inner) {
        inner = types.ref_inner(st, inner);
    }
    let tok = types.prelude_lit_tok(st, inner);
    if st[23] < 10 || tok < 0 {
        return push_bound(st, text, cap, 0 - 1, from, to);
    }
    let n = emit.string_constant_lead(st, text, tok, true);
    emit.push_arg(st, 7, false, 0, 0 - 2 - n);
    emit.push_arg(st, 1, true, st[59], 0 - 1);
    return 0;
}

// The same, without performing anything: `exec_covers` and `fs_covers` only ask where the bound is
// (`docs/processes.md` 4.13), and the report of a program that asks is the report of one that does not.
pub fn push_bound[&s, &x](st: &!s [int], text: &x [byte], cap: int, want: int, from: int, to: int) -> [] int {
    if want >= 0 && !(types.is_ref(st, cap) && types.is_prelude(st, types.ref_inner(st, cap)) && types.prelude_index(st, types.ref_inner(st, cap)) == want) {
        // What is reached through a path or a program is reached through the borrowed capability that names it.
        ast.fail(st, rules.r_capability_misused(), from, to);
        return 0;
    }
    var inner = cap;
    if types.is_ref(st, inner) {
        inner = types.ref_inner(st, inner);
    }
    let tok = types.prelude_lit_tok(st, inner);
    if tok < 0 {
        emit.push_arg(st, 7, false, 0, 0 - 1);
        emit.push_arg(st, 1, true, 0, 0 - 1);
        return 0;
    }
    let n = emit.string_constant(st, text, tok);
    emit.push_arg(st, 7, false, 0, 0 - 2 - n);
    emit.push_arg(st, 1, true, st[59], 0 - 1);
    return 0;
}

// The bound `exec_spawn_under` pushes (`docs/processes.md` 4.14): only the `Exec` that bounds nothing may be asked, since
// a program found beneath a directory chosen at run time cannot be shown to lie under a literal. It performs `exec_under`,
// which names no path.
pub fn push_under[&s, &x](st: &!s [int], text: &x [byte], cap: int, from: int, to: int) -> [] int {
    effects.perform_named(st, "exec_under");
    var inner = cap;
    if types.is_ref(st, inner) {
        inner = types.ref_inner(st, inner);
    }
    let tok = types.prelude_lit_tok(st, inner);
    // A literal of two quotes is the bound that bounds nothing, as no literal at all is.
    if types.is_prelude(st, inner) && tok >= 0 && ast.tend(st, tok) - ast.tstart(st, tok) > 2 {
        ast.fail(st, rules.r_capability_misused(), from, to);
        return 0;
    }
    return push_bound(st, text, cap, netcode.prelude_named("Exec"), from, to);
}

// Is this the `&!x Heap` a heap operation is reached through?
pub fn is_heap_ref[&s](st: &!s [int], ty: int) -> [] bool {
    return types.is_ref(st, ty) && types.ref_unique(st, ty) && types.is_prelude(st, types.ref_inner(st, ty)) && types.prelude_index(st, types.ref_inner(st, ty)) == scope.heap_index();
}

pub fn name_expr[&s, &x](st: &!s [int], text: &x [byte], id: int) -> [] ex.Ex {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let name = ast.get(st, id, 4);
    let i = scope.find(st, text, name);
    if i >= 0 {
        scope.use_slot(st, i, from, to);
        if emit.on(st) {
            if types.is_erased(st, scope.binding_type(st, i)) {
                return ex.in_reg(scope.binding_type(st, i), 0 - 1);
            }
            if types.is_slice_ref(st, scope.binding_type(st, i)) {
                let p = emit.load_slice(st, scope.slot_of(st, i));
                return ex.in_slice(scope.binding_type(st, i), p, st[59], 0);
            }
            return ex.in_reg(scope.binding_type(st, i), emit.load(st, scope.binding_type(st, i), scope.slot_of(st, i)));
        }
        return ex.plain(scope.binding_type(st, i));
    }
    // A `static` of this module declared as a slice of scalars is a shared reference to it.
    let table = lookup.static_named(st, text, name);
    if table >= 0 {
        let ty = scope.static_type(st, table);
        if ty == 0 {
            return ex.skip(st, from, to);
        }
        if emit.on(st) {
            let element = types.element_of(st, ty);
            if !types.is_plain(element) {
                return ex.skip(st, from, to);
            }
            let p = emit.static_load(st, table);
            return ex.in_slice(ty, p, st[59], 0);
        }
        return ex.plain(ty);
    }
    // A function of this module used as a value: its address, to be given to `spawn`.
    if emit.on(st) {
        var it = st[15];
        while it >= 0 {
            if ast.is_kind(st, it, kinds.NK::IFn) && ast.get(st, it, 13) == st[22] && ast.same(st, text, ast.get(st, it, 4), name) {
                if pass1.count_params(st, ast.get(st, it, 6), false) > 0 {
                    // Only a written function with no type parameters can be a value.
                    ast.fail(st, rules.r_no_function_values(), from, to);
                    return ex.nothing();
                }
                if !plain_function(st, text, it) {
                    return ex.skip(st, from, to);
                }
                return ex.in_reg(types.make_fnval(st, it), threadcode.function_pointer(st, it));
            }
            it = ast.next(st, it);
        }
    }
    // A name that is not a local may still be a function used as a value, or a builtin: those are
    // values of types this slice does not check.
    if lookup.names_something(st, text, name) {
        return ex.skip(st, from, to);
    }
    ast.fail(st, rules.r_unknown_name(), from, to);
    return ex.nothing();
}

// The code for `l op r` on two operands of type `ty`, answering the temporary of the result.
pub fn binary_code[&s](st: &!s [int], op: int, ty: int, l: ex.Ex, r: ex.Ex) -> [] int {
    if ty == 3 || ty == 4 {
        if op >= 13 {
            return floatcode.float_op(st, op, ty, l.known, l.value, l.reg, r.known, r.value, r.reg);
        }
        return floatcode.float_compare(st, op, ty, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    if op >= 13 && op <= 15 {
        return emit.checked(st, op - 13, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    if op == 16 || op == 17 {
        return emit.divide(st, op == 17, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    if op == 11 || op == 12 {
        return emit.shift(st, op == 11, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    if op >= 8 && op <= 10 {
        var kind = 2;
        if op == 10 {
            kind = 0;
        } else if op == 8 {
            kind = 1;
        }
        return emit.bitwise(st, kind, l.known, l.value, l.reg, r.known, r.value, r.reg);
    }
    return emit.compare(st, op, ty, l.known, l.value, l.reg, r.known, r.value, r.reg);
}

// A call to a builtin the table says everything about: it takes what its signature says, as a
// call to a function does, its region parameters made variables the arguments solve. A builtin the
// lowering checks by hand, one that performs an effect (rows are not checked yet) and one with a
// type the checker cannot hold are `SKIP`; and every builtin is while code is being written.
// A builtin on words, its arguments pushed.
pub fn word_builtin[&s](st: &!s [int], written: int, result: int) -> [] ex.Ex {
    if written == 70 {
        wordcode.stop(st);
        return ex.constant(0);
    }
    if written == 71 {
        wordcode.copy_within(st);
        return ex.constant(0);
    }
    if written == 72 {
        return ex.in_reg(1, wordcode.barrier(st));
    }
    if written == 73 {
        return ex.in_reg(result, wordcode.mul_wide(st, result));
    }
    if written == 74 || written == 75 {
        return ex.in_reg(result, wordcode.add_carry(st, result, written == 75));
    }
    if written == 76 {
        return ex.in_reg(1, wordcode.load_le64(st));
    }
    if written == 77 {
        return ex.in_reg(1, wordcode.byte_mask64(st));
    }
    return ex.in_reg(1, wordcode.count_bits(st, written - 78));
}

// A type written in a callee's declaration, at one call: its type parameters are the variables made
// for the call (the first is `tvars`) and its region parameters the region variables.
pub fn callee_type[&s, &x](st: &!s [int], text: &x [byte], ty: int, dp: int, fresh: int, tvars: int) -> [] int {
    st[31] = tvars;
    let out = scope.lower_type(st, text, ty, dp, fresh);
    st[31] = 0 - 1;
    return out;
}

// A function whose row is plain labels and only types this slice handles: the callees it can call.
// Regions and type parameters are fine.
pub fn plain_function[&s, &x](st: &!s [int], text: &x [byte], fn_item: int) -> [] bool {
    let dp = ast.get(st, fn_item, 6);
    if !emit.on(st) && !effects.plain_row(st, effects.row_mask(st, text, fn_item)) {
        return false;
    }
    // The type parameters stand for variables that are not used again, to see that the types can be written.
    var scratch = 0 - 1;
    var made = 0;
    while emit.on(st) && made < pass1.count_params(st, dp, false) {
        let v = types.fresh_tvar(st);
        if made == 0 {
            scratch = v;
        }
        made = made + 1;
    }
    st[31] = scratch;
    var good = true;
    var param = ast.get(st, fn_item, 7);
    while param >= 0 {
        if scope.lower_type(st, text, ast.get(st, param, 5), dp, 0 - 1) == 0 {
            good = false;
        }
        param = ast.next(st, param);
    }
    if scope.lower_type(st, text, ast.get(st, fn_item, 10), dp, 0 - 1) == 0 {
        good = false;
    }
    st[31] = 0 - 1;
    return good;
}
