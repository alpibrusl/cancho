module selfhost.scope;

// scope.cho -- what a function body keeps while it is checked: the stack of bindings and what is
// borrowed of each, the blocks `borrow` and `region` open, and the lowering of the types written in
// a declaration into the checker's own (`types.cho`).
//
// Split from `body.cho` for its length; see there for what the port checks.

import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.kinds;
import selfhost.rules;
import selfhost.pass1;
import selfhost.types;
import selfhost.instances;
import selfhost.emit;

import selfhost.tables;

// ------------------------------------------------------------- bindings ---

// A new binding. The span is where Rust says it was declared (a parameter's type, a statement),
// and the log of every binding ever declared (`st[38]`, six ints each: type, the block open then,
// that span, whether it holds something to end, the binding of the `&!` it was copied from) is what the escape check reads once the body is done. A binding starts owned.
pub fn bind[&s](st: &!s [int], name: int, ty: int, mutable: bool, from: int, to: int) -> [] int {
    if emit.on(st) {
        if types.is_erased(st, ty) {
            // nothing to keep
        } else if !types.is_plain(ty) && ty != 7 && !types.is_ref(st, ty) && !aggregate_codable(st, ty) && !instances.inferring(st) {
            return ast.fail(st, rules.r_skip(), from, to);
        } else if types.is_slice_ref(st, ty) {
            emit.alloca_slice(st, st[39]);
        } else {
            emit.alloca(st, ty, st[39]);
        }
    }
    let at = st[20] + 5 * st[21];
    st[at] = name;
    st[at + 1] = ty;
    st[at + 2] = ast.flag(mutable);
    st[at + 3] = 0;
    st[at + 4] = st[39];
    st[21] = st[21] + 1;
    let log = st[38] + 6 * st[39];
    st[log] = ty;
    st[log + 1] = st[37];
    st[log + 2] = from;
    st[log + 3] = to;
    st[log + 4] = 0;
    st[log + 5] = 0;
    if emit.on(st) && is_res_type(st, ty) {
        st[log + 4] = 1;
    }
    if emit.on(st) && types.is_thread(st, ty) {
        lease_bind(st, st[39]);
    }
    st[39] = st[39] + 1;
    return 0;
}

// The most recent live binding spelled like token `name`, or -1.
pub fn find[&s, &x](st: &!s [int], text: &x [byte], name: int) -> [] int {
    var i = st[21] - 1;
    while i >= 0 {
        if ast.same(st, text, st[st[20] + 5 * i], name) {
            return i;
        }
        i = i - 1;
    }
    return 0 - 1;
}

pub fn binding_type[&s](st: &!s [int], i: int) -> [] int {
    return st[st[20] + 5 * i + 1];
}

pub fn binding_mutable[&s](st: &!s [int], i: int) -> [] bool {
    return st[st[20] + 5 * i + 2] != 0;
}

// ------------------------------------------------------- borrows, blocks ---
//
// Whether a binding is borrowed is a flag in its record: 0 owned, -1 locked by a unique borrow,
// n frozen by n shared ones. The conflicts are Rust's linear pass, which runs after the body and
// only if the body had no error; so the first is kept (`st[32]` its rule, `st[33]`, `st[34]` its
// span) and reported at the end, if nothing else was wrong.

pub fn note[&s](st: &!s [int], rule: int, from: int, to: int) -> [] int {
    if st[32] == 0 {
        st[32] = rule;
        st[33] = from;
        st[34] = to;
    }
    return 0;
}

// ----------------------------------------------------------- linearity ---
//
// `docs/linearity-and-effects.md` section 4 as `linear.rs` replays it, here at the walk and while code is written (the
// Rust oracle of the checker alone does not run it): a binding is 0 holding nothing to end, 1 holding a `res` value, 2
// having had it consumed (the fifth int of its entry in the log of bindings). A branch saves the states and walks each
// arm from them, and the arms that go on must agree; a loop must leave them as it found them. The first refusal is kept
// like the borrow conflicts (`note`). After the log come sixteen ints, the stack pointer and the first binding of the
// block being walked, and the stack of what the branches and loops being walked have saved: a frame is its width, how
// many arms went on, the states before, the states the arms that went on agreed on, and its size.

fn lin_head[&s](st: &!s [int]) -> [] int {
    return st[38] + 6 * ((st[19] - 64) / 3 + 16);
}

// ------------------------------------------------------------------ leases ---
//
// `docs/aliasing.md` section 6.1 and `linear.rs`: a `&!` given to a thread is lent to it until the handle is joined, and
// until then no copy of that reference may be read or lent again. A reference is a copy of the one it was bound from (the
// sixth int of its entry in the log: that binding's slot, plus one); a lease is the root it lends and the handle that holds
// it. Words 3 to 14 of the header after the log: whether a `spawn` waits for its handle to be bound, how many leases, and
// five of them (root, handle, -1 for none yet). Branches and loops save and compare them as they do the states.

fn lease_at[&s](st: &!s [int], k: int) -> [] int {
    return lin_head(st) + 5 + 2 * k;
}

pub fn lease_root[&s](st: &!s [int], i: int) -> [] int {
    let slot = slot_of(st, i);
    let r = st[st[38] + 6 * slot + 5];
    if r == 0 {
        return slot;
    }
    return r - 1;
}

pub fn lease_alias[&s](st: &!s [int], now: int, source: int) -> [] int {
    st[st[38] + 6 * slot_of(st, now) + 5] = lease_root(st, source) + 1;
    return 0;
}

fn lease_count[&s](st: &!s [int]) -> [] int {
    return st[lin_head(st) + 4];
}

pub fn lease_held[&s](st: &!s [int], root: int) -> [] bool {
    var k = 0;
    while k < lease_count(st) {
        if st[lease_at(st, k)] == root {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// A `spawn` given the `&!` bound at `i`: refused if that reference is lent already, and lent from here until the handle is
// joined. (One lent where a function-valued payload or a copy through a call hides it is not followed, as in Rust.)
pub fn lease_spawn[&s](st: &!s [int], i: int, from: int, to: int) -> [] int {
    if !emit.on(st) {
        return 0;
    }
    let root = lease_root(st, i);
    if lease_held(st, root) {
        note(st, rules.r_borrow_conflict(), from, to);
    }
    let h = lin_head(st);
    if st[h + 4] >= 5 {
        ast.fail(st, rules.r_skip(), from, to);
        return 0;
    }
    st[lease_at(st, st[h + 4])] = root;
    st[lease_at(st, st[h + 4]) + 1] = 0 - 1;
    st[h + 4] = st[h + 4] + 1;
    st[h + 3] = 1;
    return 0;
}

// The handle just bound is the one the last `spawn` is waiting for.
pub fn lease_bind[&s](st: &!s [int], slot: int) -> [] int {
    let h = lin_head(st);
    if st[h + 3] == 1 {
        var k = st[h + 4] - 1;
        while k >= 0 {
            if st[lease_at(st, k) + 1] < 0 {
                st[lease_at(st, k) + 1] = slot;
                st[h + 3] = 0;
                return 0;
            }
            k = k - 1;
        }
        st[h + 3] = 0;
    }
    return 0;
}

fn lease_drop[&s](st: &!s [int], k: int) -> [] int {
    let h = lin_head(st);
    var j = k;
    while j + 1 < st[h + 4] {
        st[lease_at(st, j)] = st[lease_at(st, j + 1)];
        st[lease_at(st, j) + 1] = st[lease_at(st, j + 1) + 1];
        j = j + 1;
    }
    st[h + 4] = st[h + 4] - 1;
    return 0;
}

// `join(t)` of the handle bound at slot `slot`: its lease ends.
pub fn lease_join[&s](st: &!s [int], slot: int) -> [] int {
    var k = 0;
    while k < lease_count(st) {
        if st[lease_at(st, k) + 1] == slot {
            lease_drop(st, k);
        } else {
            k = k + 1;
        }
    }
    return 0;
}

// `join(spawn(..))`: the lease the `spawn` just made ends where it was made.
pub fn lease_join_now[&s](st: &!s [int]) -> [] int {
    let h = lin_head(st);
    if st[h + 3] == 1 {
        var k = st[h + 4] - 1;
        while k >= 0 {
            if st[lease_at(st, k) + 1] < 0 {
                lease_drop(st, k);
                st[h + 3] = 0;
                return 0;
            }
            k = k - 1;
        }
        st[h + 3] = 0;
    }
    return 0;
}

// The leases as they are, copied to the words from `to` (eleven: how many, then five pairs) and back.
fn lease_save[&s](st: &!s [int], to: int) -> [] int {
    var k = 0;
    while k < 11 {
        st[to + k] = st[lin_head(st) + 4 + k];
        k = k + 1;
    }
    return 0;
}

fn lease_load[&s](st: &!s [int], from: int) -> [] int {
    var k = 0;
    while k < 11 {
        st[lin_head(st) + 4 + k] = st[from + k];
        k = k + 1;
    }
    return 0;
}

// Are the leases as they are those saved at `at`?
fn lease_same[&s](st: &!s [int], at: int) -> [] bool {
    if st[lin_head(st) + 4] != st[at] {
        return false;
    }
    var k = 0;
    while k < st[at] {
        if st[lease_at(st, k)] != st[at + 1 + 2 * k] || st[lease_at(st, k) + 1] != st[at + 2 + 2 * k] {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// Whether the program's `main` has the wrong shape, which is said once every function has been checked (word 2 of the
// header after the log; `drive` clears it).
pub fn shape_clear[&s](st: &!s [int]) -> [] int {
    st[lin_head(st) + 2] = 0;
    return 0;
}

pub fn shape_set[&s](st: &!s [int]) -> [] int {
    st[lin_head(st) + 2] = 1;
    return 0;
}

pub fn shape_bad[&s](st: &!s [int]) -> [] bool {
    return st[lin_head(st) + 2] != 0;
}

pub fn lin_reset[&s](st: &!s [int]) -> [] int {
    let h = lin_head(st);
    st[h] = 0;
    st[h + 1] = 0;
    st[h + 3] = 0;
    st[h + 4] = 0;
    return 0;
}

pub fn lin_get[&s](st: &!s [int], slot: int) -> [] int {
    return st[st[38] + 6 * slot + 4];
}

pub fn lin_put[&s](st: &!s [int], slot: int, state: int) -> [] int {
    st[st[38] + 6 * slot + 4] = state;
    return 0;
}

// The first binding of the block being walked, which shadowing is looked for from.
pub fn lin_block[&s](st: &!s [int]) -> [] int {
    return st[lin_head(st) + 1];
}

pub fn lin_enter[&s](st: &!s [int], mark: int) -> [] int {
    st[lin_head(st) + 1] = mark;
    return 0;
}

// A `let` of a name this block has already bound, over a value it still holds, would put the value out of reach.
pub fn lin_shadow[&s, &x](st: &!s [int], text: &x [byte], name: int, from: int, to: int) -> [] int {
    if !emit.on(st) {
        return 0;
    }
    var j = st[21] - 1;
    while j >= lin_block(st) {
        if ast.same(st, text, st[st[20] + 5 * j], name) {
            if lin_get(st, slot_of(st, j)) == 1 {
                note(st, rules.r_linear_value_unconsumed(), from, to);
            }
            return 0;
        }
        j = j - 1;
    }
    return 0;
}

// A block closes over the bindings from `mark`: any still holding a value nothing consumed is a refusal, unless the
// block ended in a `return` on every path (which asked the same). They are gone either way.
pub fn lin_close[&s](st: &!s [int], mark: int, diverged: bool) -> [] int {
    if !emit.on(st) {
        return 0;
    }
    var j = mark;
    while j < st[21] {
        let slot = slot_of(st, j);
        if lin_get(st, slot) == 1 && !diverged {
            let log = st[38] + 6 * slot;
            note(st, rules.r_linear_value_unconsumed(), st[log + 2], st[log + 3]);
        }
        lin_put(st, slot, 0);
        j = j + 1;
    }
    return 0;
}

// A `return`: nothing may still hold a value.
pub fn lin_return[&s](st: &!s [int], from: int, to: int) -> [] int {
    if !emit.on(st) {
        return 0;
    }
    var k = 0;
    while k < st[39] {
        if lin_get(st, k) == 1 {
            note(st, rules.r_linear_value_unconsumed(), from, to);
            return 0;
        }
        k = k + 1;
    }
    return 0;
}

// The frame on top of the stack: where it begins.
fn lin_top[&s](st: &!s [int]) -> [] int {
    let h = lin_head(st);
    return h + 16 + st[h] - st[h + 16 + st[h] - 1];
}

// A branch or a loop is entered: the states of the bindings so far are saved.
pub fn lin_open[&s](st: &!s [int], from: int, to: int) -> [] int {
    if !emit.on(st) {
        return 0;
    }
    let h = lin_head(st);
    let n = st[39];
    let size = 25 + 2 * n;
    if st[h] + size > 262144 {
        ast.fail(st, rules.r_skip(), from, to);
        return 0;
    }
    let at = h + 16 + st[h];
    st[at] = n;
    st[at + 1] = 0;
    var k = 0;
    while k < n {
        st[at + 2 + k] = lin_get(st, k);
        k = k + 1;
    }
    lease_save(st, at + 2 + 2 * n);
    st[at + 2 + 2 * n + 22] = size;
    st[h] = st[h] + size;
    return 0;
}

// An arm begins from the states the branch was entered with.
pub fn lin_arm[&s](st: &!s [int]) -> [] int {
    if !emit.on(st) || !ast.ok(st) {
        return 0;
    }
    let at = lin_top(st);
    var k = 0;
    while k < st[at] {
        lin_put(st, k, st[at + 2 + k]);
        k = k + 1;
    }
    lease_load(st, at + 2 + 2 * st[at]);
    return 0;
}

// An arm ends: what it declared is gone, and an arm that goes on must leave what the others that go on left.
pub fn lin_arm_end[&s](st: &!s [int], diverged: bool, from: int, to: int) -> [] int {
    if !emit.on(st) || !ast.ok(st) {
        return 0;
    }
    let at = lin_top(st);
    let n = st[at];
    var k = n;
    while k < st[39] {
        lin_put(st, k, 0);
        k = k + 1;
    }
    if diverged {
        return 0;
    }
    if st[at + 1] == 0 {
        k = 0;
        while k < n {
            st[at + 2 + n + k] = lin_get(st, k);
            k = k + 1;
        }
        lease_save(st, at + 13 + 2 * n);
        st[at + 1] = 1;
        return 0;
    }
    if !lease_same(st, at + 13 + 2 * n) {
        // One arm joined the thread that holds a `&!` and another did not.
        note(st, rules.r_borrow_conflict(), from, to);
    }
    k = 0;
    while k < n {
        if lin_get(st, k) != st[at + 2 + n + k] {
            note(st, rules.r_linear_value_unconsumed(), from, to);
            return 0;
        }
        k = k + 1;
    }
    return 0;
}

// The branch is over: the states are what the arms that went on agreed on, or what they were if none did.
pub fn lin_join[&s](st: &!s [int]) -> [] int {
    if !emit.on(st) || !ast.ok(st) {
        return 0;
    }
    let at = lin_top(st);
    let n = st[at];
    var k = 0;
    while k < n {
        if st[at + 1] == 1 {
            lin_put(st, k, st[at + 2 + n + k]);
        } else {
            lin_put(st, k, st[at + 2 + k]);
        }
        k = k + 1;
    }
    if st[at + 1] == 1 {
        lease_load(st, at + 13 + 2 * n);
    } else {
        lease_load(st, at + 2 + 2 * n);
    }
    let h = lin_head(st);
    st[h] = st[h] - st[h + 16 + st[h] - 1];
    return 0;
}

// The loop is over: a body that goes on must have left the states as it found them, and they are those either way.
pub fn lin_loop_end[&s](st: &!s [int], diverged: bool, from: int, to: int) -> [] int {
    if !emit.on(st) || !ast.ok(st) {
        return 0;
    }
    let at = lin_top(st);
    let n = st[at];
    var k = n;
    while k < st[39] {
        lin_put(st, k, 0);
        k = k + 1;
    }
    k = 0;
    var differs = false;
    while k < n {
        if lin_get(st, k) != st[at + 2 + k] {
            differs = true;
        }
        lin_put(st, k, st[at + 2 + k]);
        k = k + 1;
    }
    if differs && !diverged {
        note(st, rules.r_linear_value_unconsumed(), from, to);
    }
    if !diverged && !lease_same(st, at + 2 + 2 * n) {
        // A thread spawned in the loop still holds a `&!` when the next iteration starts.
        note(st, rules.r_borrow_conflict(), from, to);
    }
    lease_load(st, at + 2 + 2 * n);
    let h = lin_head(st);
    st[h] = st[h] - st[h + 16 + st[h] - 1];
    return 0;
}

// The number this binding was declared as, which names its stack slot in the code.
pub fn slot_of[&s](st: &!s [int], i: int) -> [] int {
    return st[st[20] + 5 * i + 4];
}

pub fn borrowed[&s](st: &!s [int], i: int) -> [] int {
    return st[st[20] + 5 * i + 3];
}

// A name was read. A `res` value is moved by it (there is no read of an owned name that leaves it), so it is not
// there for a second read, and not at all while a `borrow` has it frozen.
pub fn use_slot[&s](st: &!s [int], i: int, from: int, to: int) -> [] int {
    if borrowed(st, i) < 0 {
        note(st, rules.r_borrow_conflict(), from, to);
        return 0;
    }
    if emit.on(st) {
        let slot = slot_of(st, i);
        let held = lin_get(st, slot);
        if types.is_ref(st, binding_type(st, i)) && types.ref_unique(st, binding_type(st, i)) && lease_held(st, lease_root(st, i)) {
            // A `&!` lent to a thread is its alone until the handle is joined.
            note(st, rules.r_borrow_conflict(), from, to);
        }
        if held == 1 {
            if borrowed(st, i) != 0 {
                note(st, rules.r_borrow_conflict(), from, to);
            } else {
                lin_put(st, slot, 2);
            }
        } else if held == 2 {
            note(st, rules.r_linear_use_after_move(), from, to);
        }
    }
    return 0;
}

// A binding was assigned to: not while it is borrowed, and not over a `res` value it still holds.
pub fn assign_slot[&s](st: &!s [int], i: int, from: int, to: int) -> [] int {
    if borrowed(st, i) != 0 {
        note(st, rules.r_borrow_conflict(), from, to);
    }
    if emit.on(st) {
        let slot = slot_of(st, i);
        if borrowed(st, i) == 0 && lin_get(st, slot) == 1 {
            note(st, rules.r_linear_value_unconsumed(), from, to);
        }
        if is_res_type(st, binding_type(st, i)) {
            lin_put(st, slot, 1);
        }
    }
    return 0;
}

// A `borrow` block opens over a binding: one unique borrow at a time and never beside a shared
// one, and shared ones nest.
pub fn freeze[&s](st: &!s [int], i: int, unique: bool, from: int, to: int) -> [] int {
    if emit.on(st) && lin_get(st, slot_of(st, i)) == 2 {
        // Consumed already: nothing is left to borrow.
        note(st, rules.r_linear_use_after_move(), from, to);
        return 0;
    }
    let held = borrowed(st, i);
    if held < 0 || held > 0 && unique {
        note(st, rules.r_borrow_conflict(), from, to);
        return 0;
    }
    if unique {
        st[st[20] + 5 * i + 3] = 0 - 1;
    } else {
        st[st[20] + 5 * i + 3] = held + 1;
    }
    return 0;
}

pub fn thaw[&s](st: &!s [int], i: int, unique: bool) -> [] int {
    let held = borrowed(st, i);
    if held > 1 && !unique {
        st[st[20] + 5 * i + 3] = held - 1;
    } else {
        st[st[20] + 5 * i + 3] = 0;
    }
    return 0;
}

// A block opens, named by the token `name`, inside the one open now: its number.
pub fn open_block[&s](st: &!s [int], name: int) -> [] int {
    let id = st[35];
    st[st[36] + 2 * id] = st[37];
    st[st[36] + 2 * id + 1] = name;
    st[35] = id + 1;
    st[37] = id;
    return id;
}

// The innermost open block that is an arena called like token `name`, or -1. A `borrow` block keeps
// its name as `-2 - token` and so is never one.
pub fn arena_block[&s, &x](st: &!s [int], text: &x [byte], name: int) -> [] int {
    var id = st[37];
    while id >= 0 {
        let kept = st[st[36] + 2 * id + 1];
        if kept >= 0 && ast.same(st, text, kept, name) {
            return id;
        }
        id = st[st[36] + 2 * id];
    }
    return 0 - 1;
}

pub fn close_block[&s](st: &!s [int]) -> [] int {
    st[37] = st[st[36] + 2 * st[37]];
    return 0;
}

// Does a type written in an annotation name a region other than `static`?
pub fn names_region[&s, &x](st: &!s [int], text: &x [byte], ty: int) -> [] bool {
    if ast.is_kind(st, ty, kinds.NK::TRef) {
        if !pass1.is_word(st, text, ast.get(st, ty, 5), "static") {
            return true;
        }
        return names_region(st, text, ast.get(st, ty, 6));
    }
    if ast.is_kind(st, ty, kinds.NK::TSlice) {
        return names_region(st, text, ast.get(st, ty, 6));
    }
    if ast.is_kind(st, ty, kinds.NK::TName) {
        var arg = ast.get(st, ty, 6);
        var k = 0;
        while k < ast.get(st, ty, 7) {
            if names_region(st, text, arg) {
                return true;
            }
            arg = ast.next(st, arg);
            k = k + 1;
        }
    }
    return false;
}

// The innermost open block called like token `name`, an arena or a `borrow`'s (which keeps `-2 - token`), or -1.
pub fn region_block[&s, &x](st: &!s [int], text: &x [byte], name: int) -> [] int {
    var id = st[37];
    while id >= 0 {
        let kept = st[st[36] + 2 * id + 1];
        if kept != 0 - 1 {
            var token = kept;
            if kept < 0 {
                token = 0 - 2 - kept;
            }
            if ast.same(st, text, token, name) {
                return id;
            }
        }
        id = st[st[36] + 2 * id];
    }
    return 0 - 1;
}

// `let used: Holder[&r Bytes] = hole;` in a block of region `r`, where `hole` was declared outside it and its type is a
// `Holder` whose argument is still unknown: the annotation fills the argument with a reference into `r`, which a binding
// declared outside the block would then hold (`reference-escapes-region`, rule 4 of section 5). Only this shape is judged.
pub fn escapes_by_inference[&s, &x](st: &!s [int], text: &x [byte], written: int, value: int) -> [] bool {
    if !ast.is_kind(st, value, kinds.NK::EName) || !ast.is_kind(st, written, kinds.NK::TName) {
        return false;
    }
    let local = find(st, text, ast.get(st, value, 4));
    if local < 0 {
        return false;
    }
    let ty = binding_type(st, local);
    if !types.is_named(st, ty) || !ast.same(st, text, ast.get(st, types.named_item(st, ty), 4), ast.get(st, written, 5)) {
        return false;
    }
    let outer = st[st[38] + 6 * st[st[20] + 5 * local + 4] + 1];
    var arg = ast.get(st, written, 6);
    var k = 0;
    while k < ast.get(st, written, 7) {
        if ast.is_kind(st, arg, kinds.NK::TRef) && !pass1.is_word(st, text, ast.get(st, arg, 5), "static") {
            let block = region_block(st, text, ast.get(st, arg, 5));
            if block >= 0 && block != outer && !types.encloses(st, block, outer) && types.is_tvar(st, types.shallow(st, types.named_arg(st, ty, k))) {
                return true;
            }
        }
        arg = ast.next(st, arg);
        k = k + 1;
    }
    return false;
}

// ---------------------------------------------------------------- types ---

// The scalar tag of the resolved type node `ty`, or 0 if it is not a scalar.
pub fn scalar[&s](st: &!s [int], ty: int) -> [] int {
    if ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 0 {
        return ast.get(st, ty, 10);
    }
    return 0;
}

// A struct this slice handles: declared in the file, not `res`, with no parameters, and only
// scalar fields, so a value of it is `val` and copies.
pub fn struct_plain[&s](st: &!s [int], item: int) -> [] bool {
    if !ast.is_kind(st, item, kinds.NK::IStruct) {
        return false;
    }
    if ast.get(st, item, 6) == 2 || ast.get(st, item, 7) >= 0 {
        return false;
    }
    var f = ast.get(st, item, 8);
    while f >= 0 {
        if scalar(st, ast.get(st, f, 5)) == 0 {
            return false;
        }
        f = ast.next(st, f);
    }
    return true;
}

// Is the declaration `node` of a field or a payload one code is written for: a whole number, a
// byte, a boolean, a run on the heap of those, or a struct or an enum that is itself such? `depth`
// stops a declaration that holds itself.
fn node_codable[&s](st: &!s [int], node: int, ctx: int, depth: int) -> [] bool {
    let t = types.node_type(st, node, ctx);
    if t == 0 {
        return false;
    }
    if types.is_plain(t) || types.is_erased(st, t) {
        return true;
    }
    if types.is_boxslice(st, t) || types.is_box(st, t) || types.is_handle(st, t) || types.is_penum(st, t) {
        return true;
    }
    if types.is_ref(st, t) {
        // A reference is a pointer, a run of bytes a pointer and a length; what it points at is not looked into.
        return true;
    }
    if types.is_tuple(st, t) {
        return tuple_codable(st, t);
    }
    if !types.is_named(st, t) {
        return false;
    }
    return depth > 0 && item_codable(st, t, depth - 1);
}

// A struct or an enum code is written for: no type parameters, a field or a variant at least, and
// every field or payload as `node_codable` says. A `res` one is too: what ends it is Rust's to say.
pub fn item_codable[&s](st: &!s [int], ty: int, depth: int) -> [] bool {
    let item = types.named_item(st, ty);
    // A declaration with type parameters is codable at the arguments of `ty`, which must all be there.
    if ast.get(st, item, 7) >= 0 && types.named_arg(st, ty, 0) == 0 {
        return false;
    }
    if ast.is_kind(st, item, kinds.NK::IStruct) {
        var f = ast.get(st, item, 8);
        if f < 0 {
            return false;
        }
        while f >= 0 {
            if !node_codable(st, ast.get(st, f, 5), ty, depth) {
                return false;
            }
            f = ast.next(st, f);
        }
        return true;
    }
    if ast.is_kind(st, item, kinds.NK::IEnum) {
        var v = ast.get(st, item, 8);
        if v < 0 {
            return false;
        }
        while v >= 0 {
            var p = ast.get(st, v, 5);
            var n = ast.get(st, v, 6);
            while n > 0 {
                if !node_codable(st, p, ty, depth) {
                    return false;
                }
                p = ast.next(st, p);
                n = n - 1;
            }
            v = ast.next(st, v);
        }
        return true;
    }
    return false;
}

// A value of this type has code written for it: a struct (see `item_codable`).
pub fn struct_codable[&s](st: &!s [int], ty: int) -> [] bool {
    return types.is_named(st, ty) && ast.is_kind(st, types.named_item(st, ty), kinds.NK::IStruct) && item_codable(st, ty, 6);
}

// The same for an enum.
pub fn enum_codable[&s](st: &!s [int], ty: int) -> [] bool {
    return types.is_named(st, ty) && ast.is_kind(st, types.named_item(st, ty), kinds.NK::IEnum) && item_codable(st, ty, 6);
}

// Is this a struct or an enum declared `res`?
pub fn is_res_item[&s](st: &!s [int], ty: int) -> [] bool {
    return types.is_named(st, ty) && ast.get(st, types.named_item(st, ty), 6) == 2;
}

// The type of a field's or a payload's declaration: a scalar; and when the code is written, also a
// struct, an enum or a box.
pub fn node_val[&s](st: &!s [int], node: int, ctx: int) -> [] int {
    let t = scalar(st, node);
    if t == 0 && (emit.on(st) || ctx >= 0) {
        return types.node_type(st, node, ctx);
    }
    return t;
}

// A reference to a slice of whole numbers, bytes or booleans: a pointer and a length in the code.
pub fn slice_codable[&s](st: &!s [int], ty: int) -> [] bool {
    if !types.is_slice_ref(st, ty) {
        return false;
    }
    let e = types.element_of(st, ty);
    return element_ok(st, e);
}

// May a run hold this: a scalar, or a struct, an enum or a tuple, one aggregate in the code?
pub fn element_ok[&s](st: &!s [int], e: int) -> [] bool {
    return types.is_plain(e) || aggregate_codable(st, e) && !types.is_slice_ref(st, e);
}

// A value of this type has code: a struct or an enum of scalars, one aggregate in the code.
// A tuple whose parts the code holds: whole numbers, bytes, booleans or aggregates.
pub fn tuple_codable[&s](st: &!s [int], ty: int) -> [] bool {
    if !types.is_tuple(st, ty) {
        return false;
    }
    var k = 0;
    while k < types.tuple_size(st, ty) {
        let p = types.tuple_part(st, ty, k);
        if !types.is_plain(p) && !types.is_ref(st, p) && !aggregate_codable(st, p) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// Must a value of this type be ended by something, a `res` one? A box, a handle, an enum of the prelude that holds
// one, a struct declared `res`, a tuple that has such a part.
pub fn is_res_type[&s](st: &!s [int], ty: int) -> [] bool {
    if types.is_param(st, ty) && !pass1.param_bounded(st, st[28], types.param_position(st, ty)) {
        // A type parameter not bounded `val` is checked as though it were `res` (`docs/mode-polymorphism.md` section 3.1).
        return true;
    }
    if types.is_boxslice(st, ty) || types.is_box(st, ty) || types.is_handle(st, ty) || types.is_thread(st, ty) || is_res_item(st, ty) {
        return true;
    }
    if types.is_prelude(st, ty) && tables.prelude_res(types.prelude_index(st, ty)) % 2 == 1 {
        // A capability, a handle: `res` whatever its arguments are.
        return true;
    }
    if types.is_penum(st, ty) {
        return tables.prelude_res(types.prelude_index(st, ty)) != 0;
    }
    if emit.on(st) && types.is_named(st, ty) {
        // A struct or an enum is `res` if any member is, whatever it is declared (the type graph has no cycles).
        let item = types.named_item(st, ty);
        if ast.is_kind(st, item, kinds.NK::IStruct) {
            var f = ast.get(st, item, 8);
            while f >= 0 {
                if is_res_type(st, node_val(st, ast.get(st, f, 5), ty)) {
                    return true;
                }
                f = ast.next(st, f);
            }
        }
        if ast.is_kind(st, item, kinds.NK::IEnum) {
            var v = ast.get(st, item, 8);
            while v >= 0 {
                var p = ast.get(st, v, 5);
                var n = ast.get(st, v, 6);
                while n > 0 {
                    if is_res_type(st, node_val(st, p, ty)) {
                        return true;
                    }
                    p = ast.next(st, p);
                    n = n - 1;
                }
                v = ast.next(st, v);
            }
        }
    }
    if types.is_tuple(st, ty) {
        var k = 0;
        while k < types.tuple_size(st, ty) {
            if is_res_type(st, types.tuple_part(st, ty, k)) {
                return true;
            }
            k = k + 1;
        }
    }
    return false;
}

pub fn aggregate_codable[&s](st: &!s [int], ty: int) -> [] bool {
    if types.is_tuple(st, ty) {
        return tuple_codable(st, ty);
    }
    if types.is_handle(st, ty) || types.is_penum(st, ty) || types.is_thread(st, ty) || types.is_fnval(st, ty) || types.is_fnptr(st, ty) {
        return true;
    }
    if types.is_boxslice(st, ty) {
        let e = types.boxslice_element(st, ty);
        return element_ok(st, e) || types.is_tvar(st, e);
    }
    if types.is_box(st, ty) {
        return true;
    }
    return struct_codable(st, ty) || enum_codable(st, ty);
}

// The type of the table a `static` item declares, `&static [T]` for a scalar T, or 0.
pub fn static_type[&s](st: &!s [int], item: int) -> [] int {
    let declared = ast.get(st, item, 6);
    if !ast.is_kind(st, declared, kinds.NK::TSlice) {
        return 0;
    }
    let element = scalar(st, ast.get(st, declared, 6));
    if element == 0 {
        return 0;
    }
    return types.make_ref(st, false, types.static_region(), types.make_slice(st, element));
}

// `Heap`, the prelude type the heap operations are reached through.
pub fn heap_index() -> [] int {
    return 4;
}

// `World`, the first of the prelude types: what `main` is handed, and nothing a value of can do
// but be `release`d or `split`. The code written for it is none, as in the Rust backend.
pub fn world_index() -> [] int {
    return 0;
}

// An enum this slice handles: declared in the file, not `res`, with no parameters, and only
// scalar payloads, so a value of it is `val` and copies.
pub fn enum_plain[&s](st: &!s [int], item: int) -> [] bool {
    if !ast.is_kind(st, item, kinds.NK::IEnum) {
        return false;
    }
    if ast.get(st, item, 6) == 2 || ast.get(st, item, 7) >= 0 {
        return false;
    }
    var v = ast.get(st, item, 8);
    while v >= 0 {
        var p = ast.get(st, v, 5);
        var n = ast.get(st, v, 6);
        while n > 0 {
            if scalar(st, p) == 0 {
                return false;
            }
            p = ast.next(st, p);
            n = n - 1;
        }
        v = ast.next(st, v);
    }
    return true;
}

// The element of a slice: a scalar or a type parameter, else 0.
pub fn element_type[&s](st: &!s [int], ty: int) -> [] int {
    let tag = scalar(st, ty);
    if tag != 0 {
        return tag;
    }
    if ast.is_kind(st, ty, kinds.NK::TName) && (ast.get(st, ty, 8) == 1 || ast.get(st, ty, 8) == 3 && emit.on(st)) {
        return value_type(st, ty);
    }
    return 0;
}

// The type behind a reference: as `value_type`, and also a prelude type without arguments, which
// is what a capability or a handle is borrowed as (`&!r Io`). Behind a reference nothing moves, so
// whether it is a resource does not matter here.
pub fn referent_type[&s](st: &!s [int], ty: int) -> [] int {
    if ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 2 && ast.get(st, ty, 7) == 0 {
        return types.make_prelude(st, ast.get(st, ty, 9));
    }
    return value_type(st, ty);
}

// The type of the resolved type node `ty` when it is a scalar or a plain struct, else 0.
pub fn value_type[&s](st: &!s [int], ty: int) -> [] int {
    let tag = scalar(st, ty);
    if tag != 0 {
        return tag;
    }
    if ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 1 {
        // A type parameter: a variable at a call (the callee's, `st[31]` the first of them), and
        // rigid in the body that declares it.
        if st[31] >= 0 {
            return st[31] + ast.get(st, ty, 9);
        }
        if emit.on(st) && st[63] > 0 {
            return types.env_arg(st, ast.get(st, ty, 9));
        }
        return types.make_param(st, ast.get(st, ty, 9));
    }
    if emit.on(st) && ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 2 && ast.get(st, ty, 9) == world_index() && ast.get(st, ty, 7) == 0 {
        return types.make_prelude(st, world_index());
    }
    // A tuple written in a signature.
    if emit.on(st) && ast.is_kind(st, ty, kinds.NK::TTuple) {
        return types.node_type(st, ty, 0 - 1);
    }
    // `Box[T]` written in a signature: one value on the heap, in the code.
    if emit.on(st) && ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 2 && ast.get(st, ty, 9) == tables.prelude_box() && ast.get(st, ty, 7) == 1 {
        return types.node_type(st, ty, 0 - 1);
    }
    // `Thread[T, R]` written in a signature: a handle to join.
    if emit.on(st) && ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 2 && ast.get(st, ty, 9) == tables.prelude_thread() && ast.get(st, ty, 7) == 2 {
        return types.node_type(st, ty, 0 - 1);
    }
    // A capability narrowed to a literal, in the code: `Fs("/tmp")`, `Exec("/bin")`.
    if emit.on(st) && ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 2 && ast.get(st, ty, 7) == 1 && ast.is_kind(st, ast.get(st, ty, 6), kinds.NK::TLit) {
        return types.make_prelude_lit(st, ast.get(st, ty, 9), ast.get(st, ast.get(st, ty, 6), 4));
    }
    // A prelude type without arguments that is not a resource: `Done`, `Read`, `Opened`.
    if ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 2 && ast.get(st, ty, 7) == 0 && (tables.prelude_res(ast.get(st, ty, 9)) == 0 || emit.on(st)) {
        return types.make_prelude(st, ast.get(st, ty, 9));
    }
    if ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 3 && (emit.on(st) || ast.get(st, ty, 7) > 0) {
        // A struct or an enum of the file, with its arguments if it has any (without code, only one that has some: the rest
        // are the plain ones below).
        return types.node_type(st, ty, 0 - 1);
    }
    if ast.get(st, ty, 8) == 3 && (struct_plain(st, ast.get(st, ty, 9)) || enum_plain(st, ast.get(st, ty, 9))) {
        return types.make_named(st, ast.get(st, ty, 9));
    }
    return 0;
}

// The position of the field called `name` in the struct `item`, or -1.
pub fn field_index[&s, &x](st: &!s [int], text: &x [byte], item: int, name: int) -> [] int {
    var f = ast.get(st, item, 8);
    var i = 0;
    while f >= 0 {
        if ast.same(st, text, ast.get(st, f, 4), name) {
            return i;
        }
        f = ast.next(st, f);
        i = i + 1;
    }
    return 0 - 1;
}

// The scalar type of field number `index` of the struct `item`.
pub fn field_type[&s](st: &!s [int], ty: int, index: int) -> [] int {
    var f = ast.get(st, types.named_item(st, ty), 8);
    var i = 0;
    while i < index {
        f = ast.next(st, f);
        i = i + 1;
    }
    return node_val(st, ast.get(st, f, 5), ty);
}

// The type of the resolved type node `ty`, written in a declaration whose `[...]` starts at `dp`,
// or 0 if it is one this slice does not handle: a scalar, or a reference to a scalar or to a slice
// of one. `fresh` is -1 when the declaration is the function being checked, whose region
// parameters are what the regions are; for a callee it is the first of the variables made for
// its region parameters, which stand in for them at this call.
pub fn lower_type[&s, &x](st: &!s [int], text: &x [byte], ty: int, dp: int, fresh: int) -> [] int {
    if emit.on(st) && ast.is_kind(st, ty, kinds.NK::TFn) {
        return fn_type(st, text, ty, dp, fresh);
    }
    if emit.on(st) && ast.is_kind(st, ty, kinds.NK::TTuple) {
        return types.node_type(st, ty, 0 - 1);
    }
    if ast.is_kind(st, ty, kinds.NK::TName) {
        return value_type(st, ty);
    }
    if !ast.is_kind(st, ty, kinds.NK::TRef) {
        return 0;
    }
    let reg = ast.get(st, ty, 5);
    var area = types.static_region();
    if !pass1.is_word(st, text, reg, "static") {
        area = pass1.param_index(st, text, dp, true, reg);
        if fresh >= 0 {
            area = fresh + area;
        }
    }
    let inner = ast.get(st, ty, 6);
    var referent = 0;
    if ast.is_kind(st, inner, kinds.NK::TSlice) {
        let element = element_type(st, ast.get(st, inner, 6));
        if element != 0 {
            referent = types.make_slice(st, element);
        }
    } else {
        referent = referent_type(st, inner);
    }
    if referent == 0 {
        return 0;
    }
    return types.make_ref(st, ast.get(st, ty, 4) != 0, area, referent);
}

// `fn(A, B) -> R` written for a function without type parameters: up to three parameters.
fn fn_type[&s, &x](st: &!s [int], text: &x [byte], ty: int, dp: int, fresh: int) -> [] int {
    let n = ast.get(st, ty, 6);
    if st[31] >= 0 || n > 3 {
        return 0;
    }
    var parts = 0;
    var a = 0;
    var b = 0;
    var c = 0;
    var node = ast.get(st, ty, 5);
    while parts < n {
        let t = lower_type(st, text, node, dp, fresh);
        if t == 0 {
            return 0;
        }
        if parts == 0 {
            a = t;
        } else if parts == 1 {
            b = t;
        } else {
            c = t;
        }
        node = ast.next(st, node);
        parts = parts + 1;
    }
    let ret = lower_type(st, text, ast.get(st, ty, 7), dp, fresh);
    if ret == 0 {
        return 0;
    }
    return types.make_fnptr(st, ret, n, a, b, c);
}

// `expect_type`: `found` is usable where `expected` is wanted, or a refusal at the span.
pub fn expect[&s, &x](st: &!s [int], text: &x [byte], expected: int, found: int, from: int, to: int) -> [] int {
    return types.expect_type(st, text, expected, found, from, to);
}

// The element type of a reference to a slice, or `not-a-slice` at the span.
pub fn element[&s](st: &!s [int], ty: int, from: int, to: int) -> [] int {
    let e = types.element_of(st, ty);
    if e == 0 {
        ast.fail(st, rules.r_not_a_slice(), from, to);
    }
    return e;
}
