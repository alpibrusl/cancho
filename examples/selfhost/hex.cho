module selfhost.hex;

// hex.cho -- the value of a hexadecimal digit (either case), shared by the tests of `sha1.cho` and `zlib.cho` (and later of the store): a
// digit that is none answers 0, so a malformed expected value fails the comparison it is in rather than a trap.

pub fn value(c: int) -> [] int {
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    return 0;
}
