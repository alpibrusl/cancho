module selfhost.sha1;

// sha1.cho -- SHA-1 (FIPS 180-4, 20 bytes out), written in cancho, for the object names of the git bridge of `cancho vcs`
// (`docs/vcs-native.md`: a git object is named by the SHA-1 of "KIND LENGTH\0" and its content, so the bridge cannot be exact without
// it). Not a security primitive here: git names objects with it and so must the bridge; `std.crypto` has SHA-256 and `blake3.cho` BLAKE3
// for everything that is ours.
//
// The state is a run of integers in any slice, from a base `b` (`size()` of them). A word is an integer below 2^32, so a sum is masked
// and a rotation is two shifts, which stay below 2^63.
//
//   b+0 .. b+4 the five words of the hash, b+5 the bytes in the block (0 to 63), b+6 the bytes hashed in all,
//   b+8 .. b+71 the block (a byte to an integer), b+72 .. b+151 the schedule (80 words)

fn mask() -> [] int {
    return 4294967295;
}

pub fn size() -> [] int {
    return 152;
}

fn rotl(x: int, n: int) -> [] int {
    return (x << n | x >> 32 - n) & mask();
}

// The round function and the constant of the round `t`.
fn mix(t: int, b: int, c: int, d: int) -> [] int {
    if t < 20 {
        return b & c | (b ^ mask()) & d;
    }
    if t < 40 {
        return b ^ c ^ d;
    }
    if t < 60 {
        return b & c | b & d | c & d;
    }
    return b ^ c ^ d;
}

fn constant(t: int) -> [] int {
    if t < 20 {
        return 1518500249;
    }
    if t < 40 {
        return 1859775393;
    }
    if t < 60 {
        return 2400959708;
    }
    return 3395469782;
}

// Start hashing at `b`.
pub fn init[&s](h: &!s [int], b: int) -> [] int {
    var i = 0;
    while i < size() {
        h[b + i] = 0;
        i = i + 1;
    }
    h[b] = 1732584193;
    h[b + 1] = 4023233417;
    h[b + 2] = 2562383102;
    h[b + 3] = 271733878;
    h[b + 4] = 3285377520;
    return 0;
}

// The 80 rounds over the schedule, once its first 16 words are set.
fn rounds[&s](h: &!s [int], b: int) -> [] int {
    var t = 16;
    while t < 80 {
        let w = b + 72;
        h[w + t] = rotl(h[w + t - 3] ^ h[w + t - 8] ^ h[w + t - 14] ^ h[w + t - 16], 1);
        t = t + 1;
    }
    var a = h[b];
    var bb = h[b + 1];
    var c = h[b + 2];
    var d = h[b + 3];
    var e = h[b + 4];
    t = 0;
    while t < 80 {
        let temp = rotl(a, 5) + mix(t, bb, c, d) + e + constant(t) + h[b + 72 + t] & mask();
        e = d;
        d = c;
        c = rotl(bb, 30);
        bb = a;
        a = temp;
        t = t + 1;
    }
    h[b] = h[b] + a & mask();
    h[b + 1] = h[b + 1] + bb & mask();
    h[b + 2] = h[b + 2] + c & mask();
    h[b + 3] = h[b + 3] + d & mask();
    h[b + 4] = h[b + 4] + e & mask();
    return 0;
}

// The block kept in the state, compressed.
fn block[&s](h: &!s [int], b: int) -> [] int {
    var i = 0;
    while i < 16 {
        let k = b + 8 + 4 * i;
        h[b + 72 + i] = h[k] << 24 | h[k + 1] << 16 | h[k + 2] << 8 | h[k + 3];
        i = i + 1;
    }
    rounds(h, b);
    h[b + 5] = 0;
    return 0;
}

// One more byte of the message.
pub fn byte[&s](h: &!s [int], b: int, x: int) -> [] int {
    h[b + 8 + h[b + 5]] = x;
    h[b + 5] = h[b + 5] + 1;
    h[b + 6] = h[b + 6] + 1;
    if h[b + 5] == 64 {
        block(h, b);
    }
    return 0;
}

// A run of bytes: whole blocks are taken from `data` as they are, with no copy through the state.
pub fn update[&s, &d](h: &!s [int], b: int, data: &d [byte]) -> [] int {
    let n = len(data);
    var k = 0;
    while k < n {
        if h[b + 5] == 0 && n - k >= 64 {
            var i = 0;
            while i < 16 {
                let j = k + 4 * i;
                h[b + 72 + i] = int_of(data[j]) << 24 | int_of(data[j + 1]) << 16 | int_of(data[j + 2]) << 8 | int_of(data[j + 3]);
                i = i + 1;
            }
            rounds(h, b);
            h[b + 6] = h[b + 6] + 64;
            k = k + 64;
        } else {
            byte(h, b, int_of(data[k]));
            k = k + 1;
        }
    }
    return 0;
}

// The hash: the padding is added, and the 20 bytes are written to `out` (which holds at least 20). The state is spent.
pub fn finish[&s, &o](h: &!s [int], b: int, out: &!o [byte]) -> [] int {
    let bits = h[b + 6] * 8;
    byte(h, b, 128);
    while h[b + 5] != 56 {
        byte(h, b, 0);
    }
    var i = 0;
    while i < 8 {
        byte(h, b, bits >> 8 * (7 - i) & 255);
        i = i + 1;
    }
    i = 0;
    while i < 20 {
        out[i] = byte_of(h[b + i / 4] >> 8 * (3 - i % 4) & 255);
        i = i + 1;
    }
    return 0;
}
