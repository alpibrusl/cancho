edition 7;
module selfhost.walk;

// walk.cho -- the files a command is given: a path that names a file is that file, and a path that names a directory is every `.cho` file
// beneath it, found in bytewise order of name within each directory, without descending into (or listing) a name that starts with a dot.
// That is what `cancho fmt` does (`fmt_cli.rs`), and the commands that follow it will do the same. A link is followed, as `Path::is_dir` does.
//
// The paths are laid one after another in a buffer, each followed by a NUL.

import std.buffer;
import std.bytes;
import std.dirs;
import selfhost.lexcore as lc;

fn is_cho[&r](name: &r [byte]) -> [] bool {
    return len(name) >= 4 && bytes.equal(name[len(name) - 4..len(name)], ".cho");
}

// `path` and `name` with a `/` between them, unless `path` has one at its end.
fn child[&h, &p, &n](heap: &!h Heap, path: &p [byte], name: &n [byte]) -> [heap] buffer.Buffer {
    var b = buffer.append(heap, buffer.empty(heap, len(path) + len(name) + 2), path);
    if len(path) == 0 || lc.at(path, len(path) - 1) != '/' {
        b = buffer.push(heap, b, byte_of('/'));
    }
    return buffer.append(heap, b, name);
}

fn add[&h, &p](heap: &!h Heap, found: buffer.Buffer, path: &p [byte]) -> [heap] buffer.Buffer {
    return buffer.push(heap, buffer.append(heap, found, path), byte_of(0));
}

// Would an `Fs` refuse `path` by a trap? It does when the path has two dots in a row anywhere, `..` or `a..b` (`docs/filesystem.md` section 4.1), or is 4,096 bytes or more
// (the rule is `cancho_path_covers`), so the command line asks before it opens one.
pub fn dotdot[&p](path: &p [byte]) -> [] bool {
    if len(path) >= 4096 {
        return true;
    }
    var at = 1;
    while at < len(path) {
        if lc.at(path, at) == '.' && lc.at(path, at - 1) == '.' {
            return true;
        }
        at = at + 1;
    }
    return false;
}

// Is the segment `text[from..to]` exactly `..`?
fn is_up[&t](text: &t [byte], from: int, to: int) -> [] bool {
    return to - from == 2 && lc.at(text, from) == '.' && lc.at(text, from + 1) == '.';
}

// A copy of `path` with every `a/..` pair taken out (`x/y/../z` is `x/z`), the way a shell resolves a path before it opens a file. An `Fs` traps on `..` (see `dotdot`),
// so the command line collapses before it asks. It is lexical: a link in `y` is not looked through. A `..` with nothing in front of it stays (there is no current
// directory to look it up in), and the caller's `dotdot` check then refuses the path as before. `a/..` alone is `.`.
pub fn collapse[&h, &p](heap: &!h Heap, path: &p [byte]) -> [heap] buffer.Buffer {
    var cur = buffer.append(heap, buffer.empty(heap, len(path) + 1), path);
    var again = true;
    while again {
        again = false;
        var next = buffer.empty(heap, len(path) + 1);
        borrow cur as &cb in {
            let text = buffer.bytes(cb);
            var before_from = 0 - 1;
            var before_to = 0 - 1;
            var from = 0;
            var at = 0;
            while at <= len(text) && !again {
                if at == len(text) || lc.at(text, at) == '/' {
                    if is_up(text, from, at) && before_from >= 0 && !is_up(text, before_from, before_to) {
                        var rest = at;
                        if at < len(text) {
                            rest = at + 1;
                        }
                        next = buffer.append(heap, next, text[0..before_from]);
                        next = buffer.append(heap, next, text[rest..len(text)]);
                        if before_from == 0 && rest >= len(text) {
                            next = buffer.push(heap, next, byte_of('.'));
                        }
                        again = true;
                    } else {
                        if at > from {
                            before_from = from;
                            before_to = at;
                        }
                        from = at + 1;
                    }
                }
                at = at + 1;
            }
        }
        if again {
            buffer.drop(heap, cur);
            cur = next;
        } else {
            buffer.drop(heap, next);
        }
    }
    return cur;
}

// Is `path` a directory (or a link to one)?
pub fn is_directory[&f, &p](fs: &f Fs(""), path: &p [byte]) -> [fs_read("")] bool {
    if dotdot(path) {
        return false;
    }
    match open_dir(fs, path) {
        DirOpened::Ok(dir) => {
            dir_close(dir);
            return true;
        }
        DirOpened::Failed(reason) => {
            return false;
        }
    }
}

// The `.cho` files beneath the directory at `path`, added to `found`.
fn below[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], found: buffer.Buffer) -> [heap, fs_read(""), dir_read] buffer.Buffer {
    var out = found;
    if dotdot(path) {
        return out;
    }
    match open_dir(fs, path) {
        DirOpened::Failed(reason) => {
            return out;
        }
        DirOpened::Ok(opened) => {
            var dir = opened;
            borrow dir as &d in {
                let names = dirs.list(heap, d, 1000000);
                borrow names as &n in {
                    var k = 0;
                    while k < dirs.count(n) {
                        let name = dirs.name(n, k);
                        if len(name) > 0 && lc.at(name, 0) != '.' {
                            let sub = child(heap, path, name);
                            borrow sub as &s in {
                                let kind = dirs.kind(n, k);
                                var is_dir = kind == dirs.kind_directory();
                                if kind == dirs.kind_link() || kind == dirs.kind_unknown() {
                                    is_dir = is_directory(fs, buffer.bytes(s));
                                }
                                if is_dir {
                                    out = below(heap, fs, buffer.bytes(s), out);
                                } else if is_cho(name) {
                                    out = add(heap, out, buffer.bytes(s));
                                }
                            }
                            buffer.drop(heap, sub);
                        }
                        k = k + 1;
                    }
                }
                dirs.drop(heap, names);
            }
            dir_close(dir);
        }
    }
    return out;
}

// What `path` stands for, added to `found`: itself, or the files beneath it.
pub fn collect[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], found: buffer.Buffer) -> [heap, fs_read(""), dir_read] buffer.Buffer {
    if is_directory(fs, path) {
        return below(heap, fs, path, found);
    }
    return add(heap, found, path);
}

// The files whose name ends with `suffix` directly in the directory at `path` (a name that starts with a dot is one too; a directory is not), added to `found`, in the order
// the system lists them.
pub fn direct_with[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], found: buffer.Buffer, suffix: &static [byte]) -> [heap, fs_read(""), dir_read] buffer.Buffer {
    var out = found;
    if dotdot(path) {
        return out;
    }
    match open_dir(fs, path) {
        DirOpened::Failed(reason) => {
            return out;
        }
        DirOpened::Ok(opened) => {
            var dir = opened;
            borrow dir as &d in {
                let names = dirs.list(heap, d, 1000000);
                borrow names as &n in {
                    var k = 0;
                    while k < dirs.count(n) {
                        let name = dirs.name(n, k);
                        if len(name) > len(suffix) && len(name) >= len(suffix) && bytes.equal(name[len(name) - len(suffix)..len(name)], suffix) {
                            let sub = child(heap, path, name);
                            borrow sub as &s in {
                                if !is_directory(fs, buffer.bytes(s)) {
                                    out = add(heap, out, buffer.bytes(s));
                                }
                            }
                            buffer.drop(heap, sub);
                        }
                        k = k + 1;
                    }
                }
                dirs.drop(heap, names);
            }
            dir_close(dir);
        }
    }
    return out;
}

// The `.cho` files directly in the directory at `path` (see `direct_with`).
pub fn direct[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], found: buffer.Buffer) -> [heap, fs_read(""), dir_read] buffer.Buffer {
    return direct_with(heap, fs, path, found, ".cho");
}

// The names of the directories directly in the directory at `path` (a link to one is one; a name that starts with a dot is one too), each followed by a NUL, added to `found`, in the
// order the system lists them.
pub fn subdirectories[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], found: buffer.Buffer) -> [heap, fs_read(""), dir_read] buffer.Buffer {
    var out = found;
    if dotdot(path) {
        return out;
    }
    match open_dir(fs, path) {
        DirOpened::Failed(reason) => {
            return out;
        }
        DirOpened::Ok(opened) => {
            var dir = opened;
            borrow dir as &d in {
                let names = dirs.list(heap, d, 1000000);
                borrow names as &n in {
                    var k = 0;
                    while k < dirs.count(n) {
                        let name = dirs.name(n, k);
                        let sub = child(heap, path, name);
                        borrow sub as &s in {
                            if is_directory(fs, buffer.bytes(s)) {
                                out = buffer.push(heap, buffer.append(heap, out, name), byte_of(0));
                            }
                        }
                        buffer.drop(heap, sub);
                        k = k + 1;
                    }
                }
                dirs.drop(heap, names);
            }
            dir_close(dir);
        }
    }
    return out;
}

// The `.cho` files beneath the directory at `path`, as `vcs sync` walks them (`vcs_sync.rs`, `collect_cho`): every name, a name that starts with a dot too, but not a link (to a file or to a
// directory) and not a directory called `.cancho`, `.git` or `target`; a file called `.cho` has no extension, so it is none. Within each directory in bytewise order of name, which is the order
// a sorted list of paths has (a path is ordered by its components), added to `found`.
pub fn tree[&h, &f, &p](heap: &!h Heap, fs: &f Fs(""), path: &p [byte], found: buffer.Buffer) -> [heap, fs_read(""), dir_read] buffer.Buffer {
    var out = found;
    if dotdot(path) {
        return out;
    }
    match open_dir(fs, path) {
        DirOpened::Failed(reason) => {
            return out;
        }
        DirOpened::Ok(opened) => {
            var dir = opened;
            borrow dir as &d in {
                let names = dirs.list(heap, d, 1000000);
                borrow names as &n in {
                    var k = 0;
                    while k < dirs.count(n) {
                        let name = dirs.name(n, k);
                        let kind = dirs.kind(n, k);
                        if kind == dirs.kind_directory() {
                            if !bytes.equal(name, ".cancho") && !bytes.equal(name, ".git") && !bytes.equal(name, "target") {
                                let sub = child(heap, path, name);
                                borrow sub as &s in {
                                    out = tree(heap, fs, buffer.bytes(s), out);
                                }
                                buffer.drop(heap, sub);
                            }
                        } else if kind != dirs.kind_link() && len(name) > 4 && is_cho(name) {
                            let sub = child(heap, path, name);
                            borrow sub as &s in {
                                out = add(heap, out, buffer.bytes(s));
                            }
                            buffer.drop(heap, sub);
                        }
                        k = k + 1;
                    }
                }
                dirs.drop(heap, names);
            }
            dir_close(dir);
        }
    }
    return out;
}
