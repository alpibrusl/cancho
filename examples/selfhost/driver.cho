module selfhost.driver;

// driver.cho -- reading a source file, running the front end over it, and printing the answer.
//
// The programs of `examples/selfhost` that read a program on standard input differ only in what
// they print once it is parsed, and in whether the input is one file or several, so the
// reading, the allocation and the refusal of the parser are written once, here, and each
// program's `main` says which it wants:
//
//     mode 0   the syntax tree as a listing (`listing.cho`)
//     mode 1   the checker's answer (`checker.cho`): `OK`, or the first refusal
//     mode 2   as mode 1 for the declarations, and then, if they are well formed, one line for
//              each function: `fn <start> <end>` and `OK`, a refusal, or `SKIP` (`body.cho`)
//     mode 3   the program as LLVM IR text (`emit.cho`), for `clang`; a function the checker
//              refuses, or has not yet a way to write, is the one line `ERR rule-tag start end`
//
// One file is the whole of standard input. Several files are a stream, each as a line
// `FILE <length>` and then that many bytes, in the order the compiler parses them (the files
// named on its command line, then the library): the program is then the files laid end to end
// with one byte between them, as the Rust `SourceMap` lays them out, so a span is an offset
// into the whole. Either way a refusal of the parser is the one line `ERR rule-tag start end`.

import std.io as console;
import std.buffer;
import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.rules;
import selfhost.listing;
import selfhost.checker;
import selfhost.body;
import selfhost.emit;
import selfhost.instances;
import selfhost.pass1;
import selfhost.runtime;
import selfhost.kinds;

fn refusal[&i, &s](io: &!i Io, st: &!s [int]) -> [io_write] int {
    console.write_all(io, "ERR ");
    console.write_all(io, rules.rule_tag(st[3]));
    console.space(io);
    console.print_nat(io, st[4]);
    console.space(io);
    console.print_nat(io, st[5]);
    console.newline(io);
    return 1;
}

// One line a function: where it is, and what the checker makes of its body.
fn bodies[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte]) -> [io_write] int {
    var item = st[15];
    while item >= 0 {
        if ast.is_kind(st, item, kinds.NK::IFn) {
            let from = ast.nstart(st, item);
            let to = ast.nend(st, item);
            let status = body.check_function(st, text, item);
            if emit.on(st) {
                // Only whether the code can be written, not the code itself.
                st[44] = 0;
            }
            console.write_all(io, "fn ");
            console.print_nat(io, from);
            console.space(io);
            console.print_nat(io, to);
            console.space(io);
            if status == 0 {
                console.write_all(io, "OK");
            } else if status == 2 {
                console.write_all(io, "SKIP");
                if emit.on(st) {
                    // The census (mode 4) says where the construct is that the code is not written for.
                    console.space(io);
                    console.print_nat(io, st[4]);
                    console.space(io);
                    console.print_nat(io, st[5]);
                }
            } else {
                console.write_all(io, "ERR ");
                console.write_all(io, rules.rule_tag(st[3]));
                console.space(io);
                console.print_nat(io, st[4]);
                console.space(io);
                console.print_nat(io, st[5]);
            }
            console.newline(io);
        }
        item = ast.next(st, item);
    }
    return 0;
}

// A call to the initialiser of every `static`, in the order the items come, in the module being written.
fn init_calls[&s](st: &!s [int]) -> [] int {
    var item = st[15];
    while item >= 0 {
        if ast.is_kind(st, item, kinds.NK::IStatic) {
            emit.str(st, "  call void @sinit");
            emit.nat(st, item);
            emit.str(st, "()\n");
        }
        item = ast.next(st, item);
    }
    return 0;
}

// The `main` of the C program: it keeps argc and argv for `arg_count` and `arg`, runs every static's
// initialiser, calls the program's entry (the node `entry_item`) and answers its result as the status.
fn shim[&s](st: &!s [int], entry_item: int) -> [] int {
    emit.str(st, "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n");
    emit.str(st, "  %count = sext i32 %argc to i64\n  store i64 %count, ptr @cancho_argc\n  store ptr %argv, ptr @cancho_argv\n");
    init_calls(st);
    emit.str(st, "  %r = call i64 @lexs_");
    emit.nat(st, entry_item);
    emit.str(st, "()\n  %status = trunc i64 %r to i32\n  ret i32 %status\n}\n");
    return 0;
}

// Mode 3 and the builder: every function is checked, and written as it is; then the rest of the module
// is written after them, in the state's buffers: the declarations of what the code calls, the runtime, and
// the C `main` that calls the program's `main` (or, failing that, a function called `run`). 0, or 1 for a
// refusal (`st[3]` to `st[5]`).
fn build_module[&s, &x](st: &!s [int], text: &x [byte]) -> [] int {
    emit.aim(st, 0);
    emit.str(st, "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)\n");
    emit.str(st, "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)\n");
    emit.str(st, "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)\n");
    emit.str(st, "declare void @llvm.trap()\n");
    emit.str(st, "declare i32 @putchar(i32)\n");
    emit.str(st, "declare ptr @malloc(i64)\ndeclare void @free(ptr)\n");
    emit.str(st, "declare ptr @memmove(ptr, ptr, i64)\ndeclare ptr @memchr(ptr, i32, i64)\n");
    emit.str(st, "declare double @llvm.sqrt.f64(double)\ndeclare float @llvm.sqrt.f32(float)\n");
    emit.str(st, "declare i32 @getchar()\ndeclare i64 @write(i32, ptr, i64)\n\n");
    emit.str(st, runtime.errno_location(st[61] != 0));
    emit.str(st, runtime.text());
    emit.str(st, "define i64 @cancho_write_bytes(ptr %p, i64 %n) {\nentry:\n  br label %head\nhead:\n");
    emit.str(st, "  %i = phi i64 [ 0, %entry ], [ %next, %body ]\n  %more = icmp slt i64 %i, %n\n  br i1 %more, label %body, label %done\n");
    emit.str(st, "body:\n  %addr = getelementptr i8, ptr %p, i64 %i\n  %b = load i8, ptr %addr\n  %c = zext i8 %b to i32\n");
    emit.str(st, "  %r = call i32 @putchar(i32 %c)\n  %next = add i64 %i, 1\n  br label %head\ndone:\n  ret i64 %n\n}\n\n");
    emit.str(st, "define ptr @cancho_arena_alloc(ptr %head, i64 %bytes) {\nentry:\n  %size = add i64 %bytes, 16\n  %node = call ptr @malloc(i64 %size)\n");
    emit.str(st, "  %none = icmp eq ptr %node, null\n  br i1 %none, label %fail, label %ok\nfail:\n  call void @llvm.trap()\n  unreachable\nok:\n");
    emit.str(st, "  %old = load ptr, ptr %head\n  store ptr %old, ptr %node\n  store ptr %node, ptr %head\n  %data = getelementptr i8, ptr %node, i64 16\n  ret ptr %data\n}\n\n");
    emit.str(st, "define void @cancho_arena_free(ptr %first) {\nentry:\n  br label %loop\nloop:\n  %node = phi ptr [ %first, %entry ], [ %next, %body ]\n");
    emit.str(st, "  %done = icmp eq ptr %node, null\n  br i1 %done, label %out, label %body\nbody:\n  %next = load ptr, ptr %node\n  call void @free(ptr %node)\n  br label %loop\nout:\n  ret void\n}\n\n");
    var item = st[15];
    var entry = 0;
    var entry_item = 0 - 1;
    // What the code is not written for is left out; a call to it then does not link, which is how a
    // program learns of it. Its place is said in a comment of the module.
    var left_out = 0;
    while item >= 0 {
        if ast.is_kind(st, item, kinds.NK::IStatic) {
            let mark = st[44];
            let status = body.check_static(st, text, item);
            if status == 1 {
                return 1;
            }
            if status == 2 {
                st[44] = mark;
                emit.static_stub(st, item);
                left_out = left_out + 1;
            }
        }
        if ast.is_kind(st, item, kinds.NK::IFn) {
            let mark = st[44];
            let status = body.check_function(st, text, item);
            if status == 1 {
                return 1;
            }
            if status == 2 {
                st[44] = mark;
                left_out = left_out + 1;
            } else if pass1.is_word(st, text, ast.get(st, item, 4), "main") {
                entry = 2;
                entry_item = item;
            } else if entry == 0 && pass1.is_word(st, text, ast.get(st, item, 4), "run") {
                entry = 1;
                entry_item = item;
            }
        }
        item = ast.next(st, item);
    }
    // The generic functions called, each at the types it was asked for; a call from one can ask for more.
    var instance = 0;
    while instance < instances.count(st) {
        let mark = st[44];
        instances.begin(st, instance);
        let status = body.check_function(st, text, instances.item_of(st, instance));
        instances.end(st);
        if status == 1 {
            return 1;
        }
        if status == 2 {
            st[44] = mark;
            left_out = left_out + 1;
            emit.aim(st, 0);
            emit.str(st, "; instance ");
            emit.nat(st, instance);
            emit.str(st, " left out at ");
            emit.nat(st, st[4]);
            emit.str(st, " ");
            emit.nat(st, st[5]);
            emit.str(st, "\n");
        }
        instance = instance + 1;
    }
    emit.aim(st, 0);
    if entry != 0 {
        shim(st, entry_item);
    }
    emit.str(st, "; left out: ");
    emit.nat(st, left_out);
    emit.str(st, "\n");
    if emit.overflowed(st) {
        // The code outgrew its room: what was written is not to be trusted.
        ast.fail(st, rules.r_skip(), 0, 0);
        return 1;
    }
    return 0;
}

// The module as bytes in a buffer: the string literals, a newline, then the rest.
fn module_bytes[&h, &s](heap: &!h Heap, st: &!s [int]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, st[57] + st[44] + 16);
    var at = 0;
    while at < st[57] {
        out = buffer.push(heap, out, byte_of(st[st[56] + at]));
        at = at + 1;
    }
    out = buffer.push(heap, out, byte_of(10));
    at = 0;
    while at < st[44] {
        out = buffer.push(heap, out, byte_of(st[st[43] + at]));
        at = at + 1;
    }
    return out;
}

// The module as it was written: the string literals, then the rest.
fn print_module[&i, &s](io: &!i Io, st: &!s [int]) -> [io_write] int {
    var at = 0;
    while at < st[57] {
        putchar(io, st[st[56] + at]);
        at = at + 1;
    }
    console.newline(io);
    at = 0;
    while at < st[44] {
        putchar(io, st[st[43] + at]);
        at = at + 1;
    }
    return 0;
}

// Mode 3: the module on the standard output.
fn compile[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte]) -> [io_write] int {
    if build_module(st, text) != 0 {
        return refusal(io, st);
    }
    print_module(io, st);
    return 0;
}

fn answer[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], mode: int) -> [io_write] int {
    if mode == 5 {
        // The build keeps what it finds and prints nothing.
        if ast.parse(st, text) != 0 || checker.check(st, text) != 0 {
            return 1;
        }
        return build_module(st, text);
    }
    if ast.parse(st, text) != 0 {
        return refusal(io, st);
    }
    if mode == 0 {
        listing.dump(io, st, text);
        return 0;
    }
    if checker.check(st, text) == 0 {
        if mode == 1 {
            console.write_all(io, "OK");
            console.newline(io);
            return 0;
        }
        if mode == 3 {
            return compile(io, st, text);
        }
        return bodies(io, st, text);
    }
    return refusal(io, st);
}

// The length of the file whose header `FILE <length>` starts at `at`, or -1 if there is none.
fn header_length[&r](raw: &r [byte], at: int) -> [] int {
    if !lc.spells(raw, at, at + 5, "FILE ") {
        return 0 - 1;
    }
    var j = at + 5;
    var n = 0;
    while lc.is_digit(lc.at(raw, j)) {
        n = n * 10 + (lc.at(raw, j) - '0');
        j = j + 1;
    }
    if lc.at(raw, j) != '\n' {
        return 0 - 1;
    }
    return n;
}

// Where the file of the header at `at` starts: after the line.
fn header_end[&r](raw: &r [byte], at: int) -> [] int {
    var j = at;
    while lc.at(raw, j) != '\n' {
        j = j + 1;
    }
    return j + 1;
}

// One file: the whole of the input.
fn run_one[&h, &i, &x](heap: &!h Heap, io: &!i Io, text: &x [byte], mode: int, target: int) -> [heap, io_write] int {
    var status = 0;
    let tokens = ast.count_tokens(text);
    var size = ast.size_for(tokens, 1);
    if mode == 3 {
        size = size + ast.emit_size(tokens);
    }
    let state = box_slice(heap, size, 0);
    borrow mut state as &!b in {
        let st = contents(b);
        if mode == 3 {
            ast.layout_emit(st, tokens, 1);
            st[61] = target;
        } else {
            ast.layout(st, tokens, 1);
        }
        ast.set_file(st, 0, 0, len(text));
        status = answer(io, st, text, mode);
    }
    unbox_slice(heap, state);
    return status;
}

// A build whose module is not wanted: its status.
pub fn discard[&h](heap: &!h Heap, built: Built) -> [heap] int {
    let Built { ir, status, rule, from, to } = built;
    buffer.drop(heap, ir);
    return status;
}

// What a build (mode 5) comes to: the module as bytes, or the first refusal (the rule and where), and the status.
pub res struct Built {
    ir: buffer.Buffer,
    status: int,
    rule: int,
    from: int,
    to: int,
}

// A stream of files: laid end to end, one byte between them, and parsed in order. Mode 5 is the build: the
// module is kept as bytes, for a program to write to a file, and nothing is printed.
pub fn run_many[&h, &i, &x](heap: &!h Heap, io: &!i Io, raw: &x [byte], mode: int, target: int) -> [heap, io_write] Built {
    var files = 0;
    var total = 0;
    var at = 0;
    while at < len(raw) && header_length(raw, at) >= 0 {
        let n = header_length(raw, at);
        at = header_end(raw, at) + n;
        total = total + n + 1;
        files = files + 1;
    }
    var laid = buffer.empty(heap, total + 16);
    at = 0;
    var left = files;
    while left > 0 {
        let n = header_length(raw, at);
        let start = header_end(raw, at);
        laid = buffer.append(heap, laid, raw[start..start + n]);
        laid = buffer.push(heap, laid, byte_of(0));
        at = start + n;
        left = left - 1;
    }
    var status = 0;
    var written = buffer.empty(heap, 0);
    var rule = 0;
    var from = 0;
    var to = 0;
    borrow laid as &t in {
        let text = buffer.bytes(t);
        var tokens = 0;
        var base = 0;
        var f = 0;
        at = 0;
        while f < files {
            let n = header_length(raw, at);
            tokens = tokens + ast.count_tokens(text[base..base + n]);
            base = base + n + 1;
            at = header_end(raw, at) + n;
            f = f + 1;
        }
        var size = ast.size_for(tokens, files);
        if mode >= 3 {
            size = size + ast.emit_size(tokens);
        }
        let state = box_slice(heap, size, 0);
        borrow mut state as &!b in {
            let st = contents(b);
            if mode >= 3 {
                ast.layout_emit(st, tokens, files);
                st[61] = target;
            } else {
                ast.layout(st, tokens, files);
            }
            base = 0;
            f = 0;
            at = 0;
            while f < files {
                let n = header_length(raw, at);
                ast.set_file(st, f, base, n);
                base = base + n + 1;
                at = header_end(raw, at) + n;
                f = f + 1;
            }
            status = answer(io, st, text, mode);
            if mode == 5 {
                if status == 0 {
                    buffer.drop(heap, written);
                    written = module_bytes(heap, st);
                } else {
                    rule = st[3];
                    from = st[4];
                    to = st[5];
                }
            }
        }
        unbox_slice(heap, state);
    }
    buffer.drop(heap, laid);
    return Built { ir: written, status: status, rule: rule, from: from, to: to };
}

// A line `TARGET darwin` or `TARGET linux` in front of the input says what the code is for (which libc names
// differ): 1 for darwin, 0 for linux, and 0 if there is no such line.
pub fn target_of[&r](raw: &r [byte]) -> [] int {
    if len(raw) >= 14 && lc.spells(raw, 0, 14, "TARGET darwin\n") {
        return 1;
    }
    return 0;
}

// How many bytes of the input the line took.
pub fn target_skip[&r](raw: &r [byte]) -> [] int {
    if len(raw) >= 14 && lc.spells(raw, 0, 14, "TARGET darwin\n") {
        return 14;
    }
    if len(raw) >= 13 && lc.spells(raw, 0, 13, "TARGET linux\n") {
        return 13;
    }
    return 0;
}

// Read standard input, parse it, and print the answer for `mode`; `many` says that the input is
// a stream of files. The exit status is 1 for a refusal.
pub fn drive(world: World, mode: int, many: bool) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(ffi);
    release(fs);
    release(args);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            let raw = lc.slurp(h, i);
            borrow raw as &r in {
                let all = buffer.bytes(r);
                let rest = all[target_skip(all)..len(all)];
                if many {
                    status = discard(h, run_many(h, i, rest, mode, target_of(all)));
                } else {
                    status = run_one(h, i, rest, mode, target_of(all));
                }
            }
            buffer.drop(h, raw);
        }
    }
    release(heap);
    release(io);
    return status;
}
