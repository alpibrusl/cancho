module selfhost.driver;

// driver.cho -- reading a source file, running the front end over it, and printing the answer.
//
// The programs of `examples/selfhost` that read a program on standard input differ only in what
// they print once it is parsed, and in whether the input is one file or several, so the
// reading, the allocation and the refusal of the parser are written once, here, and each
// program's `main` says which it wants:
//
//     mode 0   the syntax tree as a listing (`listing.cho`)
//     mode 1   the checker's answer (`checker.cho`): `OK`, or the first refusal
//     mode 2   as mode 1 for the declarations, and then, if they are well formed, one line for
//              each function: `fn <start> <end>` and `OK`, a refusal, or `SKIP` (`body.cho`)
//     mode 4   the parsed program as the canonical text (`printing.cho`)
//     mode 9   the identity of every declaration of the program (`identity.cho`), for a stream of files
//     mode 8   JSON as the canonical text of the program it stands for (`ingest.cho`)
//     mode 7   the parsed program as data, JSON (`jsonprint.cho`)
//     mode 6   the formatted text of a file, from the file and its canonical text (`formatting.cho`): two files in a stream
//     mode 3   the program as LLVM IR text (`emit.cho`), for `clang`; a function the checker
//              refuses, or has not yet a way to write, is the one line `ERR rule-tag start end`
//
// One file is the whole of standard input. Several files are a stream, each as a line
// `FILE <length>` and then that many bytes, in the order the compiler parses them (the files
// named on its command line, then the library): the program is then the files laid end to end
// with one byte between them, as the Rust `SourceMap` lays them out, so a span is an offset
// into the whole. Either way a refusal of the parser is the one line `ERR rule-tag start end`.

import std.io as console;
import std.buffer;
import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.rules;
import selfhost.listing;
import selfhost.checker;
import selfhost.body;
import selfhost.emit;
import selfhost.scope;
import selfhost.externcode;
import selfhost.platform;
import selfhost.instances;
import selfhost.pass1;
import selfhost.runtime;
import selfhost.kinds;
import selfhost.printing;
import selfhost.formatting;
import selfhost.jsonprint;
import selfhost.jsonread;
import selfhost.ingest;
import selfhost.identity;
import selfhost.prune;
import selfhost.testscan;
import selfhost.layoutrep;
import selfhost.authority;

// The line `ERR rule-tag start end`.
fn err_line[&i](io: &!i Io, rule: int, from: int, to: int) -> [io_write] int {
    console.write_all(io, "ERR ");
    console.write_all(io, rules.rule_tag(rule));
    console.space(io);
    console.print_nat(io, from);
    console.space(io);
    console.print_nat(io, to);
    console.newline(io);
    return 1;
}

fn refusal_line[&i, &s](io: &!i Io, st: &!s [int]) -> [io_write] int {
    return err_line(io, st[3], st[4], st[5]);
}

fn refusal[&i, &s](io: &!i Io, st: &!s [int]) -> [io_write] int {
    refusal_line(io, st);
    if emit.on(st) && st[3] != rules.r_skip() {
        // The code is being written, so a person is reading: say why, on a line of its own.
        console.write_all(io, rules.sentence(rules.rule_tag(st[3])));
        console.newline(io);
    }
    return 1;
}

// One line a function: where it is, and what the checker makes of its body.
fn bodies[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte]) -> [io_write] int {
    var item = st[15];
    while item >= 0 {
        if ast.is_kind(st, item, kinds.NK::IFn) {
            let from = ast.nstart(st, item);
            let to = ast.nend(st, item);
            let status = body.check_function(st, text, item);
            if emit.on(st) {
                // Only whether the code can be written, not the code itself.
                st[44] = 0;
            }
            console.write_all(io, "fn ");
            console.print_nat(io, from);
            console.space(io);
            console.print_nat(io, to);
            console.space(io);
            if status == 0 {
                console.write_all(io, "OK");
            } else if status == 2 {
                console.write_all(io, "SKIP");
                if emit.on(st) {
                    // The census (mode 4) says where the construct is that the code is not written for.
                    console.space(io);
                    console.print_nat(io, st[4]);
                    console.space(io);
                    console.print_nat(io, st[5]);
                }
            } else {
                console.write_all(io, "ERR ");
                console.write_all(io, rules.rule_tag(st[3]));
                console.space(io);
                console.print_nat(io, st[4]);
                console.space(io);
                console.print_nat(io, st[5]);
            }
            console.newline(io);
        }
        item = ast.next(st, item);
    }
    return 0;
}

// A call to the initialiser of every `static`, in the order the items come, in the module being written.
fn init_calls[&s](st: &!s [int]) -> [] int {
    var item = st[15];
    while item >= 0 {
        if ast.is_kind(st, item, kinds.NK::IStatic) {
            emit.str(st, "  call void @sinit");
            emit.nat(st, item);
            emit.str(st, "()\n");
        }
        item = ast.next(st, item);
    }
    return 0;
}

// The `main` of the C program: it keeps argc and argv for `arg_count` and `arg`, runs every static's
// initialiser, calls the program's entry (the node `entry_item`) and answers its result as the status.
fn shim[&s](st: &!s [int], entry_item: int) -> [] int {
    emit.str(st, "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n");
    emit.str(st, "  %count = sext i32 %argc to i64\n  store i64 %count, ptr @cancho_argc\n  store ptr %argv, ptr @cancho_argv\n");
    if st[55] & 32 != 0 {
        // The key of the stack of chunks a thread keeps for its regions.
        emit.str(st, "  call void @cancho_region_init()\n");
    }
    init_calls(st);
    emit.str(st, "  %r = call i64 @lexs_");
    emit.nat(st, entry_item);
    emit.str(st, "()\n  %status = trunc i64 %r to i32\n  ret i32 %status\n}\n");
    return 0;
}

// Mode 3 and the builder: every function is checked, and written as it is; then the rest of the module
// is written after them, in the state's buffers: the declarations of what the code calls, the runtime, and
// the C `main` that calls the program's `main` (or, failing that, a function called `run` of the root module: one of a module of the library is not an entry). 0, or 1 for a
// refusal (`st[3]` to `st[5]`).
// Does the module's own preamble already declare the C function this declaration names? The lines of the
// runtime that start with `declare` are read for the name between `@` and `(`; the few the driver declares
// itself are listed.
fn runtime_declares[&s, &x](st: &!s [int], text: &x [byte], item: int) -> [] bool {
    let name = ast.get(st, item, 4);
    if pass1.is_word(st, text, name, "putchar") || pass1.is_word(st, text, name, "malloc") || pass1.is_word(st, text, name, "calloc") || pass1.is_word(st, text, name, "free") || pass1.is_word(st, text, name, "memmove") || pass1.is_word(st, text, name, "memchr") || pass1.is_word(st, text, name, "getchar") || pass1.is_word(st, text, name, "write") {
        return true;
    }
    return preamble_declares(st, text, name, runtime.text()) || st[55] & 1 != 0 && preamble_declares(st, text, name, runtime.net_text(st[61] == 1)) || st[55] & 2 != 0 && preamble_declares(st, text, name, runtime.dirs_text(st[61] == 1));
}

// Does a line of this preamble that starts with `declare` name the function `name`?
fn preamble_declares[&s, &x](st: &!s [int], text: &x [byte], name: int, preamble: &static [byte]) -> [] bool {
    var i = 0;
    while i + 8 < len(preamble) {
        if i == 0 || int_of(preamble[i - 1]) == 10 {
            if int_of(preamble[i]) == 'd' && int_of(preamble[i + 1]) == 'e' && int_of(preamble[i + 2]) == 'c' && int_of(preamble[i + 3]) == 'l' {
                var at = i;
                while at < len(preamble) && int_of(preamble[at]) != '@' && int_of(preamble[at]) != 10 {
                    at = at + 1;
                }
                if at < len(preamble) && int_of(preamble[at]) == '@' {
                    var end = at + 1;
                    while end < len(preamble) && int_of(preamble[end]) != '(' {
                        end = end + 1;
                    }
                    if end - at - 1 == ast.tend(st, name) - ast.tstart(st, name) {
                        var same = true;
                        var k = 0;
                        while k < end - at - 1 {
                            if int_of(preamble[at + 1 + k]) != int_of(text[ast.tstart(st, name) + k]) {
                                same = false;
                            }
                            k = k + 1;
                        }
                        if same {
                            return true;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return false;
}

// Is there a foreign declaration of the same symbol before this one?
fn declared_before[&s, &x](st: &!s [int], text: &x [byte], item: int) -> [] bool {
    var other = st[15];
    while other != item {
        if ast.is_kind(st, other, kinds.NK::IExtern) && ast.same(st, text, ast.get(st, other, 4), ast.get(st, item, 4)) {
            return true;
        }
        other = ast.next(st, other);
    }
    return false;
}

// A comment in the module saying which function (or which instance of a generic one) was not written, and the
// first construct it stopped at, as a span of the input.
fn note_left_out[&s](st: &!s [int], item: int, instance: int) -> [] int {
    emit.aim(st, 0);
    emit.str(st, "; left out @lexs_");
    emit.nat(st, item);
    emit.instance_suffix(st, instance + 1);
    emit.str(st, " at ");
    emit.nat(st, st[4]);
    emit.str(st, " ");
    emit.nat(st, st[5]);
    emit.str(st, "\n");
    return 0;
}

fn out_byte[&s](st: &!s [int], at: int) -> [] int {
    return st[st[43] + at];
}

fn out_spells[&s](st: &!s [int], at: int, word: &static [byte]) -> [] bool {
    var k = 0;
    while k < len(word) {
        if at + k >= st[44] || out_byte(st, at + k) != int_of(word[k]) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

fn out_word_char[&s](st: &!s [int], at: int) -> [] bool {
    if at >= st[44] {
        return false;
    }
    let c = out_byte(st, at);
    return c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_';
}

// Is the symbol written at `sym` (up to its end `stop`) named anywhere else in the module?
fn symbol_used[&s](st: &!s [int], sym: int, stop: int) -> [] bool {
    var at = 0;
    while at < st[44] {
        if at != sym && out_byte(st, at) == '@' && out_spells(st, at, "@lexs_") {
            var k = 0;
            while sym + k < stop && out_byte(st, at + k) == out_byte(st, sym + k) {
                k = k + 1;
            }
            if sym + k == stop && !out_word_char(st, at + k) {
                return true;
            }
        }
        at = at + 1;
    }
    return false;
}

// A function left out that the module still names, a call to it that would not link: the span of its first
// construct that was not written, or a negative number if there is none.
fn left_out_reached[&s](st: &!s [int]) -> [] int {
    var at = 0;
    while at < st[44] {
        if out_byte(st, at) == ';' && out_spells(st, at, "; left out @lexs_") {
            let sym = at + 11;
            var stop = sym;
            while out_word_char(st, stop) || out_byte(st, stop) == '@' {
                stop = stop + 1;
            }
            var from = 0;
            var to = 0;
            var p = stop + 4;
            while out_word_char(st, p) {
                from = from * 10 + out_byte(st, p) - '0';
                p = p + 1;
            }
            p = p + 1;
            while out_word_char(st, p) {
                to = to * 10 + out_byte(st, p) - '0';
                p = p + 1;
            }
            if symbol_used(st, sym, stop) {
                st[4] = from;
                st[5] = to;
                return 0;
            }
        }
        at = at + 1;
    }
    return 0 - 1;
}

// The function checked and written. One with a variable whose type comes from what follows it is gone over twice: once
// to learn the types of such variables, and then for the code.
fn check_learning[&s, &x](st: &!s [int], text: &x [byte], item: int) -> [] int {
    instances.infer(st, 0);
    let mark = st[44];
    let status = body.check_function(st, text, item);
    if status != 2 || !instances.wants_inference(st) {
        return status;
    }
    instances.infer(st, 1);
    st[44] = mark;
    let learned = body.check_function(st, text, item);
    instances.infer(st, 0);
    st[44] = mark;
    if learned != 0 {
        return 2;
    }
    instances.settle(st);
    return body.check_function(st, text, item);
}

fn build_module[&s, &x](st: &!s [int], text: &x [byte]) -> [] int {
    emit.aim(st, 0);
    emit.str(st, "declare {i64, i1} @llvm.sadd.with.overflow.i64(i64, i64)\n");
    emit.str(st, "declare {i64, i1} @llvm.ssub.with.overflow.i64(i64, i64)\n");
    emit.str(st, "declare {i64, i1} @llvm.smul.with.overflow.i64(i64, i64)\n");
    emit.str(st, "declare void @llvm.trap()\n");
    // Every trap is one instruction on each target, as the Rust backend writes it, so that a program stops with the same
    // signal (SIGILL) whichever compiler built it: `llvm.trap` is `brk` on arm64, which is SIGTRAP.
    emit.str(st, "define void @cancho_trap() noreturn {\nentry:\n  call void asm sideeffect \"");
    if st[61] == 0 {
        emit.str(st, "ud2");
    } else {
        emit.str(st, "udf #0xc11f");
    }
    emit.str(st, "\", \"\"()\n  unreachable\n}\n");
    emit.str(st, "declare i32 @putchar(i32)\n");
    emit.str(st, "declare ptr @malloc(i64)\ndeclare ptr @calloc(i64, i64)\ndeclare void @free(ptr)\n");
    emit.str(st, "declare ptr @memmove(ptr, ptr, i64)\ndeclare ptr @memchr(ptr, i32, i64)\n");
    emit.str(st, "declare i32 @pthread_create(ptr, ptr, ptr, ptr)\ndeclare i32 @pthread_join(ptr, ptr)\n");
    emit.str(st, "declare double @llvm.sqrt.f64(double)\ndeclare float @llvm.sqrt.f32(float)\n");
    emit.str(st, "declare i32 @getchar()\ndeclare i64 @write(i32, ptr, i64)\n\n");
    emit.str(st, runtime.errno_location(st[61] == 1));
    emit.str(st, runtime.text());
    // An arena is one chunk of 64 KiB, all of it the region's (how much is used is kept beside the chunk, as the Rust backend's bump pointer), taken from the thread's
    // stack of chunks (`region_text`) and given back to it whole; a request past the chunk traps, as the Rust compiler's
    // does.
    emit.str(st, "@cancho_region_msg = private constant [130 x i8] c\"cancho: trap: region chunk exhausted: a region holds 65536 bytes in all; allocate big data on the heap with box_slice (AGENTS.md)\\0A\"\n");
    emit.str(st, "define ptr @cancho_arena_alloc(ptr %head, i64 %bytes) {\nentry:\n  %chunk = load ptr, ptr %head\n  %usedp = getelementptr i8, ptr %head, i64 8\n  %used = load i64, ptr %usedp\n");
    emit.str(st, "  %up = add i64 %bytes, 7\n  %rounded = and i64 %up, -8\n  %next = add i64 %used, %rounded\n");
    emit.str(st, "  %wrapped = icmp ult i64 %next, %used\n  %over = icmp ugt i64 %next, 65536\n  %bad = or i1 %wrapped, %over\n");
    emit.str(st, "  br i1 %bad, label %fail, label %ok\nfail:\n  %said = call i64 @write(i32 2, ptr @cancho_region_msg, i64 130)\n  call void @cancho_trap()\n  unreachable\nok:\n");
    emit.str(st, "  store i64 %next, ptr %usedp\n  %at = getelementptr i8, ptr %chunk, i64 %used\n  ret ptr %at\n}\n\n");
    var item = st[15];
    var entry = 0;
    var entry_item = 0 - 1;
    // What the code is not written for is left out; a call to it then does not link, which is how a
    // program learns of it. Its place is said in a comment of the module.
    var left_out = 0;
    var has_main = false;
    scope.shape_clear(st);
    while item >= 0 {
        if ast.is_kind(st, item, kinds.NK::IStatic) {
            let mark = st[44];
            let status = body.check_static(st, text, item);
            if status == 1 {
                return 1;
            }
            if status == 2 {
                st[44] = mark;
                emit.static_stub(st, item);
                left_out = left_out + 1;
            }
        }
        if ast.is_kind(st, item, kinds.NK::IFn) {
            let mark = st[44];
            if pass1.is_word(st, text, ast.get(st, item, 4), "main") {
                has_main = true;
            }
            let status = check_learning(st, text, item);
            if status == 1 {
                return 1;
            }
            if status == 2 {
                st[44] = mark;
                left_out = left_out + 1;
                note_left_out(st, item, 0 - 1);
                if pass1.is_word(st, text, ast.get(st, item, 4), "main") || entry == 0 && ast.get(st, item, 13) == 0 && pass1.is_word(st, text, ast.get(st, item, 4), "run") {
                    // The program starts there: it is reached.
                    emit.str(st, "; entry @lexs_");
                    emit.nat(st, item);
                    emit.str(st, "\n");
                }
            } else if pass1.is_word(st, text, ast.get(st, item, 4), "main") {
                entry = 2;
                entry_item = item;
            } else if entry == 0 && ast.get(st, item, 13) == 0 && pass1.is_word(st, text, ast.get(st, item, 4), "run") {
                entry = 1;
                entry_item = item;
            }
        }
        item = ast.next(st, item);
    }
    // The foreign functions, each symbol declared once; one the runtime already declares keeps that declaration,
    // for the call spells its own function type.
    emit.aim(st, 0);
    item = st[15];
    while item >= 0 {
        if ast.is_kind(st, item, kinds.NK::IExtern) && !runtime_declares(st, text, item) && !declared_before(st, text, item) {
            externcode.declare(st, text, item);
        }
        item = ast.next(st, item);
    }
    // The generic functions called, each at the types it was asked for; a call from one can ask for more.
    var instance = 0;
    while instance < instances.count(st) {
        if instances.item_of(st, instance) >= 0 {
            let mark = st[44];
            instances.begin(st, instance);
            let status = check_learning(st, text, instances.item_of(st, instance));
            instances.end(st);
            if status == 1 {
                return 1;
            }
            if status == 2 {
                st[44] = mark;
                left_out = left_out + 1;
                note_left_out(st, instances.item_of(st, instance), instance);
            }
        }
        instance = instance + 1;
    }
    if scope.shape_bad(st) {
        // The entry point is the one `main` of the whole program, taking the `World` and giving back the exit status.
        ast.fail(st, rules.r_program_shape(), 0, 0);
        return 1;
    }
    if !has_main && entry == 0 {
        // The same refusal, marked (`to` of 1, where a place would be) so that it is worded as the Rust command words it: "no `main` function".
        ast.fail(st, rules.r_program_shape(), 0, 1);
        return 1;
    }
    emit.aim(st, 0);
    if entry != 0 {
        shim(st, entry_item);
    }
    if st[55] & 4 != 0 {
        // A program that asks for the hardware AES has the functions for its target.
        emit.str(st, runtime.crypto_text(st[61]));
    }
    if st[55] & 2 != 0 {
        // A program that opens a directory has the support for them, and the constants of its target.
        emit.str(st, runtime.dirs_text(st[61] == 1));
        platform.print(st);
    }
    if st[55] & 64 != 0 {
        // A program that lets a child go has the thread that reaps it.
        emit.str(st, runtime.process_text());
    }
    if st[55] & 32 != 0 {
        // A program that opens a region has the stack of chunks its thread keeps for them.
        emit.str(st, runtime.region_text(st[61] == 1));
    }
    if st[55] & 16 != 0 {
        // A program that opens a serial port has the verbs for it.
        emit.str(st, runtime.tty_text(st[61] == 1));
    }
    if st[55] & 8 != 0 {
        // A program that claims signals has the support for them.
        emit.str(st, runtime.signals_text(st[61] == 1));
    }
    if st[55] & 1 != 0 {
        // A program that opens a socket or reads the clock has the support for them.
        emit.str(st, runtime.net_text(st[61] == 1));
    }
    // `write_bytes` is one `fwrite` to the C library's buffer, as the Rust backend's is: a write that fails sets the stream's
    // error indicator, which `flush_out` reports (`EIO`), and `putchar` writes to the same buffer, so the two stay in order.
    var stream = "@stdout";
    if st[61] == 1 {
        stream = "@__stdoutp";
    }
    if st[55] & 1 == 0 {
        emit.str(st, stream);
        emit.str(st, " = external global ptr, align 8\n");
    }
    emit.str(st, "define i64 @cancho_write_bytes(ptr %p, i64 %n) {\nentry:\n  %out = load ptr, ptr ");
    emit.str(st, stream);
    emit.str(st, ", align 8\n  %w = call i64 @fwrite(ptr %p, i64 1, i64 %n, ptr %out)\n  ret i64 %n\n}\n\n");
    emit.str(st, "; left out: ");
    emit.nat(st, left_out);
    emit.str(st, "\n");
    if left_out > 0 && left_out_reached(st) >= 0 {
        // A call to a function that was not written would not link: say so, at the construct that stopped it.
        st[2] = 0;
        ast.fail(st, rules.r_skip(), st[4], st[5]);
        return 1;
    }
    if emit.overflowed(st) {
        // The code outgrew its room: what was written is not to be trusted.
        ast.fail(st, rules.r_skip(), 0, 0);
        return 1;
    }
    return 0;
}

// The name the object file's symbol table gives the module: this, and not the name of the file the text was written to (which is the program's own, `out.ll`), so
// that the same sources built under two names are the same bytes. LLVM wants it before anything else.
fn module_name() -> [] &static [byte] {
    return "source_filename = \"cancho\"\n";
}

// The module as bytes in a buffer: its name, the string literals, a newline, then the rest.
fn module_bytes[&h, &s](heap: &!h Heap, st: &!s [int]) -> [heap] buffer.Buffer {
    var out = buffer.append(heap, buffer.empty(heap, st[57] + st[44] + 48), module_name());
    var at = 0;
    while at < st[57] {
        out = buffer.push(heap, out, byte_of(st[st[56] + at]));
        at = at + 1;
    }
    out = buffer.push(heap, out, byte_of(10));
    at = 0;
    while at < st[44] {
        out = buffer.push(heap, out, byte_of(st[st[43] + at]));
        at = at + 1;
    }
    return out;
}

// The module as it was written: its name, the string literals, then the rest.
fn print_module[&i, &s](io: &!i Io, st: &!s [int]) -> [io_write] int {
    console.write_all(io, module_name());
    var at = 0;
    while at < st[57] {
        putchar(io, st[st[56] + at]);
        at = at + 1;
    }
    console.newline(io);
    at = 0;
    while at < st[44] {
        putchar(io, st[st[43] + at]);
        at = at + 1;
    }
    return 0;
}

// Mode 3: the module on the standard output.
fn compile[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte]) -> [io_write] int {
    if build_module(st, text) != 0 {
        return refusal(io, st);
    }
    print_module(io, st);
    return 0;
}

// Mode 10: the program is checked as the build (`build_module`) checks it, and nothing is written or printed: 0, or 1 with the rule and the place in
// `st[3]`, `st[4]` and `st[5]`. What the code is not written for is let through, since it cannot be judged, and the program is not asked for a `main`, nor
// for the shape of one (`cancho ids` is not). (It was a loop of its own over the functions, which missed a refusal the build makes -- a binding that holds a
// reference into a block it outlives through a type that is still a hole -- and the build is what is run now.)
fn check_quiet[&s, &x](st: &!s [int], text: &x [byte]) -> [] int {
    if ast.parse(st, text) != 0 || checker.check(st, text) != 0 {
        return 1;
    }
    let status = build_module(st, text);
    if status != 0 && (st[3] == rules.r_program_shape() || st[3] == rules.r_skip()) {
        // Not asked for a `main`, nor to write what the code is not written for.
        st[2] = 0;
        return 0;
    }
    return status;
}

fn answer[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], mode: int) -> [io_write] int {
    if mode == 5 {
        // The build keeps what it finds and prints nothing.
        if ast.parse(st, text) != 0 || checker.check(st, text) != 0 {
            return 1;
        }
        return build_module(st, text);
    }
    if ast.parse(st, text) != 0 {
        if mode == 4 || mode == 7 {
            // The printer has the scratch of the code writer for its floats, which is what makes `refusal` explain: it does not.
            return refusal_line(io, st);
        }
        return refusal(io, st);
    }
    if mode == 0 {
        listing.dump(io, st, text);
        return 0;
    }
    if mode == 4 {
        // The canonical text of what was parsed (`printing.cho`); nothing is checked.
        return printing.print(io, st, text);
    }
    if mode == 7 {
        // The tree as data (`jsonprint.cho`); nothing is checked.
        return jsonprint.print(io, st, text);
    }
    if checker.check(st, text) == 0 {
        if mode == 1 {
            console.write_all(io, "OK");
            console.newline(io);
            return 0;
        }
        if mode == 3 {
            return compile(io, st, text);
        }
        return bodies(io, st, text);
    }
    return refusal(io, st);
}

// The length of the file whose header `FILE <length>` starts at `at`, or -1 if there is none.
fn header_length[&r](raw: &r [byte], at: int) -> [] int {
    if !lc.spells(raw, at, at + 5, "FILE ") {
        return 0 - 1;
    }
    var j = at + 5;
    var n = 0;
    while lc.is_digit(lc.at(raw, j)) {
        n = n * 10 + (lc.at(raw, j) - '0');
        j = j + 1;
    }
    if lc.at(raw, j) != '\n' {
        return 0 - 1;
    }
    return n;
}

// Where the file of the header at `at` starts: after the line.
fn header_end[&r](raw: &r [byte], at: int) -> [] int {
    var j = at;
    while lc.at(raw, j) != '\n' {
        j = j + 1;
    }
    return j + 1;
}

// One file: the whole of the input.
fn run_one[&h, &i, &x](heap: &!h Heap, io: &!i Io, text: &x [byte], mode: int, target: int) -> [heap, io_write] int {
    var status = 0;
    let tokens = ast.count_tokens(text);
    var size = ast.size_for(tokens, 1);
    if mode == 3 || mode == 4 || mode == 7 {
        size = size + ast.emit_size(tokens);
    }
    let state = box_slice(heap, size, 0);
    borrow mut state as &!b in {
        let st = contents(b);
        if mode == 3 || mode == 4 || mode == 7 {
            ast.layout_emit(st, tokens, 1);
            st[61] = target;
        } else {
            ast.layout(st, tokens, 1);
        }
        ast.set_file(st, 0, 0, len(text));
        status = answer(io, st, text, mode);
    }
    unbox_slice(heap, state);
    return status;
}

// A build whose module is not wanted: its status.
pub fn discard[&h](heap: &!h Heap, built: Built) -> [heap] int {
    let Built { ir, status, rule, from, to } = built;
    buffer.drop(heap, ir);
    return status;
}

// What a build (mode 5) comes to: the module as bytes, or the first refusal (the rule and where), and the status.
pub res struct Built {
    ir: buffer.Buffer,
    status: int,
    rule: int,
    from: int,
    to: int,
}

// Mode 9: the identity of every declaration of the parsed program (`identity.cho`), one line each. Nothing is checked.
fn identities[&h, &i, &s, &x](heap: &!h Heap, io: &!i Io, st: &!s [int], text: &x [byte], tokens: int) -> [heap, io_write] int {
    var items = 0;
    var at = st[15];
    while at >= 0 {
        items = items + 1;
        at = ast.next(st, at);
    }
    let area = box_slice(heap, identity.size_for(tokens, items), 0);
    var status = 0;
    borrow mut area as &!db in {
        let d = contents(db);
        identity.layout(d, tokens, items);
        status = identity.print(io, st, text, d);
    }
    unbox_slice(heap, area);
    return status;
}

// Mode 13: the functions of the parsed program with the identity of each signature, as `identity.listing` writes them (mode 14: `identity.pairs`, the signature and the body of each; mode 15: `identity.published`, with the name and the declared row); `st[63]` is 1 if a literal of the program
// is one whose bits are not worked out.
fn identity_list[&h, &s, &x](heap: &!h Heap, st: &!s [int], text: &x [byte], tokens: int, which: int) -> [heap] buffer.Buffer {
    var items = 0;
    var at = st[15];
    while at >= 0 {
        items = items + 1;
        at = ast.next(st, at);
    }
    let area = box_slice(heap, identity.size_for(tokens, items), 0);
    var out = buffer.empty(heap, 0);
    borrow mut area as &!db in {
        let d = contents(db);
        identity.layout(d, tokens, items);
        buffer.drop(heap, out);
        if which == 2 {
            out = identity.published(heap, st, text, d);
        } else if which == 1 {
            out = identity.pairs(heap, st, text, d);
        } else {
            out = identity.listing(heap, st, text, d);
        }
    }
    unbox_slice(heap, area);
    return out;
}

// Mode 11: what `testscan.cho` found. The tests are the answer, with their number in `st[5]`; or the status it refused with is `st[63]`, with
// `st[3]`, `st[4]` and `st[5]` as in any refusal, and the text that goes with the refusal is the answer.
fn scanned[&h, &s, &x](heap: &!h Heap, st: &!s [int], text: &x [byte]) -> [heap] buffer.Buffer {
    if ast.parse(st, text) != 0 {
        st[63] = 1;
        return buffer.empty(heap, 0);
    }
    let testscan.Scan { tests, count, status, why, at, named } = testscan.scan(heap, st, text);
    st[63] = status;
    st[3] = why;
    st[4] = at;
    st[5] = count;
    if status == 0 {
        buffer.drop(heap, named);
        return tests;
    }
    buffer.drop(heap, tests);
    return named;
}

// A stream of files: laid end to end, one byte between them, and parsed in order. Mode 5 is the build: the
// module is kept as bytes, for a program to write to a file, and nothing is printed.
pub fn run_many[&h, &i, &x](heap: &!h Heap, io: &!i Io, raw: &x [byte], mode: int, target: int) -> [heap, io_write] Built {
    var files = 0;
    var total = 0;
    var at = 0;
    while at < len(raw) && header_length(raw, at) >= 0 {
        let n = header_length(raw, at);
        at = header_end(raw, at) + n;
        total = total + n + 1;
        files = files + 1;
    }
    var laid = buffer.empty(heap, total + 16);
    at = 0;
    var left = files;
    while left > 0 {
        let n = header_length(raw, at);
        let start = header_end(raw, at);
        laid = buffer.append(heap, laid, raw[start..start + n]);
        laid = buffer.push(heap, laid, byte_of(0));
        at = start + n;
        left = left - 1;
    }
    var status = 0;
    var written = buffer.empty(heap, 0);
    var rule = 0;
    var from = 0;
    var to = 0;
    borrow laid as &t in {
        let text = buffer.bytes(t);
        var tokens = 0;
        var base = 0;
        var f = 0;
        at = 0;
        while f < files {
            let n = header_length(raw, at);
            tokens = tokens + ast.count_tokens(text[base..base + n]);
            base = base + n + 1;
            at = header_end(raw, at) + n;
            f = f + 1;
        }
        if mode >= 3 && mode != 9 && mode != 11 && mode != 13 && mode != 14 && mode != 15 && mode != 16 {
            // A string literal is one token and as many bytes, and its code is the bytes again, spelt out: the room the code is written in is
            // counted by the token, so it is raised by the length of the text.
            tokens = tokens + len(text) / 50;
        }
        var size = ast.size_for(tokens, files);
        if mode == 9 || mode == 13 || mode == 14 || mode == 15 || mode == 16 {
            // The identities only need the room the printer works floats out in.
            size = size + ast.const_region() + ast.inst_region();
        } else if mode >= 3 && mode != 11 {
            size = size + ast.emit_size(tokens);
        }
        let state = box_slice(heap, size, 0);
        borrow mut state as &!b in {
            let st = contents(b);
            if mode == 9 || mode == 13 || mode == 14 || mode == 15 || mode == 16 {
                ast.layout(st, tokens, files);
                st[62] = ast.size_for(tokens, files);
            } else if mode >= 3 && mode != 11 {
                ast.layout_emit(st, tokens, files);
                st[61] = target % 8;
            } else {
                ast.layout(st, tokens, files);
            }
            base = 0;
            f = 0;
            at = 0;
            while f < files {
                let n = header_length(raw, at);
                ast.set_file(st, f, base, n);
                base = base + n + 1;
                at = header_end(raw, at) + n;
                f = f + 1;
            }
            if mode == 3 {
                // The module is built and kept, as in mode 5, so that the functions nothing calls can be left out of it
                // (`prune.cho`); then it is printed, or the refusal is.
                status = answer(io, st, text, 5);
                if status == 0 {
                    let whole = prune.run(heap, module_bytes(heap, st));
                    borrow whole as &w in {
                        buffer.write(io, w);
                    }
                    buffer.drop(heap, whole);
                } else {
                    status = refusal(io, st);
                }
            } else if mode == 9 {
                if ast.parse(st, text) != 0 {
                    status = refusal_line(io, st);
                } else {
                    status = identities(heap, io, st, text, tokens);
                }
            } else if mode == 16 {
                // The modules the file declares and what each imports (`identity.modules`), for `vcs publish --dir`.
                if ast.parse(st, text) != 0 {
                    status = 1;
                } else {
                    buffer.drop(heap, written);
                    written = identity.modules(heap, st, text);
                    status = 0;
                }
            } else if mode == 13 || mode == 14 || mode == 15 {
                // The functions of the program with the identity of each signature (`identity.listing`), for `satisfy`; or, for a store being checked, the signature and the body of each.
                if ast.parse(st, text) != 0 {
                    status = 1;
                } else {
                    buffer.drop(heap, written);
                    written = identity_list(heap, st, text, tokens, mode - 13);
                    status = st[63];
                }
            } else if mode == 10 {
                status = check_quiet(st, text);
            } else if mode == 12 {
                // The layout of the types of the program, when it is built as the build builds it, so that a program with no `main` is refused as it is (`layoutrep.cho`).
                status = answer(io, st, text, 5);
                if status == 0 {
                    buffer.drop(heap, written);
                    written = layoutrep.report(heap, st, text);
                    status = st[63];
                }
            } else if mode == 18 || mode == 19 {
                // The report of `authority`, as prose (18) or data (19), when the program is built as the build builds it (`authority.cho`); a program some label of which is not followed is `skip`.
                status = answer(io, st, text, 5);
                if status == 0 {
                    let whole = prune.run(heap, module_bytes(heap, st));
                    buffer.drop(heap, written);
                    borrow whole as &w in {
                        if authority.unfollowed(st, buffer.bytes(w)) {
                            written = buffer.empty(heap, 0);
                            ast.fail(st, rules.r_skip(), 0, 0);
                            status = 1;
                        } else {
                            written = authority.report(heap, st, text, buffer.bytes(w), mode == 19, target / 8);
                        }
                    }
                    buffer.drop(heap, whole);
                    if status == 0 {
                        status = st[63];
                    }
                }
            } else if mode == 17 {
                // The functions the program reaches, with their rows and whether each is pure (`authority.cho`), when it is built as the build builds it.
                status = answer(io, st, text, 5);
                if status == 0 {
                    let whole = prune.run(heap, module_bytes(heap, st));
                    buffer.drop(heap, written);
                    borrow whole as &w in {
                        written = authority.reached(heap, st, text, buffer.bytes(w));
                    }
                    buffer.drop(heap, whole);
                    status = st[63];
                }
            } else if mode == 11 {
                buffer.drop(heap, written);
                written = scanned(heap, st, text);
                status = st[63];
            } else {
                status = answer(io, st, text, mode);
            }
            if mode >= 10 && status != 0 {
                rule = st[3];
                from = st[4];
                to = st[5];
            }
            if mode == 5 {
                if status == 0 {
                    buffer.drop(heap, written);
                    written = prune.run(heap, module_bytes(heap, st));
                } else {
                    rule = st[3];
                    from = st[4];
                    to = st[5];
                }
            }
        }
        unbox_slice(heap, state);
    }
    buffer.drop(heap, laid);
    return Built { ir: written, status: status, rule: rule, from: from, to: to };
}

// A line `TARGET darwin`, `TARGET linux` or `TARGET linux aarch64` in front of the input says what the code is for
// (which libc names and which constants differ): 1 for darwin, 2 for Linux on aarch64, 0 for Linux otherwise, and 0
// if there is no such line.
pub fn target_of[&r](raw: &r [byte]) -> [] int {
    if len(raw) >= 14 && lc.spells(raw, 0, 14, "TARGET darwin\n") {
        return 1;
    }
    if len(raw) >= 21 && lc.spells(raw, 0, 21, "TARGET linux aarch64\n") {
        return 2;
    }
    return 0;
}

// How many bytes of the input the line took.
pub fn target_skip[&r](raw: &r [byte]) -> [] int {
    if len(raw) >= 14 && lc.spells(raw, 0, 14, "TARGET darwin\n") {
        return 14;
    }
    if len(raw) >= 21 && lc.spells(raw, 0, 21, "TARGET linux aarch64\n") {
        return 21;
    }
    if len(raw) >= 13 && lc.spells(raw, 0, 13, "TARGET linux\n") {
        return 13;
    }
    return 0;
}

// Mode 6: the input is two files, the source and the text the printer (mode 4) wrote for it. The formatted source is written, or
// the line `CANNOT ...`. The checks that make the result safe to write over a file are for what runs the printer on it.
pub fn format_run[&h, &i, &x](heap: &!h Heap, io: &!i Io, raw: &x [byte]) -> [heap, io_write] int {
    let first = header_length(raw, 0);
    if first < 0 {
        console.write_all(io, "CANNOT the input is not two files");
        console.newline(io);
        return 1;
    }
    let from = header_end(raw, 0);
    let second_at = from + first;
    let second = header_length(raw, second_at);
    if second < 0 || header_end(raw, second_at) + second > len(raw) || from + first > len(raw) {
        console.write_all(io, "CANNOT the input is not two files");
        console.newline(io);
        return 1;
    }
    let src = raw[from..from + first];
    let printed = raw[header_end(raw, second_at)..header_end(raw, second_at) + second];
    let area = box_slice(heap, formatting.size_for(len(src), len(printed)), 0);
    var answer = 0;
    borrow mut area as &!b in {
        let m = contents(b);
        formatting.layout(m, len(src), len(printed));
        let formatted = formatting.format(heap, m, src, printed);
        let formatting.Formatted { text, status } = formatted;
        answer = status;
        var shown = text;
        if status == 0 {
            var done = buffer.empty(heap, 0);
            borrow shown as &w in {
                buffer.drop(heap, done);
                done = formatting.finish(heap, buffer.bytes(w));
            }
            buffer.drop(heap, shown);
            shown = done;
        }
        borrow shown as &w in {
            buffer.write(io, w);
        }
        buffer.drop(heap, shown);
        if answer != 0 {
            console.newline(io);
        }
    }
    unbox_slice(heap, area);
    return answer;
}

// Mode 8: the input is JSON (`docs/structured-ingest.md`), and the output is the canonical text of the program it stands for, or the line
// `ERR rule from to` with a span in the JSON.
pub fn ingest_run[&h, &i, &x](heap: &!h Heap, io: &!i Io, raw: &x [byte]) -> [heap, io_write] int {
    let records = box_slice(heap, jsonread.size_for(raw), 0);
    var status = 0;
    borrow mut records as &!jb in {
        let jm = contents(jb);
        if jsonread.read(jm, raw) != 0 {
            status = err_line(io, jm[3], jm[4], jm[5]);
        } else {
            let tokens = ingest.tokens_for(jm, raw);
            let nodes = ingest.nodes_for(jm);
            let state = box_slice(heap, ingest.size_for(tokens, nodes, nodes), 0);
            let text = box_slice(heap, len(raw) + 5 * tokens + 64, byte_of(0));
            borrow mut state as &!sb in {
                borrow mut text as &!tb in {
                    let st = contents(sb);
                    let tx = contents(tb);
                    ingest.layout(st, tokens, nodes, nodes);
                    if ingest.build(st, tx, raw, jm) != 0 {
                        status = refusal_line(io, st);
                    } else {
                        printing.print(io, st, tx[0..st[0]]);
                    }
                }
            }
            unbox_slice(heap, text);
            unbox_slice(heap, state);
        }
    }
    unbox_slice(heap, records);
    return status;
}

// Read standard input, parse it, and print the answer for `mode`; `many` says that the input is
// a stream of files. The exit status is 1 for a refusal.
pub fn drive(world: World, mode: int, many: bool) -> [] int {
    let Split { io, ffi, fs, heap, args } = split(world);
    release(ffi);
    release(fs);
    release(args);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            let raw = lc.slurp(h, i);
            borrow raw as &r in {
                let all = buffer.bytes(r);
                let rest = all[target_skip(all)..len(all)];
                if mode == 8 {
                    status = ingest_run(h, i, rest);
                } else if mode == 6 {
                    status = format_run(h, i, rest);
                } else if many {
                    status = discard(h, run_many(h, i, rest, mode, target_of(all)));
                } else {
                    status = run_one(h, i, rest, mode, target_of(all));
                }
            }
            buffer.drop(h, raw);
        }
    }
    release(heap);
    release(io);
    return status;
}
