edition 9;
module selfhost.gitcheck;

// gitcheck.cho -- the oracle of `gitread.cho` that needs no other implementation (`docs/vcs-routing.md` section 16, R14): every object of a git directory, read
// loose, from a pack or through a chain of deltas, must hash to its own name. Prints how many objects of each kind were read and how many did not match.
//
//     cancho run examples/selfhost/gitcheck.cho examples/selfhost/gitread.cho examples/selfhost/sha1.cho --std -- /ABSOLUTE/PATH/.git

import std.buffer;
import std.bytes;
import std.dirs;
import std.io as console;
import selfhost.gitread;
import selfhost.sha1;

fn line[&i](io: &!i Io, text: &static [byte], a: int) -> [io_write] int {
    console.write_all(io, text);
    console.print_nat(io, a);
    console.newline(io);
    return 0;
}

// All the ids (20 bytes each) of the objects of the catalog: the loose ones of each object directory, then those of each pack.
fn all_ids[&h, &d, &o, &x, &m](heap: &!h Heap, root: &d Dir, odirs: &o [byte], idx: &x [byte], meta: &m [int]) -> [heap, dir_read] buffer.Buffer {
    var ids = buffer.empty(heap, 1024);
    var at = 0;
    while at < len(odirs) {
        var end = at;
        while end < len(odirs) && odirs[end] != byte_of(10) {
            end = end + 1;
        }
        match dirs.enter(root, odirs[at..end]) {
            DirOpened::Ok(d0) => {
                var od = d0;
                borrow od as &odd in {
                    let fans = dirs.list(heap, odd, 100000);
                    borrow fans as &fr in {
                        var f = 0;
                        while f < dirs.count(fr) {
                            let fname = dirs.name(fr, f);
                            if len(fname) == 2 {
                                match dirs.enter(odd, fname) {
                                    DirOpened::Ok(s0) => {
                                        var sd = s0;
                                        borrow sd as &sdd in {
                                            let names = dirs.list(heap, sdd, 100000);
                                            borrow names as &nr in {
                                                var k = 0;
                                                while k < dirs.count(nr) {
                                                    let n = dirs.name(nr, k);
                                                    if len(n) == 38 {
                                                        var full = buffer.append(heap, buffer.empty(heap, 40), fname);
                                                        full = buffer.append(heap, full, n);
                                                        borrow full as &fb in {
                                                            let raw = gitread.unhex_id(heap, buffer.bytes(fb));
                                                            borrow raw as &rb in {
                                                                ids = buffer.append(heap, ids, buffer.bytes(rb));
                                                            }
                                                            buffer.drop(heap, raw);
                                                        }
                                                        buffer.drop(heap, full);
                                                    }
                                                    k = k + 1;
                                                }
                                            }
                                            dirs.drop(heap, names);
                                        }
                                        dir_close(sd);
                                    }
                                    DirOpened::Failed(e) => {
                                    }
                                }
                            }
                            f = f + 1;
                        }
                    }
                    dirs.drop(heap, fans);
                }
                dir_close(od);
            }
            DirOpened::Failed(e) => {
            }
        }
        at = end + 1;
    }
    var p = 0;
    while p < meta[0] {
        let io0 = meta[1 + 5 * p];
        let count = meta[3 + 5 * p];
        var n = 0;
        while n < count {
            let from = io0 + 8 + 1024 + n * 20;
            ids = buffer.append(heap, ids, idx[from..from + 20]);
            n = n + 1;
        }
        p = p + 1;
    }
    return ids;
}

fn run[&h, &i, &a, &f](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs("")) -> [heap, io_write, err_write, args, fs_read(""), dir_read, file_read] int {
    if arg_count(args) < 2 {
        console.error_all(io, "usage: gitcheck /ABSOLUTE/PATH/.git\n");
        return 2;
    }
    let given = arg(args, 1);
    match open_dir(fs, "/") {
        DirOpened::Ok(r0) => {
            var root = r0;
            let meta = box_slice(heap, gitread.meta_size(), 0);
            let scratch = box_slice(heap, gitread.scratch_size(), 0);
            let state = box_slice(heap, sha1.size(), 0);
            let digest = box_slice(heap, 20, byte_of(0));
            var bad = 0;
            var total = 0;
            var ofs_deltas = 0;
            var ref_deltas = 0;
            var counts1 = 0;
            var counts2 = 0;
            var counts3 = 0;
            var counts4 = 0;
            var code = 0;
            borrow mut meta as &!m in {
                borrow mut scratch as &!s in {
                    borrow mut state as &!st in {
                        borrow mut digest as &!dg in {
                            let mm = contents(m);
                            let sc = contents(s);
                            let sh = contents(st);
                            let dd = contents(dg);
                            borrow root as &rd in {
                                var gp = given;
                                if len(gp) > 0 && gp[0] == byte_of(47) {
                                    gp = gp[1..len(gp)];
                                }
                                let cat = gitread.open_catalog(heap, rd, gp, mm);
                                let (odirs, idx, pk, cstatus, cerrno, why) = gitread.cat_parts(cat);
                                if cstatus != 0 {
                                    borrow why as &wb in {
                                        console.error_all(io, buffer.bytes(wb));
                                    }
                                    console.error_all(io, "\n");
                                    code = 1;
                                } else {
                                    borrow odirs as &ob in {
                                        borrow idx as &ib in {
                                            borrow pk as &pb in {
                                                let ids = all_ids(heap, rd, buffer.bytes(ob), buffer.bytes(ib), mm);
                                                var pn = 0;
                                                while pn < mm[0] {
                                                    let io0 = mm[1 + 5 * pn];
                                                    let cnt = mm[3 + 5 * pn];
                                                    let offs = io0 + 8 + 1024 + cnt * 24;
                                                    var en = 0;
                                                    while en < cnt {
                                                        let raw = gitread.be32(buffer.bytes(ib), offs + en * 4);
                                                        if raw < 2147483648 {
                                                            let ty = int_of(buffer.bytes(pb)[mm[4 + 5 * pn] + raw]) / 16 % 8;
                                                            if ty == 6 {
                                                                ofs_deltas = ofs_deltas + 1;
                                                            } else if ty == 7 {
                                                                ref_deltas = ref_deltas + 1;
                                                            }
                                                        }
                                                        en = en + 1;
                                                    }
                                                    pn = pn + 1;
                                                }
                                                borrow ids as &sb in {
                                                    let list = buffer.bytes(sb);
                                                    var n = 0;
                                                    while n * 20 < len(list) {
                                                        let id = list[n * 20..n * 20 + 20];
                                                        let g = gitread.read_object(heap, rd, buffer.bytes(ob), buffer.bytes(ib), buffer.bytes(pb), mm, sc, id);
                                                        let (body, kind, status, gwhy) = gitread.got_parts(g);
                                                        if status != 0 {
                                                            bad = bad + 1;
                                                            if bad < 6 {
                                                                console.write_all(io, "unreadable: ");
                                                                borrow gwhy as &yb in {
                                                                    console.write_all(io, buffer.bytes(yb));
                                                                }
                                                                console.newline(io);
                                                            }
                                                        } else {
                                                            var head = buffer.append(heap, buffer.empty(heap, 32), gitread.kind_name(kind));
                                                            head = buffer.push(heap, head, byte_of(32));
                                                            borrow body as &bb in {
                                                                head = buffer.push_nat(heap, head, len(buffer.bytes(bb)));
                                                                head = buffer.push(heap, head, byte_of(0));
                                                                sha1.init(sh, 0);
                                                                borrow head as &hb in {
                                                                    sha1.update(sh, 0, buffer.bytes(hb));
                                                                }
                                                                sha1.update(sh, 0, buffer.bytes(bb));
                                                                sha1.finish(sh, 0, dd);
                                                            }
                                                            buffer.drop(heap, head);
                                                            var same = true;
                                                            var k = 0;
                                                            while k < 20 {
                                                                if dd[k] != id[k] {
                                                                    same = false;
                                                                }
                                                                k = k + 1;
                                                            }
                                                            if !same {
                                                                bad = bad + 1;
                                                                if bad < 6 {
                                                                    console.write_all(io, "wrong hash\n");
                                                                }
                                                            }
                                                            if kind == 1 {
                                                                counts1 = counts1 + 1;
                                                            } else if kind == 2 {
                                                                counts2 = counts2 + 1;
                                                            } else if kind == 3 {
                                                                counts3 = counts3 + 1;
                                                            } else {
                                                                counts4 = counts4 + 1;
                                                            }
                                                        }
                                                        buffer.drop(heap, body);
                                                        buffer.drop(heap, gwhy);
                                                        total = total + 1;
                                                        n = n + 1;
                                                    }
                                                }
                                                buffer.drop(heap, ids);
                                            }
                                        }
                                    }
                                }
                                buffer.drop(heap, odirs);
                                buffer.drop(heap, idx);
                                buffer.drop(heap, pk);
                                buffer.drop(heap, why);
                            }
                        }
                    }
                }
            }
            unbox_slice(heap, meta);
            unbox_slice(heap, scratch);
            unbox_slice(heap, state);
            unbox_slice(heap, digest);
            dir_close(root);
            line(io, "objects: ", total);
            line(io, "commits: ", counts1);
            line(io, "trees: ", counts2);
            line(io, "blobs: ", counts3);
            line(io, "tags: ", counts4);
            line(io, "pack entries that are ofs-deltas: ", ofs_deltas);
            line(io, "pack entries that are ref-deltas: ", ref_deltas);
            line(io, "not read or not equal to their name: ", bad);
            if bad > 0 {
                code = 1;
            }
            return code;
        }
        DirOpened::Failed(e) => {
            console.error_all(io, "cannot open /\n");
            return 1;
        }
    }
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals, exec, tty } = split(world);
    release(tty);
    release(ffi);
    release(net);
    release(clock);
    release(signals);
    release(exec);
    var status = 0;
    borrow mut heap as &!h in {
        borrow mut io as &!i in {
            borrow args as &a in {
                borrow fs as &f in {
                    status = run(h, i, a, f);
                }
            }
        }
    }
    release(fs);
    release(args);
    release(heap);
    release(io);
    return status;
}
