pub fn builtin_sig(i: int) -> [] int {
    return builtin_sigs[i];
}

// Where builtin b's signature starts in `builtin_sig`: 1 if the lowering checks it by hand (its table
// signature is `() -> ()`), else 0; how many parameters; each parameter's type and then the result's.
pub fn builtin_sig_start(b: int) -> [] int {
    return builtin_sig_starts[b];
}
