edition 7;
module selfhost.clifetch;

// clifetch.cho -- `vcs fetch` and `vcs resolve`, a port of `cmd_fetch`, `cmd_resolve` and `fetch_verified` (`crates/cancho/src/vcs_cli.rs`, `docs/cli-in-cancho.md` section 28): what a lock pins
// in a store checked again, and for `fetch` written to a directory as `HASH.cho`.
//
// Exit status: 1 a pin that does not hold, 2 a bad command line, 3 the environment. `--cache DIR` says where the git checkouts are kept (§23) and `--std-dir DIR` where the library is, which the
// Rust command has inside it (§24).

import std.buffer;
import std.bytes;
import std.io as console;
import selfhost.lexcore as lc;
import selfhost.projfile;
import selfhost.clibase;
import selfhost.clistore;
import selfhost.cliorigin;
import selfhost.clivcs;
import selfhost.clilock;

// The words of a `vcs fetch` or `vcs resolve` command line: where (in the arguments) the values of `--lock`, `--store` (or the store of `resolve`), `-o`, `--cache` and `--std-dir` are (-1 if not
// given), and `bad` (the status of a usage error that has been said).
struct Words {
    lock_at: int,
    store_at: int,
    out_at: int,
    cache_at: int,
    std_at: int,
    bad: int,
}

fn needs_value[&h, &i, &w](heap: &!h Heap, io: &!i Io, word: &w [byte]) -> [heap, err_write] int {
    var m = buffer.append(heap, buffer.append(heap, buffer.empty(heap, 32), "`"), word);
    m = buffer.append(heap, m, "` needs a path");
    var said = 0;
    borrow m as &mb in {
        said = clibase.usage_error(heap, io, buffer.bytes(mb));
    }
    buffer.drop(heap, m);
    return said;
}

fn quoted[&h, &i, &a, &b, &c](heap: &!h Heap, io: &!i Io, head: &a [byte], middle: &b [byte], tail: &c [byte]) -> [heap, err_write] int {
    let m = cliorigin.message(heap, head, middle, tail);
    var said = 0;
    borrow m as &mb in {
        said = clibase.usage_error(heap, io, buffer.bytes(mb));
    }
    buffer.drop(heap, m);
    return said;
}

fn words_of[&h, &i, &a](heap: &!h Heap, io: &!i Io, args: &a Args, fetching: bool) -> [heap, err_write, args] Words {
    var lock_at = 0 - 1;
    var store_at = 0 - 1;
    var out_at = 0 - 1;
    var cache_at = 0 - 1;
    var std_at = 0 - 1;
    var bad = 0;
    var n = 3;
    while n < arg_count(args) && bad == 0 {
        let word = arg(args, n);
        let valued = bytes.equal(word, "--lock") || bytes.equal(word, "--cache") || bytes.equal(word, "--std-dir") || fetching && (bytes.equal(word, "--store") || bytes.equal(word, "-o"));
        if valued && n + 1 >= arg_count(args) {
            bad = needs_value(heap, io, word);
        } else if valued {
            n = n + 1;
            if bytes.equal(word, "--lock") {
                lock_at = n;
            } else if bytes.equal(word, "--store") {
                store_at = n;
            } else if bytes.equal(word, "-o") {
                out_at = n;
            } else if bytes.equal(word, "--std-dir") {
                std_at = n;
            } else if len(arg(args, n)) == 0 || lc.at(arg(args, n), 0) != '/' {
                bad = clibase.usage_error(heap, io, "`--cache` needs an absolute directory");
            } else {
                cache_at = n;
            }
        } else if len(word) > 0 && lc.at(word, 0) == '-' {
            bad = clibase.unknown_option(heap, io, word);
        } else if fetching {
            bad = quoted(heap, io, "`vcs fetch` takes no positional arguments, found `", word, "`");
        } else if store_at >= 0 {
            bad = quoted(heap, io, "`vcs resolve` takes exactly one store directory, found a second argument `", word, "`");
        } else {
            store_at = n;
        }
        n = n + 1;
    }
    return Words { lock_at: lock_at, store_at: store_at, out_at: out_at, cache_at: cache_at, std_at: std_at, bad: bad };
}

// A line on the standard error.
fn say[&h, &i, &a, &b, &c](heap: &!h Heap, io: &!i Io, head: &a [byte], middle: &b [byte], tail: &c [byte]) -> [heap, err_write] int {
    let line = buffer.push(heap, cliorigin.message(heap, head, middle, tail), byte_of(10));
    borrow line as &lb in {
        console.error_all(io, buffer.bytes(lb));
    }
    buffer.drop(heap, line);
    return 0;
}

// The lock file at `path` read: its record (empty if there is no file), and 3 and the reason on the standard error if it could not be.
res struct Locked {
    record: buffer.Buffer,
    status: int,
}

fn read_locked[&h, &i, &f, &p](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), path: &p [byte]) -> [heap, err_write, fs_read(""), file_read] Locked {
    let read = clistore.read_lock(heap, fs, path);
    let clistore.Pins { records, why } = read;
    var status = 0;
    borrow why as &wb in {
        if buffer.size(wb) > 0 {
            say(heap, io, "", buffer.bytes(wb), "");
            status = 3;
        }
    }
    buffer.drop(heap, why);
    return Locked { record: records, status: status };
}

// The entries of a lock record (nothing for no lock).
fn entries_of[&r](record: &r [byte]) -> [] &r [byte] {
    if len(record) == 0 {
        return record[0..0];
    }
    return record[clilock.origin_end(record)..len(record) - 2];
}

// The directory of the store a lock pins: the one named, else the one its origin points at, fetched into the cache if it is not there. The status 0, 2 (the lock says nowhere) or 3.
res struct Placed {
    dir: buffer.Buffer,
    status: int,
}

fn place[&h, &i, &x, &c, &f, &k, &r, &n](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, fs: &f Fs(""), cache: &k [byte], record: &r [byte], named: &n [byte], is_named: bool) -> [heap, err_write, fs_read(""), fs_write(""), exec(""), clock, poll] Placed {
    if is_named {
        return Placed { dir: buffer.append(heap, buffer.empty(heap, len(named) + 8), named), status: 0 };
    }
    if len(record) == 0 || lc.at(record, 1) != '1' {
        return Placed { dir: buffer.empty(heap, 0), status: clibase.usage_error(heap, io, "this lock has no origin, so the store must be named: add `--store <dir>`") };
    }
    let got = cliorigin.ensure(heap, io, exec, clock, fs, cache, clivcs.field_of(record, 3, 0), clivcs.field_of(record, 3, 1), clivcs.field_of(record, 3, 2));
    let cliorigin.Checkout { dir, why, status } = got;
    var outcome = 0;
    borrow why as &wb in {
        if buffer.size(wb) > 0 {
            say(heap, io, "", buffer.bytes(wb), "");
            outcome = 3;
        }
    }
    buffer.drop(heap, why);
    return Placed { dir: dir, status: outcome };
}

// The value of the argument `at`, or nothing if it was not given.
fn value_of[&a](args: &a Args, at: int) -> [args] &a [byte] {
    if at >= 0 {
        return arg(args, at);
    }
    return arg(args, 0)[0..0];
}

// The lines `fetch` said: a path (each followed by a NUL) of `files` for each file written.
fn said_files[&i, &f](io: &!i Io, files: &f [byte]) -> [io_write] int {
    var at = 0;
    while at < len(files) {
        let end = projfile.field_end(files, at, len(files));
        console.write_all(io, "fetched ");
        console.write_all(io, files[at..end]);
        console.write_all(io, "\n");
        at = end + 1;
    }
    return 0;
}

// `vcs fetch --lock FILE [--store DIR] -o DIR`.
pub fn fetch_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    let given = words_of(heap, io, args, true);
    let Words { lock_at, store_at, out_at, cache_at, std_at, bad } = given;
    if bad != 0 {
        return bad;
    }
    if lock_at < 0 {
        return clibase.usage_error(heap, io, "`vcs fetch` needs `--lock <file>`");
    }
    if out_at < 0 {
        return clibase.usage_error(heap, io, "`vcs fetch` needs `-o <dir>`");
    }
    let read = read_locked(heap, io, fs, arg(args, lock_at));
    let Locked { record, status } = read;
    var result = status;
    if result == 0 {
        borrow record as &rb in {
            result = fetch_locked(heap, io, args, fs, exec, clock, buffer.bytes(rb), lock_at, store_at, out_at, cache_at, std_at);
        }
    }
    buffer.drop(heap, record);
    return result;
}

fn fetch_locked[&h, &i, &a, &f, &x, &c, &r](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, record: &r [byte], lock_at: int, store_at: int, out_at: int, cache_at: int, std_at: int) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    let entries = entries_of(record);
    if len(entries) == 0 {
        console.write_all(io, "nothing locked at `");
        console.write_all(io, arg(args, lock_at));
        console.write_all(io, "`; nothing to fetch\n");
        return 0;
    }
    let cache = cliorigin.cache_root(heap, io, exec, clock, value_of(args, cache_at));
    var result = 0;
    borrow cache as &cb in {
        let placed = place(heap, io, exec, clock, fs, buffer.bytes(cb), record, value_of(args, store_at), store_at >= 0);
        let Placed { dir, status } = placed;
        result = status;
        if result == 0 {
            borrow dir as &db in {
                result = fetch_in(heap, io, fs, exec, clock, buffer.bytes(cb), value_of(args, std_at), buffer.bytes(db), arg(args, out_at), entries);
            }
        }
        buffer.drop(heap, dir);
    }
    buffer.drop(heap, cache);
    return result;
}

fn fetch_in[&h, &i, &f, &x, &c, &k, &s, &t, &o, &e](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, cache: &k [byte], std_path: &s [byte], store: &t [byte], out: &o [byte], entries: &e [byte]) -> [heap, io_write, err_write, fs_read(""), fs_write(""), file_read, file_write, dir_read, exec(""), clock, poll] int {
    let got = clistore.fetch_pinned(heap, io, exec, clock, fs, cache, std_path, store, out, entries);
    let clistore.Fetched { files, why, status, needs_std } = got;
    borrow why as &wb in {
        if buffer.size(wb) > 0 {
            say(heap, io, "", buffer.bytes(wb), "");
        }
    }
    if status == 0 {
        borrow files as &fb in {
            said_files(io, buffer.bytes(fb));
        }
        if needs_std {
            console.write_all(io, "note: these files import `std`; build the consumer with `--std`\n");
        }
    }
    buffer.drop(heap, files);
    buffer.drop(heap, why);
    return status;
}

// `vcs resolve [--lock FILE] [STORE]`.
pub fn resolve_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, dir_read, fs_write(""), exec(""), clock, poll] int {
    let given = words_of(heap, io, args, false);
    let Words { lock_at, store_at, out_at, cache_at, std_at, bad } = given;
    if bad != 0 {
        return bad;
    }
    var locked = Locked { record: buffer.empty(heap, 0), status: 0 };
    if lock_at >= 0 {
        locked = replaced_locked(heap, locked, read_locked(heap, io, fs, arg(args, lock_at)));
    }
    let Locked { record, status } = locked;
    var result = status;
    if result == 0 && store_at < 0 && lock_at < 0 {
        result = clibase.usage_error(heap, io, "`vcs resolve` needs a store directory");
    }
    if result == 0 {
        borrow record as &rb in {
            result = resolve_locked(heap, io, args, fs, exec, clock, buffer.bytes(rb), lock_at, store_at, cache_at, std_at);
        }
    }
    buffer.drop(heap, record);
    return result;
}

fn replaced_locked[&h](heap: &!h Heap, old: Locked, new: Locked) -> [heap] Locked {
    let Locked { record, status } = old;
    buffer.drop(heap, record);
    return new;
}

fn resolve_locked[&h, &i, &a, &f, &x, &c, &r](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, record: &r [byte], lock_at: int, store_at: int, cache_at: int, std_at: int) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, dir_read, exec(""), clock, poll] int {
    let cache = cliorigin.cache_root(heap, io, exec, clock, value_of(args, cache_at));
    var result = 0;
    borrow cache as &cb in {
        let placed = place(heap, io, exec, clock, fs, buffer.bytes(cb), record, value_of(args, store_at), store_at >= 0);
        let Placed { dir, status } = placed;
        result = status;
        if result == 0 {
            borrow dir as &db in {
                result = resolve_in(heap, io, fs, exec, clock, buffer.bytes(cb), value_of(args, std_at), buffer.bytes(db), lock_at >= 0, entries_of(record), value_of(args, lock_at));
            }
        }
        buffer.drop(heap, dir);
    }
    buffer.drop(heap, cache);
    return result;
}

fn number[&h](heap: &!h Heap, n: int) -> [heap] buffer.Buffer {
    var reversed = buffer.empty(heap, 20);
    var rest = n;
    if rest == 0 {
        reversed = buffer.push(heap, reversed, byte_of('0'));
    }
    while rest > 0 {
        reversed = buffer.push(heap, reversed, byte_of('0' + rest % 10));
        rest = rest / 10;
    }
    var digits = buffer.empty(heap, 20);
    borrow reversed as &rb in {
        var k = buffer.size(rb);
        while k > 0 {
            k = k - 1;
            digits = buffer.push(heap, digits, buffer.bytes(rb)[k]);
        }
    }
    buffer.drop(heap, reversed);
    return digits;
}

fn resolve_in[&h, &i, &f, &x, &c, &k, &s, &t, &e, &l](heap: &!h Heap, io: &!i Io, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock, cache: &k [byte], std_path: &s [byte], store: &t [byte], use_lock: bool, entries: &e [byte], lock_path: &l [byte]) -> [heap, io_write, err_write, fs_read(""), fs_write(""), file_read, dir_read, exec(""), clock, poll] int {
    let got = clistore.resolve_store(heap, io, exec, clock, fs, cache, std_path, store, use_lock, entries);
    let clistore.Resolved { declarations, files, closure, why, status } = got;
    borrow why as &wb in {
        if buffer.size(wb) > 0 {
            say(heap, io, "", buffer.bytes(wb), "");
        }
    }
    buffer.drop(heap, why);
    if status == 4 {
        console.write_all(io, "nothing published at `");
        console.write_all(io, store);
        console.write_all(io, "`; nothing to resolve\n");
        return 0;
    }
    if status == 5 {
        console.write_all(io, "nothing locked at `");
        console.write_all(io, lock_path);
        console.write_all(io, "`; nothing to resolve\n");
        return 0;
    }
    if status != 0 {
        return status;
    }
    let d = number(heap, declarations);
    let n = number(heap, files);
    var line = buffer.empty(heap, 256);
    borrow d as &db in {
        line = buffer.append(heap, line, buffer.bytes(db));
    }
    line = buffer.append(heap, line, " declaration(s) across ");
    borrow n as &nb in {
        line = buffer.append(heap, line, buffer.bytes(nb));
    }
    line = buffer.append(heap, buffer.append(heap, buffer.append(heap, line, " file(s) at `"), store), "` still resolve exactly as published");
    if closure > 0 {
        let m = number(heap, closure);
        line = buffer.append(heap, line, ", plus ");
        borrow m as &mb in {
            line = buffer.append(heap, line, buffer.bytes(mb));
        }
        line = buffer.append(heap, line, " file(s) verified transitively through its own `requires/`");
        buffer.drop(heap, m);
    }
    line = buffer.push(heap, line, byte_of(10));
    buffer.drop(heap, d);
    buffer.drop(heap, n);
    clibase.show(heap, io, line);
    return 0;
}
