module selfhost.narrowing;

// narrowing.cho -- what `narrow(cap, "a", ...)` must satisfy (`lower/mod.rs` `narrow` and `lower/narrow.rs`, section 5 of
// `docs/narrowing-into-several.md`): a literal is inside what the capability was narrowed to, at a separator for the
// capabilities that name paths, and not equal to it; several literals are unrelated paths of `Fs` or `Exec`. A literal
// is a string token; the capability's own is `types.prelude_lit_tok`, or none, which is the empty string.
//
// The bytes of a literal are compared as written, so one with an escape is left alone (the Rust compiler compares what
// it means): a refusal is only made when it cannot be wrong.

import selfhost.ast;
import selfhost.kinds;
import selfhost.rules;
import selfhost.types;
import selfhost.netcode;

// Where the bytes of the literal in token `tok` start and end, between its quotes; none is the empty string.
fn first[&s](st: &!s [int], tok: int) -> [] int {
    if tok < 0 {
        return 0;
    }
    return ast.tstart(st, tok) + 1;
}

fn last[&s](st: &!s [int], tok: int) -> [] int {
    if tok < 0 {
        return 0;
    }
    return ast.tend(st, tok) - 1;
}

// Does the literal hold an escape?
fn escaped[&s, &x](st: &!s [int], text: &x [byte], tok: int) -> [] bool {
    var i = first(st, tok);
    while i < last(st, tok) {
        if int_of(text[i]) == 92 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn size[&s](st: &!s [int], tok: int) -> [] int {
    return last(st, tok) - first(st, tok);
}

// Does `target` start with `current`?
fn starts_with[&s, &x](st: &!s [int], text: &x [byte], current: int, target: int) -> [] bool {
    let n = size(st, current);
    if size(st, target) < n {
        return false;
    }
    var i = 0;
    while i < n {
        if int_of(text[first(st, current) + i]) != int_of(text[first(st, target) + i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// `extends_path`: `target` is inside `prefix` at a separator, or is it.
fn extends[&s, &x](st: &!s [int], text: &x [byte], prefix: int, target: int) -> [] bool {
    if !starts_with(st, text, prefix, target) {
        return false;
    }
    let n = size(st, prefix);
    if n == 0 || int_of(text[last(st, prefix) - 1]) == 47 || size(st, target) == n {
        return true;
    }
    return int_of(text[first(st, target) + n]) == 47;
}

fn equal[&s, &x](st: &!s [int], text: &x [byte], a: int, b: int) -> [] bool {
    return size(st, a) == size(st, b) && starts_with(st, text, a, b);
}

// Is the path of literal `target` inside the one of `prefix`, at a separator? A literal with an escape is not judged: true.
pub fn path_inside[&s, &x](st: &!s [int], text: &x [byte], prefix: int, target: int) -> [] bool {
    if escaped(st, text, prefix) || escaped(st, text, target) {
        return true;
    }
    return extends(st, text, prefix, target);
}

// A `Net` bound splits at its last `:`. With no `:`, all digits is a bare port and anything else a bare host. These give the
// start of the port (or -1 for none) and the length of the host.
fn port_at[&s, &x](st: &!s [int], text: &x [byte], lit: int) -> [] int {
    var i = last(st, lit);
    while i > first(st, lit) {
        i = i - 1;
        if int_of(text[i]) == 58 {
            return i + 1;
        }
    }
    let n = size(st, lit);
    if n == 0 {
        return 0 - 1;
    }
    var k = 0;
    while k < n {
        let c = int_of(text[first(st, lit) + k]);
        if c < 48 || c > 57 {
            return 0 - 1;
        }
        k = k + 1;
    }
    return first(st, lit);
}

fn host_len[&s, &x](st: &!s [int], text: &x [byte], lit: int) -> [] int {
    let p = port_at(st, text, lit);
    if p < 0 {
        return size(st, lit);
    }
    if p == first(st, lit) {
        return 0;
    }
    return p - 1 - first(st, lit);
}

// Is the host of `inner` one label ahead of the suffix `outer` names, `outer` being written `*.suffix`? The label is not
// empty and has no `.` or `*` in it.
fn one_label_under[&s, &x](st: &!s [int], text: &x [byte], outer: int, inner: int) -> [] bool {
    let oh = host_len(st, text, outer);
    let ih = host_len(st, text, inner);
    let suffix = oh - 2;
    let label = ih - suffix - 1;
    if suffix < 0 || label < 1 {
        return false;
    }
    var i = 0;
    while i < suffix {
        if int_of(text[first(st, outer) + 2 + i]) != int_of(text[first(st, inner) + label + 1 + i]) {
            return false;
        }
        i = i + 1;
    }
    if int_of(text[first(st, inner) + label]) != 46 {
        return false;
    }
    i = 0;
    while i < label {
        let c = int_of(text[first(st, inner) + i]);
        if c == 46 || c == 42 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn same_host[&s, &x](st: &!s [int], text: &x [byte], a: int, b: int) -> [] bool {
    let n = host_len(st, text, a);
    if host_len(st, text, b) != n {
        return false;
    }
    var i = 0;
    while i < n {
        if int_of(text[first(st, a) + i]) != int_of(text[first(st, b) + i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// `net_contains`: everything `inner` admits, `outer` admits. The port, when `outer` names one, is exact. The host is a prefix
// of the other's, or, with `exact` (edition 10, `docs/net-bounds.md` 2.3), an empty host admits any, `*.suffix` admits that
// bound and one label ahead of `.suffix`, and every other host admits only itself.
fn net_contains[&s, &x](st: &!s [int], text: &x [byte], outer: int, inner: int, exact: bool) -> [] bool {
    let oh = host_len(st, text, outer);
    if exact {
        let wild = oh >= 2 && int_of(text[first(st, outer)]) == 42 && int_of(text[first(st, outer) + 1]) == 46;
        if oh > 0 && !same_host(st, text, outer, inner) && !(wild && one_label_under(st, text, outer, inner)) {
            return false;
        }
    } else {
        if host_len(st, text, inner) < oh {
            return false;
        }
        var i = 0;
        while i < oh {
            if int_of(text[first(st, outer) + i]) != int_of(text[first(st, inner) + i]) {
                return false;
            }
            i = i + 1;
        }
    }
    let op = port_at(st, text, outer);
    if op < 0 {
        return true;
    }
    let ip = port_at(st, text, inner);
    if ip < 0 || last(st, outer) - op != last(st, inner) - ip {
        return false;
    }
    var k = 0;
    while k < last(st, outer) - op {
        if int_of(text[op + k]) != int_of(text[ip + k]) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// One literal narrowing `current` (`check_narrowing`): inside it, at a separator when `path`, and not equal. True if
// it was refused.
pub fn refused_one[&s, &x](st: &!s [int], text: &x [byte], path: bool, current: int, target: int, from: int, to: int) -> [] bool {
    if escaped(st, text, current) || escaped(st, text, target) {
        return false;
    }
    var inside = starts_with(st, text, current, target);
    if path {
        inside = extends(st, text, current, target);
    } else {
        inside = net_contains(st, text, current, target, st[23] >= 10);
    }
    if !inside || equal(st, text, current, target) {
        ast.fail(st, rules.r_capability_not_narrowable(), from, to);
        return true;
    }
    return false;
}

// Two literals of one `narrow` into several: no two the same path, and none inside another. True if refused.
pub fn refused_pair[&s, &x](st: &!s [int], text: &x [byte], path: bool, a: int, b: int, from: int, to: int) -> [] bool {
    if escaped(st, text, a) || escaped(st, text, b) {
        return false;
    }
    // A path extends at a separator; a `Net` bound has a host prefix and an exact port.
    var nested = net_contains(st, text, a, b, st[23] >= 10) || net_contains(st, text, b, a, st[23] >= 10);
    if path {
        nested = extends(st, text, a, b) || extends(st, text, b, a);
    }
    if equal(st, text, a, b) || nested {
        ast.fail(st, rules.r_capability_not_narrowable(), from, to);
        return true;
    }
    return false;
}

// The capabilities `narrow` accepts, by the name of their prelude type; and the three that narrow into several.
pub fn narrows[&s](st: &!s [int], index: int) -> [] bool {
    return index == netcode.prelude_named("Ffi") || index == netcode.prelude_named("Fs") || is_net(st, index) || index == netcode.prelude_named("Signals") || index == netcode.prelude_named("Exec") || index == netcode.prelude_named("Tty");
}

pub fn narrows_many[&s](st: &!s [int], index: int) -> [] bool {
    return index == netcode.prelude_named("Fs") || index == netcode.prelude_named("Exec") || is_net(st, index);
}

// `Net`, and the two halves of it from edition 11 (`docs/net-bounds.md` 3): bounded by the same `host:port` text.
pub fn is_net[&s](st: &!s [int], index: int) -> [] bool {
    return index == netcode.prelude_named("Net") || index == netcode.prelude_named("Out") || index == netcode.prelude_named("Ports");
}

// A path capability: the separator rule applies to the literals (`Fs`, `Exec`, `Tty`); `Net` is a host prefix and an exact port.
pub fn is_path[&s](st: &!s [int], index: int) -> [] bool {
    return index == netcode.prelude_named("Fs") || index == netcode.prelude_named("Exec") || index == netcode.prelude_named("Tty");
}

// A capability whose literal is checked here: the paths and `Net`. `Ffi` and `Signals` name a set, and narrow as one.
pub fn checked[&s](st: &!s [int], index: int) -> [] bool {
    return is_path(st, index) || is_net(st, index);
}

// Is the library written in text[ts..te] one of those of the set `held` (names separated by commas)?
fn in_set[&s, &x](st: &!s [int], text: &x [byte], held: int, ts: int, te: int) -> [] bool {
    let end = last(st, held);
    var i = first(st, held);
    while i <= end {
        var j = i;
        while j < end && int_of(text[j]) != 44 {
            j = j + 1;
        }
        if j - i == te - ts {
            var k = 0;
            var same = true;
            while k < te - ts {
                if int_of(text[i + k]) != int_of(text[ts + k]) {
                    same = false;
                }
                k = k + 1;
            }
            if same {
                return true;
            }
        }
        i = j + 1;
    }
    return false;
}

// Are the members of the set of libraries written in the literal well formed (`parse_scope`): names of letters, digits, `_`,
// `.`, `+` and `-`, none empty, none twice?
fn library_names[&s, &x](st: &!s [int], text: &x [byte], tok: int) -> [] bool {
    let end = last(st, tok);
    var i = first(st, tok);
    while i <= end {
        var j = i;
        while j < end && int_of(text[j]) != 44 {
            let c = int_of(text[j]);
            let fine = c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c == 46 || c == 43 || c == 45;
            if !fine {
                return false;
            }
            j = j + 1;
        }
        if j == i {
            return false;
        }
        var k = first(st, tok);
        while k < i {
            var l = k;
            while l < i - 1 && int_of(text[l]) != 44 {
                l = l + 1;
            }
            if l - k == j - i {
                var same = true;
                var m = 0;
                while m < j - i {
                    if int_of(text[k + m]) != int_of(text[i + m]) {
                        same = false;
                    }
                    m = m + 1;
                }
                if same {
                    return false;
                }
            }
            k = l + 1;
        }
        i = j + 1;
    }
    return true;
}

// `narrow_ffi`: a set of libraries narrows as a set: every library wanted is one held (held nothing: any), and not the
// same set. True if refused. A set that is not well formed is left to `foreign-scope`.
pub fn refused_set[&s, &x](st: &!s [int], text: &x [byte], current: int, target: int, from: int, to: int) -> [] bool {
    if escaped(st, text, current) || escaped(st, text, target) {
        return false;
    }
    if size(st, target) > 0 && !library_names(st, text, target) {
        ast.fail(st, rules.r_foreign_scope(), from, to);
        return true;
    }
    if size(st, target) == 0 {
        if size(st, current) == 0 {
            ast.fail(st, rules.r_capability_not_narrowable(), from, to);
            return true;
        }
        // Nothing wanted is not covered by something held.
        ast.fail(st, rules.r_capability_not_narrowable(), from, to);
        return true;
    }
    if size(st, current) > 0 {
        let end = last(st, target);
        var i = first(st, target);
        while i <= end {
            var j = i;
            while j < end && int_of(text[j]) != 44 {
                j = j + 1;
            }
            if j == i {
                return false;
            }
            if !in_set(st, text, current, i, j) {
                ast.fail(st, rules.r_capability_not_narrowable(), from, to);
                return true;
            }
            i = j + 1;
        }
        if equal(st, text, current, target) {
            ast.fail(st, rules.r_capability_not_narrowable(), from, to);
            return true;
        }
    }
    return false;
}

pub fn is_ffi[&s](st: &!s [int], index: int) -> [] bool {
    return index == netcode.prelude_named("Ffi");
}

// Every literal of `narrow` must be written as one, so that the refinement can be checked where it is written. False if one
// is not (refused).
pub fn literals[&s](st: &!s [int], arg: int, nargs: int) -> [] bool {
    var each = ast.next(st, arg);
    var left = nargs - 1;
    while left > 0 {
        if !ast.is_kind(st, each, kinds.NK::EStr) {
            ast.fail(st, rules.r_capability_not_narrowable(), ast.nstart(st, each), ast.nend(st, each));
            return false;
        }
        each = ast.next(st, each);
        left = left - 1;
    }
    return true;
}

// What `narrow` of a capability of type `cty` to the literals from `lit` (`nargs` - 1 of them) makes of the program:
// 0 nothing to say, 1 refused (noted), 2 not something this checks.
pub fn refused[&s, &x](st: &!s [int], text: &x [byte], cty: int, lit: int, nargs: int, from: int, to: int) -> [] int {
    if types.is_ref(st, cty) {
        // Narrowing consumes what it attenuates: a borrow is the promise to give it back.
        ast.fail(st, rules.r_capability_not_narrowable(), from, to);
        return 1;
    }
    if !types.is_prelude(st, cty) {
        return 2;
    }
    let index = types.prelude_index(st, cty);
    if !narrows(st, index) || nargs > 2 && !narrows_many(st, index) {
        // It carries no value to narrow, or it does not narrow into several.
        ast.fail(st, rules.r_capability_not_narrowable(), from, to);
        return 1;
    }
    let now = types.prelude_lit_tok(st, cty);
    if checked(st, index) {
        var at = lit;
        var seen = 0;
        while seen < nargs - 1 {
            if refused_one(st, text, is_path(st, index), now, ast.get(st, at, 4), ast.nstart(st, at), ast.nend(st, at)) {
                return 1;
            }
            seen = seen + 1;
            at = ast.next(st, at);
        }
        var x = lit;
        var i = 0;
        while i < nargs - 1 {
            var y = ast.next(st, x);
            var j = i + 1;
            while j < nargs - 1 {
                if refused_pair(st, text, is_path(st, index), ast.get(st, x, 4), ast.get(st, y, 4), ast.nstart(st, y), ast.nend(st, y)) {
                    return 1;
                }
                y = ast.next(st, y);
                j = j + 1;
            }
            x = ast.next(st, x);
            i = i + 1;
        }
    }
    if is_ffi(st, index) && refused_set(st, text, now, ast.get(st, lit, 4), from, to) {
        return 1;
    }
    if is_signals(st, index) && refused_signals(st, text, now, ast.get(st, lit, 4), from, to) {
        return 1;
    }
    return 0;
}

// A capability whose only consumer is `release`: the root authorities, which are not taken apart and not destroyed by
// anything else (`released_only`).
pub fn released_only[&s](st: &!s [int], index: int) -> [] bool {
    return index == netcode.prelude_named("World") || index == netcode.prelude_named("Io") || index == netcode.prelude_named("Ffi") || index == netcode.prelude_named("Fs") || index == netcode.prelude_named("Heap") || index == netcode.prelude_named("Args") || is_net(st, index) || index == netcode.prelude_named("Clock") || index == netcode.prelude_named("Signals") || index == netcode.prelude_named("Exec") || index == netcode.prelude_named("Tty");
}

// ---------------------------------------------------------------- listeners ---
//
// `listen.rs`: what a `Net` narrowed to a bound grants a listener. A bound of nothing or of digits is a bare port, which
// says "every interface"; otherwise it is `host:port` (or a host), and the host is one address, `0.0.0.0` (every address),
// or not an address at all, which matches nothing.

// The IPv4 address written in text[a..b], strictly (four decimal octets of one to three digits, none over 255, none with a
// leading zero), or -1.
fn dotted[&x](text: &x [byte], a: int, b: int) -> [] int {
    var value = 0;
    var parts = 0;
    var at = a;
    while at <= b {
        var octet = 0;
        var digits = 0;
        var first = 0 - 1;
        while at < b && int_of(text[at]) != 46 {
            let c = int_of(text[at]);
            if c < 48 || c > 57 {
                return 0 - 1;
            }
            if digits == 0 {
                first = c;
            }
            octet = octet * 10 + c - 48;
            digits = digits + 1;
            at = at + 1;
        }
        if digits == 0 || digits > 3 || octet > 255 || digits > 1 && first == 48 {
            return 0 - 1;
        }
        value = value * 256 + octet;
        parts = parts + 1;
        at = at + 1;
    }
    if parts != 4 {
        return 0 - 1;
    }
    return value;
}

// Is the bound a bare port (or nothing)?
fn plain_port[&s, &x](st: &!s [int], text: &x [byte], bound: int) -> [] bool {
    var i = first(st, bound);
    while i < last(st, bound) {
        let c = int_of(text[i]);
        if c < 48 || c > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// May a listener bind `address` under the bound? A bare port grants every address; `host:port` that host; `0.0.0.0`
// any; a host that is not an address, none.
fn covers[&s, &x](st: &!s [int], text: &x [byte], bound: int, address: int) -> [] bool {
    if plain_port(st, text, bound) {
        return true;
    }
    var colon = last(st, bound);
    var i = last(st, bound) - 1;
    var found = false;
    while i >= first(st, bound) && !found {
        if int_of(text[i]) == 58 {
            colon = i;
            found = true;
        }
        i = i - 1;
    }
    if colon == first(st, bound) {
        return true;
    }
    let only = dotted(text, first(st, bound), colon);
    if only < 0 {
        return false;
    }
    return only == 0 || only == address;
}

// A dial (`connect`, `tcp_connect`, `tcp_connect_start`, `udp_connect`) takes a borrowed `Net` or, from edition 11, an `Out`: never a
// `Ports`, which holds the listening half. True if refused.
pub fn dial_refused[&s](st: &!s [int], which: int, cap: int, from: int, to: int) -> [] bool {
    if which != 33 && which != 37 && which != 110 && which != 129 {
        return false;
    }
    if types.is_ref(st, cap) && types.is_prelude(st, types.ref_inner(st, cap)) && types.prelude_index(st, types.ref_inner(st, cap)) == netcode.prelude_named("Ports") {
        ast.fail(st, rules.r_capability_misused(), from, to);
        return true;
    }
    return false;
}

// A listener (`tcp_listen`, `tcp_listen_on`, `udp_bind`) through the `Net` that was handed over: it must be a borrowed `Net` or `Ports`,
// and what it was narrowed to must grant the interface the call binds: every one for `tcp_listen` and `udp_bind`, the address
// of the literal for `tcp_listen_on`. True if refused.
pub fn listen_refused[&s, &x](st: &!s [int], text: &x [byte], which: int, on: bool, cap: int, address: int, from: int, to: int) -> [] bool {
    if which != 36 && which != 130 {
        return false;
    }
    if !types.is_ref(st, cap) || !types.is_prelude(st, types.ref_inner(st, cap)) || (types.prelude_index(st, types.ref_inner(st, cap)) != netcode.prelude_named("Net") && types.prelude_index(st, types.ref_inner(st, cap)) != netcode.prelude_named("Ports")) {
        ast.fail(st, rules.r_capability_misused(), from, to);
        return true;
    }
    let bound = types.prelude_lit_tok(st, types.ref_inner(st, cap));
    if escaped(st, text, bound) {
        return false;
    }
    if on && !covers(st, text, bound, address) || !on && !plain_port(st, text, bound) {
        ast.fail(st, rules.r_listen_host(), from, to);
        return true;
    }
    return false;
}

// A set of signals (`signals.rs`): each name one a program may claim, none twice, strictly inside what is held (nothing held:
// every claimable one). True if refused.
pub fn refused_signals[&s, &x](st: &!s [int], text: &x [byte], current: int, target: int, from: int, to: int) -> [] bool {
    if escaped(st, text, current) || escaped(st, text, target) {
        return false;
    }
    var wanted = 0;
    let end = last(st, target);
    var i = first(st, target);
    if size(st, target) == 0 {
        ast.fail(st, rules.r_signal_not_claimable(), from, to);
        return true;
    }
    while i <= end {
        var j = i;
        while j < end && int_of(text[j]) != 44 {
            j = j + 1;
        }
        let bit = netcode.signal_bit(text, i, j);
        if bit == 0 || wanted & bit != 0 {
            ast.fail(st, rules.r_signal_not_claimable(), from, to);
            return true;
        }
        wanted = wanted | bit;
        i = j + 1;
    }
    var held = 255;
    if size(st, current) > 0 {
        held = 0;
        let stop = last(st, current);
        var at = first(st, current);
        while at <= stop {
            var j = at;
            while j < stop && int_of(text[j]) != 44 {
                j = j + 1;
            }
            held = held | netcode.signal_bit(text, at, j);
            at = j + 1;
        }
    }
    if wanted | held != held || size(st, current) > 0 && wanted == held {
        ast.fail(st, rules.r_capability_not_narrowable(), from, to);
        return true;
    }
    return false;
}

pub fn is_signals[&s](st: &!s [int], index: int) -> [] bool {
    return index == netcode.prelude_named("Signals");
}

// A value of this type is certainly too big to be given to a thread or to come back from one: more than one leaf (an
// aggregate, a float, a slice). Other types it may carry are left to the code that is written for them.
pub fn cannot_cross[&s](st: &!s [int], ty: int) -> [] bool {
    return types.is_named(st, ty) || types.is_tuple(st, ty) || ty == 3 || ty == 4 || types.is_slice_ref(st, ty);
}
