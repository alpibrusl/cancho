edition 7;
module selfhost.clici;

// clici.cho -- `cancho ci`, written in cancho (`docs/agent-ci.md`, slice 1): the gate as one command.
//
//     ci [--output json] [--std-dir DIR] [--test FILE]... FILE...
//
// Three steps, each a run of this same command line as a child, so that `ci` says what `fmt --check`, `check --output json` and `test` say and nothing
// they do not: `fmt` over every file named, `check` over the program (the FILEs; skipped, because `no-program`, when only `--test` files are named), and `test` over the
// `--test` files (named in full, as `cancho test` takes them). The test step is skipped, not failed a second time, when `check` failed, and it is skipped
// when no `--test` file is named. Every step that can run does.
//
// The answer is one object: `ok`, and the steps, each with its `status` (`pass`, `fail`, `skipped`) and, for a failure, its `findings`. A finding of
// `ci`'s own is `{ "rule": "ci-...", "message": "..." }`; a finding of `check` is the refusal `check --output json` printed, unchanged. Without
// `--output json` the same steps are one line each.
//
// Exit status: 0 every step passed, 1 a finding, 2 the command line was wrong, 3 a step could not be run, 4 `test` failed and nothing before it did
// (the first failing step's status wins, in the order fmt, check, test).

import std.buffer;
import std.bytes;
import std.io as console;
import selfhost.lexcore as lc;
import selfhost.jsonwrite;
import selfhost.clibase;
import selfhost.cliprog;
import selfhost.cibase;
import selfhost.filewrite;
import selfhost.jsonread;

// One step: its JSON object, its status (0 pass, 1 fail, 2 skipped) and the exit status it contributes (0, 1, 3 or 4).
pub res struct Step {
    json: buffer.Buffer,
    status: int,
    code: int,
}

// `{ "rule": R, "message": M }` appended to `items` (a comma first if it is not the first of `count`).
fn finding[&h, &r, &m](heap: &!h Heap, items: buffer.Buffer, count: int, rule: &r [byte], message: &m [byte]) -> [heap] (buffer.Buffer, int) {
    var out = items;
    if count > 0 {
        out = buffer.append(heap, out, ", ");
    }
    out = buffer.append(heap, out, "{ \"rule\": ");
    out = jsonwrite.string(heap, out, rule);
    out = buffer.append(heap, out, ", \"message\": ");
    out = jsonwrite.string(heap, out, message);
    out = buffer.append(heap, out, " }");
    return (out, count + 1);
}

// Each non-empty line of `text` (that has `only` in it, if that is not empty) as a finding of `rule`.
fn lines_into[&h, &t, &r, &o](heap: &!h Heap, items: buffer.Buffer, count: int, text: &t [byte], rule: &r [byte], only: &o [byte]) -> [heap] (buffer.Buffer, int) {
    var out = items;
    var n = count;
    var start = 0;
    var at = 0;
    while at <= len(text) {
        if at == len(text) || int_of(text[at]) == 10 {
            if at > start && (len(only) == 0 || clibase.contains(text[start..at], only)) {
                let (o, k) = finding(heap, out, n, rule, text[start..at]);
                out = o;
                n = k;
            }
            start = at + 1;
        }
        at = at + 1;
    }
    return (out, n);
}

// `{ "name": N, "status": S, "findings": [ ITEMS ] }`, or for a skipped step `{ "name": N, "status": "skipped", "because": B }`.
fn step_object[&h, &n, &s, &b](heap: &!h Heap, name: &n [byte], status: &s [byte], items: buffer.Buffer, because: &b [byte]) -> [heap] buffer.Buffer {
    var out = buffer.append(heap, buffer.empty(heap, 256), "{ \"name\": ");
    out = jsonwrite.string(heap, out, name);
    out = buffer.append(heap, out, ", \"status\": ");
    out = jsonwrite.string(heap, out, status);
    var has = false;
    borrow items as &hb in {
        has = buffer.size(hb) > 0;
    }
    if len(because) > 0 {
        out = buffer.append(heap, out, ", \"because\": ");
        out = jsonwrite.string(heap, out, because);
    } else if has || bytes.equal(status, "fail") {
        out = buffer.append(heap, out, ", \"findings\": [ ");
        borrow items as &ib in {
            out = buffer.append(heap, out, buffer.bytes(ib));
        }
        out = buffer.append(heap, out, " ]");
    }
    buffer.drop(heap, items);
    return buffer.append(heap, out, " }");
}

fn skipped[&h, &n, &b](heap: &!h Heap, name: &n [byte], because: &b [byte]) -> [heap] Step {
    return Step { json: step_object(heap, name, "skipped", buffer.empty(heap, 0), because), status: 2, code: 0 };
}

// The words of a child's command line, each followed by a NUL: `command` (already NUL-terminated words), then `--std-dir D` if given, then the files
// `which` selects: 0 the FILEs, 1 the `--test` files, 2 both.
fn words[&h, &a, &c](heap: &!h Heap, args: &a Args, command: &c [byte], which: int) -> [heap, args] buffer.Buffer {
    var out = buffer.append(heap, buffer.empty(heap, 256), command);
    var n = 2;
    var testing = false;
    while n < arg_count(args) {
        let word = arg(args, n);
        if bytes.equal(word, "--output") || bytes.equal(word, "--reason") {
            n = n + 1;
        } else if bytes.equal(word, "--std-dir") {
            n = n + 1;
            out = buffer.append(heap, buffer.append(heap, out, "--std-dir\0"), arg(args, n));
            out = buffer.append(heap, out, "\0");
        } else if bytes.equal(word, "--test") {
            n = n + 1;
            if which >= 1 {
                out = buffer.append(heap, buffer.append(heap, out, arg(args, n)), "\0");
            }
        } else if len(word) > 0 && lc.at(word, 0) == '-' {
            testing = testing;
        } else if which != 1 {
            out = buffer.append(heap, buffer.append(heap, out, word), "\0");
        }
        n = n + 1;
    }
    return out;
}

// This command line, run as a child with `argv`: what it wrote and how it ended (`cliprog.Captured`).
fn child_run[&h, &i, &x, &c, &a](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, args: &a Args, argv: buffer.Buffer) -> [heap, err_write, args, exec(""), clock, poll] cliprog.Captured {
    var held_out = buffer.empty(heap, 0);
    var held_err = buffer.empty(heap, 0);
    var held_kind = 5;
    var held_value = 0;
    borrow argv as &ab in {
        let got = cliprog.run_capture(heap, io, exec, clock, arg(args, 0), "", buffer.bytes(ab));
        let cliprog.Captured { out, err, kind, value } = got;
        buffer.drop(heap, held_out);
        buffer.drop(heap, held_err);
        held_out = out;
        held_err = err;
        held_kind = kind;
        held_value = value;
    }
    buffer.drop(heap, argv);
    return cliprog.Captured { out: held_out, err: held_err, kind: held_kind, value: held_value };
}

// A step whose child did not run to an exit status: status 3 and one finding.
fn unrunnable[&h, &n](heap: &!h Heap, name: &n [byte]) -> [heap] Step {
    let (items, count) = finding(heap, buffer.empty(heap, 128), 0, "ci-step-unrunnable", "the step could not be run or did not end by itself");
    return Step { json: step_object(heap, name, "fail", items, ""), status: 1, code: 3 };
}

fn fmt_step[&h, &i, &x, &c, &a](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, args: &a Args) -> [heap, err_write, args, exec(""), clock, poll] Step {
    let got = child_run(heap, io, exec, clock, args, words(heap, args, "fmt\0--check\0", 2));
    let cliprog.Captured { out, err, kind, value } = got;
    var body = buffer.empty(heap, 0);
    var st = 0;
    var cd = 0;
    if kind != 0 || value > 1 {
        buffer.drop(heap, body);
        let (ub, us, uc) = unpack(unrunnable(heap, "fmt"));
        body = ub;
        st = us;
        cd = uc;
    } else if value == 0 {
        buffer.drop(heap, body);
        body = step_object(heap, "fmt", "pass", buffer.empty(heap, 0), "");
        st = 0;
        cd = 0;
    } else {
        var items = buffer.empty(heap, 256);
        var count = 0;
        borrow out as &ob in {
            let (o, k) = lines_into(heap, items, count, buffer.bytes(ob), "ci-not-formatted", "");
            items = o;
            count = k;
        }
        borrow err as &eb in {
            let (o, k) = lines_into(heap, items, count, buffer.bytes(eb), "ci-fmt-refused", "");
            items = o;
            count = k;
        }
        buffer.drop(heap, body);
        body = step_object(heap, "fmt", "fail", items, "");
        st = 1;
        cd = 1;
    }
    buffer.drop(heap, out);
    buffer.drop(heap, err);
    return Step { json: body, status: st, code: cd };
}

// The array inside `check --output json`'s answer (from its first `[` to its last `]`), as findings; the whole answer as one finding if it has none.
fn check_findings[&h, &t](heap: &!h Heap, items: buffer.Buffer, text: &t [byte]) -> [heap] buffer.Buffer {
    var first = 0 - 1;
    var last = 0 - 1;
    var at = 0;
    while at < len(text) {
        if int_of(text[at]) == 91 && first < 0 {
            first = at;
        }
        if int_of(text[at]) == 93 {
            last = at;
        }
        at = at + 1;
    }
    if first >= 0 && last > first + 1 {
        return buffer.append(heap, items, text[first + 1..last]);
    }
    let (o, k) = finding(heap, items, 0, "ci-check-unreadable", text);
    return o;
}

fn check_step[&h, &i, &x, &c, &a](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, args: &a Args, files: int) -> [heap, err_write, args, exec(""), clock, poll] Step {
    if files == 0 {
        return skipped(heap, "check", "no-program");
    }
    let got = child_run(heap, io, exec, clock, args, words(heap, args, "check\0--output\0json\0", 0));
    let cliprog.Captured { out, err, kind, value } = got;
    var body = buffer.empty(heap, 0);
    var st = 0;
    var cd = 0;
    if kind != 0 || value > 1 {
        buffer.drop(heap, body);
        let (ub, us, uc) = unpack(unrunnable(heap, "check"));
        body = ub;
        st = us;
        cd = uc;
    } else if value == 0 {
        buffer.drop(heap, body);
        body = step_object(heap, "check", "pass", buffer.empty(heap, 0), "");
        st = 0;
        cd = 0;
    } else {
        var items = buffer.empty(heap, 256);
        borrow out as &ob in {
            items = check_findings(heap, items, buffer.bytes(ob));
        }
        buffer.drop(heap, body);
        body = step_object(heap, "check", "fail", items, "");
        st = 1;
        cd = 1;
    }
    buffer.drop(heap, out);
    buffer.drop(heap, err);
    return Step { json: body, status: st, code: cd };
}

fn test_step[&h, &i, &x, &c, &a](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, args: &a Args) -> [heap, err_write, args, exec(""), clock, poll] Step {
    let got = child_run(heap, io, exec, clock, args, words(heap, args, "test\0", 1));
    let cliprog.Captured { out, err, kind, value } = got;
    var body = buffer.empty(heap, 0);
    var st = 0;
    var cd = 0;
    if kind != 0 || value == 3 || value > 4 {
        buffer.drop(heap, body);
        let (ub, us, uc) = unpack(unrunnable(heap, "test"));
        body = ub;
        st = us;
        cd = uc;
    } else if value == 0 {
        buffer.drop(heap, body);
        body = step_object(heap, "test", "pass", buffer.empty(heap, 0), "");
        st = 0;
        cd = 0;
    } else {
        var rule = "ci-test-failed";
        if value == 1 {
            rule = "ci-test-refused";
        } else if value == 2 {
            rule = "ci-no-tests";
        }
        var items = buffer.empty(heap, 256);
        var count = 0;
        borrow out as &ob in {
            let (o, k) = lines_into(heap, items, count, buffer.bytes(ob), rule, " ... FAILED");
            items = o;
            count = k;
        }
        borrow err as &eb in {
            let (o, k) = lines_into(heap, items, count, buffer.bytes(eb), rule, "");
            items = o;
            count = k;
        }
        if count == 0 {
            let (o, k) = finding(heap, items, count, rule, "the test run failed and said nothing");
            items = o;
            count = k;
        }
        var code = 1;
        if value == 4 {
            code = 4;
        }
        buffer.drop(heap, body);
        body = step_object(heap, "test", "fail", items, "");
        st = 1;
        cd = code;
    }
    buffer.drop(heap, out);
    buffer.drop(heap, err);
    return Step { json: body, status: st, code: cd };
}

fn unpack(step: Step) -> [] (buffer.Buffer, int, int) {
    let Step { json, status, code } = step;
    return (json, status, code);
}

// The test step if `check` passed and there are test files, else the reason it is not run.
fn test_or_skip[&h, &i, &x, &c, &a](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, args: &a Args, check_status: int, tests: int) -> [heap, err_write, args, exec(""), clock, poll] Step {
    if check_status == 1 {
        return skipped(heap, "test", "check");
    }
    if tests == 0 {
        return skipped(heap, "test", "no-tests");
    }
    return test_step(heap, io, exec, clock, args);
}

// ---- the authority baseline (`docs/agent-ci.md` section 3) ----
//
// `authority --output json` prints one key to a line, and the baseline is written in the same lines, so both are read the same way: as FACTS, one to a
// line of text (`bounded=true`, `label:{ "name": ... }`, `never:the heap`, `symbol:...`, `unbounded:...`), and a change is a fact in one set and not the other.
// `pure`, `functions`, `effects` and the folding counts are not facts: they move with every refactor, and the labels they would restate are kept.

fn starts[&t, &w](t: &t [byte], word: &w [byte]) -> [] bool {
    return len(t) >= len(word) && lc.spells(t, 0, len(word), word);
}

// `t` without the spaces at its ends and a carriage return.
fn trim[&t](t: &t [byte]) -> [] &t [byte] {
    var a = 0;
    var b = len(t);
    while a < b && (int_of(t[a]) == 32 || int_of(t[a]) == 9) {
        a = a + 1;
    }
    while b > a && (int_of(t[b - 1]) == 32 || int_of(t[b - 1]) == 13) {
        b = b - 1;
    }
    return t[a..b];
}

fn no_comma[&t](t: &t [byte]) -> [] &t [byte] {
    if len(t) > 0 && int_of(t[len(t) - 1]) == 44 {
        return t[0..len(t) - 1];
    }
    return t;
}

// Each string between quotes after the first `[` of `t`, as a fact with `prefix`.
fn quoted_facts[&h, &t, &p](heap: &!h Heap, facts: buffer.Buffer, t: &t [byte], prefix: &p [byte]) -> [heap] buffer.Buffer {
    var out = facts;
    var i = 0;
    while i < len(t) && int_of(t[i]) != 91 {
        i = i + 1;
    }
    var open = false;
    var from = 0;
    while i < len(t) {
        if int_of(t[i]) == 34 {
            if open {
                out = buffer.push(heap, buffer.append(heap, buffer.append(heap, out, prefix), t[from..i]), byte_of(10));
                open = false;
            } else {
                open = true;
                from = i + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn fact[&h, &p, &t](heap: &!h Heap, facts: buffer.Buffer, prefix: &p [byte], t: &t [byte]) -> [heap] buffer.Buffer {
    return buffer.push(heap, buffer.append(heap, buffer.append(heap, facts, prefix), t), byte_of(10));
}

// The facts of `text` (a report or a baseline), and the lines of it that belong in a baseline, as they are.
fn scan[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] (buffer.Buffer, buffer.Buffer) {
    var facts = buffer.empty(heap, 256);
    var kept = buffer.empty(heap, 256);
    var section = 0;
    var start = 0;
    var at = 0;
    while at <= len(text) {
        if at == len(text) || int_of(text[at]) == 10 {
            let line = text[start..at];
            let t = trim(line);
            if starts(t, "\"bounded\": ") {
                facts = fact(heap, facts, "bounded=", no_comma(t[11..len(t)]));
                kept = buffer.push(heap, buffer.append(heap, kept, no_return(line)), byte_of(10));
            } else if starts(t, "\"unbounded_by\": [") {
                kept = buffer.push(heap, buffer.append(heap, kept, no_return(line)), byte_of(10));
                if int_of(no_comma(t)[len(no_comma(t)) - 1]) == 91 {
                    section = 1;
                }
            } else if starts(t, "\"labels\": [") {
                kept = buffer.push(heap, buffer.append(heap, kept, no_return(line)), byte_of(10));
                section = 2;
            } else if starts(t, "\"never_touches\": [") {
                kept = buffer.push(heap, buffer.append(heap, kept, no_return(line)), byte_of(10));
                facts = quoted_facts(heap, facts, t, "never:");
            } else if starts(t, "\"foreign_symbols\": [") {
                kept = buffer.push(heap, buffer.append(heap, kept, no_return(line)), byte_of(10));
                facts = quoted_facts(heap, facts, t, "symbol:");
            } else if section == 1 && len(t) > 0 {
                kept = buffer.push(heap, buffer.append(heap, kept, no_return(line)), byte_of(10));
                if int_of(t[0]) == 93 {
                    section = 0;
                } else {
                    facts = fact(heap, facts, "unbounded:", no_comma(t));
                }
            } else if section == 2 && len(t) > 0 {
                kept = buffer.push(heap, buffer.append(heap, kept, no_return(line)), byte_of(10));
                if int_of(t[0]) == 93 {
                    section = 0;
                } else if int_of(t[0]) == 123 {
                    facts = fact(heap, facts, "label:", no_comma(t));
                }
            }
            start = at + 1;
        }
        at = at + 1;
    }
    return (facts, kept);
}

fn no_return[&t](t: &t [byte]) -> [] &t [byte] {
    if len(t) > 0 && int_of(t[len(t) - 1]) == 13 {
        return t[0..len(t) - 1];
    }
    return t;
}

// Whether `line` is one whole line of `set`.
fn has_line[&s, &l](set: &s [byte], line: &l [byte]) -> [] bool {
    var start = 0;
    var at = 0;
    while at <= len(set) {
        if at == len(set) || int_of(set[at]) == 10 {
            if at - start == len(line) && lc.spells(set, start, at, line) {
                return true;
            }
            start = at + 1;
        }
        at = at + 1;
    }
    return false;
}

// What comparing a baseline with a run found: the findings, the entries of `accepted` for what widened, and how many widened and narrowed.
res struct Diff {
    items: buffer.Buffer,
    accepted: buffer.Buffer,
    count: int,
    widened: int,
    narrowed: int,
}

// One fact that is in one set and not the other: `added` if it is in the run and not in the baseline. A domain in `never_touches` is the other way
// round: one that is no longer there is a widening.
fn classify[&h, &l, &r](heap: &!h Heap, diff: Diff, line: &l [byte], added: bool, reason: &r [byte]) -> [heap] Diff {
    let Diff { items, accepted, count, widened, narrowed } = diff;
    var kind = 0;
    if starts(line, "never:") {
        if added {
            kind = 2;
        } else {
            kind = 1;
        }
    } else if starts(line, "bounded=") {
        if added && starts(line, "bounded=false") {
            kind = 3;
        } else if added {
            kind = 2;
        }
    } else if added {
        kind = 1;
    } else {
        kind = 2;
    }
    var more_items = items;
    var more_accepted = accepted;
    var n = count;
    var wide = widened;
    var narrow = narrowed;
    if kind == 1 || kind == 3 {
        var message = buffer.append(heap, buffer.empty(heap, 64), "authority widened: ");
        if starts(line, "never:") {
            message = buffer.append(heap, message, "no longer proven out of reach: ");
        }
        message = buffer.append(heap, message, line);
        var rule = "ci-authority-widened";
        if kind == 3 {
            rule = "ci-authority-unbounded";
        }
        borrow message as &mb in {
            let (o, k) = finding(heap, more_items, n, rule, buffer.bytes(mb));
            more_items = o;
            n = k;
        }
        buffer.drop(heap, message);
        if wide > 0 {
            more_accepted = buffer.append(heap, more_accepted, ",\n    ");
        }
        more_accepted = buffer.append(heap, more_accepted, "{ \"fact\": ");
        more_accepted = jsonwrite.string(heap, more_accepted, line);
        more_accepted = buffer.append(heap, more_accepted, ", \"reason\": ");
        more_accepted = jsonwrite.string(heap, more_accepted, reason);
        more_accepted = buffer.append(heap, more_accepted, " }");
        wide = wide + 1;
    } else if kind == 2 {
        var message = buffer.append(heap, buffer.empty(heap, 64), "authority narrowed: ");
        message = buffer.append(heap, message, line);
        borrow message as &mb in {
            let (o, k) = finding(heap, more_items, n, "ci-authority-narrowed", buffer.bytes(mb));
            more_items = o;
            n = k;
        }
        buffer.drop(heap, message);
        narrow = narrow + 1;
    }
    return Diff { items: more_items, accepted: more_accepted, count: n, widened: wide, narrowed: narrow };
}

// Every line of `from` that `other` lacks.
fn pass[&h, &f, &o, &r](heap: &!h Heap, diff: Diff, from: &f [byte], other: &o [byte], added: bool, reason: &r [byte]) -> [heap] Diff {
    var now = diff;
    var start = 0;
    var at = 0;
    while at <= len(from) {
        if at == len(from) || int_of(from[at]) == 10 {
            if at > start && !has_line(other, from[start..at]) {
                now = classify(heap, now, from[start..at], added, reason);
            }
            start = at + 1;
        }
        at = at + 1;
    }
    return now;
}

// The entries of `accepted` a baseline already has, each as it is, joined by the separator the file uses.
fn old_accepted[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 64);
    var first = true;
    var start = 0;
    var at = 0;
    while at <= len(text) {
        if at == len(text) || int_of(text[at]) == 10 {
            let t = trim(text[start..at]);
            if starts(t, "{ \"fact\"") {
                if !first {
                    out = buffer.append(heap, out, ",\n    ");
                }
                out = buffer.append(heap, out, no_comma(t));
                first = false;
            }
            start = at + 1;
        }
        at = at + 1;
    }
    return out;
}

fn valid_json[&h, &t](heap: &!h Heap, text: &t [byte]) -> [heap] bool {
    let area = box_slice(heap, jsonread.size_for(text), 0);
    var good = false;
    borrow mut area as &!ab in {
        let jm = contents(ab);
        good = jsonread.read(jm, text) == 0;
    }
    unbox_slice(heap, area);
    return good;
}

// The baseline file for `name`: the kept lines of a run, and the entries of `accepted`.
fn baseline_text[&h, &n, &k, &o, &e](heap: &!h Heap, name: &n [byte], kept: &k [byte], old: &o [byte], fresh: &e [byte]) -> [heap] buffer.Buffer {
    var out = buffer.append(heap, buffer.empty(heap, 1024), "{\n  \"format\": 1,\n  \"program\": ");
    out = jsonwrite.string(heap, out, name);
    out = buffer.append(heap, out, ",\n");
    out = buffer.append(heap, out, kept);
    if len(old) + len(fresh) == 0 {
        return buffer.append(heap, out, "  \"accepted\": []\n}\n");
    }
    out = buffer.append(heap, out, "  \"accepted\": [\n    ");
    out = buffer.append(heap, out, old);
    if len(old) > 0 && len(fresh) > 0 {
        out = buffer.append(heap, out, ",\n    ");
    }
    out = buffer.append(heap, out, fresh);
    return buffer.append(heap, out, "\n  ]\n}\n");
}

// The authority step: the run's facts against the baseline's, or the baseline written (`--accept-authority`).
fn judge[&h, &f, &n, &r](heap: &!h Heap, fs: &f Fs(""), name: &n [byte], facts: buffer.Buffer, kept: buffer.Buffer, strict: bool, accept: bool, reason: &r [byte]) -> [heap, fs_read(""), fs_write(""), file_read, file_write] Step {
    let (base, failed) = cibase.read(heap, fs);
    var diff = Diff { items: buffer.empty(heap, 256), accepted: buffer.empty(heap, 64), count: 0, widened: 0, narrowed: 0 };
    var old = buffer.empty(heap, 0);
    // 0 there is no baseline, 1 it cannot be read, 2 it is another program's, 3 it is this one's.
    var state = 0;
    if failed == 2 {
        state = 0;
    } else if failed != 0 {
        state = 1;
    } else {
        borrow base as &bb in {
            let text = buffer.bytes(bb);
            var expected = buffer.append(heap, buffer.empty(heap, 64), "  \"program\": ");
            expected = jsonwrite.string(heap, expected, name);
            expected = buffer.append(heap, expected, ",");
            if !valid_json(heap, text) || !has_line(text, "  \"format\": 1,") {
                state = 1;
            } else {
                var same = false;
                borrow expected as &xb in {
                    same = has_line(text, buffer.bytes(xb));
                }
                if same {
                    state = 3;
                    let (base_facts, base_kept) = scan(heap, text);
                    buffer.drop(heap, base_kept);
                    buffer.drop(heap, old);
                    old = old_accepted(heap, text);
                    borrow base_facts as &bf in {
                        borrow facts as &cf in {
                            diff = pass(heap, diff, buffer.bytes(cf), buffer.bytes(bf), true, reason);
                            diff = pass(heap, diff, buffer.bytes(bf), buffer.bytes(cf), false, reason);
                        }
                    }
                    buffer.drop(heap, base_facts);
                } else {
                    state = 2;
                }
            }
            buffer.drop(heap, expected);
        }
    }
    buffer.drop(heap, base);
    let Diff { items, accepted, count, widened, narrowed } = diff;
    var shown = items;
    var n = count;
    var fail = false;
    var code = 1;
    if state == 1 {
        let (o, k) = finding(heap, shown, n, "ci-baseline-unreadable", "cancho.authority.json is not a baseline this command line reads (format 1)");
        shown = o;
        n = k;
        fail = true;
    } else if state == 2 {
        let (o, k) = finding(heap, shown, n, "ci-authority-baseline-stale", "cancho.authority.json is the baseline of another program");
        shown = o;
        n = k;
        fail = true;
    } else if accept {
        // What widened is the record in `accepted`; the findings of the comparison are not an answer to an acceptance.
        buffer.drop(heap, shown);
        shown = buffer.empty(heap, 128);
        n = 0;
        var out = buffer.empty(heap, 0);
        borrow kept as &kb in {
            borrow old as &ob in {
                borrow accepted as &ab in {
                    buffer.drop(heap, out);
                    out = baseline_text(heap, name, buffer.bytes(kb), buffer.bytes(ob), buffer.bytes(ab));
                }
            }
        }
        var wrote = 1;
        borrow out as &wb in {
            wrote = filewrite.store(fs, cibase.file_name(), buffer.bytes(wb));
        }
        buffer.drop(heap, out);
        if wrote != 0 {
            let (o, k) = finding(heap, shown, n, "ci-authority-unwritable", "cancho.authority.json could not be written");
            shown = o;
            n = k;
            fail = true;
            code = 3;
        } else {
            let (o, k) = finding(heap, shown, n, "ci-authority-accepted", "cancho.authority.json written from this run");
            shown = o;
            n = k;
        }
    } else if state == 0 {
        let (o, k) = finding(heap, shown, n, "ci-authority-baseline-missing", "no cancho.authority.json; record one with `ci --accept-authority --reason WHY`");
        shown = o;
        n = k;
        fail = true;
    } else if widened > 0 || strict && narrowed > 0 {
        fail = true;
    }
    buffer.drop(heap, accepted);
    buffer.drop(heap, old);
    buffer.drop(heap, facts);
    buffer.drop(heap, kept);
    if fail {
        return Step { json: step_object(heap, "authority", "fail", shown, ""), status: 1, code: code };
    }
    return Step { json: step_object(heap, "authority", "pass", shown, ""), status: 0, code: 0 };
}

fn authority_step[&h, &i, &x, &c, &a, &f, &r](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, args: &a Args, fs: &f Fs(""), files: int, check_status: int, strict: bool, accept: bool, reason: &r [byte]) -> [heap, err_write, args, fs_read(""), fs_write(""), file_read, file_write, exec(""), clock, poll] Step {
    if files == 0 {
        return skipped(heap, "authority", "no-program");
    }
    if check_status != 0 {
        return skipped(heap, "authority", "check");
    }
    let got = child_run(heap, io, exec, clock, args, words(heap, args, "authority\0--output\0json\0", 0));
    let cliprog.Captured { out, err, kind, value } = got;
    buffer.drop(heap, err);
    if kind != 0 || value != 0 {
        buffer.drop(heap, out);
        return unrunnable(heap, "authority");
    }
    var facts = buffer.empty(heap, 0);
    var kept = buffer.empty(heap, 0);
    borrow out as &ob in {
        let (fa, ke) = scan(heap, buffer.bytes(ob));
        buffer.drop(heap, facts);
        buffer.drop(heap, kept);
        facts = fa;
        kept = ke;
    }
    buffer.drop(heap, out);
    return judge(heap, fs, clibase.stem(arg(args, first_file(args))), facts, kept, strict, accept, reason);
}

// Where the first FILE is among the arguments (it is there: `ci` has refused a command line with none).
fn first_file[&a](args: &a Args) -> [args] int {
    var n = 2;
    while n < arg_count(args) {
        let word = arg(args, n);
        if bytes.equal(word, "--output") || bytes.equal(word, "--std-dir") || bytes.equal(word, "--test") || bytes.equal(word, "--reason") {
            n = n + 1;
        } else if len(word) > 0 && lc.at(word, 0) == '-' {
            n = n + 0;
        } else {
            return n;
        }
        n = n + 1;
    }
    return 2;
}

fn status_word(status: int) -> [] &static [byte] {
    if status == 0 {
        return "pass";
    }
    if status == 1 {
        return "fail";
    }
    return "skipped";
}

pub fn ci_command[&h, &i, &a, &f, &x, &c](heap: &!h Heap, io: &!i Io, args: &a Args, fs: &f Fs(""), exec: &x Exec(""), clock: &c Clock) -> [heap, io_write, err_write, args, fs_read(""), fs_write(""), file_read, file_write, exec(""), clock, poll] int {
    var json = false;
    var strict = false;
    var accept = false;
    var reason_at = 0 - 1;
    var files = 0;
    var tests = 0;
    var n = 2;
    while n < arg_count(args) {
        let word = arg(args, n);
        if bytes.equal(word, "--output") {
            n = n + 1;
            if n < arg_count(args) && bytes.equal(arg(args, n), "json") {
                json = true;
            } else {
                return clibase.usage_error(heap, io, "`--output` needs `json`");
            }
        } else if bytes.equal(word, "--std-dir") {
            n = n + 1;
            if n >= arg_count(args) {
                return clibase.usage_error(heap, io, "`--std-dir` needs a directory");
            }
        } else if bytes.equal(word, "--strict") {
            strict = true;
        } else if bytes.equal(word, "--accept-authority") {
            accept = true;
        } else if bytes.equal(word, "--reason") {
            n = n + 1;
            if n >= arg_count(args) || len(arg(args, n)) == 0 {
                return clibase.usage_error(heap, io, "`--reason` needs the reason, as text");
            }
            reason_at = n;
        } else if bytes.equal(word, "--test") {
            n = n + 1;
            if n >= arg_count(args) {
                return clibase.usage_error(heap, io, "`--test` needs a file");
            }
            tests = tests + 1;
        } else if len(word) > 0 && lc.at(word, 0) == '-' {
            return clibase.unknown_option(heap, io, word);
        } else {
            files = files + 1;
        }
        n = n + 1;
    }
    // The steps are runs of this command line, found by the name it was run by; a name with `..` in it is refused by `Exec` (`docs/cli-in-cancho.md` section 40).
    if clibase.contains(arg(args, 0), "..") {
        console.error_all(io, "ci-self-path: `ci` runs this command line again, and cannot by a name with `..` in it; run it by a path without\n");
        return 3;
    }
    if files + tests == 0 {
        return clibase.usage_error(heap, io, "no file given");
    }
    if accept && reason_at < 0 {
        console.error_all(io, "ci-accept-needs-reason: `--accept-authority` needs `--reason WHY`, which is written beside what it admits\n");
        return 2;
    }
    if reason_at >= 0 && !accept {
        return clibase.usage_error(heap, io, "`--reason` is for `--accept-authority`");
    }
    var reason = "";
    if reason_at >= 0 {
        reason = arg(args, reason_at);
    }
    let (fj, fst, fc) = unpack(fmt_step(heap, io, exec, clock, args));
    let (cj, cst, cc) = unpack(check_step(heap, io, exec, clock, args, files));
    let (tj, tst, tc) = unpack(test_or_skip(heap, io, exec, clock, args, cst, tests));
    let (aj, ast, ac) = unpack(authority_step(heap, io, exec, clock, args, fs, files, cst, strict, accept, reason));
    var status = ac;
    if fc != 0 {
        status = fc;
    } else if cc != 0 {
        status = cc;
    } else if tc != 0 {
        status = tc;
    }
    var report = buffer.empty(heap, 512);
    if json {
        report = buffer.append(heap, report, "{ \"ok\": ");
        if status == 0 {
            report = buffer.append(heap, report, "true");
        } else {
            report = buffer.append(heap, report, "false");
        }
        report = buffer.append(heap, report, ", \"steps\": [ ");
        borrow fj as &fb in {
            report = buffer.append(heap, report, buffer.bytes(fb));
        }
        report = buffer.append(heap, report, ", ");
        borrow cj as &cb in {
            report = buffer.append(heap, report, buffer.bytes(cb));
        }
        report = buffer.append(heap, report, ", ");
        borrow tj as &tb in {
            report = buffer.append(heap, report, buffer.bytes(tb));
        }
        report = buffer.append(heap, report, ", ");
        borrow aj as &ab in {
            report = buffer.append(heap, report, buffer.bytes(ab));
        }
        report = buffer.append(heap, report, " ] }\n");
    } else {
        report = buffer.append(heap, report, "fmt ");
        report = buffer.append(heap, report, status_word(fst));
        report = buffer.append(heap, report, "\ncheck ");
        report = buffer.append(heap, report, status_word(cst));
        report = buffer.append(heap, report, "\ntest ");
        report = buffer.append(heap, report, status_word(tst));
        report = buffer.append(heap, report, "\nauthority ");
        report = buffer.append(heap, report, status_word(ast));
        report = buffer.append(heap, report, "\n");
    }
    buffer.drop(heap, fj);
    buffer.drop(heap, cj);
    buffer.drop(heap, tj);
    buffer.drop(heap, aj);
    clibase.show(heap, io, report);
    return status;
}
