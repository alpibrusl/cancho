module selfhost.netcode;

// netcode.cho -- the code for the sockets and the clock: calls of the functions of `runtime/net.c`, whose
// arguments are on the argument stack, and the answers made into the values of the language.
//
// A function that answers a tag, a handle or a count, and a reason writes the three to a cell of three whole
// numbers, which become the leaves of the prelude enum (`Dialed`, `Accepted`, `Received`, `Sent`, `Listening`).

import std.bytes;
import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.types;
import selfhost.emit;
import selfhost.tables;

// The index of the prelude type called `name`, or -1.
pub fn prelude_named(name: &static [byte]) -> [] int {
    var i = 0;
    while i < tables.prelude_count() {
        if bytes.equal(tables.prelude_name(i), name) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// A cell of five whole numbers, in the entry block; its temporary.
fn cell[&s](st: &!s [int]) -> [] int {
    let keep = st[49];
    st[49] = 2;
    let n = emit.fresh(st);
    emit.str(st, "  ");
    emit.temp(st, n);
    emit.str(st, " = alloca i64, i64 5\n");
    st[49] = keep;
    return n;
}

fn arguments[&s](st: &!s [int], n: int) -> [] int {
    let first = st[52] - n;
    var i = 0;
    while i < n {
        let at = st[51] + 4 * (first + i);
        if i > 0 {
            emit.str(st, ", ");
        }
        emit.llvm_type(st, st[at]);
        emit.str(st, " ");
        emit.operand(st, st[at], st[at + 1] != 0, st[at + 2], st[at + 3]);
        i = i + 1;
    }
    return first;
}

// `@name` called with the last `n` arguments pushed; the temporary of the whole number it answers.
pub fn call_int[&s](st: &!s [int], name: &static [byte], n: int) -> [] int {
    let result = emit.start(st);
    emit.str(st, "call i64 @");
    emit.str(st, name);
    emit.str(st, "(");
    st[52] = arguments(st, n);
    emit.str(st, ")\n");
    return result;
}

// The same for a function that writes three whole numbers to the cell it is given last; the cell.
pub fn call_out[&s](st: &!s [int], name: &static [byte], n: int) -> [] int {
    let out = cell(st);
    emit.str(st, "  call void @");
    emit.str(st, name);
    emit.str(st, "(");
    st[52] = arguments(st, n);
    if n > 0 {
        emit.str(st, ", ");
    }
    emit.str(st, "ptr ");
    emit.temp(st, out);
    emit.str(st, ")\n");
    return out;
}

fn load_out[&s](st: &!s [int], out: int, k: int) -> [] int {
    let at = emit.start(st);
    emit.str(st, "getelementptr i64, ptr ");
    emit.temp(st, out);
    emit.str(st, ", i64 ");
    emit.nat(st, k);
    emit.str(st, "\n");
    let v = emit.start(st);
    emit.str(st, "load i64, ptr ");
    emit.temp(st, at);
    emit.str(st, "\n");
    return v;
}

// The prelude enum `ty` made of the cell's first `slots` numbers: the tag, then the payloads of its arms in order.
pub fn answer[&s](st: &!s [int], ty: int, slots: int, out: int) -> [] int {
    var acc = 0 - 1;
    var k = 0;
    while k < slots {
        let v = load_out(st, out, k);
        acc = emit.insert_at(st, ty, acc, k, 1, false, 0, v);
        k = k + 1;
    }
    return acc;
}

// The builtin as the code treats it: a pipe is read, written, closed and made non-blocking as a connection is,
// and a directory is closed as a file.
pub fn canonical(number: int) -> [] int {
    if number == 128 {
        return 36;
    }
    if number == 49 || number == 50 {
        return number - 10;
    }
    if number == 51 || number == 52 || number == 63 || number == 105 {
        return 44;
    }
    if number == 53 {
        return 41;
    }
    return number;
}

// Does the call need the support for directories?
pub fn needs_dirs(which: int) -> [] bool {
    return which >= 54 && which <= 69 && which != 63;
}

// The constants a call pushes after its arguments.
pub fn extras[&s](st: &!s [int], which: int) -> [] int {
    if which >= 93 && which <= 104 {
        // The poller's functions are told whether `epoll_event` is the packed one (x86-64); a hand-over whether it is
        // a datagram socket's; a listener is watched for reading.
        if which == 94 {
            emit.push_arg(st, 1, true, 1, 0 - 1);
        }
        if which == 94 || which == 95 || which == 96 {
            emit.push_arg(st, 1, true, ast.flag(which == 96), 0 - 1);
        }
        if which >= 94 && which <= 99 {
            emit.push_arg(st, 1, true, ast.flag(st[61] == 0), 0 - 1);
        }
        if which >= 101 && which <= 104 {
            emit.push_arg(st, 1, true, (which - 101) % 2, 0 - 1);
        }
    } else if which >= 55 && which <= 58 {
        emit.push_arg(st, 1, true, which - 55, 0 - 1);
    } else if which == 59 || which == 60 {
        emit.push_arg(st, 1, true, which - 59, 0 - 1);
    } else if which == 68 {
        emit.push_arg(st, 1, true, 0, 0 - 1);
    } else if which == 69 {
        emit.push_arg(st, 7, false, 0, 0 - 1);
        emit.push_arg(st, 1, true, 0, 0 - 1);
        emit.push_arg(st, 1, true, 1, 0 - 1);
    } else if which == 46 || which == 47 {
        emit.push_arg(st, 1, true, which - 46, 0 - 1);
    }
    return 0;
}

// How many arguments the builtin numbered `which` (see `codes.net_code`; a pipe's number is made a connection's) takes.
pub fn arity(which: int) -> [] int {
    if which == 131 {
        return 2;
    }
    if which == 129 || which == 130 || which == 132 || which == 133 || which == 134 {
        return 3;
    }
    if which >= 122 && which <= 125 || which == 127 {
        return 2;
    }
    if which == 106 || which == 108 {
        return 1;
    }
    if which == 107 || which == 109 {
        return 2;
    }
    if which == 110 {
        return 3;
    }
    if which == 93 {
        return 0;
    }
    if which == 94 || which == 98 || which == 99 {
        return 3;
    }
    if which == 95 || which == 96 {
        return 4;
    }
    if which == 97 {
        return 2;
    }
    if which == 36 {
        return 4;
    }
    if which == 33 || which == 37 || which == 59 || which == 60 {
        return 3;
    }
    if which == 32 || which == 34 || which == 39 || which == 40 || which >= 54 && which <= 58 || which == 61 || which == 65 || which == 67 || which == 68 {
        return 2;
    }
    if which == 48 {
        return 0;
    }
    return 1;
}

// Does the first argument, a capability narrowed to a bound, give the bound the call checks?
pub fn holds_bound(which: int) -> [] bool {
    return which == 32 || which == 33 || which == 36 || which == 37 || which == 54 || which == 110 || which == 122 || which == 129 || which == 130;
}

// How many numbers the function answers in its cell: 0 when it answers one whole number.
pub fn slots(which: int) -> [] int {
    if which == 119 || which == 122 || which == 129 || which == 130 || which == 133 {
        return 3;
    }
    if which == 131 || which == 132 {
        return 4;
    }
    if which == 106 || which == 107 || which == 110 {
        return 3;
    }
    if which == 93 || which == 103 || which == 104 {
        return 3;
    }
    if which == 48 || which == 65 {
        return 4;
    }
    if which == 67 {
        return 5;
    }
    if which >= 36 && which <= 40 || which >= 54 && which <= 62 || which == 64 || which == 68 || which == 69 {
        return 3;
    }
    return 0;
}

// The prelude enum the answer is made into.
pub fn enum_name(which: int) -> [] &static [byte] {
    if which == 129 || which == 130 {
        return "UdpOpened";
    }
    if which == 131 || which == 132 {
        return "Datagram";
    }
    if which == 133 {
        return "Sent";
    }
    if which == 122 {
        return "TtyOpened";
    }
    if which == 119 {
        return "Watching";
    }
    if which == 106 {
        return "Done";
    }
    if which == 107 {
        return "Read";
    }
    if which == 110 {
        return "Dialed";
    }
    if which == 93 {
        return "Polling";
    }
    if which == 104 {
        return "UdpOpened";
    }
    if which == 103 {
        return "Attached";
    }
    if which == 54 || which == 55 {
        return "DirOpened";
    }
    if which >= 56 && which <= 58 {
        return "Opened";
    }
    if which >= 59 && which <= 62 || which == 68 || which == 69 {
        return "Done";
    }
    if which == 64 {
        return "Listing";
    }
    if which == 65 {
        return "Listed";
    }
    if which == 67 {
        return "DirStat";
    }
    if which == 48 {
        return "Piped";
    }
    if which == 37 {
        return "Dialed";
    }
    if which == 38 {
        return "Accepted";
    }
    if which == 39 {
        return "Received";
    }
    if which == 40 {
        return "Sent";
    }
    return "Listening";
}

// The function of `runtime/net.c` that does it.
pub fn function(which: int) -> [] &static [byte] {
    if which == 129 {
        return "cancho_net_udp_connect";
    }
    if which == 130 {
        return "cancho_net_udp_bind";
    }
    if which == 131 {
        return "cancho_udp_recv";
    }
    if which == 132 {
        return "cancho_udp_recv_from";
    }
    if which == 133 {
        return "cancho_udp_send_to";
    }
    if which == 134 {
        return "cancho_udp_peer";
    }
    if which == 135 {
        return "cancho_udp_local_port";
    }
    if which == 127 {
        return "cancho_child_kill";
    }
    if which == 122 {
        return "cancho_tty_open";
    }
    if which == 123 {
        return "cancho_tty_configure";
    }
    if which == 124 {
        return "cancho_tty_read";
    }
    if which == 125 {
        return "cancho_tty_write";
    }
    if which == 126 {
        return "cancho_tty_flush";
    }
    if which == 119 {
        return "cancho_signals_watch";
    }
    if which == 120 {
        return "cancho_signals_pending";
    }
    if which == 121 {
        return "cancho_signals_close";
    }
    if which == 106 {
        return "cancho_flush_out";
    }
    if which == 107 {
        return "cancho_read_stdin";
    }
    if which == 108 {
        return "cancho_conn_connect_status";
    }
    if which == 109 {
        return "cancho_conn_peer";
    }
    if which == 110 {
        return "cancho_net_tcp_connect_start";
    }
    if which == 93 {
        return "cancho_poller_new";
    }
    if which == 94 || which == 95 || which == 96 {
        return "cancho_poller_ctl";
    }
    if which == 97 {
        return "cancho_poller_remove";
    }
    if which == 98 {
        return "cancho_poller_wait";
    }
    if which == 99 {
        return "cancho_poller_add_child";
    }
    if which == 101 || which == 102 {
        return "cancho_conn_detach";
    }
    if which == 103 || which == 104 {
        return "cancho_conn_attach";
    }
    if which == 54 {
        return "cancho_dir_open";
    }
    if which >= 55 && which <= 58 {
        return "cancho_dir_step";
    }
    if which == 59 || which == 60 {
        return "cancho_dir_rename";
    }
    if which == 61 {
        return "cancho_dir_remove";
    }
    if which == 62 {
        return "cancho_dir_sync";
    }
    if which == 64 {
        return "cancho_dir_list";
    }
    if which == 65 {
        return "cancho_dir_next";
    }
    if which == 66 {
        return "cancho_dir_list_close";
    }
    if which == 67 {
        return "cancho_dir_stat";
    }
    if which == 68 || which == 69 {
        return "cancho_dir_mode";
    }
    if which == 32 {
        return "cancho_net_bind";
    }
    if which == 33 {
        return "cancho_net_connect";
    }
    if which == 34 {
        return "cancho_net_listen";
    }
    if which == 35 {
        return "cancho_net_accept";
    }
    if which == 36 {
        return "cancho_net_tcp_listen";
    }
    if which == 37 {
        return "cancho_net_tcp_connect";
    }
    if which == 38 {
        return "cancho_net_tcp_accept";
    }
    if which == 39 {
        return "cancho_net_conn_read";
    }
    if which == 40 {
        return "cancho_net_conn_write";
    }
    if which == 41 || which == 42 {
        return "cancho_net_nonblocking";
    }
    if which == 43 {
        return "cancho_net_nodelay";
    }
    if which == 44 || which == 45 {
        return "cancho_fd_close";
    }
    if which == 48 {
        return "cancho_net_pipe_open";
    }
    return "cancho_clock_ms";
}

// Does the first argument, a capability or the console, give nothing the call passes on?
pub fn leading(which: int) -> [] bool {
    return holds_bound(which) || which == 46 || which == 47 || which == 106 || which == 107 || which == 119;
}

// The bit of a signal named in the literal a `Signals` capability was narrowed to.
pub fn signal_bit[&x](text: &x [byte], from: int, to: int) -> [] int {
    if lc.spells(text, from, to, "ALRM") {
        return 64;
    }
    if lc.spells(text, from, to, "HUP") {
        return 1;
    }
    if lc.spells(text, from, to, "INT") {
        return 2;
    }
    if lc.spells(text, from, to, "QUIT") {
        return 4;
    }
    if lc.spells(text, from, to, "TERM") {
        return 8;
    }
    if lc.spells(text, from, to, "USR1") {
        return 16;
    }
    if lc.spells(text, from, to, "USR2") {
        return 32;
    }
    if lc.spells(text, from, to, "WINCH") {
        return 128;
    }
    return 0;
}

// The signals of a capability narrowed to `"INT,TERM"` as their bits; 0 if it was not narrowed.
pub fn signal_bits[&s, &x](st: &!s [int], text: &x [byte], cap: int) -> [] int {
    var inner = cap;
    if types.is_ref(st, inner) {
        inner = types.ref_inner(st, inner);
    }
    let tok = types.prelude_lit_tok(st, inner);
    if tok < 0 {
        return 0;
    }
    let stop = ast.tend(st, tok) - 1;
    var at = ast.tstart(st, tok) + 1;
    var first = at;
    var bits = 0;
    while at <= stop {
        if at == stop || int_of(text[at]) == ',' {
            bits = bits | signal_bit(text, first, at);
            first = at + 1;
        }
        at = at + 1;
    }
    return bits;
}

// The IPv4 address a string literal spells (`"127.0.0.1"`) as a whole number, or -1 if it is not one.
pub fn ipv4[&s, &x](st: &!s [int], text: &x [byte], tok: int) -> [] int {
    let stop = ast.tend(st, tok) - 1;
    var at = ast.tstart(st, tok) + 1;
    var value = 0;
    var parts = 0;
    var octet = 0;
    var digits = 0;
    while at <= stop {
        if at == stop || int_of(text[at]) == '.' {
            if digits == 0 || octet > 255 {
                return 0 - 1;
            }
            value = value * 256 + octet;
            parts = parts + 1;
            octet = 0;
            digits = 0;
        } else if int_of(text[at]) >= '0' && int_of(text[at]) <= '9' {
            octet = octet * 10 + int_of(text[at]) - '0';
            digits = digits + 1;
        } else {
            return 0 - 1;
        }
        at = at + 1;
    }
    if parts != 4 {
        return 0 - 1;
    }
    return value;
}
