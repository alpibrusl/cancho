    b = buffer.append(heap, b, "  %w = zext i32 %w32 to i64\n");
    b = buffer.append(heap, b, "  %cw = mul i64 %c, %w\n");
    b = buffer.append(heap, b, "  %pfs = getelementptr i64, ptr @cancho_i_fs, i64 %fn\n");
    b = buffer.append(heap, b, "  %vs = load i64, ptr %pfs\n");
    b = buffer.append(heap, b, "  %vs1 = add i64 %vs, %c\n");
    b = buffer.append(heap, b, "  store i64 %vs1, ptr %pfs\n");
    b = buffer.append(heap, b, "  %pfi = getelementptr i64, ptr @cancho_i_fi, i64 %fn\n");
    b = buffer.append(heap, b, "  %vi = load i64, ptr %pfi\n");
    b = buffer.append(heap, b, "  %vi1 = add i64 %vi, %cw\n");
    b = buffer.append(heap, b, "  store i64 %vi1, ptr %pfi\n");
    b = buffer.append(heap, b, "  %pa = getelementptr i64, ptr @cancho_i_alloc, i64 %s\n");
    b = buffer.append(heap, b, "  %a = load i64, ptr %pa\n");
    b = buffer.append(heap, b, "  %pfa = getelementptr i64, ptr @cancho_i_fa, i64 %fn\n");
    b = buffer.append(heap, b, "  %va = load i64, ptr %pfa\n");
    b = buffer.append(heap, b, "  %va1 = add i64 %va, %a\n");
    b = buffer.append(heap, b, "  store i64 %va1, ptr %pfa\n");
    b = buffer.append(heap, b, "  %sn = add i64 %s, 1\n");
    b = buffer.append(heap, b, "  br label %sloop\n");
    b = buffer.append(heap, b, "fstart:\n");
    b = buffer.append(heap, b, "  %nf = load i64, ptr getelementptr (i64, ptr @cancho_i_dims, i64 1)\n");
    b = buffer.append(heap, b, "  br label %floop\n");
    b = buffer.append(heap, b, "floop:\n");
    b = buffer.append(heap, b, "  %f = phi i64 [ 0, %fstart ], [ %fnx, %fnext ]\n");
    b = buffer.append(heap, b, "  %fmore = icmp slt i64 %f, %nf\n");
    b = buffer.append(heap, b, "  br i1 %fmore, label %fbody, label %done\n");
    b = buffer.append(heap, b, "fbody:\n");
    b = buffer.append(heap, b, "  %pst = getelementptr i64, ptr @cancho_i_fs, i64 %f\n");
    b = buffer.append(heap, b, "  %st = load i64, ptr %pst\n");
    b = buffer.append(heap, b, "  %pal = getelementptr i64, ptr @cancho_i_fa, i64 %f\n");
    b = buffer.append(heap, b, "  %al = load i64, ptr %pal\n");
    b = buffer.append(heap, b, "  %any = or i64 %st, %al\n");
    b = buffer.append(heap, b, "  %nz = icmp ne i64 %any, 0\n");
    b = buffer.append(heap, b, "  br i1 %nz, label %print, label %fnext\n");
    return b;
}

fn text_6[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "print:\n");
    b = buffer.append(heap, b, "  %pin = getelementptr ptr, ptr @cancho_i_f_name, i64 %f\n");
    b = buffer.append(heap, b, "  %name = load ptr, ptr %pin\n");
    b = buffer.append(heap, b, "  %pfl = getelementptr ptr, ptr @cancho_i_f_file, i64 %f\n");
