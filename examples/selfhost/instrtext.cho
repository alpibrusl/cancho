fn text_3[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "  %r3 = call i32 (i32, ptr, ...) @dprintf(i32 %fd, ptr @cancho_i_f_frame, ptr %name, ptr %file, i32 %line)\n");
    b = buffer.append(heap, b, "  br label %next\n");
