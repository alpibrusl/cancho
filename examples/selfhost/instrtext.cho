    b = buffer.append(heap, b, "  %r = call i32 (i32, ptr, ...) @dprintf(i32 %fd, ptr @cancho_i_f_fn, ptr %name, ptr %file, i32 %line, i64 %ir, i64 %st, i64 %al)\n");
    b = buffer.append(heap, b, "  br label %fnext\n");
    b = buffer.append(heap, b, "fnext:\n");
    b = buffer.append(heap, b, "  %fnx = add i64 %f, 1\n");
    b = buffer.append(heap, b, "  br label %floop\n");
    b = buffer.append(heap, b, "done:\n");
    b = buffer.append(heap, b, "  ret void\n");
    b = buffer.append(heap, b, "}\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "define internal void @cancho_i_init() {\n");
    b = buffer.append(heap, b, "entry:\n");
    b = buffer.append(heap, b, "  %path = call ptr @getenv(ptr @cancho_i_env)\n");
    b = buffer.append(heap, b, "  %none = icmp eq ptr %path, null\n");
    b = buffer.append(heap, b, "  br i1 %none, label %out, label %open\n");
    b = buffer.append(heap, b, "open:\n");
    b = buffer.append(heap, b, "  %fd = call i32 @creat(ptr %path, i32 384)\n");
    b = buffer.append(heap, b, "  store i32 %fd, ptr @cancho_i_out\n");
    b = buffer.append(heap, b, "  %a = call ptr @signal(i32 4, ptr @cancho_i_on_signal)\n");
    b = buffer.append(heap, b, "  %b = call ptr @signal(i32 5, ptr @cancho_i_on_signal)\n");
    b = buffer.append(heap, b, "  %c = call ptr @signal(i32 8, ptr @cancho_i_on_signal)\n");
    b = buffer.append(heap, b, "  %d = call ptr @signal(i32 11, ptr @cancho_i_on_signal)\n");
    b = buffer.append(heap, b, "  %mode = load i64, ptr getelementptr (i64, ptr @cancho_i_dims, i64 2)\n");
    b = buffer.append(heap, b, "  %profiling = icmp eq i64 %mode, 1\n");
    b = buffer.append(heap, b, "  br i1 %profiling, label %reg, label %out\n");
    b = buffer.append(heap, b, "reg:\n");
    b = buffer.append(heap, b, "  %e = call i32 @atexit(ptr @cancho_i_dump)\n");
    b = buffer.append(heap, b, "  br label %out\n");
    b = buffer.append(heap, b, "out:\n");
    b = buffer.append(heap, b, "  ret void\n");
    b = buffer.append(heap, b, "}\n");
    b = buffer.append(heap, b, "\n");
    return b;
}

fn text_7[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @cancho_i_init, ptr null }]\n");
    return b;
}

pub fn text[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = text_0(heap, b);
    b = text_1(heap, b);
    b = text_2(heap, b);
    b = text_3(heap, b);
    b = text_4(heap, b);
    b = text_5(heap, b);
    b = text_6(heap, b);
    b = text_7(heap, b);
    return b;
}
