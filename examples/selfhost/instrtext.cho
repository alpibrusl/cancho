    b = buffer.append(heap, b, "  store i64 %k, ptr @cancho_i_kind\n");
    b = buffer.append(heap, b, "  ret void\n");
    b = buffer.append(heap, b, "}\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "define void @cancho_i_enter(i32 %f) {\n");
    b = buffer.append(heap, b, "entry:\n");
    b = buffer.append(heap, b, "  %d0 = load i64, ptr @cancho_i_depth\n");
    b = buffer.append(heap, b, "  %d = add i64 %d0, 1\n");
    b = buffer.append(heap, b, "  store i64 %d, ptr @cancho_i_depth\n");
    b = buffer.append(heap, b, "  %ok = icmp ult i64 %d, 4096\n");
    b = buffer.append(heap, b, "  br i1 %ok, label %set, label %out\n");
