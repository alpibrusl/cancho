fn text_4[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "  %armed = icmp sgt i64 %bn, 0\n");
    b = buffer.append(heap, b, "  %samef = icmp eq i64 %fl64, %bf\n");
    b = buffer.append(heap, b, "  %samel = icmp eq i64 %ln64, %bl\n");
    b = buffer.append(heap, b, "  %m1 = and i1 %samef, %samel\n");
    b = buffer.append(heap, b, "  %m = and i1 %m1, %armed\n");
    b = buffer.append(heap, b, "  br i1 %m, label %match, label %out\n");
    b = buffer.append(heap, b, "match:\n");
    b = buffer.append(heap, b, "  %h = load i64, ptr @cancho_i_hits\n");
    b = buffer.append(heap, b, "  %h1 = add i64 %h, 1\n");
    b = buffer.append(heap, b, "  store i64 %h1, ptr @cancho_i_hits\n");
    b = buffer.append(heap, b, "  %reached = icmp eq i64 %h1, %bn\n");
    b = buffer.append(heap, b, "  br i1 %reached, label %stop, label %out\n");
    b = buffer.append(heap, b, "stop:\n");
    b = buffer.append(heap, b, "  call void @cancho_i_report(i32 0, i32 0)\n");
    b = buffer.append(heap, b, "  call void @_exit(i32 0)\n");
    b = buffer.append(heap, b, "  unreachable\n");
    b = buffer.append(heap, b, "out:\n");
    b = buffer.append(heap, b, "  ret void\n");
    b = buffer.append(heap, b, "}\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "define void @cancho_i_on_signal(i32 %sig) {\n");
    b = buffer.append(heap, b, "entry:\n");
    b = buffer.append(heap, b, "  call void @cancho_i_report(i32 1, i32 %sig)\n");
    b = buffer.append(heap, b, "  call void @_exit(i32 1)\n");
    b = buffer.append(heap, b, "  unreachable\n");
    b = buffer.append(heap, b, "}\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "define void @cancho_i_dump() {\n");
    b = buffer.append(heap, b, "entry:\n");
    b = buffer.append(heap, b, "  %fd = load i32, ptr @cancho_i_out\n");
    b = buffer.append(heap, b, "  %open = icmp sge i32 %fd, 0\n");
    b = buffer.append(heap, b, "  br i1 %open, label %sum, label %done\n");
    b = buffer.append(heap, b, "sum:\n");
    b = buffer.append(heap, b, "  %ns = load i64, ptr @cancho_i_dims\n");
    b = buffer.append(heap, b, "  br label %sloop\n");
    b = buffer.append(heap, b, "sloop:\n");
    b = buffer.append(heap, b, "  %s = phi i64 [ 0, %sum ], [ %sn, %sadd ]\n");
    b = buffer.append(heap, b, "  %smore = icmp slt i64 %s, %ns\n");
    b = buffer.append(heap, b, "  br i1 %smore, label %sadd, label %fstart\n");
    b = buffer.append(heap, b, "sadd:\n");
    return b;
}

fn text_5[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "  %pfn = getelementptr i32, ptr @cancho_i_s_fn, i64 %s\n");
    b = buffer.append(heap, b, "  %fn32 = load i32, ptr %pfn\n");
    b = buffer.append(heap, b, "  %fn = zext i32 %fn32 to i64\n");
    b = buffer.append(heap, b, "  %pc = getelementptr i64, ptr @cancho_i_count, i64 %s\n");
    b = buffer.append(heap, b, "  %c = load i64, ptr %pc\n");
    b = buffer.append(heap, b, "  %pw = getelementptr i32, ptr @cancho_i_s_w, i64 %s\n");
