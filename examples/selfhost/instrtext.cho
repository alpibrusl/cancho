    b = buffer.append(heap, b, "  %p = getelementptr i32, ptr @cancho_i_sid, i64 %d\n");
    b = buffer.append(heap, b, "  %s1 = add i32 %s, 1\n");
    b = buffer.append(heap, b, "  store i32 %s1, ptr %p\n");
    b = buffer.append(heap, b, "  br label %cnt\n");
