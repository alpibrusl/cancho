    b = buffer.append(heap, b, "  %c = load i64, ptr %pc\n");
    b = buffer.append(heap, b, "  %c1 = add i64 %c, 1\n");
    b = buffer.append(heap, b, "  store i64 %c1, ptr %pc\n");
    b = buffer.append(heap, b, "  %mode = load i64, ptr getelementptr (i64, ptr @cancho_i_dims, i64 2)\n");
    b = buffer.append(heap, b, "  %tracing = icmp eq i64 %mode, 0\n");
    b = buffer.append(heap, b, "  br i1 %tracing, label %test, label %out\n");
