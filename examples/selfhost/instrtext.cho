    b = buffer.append(heap, b, "  %ln = load i32, ptr %pln\n");
    b = buffer.append(heap, b, "  %fl64 = zext i32 %fl to i64\n");
    b = buffer.append(heap, b, "  %ln64 = zext i32 %ln to i64\n");
    b = buffer.append(heap, b, "  %bf = load i64, ptr @cancho_i_bp\n");
    b = buffer.append(heap, b, "  %bl = load i64, ptr getelementptr (i64, ptr @cancho_i_bp, i64 1)\n");
    b = buffer.append(heap, b, "  %bn = load i64, ptr getelementptr (i64, ptr @cancho_i_bp, i64 2)\n");
