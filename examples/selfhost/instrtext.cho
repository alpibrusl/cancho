    b = buffer.append(heap, b, "@cancho_i_f_frame = private constant [16 x i8] c\"frame\\09%s\\09%s\\09%d\\0A\\00\"\n");
    b = buffer.append(heap, b, "@cancho_i_f_fn = private constant [25 x i8] c\"fn\\09%s\\09%s\\09%d\\09%ld\\09%ld\\09%ld\\0A\\00\"\n");
