// check.cho -- the cancho checker so far, written in cancho: the program.
//
// Stage 3b of the self-hosting spike (`docs/self-hosting.md` section 6, epic #295). Reads a
// source file on standard input, parses it with `ast.cho` and runs `checker.cho` (`pass1.cho`, `foreign.cho`) over the tree, and
// writes one line:
//
//     OK                        the declarations are well formed
//     ERR rule-tag start end    the first refusal, from the parser or from the checker
//
// The oracle is `cancho_syntax::parse` followed by `cancho_ir::check_declarations`, which is
// the half of the Rust checker this is a port of; `tests/conformance/selfhost.rs` compares them
// over every program in the repository.
//
//     cancho run examples/selfhost/check.cho examples/selfhost/driver.cho examples/selfhost/listing.cho \
//         examples/selfhost/pass1.cho examples/selfhost/ast.cho examples/selfhost/kinds.cho \
//         examples/selfhost/lexcore.cho examples/selfhost/tables.cho --std < f.cho

import selfhost.driver;

fn main(world: World) -> [] int {
    return driver.drive(world, 1, false);
}
