module selfhost.printing;

// printing.cho -- the canonical printer, written in cancho (issue #485, `docs/formatting.md`).
//
// A port of `crates/cancho-syntax/src/print.rs`: the tree `ast.cho` builds, written back as the one text the language has for it
// (`docs/canonical-ast.md`). The oracle is `cancho print`; `tests/conformance/selfhost.rs` compares the two over every program in the
// repository. It reads what the tree keeps and, for what the tree does not keep (an effect row, a declaration's `[T, &r where ..]`, a
// destructuring pattern's names, a match pattern), the tokens, as `listing.cho` does.
//
// The output goes to the standard output a piece at a time, with the depth of the indentation carried along.

import std.io as console;
import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.kinds;
import selfhost.floatprint;

fn w[&i, &r](io: &!i Io, s: &r [byte]) -> [io_write] int {
    return console.write_all(io, s);
}

fn indent[&i](io: &!i Io, depth: int) -> [io_write] int {
    var k = 0;
    while k < depth {
        w(io, "    ");
        k = k + 1;
    }
    return 0;
}

// The text of token `i`.
fn name[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], i: int) -> [io_write] int {
    return w(io, text[ast.tstart(st, i)..ast.tend(st, i)]);
}

// `q.name`, or `name` where there is no qualifier (-1).
fn qualified[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], q: int, n: int) -> [io_write] int {
    if q >= 0 {
        name(io, st, text, q);
        w(io, ".");
    }
    return name(io, st, text, n);
}

fn code(t: lc.Tok) -> [] int {
    return lc.code(t);
}

// ------------------------------------------------------------- literals ---

// The string literal at token `i`, as the language writes one: the escapes the grammar admits, and no others
// (`docs/strings.md` section 4).
fn string_literal[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], i: int) -> [io_write] int {
    let to = ast.tend(st, i) - 1;
    var j = ast.tstart(st, i) + 1;
    w(io, "\"");
    while j < to {
        var c = lc.at(text, j);
        if c == '\\' {
            j = j + 1;
            let e = lc.at(text, j);
            c = e;
            if e == 'n' {
                c = 10;
            }
            if e == 'r' {
                c = 13;
            }
            if e == 't' {
                c = 9;
            }
            if e == '0' {
                c = 0;
            }
        }
        if c == 10 {
            w(io, "\\n");
        } else if c == 13 {
            w(io, "\\r");
        } else if c == 9 {
            w(io, "\\t");
        } else if c == '\\' {
            w(io, "\\\\");
        } else if c == '"' {
            w(io, "\\\"");
        } else if c == 0 {
            w(io, "\\0");
        } else {
            console.putchar(io, c);
        }
        j = j + 1;
    }
    return w(io, "\"");
}

// ----------------------------------------------- what the tokens still say ---

// `[io, ffi("libc")]`, from the row whose `[` is token `open`: in the order written.
fn effect_row[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], open: int) -> [io_write] int {
    w(io, "[");
    var k = open + 1;
    var first = true;
    while ast.code_at(st, k) != code(lc.Tok::RBracket) {
        if !first {
            w(io, ", ");
        }
        first = false;
        name(io, st, text, k);
        k = k + 1;
        if ast.code_at(st, k) == code(lc.Tok::LParen) {
            w(io, "(");
            string_literal(io, st, text, k + 1);
            w(io, ")");
            k = k + 3;
        }
        if ast.code_at(st, k) == code(lc.Tok::Comma) {
            k = k + 1;
        }
    }
    return w(io, "]");
}

// `{ a, b }` or `(a, b)`'s names, from the token after the opener, up to `closer`: a, b.
fn names[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], open: int, closer: lc.Tok) -> [io_write] int {
    var k = open + 1;
    var first = true;
    while ast.code_at(st, k) != code(closer) {
        if !first {
            w(io, ", ");
        }
        first = false;
        name(io, st, text, k);
        k = k + 1;
        if ast.code_at(st, k) == code(lc.Tok::Comma) {
            k = k + 1;
        }
    }
    return 0;
}

// A match pattern, from its first token: `_`, or `Enum::Variant(a, _)`, `q.Enum::Variant`.
fn pattern[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], first: int) -> [io_write] int {
    if ast.code_at(st, first) == code(lc.Tok::Underscore) {
        return w(io, "_");
    }
    var k = first;
    var qualifier = 0 - 1;
    if ast.code_at(st, k + 1) == code(lc.Tok::Dot) {
        qualifier = k;
        k = k + 2;
    }
    qualified(io, st, text, qualifier, k);
    w(io, "::");
    name(io, st, text, k + 2);
    k = k + 3;
    if ast.code_at(st, k) == code(lc.Tok::LParen) {
        k = k + 1;
        var any = false;
        var firstb = true;
        while ast.code_at(st, k) != code(lc.Tok::RParen) {
            if firstb {
                w(io, "(");
            } else {
                w(io, ", ");
            }
            firstb = false;
            any = true;
            if ast.code_at(st, k) == code(lc.Tok::Underscore) {
                w(io, "_");
            } else {
                name(io, st, text, k);
            }
            k = k + 1;
            if ast.code_at(st, k) == code(lc.Tok::Comma) {
                k = k + 1;
            }
        }
        if any {
            w(io, ")");
        }
    }
    return 0;
}

// The `[T, U: val, &r where a <= b]` of a declaration whose `[` is token `start` (-1 if it has none): type parameters first, then
// regions, as the Rust AST keeps them apart; nothing if there are neither.
fn generics[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], start: int) -> [io_write] int {
    if start < 0 {
        return 0;
    }
    var k = start + 1;
    var any = false;
    while ast.code_at(st, k) != code(lc.Tok::RBracket) && ast.code_at(st, k) != code(lc.Tok::Where) {
        if ast.code_at(st, k) == code(lc.Tok::Amp) {
            any = true;
            k = k + 2;
        } else {
            any = true;
            k = k + 1;
            if ast.code_at(st, k) == code(lc.Tok::Colon) {
                k = k + 2;
            }
        }
        if ast.code_at(st, k) == code(lc.Tok::Comma) {
            k = k + 1;
        }
    }
    if !any {
        return 0;
    }
    w(io, "[");
    var first = true;
    k = start + 1;
    while ast.code_at(st, k) != code(lc.Tok::RBracket) && ast.code_at(st, k) != code(lc.Tok::Where) {
        if ast.code_at(st, k) == code(lc.Tok::Amp) {
            k = k + 2;
        } else {
            if !first {
                w(io, ", ");
            }
            first = false;
            name(io, st, text, k);
            k = k + 1;
            if ast.code_at(st, k) == code(lc.Tok::Colon) {
                w(io, ": val");
                k = k + 2;
            }
        }
        if ast.code_at(st, k) == code(lc.Tok::Comma) {
            k = k + 1;
        }
    }
    k = start + 1;
    while ast.code_at(st, k) != code(lc.Tok::RBracket) && ast.code_at(st, k) != code(lc.Tok::Where) {
        if ast.code_at(st, k) == code(lc.Tok::Amp) {
            if !first {
                w(io, ", ");
            }
            first = false;
            w(io, "&");
            name(io, st, text, k + 1);
            k = k + 2;
        } else {
            k = k + 1;
            if ast.code_at(st, k) == code(lc.Tok::Colon) {
                k = k + 2;
            }
        }
        if ast.code_at(st, k) == code(lc.Tok::Comma) {
            k = k + 1;
        }
    }
    if ast.code_at(st, k) == code(lc.Tok::Where) {
        w(io, " where ");
        k = k + 1;
        var firstc = true;
        var go = true;
        while go {
            if !firstc {
                w(io, ", ");
            }
            firstc = false;
            name(io, st, text, k);
            w(io, " <= ");
            name(io, st, text, k + 2);
            k = k + 3;
            if ast.code_at(st, k) == code(lc.Tok::Comma) {
                k = k + 1;
            } else {
                go = false;
            }
        }
    }
    return w(io, "]");
}

// ---------------------------------------------------------------- types ---

fn types[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], head: int, n: int) -> [io_write] int {
    var at = head;
    var left = n;
    while left > 0 {
        if left != n {
            w(io, ", ");
        }
        type_expr(io, st, text, at);
        at = ast.next(st, at);
        left = left - 1;
    }
    return 0;
}

fn type_expr[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], id: int) -> [io_write] int {
    if ast.is_kind(st, id, kinds.NK::TName) {
        qualified(io, st, text, ast.get(st, id, 4), ast.get(st, id, 5));
        let n = ast.get(st, id, 7);
        if n == 0 {
            return 0;
        }
        if n == 1 && ast.is_kind(st, ast.get(st, id, 6), kinds.NK::TLit) {
            // `Ffi("libc")`: a literal argument is written in parentheses.
            w(io, "(");
            type_expr(io, st, text, ast.get(st, id, 6));
            return w(io, ")");
        }
        w(io, "[");
        types(io, st, text, ast.get(st, id, 6), n);
        return w(io, "]");
    }
    if ast.is_kind(st, id, kinds.NK::TRef) {
        w(io, "&");
        if ast.get(st, id, 4) != 0 {
            w(io, "!");
        }
        name(io, st, text, ast.get(st, id, 5));
        w(io, " ");
        return type_expr(io, st, text, ast.get(st, id, 6));
    }
    if ast.is_kind(st, id, kinds.NK::TSlice) {
        w(io, "[");
        type_expr(io, st, text, ast.get(st, id, 6));
        return w(io, "]");
    }
    if ast.is_kind(st, id, kinds.NK::TTuple) {
        return tuple_of_types(io, st, text, ast.get(st, id, 6), ast.get(st, id, 7));
    }
    if ast.is_kind(st, id, kinds.NK::TLit) {
        return string_literal(io, st, text, ast.get(st, id, 4));
    }
    // A function type.
    w(io, "fn(");
    types(io, st, text, ast.get(st, id, 5), ast.get(st, id, 6));
    w(io, ") -> ");
    effect_row(io, st, text, ast.get(st, id, 4));
    w(io, " ");
    return type_expr(io, st, text, ast.get(st, id, 7));
}

// `(A, B)`, and `(A,)` for one part.
fn tuple_of_types[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], head: int, n: int) -> [io_write] int {
    w(io, "(");
    types(io, st, text, head, n);
    if n == 1 {
        w(io, ",");
    }
    return w(io, ")");
}

// ---------------------------------------------------------- expressions ---

// Binding powers, loosest first, by the operator's number in `ast.op_name`.
fn power(op: int) -> [] int {
    if op == 0 {
        return 1;
    }
    if op == 1 {
        return 2;
    }
    if op <= 3 {
        return 3;
    }
    if op <= 7 {
        return 4;
    }
    if op == 8 {
        return 5;
    }
    if op == 9 {
        return 6;
    }
    if op == 10 {
        return 7;
    }
    if op <= 12 {
        return 8;
    }
    if op <= 14 {
        return 9;
    }
    return 10;
}

fn unary_level() -> [] int {
    return 11;
}

fn postfix_level() -> [] int {
    return 12;
}

pub fn operator(op: int) -> [] &static [byte] {
    if op == 0 {
        return "||";
    }
    if op == 1 {
        return "&&";
    }
    if op == 2 {
        return "==";
    }
    if op == 3 {
        return "!=";
    }
    if op == 4 {
        return "<";
    }
    if op == 5 {
        return "<=";
    }
    if op == 6 {
        return ">";
    }
    if op == 7 {
        return ">=";
    }
    if op == 8 {
        return "|";
    }
    if op == 9 {
        return "^";
    }
    if op == 10 {
        return "&";
    }
    if op == 11 {
        return "<<";
    }
    if op == 12 {
        return ">>";
    }
    if op == 13 {
        return "+";
    }
    if op == 14 {
        return "-";
    }
    if op == 15 {
        return "*";
    }
    if op == 16 {
        return "/";
    }
    return "%";
}

pub fn unary_symbol(op: int) -> [] &static [byte] {
    if op == 0 {
        return "-";
    }
    if op == 1 {
        return "!";
    }
    if op == 2 {
        return "~";
    }
    return "*";
}

// Is the expression a numeric literal, which `.` and `-` must not run into?
fn is_number[&s](st: &!s [int], id: int) -> [] bool {
    return ast.is_kind(st, id, kinds.NK::EInt) || ast.is_kind(st, id, kinds.NK::EFloat);
}

// Does a struct literal appear where a block could follow it (`if`, `while`, `match`)? Anything inside brackets is safe.
fn bare_struct[&s](st: &!s [int], id: int) -> [] bool {
    if ast.is_kind(st, id, kinds.NK::EStructLit) {
        return true;
    }
    if ast.is_kind(st, id, kinds.NK::EBinary) {
        return bare_struct(st, ast.get(st, id, 5)) || bare_struct(st, ast.get(st, id, 6));
    }
    if ast.is_kind(st, id, kinds.NK::EUnary) {
        return bare_struct(st, ast.get(st, id, 5));
    }
    if ast.is_kind(st, id, kinds.NK::EField) || ast.is_kind(st, id, kinds.NK::EIndex) {
        return bare_struct(st, ast.get(st, id, 4));
    }
    return false;
}

// An expression in a position followed by a block.
fn condition[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], id: int) -> [io_write] int {
    if bare_struct(st, id) {
        w(io, "(");
        expr_at(io, st, text, id, 0);
        return w(io, ")");
    }
    return expr_at(io, st, text, id, 0);
}

fn exprs[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], head: int, n: int) -> [io_write] int {
    var at = head;
    var left = n;
    while left > 0 {
        if left != n {
            w(io, ", ");
        }
        expr_at(io, st, text, at, 0);
        at = ast.next(st, at);
        left = left - 1;
    }
    return 0;
}

// The base of a `.`: a numeric literal there is parenthesised.
fn dotted[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], base: int) -> [io_write] int {
    if is_number(st, base) {
        w(io, "(");
        expr_at(io, st, text, base, postfix_level());
        return w(io, ")");
    }
    return expr_at(io, st, text, base, postfix_level());
}

// `level` is the binding power of the context: anything that binds more loosely is wrapped.
fn expr_at[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], id: int, level: int) -> [io_write] int {
    if ast.is_kind(st, id, kinds.NK::EInt) {
        return console.print_int(io, ast.get(st, id, 4));
    }
    if ast.is_kind(st, id, kinds.NK::EBool) {
        if ast.get(st, id, 4) != 0 {
            return w(io, "true");
        }
        return w(io, "false");
    }
    if ast.is_kind(st, id, kinds.NK::EStr) {
        return string_literal(io, st, text, ast.get(st, id, 4));
    }
    if ast.is_kind(st, id, kinds.NK::EFloat) {
        if ast.get(st, id, 6) == 1 {
            // A literal that came as bits (`ingest.cho`) has no text to read them from.
            return floatprint.from_bits(io, st, ast.get(st, id, 5), ast.get(st, id, 4) != 0);
        }
        return floatprint.literal(io, st, text, ast.nstart(st, id), ast.nend(st, id), ast.get(st, id, 4) != 0);
    }
    if ast.is_kind(st, id, kinds.NK::EName) {
        return name(io, st, text, ast.get(st, id, 4));
    }
    if ast.is_kind(st, id, kinds.NK::EStructLit) {
        qualified(io, st, text, ast.get(st, id, 4), ast.get(st, id, 5));
        let n = ast.get(st, id, 7);
        if n == 0 {
            return w(io, " { }");
        }
        w(io, " { ");
        var at = ast.get(st, id, 6);
        var left = n;
        while left > 0 {
            if left != n {
                w(io, ", ");
            }
            name(io, st, text, ast.get(st, at, 4));
            w(io, ": ");
            expr_at(io, st, text, ast.get(st, at, 5), 0);
            at = ast.next(st, at);
            left = left - 1;
        }
        return w(io, " }");
    }
    if ast.is_kind(st, id, kinds.NK::EField) {
        dotted(io, st, text, ast.get(st, id, 4));
        w(io, ".");
        return name(io, st, text, ast.get(st, id, 5));
    }
    if ast.is_kind(st, id, kinds.NK::ETuple) {
        w(io, "(");
        exprs(io, st, text, ast.get(st, id, 4), ast.get(st, id, 5));
        if ast.get(st, id, 5) == 1 {
            w(io, ",");
        }
        return w(io, ")");
    }
    if ast.is_kind(st, id, kinds.NK::ETupleField) {
        dotted(io, st, text, ast.get(st, id, 4));
        w(io, ".");
        return console.print_int(io, ast.get(st, id, 5));
    }
    if ast.is_kind(st, id, kinds.NK::EIndex) {
        expr_at(io, st, text, ast.get(st, id, 4), postfix_level());
        w(io, "[");
        expr_at(io, st, text, ast.get(st, id, 5), 0);
        return w(io, "]");
    }
    if ast.is_kind(st, id, kinds.NK::ESlice) {
        expr_at(io, st, text, ast.get(st, id, 4), postfix_level());
        w(io, "[");
        expr_at(io, st, text, ast.get(st, id, 5), 0);
        w(io, "..");
        expr_at(io, st, text, ast.get(st, id, 6), 0);
        return w(io, "]");
    }
    if ast.is_kind(st, id, kinds.NK::EVariant) {
        qualified(io, st, text, ast.get(st, id, 4), ast.get(st, id, 5));
        w(io, "::");
        name(io, st, text, ast.get(st, id, 6));
        if ast.get(st, id, 8) == 0 {
            return 0;
        }
        w(io, "(");
        exprs(io, st, text, ast.get(st, id, 7), ast.get(st, id, 8));
        return w(io, ")");
    }
    if ast.is_kind(st, id, kinds.NK::ECall) {
        qualified(io, st, text, ast.get(st, id, 4), ast.get(st, id, 5));
        w(io, "(");
        exprs(io, st, text, ast.get(st, id, 6), ast.get(st, id, 7));
        return w(io, ")");
    }
    if ast.is_kind(st, id, kinds.NK::EAlloc) {
        w(io, "alloc[");
        name(io, st, text, ast.get(st, id, 4));
        w(io, "](");
        expr_at(io, st, text, ast.get(st, id, 5), 0);
        return w(io, ")");
    }
    if ast.is_kind(st, id, kinds.NK::EAllocSlice) {
        w(io, "alloc_slice[");
        name(io, st, text, ast.get(st, id, 4));
        w(io, "](");
        expr_at(io, st, text, ast.get(st, id, 5), 0);
        w(io, ", ");
        expr_at(io, st, text, ast.get(st, id, 6), 0);
        return w(io, ")");
    }
    if ast.is_kind(st, id, kinds.NK::EUnary) {
        let wrapped = unary_level() < level;
        if wrapped {
            w(io, "(");
        }
        let op = ast.get(st, id, 4);
        let operand = ast.get(st, id, 5);
        if op == 0 && is_number(st, operand) {
            // `-` before a literal token is one literal, so a negation of one keeps the two apart.
            w(io, "-(");
            expr_at(io, st, text, operand, unary_level());
            w(io, ")");
        } else {
            w(io, unary_symbol(op));
            expr_at(io, st, text, operand, unary_level());
        }
        if wrapped {
            w(io, ")");
        }
        return 0;
    }
    // A binary operation, left-associative throughout.
    let op = ast.get(st, id, 4);
    let own = power(op);
    let wrapped = own < level;
    if wrapped {
        w(io, "(");
    }
    expr_at(io, st, text, ast.get(st, id, 5), own);
    w(io, " ");
    w(io, operator(op));
    w(io, " ");
    expr_at(io, st, text, ast.get(st, id, 6), own + 1);
    if wrapped {
        w(io, ")");
    }
    return 0;
}

// ----------------------------------------------------------- statements ---

fn stmts[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], head: int, n: int, depth: int) -> [io_write] int {
    var at = head;
    var left = n;
    while left > 0 {
        stmt(io, st, text, at, depth);
        at = ast.next(st, at);
        left = left - 1;
    }
    return 0;
}

// The lines of a block that has had its opening brace written, and the closing one.
fn nested[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], head: int, n: int, depth: int) -> [io_write] int {
    stmts(io, st, text, head, n, depth + 1);
    indent(io, depth);
    return w(io, "}\n");
}

// `if c { .. }` and what follows it. `chain` is 1 for the link of a chain, which starts the line `} else if`.
fn if_chain[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], id: int, depth: int, chain: bool) -> [io_write] int {
    if chain {
        w(io, "} else ");
    } else {
        indent(io, depth);
    }
    w(io, "if ");
    condition(io, st, text, ast.get(st, id, 4));
    w(io, " {\n");
    stmts(io, st, text, ast.get(st, id, 5), ast.get(st, id, 6), depth + 1);
    let n = ast.get(st, id, 8);
    if n < 0 {
        indent(io, depth);
        return w(io, "}\n");
    }
    indent(io, depth);
    let only = ast.get(st, id, 7);
    if n == 1 && ast.is_kind(st, only, kinds.NK::SIf) {
        return if_chain(io, st, text, only, depth, true);
    }
    w(io, "} else {\n");
    return nested(io, st, text, only, n, depth);
}

fn stmt[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], id: int, depth: int) -> [io_write] int {
    if ast.is_kind(st, id, kinds.NK::SIf) {
        return if_chain(io, st, text, id, depth, false);
    }
    indent(io, depth);
    if ast.is_kind(st, id, kinds.NK::SLet) {
        if ast.get(st, id, 4) != 0 {
            w(io, "var ");
        } else {
            w(io, "let ");
        }
        name(io, st, text, ast.get(st, id, 5));
        if ast.get(st, id, 6) >= 0 {
            w(io, ": ");
            type_expr(io, st, text, ast.get(st, id, 6));
        }
        w(io, " = ");
        expr_at(io, st, text, ast.get(st, id, 7), 0);
        return w(io, ";\n");
    }
    if ast.is_kind(st, id, kinds.NK::SAssign) {
        expr_at(io, st, text, ast.get(st, id, 4), 0);
        w(io, " = ");
        expr_at(io, st, text, ast.get(st, id, 5), 0);
        return w(io, ";\n");
    }
    if ast.is_kind(st, id, kinds.NK::SDestructure) {
        w(io, "let ");
        qualified(io, st, text, ast.get(st, id, 4), ast.get(st, id, 5));
        w(io, " { ");
        names(io, st, text, ast.get(st, id, 6), lc.Tok::RBrace);
        w(io, " } = ");
        expr_at(io, st, text, ast.get(st, id, 7), 0);
        return w(io, ";\n");
    }
    if ast.is_kind(st, id, kinds.NK::SDestructureTuple) {
        w(io, "let (");
        names(io, st, text, ast.get(st, id, 4), lc.Tok::RParen);
        w(io, ") = ");
        expr_at(io, st, text, ast.get(st, id, 5), 0);
        return w(io, ";\n");
    }
    if ast.is_kind(st, id, kinds.NK::SBorrow) {
        w(io, "borrow ");
        if ast.get(st, id, 5) != 0 {
            w(io, "mut ");
        }
        name(io, st, text, ast.get(st, id, 4));
        w(io, " as &");
        if ast.get(st, id, 5) != 0 {
            w(io, "!");
        }
        name(io, st, text, ast.get(st, id, 6));
        w(io, " in {\n");
        return nested(io, st, text, ast.get(st, id, 7), ast.get(st, id, 8), depth);
    }
    if ast.is_kind(st, id, kinds.NK::SRegion) {
        w(io, "region ");
        name(io, st, text, ast.get(st, id, 4));
        w(io, " {\n");
        return nested(io, st, text, ast.get(st, id, 5), ast.get(st, id, 6), depth);
    }
    if ast.is_kind(st, id, kinds.NK::SExpr) {
        expr_at(io, st, text, ast.get(st, id, 4), 0);
        return w(io, ";\n");
    }
    if ast.is_kind(st, id, kinds.NK::SWhile) {
        w(io, "while ");
        condition(io, st, text, ast.get(st, id, 4));
        w(io, " {\n");
        return nested(io, st, text, ast.get(st, id, 5), ast.get(st, id, 6), depth);
    }
    if ast.is_kind(st, id, kinds.NK::SMatch) {
        w(io, "match ");
        condition(io, st, text, ast.get(st, id, 4));
        w(io, " {\n");
        var arm = ast.get(st, id, 5);
        var left = ast.get(st, id, 6);
        while left > 0 {
            indent(io, depth + 1);
            pattern(io, st, text, ast.get(st, arm, 4));
            w(io, " => {\n");
            nested(io, st, text, ast.get(st, arm, 5), ast.get(st, arm, 6), depth + 1);
            arm = ast.next(st, arm);
            left = left - 1;
        }
        indent(io, depth);
        return w(io, "}\n");
    }
    if ast.is_kind(st, id, kinds.NK::SReturn) {
        w(io, "return ");
        expr_at(io, st, text, ast.get(st, id, 4), 0);
        return w(io, ";\n");
    }
    w(io, "defer ");
    expr_at(io, st, text, ast.get(st, id, 4), 0);
    return w(io, ";\n");
}

// ---------------------------------------------------------------- items ---

fn visibility[&i](io: &!i Io, public: int) -> [io_write] int {
    if public != 0 {
        return w(io, "pub ");
    }
    return 0;
}

fn mode_prefix[&i](io: &!i Io, mode: int) -> [io_write] int {
    if mode == 2 {
        return w(io, "res ");
    }
    if mode == 1 {
        return w(io, "val ");
    }
    return 0;
}

fn params[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], head: int, n: int) -> [io_write] int {
    var at = head;
    var left = n;
    while left > 0 {
        if left != n {
            w(io, ", ");
        }
        name(io, st, text, ast.get(st, at, 4));
        w(io, ": ");
        type_expr(io, st, text, ast.get(st, at, 5));
        at = ast.next(st, at);
        left = left - 1;
    }
    return 0;
}

fn item[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], id: int) -> [io_write] int {
    if ast.is_kind(st, id, kinds.NK::IFn) {
        visibility(io, ast.get(st, id, 5));
        w(io, "fn ");
        name(io, st, text, ast.get(st, id, 4));
        generics(io, st, text, ast.get(st, id, 6));
        w(io, "(");
        params(io, st, text, ast.get(st, id, 7), ast.get(st, id, 8));
        w(io, ") -> ");
        effect_row(io, st, text, ast.get(st, id, 9));
        w(io, " ");
        type_expr(io, st, text, ast.get(st, id, 10));
        w(io, " {\n");
        return nested(io, st, text, ast.get(st, id, 11), ast.get(st, id, 12), 0);
    }
    if ast.is_kind(st, id, kinds.NK::IExtern) {
        w(io, "extern fn ");
        name(io, st, text, ast.get(st, id, 4));
        generics(io, st, text, ast.get(st, id, 6));
        w(io, "(");
        params(io, st, text, ast.get(st, id, 7), ast.get(st, id, 8));
        w(io, ") -> ");
        effect_row(io, st, text, ast.get(st, id, 9));
        w(io, " ");
        type_expr(io, st, text, ast.get(st, id, 10));
        return w(io, ";\n");
    }
    if ast.is_kind(st, id, kinds.NK::IStruct) {
        visibility(io, ast.get(st, id, 5));
        mode_prefix(io, ast.get(st, id, 6));
        w(io, "struct ");
        name(io, st, text, ast.get(st, id, 4));
        generics(io, st, text, ast.get(st, id, 7));
        w(io, " {\n");
        var at = ast.get(st, id, 8);
        while at >= 0 {
            indent(io, 1);
            name(io, st, text, ast.get(st, at, 4));
            w(io, ": ");
            type_expr(io, st, text, ast.get(st, at, 5));
            w(io, ",\n");
            at = ast.next(st, at);
        }
        return w(io, "}\n");
    }
    if ast.is_kind(st, id, kinds.NK::IEnum) {
        visibility(io, ast.get(st, id, 5));
        mode_prefix(io, ast.get(st, id, 6));
        w(io, "enum ");
        name(io, st, text, ast.get(st, id, 4));
        generics(io, st, text, ast.get(st, id, 7));
        w(io, " {\n");
        var at = ast.get(st, id, 8);
        while at >= 0 {
            indent(io, 1);
            name(io, st, text, ast.get(st, at, 4));
            if ast.get(st, at, 6) > 0 {
                w(io, "(");
                types(io, st, text, ast.get(st, at, 5), ast.get(st, at, 6));
                w(io, ")");
            }
            w(io, ",\n");
            at = ast.next(st, at);
        }
        return w(io, "}\n");
    }
    // A static.
    visibility(io, ast.get(st, id, 5));
    w(io, "static ");
    name(io, st, text, ast.get(st, id, 4));
    w(io, ": ");
    type_expr(io, st, text, ast.get(st, id, 6));
    w(io, " {\n");
    return nested(io, st, text, ast.get(st, id, 7), ast.get(st, id, 8), 0);
}

// `module a.b;` for a module that is not the root, and the module's imports in the order written.
fn module_header[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte], m: int) -> [io_write] int {
    if m != 0 {
        w(io, "module ");
        let first = ast.module_first(st, m);
        name(io, st, text, first);
        var n = 1;
        while n < ast.module_len(st, m) {
            w(io, ".");
            name(io, st, text, first + 2 * n);
            n = n + 1;
        }
        w(io, ";\n");
    }
    var k = 0;
    while k < st[12] {
        if ast.import_module(st, k) == m {
            let keyword = ast.import_keyword(st, k);
            w(io, "import ");
            var at = keyword + 1;
            var last = at;
            name(io, st, text, at);
            while ast.code_at(st, at + 1) == code(lc.Tok::Dot) {
                w(io, ".");
                name(io, st, text, at + 2);
                at = at + 2;
                last = at;
            }
            at = at + 1;
            if ast.code_at(st, at) == code(lc.Tok::As) && !ast.same(st, text, at + 1, last) {
                // An alias that is the last segment is no alias.
                w(io, " as ");
                name(io, st, text, at + 1);
            }
            w(io, ";\n");
        }
        k = k + 1;
    }
    return 0;
}

// Does module `m` have an import?
pub fn has_imports[&s](st: &!s [int], m: int) -> [] bool {
    var k = 0;
    while k < st[12] {
        if ast.import_module(st, k) == m {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// Is there an item in module `m`?
fn has_items[&s](st: &!s [int], m: int) -> [] bool {
    var at = st[15];
    while at >= 0 {
        if ast.get(st, at, 13) == m {
            return true;
        }
        at = ast.next(st, at);
    }
    return false;
}

// The whole unit: modules in order, each with its header, its imports and its items, one blank line between.
pub fn print[&i, &s, &x](io: &!i Io, st: &!s [int], text: &x [byte]) -> [io_write] int {
    var first = true;
    var m = 0;
    while m < st[11] {
        let imports = has_imports(st, m);
        if has_items(st, m) || imports {
            if !first {
                w(io, "\n");
            }
            first = false;
            module_header(io, st, text, m);
            var n = 0;
            var at = st[15];
            while at >= 0 {
                if ast.get(st, at, 13) == m {
                    if n > 0 || m != 0 || imports {
                        w(io, "\n");
                    }
                    item(io, st, text, at);
                    n = n + 1;
                }
                at = ast.next(st, at);
            }
        }
        m = m + 1;
    }
    return 0;
}
