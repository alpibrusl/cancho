module selfhost.zlib;

// zlib.cho -- the zlib format (RFC 1950) and DEFLATE (RFC 1951) in cancho, for the objects of `cancho vcs` and of its git bridge
// (`docs/vcs-native.md` section 3: a git loose object and a pack entry are zlib streams, and the bridge must read what git writes and
// write what git reads).
//
//   * `adler32`      the checksum of a stream's trailer.
//   * `inflate`      a DEFLATE stream (raw), from any byte of a slice, into a `buffer.Buffer`; it says where the stream ended, which a pack needs
//                    (entries follow one another with no length).
//   * `unzlib`       a zlib stream: the header checked, the DEFLATE inside it inflated, the Adler-32 compared.
//   * `zlib_stored`  a zlib stream of stored blocks (no compression): valid input for any reader, and what a first writer needs. The
//                    compressor (fixed and dynamic Huffman, LZ77) is a later slice of `docs/vcs-native.md`.
//
// `inflate` is a port of Mark Adler's `puff.c` (zlib's `contrib/puff`): canonical Huffman codes decoded one bit at a time from a count and a
// symbol table, so there are no tables to build but two small ones. It is the slow, short and checkable form; its speed is measured in
// `docs/vcs-native.md`.
//
// Every refusal is a status, never a trap, and a status is a rule tag (the constants below, spelled out in `tag`). No input reaches a
// panic: every read of the input is against its length, every back-reference against the output so far, every table index against its size.
//
//   status 0   ok
//   status 1   zlib-header          the two header bytes are not a zlib header (method 8, window of at most 32 KiB, a multiple of 31)
//   status 2   zlib-dictionary      the header asks for a preset dictionary, which this does not carry
//   status 3   inflate-truncated    the input ended inside the stream
//   status 4   inflate-block-type   a block of type 3
//   status 5   inflate-stored-length the length of a stored block is not the complement of its check
//   status 6   inflate-bad-code     a code that is over-subscribed, incomplete, or does not decode
//   status 7   inflate-distance     a back-reference that reaches before the start of the output
//   status 8   inflate-limit        the output would pass the limit asked for
//   status 9   zlib-adler           the checksum of the output is not the one in the trailer

import std.buffer;

// The result of `inflate`: the output (every byte of it that was made), the status, and the index of the first byte after the stream.
pub res struct Inflated {
    out: buffer.Buffer,
    status: int,
    end: int,
}

// The words of the status: `tag(n)` is the rule's name for status `n`, as a number of the table in the header, spelled by the caller's
// own table; kept here as the one place the numbers are fixed.
pub fn status_ok() -> [] int {
    return 0;
}

pub fn status_header() -> [] int {
    return 1;
}

pub fn status_dictionary() -> [] int {
    return 2;
}

pub fn status_truncated() -> [] int {
    return 3;
}

pub fn status_block_type() -> [] int {
    return 4;
}

pub fn status_stored_length() -> [] int {
    return 5;
}

pub fn status_bad_code() -> [] int {
    return 6;
}

pub fn status_distance() -> [] int {
    return 7;
}

pub fn status_limit() -> [] int {
    return 8;
}

pub fn status_adler() -> [] int {
    return 9;
}

// ---- Adler-32 ------------------------------------------------------------------------------------------------------------------------

// The Adler-32 of `data[from..to]`, continuing `prev` (start with 1). Both sums are reduced every 5552 bytes, the most that cannot overflow a
// 32-bit word in the reference; here an integer is 64 bits, so it is a matter of keeping to the same answer, not of room.
pub fn adler32[&d](data: &d [byte], from: int, to: int, prev: int) -> [] int {
    var a = prev & 65535;
    var b = prev >> 16 & 65535;
    var k = from;
    var run = 0;
    while k < to {
        a = a + int_of(data[k]);
        b = b + a;
        k = k + 1;
        run = run + 1;
        if run == 5552 {
            a = a % 65521;
            b = b % 65521;
            run = 0;
        }
    }
    return b % 65521 << 16 | a % 65521;
}

// ---- the state of the decoder ----------------------------------------------------------------------------------------------------------
//
// One slice of integers:
//   0 the next byte of the input, 1 the bits waiting, 2 how many, 3 the status (0 until the first refusal)
//   10 .. 329 code lengths (320), 330 the literal and length code (16 counts, 288 symbols), 634 the distance code (16 counts, 32 symbols),
//   682 the code of the code lengths (16 counts, 19 symbols), 720 length bases (29), 750 length extra bits (29), 780 distance bases (30),
//   810 distance extra bits (30), 840 offsets (16)

fn state_size() -> [] int {
    return 860;
}

fn lengths() -> [] int {
    return 10;
}

fn lit_code() -> [] int {
    return 330;
}

fn dist_code() -> [] int {
    return 634;
}

fn cl_code() -> [] int {
    return 682;
}

// A refusal is kept the first time it is made, and every later step answers as if nothing were left.
fn fail[&s](t: &!s [int], status: int) -> [] int {
    if t[3] == 0 {
        t[3] = status;
    }
    return 0;
}

// `need` bits of the input, the first one read being the lowest; none is read once a refusal is made.
fn bits[&s, &d](t: &!s [int], data: &d [byte], need: int) -> [] int {
    var v = t[1];
    while t[2] < need {
        if t[0] >= len(data) {
            fail(t, 3);
            return 0;
        }
        v = v | int_of(data[t[0]]) << t[2];
        t[0] = t[0] + 1;
        t[2] = t[2] + 8;
    }
    t[1] = v >> need;
    t[2] = t[2] - need;
    return v & (1 << need) - 1;
}

// ---- Huffman codes ---------------------------------------------------------------------------------------------------------------------

// Make the code at `h` from the `n` lengths at `from`. Answers the number of codes left over: 0 for a complete code, more than 0 for an
// incomplete one, less than 0 for one that is over-subscribed (`puff.c`: `construct`).
fn construct[&s](t: &!s [int], h: int, from: int, n: int) -> [] int {
    var i = 0;
    while i < 16 {
        t[h + i] = 0;
        i = i + 1;
    }
    i = 0;
    while i < n {
        let l = t[from + i];
        t[h + l] = t[h + l] + 1;
        i = i + 1;
    }
    if t[h] == n {
        return 0;
    }
    var left = 1;
    var l = 1;
    while l < 16 {
        left = left * 2 - t[h + l];
        if left < 0 {
            return left;
        }
        l = l + 1;
    }
    t[840 + 1] = 0;
    l = 1;
    while l < 15 {
        t[840 + l + 1] = t[840 + l] + t[h + l];
        l = l + 1;
    }
    i = 0;
    while i < n {
        let l2 = t[from + i];
        if l2 != 0 {
            t[h + 16 + t[840 + l2]] = i;
            t[840 + l2] = t[840 + l2] + 1;
        }
        i = i + 1;
    }
    return left;
}

// The next symbol by the code at `h`, or -1 (and a refusal) when the bits are no code of it (`puff.c`: `decode`).
fn decode[&s, &d](t: &!s [int], data: &d [byte], h: int) -> [] int {
    var code = 0;
    var first = 0;
    var index = 0;
    var l = 1;
    while l < 16 {
        code = code | bits(t, data, 1);
        if t[3] != 0 {
            return -1;
        }
        let count = t[h + l];
        if code - count < first {
            return t[h + 16 + index + (code - first)];
        }
        index = index + count;
        first = (first + count) * 2;
        code = code * 2;
        l = l + 1;
    }
    fail(t, 6);
    return -1;
}

// ---- the blocks ------------------------------------------------------------------------------------------------------------------------

fn tables[&s](t: &!s [int]) -> [] int {
    var i = 0;
    var base = 3;
    while i < 29 {
        var extra = 0;
        if i >= 8 {
            extra = (i - 4) / 4;
        }
        if i == 28 {
            extra = 0;
        }
        t[720 + i] = base;
        t[750 + i] = extra;
        base = base + (1 << extra);
        i = i + 1;
    }
    t[720 + 28] = 258;
    i = 0;
    base = 1;
    while i < 30 {
        var extra = 0;
        if i >= 4 {
            extra = (i - 2) / 2;
        }
        t[780 + i] = base;
        t[810 + i] = extra;
        base = base + (1 << extra);
        i = i + 1;
    }
    return 0;
}

// A stored block: the rest of the byte, a length and its complement, and the bytes.
fn stored[&h, &s, &d](heap: &!h Heap, t: &!s [int], data: &d [byte], out: buffer.Buffer, limit: int) -> [heap] buffer.Buffer {
    t[1] = 0;
    t[2] = 0;
    if t[0] + 4 > len(data) {
        fail(t, 3);
        return out;
    }
    let n = int_of(data[t[0]]) | int_of(data[t[0] + 1]) << 8;
    let c = int_of(data[t[0] + 2]) | int_of(data[t[0] + 3]) << 8;
    if n != 65535 - c {
        fail(t, 5);
        return out;
    }
    t[0] = t[0] + 4;
    if t[0] + n > len(data) {
        fail(t, 3);
        return out;
    }
    var have = 0;
    borrow out as &r in {
        have = buffer.size(r);
    }
    if have + n > limit {
        fail(t, 8);
        return out;
    }
    let grown = buffer.append(heap, out, data[t[0]..t[0] + n]);
    t[0] = t[0] + n;
    return grown;
}

// The symbols of a compressed block, until its end code.
fn codes[&h, &s, &d](heap: &!h Heap, t: &!s [int], data: &d [byte], out: buffer.Buffer, limit: int) -> [heap] buffer.Buffer {
    var o = out;
    var have = 0;
    borrow o as &r0 in {
        have = buffer.size(r0);
    }
    while t[3] == 0 {
        let sym = decode(t, data, lit_code());
        if t[3] != 0 {
            return o;
        }
        if sym < 256 {
            if have + 1 > limit {
                fail(t, 8);
                return o;
            }
            o = buffer.push(heap, o, byte_of(sym));
            have = have + 1;
        } else {
            if sym == 256 {
                return o;
            }
            let s2 = sym - 257;
            if s2 >= 29 {
                fail(t, 6);
                return o;
            }
            let n = t[720 + s2] + bits(t, data, t[750 + s2]);
            let ds = decode(t, data, dist_code());
            if t[3] != 0 {
                return o;
            }
            if ds >= 30 {
                fail(t, 6);
                return o;
            }
            let dist = t[780 + ds] + bits(t, data, t[810 + ds]);
            if t[3] != 0 {
                return o;
            }
            if dist > have {
                fail(t, 7);
                return o;
            }
            if have + n > limit {
                fail(t, 8);
                return o;
            }
            var k = 0;
            while k < n {
                var v = 0;
                borrow o as &r in {
                    let all = buffer.bytes(r);
                    v = int_of(all[len(all) - dist]);
                }
                o = buffer.push(heap, o, byte_of(v));
                have = have + 1;
                k = k + 1;
            }
        }
    }
    return o;
}

// The code lengths of the fixed codes (RFC 1951 section 3.2.6), then the two codes.
fn fixed[&s](t: &!s [int]) -> [] int {
    var i = 0;
    while i < 288 {
        var l = 8;
        if i >= 144 {
            l = 9;
        }
        if i >= 256 {
            l = 7;
        }
        if i >= 280 {
            l = 8;
        }
        t[lengths() + i] = l;
        i = i + 1;
    }
    construct(t, lit_code(), lengths(), 288);
    i = 0;
    while i < 30 {
        t[lengths() + i] = 5;
        i = i + 1;
    }
    construct(t, dist_code(), lengths(), 30);
    return 0;
}

fn order(i: int) -> [] int {
    if i == 0 {
        return 16;
    }
    if i == 1 {
        return 17;
    }
    if i == 2 {
        return 18;
    }
    if i == 3 {
        return 0;
    }
    if i == 4 {
        return 8;
    }
    if i == 5 {
        return 7;
    }
    if i == 6 {
        return 9;
    }
    if i == 7 {
        return 6;
    }
    if i == 8 {
        return 10;
    }
    if i == 9 {
        return 5;
    }
    if i == 10 {
        return 11;
    }
    if i == 11 {
        return 4;
    }
    if i == 12 {
        return 12;
    }
    if i == 13 {
        return 3;
    }
    if i == 14 {
        return 13;
    }
    if i == 15 {
        return 2;
    }
    if i == 16 {
        return 14;
    }
    if i == 17 {
        return 1;
    }
    return 15;
}

// The codes of a dynamic block (`puff.c`: `dynamic`).
fn dynamic[&s, &d](t: &!s [int], data: &d [byte]) -> [] int {
    let nlen = bits(t, data, 5) + 257;
    let ndist = bits(t, data, 5) + 1;
    let ncode = bits(t, data, 4) + 4;
    if t[3] != 0 {
        return 0;
    }
    if nlen > 286 || ndist > 30 {
        fail(t, 6);
        return 0;
    }
    var i = 0;
    while i < 19 {
        t[lengths() + i] = 0;
        i = i + 1;
    }
    i = 0;
    while i < ncode {
        t[lengths() + order(i)] = bits(t, data, 3);
        i = i + 1;
    }
    if t[3] != 0 {
        return 0;
    }
    if construct(t, cl_code(), lengths(), 19) != 0 {
        fail(t, 6);
        return 0;
    }
    i = 0;
    while i < nlen + ndist {
        let sym = decode(t, data, cl_code());
        if t[3] != 0 {
            return 0;
        }
        if sym < 16 {
            t[lengths() + i] = sym;
            i = i + 1;
        } else {
            var prev = 0;
            var rep = 0;
            if sym == 16 {
                if i == 0 {
                    fail(t, 6);
                    return 0;
                }
                prev = t[lengths() + i - 1];
                rep = 3 + bits(t, data, 2);
            } else if sym == 17 {
                rep = 3 + bits(t, data, 3);
            } else {
                rep = 11 + bits(t, data, 7);
            }
            if t[3] != 0 {
                return 0;
            }
            if i + rep > nlen + ndist {
                fail(t, 6);
                return 0;
            }
            while rep > 0 {
                t[lengths() + i] = prev;
                i = i + 1;
                rep = rep - 1;
            }
        }
    }
    if t[lengths() + 256] == 0 {
        fail(t, 6);
        return 0;
    }
    let lerr = construct(t, lit_code(), lengths(), nlen);
    if lerr < 0 || lerr > 0 && nlen != t[lit_code()] + t[lit_code() + 1] {
        fail(t, 6);
        return 0;
    }
    let derr = construct(t, dist_code(), lengths() + nlen, ndist);
    if derr < 0 || derr > 0 && ndist != t[dist_code()] + t[dist_code() + 1] {
        fail(t, 6);
        return 0;
    }
    return 0;
}

// ---- the entry points ------------------------------------------------------------------------------------------------------------------

// Inflate the DEFLATE stream that starts at `data[start]`, appending to `out`; the output may not reach `limit` bytes in all. `end` is the
// index of the first byte after the stream (a byte that is partly used counts as used).
pub fn inflate[&h, &d](heap: &!h Heap, data: &d [byte], start: int, out: buffer.Buffer, limit: int) -> [heap] Inflated {
    let area = box_slice(heap, state_size(), 0);
    var o = out;
    var status = 0;
    var end = start;
    borrow mut area as &!a in {
        let t = contents(a);
        t[0] = start;
        tables(t);
        var last = 0;
        while last == 0 && t[3] == 0 {
            last = bits(t, data, 1);
            let kind = bits(t, data, 2);
            if t[3] == 0 {
                if kind == 0 {
                    o = stored(heap, t, data, o, limit);
                } else if kind == 1 {
                    fixed(t);
                    o = codes(heap, t, data, o, limit);
                } else if kind == 2 {
                    dynamic(t, data);
                    if t[3] == 0 {
                        o = codes(heap, t, data, o, limit);
                    }
                } else {
                    fail(t, 4);
                }
            }
        }
        status = t[3];
        end = t[0];
    }
    unbox_slice(heap, area);
    return Inflated { out: o, status: status, end: end };
}

// A zlib stream that starts at `data[start]`: the output appended to `out`, the status, and `end`, the index after the four bytes of the
// trailer.
pub fn unzlib[&h, &d](heap: &!h Heap, data: &d [byte], start: int, into: buffer.Buffer, limit: int) -> [heap] Inflated {
    if start + 2 > len(data) {
        return Inflated { out: into, status: 3, end: start };
    }
    let cmf = int_of(data[start]);
    let flg = int_of(data[start + 1]);
    if cmf % 16 != 8 || cmf / 16 > 7 || (cmf * 256 + flg) % 31 != 0 {
        return Inflated { out: into, status: 1, end: start };
    }
    if flg / 32 % 2 == 1 {
        return Inflated { out: into, status: 2, end: start };
    }
    var before = 0;
    borrow into as &r0 in {
        before = buffer.size(r0);
    }
    let r = inflate(heap, data, start + 2, into, limit);
    let Inflated { out, status, end } = r;
    if status != 0 {
        return Inflated { out: out, status: status, end: end };
    }
    if end + 4 > len(data) {
        return Inflated { out: out, status: 3, end: end };
    }
    var sum = 1;
    borrow out as &m in {
        let all = buffer.bytes(m);
        sum = adler32(all, before, len(all), 1);
    }
    let want = int_of(data[end]) << 24 | int_of(data[end + 1]) << 16 | int_of(data[end + 2]) << 8 | int_of(data[end + 3]);
    if want != sum {
        return Inflated { out: out, status: 9, end: end + 4 };
    }
    return Inflated { out: out, status: 0, end: end + 4 };
}

// A zlib stream of stored blocks holding `data`, appended to `out`: the header (78 01), blocks of at most 65,535 bytes (one, empty, for no
// data), and the Adler-32.
pub fn zlib_stored[&h, &d](heap: &!h Heap, data: &d [byte], out: buffer.Buffer) -> [heap] buffer.Buffer {
    var o = buffer.push(heap, out, byte_of(120));
    o = buffer.push(heap, o, byte_of(1));
    let n = len(data);
    var at = 0;
    var more = true;
    while more {
        var chunk = n - at;
        if chunk > 65535 {
            chunk = 65535;
        }
        var final = 0;
        if at + chunk == n {
            final = 1;
        }
        o = buffer.push(heap, o, byte_of(final));
        o = buffer.push(heap, o, byte_of(chunk & 255));
        o = buffer.push(heap, o, byte_of(chunk >> 8));
        o = buffer.push(heap, o, byte_of(65535 - chunk & 255));
        o = buffer.push(heap, o, byte_of(65535 - chunk >> 8));
        o = buffer.append(heap, o, data[at..at + chunk]);
        at = at + chunk;
        more = final == 0;
    }
    let sum = adler32(data, 0, n, 1);
    o = buffer.push(heap, o, byte_of(sum >> 24 & 255));
    o = buffer.push(heap, o, byte_of(sum >> 16 & 255));
    o = buffer.push(heap, o, byte_of(sum >> 8 & 255));
    o = buffer.push(heap, o, byte_of(sum & 255));
    return o;
}
