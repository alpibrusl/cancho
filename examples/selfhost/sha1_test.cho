module selfhost.sha1_test;

// sha1_test.cho -- tests of `sha1.cho`, run by `cancho test examples/selfhost/sha1_test.cho examples/selfhost/sha1.cho examples/selfhost/hex.cho --std`.
//
// The oracles are fixed: the vectors of FIPS 180-4 and the digest of a git blob ("hello\n" is `ce01362...`, what `git hash-object` says),
// and a table of the digests of the messages of 0 to 130 bytes (`byte i = i * 7 + 3`), written once by Python's `hashlib`, which covers every
// length around the block (55, 56, 63, 64, 65, 119, 120).

import selfhost.hex;
import selfhost.sha1;

// The 20 bytes of `out` are the digest written as 40 hexadecimal digits in `want` from `at`.
fn same[&o, &w](out: &o [byte], want: &w [byte], at: int) -> [] bool {
    var i = 0;
    while i < 20 {
        let x = hex.value(int_of(want[at + 2 * i])) * 16 + hex.value(int_of(want[at + 2 * i + 1]));
        if x != int_of(out[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn of_text[&h, &t](heap: &!h Heap, text: &t [byte], want: &t [byte]) -> [heap] bool {
    let area = box_slice(heap, sha1.size(), 0);
    let out = box_slice(heap, 20, byte_of(0));
    var ok = false;
    borrow mut area as &!a in {
        borrow mut out as &!o in {
            let st = contents(a);
            let digest = contents(o);
            sha1.init(st, 0);
            sha1.update(st, 0, text);
            sha1.finish(st, 0, digest);
            ok = same(digest, want, 0);
        }
    }
    unbox_slice(heap, area);
    unbox_slice(heap, out);
    return ok;
}

pub fn test_fips_vectors[&h](heap: &!h Heap) -> [heap] int {
    if !of_text(heap, "", "da39a3ee5e6b4b0d3255bfef95601890afd80709") {
        return 1;
    }
    if !of_text(heap, "abc", "a9993e364706816aba3e25717850c26c9cd0d89d") {
        return 2;
    }
    if !of_text(heap, "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "84983e441c3bd26ebaae4aa1f95129e5e54670f1") {
        return 3;
    }
    return 0;
}

pub fn test_a_git_blob[&h](heap: &!h Heap) -> [heap] int {
    // "blob 6\0hello\n"
    if !of_text(heap, "blob 6\0hello\n", "ce013625030ba8dba906f756967f9e9ca394464a") {
        return 1;
    }
    return 0;
}

// A million 'a', in runs of 1000 (so `update` meets the buffer full, empty and in between) and then the same by single bytes.
pub fn test_a_million_a[&h](heap: &!h Heap) -> [heap] int {
    let area = box_slice(heap, sha1.size(), 0);
    let out = box_slice(heap, 20, byte_of(0));
    let run = box_slice(heap, 1000, byte_of(97));
    var code = 0;
    borrow mut area as &!a in {
        borrow mut out as &!o in {
            borrow mut run as &!r in {
                let st = contents(a);
                let digest = contents(o);
                let chunk = contents(r);
                sha1.init(st, 0);
                var k = 0;
                while k < 1000 {
                    sha1.update(st, 0, chunk);
                    k = k + 1;
                }
                sha1.finish(st, 0, digest);
                if !same(digest, "34aa973cd4c4daa4f61eeb2bdbad27316534016f", 0) {
                    code = 1;
                }
                sha1.init(st, 0);
                k = 0;
                while k < 1000000 {
                    sha1.byte(st, 0, 97);
                    k = k + 1;
                }
                sha1.finish(st, 0, digest);
                if !same(digest, "34aa973cd4c4daa4f61eeb2bdbad27316534016f", 0) {
                    code = 2;
                }
            }
        }
    }
    unbox_slice(heap, area);
    unbox_slice(heap, out);
    unbox_slice(heap, run);
    return code;
}

// Every length from 0 to 130, whole, against `hashlib`, and cut in two at every point for the lengths up to 130 (the split changes where the
// block boundary falls in `update`).
pub fn test_every_length_against_hashlib[&h](heap: &!h Heap) -> [heap] int {
    let table = "";
    let area = box_slice(heap, sha1.size(), 0);
    let out = box_slice(heap, 20, byte_of(0));
    let msg = box_slice(heap, 131, byte_of(0));
    var code = 0;
    borrow mut area as &!a in {
        borrow mut out as &!o in {
            borrow mut msg as &!m in {
                let st = contents(a);
                let digest = contents(o);
                let data = contents(m);
                var i = 0;
                while i < 131 {
                    data[i] = byte_of(i * 7 + 3 & 255);
                    i = i + 1;
                }
                var n = 0;
                while n < 131 {
                    sha1.init(st, 0);
                    sha1.update(st, 0, data[0..n]);
                    sha1.finish(st, 0, digest);
                    if !same(digest, table, 40 * n) {
                        code = 1000 + n;
                    }
                    var cut = 0;
                    while cut <= n {
                        sha1.init(st, 0);
                        sha1.update(st, 0, data[0..cut]);
                        sha1.update(st, 0, data[cut..n]);
                        sha1.finish(st, 0, digest);
                        if !same(digest, table, 40 * n) {
                            code = 100000 + 1000 * n + cut;
                        }
                        cut = cut + 1;
                    }
                    n = n + 1;
                }
            }
        }
    }
    unbox_slice(heap, area);
    unbox_slice(heap, out);
    unbox_slice(heap, msg);
    return code;
}
