pub fn split_for(edition: int) -> [] int {
    if edition >= 8 {
        return 50;
    }
    if edition >= 7 {
        return 38;
    }
    if edition >= 6 {
        return 28;
    }
    if edition >= 5 {
        return 24;
    }
    if edition >= 2 {
        return 12;
    }
    return 7;
}

pub fn builtin_sig(i: int) -> [] int {
    return builtin_sigs[i];
}

// Where builtin b's signature starts in `builtin_sig`.
pub fn builtin_sig_start(b: int) -> [] int {
    return builtin_sig_starts[b];
}

pub fn builtin_regions(b: int) -> [] int {
    return builtin_region_counts[b];
}

// How many labels builtin b performs, and label k of them as 2 * the label's number, plus 1 if it
// carries an argument (a path, a host).
pub fn builtin_effect_count(b: int) -> [] int {
    return builtin_effect_counts[b];
}

pub fn builtin_effect(b: int, k: int) -> [] int {
    return builtin_effect_stream[builtin_effect_starts[b] + k];
}

pub fn effect_name(i: int) -> [] &static [byte] {
    let start = effect_name_starts[i];
    return effect_chars()[start..start + effect_name_lens[i]];
}

pub fn prelude_field_count(d: int) -> [] int {
    return prelude_field_counts[d];
}

// Field k of prelude struct d is field number `prelude_field_first(d) + k` of all.
pub fn prelude_field_first(d: int) -> [] int {
    return prelude_field_firsts[d];
}

pub fn field_name(f: int) -> [] &static [byte] {
    let start = field_name_starts[f];
    return field_chars()[start..start + field_name_lens[f]];
}

// Where field f's type starts in `field_type`.
pub fn field_type_start(f: int) -> [] int {
    return field_type_starts[f];
}

pub fn field_type(i: int) -> [] int {
    return field_types[i];
}
