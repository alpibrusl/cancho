module selfhost.formatting;

// formatting.cho -- `cancho fmt`, written in cancho (issue #485, `docs/formatting.md`).
//
// A port of `crates/cancho-syntax/src/format.rs`, the part that needs no tree: it is given the text of a file and the text the canonical
// printer (`printing.cho`) wrote for it, aligns the two token streams, and puts back what the printer cannot know: the comments, one
// blank line where the source had one or more, the way a literal was spelled and the `edition N;` line. The oracle is `cancho fmt`;
// `tests/conformance/selfhost.rs` compares the two over every program in the repository.
//
// Not here: the checks that make the result safe to write over a file (it parses, to a tree that prints as the original does; it holds
// the same comments; formatting it again changes nothing). They need the printer run on the result, so they belong to what runs the
// printer and this in turn -- the driver does it for the tests and the command line will.
//
// Everything is kept in one array of integers (`m`): the tokens of the source, of the printed text and of the printed text with the
// spellings put back, the comments, and the tables the placing needs. `layout` says where each of them is.

import std.buffer;
import selfhost.lexcore as lc;

// ---------------------------------------------------------------- layout ---

// Slots of the array `m`. Slots 0 to 7 are sizes and counts; the others are the places of the tables (an offset into `m`).
fn s_src_len() -> [] int {
    return 0;
}

fn s_out_len() -> [] int {
    return 1;
}

// The counts of the source's tokens and comments, of the printed text's, and of the respelled text's: three pairs from slot 2.
fn s_counts_in() -> [] int {
    return 2;
}

fn s_counts_out() -> [] int {
    return 4;
}

fn s_counts_all() -> [] int {
    return 6;
}

fn s_lines() -> [] int {
    return 8;
}

fn s_repls() -> [] int {
    return 9;
}

// A token table is three tables (kind, start, end) at three consecutive slots.
fn s_in() -> [] int {
    return 10;
}

fn s_in_comments() -> [] int {
    return 13;
}

fn s_out() -> [] int {
    return 15;
}

fn s_out_comments() -> [] int {
    return 18;
}

fn s_all() -> [] int {
    return 20;
}

fn s_all_comments() -> [] int {
    return 23;
}

fn s_map() -> [] int {
    return 25;
}

fn s_dropped() -> [] int {
    return 26;
}

fn s_repl() -> [] int {
    return 27;
}

fn s_all_line() -> [] int {
    return 28;
}

fn s_all_last() -> [] int {
    return 29;
}

fn s_in_line() -> [] int {
    return 30;
}

fn s_in_last() -> [] int {
    return 31;
}

fn s_line_start() -> [] int {
    return 32;
}

fn s_line_end() -> [] int {
    return 33;
}

fn s_blank() -> [] int {
    return 34;
}

fn s_seen() -> [] int {
    return 35;
}

fn s_at_end() -> [] int {
    return 36;
}

fn s_anchor() -> [] int {
    return 37;
}

fn s_blank_above() -> [] int {
    return 38;
}

fn s_first() -> [] int {
    return 39;
}

fn s_order() -> [] int {
    return 40;
}

fn header() -> [] int {
    return 48;
}

// How many integers `m` needs for a source of `ls` bytes and printed text of `lp`.
pub fn size_for(ls: int, lp: int) -> [] int {
    let tokens_in = ls + 2;
    let comments_in = ls / 2 + 2;
    let tokens_out = lp + 2;
    let comments_out = lp / 2 + 2;
    let tokens_all = lp + ls + 24;
    let lines = tokens_all;
    return header() + 7 * tokens_in + 5 * comments_in + 7 * tokens_out + 2 * comments_out + 7 * tokens_all + 6 * lines + 64;
}

// Hand out the tables in order.
pub fn layout[&s](m: &!s [int], ls: int, lp: int) -> [] int {
    let tokens_in = ls + 2;
    let comments_in = ls / 2 + 2;
    let tokens_out = lp + 2;
    let comments_out = lp / 2 + 2;
    let tokens_all = lp + ls + 24;
    let lines = tokens_all;
    m[s_src_len()] = ls;
    m[s_out_len()] = lp;
    var at = header();
    var k = 0;
    while k < 3 {
        m[s_in() + k] = at;
        at = at + tokens_in;
        k = k + 1;
    }
    m[s_in_comments()] = at;
    at = at + comments_in;
    m[s_in_comments() + 1] = at;
    at = at + comments_in;
    k = 0;
    while k < 3 {
        m[s_out() + k] = at;
        at = at + tokens_out;
        k = k + 1;
    }
    m[s_out_comments()] = at;
    at = at + comments_out;
    m[s_out_comments() + 1] = at;
    at = at + comments_out;
    k = 0;
    while k < 3 {
        m[s_all() + k] = at;
        at = at + tokens_all;
        k = k + 1;
    }
    m[s_all_comments()] = at;
    at = at + tokens_all;
    m[s_all_comments() + 1] = at;
    at = at + tokens_all;
    m[s_map()] = at;
    at = at + tokens_in;
    m[s_dropped()] = at;
    at = at + tokens_in;
    m[s_repl()] = at;
    at = at + 4 * tokens_out;
    m[s_all_line()] = at;
    at = at + tokens_all;
    m[s_all_last()] = at;
    at = at + tokens_all;
    m[s_in_line()] = at;
    at = at + tokens_in;
    m[s_in_last()] = at;
    at = at + tokens_in;
    m[s_line_start()] = at;
    at = at + lines;
    m[s_line_end()] = at;
    at = at + lines;
    m[s_blank()] = at;
    at = at + lines + 4;
    m[s_seen()] = at;
    at = at + lines + 4;
    m[s_at_end()] = at;
    at = at + lines + 4;
    m[s_anchor()] = at;
    at = at + comments_in;
    m[s_blank_above()] = at;
    at = at + comments_in;
    m[s_first()] = at;
    at = at + lines + 4;
    m[s_order()] = at;
    at = at + comments_in;
    return at;
}

fn rd[&s](m: &!s [int], slot: int, i: int) -> [] int {
    return m[m[slot] + i];
}

fn wr[&s](m: &!s [int], slot: int, i: int, v: int) -> [] int {
    m[m[slot] + i] = v;
    return 0;
}

// ---------------------------------------------------------------- tokens ---

// The tokens and the comments of `text`, into the tables at `table` (kind, start, end) and `comments` (start, end), and the two counts
// at `counts`. 0 if it all tokenises, else the offset of what does not, plus one.
fn tokenise[&s, &x](m: &!s [int], text: &x [byte], table: int, comments: int, counts: int) -> [] int {
    var i = 0;
    var n = 0;
    var c = 0;
    var after_dot = false;
    var bad = 0;
    while i < len(text) && bad == 0 {
        match lc.step(text, i, after_dot) {
            lc.Step::Skip(next) => {
                if lc.at(text, i) == '/' && lc.at(text, i + 1) == '/' {
                    wr(m, comments, c, i);
                    wr(m, comments + 1, c, next);
                    c = c + 1;
                }
                i = next;
            }
            lc.Step::Token(k, from, to) => {
                wr(m, table, n, lc.code(k));
                wr(m, table + 1, n, from);
                wr(m, table + 2, n, to);
                n = n + 1;
                after_dot = lc.is_dot(k);
                i = to;
            }
            lc.Step::Fail(rule, from, to) => {
                bad = from + 1;
            }
        }
    }
    m[counts] = n;
    m[counts + 1] = c;
    return bad;
}

fn code(t: lc.Tok) -> [] int {
    return lc.code(t);
}

fn is_literal(k: int) -> [] bool {
    return k == code(lc.Tok::Int) || k == code(lc.Tok::Float) || k == code(lc.Tok::Str);
}

// Do the bytes `a` to `b` of `x` and `c` to `d` of `y` spell the same?
fn same_text[&x, &y](x: &x [byte], a: int, b: int, y: &y [byte], c: int, d: int) -> [] bool {
    if b - a != d - c {
        return false;
    }
    var k = 0;
    while k < b - a {
        if lc.at(x, a + k) != lc.at(y, c + k) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// How many of the `n` sorted numbers at `slot` are below `x`.
fn below[&s](m: &!s [int], slot: int, n: int, x: int) -> [] int {
    var lo = 0;
    var hi = n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if rd(m, slot, mid) < x {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

// How many newlines are in the bytes `from` to `to` of `text`.
fn newlines[&x](text: &x [byte], from: int, to: int) -> [] int {
    var n = 0;
    var k = from;
    while k < to {
        if lc.at(text, k) == '\n' {
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

// ---------------------------------------------------------------- output ---

fn put[&h, &r](heap: &!h Heap, b: buffer.Buffer, s: &r [byte]) -> [heap] buffer.Buffer {
    return buffer.append(heap, b, s);
}

fn put_byte[&h](heap: &!h Heap, b: buffer.Buffer, c: int) -> [heap] buffer.Buffer {
    return buffer.push(heap, b, byte_of(c));
}

fn put_number[&h](heap: &!h Heap, b: buffer.Buffer, n: int) -> [heap] buffer.Buffer {
    return buffer.push_nat(heap, b, n);
}

fn is_blank_byte(c: int) -> [] bool {
    return c == ' ' || c == '\t' || c == '\r' || c == '\n' || c == 11 || c == 12;
}

// The end of the bytes `from` to `to` of `text` without the white space at the end.
fn trimmed_end[&x](text: &x [byte], from: int, to: int) -> [] int {
    var e = to;
    while e > from && is_blank_byte(lc.at(text, e - 1)) {
        e = e - 1;
    }
    return e;
}

// ---------------------------------------------------------------- refusal ---

// `CANNOT line N: ...`: the sentence `format.rs` gives.
fn cannot_line[&h](heap: &!h Heap, out: buffer.Buffer, line: int, what: &static [byte]) -> [heap] buffer.Buffer {
    var b = out;
    b = put(heap, b, "CANNOT line ");
    b = put_number(heap, b, line);
    b = put(heap, b, ": ");
    b = put(heap, b, what);
    return b;
}

// ---------------------------------------------------------------- format ---

pub res struct Formatted {
    text: buffer.Buffer,
    status: int,
}

// The formatted text of `src`, whose canonical rendering is `printed`: status 0, or status 1 and the line `CANNOT ...` in its place.
pub fn format[&h, &s, &x, &y](heap: &!h Heap, m: &!s [int], src: &x [byte], printed: &y [byte]) -> [heap] Formatted {
    var out = buffer.empty(heap, len(src) + len(printed) + 64);
    let bad_in = tokenise(m, src, s_in(), s_in_comments(), s_counts_in());
    if bad_in != 0 {
        out = put(heap, out, "CANNOT the source does not tokenise");
        return Formatted { text: out, status: 1 };
    }
    let bad_out = tokenise(m, printed, s_out(), s_out_comments(), s_counts_out());
    if bad_out != 0 {
        out = put(heap, out, "CANNOT the canonical rendering does not tokenise");
        return Formatted { text: out, status: 1 };
    }
    let nin = m[s_counts_in()];
    let nout = m[s_counts_out()];

    // `print` has no edition marker to print, and dropping it would change what the file means: it is carried across as the first line.
    var skip = 0;
    if nin >= 3 && rd(m, s_in(), 0) == code(lc.Tok::Ident) && lc.spells(src, rd(m, s_in() + 1, 0), rd(m, s_in() + 2, 0), "edition") && rd(m, s_in(), 1) == code(lc.Tok::Int) && rd(m, s_in(), 2) == code(lc.Tok::Semi) {
        skip = 3;
    }

    // `pub extern fn`: the parser reads and discards the `pub`.
    var k = 0;
    while k < nin {
        wr(m, s_dropped(), k, 0);
        wr(m, s_map(), k, 0 - 1);
        if k + 1 < nin && rd(m, s_in(), k) == code(lc.Tok::Pub) && rd(m, s_in(), k + 1) == code(lc.Tok::Extern) {
            wr(m, s_dropped(), k, 1);
        }
        k = k + 1;
    }

    // Align, rewriting each literal to the way the source spelled it.
    var i = skip;
    var j = 0;
    var nrepl = 0;
    var refused = false;
    while i < nin && !refused {
        let ak = rd(m, s_in(), i);
        var bk = 0 - 1;
        if j < nout {
            bk = rd(m, s_out(), j);
        }
        if ak == code(lc.Tok::LBrace) && i > 0 && rd(m, s_in(), i - 1) == code(lc.Tok::Else) && bk == code(lc.Tok::If) {
            // `else { if .. }` prints as `else if ..`: the braces have no counterpart. The `}` that closes this block is dropped.
            var depth = 0;
            var q = i;
            var found = 0 - 1;
            while q < nin && found < 0 {
                let qk = rd(m, s_in(), q);
                if qk == code(lc.Tok::LBrace) {
                    depth = depth + 1;
                }
                if qk == code(lc.Tok::RBrace) {
                    depth = depth - 1;
                    if depth == 0 {
                        found = q;
                    }
                }
                q = q + 1;
            }
            if found >= 0 {
                wr(m, s_dropped(), found, 1);
            }
            i = i + 1;
        } else if rd(m, s_dropped(), i) == 1 {
            i = i + 1;
        } else if bk >= 0 && ak == bk && is_literal(ak) {
            let a = rd(m, s_in() + 1, i);
            let b = rd(m, s_in() + 2, i);
            let c = rd(m, s_out() + 1, j);
            let d = rd(m, s_out() + 2, j);
            if !same_text(src, a, b, printed, c, d) {
                wr(m, s_repl(), 4 * nrepl, c);
                wr(m, s_repl(), 4 * nrepl + 1, d);
                wr(m, s_repl(), 4 * nrepl + 2, a);
                wr(m, s_repl(), 4 * nrepl + 3, b);
                nrepl = nrepl + 1;
            }
            wr(m, s_map(), i, j);
            i = i + 1;
            j = j + 1;
        } else if bk >= 0 && ak == bk && same_text(src, rd(m, s_in() + 1, i), rd(m, s_in() + 2, i), printed, rd(m, s_out() + 1, j), rd(m, s_out() + 2, j)) {
            wr(m, s_map(), i, j);
            i = i + 1;
            j = j + 1;
        } else if ak == code(lc.Tok::LParen) || ak == code(lc.Tok::RParen) || ak == code(lc.Tok::Comma) {
            // A redundant parenthesis, or a trailing comma, the printer did not write.
            i = i + 1;
        } else if bk == code(lc.Tok::Comma) {
            // A trailing comma the printer wrote and the source did not.
            j = j + 1;
        } else {
            refused = true;
            let line = newlines(src, 0, rd(m, s_in() + 1, i)) + 1;
            if bk == code(lc.Tok::Import) {
                // The printer writes every `import` before the first declaration; one written further down has nowhere to stay.
                var at = line;
                var q = i;
                var late = false;
                while q < nin && !late {
                    if rd(m, s_in(), q) == code(lc.Tok::Import) {
                        at = newlines(src, 0, rd(m, s_in() + 1, q)) + 1;
                        late = true;
                    }
                    q = q + 1;
                }
                out = cannot_line(heap, out, at, "an `import` after the first declaration; the canonical form puts every import before it, so move this one up");
            } else {
                out = put(heap, out, "CANNOT line ");
                out = put_number(heap, out, line);
                out = put(heap, out, ": `");
                out = put(heap, out, src[rd(m, s_in() + 1, i)..rd(m, s_in() + 2, i)]);
                out = put(heap, out, "` has no counterpart in the canonical rendering; the layout is not something this formatter can reproduce");
            }
        }
    }
    if refused {
        return Formatted { text: out, status: 1 };
    }
    var rest = false;
    while j < nout {
        if rd(m, s_out(), j) != code(lc.Tok::Comma) {
            rest = true;
        }
        j = j + 1;
    }
    if rest {
        out = put(heap, out, "CANNOT the canonical rendering has tokens the source does not");
        return Formatted { text: out, status: 1 };
    }
    m[s_repls()] = nrepl;

    // The printed text with the spellings put back, after the edition line if there is one.
    var all = buffer.empty(heap, len(src) + len(printed) + 32);
    if skip == 3 {
        all = put(heap, all, "edition ");
        all = put(heap, all, src[rd(m, s_in() + 1, 1)..rd(m, s_in() + 2, 1)]);
        all = put(heap, all, ";\n");
    }
    var at = 0;
    k = 0;
    while k < nrepl {
        all = put(heap, all, printed[at..rd(m, s_repl(), 4 * k)]);
        all = put(heap, all, src[rd(m, s_repl(), 4 * k + 2)..rd(m, s_repl(), 4 * k + 3)]);
        at = rd(m, s_repl(), 4 * k + 1);
        k = k + 1;
    }
    all = put(heap, all, printed[at..len(printed)]);

    borrow all as &t in {
        let spelled = buffer.bytes(t);
        out = place(heap, m, src, spelled, out, skip);
    }
    buffer.drop(heap, all);
    return Formatted { text: out, status: 0 };
}

// Everything after the alignment: where each source token landed in `spelled` (the edition line and the printed text), the comments
// and the blank lines placed by it, and the lines written to `out`.
fn place[&h, &s, &x, &y](heap: &!h Heap, m: &!s [int], src: &x [byte], spelled: &y [byte], out: buffer.Buffer, skip: int) -> [heap] buffer.Buffer {
    var o = out;
    let nin = m[s_counts_in()];
    let ncom = m[s_counts_in() + 1];
    tokenise(m, spelled, s_all(), s_all_comments(), s_counts_all());
    let nall = m[s_counts_all()];

    // The lines of the text.
    var nlines = 0;
    var start = 0;
    var p = 0;
    while p < len(spelled) {
        if lc.at(spelled, p) == '\n' {
            wr(m, s_line_start(), nlines, start);
            wr(m, s_line_end(), nlines, p);
            nlines = nlines + 1;
            start = p + 1;
        }
        p = p + 1;
    }
    if start < len(spelled) {
        wr(m, s_line_start(), nlines, start);
        wr(m, s_line_end(), nlines, len(spelled));
        nlines = nlines + 1;
    }
    m[s_lines()] = nlines;

    // The line of each token of the text, and whether it is the last on its line.
    var line = 0;
    p = 0;
    var t = 0;
    while t < nall {
        let at = rd(m, s_all() + 1, t);
        while p < at {
            if lc.at(spelled, p) == '\n' {
                line = line + 1;
            }
            p = p + 1;
        }
        wr(m, s_all_line(), t, line);
        t = t + 1;
    }
    t = 0;
    while t < nall {
        var last = 1;
        if t + 1 < nall && rd(m, s_all_line(), t + 1) == rd(m, s_all_line(), t) {
            last = 0;
        }
        wr(m, s_all_last(), t, last);
        t = t + 1;
    }

    // Where each source token went: the edition marker's three tokens are the first three of the text; the others by the alignment.
    var n = 0;
    while n < nin {
        var j = 0 - 1;
        if n < skip {
            j = n;
        } else if rd(m, s_map(), n) >= 0 {
            j = rd(m, s_map(), n) + skip;
        }
        if j >= 0 && j < nall {
            wr(m, s_in_line(), n, rd(m, s_all_line(), j));
            wr(m, s_in_last(), n, rd(m, s_all_last(), j));
        } else {
            wr(m, s_in_line(), n, 0 - 1);
            wr(m, s_in_last(), n, 0);
        }
        n = n + 1;
    }

    n = 0;
    while n <= nlines {
        wr(m, s_blank(), n, 0);
        wr(m, s_seen(), n, 0);
        wr(m, s_at_end(), n, 0 - 1);
        n = n + 1;
    }

    // Blank lines before each output line's first token. What precedes a position is the previous token or comment, whichever is later.
    n = 0;
    while n < nin {
        let l = rd(m, s_in_line(), n);
        if l >= 0 && rd(m, s_seen(), l) == 0 {
            wr(m, s_seen(), l, 1);
            let a = rd(m, s_in() + 1, n);
            if blank_between(m, src, nin, ncom, a) {
                wr(m, s_blank(), l, 1);
            }
        }
        n = n + 1;
    }

    // Per comment: the end of an output line, or above the line of the next token.
    var c = 0;
    while c < ncom {
        let cs = rd(m, s_in_comments(), c);
        let ce = rd(m, s_in_comments() + 1, c);
        let prev = below(m, s_in() + 2, nin, cs + 1) - 1;
        let nxt = below(m, s_in() + 1, nin, ce);
        var placed = false;
        if prev >= 0 && newlines(src, rd(m, s_in() + 2, prev), cs) == 0 {
            // The line the nearest placed token at or before it ended up on, if that token ends it.
            var q = prev;
            while q >= 0 && rd(m, s_in_line(), q) < 0 {
                q = q - 1;
            }
            if q >= 0 {
                let l = rd(m, s_in_line(), q);
                if rd(m, s_in_last(), q) == 1 && rd(m, s_at_end(), l) < 0 {
                    wr(m, s_at_end(), l, c);
                    placed = true;
                }
            }
        }
        if !placed {
            var anchor = nlines;
            var q = nxt;
            var found = false;
            while q < nin && !found {
                if rd(m, s_in_line(), q) >= 0 {
                    anchor = rd(m, s_in_line(), q);
                    found = true;
                }
                q = q + 1;
            }
            wr(m, s_anchor(), c, anchor);
            if blank_between(m, src, nin, ncom, cs) {
                wr(m, s_blank_above(), c, 1);
            } else {
                wr(m, s_blank_above(), c, 0);
            }
        } else {
            wr(m, s_anchor(), c, 0 - 1);
        }
        c = c + 1;
    }

    // The comments above a line, in order: by counting.
    n = 0;
    while n <= nlines + 1 {
        wr(m, s_first(), n, 0);
        n = n + 1;
    }
    c = 0;
    while c < ncom {
        let a = rd(m, s_anchor(), c);
        if a >= 0 {
            wr(m, s_first(), a + 1, rd(m, s_first(), a + 1) + 1);
        }
        c = c + 1;
    }
    n = 0;
    while n <= nlines {
        wr(m, s_first(), n + 1, rd(m, s_first(), n + 1) + rd(m, s_first(), n));
        n = n + 1;
    }
    c = 0;
    while c < ncom {
        let a = rd(m, s_anchor(), c);
        if a >= 0 {
            // The slot of the next free place of that line is its start plus how many it has already: kept in the order table.
            var s = rd(m, s_first(), a);
            while s < rd(m, s_first(), a + 1) && rd(m, s_order(), s) != 0 {
                s = s + 1;
            }
            wr(m, s_order(), s, c + 1);
        }
        c = c + 1;
    }

    // Assemble.
    n = 0;
    while n <= nlines {
        var closes = false;
        var indent = 0;
        if n < nlines {
            let a = rd(m, s_line_start(), n);
            let b = rd(m, s_line_end(), n);
            while a + indent < b && lc.at(spelled, a + indent) == ' ' {
                indent = indent + 1;
            }
            if a + indent < b && lc.at(spelled, a + indent) == '}' {
                closes = true;
            }
        }
        var comment_indent = indent;
        if n == nlines {
            comment_indent = 0;
        } else if closes {
            comment_indent = indent + 4;
        }
        var s = rd(m, s_first(), n);
        while s < rd(m, s_first(), n + 1) {
            let which = rd(m, s_order(), s) - 1;
            if which >= 0 {
                if rd(m, s_blank_above(), which) == 1 {
                    o = push_blank(heap, o);
                }
                var sp = 0;
                while sp < comment_indent {
                    o = put_byte(heap, o, ' ');
                    sp = sp + 1;
                }
                let cs = rd(m, s_in_comments(), which);
                let ce = rd(m, s_in_comments() + 1, which);
                o = put(heap, o, src[cs..trimmed_end(src, cs, ce)]);
                o = put_byte(heap, o, '\n');
            }
            s = s + 1;
        }
        if n < nlines {
            let a = rd(m, s_line_start(), n);
            let b = rd(m, s_line_end(), n);
            if rd(m, s_blank(), n) == 1 && !closes && b > a {
                o = push_blank(heap, o);
            }
            o = put(heap, o, spelled[a..b]);
            let which = rd(m, s_at_end(), n);
            if which >= 0 {
                let cs = rd(m, s_in_comments(), which);
                let ce = rd(m, s_in_comments() + 1, which);
                o = put_byte(heap, o, ' ');
                o = put(heap, o, src[cs..trimmed_end(src, cs, ce)]);
            }
            o = put_byte(heap, o, '\n');
        }
        n = n + 1;
    }
    return o;
}

// Is there a blank line between what precedes `at` (the previous token or comment, whichever is later) and `at`?
fn blank_between[&s, &x](m: &!s [int], src: &x [byte], nin: int, ncom: int, at: int) -> [] bool {
    let t = below(m, s_in() + 2, nin, at + 1);
    let c = below(m, s_in_comments() + 1, ncom, at + 1);
    var from = 0;
    if t > 0 {
        from = rd(m, s_in() + 2, t - 1);
    }
    if c > 0 && rd(m, s_in_comments() + 1, c - 1) > from {
        from = rd(m, s_in_comments() + 1, c - 1);
    }
    return newlines(src, from, at) >= 2;
}

// A blank line, unless the output is empty, already ends in one, or ends in `{`.
fn push_blank[&h](heap: &!h Heap, o: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = o;
    var add = false;
    borrow b as &t in {
        let bytes = buffer.bytes(t);
        let n = len(bytes);
        if n >= 2 && lc.at(bytes, n - 1) == '\n' && lc.at(bytes, n - 2) != '\n' && lc.at(bytes, n - 2) != '{' {
            add = true;
        }
    }
    if add {
        b = put_byte(heap, b, '\n');
    }
    return b;
}

// The text without the empty lines at its end.
pub fn finish[&h, &x](heap: &!h Heap, text: &x [byte]) -> [heap] buffer.Buffer {
    var e = len(text);
    while e >= 2 && lc.at(text, e - 1) == '\n' && lc.at(text, e - 2) == '\n' {
        e = e - 1;
    }
    if e == 1 && lc.at(text, 0) == '\n' {
        e = 0;
    }
    return buffer.append(heap, buffer.empty(heap, e + 1), text[0..e]);
}

// The comments of `text`, in order, each without the white space at its end and followed by a newline: what the second check of
// `docs/formatting.md` section 4 compares (the same comments, in the same order). Nothing if `text` does not tokenise.
pub fn comments_of[&h, &x](heap: &!h Heap, text: &x [byte]) -> [heap] buffer.Buffer {
    var out = buffer.empty(heap, 64);
    let area = box_slice(heap, size_for(len(text), len(text)), 0);
    borrow mut area as &!b in {
        let m = contents(b);
        layout(m, len(text), len(text));
        if tokenise(m, text, s_all(), s_all_comments(), s_counts_all()) == 0 {
            var c = 0;
            while c < m[s_counts_all() + 1] {
                let from = rd(m, s_all_comments(), c);
                let to = trimmed_end(text, from, rd(m, s_all_comments() + 1, c));
                out = buffer.append(heap, out, text[from..to]);
                out = put_byte(heap, out, '\n');
                c = c + 1;
            }
        }
    }
    unbox_slice(heap, area);
    return out;
}
