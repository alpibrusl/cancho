module selfhost.pass1;

// pass1.cho -- the first half of the cancho checker, written in cancho.
//
// Stage 3b of the self-hosting spike (`docs/self-hosting.md` section 6, epic #295): a port
// of what `crates/cancho-ir/src/lib.rs` calls `collect_declarations` -- imports, type
// declarations, statics and function signatures, in that order, stopping at the first
// refusal -- over the tree `ast.cho` builds. No body is read here.
//
// The oracle is `cancho_ir::check_declarations`, which is that half and nothing else, so the
// first refusal of this port must be the first refusal of the Rust checker, rule and span.
// `foreign.cho` is the foreign declarations, which run between the types and the statics, and
// `checker.cho` is the order.
//
// A type is resolved *in place*: each `TName` node gets what it names in slots 8..10 (8 the
// class: 0 a scalar, 1 a type parameter, 2 a prelude type, 3 a type the file declares; 9 the
// prelude index or the declaring item; 10 which scalar), which is what the tree is for.
//
// How a definition is named: a prelude type by its index in `tables.cho` (the Rust order,
// which is its `DefId`), a type the file declares by `user_base() + item`.

import selfhost.lexcore as lc;
import selfhost.ast;
import selfhost.rules;
import selfhost.kinds;
import selfhost.tables;

pub fn user_base() -> [] int {
    return 100000;
}

// --------------------------------------------------------------- tokens ---

pub fn is_word[&s, &x](st: &!s [int], text: &x [byte], tok: int, spelled: &static [byte]) -> [] bool {
    return lc.spells(text, ast.tstart(st, tok), ast.tend(st, tok), spelled);
}

pub fn is_code[&s](st: &!s [int], tok: int, t: lc.Tok) -> [] bool {
    return ast.code_at(st, tok) == lc.code(t);
}

// ------------------------------------------------------------- imports ---

// How many segments the path of the import at token `keyword` has.
fn path_len[&s](st: &!s [int], keyword: int) -> [] int {
    var n = 1;
    while is_code(st, keyword + 2 * n, lc.Tok::Dot) {
        n = n + 1;
    }
    return n;
}

// The token after the path: `;`, or `as`.
fn after_path[&s](st: &!s [int], keyword: int) -> [] int {
    return keyword + 2 * path_len(st, keyword);
}

// The token that names the import: its `as`, or the path's last segment.
fn import_alias[&s](st: &!s [int], keyword: int) -> [] int {
    let after = after_path(st, keyword);
    if is_code(st, after, lc.Tok::As) {
        return after + 1;
    }
    return after - 1;
}

// The token that ends the import: its `;`.
fn import_end[&s](st: &!s [int], keyword: int) -> [] int {
    let after = after_path(st, keyword);
    if is_code(st, after, lc.Tok::As) {
        return after + 2;
    }
    return after;
}

// The module the import at token `keyword` names: the one whose path is the import's, or -1 if
// the program declares no such module.
fn imported_module[&s, &x](st: &!s [int], text: &x [byte], keyword: int) -> [] int {
    var m = 1;
    while m < st[11] {
        if ast.module_len(st, m) == path_len(st, keyword) {
            var k = 0;
            var equal = true;
            while k < ast.module_len(st, m) && equal {
                equal = ast.same(st, text, keyword + 1 + 2 * k, ast.module_first(st, m) + 2 * k);
                k = k + 1;
            }
            if equal {
                return m;
            }
        }
        m = m + 1;
    }
    return 0 - 1;
}

// Every import names a module the program declares, and no two bind the same qualifier.
pub fn check_imports[&s, &x](st: &!s [int], text: &x [byte]) -> [] int {
    var m = 0;
    while m < st[11] && ast.ok(st) {
        var n = 0;
        while n < st[12] && ast.ok(st) {
            if ast.import_module(st, n) == m {
                let keyword = ast.import_keyword(st, n);
                let from = ast.tstart(st, keyword);
                let to = ast.tend(st, import_end(st, keyword));
                if imported_module(st, text, keyword) < 0 {
                    ast.fail(st, rules.r_unknown_name(), from, to);
                } else {
                    var j = 0;
                    while j < n && ast.ok(st) {
                        if ast.import_module(st, j) == m {
                            if ast.same(st, text, import_alias(st, ast.import_keyword(st, j)), import_alias(st, keyword)) {
                                ast.fail(st, rules.r_duplicate_declaration(), from, to);
                            }
                        }
                        j = j + 1;
                    }
                }
            }
            n = n + 1;
        }
        m = m + 1;
    }
    return 0;
}

// The module a qualifier written in `unit_of` means: `unit_of` itself if there is no
// qualifier, the module an import in `unit_of` binds it to, else -1.
pub fn resolve_module[&s, &x](st: &!s [int], text: &x [byte], unit_of: int, qualifier: int) -> [] int {
    if qualifier < 0 {
        return unit_of;
    }
    var n = 0;
    while n < st[12] {
        if ast.import_module(st, n) == unit_of {
            let keyword = ast.import_keyword(st, n);
            if ast.same(st, text, import_alias(st, keyword), qualifier) {
                return imported_module(st, text, keyword);
            }
        }
        n = n + 1;
    }
    return 0 - 1;
}

// ------------------------------------------------- a declaration's `[...]` ---
//
// `[T, &r, U: val where r <= q]` is not kept in the tree, only where it starts (-1 if the
// declaration has none); these read it from the tokens, which are already checked.

// The token of the `k`th type parameter (`region` false) or region parameter (true), or -1.
fn nth_param[&s](st: &!s [int], dp: int, regions: bool, k: int) -> [] int {
    if dp < 0 {
        return 0 - 1;
    }
    var at = dp + 1;
    var seen = 0;
    while !is_code(st, at, lc.Tok::RBracket) && !is_code(st, at, lc.Tok::Where) {
        if is_code(st, at, lc.Tok::Amp) {
            if regions {
                if seen == k {
                    return at + 1;
                }
                seen = seen + 1;
            }
            at = at + 2;
        } else {
            let name = at;
            at = at + 1;
            if is_code(st, at, lc.Tok::Colon) {
                at = at + 2;
            }
            if !regions {
                if seen == k {
                    return name;
                }
                seen = seen + 1;
            }
        }
        if is_code(st, at, lc.Tok::Comma) {
            at = at + 1;
        }
    }
    return 0 - 1;
}

pub fn count_params[&s](st: &!s [int], dp: int, regions: bool) -> [] int {
    var n = 0;
    while nth_param(st, dp, regions, n) >= 0 {
        n = n + 1;
    }
    return n;
}

// Is the `k`th type parameter written `: val`?
pub fn param_bounded[&s](st: &!s [int], dp: int, k: int) -> [] bool {
    let name = nth_param(st, dp, false, k);
    return name >= 0 && is_code(st, name + 1, lc.Tok::Colon);
}

// The position of the first parameter spelled like `tok`, or -1.
pub fn param_index[&s, &x](st: &!s [int], text: &x [byte], dp: int, regions: bool, tok: int) -> [] int {
    var k = 0;
    while nth_param(st, dp, regions, k) >= 0 {
        if ast.same(st, text, nth_param(st, dp, regions, k), tok) {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

// The token of the inner region of the `k`th `where` pair, or -1; the outer is two on.
pub fn nth_outlive[&s](st: &!s [int], dp: int, k: int) -> [] int {
    if dp < 0 {
        return 0 - 1;
    }
    var at = dp + 1;
    while !is_code(st, at, lc.Tok::RBracket) && !is_code(st, at, lc.Tok::Where) {
        at = at + 1;
    }
    if !is_code(st, at, lc.Tok::Where) {
        return 0 - 1;
    }
    let first = at + 1 + 4 * k;
    if is_code(st, first, lc.Tok::Ident) && first + 2 < st[8] {
        return first;
    }
    return 0 - 1;
}

// A declaration's type parameters are distinct and shadow no built-in type.
fn check_generic_names[&s, &x](st: &!s [int], text: &x [byte], dp: int, from: int, to: int) -> [] int {
    var k = 0;
    while ast.ok(st) && nth_param(st, dp, false, k) >= 0 {
        let name = nth_param(st, dp, false, k);
        if is_word(st, text, name, "int") || is_word(st, text, name, "bool") {
            ast.fail(st, rules.r_builtin_redeclared(), from, to);
        }
        var j = 0;
        while j < k {
            if ast.same(st, text, nth_param(st, dp, false, j), name) {
                ast.fail(st, rules.r_duplicate_declaration(), from, to);
            }
            j = j + 1;
        }
        k = k + 1;
    }
    return 0;
}

// A declaration's region parameters are distinct, are not also type parameters, and are not
// `static`.
pub fn check_region_names[&s, &x](st: &!s [int], text: &x [byte], dp: int, from: int, to: int) -> [] int {
    var k = 0;
    while ast.ok(st) && nth_param(st, dp, true, k) >= 0 {
        let name = nth_param(st, dp, true, k);
        var j = 0;
        while j < k {
            if ast.same(st, text, nth_param(st, dp, true, j), name) {
                ast.fail(st, rules.r_duplicate_declaration(), from, to);
            }
            j = j + 1;
        }
        if param_index(st, text, dp, false, name) >= 0 {
            ast.fail(st, rules.r_region_mismatch(), from, to);
        }
        if is_word(st, text, name, "static") {
            ast.fail(st, rules.r_static_item(), from, to);
        }
        k = k + 1;
    }
    return 0;
}

// ------------------------------------------------------------- the defs ---

fn is_type_item[&s](st: &!s [int], item: int) -> [] bool {
    return ast.is_kind(st, item, kinds.NK::IStruct) || ast.is_kind(st, item, kinds.NK::IEnum);
}

fn prelude_is[&x](text: &x [byte], from: int, to: int, p: int) -> [] bool {
    return lc.spells(text, from, to, tables.prelude_name(p));
}

// What the name at token `name` means, written in a file at `edition`, looked for in
// `target`: -1, a prelude index, or `user_base() + item`. The latest edition the file can see
// wins, and of equals the last declared.
pub fn lookup[&s, &x](st: &!s [int], text: &x [byte], name: int, target: int, edition: int) -> [] int {
    let from = ast.tstart(st, name);
    let to = ast.tend(st, name);
    var best = 0 - 1;
    var since = 0;
    var p = 0;
    while p < tables.prelude_count() {
        if prelude_is(text, from, to, p) && tables.prelude_since(p) <= edition {
            if best < 0 || tables.prelude_since(p) >= since {
                best = p;
                since = tables.prelude_since(p);
            }
        }
        p = p + 1;
    }
    var it = st[15];
    while it >= 0 {
        if is_type_item(st, it) && ast.get(st, it, 13) == target && ast.same(st, text, ast.get(st, it, 4), name) {
            if best < 0 || 1 >= since {
                best = user_base() + it;
                since = 1;
            }
        }
        it = ast.next(st, it);
    }
    return best;
}

pub fn def_public[&s](st: &!s [int], def: int) -> [] bool {
    if def >= user_base() {
        return ast.get(st, def - user_base(), 5) != 0;
    }
    return tables.prelude_public(def);
}

fn def_arity[&s](st: &!s [int], def: int) -> [] int {
    if def >= user_base() {
        return count_params(st, ast.get(st, def - user_base(), 7), false);
    }
    return tables.prelude_arity(def);
}

// Is parameter `i` of the definition bounded `val`, as the declaration's own `val` implies?
fn def_bound_val[&s](st: &!s [int], def: int, i: int) -> [] bool {
    if def >= user_base() {
        let item = def - user_base();
        if ast.get(st, item, 6) == 1 {
            return true;
        }
        return param_bounded(st, ast.get(st, item, 7), i);
    }
    return tables.prelude_bound(def) / pow2(i) % 2 == 1;
}

fn pow2(n: int) -> [] int {
    var v = 1;
    var k = 0;
    while k < n {
        v = v * 2;
        k = k + 1;
    }
    return v;
}

// ---------------------------------------------------------------- modes ---
//
// The mode of a type is `res` if it is declared `res` or any member is, else `val`; a reference,
// a slice and a scalar are `val`, and a type parameter is `val` only if its declaration bounded
// it so. Written as a *function of the parameters* it needs no substitution: a type's `bits`
// say whether it is `res` whatever its parameters are (bit 0) and which parameters, if `res`,
// make it so (bit 1 + j for parameter j of the enclosing declaration). Naming a definition
// at arguments combines its bits with the arguments' own.

fn bit_of(bits: int, k: int) -> [] bool {
    return bits / pow2(k) % 2 == 1;
}

fn bits_or(a: int, b: int) -> [] int {
    var out = 0;
    var k = 0;
    while k < 12 {
        if bit_of(a, k) || bit_of(b, k) {
            out = out + pow2(k);
        }
        k = k + 1;
    }
    return out;
}

// The bits of the type declared by `item`. Until its members are resolved (slot 12) it has
// none, as in the Rust checker, which fills them in as it goes; a declared `res` is `res`
// regardless.
fn user_bits[&s](st: &!s [int], item: int, depth: int) -> [] int {
    if ast.get(st, item, 6) == 2 {
        return 1;
    }
    if ast.get(st, item, 12) != 1 {
        return 0;
    }
    var out = 0;
    var member = ast.get(st, item, 8);
    while member >= 0 {
        if ast.is_kind(st, item, kinds.NK::IStruct) {
            out = bits_or(out, mode_bits(st, ast.get(st, member, 5), depth + 1));
        } else {
            var payload = ast.get(st, member, 5);
            while payload >= 0 {
                out = bits_or(out, mode_bits(st, payload, depth + 1));
                payload = ast.next(st, payload);
            }
        }
        member = ast.next(st, member);
    }
    return out;
}

// The bits of the resolved type `ty`. A type that contains itself is refused later; the Rust
// checker recurses without end on one met first, and this answers `res` instead of looping.
fn mode_bits[&s](st: &!s [int], ty: int, depth: int) -> [] int {
    if depth > 64 {
        return 1;
    }
    if ast.is_kind(st, ty, kinds.NK::TTuple) {
        var out = 0;
        var at = ast.get(st, ty, 6);
        var left = ast.get(st, ty, 7);
        while left > 0 {
            out = bits_or(out, mode_bits(st, at, depth + 1));
            at = ast.next(st, at);
            left = left - 1;
        }
        return out;
    }
    if !ast.is_kind(st, ty, kinds.NK::TName) {
        return 0;
    }
    let class = ast.get(st, ty, 8);
    if class == 1 {
        return pow2(1 + ast.get(st, ty, 9));
    }
    if class != 2 && class != 3 {
        return 0;
    }
    var def = 0;
    if class == 2 {
        def = tables.prelude_res(ast.get(st, ty, 9));
    } else {
        def = user_bits(st, ast.get(st, ty, 9), depth);
    }
    var out = def % 2;
    var arg = ast.get(st, ty, 6);
    var i = 0;
    while i < ast.get(st, ty, 7) {
        if bit_of(def, 1 + i) {
            out = bits_or(out, mode_bits(st, arg, depth + 1));
        }
        arg = ast.next(st, arg);
        i = i + 1;
    }
    return out;
}

// Is a type with these bits `res`, written inside the declaration whose `[...]` starts at
// `scope`? Its parameters are `res` unless bounded `val`.
fn is_res[&s](st: &!s [int], bits: int, scope: int) -> [] bool {
    if bit_of(bits, 0) {
        return true;
    }
    var j = 0;
    while j < 11 {
        if bit_of(bits, 1 + j) && !param_bounded(st, scope, j) {
            return true;
        }
        j = j + 1;
    }
    return false;
}

// Is the scope a type is narrowed to well formed (`parse_scope`): library names, each
// letters, digits and `_.+-`, separated by commas, none empty and none twice?
fn scope_valid[&s, &x](st: &!s [int], text: &x [byte], lit: int) -> [] bool {
    let from = ast.tstart(st, lit) + 1;
    let to = ast.tend(st, lit) - 1;
    if from == to {
        return true;
    }
    var name = from;
    var at = from;
    while at <= to {
        var c = 0 - 1;
        if at < to {
            c = lc.at(text, at);
        }
        if at == to || c == ',' {
            if at == name {
                return false;
            }
            var other = from;
            while other < name {
                // The names before this one: each is compared whole.
                var end = other;
                while end < to && lc.at(text, end) != ',' {
                    end = end + 1;
                }
                if end - other == at - name && lc.spells(text, other, end, text[name..at]) {
                    return false;
                }
                other = end + 1;
            }
            name = at + 1;
        } else if !(lc.is_digit(c) || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' || c == '.' || c == '+' || c == '-') {
            return false;
        }
        at = at + 1;
    }
    return true;
}

// -------------------------------------------------------- written types ---

// Resolve the type node `id`, written in a file at `edition` inside `module`, in the scope of
// the declaration whose `[...]` starts at token `scope` (-1 for none): its type parameters, and
// its region parameters if `regions_ok`. `unsized_ok`: a `[T]` may stand here.
pub fn resolve[&s, &x](st: &!s [int], text: &x [byte], id: int, unit_of: int, edition: int, scope: int, regions_ok: bool, unsized_ok: bool) -> [] int {
    if !ast.ok(st) || id < 0 {
        return 0;
    }
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    if ast.is_kind(st, id, kinds.NK::TRef) {
        let reg = ast.get(st, id, 5);
        if is_word(st, text, reg, "static") {
            if ast.get(st, id, 4) != 0 {
                ast.fail(st, rules.r_static_item(), from, to);
                return 0;
            }
            return resolve(st, text, ast.get(st, id, 6), unit_of, edition, scope, regions_ok, true);
        }
        if !regions_ok || param_index(st, text, scope, true, reg) < 0 {
            ast.fail(st, rules.r_region_not_in_scope(), from, to);
            return 0;
        }
        return resolve(st, text, ast.get(st, id, 6), unit_of, edition, scope, regions_ok, true);
    }
    if ast.is_kind(st, id, kinds.NK::TLit) {
        return 0;
    }
    if ast.is_kind(st, id, kinds.NK::TSlice) {
        if !unsized_ok {
            ast.fail(st, rules.r_unsized_type(), from, to);
            return 0;
        }
        return resolve(st, text, ast.get(st, id, 6), unit_of, edition, scope, regions_ok, false);
    }
    if ast.is_kind(st, id, kinds.NK::TTuple) {
        if ast.get(st, id, 7) < 2 {
            ast.fail(st, rules.r_pattern_shape(), from, to);
            return 0;
        }
        return resolve_list(st, text, ast.get(st, id, 6), ast.get(st, id, 7), unit_of, edition, scope, regions_ok, false);
    }
    if ast.is_kind(st, id, kinds.NK::TFn) {
        resolve_list(st, text, ast.get(st, id, 5), ast.get(st, id, 6), unit_of, edition, scope, regions_ok, false);
        return resolve(st, text, ast.get(st, id, 7), unit_of, edition, scope, regions_ok, false);
    }
    return resolve_name(st, text, id, unit_of, edition, scope, regions_ok);
}

fn resolve_list[&s, &x](st: &!s [int], text: &x [byte], head: int, n: int, unit_of: int, edition: int, scope: int, regions_ok: bool, unsized_ok: bool) -> [] int {
    var at = head;
    var left = n;
    while left > 0 && ast.ok(st) {
        resolve(st, text, at, unit_of, edition, scope, regions_ok, unsized_ok);
        at = ast.next(st, at);
        left = left - 1;
    }
    return 0;
}

fn annotate[&s](st: &!s [int], id: int, class: int, index: int, scalar: int) -> [] int {
    ast.put(st, id, 8, class);
    ast.put(st, id, 9, index);
    return ast.put(st, id, 10, scalar);
}

// Which scalar the name at token `name` is, in a file at `edition`: 1 `int`, 2 `byte`,
// 3 `float`, 4 `f32` (from edition 6), 5 `bool`; 0 for none.
fn scalar_of[&s, &x](st: &!s [int], text: &x [byte], name: int, edition: int) -> [] int {
    if is_word(st, text, name, "int") {
        return 1;
    }
    if is_word(st, text, name, "byte") {
        return 2;
    }
    if is_word(st, text, name, "float") {
        return 3;
    }
    if is_word(st, text, name, "f32") && edition >= 6 {
        return 4;
    }
    if is_word(st, text, name, "bool") {
        return 5;
    }
    return 0;
}

fn is_scalar_type[&s](st: &!s [int], id: int) -> [] bool {
    return ast.is_kind(st, id, kinds.NK::TName) && ast.get(st, id, 8) == 0;
}

fn resolve_name[&s, &x](st: &!s [int], text: &x [byte], id: int, unit_of: int, edition: int, scope: int, regions_ok: bool) -> [] int {
    let from = ast.nstart(st, id);
    let to = ast.nend(st, id);
    let qualifier = ast.get(st, id, 4);
    let name = ast.get(st, id, 5);
    let nargs = ast.get(st, id, 7);
    let target = resolve_module(st, text, unit_of, qualifier);
    if target < 0 {
        ast.fail(st, rules.r_module_not_imported(), from, to);
        return 0;
    }
    let found = lookup(st, text, name, target, edition);
    let boxed = found == tables.prelude_box();
    resolve_list(st, text, ast.get(st, id, 6), nargs, unit_of, edition, scope, regions_ok, boxed);
    if !ast.ok(st) {
        return 0;
    }
    let g = param_index(st, text, scope, false, name);
    if g >= 0 {
        if nargs > 0 {
            ast.fail(st, rules.r_type_args_not_taken(), from, to);
            return 0;
        }
        return annotate(st, id, 1, g, 0);
    }
    let scalar = scalar_of(st, text, name, edition);
    if scalar > 0 {
        if nargs != 0 {
            ast.fail(st, rules.r_arity_mismatch(), from, to);
            return 0;
        }
        return annotate(st, id, 0, 0, scalar);
    }
    if found < 0 {
        ast.fail(st, rules.r_unknown_name(), from, to);
        return 0;
    }
    if target != unit_of && !def_public(st, found) {
        ast.fail(st, rules.r_not_public(), from, to);
        return 0;
    }
    // `docs/mode-polymorphism.md` section 3: a parameter bounded `val` takes no `res` argument.
    var arg = ast.get(st, id, 6);
    var i = 0;
    while i < nargs {
        if def_bound_val(st, found, i) && is_res(st, mode_bits(st, arg, 0), scope) {
            ast.fail(st, rules.r_mode_bound_violated(), from, to);
            return 0;
        }
        arg = ast.next(st, arg);
        i = i + 1;
    }
    // The scope an `Ffi` is narrowed to has to be well formed.
    if found == tables.prelude_ffi() && nargs >= 1 && ast.is_kind(st, ast.get(st, id, 6), kinds.NK::TLit) {
        if !scope_valid(st, text, ast.get(st, ast.get(st, id, 6), 4)) {
            ast.fail(st, rules.r_foreign_scope(), from, to);
            return 0;
        }
    }
    if nargs != def_arity(st, found) {
        ast.fail(st, rules.r_arity_mismatch(), from, to);
        return 0;
    }
    if found >= user_base() {
        return annotate(st, id, 3, found - user_base(), 0);
    }
    return annotate(st, id, 2, found, 0);
}

// -------------------------------------------------------- type declarations ---

// Is the name at `tok` one a file at `edition` may not redeclare as a type?
fn builtin_type[&s, &x](st: &!s [int], text: &x [byte], tok: int, edition: int) -> [] bool {
    if is_word(st, text, tok, "int") || is_word(st, text, tok, "bool") {
        return true;
    }
    if is_word(st, text, tok, "f32") && edition >= 6 {
        return true;
    }
    var p = 0;
    while p < tables.prelude_count() {
        if prelude_is(text, ast.tstart(st, tok), ast.tend(st, tok), p) && tables.prelude_since(p) <= edition {
            return true;
        }
        p = p + 1;
    }
    return false;
}

// Does a type reach `target` through its members, `Box` being the one way back that is finite?
fn reaches_through[&s](st: &!s [int], ty: int, target: int, stamp: int) -> [] bool {
    if ast.is_kind(st, ty, kinds.NK::TTuple) {
        var at = ast.get(st, ty, 6);
        var left = ast.get(st, ty, 7);
        while left > 0 {
            if reaches_through(st, at, target, stamp) {
                return true;
            }
            at = ast.next(st, at);
            left = left - 1;
        }
        return false;
    }
    if !ast.is_kind(st, ty, kinds.NK::TName) {
        return false;
    }
    let class = ast.get(st, ty, 8);
    if class != 2 && class != 3 {
        return false;
    }
    let index = ast.get(st, ty, 9);
    if class == 2 && index == tables.prelude_box() {
        return false;
    }
    if class == 3 {
        if index == target || reaches(st, index, target, stamp) {
            return true;
        }
    }
    var at = ast.get(st, ty, 6);
    var left = ast.get(st, ty, 7);
    while left > 0 {
        if reaches_through(st, at, target, stamp) {
            return true;
        }
        at = ast.next(st, at);
        left = left - 1;
    }
    return false;
}

// Does the type declared by `item` hold `target`, directly or through what it holds? Slot 15
// of an item marks the walk it has been seen in, so each is entered once.
fn reaches[&s](st: &!s [int], item: int, target: int, stamp: int) -> [] bool {
    if ast.get(st, item, 15) == stamp {
        return false;
    }
    ast.put(st, item, 15, stamp);
    var member = ast.get(st, item, 8);
    while member >= 0 {
        if ast.is_kind(st, item, kinds.NK::IStruct) {
            if reaches_through(st, ast.get(st, member, 5), target, stamp) {
                return true;
            }
        } else {
            var payload = ast.get(st, member, 5);
            while payload >= 0 {
                if reaches_through(st, payload, target, stamp) {
                    return true;
                }
                payload = ast.next(st, payload);
            }
        }
        member = ast.next(st, member);
    }
    return false;
}

pub fn collect_types[&s, &x](st: &!s [int], text: &x [byte]) -> [] int {
    // The names, so a member may mention a type declared later in the file.
    var it = st[15];
    while it >= 0 && ast.ok(st) {
        if is_type_item(st, it) {
            let from = ast.nstart(st, it);
            let to = ast.nend(st, it);
            let name = ast.get(st, it, 4);
            let unit_of = ast.get(st, it, 13);
            let edition = ast.get(st, it, 14);
            if builtin_type(st, text, name, edition) {
                ast.fail(st, rules.r_builtin_redeclared(), from, to);
            }
            var other = st[15];
            while other != it && ast.ok(st) {
                if is_type_item(st, other) && ast.get(st, other, 13) == unit_of && ast.same(st, text, ast.get(st, other, 4), name) {
                    ast.fail(st, rules.r_duplicate_declaration(), from, to);
                }
                other = ast.next(st, other);
            }
            check_generic_names(st, text, ast.get(st, it, 7), from, to);
        }
        it = ast.next(st, it);
    }
    // Their members.
    it = st[15];
    while it >= 0 && ast.ok(st) {
        if ast.is_kind(st, it, kinds.NK::IStruct) {
            collect_fields(st, text, it);
        }
        if ast.is_kind(st, it, kinds.NK::IEnum) {
            collect_variants(st, text, it);
        }
        it = ast.next(st, it);
    }
    // A type must have a finite size.
    var stamp = 0;
    it = st[15];
    while it >= 0 && ast.ok(st) {
        if is_type_item(st, it) {
            stamp = stamp + 1;
            if reaches(st, it, it, stamp) {
                ast.fail(st, rules.r_infinite_type(), ast.nstart(st, it), ast.nend(st, it));
            }
        }
        it = ast.next(st, it);
    }
    // A declared `val` promises something about every member: none may be `res`, whatever the
    // parameters are.
    it = st[15];
    while it >= 0 && ast.ok(st) {
        if is_type_item(st, it) && ast.get(st, it, 6) == 1 && val_holds_res(st, it) {
            ast.fail(st, rules.r_mode_bound_violated(), ast.nstart(st, it), ast.nend(st, it));
        }
        it = ast.next(st, it);
    }
    return 0;
}

// Does the type declared by `item` hold a member that is `res` whatever its parameters are?
fn val_holds_res[&s](st: &!s [int], item: int) -> [] bool {
    var member = ast.get(st, item, 8);
    while member >= 0 {
        if ast.is_kind(st, item, kinds.NK::IStruct) {
            if bit_of(mode_bits(st, ast.get(st, member, 5), 0), 0) {
                return true;
            }
        } else {
            var payload = ast.get(st, member, 5);
            while payload >= 0 {
                if bit_of(mode_bits(st, payload, 0), 0) {
                    return true;
                }
                payload = ast.next(st, payload);
            }
        }
        member = ast.next(st, member);
    }
    return false;
}

fn collect_fields[&s, &x](st: &!s [int], text: &x [byte], it: int) -> [] int {
    let from = ast.nstart(st, it);
    let to = ast.nend(st, it);
    var field = ast.get(st, it, 8);
    while field >= 0 && ast.ok(st) {
        var other = ast.get(st, it, 8);
        while other != field {
            if ast.same(st, text, ast.get(st, other, 4), ast.get(st, field, 4)) {
                ast.fail(st, rules.r_duplicate_declaration(), from, to);
            }
            other = ast.next(st, other);
        }
        resolve(st, text, ast.get(st, field, 5), ast.get(st, it, 13), ast.get(st, it, 14), ast.get(st, it, 7), false, false);
        field = ast.next(st, field);
    }
    ast.put(st, it, 12, 1);
    return 0;
}

fn collect_variants[&s, &x](st: &!s [int], text: &x [byte], it: int) -> [] int {
    let from = ast.nstart(st, it);
    let to = ast.nend(st, it);
    if ast.get(st, it, 8) < 0 {
        ast.fail(st, rules.r_enum_has_no_variants(), from, to);
        return 0;
    }
    var variant = ast.get(st, it, 8);
    while variant >= 0 && ast.ok(st) {
        var other = ast.get(st, it, 8);
        while other != variant {
            if ast.same(st, text, ast.get(st, other, 4), ast.get(st, variant, 4)) {
                ast.fail(st, rules.r_duplicate_declaration(), from, to);
            }
            other = ast.next(st, other);
        }
        resolve_list(st, text, ast.get(st, variant, 5), ast.get(st, variant, 6), ast.get(st, it, 13), ast.get(st, it, 14), ast.get(st, it, 7), false, false);
        variant = ast.next(st, variant);
    }
    ast.put(st, it, 12, 1);
    return 0;
}

// ----------------------------------------------------- statics, signatures ---

pub fn check_statics[&s, &x](st: &!s [int], text: &x [byte]) -> [] int {
    var it = st[15];
    while it >= 0 && ast.ok(st) {
        if ast.is_kind(st, it, kinds.NK::IStatic) {
            let from = ast.nstart(st, it);
            let to = ast.nend(st, it);
            let name = ast.get(st, it, 4);
            let unit_of = ast.get(st, it, 13);
            var other = st[15];
            while other != it && ast.ok(st) {
                if ast.is_kind(st, other, kinds.NK::IStatic) && ast.get(st, other, 13) == unit_of && ast.same(st, text, ast.get(st, other, 4), name) {
                    ast.fail(st, rules.r_duplicate_declaration(), from, to);
                }
                other = ast.next(st, other);
            }
            other = st[15];
            while other >= 0 && ast.ok(st) {
                if ast.is_kind(st, other, kinds.NK::IFn) || ast.is_kind(st, other, kinds.NK::IExtern) {
                    if ast.get(st, other, 13) == unit_of && ast.same(st, text, ast.get(st, other, 4), name) {
                        ast.fail(st, rules.r_duplicate_declaration(), from, to);
                    }
                }
                other = ast.next(st, other);
            }
            let ty = ast.get(st, it, 6);
            resolve(st, text, ty, unit_of, ast.get(st, it, 14), 0 - 1, false, true);
            if ast.ok(st) && !static_slice(st, ty) {
                ast.fail(st, rules.r_static_item(), from, to);
            }
        }
        it = ast.next(st, it);
    }
    return 0;
}

// A `static` is a slice of `int`, `byte`, `bool` or `float`.
fn static_slice[&s](st: &!s [int], ty: int) -> [] bool {
    if !ast.is_kind(st, ty, kinds.NK::TSlice) {
        return false;
    }
    let element = ast.get(st, ty, 6);
    if !is_scalar_type(st, element) {
        return false;
    }
    return ast.get(st, element, 10) != 4;
}

// The first type in `id` that is private to `module`, as `private_type_in` finds it.
fn private_in[&s](st: &!s [int], id: int, unit_of: int) -> [] bool {
    if ast.is_kind(st, id, kinds.NK::TRef) || ast.is_kind(st, id, kinds.NK::TSlice) {
        return private_in(st, ast.get(st, id, 6), unit_of);
    }
    if ast.is_kind(st, id, kinds.NK::TTuple) {
        return private_in_list(st, ast.get(st, id, 6), ast.get(st, id, 7), unit_of);
    }
    if ast.is_kind(st, id, kinds.NK::TName) {
        if ast.get(st, id, 8) == 3 {
            let item = ast.get(st, id, 9);
            if ast.get(st, item, 13) == unit_of && ast.get(st, item, 5) == 0 {
                return true;
            }
        }
        if ast.get(st, id, 8) == 2 || ast.get(st, id, 8) == 3 {
            return private_in_list(st, ast.get(st, id, 6), ast.get(st, id, 7), unit_of);
        }
    }
    return false;
}

fn private_in_list[&s](st: &!s [int], head: int, n: int, unit_of: int) -> [] bool {
    var at = head;
    var left = n;
    while left > 0 {
        if private_in(st, at, unit_of) {
            return true;
        }
        at = ast.next(st, at);
        left = left - 1;
    }
    return false;
}

// Is the name at `tok` a builtin of any edition?
pub fn builtin_named[&s, &x](st: &!s [int], text: &x [byte], tok: int) -> [] bool {
    var b = 0;
    while b < tables.builtin_count() {
        if lc.spells(text, ast.tstart(st, tok), ast.tend(st, tok), tables.builtin_name(b)) {
            return true;
        }
        b = b + 1;
    }
    return false;
}

// Is the name at `tok` a builtin a file at `edition` can see?
pub fn builtin_name[&s, &x](st: &!s [int], text: &x [byte], tok: int, edition: int) -> [] bool {
    var b = 0;
    while b < tables.builtin_count() {
        if lc.spells(text, ast.tstart(st, tok), ast.tend(st, tok), tables.builtin_name(b)) && tables.builtin_since(b) <= edition {
            return true;
        }
        b = b + 1;
    }
    return false;
}

pub fn check_signatures[&s, &x](st: &!s [int], text: &x [byte]) -> [] int {
    var it = st[15];
    while it >= 0 && ast.ok(st) {
        if ast.is_kind(st, it, kinds.NK::IFn) {
            check_signature(st, text, it);
        }
        it = ast.next(st, it);
    }
    return 0;
}

fn check_signature[&s, &x](st: &!s [int], text: &x [byte], it: int) -> [] int {
    let from = ast.nstart(st, it);
    let to = ast.nend(st, it);
    let name = ast.get(st, it, 4);
    let unit_of = ast.get(st, it, 13);
    let edition = ast.get(st, it, 14);
    let dp = ast.get(st, it, 6);
    if builtin_name(st, text, name, edition) {
        ast.fail(st, rules.r_builtin_redeclared(), from, to);
        return 0;
    }
    var other = st[15];
    while other != it && ast.ok(st) {
        if ast.is_kind(st, other, kinds.NK::IFn) && ast.get(st, other, 13) == unit_of && ast.same(st, text, ast.get(st, other, 4), name) {
            ast.fail(st, rules.r_duplicate_declaration(), from, to);
        }
        other = ast.next(st, other);
    }
    // A foreign declaration and a written function are two answers to one call.
    other = st[15];
    while other >= 0 && ast.ok(st) {
        if ast.is_kind(st, other, kinds.NK::IExtern) && ast.get(st, other, 13) == unit_of && ast.same(st, text, ast.get(st, other, 4), name) {
            ast.fail(st, rules.r_foreign_declaration(), from, to);
        }
        other = ast.next(st, other);
    }
    check_generic_names(st, text, dp, from, to);
    check_region_names(st, text, dp, from, to);
    // `where a <= b` names two region parameters.
    var k = 0;
    while ast.ok(st) && nth_outlive(st, dp, k) >= 0 {
        let inner = nth_outlive(st, dp, k);
        if param_index(st, text, dp, true, inner) < 0 || param_index(st, text, dp, true, inner + 2) < 0 {
            ast.fail(st, rules.r_region_mismatch(), from, to);
        }
        k = k + 1;
    }
    var param = ast.get(st, it, 7);
    while param >= 0 && ast.ok(st) {
        var earlier = ast.get(st, it, 7);
        while earlier != param {
            if ast.same(st, text, ast.get(st, earlier, 4), ast.get(st, param, 4)) {
                ast.fail(st, rules.r_duplicate_declaration(), from, to);
            }
            earlier = ast.next(st, earlier);
        }
        resolve(st, text, ast.get(st, param, 5), unit_of, edition, dp, true, false);
        param = ast.next(st, param);
    }
    resolve(st, text, ast.get(st, it, 10), unit_of, edition, dp, true, false);
    if ast.ok(st) && ast.get(st, it, 5) != 0 {
        var p = ast.get(st, it, 7);
        var hidden = false;
        while p >= 0 {
            if private_in(st, ast.get(st, p, 5), unit_of) {
                hidden = true;
            }
            p = ast.next(st, p);
        }
        if hidden || private_in(st, ast.get(st, it, 10), unit_of) {
            ast.fail(st, rules.r_not_public(), from, to);
        }
    }
    return 0;
}
