module selfhost.effects;

// effects.cho -- what a function performs, against the row it declares.
//
// A function's row lists the effects it may have, and Rust holds it exact (`docs/linearity-and-
// effects.md` section 7.3): what a body performs, which is what the builtins it calls perform and
// what the rows of the functions it calls say, must be the row, in both directions. A label in the
// body and not the row is `effect-not-declared`; a label in the row and not the body is
// `effect-declared-not-performed`. Both are refused at the function.
//
// A set of labels is an integer here, bit i for the label `builtins.effect_name(i)`. A label that
// carries an argument (`fs_read("/tmp")`), or whose name no builtin performs, is not one of those;
// a row with either is reported in the two high bits and left to the callers to be careful about.

import selfhost.ast;
import selfhost.kinds;
import selfhost.narrowing;
import selfhost.rules;
import selfhost.builtins;
import selfhost.lexcore as lc;
import selfhost.pass1;
import selfhost.tables;
import std.bytes;

pub fn two_to[&s](st: &!s [int], n: int) -> [] int {
    var v = 1;
    var i = 0;
    while i < n {
        v = v * 2;
        i = i + 1;
    }
    return v;
}

// The bit of the high flag for a label with an argument, and for one no builtin performs.
// The labels the masks keep: the ones a builtin performs, then `conc`, which `spawn` and `join` perform and which is no
// builtin's.
pub fn label_count() -> [] int {
    return builtins.effect_count() + 1;
}

pub fn conc_bit() -> [] int {
    return builtins.effect_count();
}

pub fn arg_flag[&s](st: &!s [int]) -> [] int {
    return two_to(st, 60);
}

pub fn unknown_flag[&s](st: &!s [int]) -> [] int {
    return two_to(st, 61);
}

// Does `mask` have bit `n` set?
fn has[&s](st: &!s [int], mask: int, n: int) -> [] bool {
    return mask / two_to(st, n) % 2 == 1;
}

// The labels of the row of function `fn_item`: the mask of those a builtin performs, plus the
// flags for an argument and for an unknown name. `[` is the token the item keeps for it.
pub fn row_mask[&s, &x](st: &!s [int], text: &x [byte], fn_item: int) -> [] int {
    var p = ast.get(st, fn_item, 9) + 1;
    var mask = 0;
    while !pass1.is_code(st, p, lc.Tok::RBracket) {
        var found = 0 - 1;
        var i = 0;
        while i < builtins.effect_count() {
            if lc.spells(text, ast.tstart(st, p), ast.tend(st, p), builtins.effect_name(i)) {
                found = i;
            }
            i = i + 1;
        }
        if found < 0 && lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "conc") {
            found = conc_bit();
        }
        p = p + 1;
        if pass1.is_code(st, p, lc.Tok::LParen) {
            while !pass1.is_code(st, p, lc.Tok::RParen) {
                p = p + 1;
            }
            p = p + 1;
            if !has(st, mask, 60) {
                mask = mask + arg_flag(st);
            }
        } else if found < 0 {
            if !has(st, mask, 61) {
                mask = mask + unknown_flag(st);
            }
        } else if !has(st, mask, found) {
            mask = mask + two_to(st, found);
        }
        if pass1.is_code(st, p, lc.Tok::Comma) {
            p = p + 1;
        }
    }
    return mask;
}

// A row that is only labels a builtin performs: nothing with an argument, nothing unknown.
pub fn plain_row[&s](st: &!s [int], mask: int) -> [] bool {
    return mask < arg_flag(st);
}

// The builtin `b` performs its labels: added to the set `st[54]` the function being checked
// keeps. A label that carries an argument is not one the checker follows: answers false.
pub fn perform[&s](st: &!s [int], b: int) -> [] bool {
    var k = 0;
    while k < builtins.builtin_effect_count(b) {
        let code = builtins.builtin_effect(b, k);
        if code % 2 == 1 {
            return false;
        }
        if !has(st, st[54], code / 2) {
            st[54] = st[54] + two_to(st, code / 2);
        }
        k = k + 1;
    }
    return true;
}

// The function performs the label called `name`, which some builtin performs.
pub fn perform_named[&s](st: &!s [int], name: &static [byte]) -> [] int {
    if bytes.equal(name, "conc") && !has(st, st[54], conc_bit()) {
        st[54] = st[54] + two_to(st, conc_bit());
    }
    var n = 0;
    while n < builtins.effect_count() {
        if bytes.equal(builtins.effect_name(n), name) && !has(st, st[54], n) {
            st[54] = st[54] + two_to(st, n);
        }
        n = n + 1;
    }
    return 0;
}

// The function performed something the masks do not keep: a label with an argument (a path, a program, an address, a
// library), or what a function value does. Bit 61 of the set says so, and the refusal that the row says more than the body
// does is not made for such a function.
pub fn mark_untracked[&s](st: &!s [int]) -> [] int {
    if !has(st, st[54], 61) {
        st[54] = st[54] + two_to(st, 61);
    }
    return 0;
}

pub fn untracked[&s](st: &!s [int]) -> [] bool {
    return has(st, st[54], 61);
}

// The function performed a label with an argument, which is untracked too (bit 62): an empty row declares none.
pub fn mark_arg[&s](st: &!s [int]) -> [] int {
    mark_untracked(st);
    if !has(st, st[54], 62) {
        st[54] = st[54] + two_to(st, 62);
    }
    return 0;
}

pub fn arg_performed[&s](st: &!s [int]) -> [] bool {
    return has(st, st[54], 62);
}

// The labels a call to a function with the row `mask` performs, added to the set.
pub fn perform_row[&s](st: &!s [int], mask: int) -> [] int {
    if has(st, mask, 60) {
        mark_arg(st);
    }
    var n = 0;
    while n < label_count() {
        if has(st, mask, n) && !has(st, st[54], n) {
            st[54] = st[54] + two_to(st, n);
        }
        n = n + 1;
    }
    return 0;
}

// The labels owning a value of the prelude type `index` stands for: what `discharged_by` says of it.
// A type that carries a literal discharges labels with an argument too, which are not in the mask.
pub fn discharged[&s](st: &!s [int], index: int) -> [] int {
    let labels = tables.prelude_labels(index);
    var mask = 0;
    var i = 0;
    while i < len(labels) {
        var j = i;
        while j < len(labels) && int_of(labels[j]) != 32 {
            j = j + 1;
        }
        if j > i {
            let last = int_of(labels[j - 1]);
            if last != '*' && last != '=' {
                var n = 0;
                while n < builtins.effect_count() {
                    if lc.spells(labels, i, j, builtins.effect_name(n)) && !has(st, mask, n) {
                        mask = mask + two_to(st, n);
                    }
                    n = n + 1;
                }
            }
        }
        i = j + 1;
    }
    return mask;
}

// Does a function that owns `Fs("/tmp")` or `Exec("/bin")` discharge the path or program in token `lit`, which a callee
// performs (`family` 0 reads and writes of `Fs`, 1 `Exec`)? A `World` discharges every one; a borrowed capability none
// (`discharged_by`). What is not a literal of a prelude type is not judged: true.
fn owner_covers[&s, &x](st: &!s [int], text: &x [byte], caller: int, family: int, lit: int) -> [] bool {
    var owned = ast.get(st, caller, 7);
    while owned >= 0 {
        let ty = ast.get(st, owned, 5);
        if ast.is_kind(st, ty, kinds.NK::TName) && ast.get(st, ty, 8) == 2 {
            let index = ast.get(st, ty, 9);
            if index == 0 {
                return true;
            }
            if index == tables.prelude_fs() && family == 0 || index == tables.prelude_exec() && family == 1 {
                let arg = ast.get(st, ty, 6);
                if ast.get(st, ty, 7) != 1 || !ast.is_kind(st, arg, kinds.NK::TLit) {
                    return true;
                }
                if narrowing.path_inside(st, text, ast.get(st, arg, 4), lit) {
                    return true;
                }
            }
        }
        owned = ast.next(st, owned);
    }
    return false;
}

// A call of `callee` performs a path or a program that no capability `caller` owns reaches, and `caller` declares no label
// with an argument to say so: `Label::covers` compares `fs_read("/tmpevil")` with what an `Fs("/tmp")` discharges at a
// separator, and a label with an argument never covers a plain one. Only the rows of functions are read here, so what
// a builtin performs with a borrowed capability is not judged.
pub fn outside_owned[&s, &x](st: &!s [int], text: &x [byte], caller: int, callee: int) -> [] bool {
    if caller < 0 || has(st, row_mask(st, text, caller), 60) {
        return false;
    }
    var p = ast.get(st, callee, 9) + 1;
    while !pass1.is_code(st, p, lc.Tok::RBracket) {
        var family = 0 - 1;
        if lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "fs_read") || lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "fs_write") {
            family = 0;
        } else if lc.spells(text, ast.tstart(st, p), ast.tend(st, p), "exec") {
            family = 1;
        }
        p = p + 1;
        if pass1.is_code(st, p, lc.Tok::LParen) {
            if family >= 0 && pass1.is_code(st, p + 1, lc.Tok::Str) && !owner_covers(st, text, caller, family, p + 1) {
                return true;
            }
            while !pass1.is_code(st, p, lc.Tok::RParen) {
                p = p + 1;
            }
            p = p + 1;
        }
        if pass1.is_code(st, p, lc.Tok::Comma) {
            p = p + 1;
        }
    }
    return false;
}

// What a call of `callee` performs, added to the set, and the refusal when that is outside what the function being checked
// (`st[64]`) owns and declares.
pub fn perform_call[&s, &x](st: &!s [int], text: &x [byte], callee: int) -> [] int {
    perform_row(st, row_mask(st, text, callee));
    if outside_owned(st, text, st[64], callee) {
        ast.fail(st, rules.r_effect_not_declared(), ast.nstart(st, st[64]), ast.nend(st, st[64]));
    }
    return 0;
}

// The labels of two masks.
pub fn union[&s](st: &!s [int], a: int, b: int) -> [] int {
    var mask = a;
    var n = 0;
    while n < label_count() {
        if has(st, b, n) && !has(st, mask, n) {
            mask = mask + two_to(st, n);
        }
        n = n + 1;
    }
    return mask;
}

// The row is exact: what the body performed against what `fn_item` declares. The first
// disagreement is a refusal at the function, `effect-not-declared` when the body does more than the
// row says and `effect-declared-not-performed` when the row says more. `both` is false while code is
// written: not every builtin records what it performs there yet, so a row that says more may be right,
// and only the refusal that cannot be wrong is made.
pub fn check[&s, &x](st: &!s [int], text: &x [byte], fn_item: int, from: int, to: int, authority: int, both: bool) -> [] int {
    let declared = row_mask(st, text, fn_item);
    // A function that owns a capability needs no label for what the capability allows (section 8.2
    // of the same document): what the parameters discharge is not performed as far as the row goes.
    var performed = 0;
    var m = 0;
    while m < label_count() {
        if has(st, st[54], m) && !has(st, authority, m) {
            performed = performed + two_to(st, m);
        }
        m = m + 1;
    }
    // A plain label performed and not in the row is refused whatever else the row carries: a label with an argument
    // covers no plain label (`Label::covers`).
    var n = 0;
    while n < label_count() {
        if has(st, performed, n) && !has(st, declared, n) {
            ast.fail(st, rules.r_effect_not_declared(), from, to);
            return 0;
        }
        n = n + 1;
    }
    if has(st, declared, 60) {
        if !both {
            return 0;
        }
        // A label with an argument is a different label from the plain one a builtin performs, and
        // from every other: nothing performed can be compared with it yet.
        if performed != 0 {
            ast.fail(st, rules.r_skip(), from, to);
            return 0;
        }
        ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
        return 0;
    }
    if !both {
        return 0;
    }
    n = 0;
    while n < label_count() {
        if has(st, declared, n) && !has(st, performed, n) {
            ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
            return 0;
        }
        n = n + 1;
    }
    if has(st, declared, 61) {
        ast.fail(st, rules.r_effect_declared_not_performed(), from, to);
    }
    return 0;
}
