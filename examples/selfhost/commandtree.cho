fn skill_text_7[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# The same tree as data, for an agent to read\n");
    b = buffer.append(heap, b, "cancho print --output json app.cho\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "**See also:** `cancho ids`, `cancho ingest`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## `cancho ingest`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "the missing half of `print`: a JSON unit in, canonical .cho text out (docs/structured-ingest.md) -- an agent writes the data form and the compiler checks it against the same vocabulary the encoder writes, refusing with a rule like any other (ingest-json, ingest-node, ingest-arity)\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Options\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "- `--output` (enum[json]) — a refusal as data: rule, message, position (docs/structured-ingest.md)\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Arguments\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "- `file` (string, required) — exactly one .json file\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Examples\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# Render a JSON unit as canonical text\n");
    b = buffer.append(heap, b, "cancho ingest unit.json\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# The loop an agent closes with it\n");
    b = buffer.append(heap, b, "cancho print --output json app.cho > unit.json && cancho ingest unit.json\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "**See also:** `cancho print`, `cancho check`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## `cancho agent-guidelines`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "emit AGENTS.md: how to write cancho in one page rather than in 42 documents. Every checked code block in it is run by the test suite, so a guideline that stops being true is a red build\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Examples\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    return b;
}

fn skill_text_8[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "# Read the rules\n");
    b = buffer.append(heap, b, "cancho agent-guidelines\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# Capture into a repo\n");
    b = buffer.append(heap, b, "cancho agent-guidelines > AGENTS.md\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "**See also:** `cancho skill`, `cancho introspect`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## `cancho vcs`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "the content-addressed package store: publish, log, resolve, lock, and fetch declarations (docs/package-system.md)\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Arguments\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "- `subcommand` (enum[publish|log|resolve|lock|fetch], required) — what to do\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Examples\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# Publish every declaration in a file\n");
    b = buffer.append(heap, b, "cancho vcs publish --store .cancho-vcs app.cho\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# List what a store has published\n");
    b = buffer.append(heap, b, "cancho vcs log --store .cancho-vcs\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# Re-verify every pin a store has ever published\n");
    b = buffer.append(heap, b, "cancho vcs resolve .cancho-vcs\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# Pin names by hash into a lock file\n");
    b = buffer.append(heap, b, "cancho vcs lock --store .cancho-vcs -o app.lock connect octets_of\n");
    b = buffer.append(heap, b, "```\n");
    return b;
}

fn skill_text_9[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# Fetch verified sources for a lock\n");
    b = buffer.append(heap, b, "cancho vcs fetch --lock app.lock --store .cancho-vcs -o vendor/\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "**See also:** `cancho check`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## `cancho install`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "fetch and check the dependencies named in cancho.toml into build/deps, after checking the compiler is the one the project was written for (docs/package-system.md section 8)\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Options\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "- `--ignore-compiler-rev` (bool) — go on although this compiler is not the commit the project names\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Examples\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# Fetch the project's dependencies\n");
    b = buffer.append(heap, b, "cancho install\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "**See also:** `cancho add`, `cancho build`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## `cancho add`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "add a dependency to cancho.toml, pinned to a full commit hash (a --ref is resolved once and the hash written), then install it; the file is put back if the install fails\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Options\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "- `--rev` (string) — a full commit hash\n");
    b = buffer.append(heap, b, "- `--ref` (string) — a branch or tag, resolved once (default: the repository's head)\n");
    b = buffer.append(heap, b, "- `--path` (string) — the store inside the repository (default .cancho-vcs)\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Arguments\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "- `name` (string, required) — what the dependency is called in the project\n");
    b = buffer.append(heap, b, "- `git-url` (string, required) — the repository\n");
    b = buffer.append(heap, b, "\n");
    return b;
}

fn skill_text_10[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "### Examples\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```bash\n");
    b = buffer.append(heap, b, "# Depend on a library at its current head\n");
    b = buffer.append(heap, b, "cancho add log https://github.com/alpibrusl/cancho-log --path .cancho-vcs/log\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "**See also:** `cancho install`, `cancho vcs`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## Output format\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "All commands support `--output json|text|table`. When using `--output json`, responses follow a standard envelope:\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "```json\n");
    b = buffer.append(heap, b, "{\"ok\": true, \"command\": \"...\", \"data\": {...}, \"meta\": {\"duration_ms\": ..., \"version\": \"...\"}}\n");
    b = buffer.append(heap, b, "```\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## Exit codes\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "| Code | Meaning | Action |\n");
    b = buffer.append(heap, b, "|------|---------|--------|\n");
    b = buffer.append(heap, b, "| 0 | Success | Proceed |\n");
    b = buffer.append(heap, b, "| 2 | Invalid arguments | Correct and retry |\n");
    b = buffer.append(heap, b, "| 3 | Not found | Check inputs |\n");
    b = buffer.append(heap, b, "| 5 | Conflict | Resolve conflict |\n");
    b = buffer.append(heap, b, "| 8 | Precondition failed | Fix precondition |\n");
    b = buffer.append(heap, b, "| 9 | Dry-run completed | Review and confirm |\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## Further discovery\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "- `cancho --help` — full help for any command\n");
    b = buffer.append(heap, b, "- `cancho introspect` — machine-readable command tree (JSON)\n");
    b = buffer.append(heap, b, "- `.cli/README.md` — persistent reference (survives context resets)\n");
    return b;
}

pub fn skill_text[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = skill_text_0(heap, b);
    b = skill_text_1(heap, b);
    b = skill_text_2(heap, b);
    b = skill_text_3(heap, b);
    b = skill_text_4(heap, b);
    b = skill_text_5(heap, b);
    b = skill_text_6(heap, b);
    b = skill_text_7(heap, b);
    b = skill_text_8(heap, b);
    b = skill_text_9(heap, b);
    b = skill_text_10(heap, b);
    return b;
}

fn skill_json_head_0[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "{\n");
    b = buffer.append(heap, b, "  \"ok\": true,\n");
    b = buffer.append(heap, b, "  \"command\": \"skill\",\n");
    b = buffer.append(heap, b, "  \"data\": {\n");
    b = buffer.append(heap, b, "    \"content\": \"---\\nname: cancho\\ndescription: \\\"Invoke the `cancho` CLI. Commands: build, check, run, test…\\\"\\n---\\n\\n# cancho\\n\\n> Auto-generated skill file for `cancho` v0.0.0\\n> Re-generate with: `cancho skill` or `acli skill --bin cancho`\\n\\n## Available commands\\n\\n- `cancho build` — compile one or more files to a linked executable or object file (exit 1 = refused, 2 = bad command line, 3 = environment failure) (idempotent)\\n- `cancho check` — type-check without producing an executable; --output json answers every refusal as data (a stable rule tag, position, and sentence) instead of prose (docs/agent-errors.md) (idempotent)\\n- `cancho run` — build to a temporary executable and run it; the process's own exit status is the compiled program's, not a fixed cancho code\\n- `cancho test` — build once and run every `fn test_*` in the files named, one process each; a test answers 0 to pass, and a trap fails it (exit 0 = all passed, 4 = a test failed, 1 = refused, 2 = bad command line or no tests found, 3 = environment failure; docs/testing.md)\\n- `cancho fmt` — rewrite files in canonical layout, keeping comments, blank lines and literal spellings; --check writes nothing and exits 1 if any file would change (exit 1 also = a file it cannot format safely; docs/formatting.md) (idempotent)\\n- `cancho ids` — print each declaration's content hash: a signature and a body for every function, one identity for every type (docs/canonical-ast.md) (idempotent)\\n- `cancho authority` — derive the least grant a program provably needs from its own effect rows (docs/authority.md) (idempotent)\\n- `cancho satisfy` — the spec-to-implementation loop (docs/satisfy.md): a contract is a .cho file whose `fn test_*` call the candidate, and satisfaction is the checker and the test runner composed against one program, the verdict named with the candidate's recomputed SigId (exit 0 = satisfied, 1 = refused by the checker, 4 = a test failed, 2 = bad command line or a contract with no tests)\\n- `cancho layout` — report struct field layout and what packing or reordering would cost or save (docs/layout.md) (idempotent)\\n- `cancho print` — render one parsed file in canonical form -- the AST-to-text direction of the pipeline, not a formatter (comments never reach the AST) (idempotent)\\n- `cancho ingest` — the missing half of `print`: a JSON unit in, canonical .cho text out (docs/structured-ingest.md) -- an agent writes the data form and the compiler checks it against the same vocabulary the encoder writes, refusing with a rule like any other (ingest-json, ingest-node, ingest-arity) (idempotent)\\n- `cancho agent-guidelines` — emit AGENTS.md: how to write cancho in one page rather than in 42 documents. Every checked code block in it is run by the test suite, so a guideline that stops being true is a red build (idempotent)\\n- `cancho vcs` — the content-addressed package store: publish, log, resolve, lock, and fetch declarations (docs/package-system.md)\\n- `cancho install` — fetch and check the dependencies named in cancho.toml into build/deps, after checking the compiler is the one the project was written for (docs/package-system.md section 8) (idempotent)\\n- `cancho add` — add a dependency to cancho.toml, pinned to a full commit hash (a --ref is resolved once and the hash written), then install it; the file is put back if the install fails\\n\\n## `cancho build`\\n\\ncompile one or more files to a linked executable or object file (exit 1 = refused, 2 = bad command line, 3 = environment failure)\\n\\n### Options\\n\\n- `--emit` (enum[exe|obj]) — emit a linked executable or a bare object file [default: \\\"exe\\\"]\\n- `--std` (bool) — make the standard library's source available\\n- `--backend` (enum[cranelift|llvm]) — which backend generates code [default: \\\"llvm\\\"]\\n- `--target` (string) — generate code for this target triple (`--backend llvm` only; `wasm32-wasip1`, docs/wasm.md)\\n\\n### Arguments\\n\\n- `file` (string[], optional) — one or more .cho files -- a program is the set of files named on the command line; with none, in a project, build the [[bin]] programs of cancho.toml (--bin <name> one of them)\\n- `-o <path>` (string, optional) — output path (default: the first input's stem)\\n- `-l <name>` (string[], optional) — link `lib<name>` at the final link step, repeatable, passed to `cc` unexamined\\n- `-L <path>` (string[], optional) — linker search path for `-l`, repeatable, same treatment\\n\\n### Examples\\n\\n```bash\\n# Build an executable\\ncancho build hello.cho\\n```\\n\\n```bash\\n# Build with the standard library available\\ncancho build --std app.cho\\n```\\n\\n```bash\\n# Build against a library beyond libc\\ncancho build -o client client.cho -l ssl -l crypto\\n```\\n\\n**See also:** `cancho check`, `cancho run`\\n\\n## `cancho check`\\n\\ntype-check without producing an executable; --output json answers every refusal as data (a stable rule tag, position, and sentence) instead of prose (docs/agent-errors.md)\\n\\n### Options\\n\\n- `--std` (bool) — make the standard library's source available\\n- `--output` (enum[json]) — report every independent refusal as structured data\\n- `--backend` (enum[cranelift|llvm]) — which backend generates the code check discards [default: \\\"llvm\\\"]\\n- `--target` (string) — generate code for this target triple (`--backend llvm` only; `wasm32-wasip1`, docs/wasm.md)\\n\\n### Arguments\\n\\n- `file` (string[], required) — one or more .cho files\\n\\n### Examples\\n\\n```bash\\n# Type-check a file\\ncancho check hello.cho\\n```\\n\\n```bash\\n# Every refusal as structured data\\ncancho check --output json app.cho\\n```\\n\\n**See also:** `cancho build`, `cancho agent-guidelines`\\n\\n## `cancho run`\\n\\nbuild to a temporary executable and run it; the process's own exit status is the compiled program's, not a fixed cancho code\\n\\n### Options\\n\\n- `--std` (bool) — make the standard library's source available\\n- `--backend` (enum[cranelift|llvm]) — which backend generates code [default: \\\"llvm\\\"]\\n- `--target` (string) — generate code for this target triple (`--backend llvm` only; `wasm32-wasip1`, docs/wasm.md)\\n\\n### Arguments\\n\\n- `file` (string[], required) — one or more .cho files\\n- `-l <name>` (string[], optional) — link `lib<name>` (repeatable)\\n- `-L <path>` (string[], optional) — linker search path for `-l` (repeatable)\\n\\n### Examples\\n\\n```bash\\n# Run a program\\ncancho run hello.cho\\n```\\n\\n**See also:** `cancho build`, `cancho check`\\n\\n## `cancho test`\\n\\nbuild once and run every `fn test_*` in the files named, one process each; a test answers 0 to pass, and a trap fails it (exit 0 = all passed, 4 = a test failed, 1 = refused, 2 = bad command line or no tests found, 3 = environment failure; docs/testing.md)\\n\\n### Options\\n\\n- `--std` (bool) — make the standard library's source available\\n- `--backend` (enum[cranelift|llvm]) — which backend generates code [default: \\\"llvm\\\"]\\n\\n### Arguments\\n\\n- `file` (string[], optional) — one or more .cho files, none declaring `main`; with none, in a project, run the [[test]] sets of cancho.toml (--test <name> one of them)\\n- `-l <name>` (string[], optional) — link `lib<name>` (repeatable)\\n- `-L <path>` (string[], optional) — linker search path for `-l` (repeatable)\\n\\n### Examples\\n\\n```bash\\n# Run a file's tests\\ncancho test --std tests.cho\\n```\\n\\n**See also:** `cancho run`, `cancho check`\\n\\n## `cancho fmt`\\n\\nrewrite files in canonical layout, keeping comments, blank lines and literal spellings; --check writes nothing and exits 1 if any file would change (exit 1 also = a file it cannot format safely; docs/formatting.md)\\n\\n### Options\\n\\n- `--check` (bool) — report what would change and write nothing\\n\\n### Arguments\\n\\n- `file` (string[], required) — one or more .cho files, or directories searched for them\\n\\n### Examples\\n\\n```bash\\n# Format a tree in place\\ncancho fmt src/\\n```\\n\\n```bash\\n# Fail if anything is not canonical (CI)\\ncancho fmt --check src/ tests/\\n```\\n\\n**See also:** `cancho check`, `cancho print`\\n\\n## `cancho ids`\\n\\nprint each declaration's content hash: a signature and a body for every function, one identity for every type (docs/canonical-ast.md)\\n\\n### Options\\n\\n- `--std` (bool) — make the standard library's source available\\n\\n### Arguments\\n\\n- `file` (string[], required) — one or more .cho files\\n\\n### Examples\\n\\n```bash\\n# Print every declaration's hash\\ncancho ids app.cho\\n```\\n\\n**See also:** `cancho print`, `cancho check`\\n\\n## `cancho authority`\\n\\nderive the least grant a program provably needs from its own effect rows (docs/authority.md)\\n\\n### Options\\n\\n- `--std` (bool) — make the standard library's source available\\n- `--output` (enum[json]) — the report as data rather than prose\\n- `--target` (string) — also report the WASI imports a module built for this target triple may make (`wasm32-wasip1`, docs/wasm.md)\\n\\n### Arguments\\n\\n- `file` (string[], required) — one or more .cho files\\n\\n### Examples\\n\\n```bash\\n# What authority does this program need?\\ncancho authority --output json app.cho\\n```\\n\\n```bash\\n# And what may a WebAssembly build of it import?\\ncancho authority --target wasm32-wasip1 --output json app.cho\\n```\\n\\n**See also:** `cancho check`, `cancho layout`\\n\\n## `cancho satisfy`\\n\\nthe spec-to-implementation loop (docs/satisfy.md): a contract is a .cho file whose `fn test_*` call the candidate, and satisfaction is the checker and the test runner composed against one program, the verdict named with the candidate's recomputed SigId (exit 0 = satisfied, 1 = refused by the checker, 4 = a test failed, 2 = bad command line or a contract with no tests)\\n\\n### Options\\n\\n- `--std` (bool) — make the standard library's source available\\n\\n### Arguments\\n\\n- `contract` (string, optional) — the .cho file whose `fn test_*` call the candidate\\n- `candidate` (string, optional) — the .cho file whose declarations the contract's tests call\\n\\n### Examples\\n\\n```bash\\n# Ask a contract of an implementation\\ncancho satisfy --std tests/satisfy/max.contract.cho tests/satisfy/max.candidate.cho\\n```\\n\\n**See also:** `cancho test`, `cancho check`, `cancho ids`\\n\\n## `cancho layout`\\n\\nreport struct field layout and what packing or reordering would cost or save (docs/layout.md)\\n\\n### Options\\n\\n- `--std` (bool) — make the standard library's source available\\n\\n### Arguments\\n\\n- `file` (string[], required) — one or more .cho files\\n\\n### Examples\\n\\n```bash\\n# Report struct layout\\ncancho layout app.cho\\n```\\n\\n**See also:** `cancho ids`\\n\\n## `cancho print`\\n\\nrender one parsed file in canonical form -- the AST-to-text direction of the pipeline, not a formatter (comments never reach the AST)\\n\\n### Options\\n\\n- `--output` (enum[json]) — the tree as JSON rather than canonical text (docs/structured-ingest.md)\\n\\n### Arguments\\n\\n- `file` (string, required) — exactly one .cho file\\n\\n### Examples\\n\\n```bash\\n# Render a file canonically\\ncancho print app.cho\\n```\\n\\n```bash\\n# The same tree as data, for an agent to read\\ncancho print --output json app.cho\\n```\\n\\n**See also:** `cancho ids`, `cancho ingest`\\n\\n## `cancho ingest`\\n\\nthe missing half of `print`: a JSON unit in, canonical .cho text out (docs/structured-ingest.md) -- an agent writes the data form and the compiler checks it against the same vocabulary the encoder writes, refusing with a rule like any other (ingest-json, ingest-node, ingest-arity)\\n\\n### Options\\n\\n- `--output` (enum[json]) — a refusal as data: rule, message, position (docs/structured-ingest.md)\\n\\n### Arguments\\n\\n- `file` (string, required) — exactly one .json file\\n\\n### Examples\\n\\n```bash\\n# Render a JSON unit as canonical text\\ncancho ingest unit.json\\n```\\n\\n```bash\\n# The loop an agent closes with it\\ncancho print --output json app.cho > unit.json && cancho ingest unit.json\\n```\\n\\n**See also:** `cancho print`, `cancho check`\\n\\n## `cancho agent-guidelines`\\n\\nemit AGENTS.md: how to write cancho in one page rather than in 42 documents. Every checked code block in it is run by the test suite, so a guideline that stops being true is a red build\\n\\n### Examples\\n\\n```bash\\n# Read the rules\\ncancho agent-guidelines\\n```\\n\\n```bash\\n# Capture into a repo\\ncancho agent-guidelines > AGENTS.md\\n```\\n\\n**See also:** `cancho skill`, `cancho introspect`\\n\\n## `cancho vcs`\\n\\nthe content-addressed package store: publish, log, resolve, lock, and fetch declarations (docs/package-system.md)\\n\\n### Arguments\\n\\n- `subcommand` (enum[publish|log|resolve|lock|fetch], required) — what to do\\n\\n### Examples\\n\\n```bash\\n# Publish every declaration in a file\\ncancho vcs publish --store .cancho-vcs app.cho\\n```\\n\\n```bash\\n# List what a store has published\\ncancho vcs log --store .cancho-vcs\\n```\\n\\n```bash\\n# Re-verify every pin a store has ever published\\ncancho vcs resolve .cancho-vcs\\n```\\n\\n```bash\\n# Pin names by hash into a lock file\\ncancho vcs lock --store .cancho-vcs -o app.lock connect octets_of\\n```\\n\\n```bash\\n# Fetch verified sources for a lock\\ncancho vcs fetch --lock app.lock --store .cancho-vcs -o vendor/\\n```\\n\\n**See also:** `cancho check`\\n\\n## `cancho install`\\n\\nfetch and check the dependencies named in cancho.toml into build/deps, after checking the compiler is the one the project was written for (docs/package-system.md section 8)\\n\\n### Options\\n\\n- `--ignore-compiler-rev` (bool) — go on although this compiler is not the commit the project names\\n\\n### Examples\\n\\n```bash\\n# Fetch the project's dependencies\\ncancho install\\n```\\n\\n**See also:** `cancho add`, `cancho build`\\n\\n## `cancho add`\\n\\nadd a dependency to cancho.toml, pinned to a full commit hash (a --ref is resolved once and the hash written), then install it; the file is put back if the install fails\\n\\n### Options\\n\\n- `--rev` (string) — a full commit hash\\n- `--ref` (string) — a branch or tag, resolved once (default: the repository's head)\\n- `--path` (string) — the store inside the repository (default .cancho-vcs)\\n\\n### Arguments\\n\\n- `name` (string, required) — what the dependency is called in the project\\n- `git-url` (string, required) — the repository\\n\\n### Examples\\n\\n```bash\\n# Depend on a library at its current head\\ncancho add log https://github.com/alpibrusl/cancho-log --path .cancho-vcs/log\\n```\\n\\n**See also:** `cancho install`, `cancho vcs`\\n\\n## Output format\\n\\nAll commands support `--output json|text|table`. When using `--output json`, responses follow a standard envelope:\\n\\n```json\\n{\\\"ok\\\": true, \\\"command\\\": \\\"...\\\", \\\"data\\\": {...}, \\\"meta\\\": {\\\"duration_ms\\\": ..., \\\"version\\\": \\\"...\\\"}}\\n```\\n\\n## Exit codes\\n\\n| Code | Meaning | Action |\\n|------|---------|--------|\\n| 0 | Success | Proceed |\\n| 2 | Invalid arguments | Correct and retry |\\n| 3 | Not found | Check inputs |\\n| 5 | Conflict | Resolve conflict |\\n| 8 | Precondition failed | Fix precondition |\\n| 9 | Dry-run completed | Review and confirm |\\n\\n## Further discovery\\n\\n- `cancho --help` — full help for any command\\n- `cancho introspect` — machine-readable command tree (JSON)\\n- `.cli/README.md` — persistent reference (survives context resets)\\n\",\n");
    b = buffer.append(heap, b, "    \"path\": ");
    return b;
}

pub fn skill_json_head[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = skill_json_head_0(heap, b);
    return b;
}

fn skill_json_tail_0[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "  },\n");
    b = buffer.append(heap, b, "  \"meta\": {\n");
    b = buffer.append(heap, b, "    \"duration_ms\": 0,\n");
    b = buffer.append(heap, b, "    \"version\": \"0.0.0\"\n");
    b = buffer.append(heap, b, "  }\n");
    b = buffer.append(heap, b, "}\n");
    return b;
}

pub fn skill_json_tail[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = skill_json_tail_0(heap, b);
    return b;
}
