fn skill_text_0[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "---\n");
    b = buffer.append(heap, b, "name: cancho\n");
    b = buffer.append(heap, b, "description: \"Invoke the `cancho` CLI. Commands: build, check, run, test…\"\n");
    b = buffer.append(heap, b, "---\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "# cancho\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "> Auto-generated skill file for `cancho` v0.0.0\n");
    b = buffer.append(heap, b, "> Re-generate with: `cancho skill` or `acli skill --bin cancho`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## Available commands\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "- `cancho build` — compile one or more files to a linked executable or object file (exit 1 = refused, 2 = bad command line, 3 = environment failure) (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho check` — type-check without producing an executable; --output json answers every refusal as data (a stable rule tag, position, and sentence) instead of prose (docs/agent-errors.md) (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho run` — build to a temporary executable and run it; the process's own exit status is the compiled program's, not a fixed cancho code\n");
    b = buffer.append(heap, b, "- `cancho test` — build once and run every `fn test_*` in the files named, one process each; a test answers 0 to pass, and a trap fails it (exit 0 = all passed, 4 = a test failed, 1 = refused, 2 = bad command line or no tests found, 3 = environment failure; docs/testing.md)\n");
    b = buffer.append(heap, b, "- `cancho fmt` — rewrite files in canonical layout, keeping comments, blank lines and literal spellings; --check writes nothing and exits 1 if any file would change (exit 1 also = a file it cannot format safely; docs/formatting.md) (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho ids` — print each declaration's content hash: a signature and a body for every function, one identity for every type (docs/canonical-ast.md) (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho authority` — derive the least grant a program provably needs from its own effect rows (docs/authority.md) (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho satisfy` — the spec-to-implementation loop (docs/satisfy.md): a contract is a .cho file whose `fn test_*` call the candidate, and satisfaction is the checker and the test runner composed against one program, the verdict named with the candidate's recomputed SigId (exit 0 = satisfied, 1 = refused by the checker, 4 = a test failed, 2 = bad command line or a contract with no tests)\n");
    b = buffer.append(heap, b, "- `cancho layout` — report struct field layout and what packing or reordering would cost or save (docs/layout.md) (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho print` — render one parsed file in canonical form -- the AST-to-text direction of the pipeline, not a formatter (comments never reach the AST) (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho ingest` — the missing half of `print`: a JSON unit in, canonical .cho text out (docs/structured-ingest.md) -- an agent writes the data form and the compiler checks it against the same vocabulary the encoder writes, refusing with a rule like any other (ingest-json, ingest-node, ingest-arity) (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho agent-guidelines` — emit AGENTS.md: how to write cancho in one page rather than in 42 documents. Every checked code block in it is run by the test suite, so a guideline that stops being true is a red build (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho vcs` — the content-addressed package store: publish, log, resolve, lock, and fetch declarations (docs/package-system.md)\n");
    b = buffer.append(heap, b, "- `cancho install` — fetch and check the dependencies named in cancho.toml into build/deps, after checking the compiler is the one the project was written for (docs/package-system.md section 8) (idempotent)\n");
    b = buffer.append(heap, b, "- `cancho add` — add a dependency to cancho.toml, pinned to a full commit hash (a --ref is resolved once and the hash written), then install it; the file is put back if the install fails\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "## `cancho build`\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "compile one or more files to a linked executable or object file (exit 1 = refused, 2 = bad command line, 3 = environment failure)\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Options\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "- `--emit` (enum[exe|obj]) — emit a linked executable or a bare object file [default: \"exe\"]\n");
    b = buffer.append(heap, b, "- `--std` (bool) — make the standard library's source available\n");
    b = buffer.append(heap, b, "- `--backend` (enum[cranelift|llvm]) — which backend generates code [default: \"llvm\"]\n");
    b = buffer.append(heap, b, "- `--target` (string) — generate code for this target triple (`--backend llvm` only; `wasm32-wasip1`, docs/wasm.md)\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "### Arguments\n");
    return b;
}

