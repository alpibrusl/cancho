    b = buffer.append(heap, b, "            \"required\": false,\n");
    b = buffer.append(heap, b, "            \"type\": \"string[]\"\n");
    b = buffer.append(heap, b, "          },\n");
    b = buffer.append(heap, b, "          {\n");
    b = buffer.append(heap, b, "            \"description\": \"output path (default: the first input's stem)\",\n");
    b = buffer.append(heap, b, "            \"name\": \"-o <path>\",\n");
    b = buffer.append(heap, b, "            \"required\": false,\n");
    b = buffer.append(heap, b, "            \"type\": \"string\"\n");
    b = buffer.append(heap, b, "          },\n");
    b = buffer.append(heap, b, "          {\n");
    b = buffer.append(heap, b, "            \"description\": \"link `lib<name>` at the final link step, repeatable, passed to `cc` unexamined\",\n");
    b = buffer.append(heap, b, "            \"name\": \"-l <name>\",\n");
    b = buffer.append(heap, b, "            \"required\": false,\n");
    b = buffer.append(heap, b, "            \"type\": \"string[]\"\n");
    b = buffer.append(heap, b, "          },\n");
    b = buffer.append(heap, b, "          {\n");
    b = buffer.append(heap, b, "            \"description\": \"linker search path for `-l`, repeatable, same treatment\",\n");
    b = buffer.append(heap, b, "            \"name\": \"-L <path>\",\n");
    b = buffer.append(heap, b, "            \"required\": false,\n");
    b = buffer.append(heap, b, "            \"type\": \"string[]\"\n");
    b = buffer.append(heap, b, "          }\n");
    b = buffer.append(heap, b, "        ],\n");
    b = buffer.append(heap, b, "        \"description\": \"compile one or more files to a linked executable or object file (exit 1 = refused, 2 = bad command line, 3 = environment failure)\",\n");
