edition 7;
module selfhost.commandtree;

// commandtree.cho -- what `cancho --help`, `introspect` and `skill` write (`docs/cli-in-cancho.md`).
// GENERATED by the test `selfhost::statics::command_tree_module_is_what_cancho_says`: change the source, then run it with CANCHO_REGENERATE=1.

import std.buffer;

fn usage_0[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "cancho — the bootstrap compiler for the cancho systems dialect\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "usage:\n");
    b = buffer.append(heap, b, "    cancho build <file.cho>... [-o <output>] [--emit exe|obj] [--std] [--backend cranelift|llvm] [--target <triple>] [-l <name>]... [-L <path>]... [--compiler <exe>]\n");
    b = buffer.append(heap, b, "    cancho check <file.cho>... [--std] [--output json] [--backend cranelift|llvm] [--target <triple>]\n");
    b = buffer.append(heap, b, "    cancho run   <file.cho>... [--std] [--backend cranelift|llvm] [--target <triple>] [-l <name>]... [-L <path>]...\n");
    b = buffer.append(heap, b, "    cancho test  <file.cho>... [--std] [--backend cranelift|llvm] [-l <name>]... [-L <path>]...\n");
    b = buffer.append(heap, b, "    cancho satisfy <contract.cho> <candidate.cho> [--std]\n");
    b = buffer.append(heap, b, "    cancho fmt   <file.cho|dir>... [--check]\n");
    b = buffer.append(heap, b, "    cancho ids   <file.cho>... [--std]\n");
    b = buffer.append(heap, b, "    cancho authority <file.cho>... [--std] [--output json] [--target <triple>]\n");
    b = buffer.append(heap, b, "    cancho layout    <file.cho>... [--std]\n");
    b = buffer.append(heap, b, "    cancho print <file.cho> [--output json]\n");
    b = buffer.append(heap, b, "    cancho ingest <file.json> [--output json]\n");
    b = buffer.append(heap, b, "    cancho agent-guidelines\n");
    b = buffer.append(heap, b, "    cancho introspect [--output json]\n");
    b = buffer.append(heap, b, "    cancho skill [--output json] [<out-file>]\n");
    b = buffer.append(heap, b, "    cancho install [--ignore-compiler-rev]\n");
    b = buffer.append(heap, b, "    cancho add <name> <git-url> [--rev <hash> | --ref <name>] [--path <dir>] [--ignore-compiler-rev]\n");
    b = buffer.append(heap, b, "    cancho build [--bin <name>] [--ignore-compiler-rev]\n");
    b = buffer.append(heap, b, "    cancho test  [--test <name>] [--ignore-compiler-rev]\n");
    b = buffer.append(heap, b, "    cancho vcs publish [--store <dir>] [--std] [--requires <lock>[:<dep-store>]]... <file.cho>\n");
    b = buffer.append(heap, b, "    cancho vcs publish [--store <root>] [--std] --dir <dir>\n");
    b = buffer.append(heap, b, "    cancho vcs sync [--dir <dir>] [--std] [--check]\n");
    b = buffer.append(heap, b, "    cancho vcs log     [--store <dir>]\n");
    b = buffer.append(heap, b, "    cancho vcs resolve [--lock <file>] [<store-dir>]\n");
    b = buffer.append(heap, b, "    cancho vcs lock (--store <dir> | --git <url> (--rev <hash> | --ref <name>) [--path <dir>]) -o <file> (--all | <name>...)\n");
    b = buffer.append(heap, b, "    cancho vcs fetch --lock <file> [--store <dir>] -o <dir>\n");
    b = buffer.append(heap, b, "    cancho --version\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "options:\n");
    b = buffer.append(heap, b, "    -o <output>     where to write the result (default: the first input's stem)\n");
    b = buffer.append(heap, b, "    --emit exe|obj  emit a linked executable (default) or a bare object file\n");
    b = buffer.append(heap, b, "    --std           make the standard library's source available\n");
    b = buffer.append(heap, b, "    --compiler <exe>  (build) which compiler builds the program. By default the one written in cancho (built once, from sources\n");
    b = buffer.append(heap, b, "                      compiled into this binary, and cached) writes the code, after the Rust front end has checked the\n");
    b = buffer.append(heap, b, "                      program; one that has no code for something, or fails, hands that build to the Rust compiler. `rust` asks for\n");
    b = buffer.append(heap, b, "                      the Rust compiler alone; `auto` for the one in cancho alone, with what it refuses, and no fallback; a path for\n");
    b = buffer.append(heap, b, "                      that compiler. `CANCHO_COMPILER` says the same for every build; `--backend cranelift` and WebAssembly are the\n");
    b = buffer.append(heap, b, "                      Rust compiler's\n");
    return b;
}

fn usage_1[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "    --output json   `check` and `authority` as data rather than prose\n");
    b = buffer.append(heap, b, "    --backend cranelift|llvm\n");
    b = buffer.append(heap, b, "                    which backend generates code (default: llvm, since #127).\n");
    b = buffer.append(heap, b, "                    `llvm` is `cancho-codegen-llvm` (docs/llvm-backend.md):\n");
    b = buffer.append(heap, b, "                    every program this repository tracks builds on it, and\n");
    b = buffer.append(heap, b, "                    anything outside that is refused with an ordinary located\n");
    b = buffer.append(heap, b, "                    error, not a crash. `cranelift` is unaffected either way.\n");
    b = buffer.append(heap, b, "    --target <triple>\n");
    b = buffer.append(heap, b, "                    generate code for another target (`--backend llvm` only;\n");
    b = buffer.append(heap, b, "                    docs/wasm.md). Only `wasm32-wasip1` is built so far: it\n");
    b = buffer.append(heap, b, "                    needs `CLANG` (a clang with the wasm32 target), `WASM_LD`,\n");
    b = buffer.append(heap, b, "                    and `WASI_SYSROOT` (a wasi-libc sysroot); `run` uses\n");
    b = buffer.append(heap, b, "                    `WASMTIME` and `WASMTIME_FLAGS` (e.g. `--dir=.`). A builtin\n");
    b = buffer.append(heap, b, "                    with no WASI meaning is refused.\n");
    b = buffer.append(heap, b, "    -l <name>       link `lib<name>` at the final link step (`build`/`run`\n");
    b = buffer.append(heap, b, "                    only); repeatable, passed to `cc` unexamined\n");
    b = buffer.append(heap, b, "    -L <path>       add `<path>` to the linker's search path for the above;\n");
    b = buffer.append(heap, b, "                    repeatable, same treatment\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "A program is the set of files named on the command line, in any order.\n");
    b = buffer.append(heap, b, "Each file is in a module -- the root, unless it says `module a.b;` -- and\n");
    b = buffer.append(heap, b, "reaches another module's names through `import`. See docs/many-files.md\n");
    b = buffer.append(heap, b, "and docs/modules.md.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`--std` adds the standard library's source, which is compiled into this\n");
    b = buffer.append(heap, b, "binary rather than looked up on disk: no search path, no manifest. It is\n");
    b = buffer.append(heap, b, "not a prelude -- a program still writes `import std.io;` where it uses\n");
    b = buffer.append(heap, b, "one -- and a declaration nothing calls emits nothing. See\n");
    b = buffer.append(heap, b, "docs/standard-library.md.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`check --output json` answers every refusal as data: a stable `rule`\n");
    b = buffer.append(heap, b, "tag, the same sentence, what the rule enforces, and a position. The exit\n");
    b = buffer.append(heap, b, "status is unchanged -- 1 for a refused program -- and `check` reports\n");
    b = buffer.append(heap, b, "every independent refusal rather than the first. See\n");
    b = buffer.append(heap, b, "docs/agent-errors.md.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`check` also generates the code and discards it, so a program it\n");
    b = buffer.append(heap, b, "accepts is one `build` can compile. If the compiler itself fails, that\n");
    b = buffer.append(heap, b, "is a refusal with rule `internal`, at the function it failed on. See\n");
    b = buffer.append(heap, b, "docs/internal-errors.md.\n");
    return b;
}

fn usage_2[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`test` runs every `fn test_*` in the files named, one process each, and\n");
    b = buffer.append(heap, b, "exits 4 if any failed. A test answers 0 to pass; `std.test`'s `assert`\n");
    b = buffer.append(heap, b, "traps otherwise. The files must not declare `main`: the runner writes\n");
    b = buffer.append(heap, b, "one. See docs/testing.md.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`fmt` rewrites each file (or each `.cho` under a directory) in canonical\n");
    b = buffer.append(heap, b, "layout, keeping its comments, its blank lines and the way it spelled each\n");
    b = buffer.append(heap, b, "literal. `--check` writes nothing and exits 1 if any file would change.\n");
    b = buffer.append(heap, b, "A file it cannot format without moving or losing a comment is left alone\n");
    b = buffer.append(heap, b, "and reported, also exit 1. See docs/formatting.md.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`agent-guidelines` prints AGENTS.md, which is how to write cancho in\n");
    b = buffer.append(heap, b, "one page rather than in 42 documents. Every checked code block in it is\n");
    b = buffer.append(heap, b, "run by the test suite, so a guideline that stops being true is a red\n");
    b = buffer.append(heap, b, "build. See docs/agent-errors.md for what a refusal says as data.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`introspect` prints the full command tree as JSON (ACLI spec §1.2) and\n");
    b = buffer.append(heap, b, "`skill` prints a generated agentskills.io SKILL.md -- both sourced from\n");
    b = buffer.append(heap, b, "one registration in src/acli.rs, so the command list an agent reads\n");
    b = buffer.append(heap, b, "cannot drift from the dispatch table the way a hand-written doc could.\n");
    b = buffer.append(heap, b, "Neither is the exit-code contract: `skill`'s own \"Exit codes\" section\n");
    b = buffer.append(heap, b, "is the ACLI SDK's generic template, not this binary's. `--version`,\n");
    b = buffer.append(heap, b, "`build`, `check`, `run` keep the codes at the top of this file, and\n");
    b = buffer.append(heap, b, "`check --output json` keeps its own `rule` tag as the machine-readable\n");
    b = buffer.append(heap, b, "form. See docs/agent-cli.md.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`ids` prints each declaration's content hash: a signature and a body for\n");
    b = buffer.append(heap, b, "every function, one identity for every type. A unit hashes its content,\n");
    b = buffer.append(heap, b, "not the file it sits in. See docs/canonical-ast.md.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`print` renders one parsed file in canonical form. It is the AST-to-text\n");
    b = buffer.append(heap, b, "direction of that same pipeline, not a formatter: comments never reach the\n");
    b = buffer.append(heap, b, "AST, so they are not in the output. `fmt` is the formatter.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`vcs publish` logs every declaration in one file as an `AddFunction`\n");
    b = buffer.append(heap, b, "operation in a content-addressed store at `--store` (default\n");
    b = buffer.append(heap, b, "`.cancho-vcs`), gated by the same checker `check` runs. A second publish\n");
    b = buffer.append(heap, b, "of an unchanged declaration is a no-op; a second publish of a *changed*\n");
    b = buffer.append(heap, b, "one is refused -- incremental publish is design-stage, not built. `vcs\n");
    return b;
}

fn usage_3[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "log` lists what a store already has. `--requires <lock>:<dep-store>`\n");
    b = buffer.append(heap, b, "(repeatable) is for a package that itself needs another package: the\n");
    b = buffer.append(heap, b, "identity published is still this file's own (structural, unaffected by\n");
    b = buffer.append(heap, b, "any dependency), but the file must still type-check with that\n");
    b = buffer.append(heap, b, "dependency's source in scope, and the pin is recorded so a later `vcs\n");
    b = buffer.append(heap, b, "resolve`/`vcs fetch` finds it without the consumer needing to know it\n");
    b = buffer.append(heap, b, "exists. See docs/vcs-publish.md and docs/package-system.md §4.6.\n");
    b = buffer.append(heap, b, "`--std` lets the package import the bundled library; a publish that\n");
    b = buffer.append(heap, b, "imports `std` (itself or through a `--requires` package) without it is\n");
    b = buffer.append(heap, b, "refused. `resolve` and `fetch` need no flag, and `fetch` notes when the\n");
    b = buffer.append(heap, b, "consumer must `build --std` (docs/package-system.md §4.8).\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`vcs resolve <store-dir>` never trusts that store's own manifest: it\n");
    b = buffer.append(heap, b, "re-parses and re-typechecks the source behind every pin under today's\n");
    b = buffer.append(heap, b, "compiler, then re-derives each declaration's identity and refuses, with\n");
    b = buffer.append(heap, b, "every mismatch reported at once, if a pin no longer matches its own\n");
    b = buffer.append(heap, b, "source, its source no longer type-checks, or a source blob is missing.\n");
    b = buffer.append(heap, b, "Exit 0 only if every pin still resolves exactly as published. `--lock\n");
    b = buffer.append(heap, b, "<file>` scopes this to just the names `vcs lock` pinned, instead of\n");
    b = buffer.append(heap, b, "everything the store has ever published. If the store itself has a\n");
    b = buffer.append(heap, b, "dependency (`--requires` at publish time), its own closure is walked\n");
    b = buffer.append(heap, b, "and verified too, refusing on a cycle or a diamond conflict rather than\n");
    b = buffer.append(heap, b, "guessing. See docs/package-system.md §4.2 and §4.6.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`vcs lock --store <dir> -o <file> <name>...` looks each name up in a\n");
    b = buffer.append(heap, b, "dependency store's manifest and pins it -- by hash, not by name -- into\n");
    b = buffer.append(heap, b, "a lock file at `-o`, refusing if a name is unpublished or ambiguous.\n");
    b = buffer.append(heap, b, "A name is chosen once, when it is first locked; nothing later can\n");
    b = buffer.append(heap, b, "silently substitute a different declaration under it. See\n");
    b = buffer.append(heap, b, "docs/package-system.md §4.5.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`vcs fetch --lock <file> --store <dir> -o <dir>` re-verifies every pin\n");
    b = buffer.append(heap, b, "in a lock the same way `vcs resolve --lock` does, then writes each\n");
    b = buffer.append(heap, b, "distinct verified source to `-o` as `<source_hash>.cho` -- nothing is\n");
    b = buffer.append(heap, b, "written unless everything verifies. This needs no compiler support: a\n");
    b = buffer.append(heap, b, "program is already the set of files named on the command line, and\n");
    b = buffer.append(heap, b, "`import` already resolves a name against whatever module is among\n");
    b = buffer.append(heap, b, "them (docs/modules.md §4.2), so a fetched file is `import`-able the\n");
    b = buffer.append(heap, b, "moment it exists on disk. A dependency's own dependency (`--requires`)\n");
    b = buffer.append(heap, b, "is fetched too, into the same `-o`, so a consumer of a package that has\n");
    return b;
}

fn usage_4[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "one never has to fetch it separately. See docs/package-system.md §4.6\n");
    b = buffer.append(heap, b, "and §4.7.\n");
    b = buffer.append(heap, b, "\n");
    b = buffer.append(heap, b, "`-l`/`-L` are `cc`'s own flags, passed through unexamined: this project\n");
    b = buffer.append(heap, b, "invents no manifest and no dependency resolution, only the ability to\n");
    b = buffer.append(heap, b, "ask the linker for a library beyond libc at all, which nothing here\n");
    b = buffer.append(heap, b, "could do before. `c_ptr` (docs/opaque-pointers.md) lets a foreign\n");
    b = buffer.append(heap, b, "signature name a handle from a library like OpenSSL; this is what\n");
    b = buffer.append(heap, b, "makes that library reachable at link time. See docs/foreign-linking.md.\n");
    return b;
}

pub fn usage[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = usage_0(heap, b);
    b = usage_1(heap, b);
    b = usage_2(heap, b);
    b = usage_3(heap, b);
    b = usage_4(heap, b);
    return b;
}

fn introspect_text_0[&h](heap: &!h Heap, out: buffer.Buffer) -> [heap] buffer.Buffer {
    var b = out;
    b = buffer.append(heap, b, "acli_version: \"0.1.0\"\n");
    b = buffer.append(heap, b, "commands: [{\"arguments\":[{\"description\":\"one or more .cho files -- a program is the set of files named on the command line; with none, in a project, build the [[bin]] programs of cancho.toml (--bin <name> one of them)\",\"name\":\"file\",\"required\":false,\"type\":\"string[]\"},{\"description\":\"output path (default: the first input's stem)\",\"name\":\"-o <path>\",\"required\":false,\"type\":\"string\"},{\"description\":\"link `lib<name>` at the final link step, repeatable, passed to `cc` unexamined\",\"name\":\"-l <name>\",\"required\":false,\"type\":\"string[]\"},{\"description\":\"linker search path for `-l`, repeatable, same treatment\",\"name\":\"-L <path>\",\"required\":false,\"type\":\"string[]\"}],\"description\":\"compile one or more files to a linked executable or object file (exit 1 = refused, 2 = bad command line, 3 = environment failure)\",\"examples\":[{\"description\":\"Build an executable\",\"invocation\":\"cancho build hello.cho\"},{\"description\":\"Build with the standard library available\",\"invocation\":\"cancho build --std app.cho\"},{\"description\":\"Build against a library beyond libc\",\"invocation\":\"cancho build -o client client.cho -l ssl -l crypto\"}],\"idempotent\":true,\"name\":\"build\",\"options\":[{\"default\":\"exe\",\"description\":\"emit a linked executable or a bare object file\",\"name\":\"emit\",\"type\":\"enum[exe|obj]\"},{\"description\":\"make the standard library's source available\",\"name\":\"std\",\"type\":\"bool\"},{\"default\":\"llvm\",\"description\":\"which backend generates code\",\"name\":\"backend\",\"type\":\"enum[cranelift|llvm]\"},{\"description\":\"generate code for this target triple (`--backend llvm` only; `wasm32-wasip1`, docs/wasm.md)\",\"name\":\"target\",\"type\":\"string\"}],\"see_also\":[\"check\",\"run\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"one or more .cho files\",\"name\":\"file\",\"required\":true,\"type\":\"string[]\"}],\"description\":\"type-check without producing an executable; --output json answers every refusal as data (a stable rule tag, position, and sentence) instead of prose (docs/agent-errors.md)\",\"examples\":[{\"description\":\"Type-check a file\",\"invocation\":\"cancho check hello.cho\"},{\"description\":\"Every refusal as structured data\",\"invocation\":\"cancho check --output json app.cho\"}],\"idempotent\":true,\"name\":\"check\",\"options\":[{\"description\":\"make the standard library's source available\",\"name\":\"std\",\"type\":\"bool\"},{\"description\":\"report every independent refusal as structured data\",\"name\":\"output\",\"type\":\"enum[json]\"},{\"default\":\"llvm\",\"description\":\"which backend generates the code check discards\",\"name\":\"backend\",\"type\":\"enum[cranelift|llvm]\"},{\"description\":\"generate code for this target triple (`--backend llvm` only; `wasm32-wasip1`, docs/wasm.md)\",\"name\":\"target\",\"type\":\"string\"}],\"see_also\":[\"build\",\"agent-guidelines\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"one or more .cho files\",\"name\":\"file\",\"required\":true,\"type\":\"string[]\"},{\"description\":\"link `lib<name>` (repeatable)\",\"name\":\"-l <name>\",\"required\":false,\"type\":\"string[]\"},{\"description\":\"linker search path for `-l` (repeatable)\",\"name\":\"-L <path>\",\"required\":false,\"type\":\"string[]\"}],\"description\":\"build to a temporary executable and run it; the process's own exit status is the compiled program's, not a fixed cancho code\",\"examples\":[{\"description\":\"Run a program\",\"invocation\":\"cancho run hello.cho\"}],\"idempotent\":false,\"name\":\"run\",\"options\":[{\"description\":\"make the standard library's source available\",\"name\":\"std\",\"type\":\"bool\"},{\"default\":\"llvm\",\"description\":\"which backend generates code\",\"name\":\"backend\",\"type\":\"enum[cranelift|llvm]\"},{\"description\":\"generate code for this target triple (`--backend llvm` only; `wasm32-wasip1`, docs/wasm.md)\",\"name\":\"target\",\"type\":\"string\"}],\"see_also\":[\"build\",\"check\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"one or more .cho files, none declaring `main`; with none, in a project, run the [[test]] sets of cancho.toml (--test <name> one of them)\",\"name\":\"file\",\"required\":false,\"type\":\"string[]\"},{\"description\":\"link `lib<name>` (repeatable)\",\"name\":\"-l <name>\",\"required\":false,\"type\":\"string[]\"},{\"description\":\"linker search path for `-l` (repeatable)\",\"name\":\"-L <path>\",\"required\":false,\"type\":\"string[]\"}],\"description\":\"build once and run every `fn test_*` in the files named, one process each; a test answers 0 to pass, and a trap fails it (exit 0 = all passed, 4 = a test failed, 1 = refused, 2 = bad command line or no tests found, 3 = environment failure; docs/testing.md)\",\"examples\":[{\"description\":\"Run a file's tests\",\"invocation\":\"cancho test --std tests.cho\"}],\"idempotent\":false,\"name\":\"test\",\"options\":[{\"description\":\"make the standard library's source available\",\"name\":\"std\",\"type\":\"bool\"},{\"default\":\"llvm\",\"description\":\"which backend generates code\",\"name\":\"backend\",\"type\":\"enum[cranelift|llvm]\"}],\"see_also\":[\"run\",\"check\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"one or more .cho files, or directories searched for them\",\"name\":\"file\",\"required\":true,\"type\":\"string[]\"}],\"description\":\"rewrite files in canonical layout, keeping comments, blank lines and literal spellings; --check writes nothing and exits 1 if any file would change (exit 1 also = a file it cannot format safely; docs/formatting.md)\",\"examples\":[{\"description\":\"Format a tree in place\",\"invocation\":\"cancho fmt src/\"},{\"description\":\"Fail if anything is not canonical (CI)\",\"invocation\":\"cancho fmt --check src/ tests/\"}],\"idempotent\":true,\"name\":\"fmt\",\"options\":[{\"description\":\"report what would change and write nothing\",\"name\":\"check\",\"type\":\"bool\"}],\"see_also\":[\"check\",\"print\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"one or more .cho files\",\"name\":\"file\",\"required\":true,\"type\":\"string[]\"}],\"description\":\"print each declaration's content hash: a signature and a body for every function, one identity for every type (docs/canonical-ast.md)\",\"examples\":[{\"description\":\"Print every declaration's hash\",\"invocation\":\"cancho ids app.cho\"}],\"idempotent\":true,\"name\":\"ids\",\"options\":[{\"description\":\"make the standard library's source available\",\"name\":\"std\",\"type\":\"bool\"}],\"see_also\":[\"print\",\"check\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"one or more .cho files\",\"name\":\"file\",\"required\":true,\"type\":\"string[]\"}],\"description\":\"derive the least grant a program provably needs from its own effect rows (docs/authority.md)\",\"examples\":[{\"description\":\"What authority does this program need?\",\"invocation\":\"cancho authority --output json app.cho\"},{\"description\":\"And what may a WebAssembly build of it import?\",\"invocation\":\"cancho authority --target wasm32-wasip1 --output json app.cho\"}],\"idempotent\":true,\"name\":\"authority\",\"options\":[{\"description\":\"make the standard library's source available\",\"name\":\"std\",\"type\":\"bool\"},{\"description\":\"the report as data rather than prose\",\"name\":\"output\",\"type\":\"enum[json]\"},{\"description\":\"also report the WASI imports a module built for this target triple may make (`wasm32-wasip1`, docs/wasm.md)\",\"name\":\"target\",\"type\":\"string\"}],\"see_also\":[\"check\",\"layout\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"the .cho file whose `fn test_*` call the candidate\",\"name\":\"contract\",\"required\":false,\"type\":\"string\"},{\"description\":\"the .cho file whose declarations the contract's tests call\",\"name\":\"candidate\",\"required\":false,\"type\":\"string\"}],\"description\":\"the spec-to-implementation loop (docs/satisfy.md): a contract is a .cho file whose `fn test_*` call the candidate, and satisfaction is the checker and the test runner composed against one program, the verdict named with the candidate's recomputed SigId (exit 0 = satisfied, 1 = refused by the checker, 4 = a test failed, 2 = bad command line or a contract with no tests)\",\"examples\":[{\"description\":\"Ask a contract of an implementation\",\"invocation\":\"cancho satisfy --std tests/satisfy/max.contract.cho tests/satisfy/max.candidate.cho\"}],\"idempotent\":false,\"name\":\"satisfy\",\"options\":[{\"description\":\"make the standard library's source available\",\"name\":\"std\",\"type\":\"bool\"}],\"see_also\":[\"test\",\"check\",\"ids\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"one or more .cho files\",\"name\":\"file\",\"required\":true,\"type\":\"string[]\"}],\"description\":\"report struct field layout and what packing or reordering would cost or save (docs/layout.md)\",\"examples\":[{\"description\":\"Report struct layout\",\"invocation\":\"cancho layout app.cho\"}],\"idempotent\":true,\"name\":\"layout\",\"options\":[{\"description\":\"make the standard library's source available\",\"name\":\"std\",\"type\":\"bool\"}],\"see_also\":[\"ids\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"exactly one .cho file\",\"name\":\"file\",\"required\":true,\"type\":\"string\"}],\"description\":\"render one parsed file in canonical form -- the AST-to-text direction of the pipeline, not a formatter (comments never reach the AST)\",\"examples\":[{\"description\":\"Render a file canonically\",\"invocation\":\"cancho print app.cho\"},{\"description\":\"The same tree as data, for an agent to read\",\"invocation\":\"cancho print --output json app.cho\"}],\"idempotent\":true,\"name\":\"print\",\"options\":[{\"description\":\"the tree as JSON rather than canonical text (docs/structured-ingest.md)\",\"name\":\"output\",\"type\":\"enum[json]\"}],\"see_also\":[\"ids\",\"ingest\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"exactly one .json file\",\"name\":\"file\",\"required\":true,\"type\":\"string\"}],\"description\":\"the missing half of `print`: a JSON unit in, canonical .cho text out (docs/structured-ingest.md) -- an agent writes the data form and the compiler checks it against the same vocabulary the encoder writes, refusing with a rule like any other (ingest-json, ingest-node, ingest-arity)\",\"examples\":[{\"description\":\"Render a JSON unit as canonical text\",\"invocation\":\"cancho ingest unit.json\"},{\"description\":\"The loop an agent closes with it\",\"invocation\":\"cancho print --output json app.cho > unit.json && cancho ingest unit.json\"}],\"idempotent\":true,\"name\":\"ingest\",\"options\":[{\"description\":\"a refusal as data: rule, message, position (docs/structured-ingest.md)\",\"name\":\"output\",\"type\":\"enum[json]\"}],\"see_also\":[\"print\",\"check\"],\"subcommands\":[]},{\"arguments\":[],\"description\":\"emit AGENTS.md: how to write cancho in one page rather than in 42 documents. Every checked code block in it is run by the test suite, so a guideline that stops being true is a red build\",\"examples\":[{\"description\":\"Read the rules\",\"invocation\":\"cancho agent-guidelines\"},{\"description\":\"Capture into a repo\",\"invocation\":\"cancho agent-guidelines > AGENTS.md\"}],\"idempotent\":true,\"name\":\"agent-guidelines\",\"options\":[],\"see_also\":[\"skill\",\"introspect\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"what to do\",\"name\":\"subcommand\",\"required\":true,\"type\":\"enum[publish|log|resolve|lock|fetch]\"}],\"description\":\"the content-addressed package store: publish, log, resolve, lock, and fetch declarations (docs/package-system.md)\",\"examples\":[{\"description\":\"Publish every declaration in a file\",\"invocation\":\"cancho vcs publish --store .cancho-vcs app.cho\"},{\"description\":\"List what a store has published\",\"invocation\":\"cancho vcs log --store .cancho-vcs\"},{\"description\":\"Re-verify every pin a store has ever published\",\"invocation\":\"cancho vcs resolve .cancho-vcs\"},{\"description\":\"Pin names by hash into a lock file\",\"invocation\":\"cancho vcs lock --store .cancho-vcs -o app.lock connect octets_of\"},{\"description\":\"Fetch verified sources for a lock\",\"invocation\":\"cancho vcs fetch --lock app.lock --store .cancho-vcs -o vendor/\"}],\"idempotent\":false,\"name\":\"vcs\",\"options\":[],\"see_also\":[\"check\"],\"subcommands\":[]},{\"arguments\":[],\"description\":\"fetch and check the dependencies named in cancho.toml into build/deps, after checking the compiler is the one the project was written for (docs/package-system.md section 8)\",\"examples\":[{\"description\":\"Fetch the project's dependencies\",\"invocation\":\"cancho install\"}],\"idempotent\":true,\"name\":\"install\",\"options\":[{\"description\":\"go on although this compiler is not the commit the project names\",\"name\":\"ignore-compiler-rev\",\"type\":\"bool\"}],\"see_also\":[\"add\",\"build\"],\"subcommands\":[]},{\"arguments\":[{\"description\":\"what the dependency is called in the project\",\"name\":\"name\",\"required\":true,\"type\":\"string\"},{\"description\":\"the repository\",\"name\":\"git-url\",\"required\":true,\"type\":\"string\"}],\"description\":\"add a dependency to cancho.toml, pinned to a full commit hash (a --ref is resolved once and the hash written), then install it; the file is put back if the install fails\",\"examples\":[{\"description\":\"Depend on a library at its current head\",\"invocation\":\"cancho add log https://github.com/alpibrusl/cancho-log --path .cancho-vcs/log\"}],\"idempotent\":false,\"name\":\"add\",\"options\":[{\"description\":\"a full commit hash\",\"name\":\"rev\",\"type\":\"string\"},{\"description\":\"a branch or tag, resolved once (default: the repository's head)\",\"name\":\"ref\",\"type\":\"string\"},{\"description\":\"the store inside the repository (default .cancho-vcs)\",\"name\":\"path\",\"type\":\"string\"}],\"see_also\":[\"install\",\"vcs\"],\"subcommands\":[]}]\n");
