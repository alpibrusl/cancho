    b = buffer.append(heap, b, "          {\n");
    b = buffer.append(heap, b, "            \"description\": \"Build an executable\",\n");
    b = buffer.append(heap, b, "            \"invocation\": \"cancho build hello.cho\"\n");
    b = buffer.append(heap, b, "          },\n");
    b = buffer.append(heap, b, "          {\n");
    return b;
}

