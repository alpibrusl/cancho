edition 6;

// `tls_echo` -- a TLS 1.3 echo server: the example `docs/tls-server.md` §8,
// step 3, gives the broker and the gateway to copy. Non-blocking, one
// thread, one `Poller`, many connections at once over `std.conns`, with
// `packages/tls`'s engine between each socket and the echo. No foreign
// code: the authority report is bounded.
//
//     tls_echo --port <n> --dir <directory> [--identity <subdirectory>]...
//              [--alpn <p1,p2,...>] [--connections <n>] [--handshakes <n>]
//              [--rate <per second>] [--handshake-timeout <ms>] [--idle <ms>]
//              [--per-address <n>] [--per-address-rate <per second>]
//
// `--dir` holds the certificates: `chain.pem` (PEM, leaf first), `key.pem`
// (P-256, PKCS#8 or SEC 1, unencrypted) and `names` (the host names it
// serves), or, with `--identity`, one subdirectory each holding the three,
// up to 16, the first the default for an unknown or absent name
// (`examples/tls_echo/identity.cho` says why the directory is opened once
// and read through the handle). The engine's entropy is 32 bytes of
// `/dev/urandom`. Because the operator names the directory, `main` holds `Fs("")` and the
// report says `fs_read("")`; `examples/tls_echo_fixed` is this server with the directory
// fixed at build time, and reports the two paths it reads (`serve` and the loop are shared).
//
// The defaults: no ALPN; 256 connections; 32 handshakes in progress and
// 100 started a second (a full handshake measured 3.0 ms of this server's
// CPU on an Apple M4 and 5.5 ms on CI's x86-64, `docs/tls-server.md`
// §11.4, so 100 a second is a third to a half of the one core it runs on;
// set it from the machine's own figure);
// 10,000 ms to finish a handshake; 60,000 ms idle.
//
// `SIGHUP` reads every identity again (`tls.replace_identity`); `SIGINT`
// or `SIGTERM` stops it cleanly. What it prints, and how the bounds work,
// is `examples/tls_echo/front.cho`'s header. Exit status: 0 stopped by a
// signal, 2 a usage error, 3 the port cannot be listened on, 4 no poller,
// 5 the directory cannot be opened, 6 an identity refused, 7 the
// signals cannot be claimed.

import std.bytes;
import std.io;
import echo_loop;
import tls_front as front;
import tls;

fn usage[&i](io: &!i Io) -> [err_write] int {
    io.error_all(io, "usage: tls_echo --port <n> --dir <directory> [--identity <subdirectory>]... [--alpn <p1,p2>]\n");
    io.error_all(io, "                [--connections <n>] [--handshakes <n>] [--rate <n>] [--handshake-timeout <ms>] [--idle <ms>]\n");
    io.error_all(io, "                [--per-address <n>] [--per-address-rate <n>] [--areas <n>]\n");
    return 2;
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals } = split(world);
    release(ffi);
    let claim = narrow(signals, "HUP,INT,TERM");
    var status = 0;
    borrow mut io as &!i in {
        borrow mut heap as &!h in {
            let cfgb = box_slice(h, front.cfg_len() + 1, 0);
            let subsb = box_slice(h, 16 * front.sub_cap(), byte_of(0));
            let lensb = box_slice(h, 16, 0);
            borrow mut cfgb as &!cw in {
                borrow mut subsb as &!uw in {
                    borrow mut lensb as &!lw in {
                        let cfg = contents(cw);
                        cfg[front.c_conns()] = 256;
                        cfg[front.c_handshakes()] = 32;
                        cfg[front.c_rate()] = 100;
                        cfg[front.c_hs_timeout()] = 10000;
                        cfg[front.c_idle()] = 60000;
                        region r {
                            let alpn = alloc_slice[r](512, byte_of(0));
                            let info = alloc_slice[r](2, 0);
                            let entropy = alloc_slice[r](32, byte_of(0));
                            var dir_name = "";
                            borrow args as &g in {
                                dir_name = front.parse(g, cfg, contents(uw), contents(lw), alpn, info);
                            }
                            if cfg[front.c_identities()] == 0 {
                                // No `--identity`: the directory itself is the one.
                                cfg[front.c_identities()] = 1;
                            }
                            if info[1] != 0 {
                                status = usage(i);
                            } else {
                                // The two uses of a path: the entropy, and the
                                // directory, opened once. Nothing after them is
                                // handed the filesystem capability: `serve`, the
                                // loop and the reload hold the directory handle.
                                var opened = DirOpened::Failed(2);
                                borrow fs as &ff in {
                                    if fs_read(ff, "/dev/urandom", entropy) != 32 {
                                        io.error_all(i, "tls_echo: cannot read 32 bytes of /dev/urandom\n");
                                        status = 5;
                                    }
                                    match opened {
                                        DirOpened::Ok(unused) => {
                                            dir_close(unused);
                                        }
                                        DirOpened::Failed(unused) => {
                                        }
                                    }
                                    opened = open_dir(ff, dir_name);
                                }
                                match opened {
                                    DirOpened::Ok(d) => {
                                        var dir = d;
                                        if status == 0 {
                                            borrow dir as &dh in {
                                                borrow net as &nn in {
                                                    borrow clock as &kk in {
                                                        borrow claim as &ss in {
                                                            status = echo_loop.serve(h, i, nn, kk, ss, dh, contents(uw), contents(lw), cfg, entropy, alpn[0..info[0]]);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        dir_close(dir);
                                    }
                                    DirOpened::Failed(e) => {
                                        io.error_all(i, "tls_echo: cannot open the directory --dir names\n");
                                        status = 5;
                                    }
                                }
                                bytes.zero(entropy);
                            }
                        }
                    }
                }
            }
            unbox_slice(h, cfgb);
            unbox_slice(h, subsb);
            unbox_slice(h, lensb);
        }
    }
    release(fs);
    release(net);
    release(clock);
    release(claim);
    release(args);
    release(io);
    release(heap);
    return status;
}
