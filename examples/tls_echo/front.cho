edition 6;
module tls_front;

// `tls_front` -- what a program that terminates TLS 1.3 over `packages/tls` has
// whatever it does with the plaintext: the options and the per-slot state
// they live in, the log, the handshake bounds (`admit`), accepting, writing
// what the engine has for a socket, ending a connection, reading the
// identities again, and parsing the command line (`docs/tls-server.md` §7,
// §8). It was `examples/tls_echo/echo.cho` and `tls_echo.cho` until a second
// program, `examples/https_hello` (`docs/http-server.md` §11), needed the same
// pieces: the duplication check (`conformance/duplication.rs`) would refuse a
// copy, and a bound fixed in one that was not fixed in the other is the kind of
// difference that is found in production. The move changed no line: every
// function below was, byte for byte, in `echo.cho` or `tls_echo.cho`, with
// `pub` added and, in `stride`, the 4 slots `https_hello` needs.
//
// What stays with each program is what touches the plaintext: `pump` (the
// echo, or the HTTP server between `tls.recv` and `tls.send`), the closing
// that follows it, the sweep and the stop, which call it, and the loop.

// The loop of `examples/tls_echo` and of `examples/https_hello`: one thread, one
// `Poller`, every connection in a slot of `std.conns` and the same slot of the TLS
// engine (`docs/tls-server.md` §8, step 3). The engine moves bytes; these files own
// the sockets, the clock, the bounds and the log.
//
// A connection goes through five phases, in `st[slot * stride()]`:
//
//     1 queued       accepted, waiting for its turn to start a handshake;
//                    not watched, so its ClientHello waits in the kernel
//     2 handshake    `tls.serve` called: it can cost the server a signature
//     3 established  what the program does with the plaintext (the echo, or HTTP)
//     4 closing      our close_notify queued, the rest being written
//
// **The bounds** (`docs/tls-server.md` §7, CPU exhaustion). A handshake
// costs this server about 4 ms of CPU (§6), and any peer can start one, so
// two numbers bound it: handshakes in progress (`tls.handshakes_in_progress`,
// the engine's count of slots served and not yet established, failed or
// closed) and handshakes started in each second. A connection over either
// is **delayed, not refused**: it stays queued, its bytes unread, and
// starts when both allow, oldest first. What is refused is a connection
// over the table (`--connections`): it is accepted and closed at once,
// before it costs anything but the accept. A queued or handshaking
// connection has `--handshake-timeout` to finish (each phase its own), so
// a peer that connects and sends nothing holds a handshake place for that
// long and no longer; an established one is closed with close_notify after
// `--idle` without a byte either way.
//
// **The peer** (`docs/conn-peer.md`). Every line about a connection says who it is from, as the
// socket sees it: `peer=<address>:<port>`. It is asked of the kernel once, right after the
// connection is put in the table (`conns.peer`), and kept in the slot, because a connection that
// has ended has no peer to ask (a reset one has none even sooner, which is `peer=-`). Two more
// bounds count under the peer's **key** (`addr.key`: an IPv4 address, or an IPv6 /64):
// `--per-address <n>` refuses a connection when `<n>` from the same key are already held (it
// is closed at once, as one over the table is: `refused <id> peer=... per-address`), and
// `--per-address-rate <n>` delays a queued connection while `<n>` handshakes from its key were
// already started in this second, as `--rate` delays it for all keys together. Both are 0 (off)
// unless given. A client behind a proxy or NAT is the proxy's or the NAT's address, and counts
// with everything else behind it. An IPv4-mapped address is the IPv4 one (`docs/conn-peer.md`
// section 4); no cancho listener is dual-stack yet, so today every peer here is IPv4.
//
// **Reload** is `SIGHUP`: every identity is read again from its directory
// and given to `tls.replace_identity`; a connection whose ClientHello was
// answered keeps the certificate it was sent, and every later one gets the
// new. A refused replacement (an expired chain, a key that is not the
// leaf's) leaves the old identity serving, and says so. **Stop** is `INT`
// or `TERM`: no more connections; queued and handshaking ones are closed,
// established ones are sent close_notify, and the loop ends once those are
// written or after two seconds.
//
// Lines it prints, each flushed as it is written:
//
//     listening <port>
//     conn <n> peer=<address:port> established suite=<name> group=<name> sni=<name|-> alpn=<protocol|-> hrr=<yes|no> waited=<ms> handshake=<ms>
//     conn <n> peer=<address:port> closed <why> in=<bytes> ms=<since accepted>
//     refused <n> peer=<address:port> full | stopping | per-address
//     reload <identity> ok | reload <identity> refused <tag> | reload <identity> unreadable <file> errno=<n>
//     stopping
//
// `<why>` is `ok` (close_notify both ways), `idle`, `shutdown`,
// `handshake-timeout`, `queue-timeout`, `socket` (the socket failed), or
// the engine's refusal tag (`tls-peer-closed`, `tls-alert-<n>`, a
// `tls-server-*` tag, ...).

import std.addr;
import std.conns;
import std.flags;
import std.io;
import echo_identity;
import tls;

pub fn c_conns() -> [] int {
    return 0;
}

pub fn c_handshakes() -> [] int {
    return 1;
}

pub fn c_rate() -> [] int {
    return 2;
}

pub fn c_hs_timeout() -> [] int {
    return 3;
}

pub fn c_idle() -> [] int {
    return 4;
}

pub fn c_identities() -> [] int {
    return 5;
}

// `--per-address`: at most this many connections from one address key (`std.addr.key`: an
// IPv4 address, or an IPv6 /64), 0 for no bound; and `--per-address-rate`: at most this many
// handshakes started in a second from one key, 0 for no bound.
pub fn c_per_addr() -> [] int {
    return 6;
}

pub fn c_addr_rate() -> [] int {
    return 7;
}

pub fn cfg_len() -> [] int {
    return 8;
}

// The room for an identity's subdirectory name, in `subs`.
pub fn sub_cap() -> [] int {
    return 256;
}

pub fn stride() -> [] int {
    return 26;
}

pub fn s_phase() -> [] int {
    return 0;
}

// When the phase began (monotonic ms).
pub fn s_since() -> [] int {
    return 1;
}

// The last byte either way (monotonic ms), for `--idle`.
pub fn s_active() -> [] int {
    return 2;
}

// Bytes for the socket, `pend[ps..pe]`; bytes from it not yet fed,
// `inq[is..ie]`; plaintext not yet echoed, `app[as..ae]`.
pub fn s_ps() -> [] int {
    return 3;
}

pub fn s_pe() -> [] int {
    return 4;
}

pub fn s_is() -> [] int {
    return 5;
}

pub fn s_ie() -> [] int {
    return 6;
}

pub fn s_as() -> [] int {
    return 7;
}

pub fn s_ae() -> [] int {
    return 8;
}

pub fn s_in() -> [] int {
    return 9;
}

pub fn s_id() -> [] int {
    return 10;
}

// 1 once the socket's read side ended.
pub fn s_eof() -> [] int {
    return 11;
}

// What it is watched for: 0 not registered, 1 read, 2 write.
pub fn s_watch() -> [] int {
    return 12;
}

pub fn s_accepted() -> [] int {
    return 13;
}

pub fn s_waited() -> [] int {
    return 14;
}

// Why it is closing (phase 4).
pub fn s_reason() -> [] int {
    return 15;
}

// For a program that serves HTTP over the plaintext (`examples/https_hello`): the slot
// of the `http.server` connection this one is attached to; plaintext received and not
// yet given to it, `rcv[rs..re]`; and 1 once the peer's close_notify has been read.
pub fn s_hslot() -> [] int {
    return 16;
}

pub fn s_rs() -> [] int {
    return 17;
}

pub fn s_re() -> [] int {
    return 18;
}

pub fn s_peer_closed() -> [] int {
    return 19;
}

// The connection's peer, asked once when it was accepted (`docs/conn-peer.md` section 7): the
// family (4 or 6; 0 for none), the four address words and the port. It is kept here because the
// connection is gone when the line saying it closed is written, and a peer cannot be asked of
// a socket that is not there.
pub fn s_pfam() -> [] int {
    return 20;
}

pub fn s_pw0() -> [] int {
    return 21;
}

pub fn s_pw1() -> [] int {
    return 22;
}

pub fn s_pw2() -> [] int {
    return 23;
}

pub fn s_pw3() -> [] int {
    return 24;
}

pub fn s_pport() -> [] int {
    return 25;
}

pub fn phase_free() -> [] int {
    return 0;
}

pub fn phase_queued() -> [] int {
    return 1;
}

pub fn phase_handshake() -> [] int {
    return 2;
}

pub fn phase_established() -> [] int {
    return 3;
}

pub fn phase_closing() -> [] int {
    return 4;
}

pub fn g_qhead() -> [] int {
    return 0;
}

pub fn g_qlen() -> [] int {
    return 1;
}

// The rate's window: when it began, and handshakes started in it.
pub fn g_window() -> [] int {
    return 2;
}

pub fn g_started() -> [] int {
    return 3;
}

pub fn g_next_id() -> [] int {
    return 4;
}

pub fn g_stopping() -> [] int {
    return 5;
}

pub fn g_stop_at() -> [] int {
    return 6;
}

pub fn g_last_sweep() -> [] int {
    return 7;
}

// The window's number, counted from 1: an entry of the address table is current only if it
// holds this.
pub fn g_wserial() -> [] int {
    return 8;
}

// How many queued connections the last `admit` left waiting for their address's rate.
pub fn g_held() -> [] int {
    return 9;
}

// The address table of `--per-address-rate`: `ak_cap()` entries of four ints from `g_ak()`,
// each (family, key bits, window number, handshakes started in it). A window's number that is
// not the current one makes an entry free, so nothing is ever cleared. At most `ak_cap()`
// distinct keys can start a handshake in one window; the next is delayed to the next.
pub fn g_ak() -> [] int {
    return 10;
}

pub fn ak_cap() -> [] int {
    return 1024;
}

pub fn gl_len() -> [] int {
    return 10 + 4 * 1024;
}

// Each slot's buffers.
pub fn pend_cap() -> [] int {
    return 16384;
}

pub fn inq_cap() -> [] int {
    return 16384;
}

pub fn app_cap() -> [] int {
    return 16384;
}

// How long a stop waits for close_notify to be written.
pub fn drain_ms() -> [] int {
    return 2000;
}

// Why a connection ended, when it is not the engine's refusal.
pub fn r_socket() -> [] int {
    return 0 - 1001;
}

pub fn r_idle() -> [] int {
    return 0 - 1002;
}

pub fn r_handshake_timeout() -> [] int {
    return 0 - 1003;
}

pub fn r_queue_timeout() -> [] int {
    return 0 - 1004;
}

pub fn r_shutdown() -> [] int {
    return 0 - 1005;
}

pub fn flush[&i](io: &!i Io) -> [io_write] int {
    match flush_out(io) {
        Done::Ok(n) => {
            return 0;
        }
        Done::Failed(e) => {
            return e;
        }
    }
}

pub fn suite_name(code: int) -> [] &static [byte] {
    if code == 0x1301 {
        return "TLS_AES_128_GCM_SHA256";
    }
    if code == 0x1302 {
        return "TLS_AES_256_GCM_SHA384";
    }
    if code == 0x1303 {
        return "TLS_CHACHA20_POLY1305_SHA256";
    }
    return "-";
}

pub fn group_name(code: int) -> [] &static [byte] {
    if code == 0x001d {
        return "x25519";
    }
    if code == 0x0017 {
        return "secp256r1";
    }
    if code == 0x0018 {
        return "secp384r1";
    }
    return "-";
}

pub fn print_text[&i, &d](io: &!i Io, d: &d [byte]) -> [io_write] int {
    if len(d) == 0 {
        io.write_all(io, "-");
    } else {
        io.write_all(io, d);
    }
    return 0;
}

pub fn why[&i, &e](io: &!i Io, engine: &e tls.Engine, slot: int, reason: int) -> [io_write] int {
    if reason == r_socket() {
        io.write_all(io, "socket");
    } else if reason == r_idle() {
        io.write_all(io, "idle");
    } else if reason == r_handshake_timeout() {
        io.write_all(io, "handshake-timeout");
    } else if reason == r_queue_timeout() {
        io.write_all(io, "queue-timeout");
    } else if reason == r_shutdown() {
        io.write_all(io, "shutdown");
    } else {
        io.write_all(io, tls.refusal_tag(reason));
        if reason == 0 - 2 {
            io.write_all(io, "-");
            io.print_int(io, tls.alert_received(engine, slot));
        }
    }
    return 0;
}

// The peer kept in `st` for the slot at `b`, as `address:port` (`[address]:port` for IPv6), or
// `-` when there is none.
pub fn print_peer[&i, &s](io: &!i Io, st: &s [int], b: int) -> [io_write] int {
    if st[b + s_pfam()] == 0 {
        io.write_all(io, "-");
        return 0;
    }
    let p = addr.from_parts(st[b + s_pfam()], st[b + s_pw0()], st[b + s_pw1()], st[b + s_pw2()], st[b + s_pw3()], st[b + s_pport()]);
    region r {
        let text = alloc_slice[r](addr.max_text(), byte_of(0));
        io.write_all(io, text[0..addr.text_port(p, text)]);
    }
    return 0;
}

pub fn log_established[&i, &e, &s](io: &!i Io, engine: &e tls.Engine, st: &s [int], slot: int, now: int) -> [io_write] int {
    let b = slot * stride();
    io.write_all(io, "conn ");
    io.print_int(io, st[b + s_id()]);
    io.write_all(io, " peer=");
    print_peer(io, st, b);
    io.write_all(io, " established suite=");
    io.write_all(io, suite_name(tls.suite(engine, slot)));
    io.write_all(io, " group=");
    io.write_all(io, group_name(tls.group(engine, slot)));
    region r {
        let text = alloc_slice[r](256, byte_of(0));
        io.write_all(io, " sni=");
        print_text(io, text[0..tls.server_name(engine, slot, text)]);
        io.write_all(io, " alpn=");
        print_text(io, text[0..tls.alpn(engine, slot, text)]);
    }
    if tls.retried(engine, slot) {
        io.write_all(io, " hrr=yes");
    } else {
        io.write_all(io, " hrr=no");
    }
    io.write_all(io, " waited=");
    io.print_int(io, st[b + s_waited()]);
    io.write_all(io, " handshake=");
    io.print_int(io, now - st[b + s_since()]);
    io.newline(io);
    flush(io);
    return 0;
}

// Ends the connection in `slot`: logs it, forgets its keys, closes the
// socket and frees the slot. Answers 1, for the caller's count.
pub fn end_slot[&i, &e, &t, &s](io: &!i Io, engine: &!e tls.Engine, tab: &!t conns.Table, st: &!s [int], slot: int, reason: int, now: int) -> [io_write] int {
    let b = slot * stride();
    io.write_all(io, "conn ");
    io.print_int(io, st[b + s_id()]);
    io.write_all(io, " peer=");
    print_peer(io, st, b);
    io.write_all(io, " closed ");
    why(io, engine, slot, reason);
    io.write_all(io, " in=");
    io.print_int(io, st[b + s_in()]);
    io.write_all(io, " ms=");
    io.print_int(io, now - st[b + s_accepted()]);
    io.newline(io);
    flush(io);
    if st[b + s_phase()] >= phase_handshake() {
        tls.drop(engine, slot);
    }
    var k = 0;
    while k < stride() {
        st[b + k] = 0;
        k = k + 1;
    }
    conns.close(tab, slot);
    return 1;
}

// Writes what the engine has for the socket. 0 when all of it went (or
// there was none), 1 when the socket is full, -1 when it failed.
pub fn flush_slot[&e, &t, &s, &p](engine: &!e tls.Engine, tab: &!t conns.Table, st: &!s [int], pend: &!p [byte], slot: int) -> [conn_write] int {
    let b = slot * stride();
    let base = slot * pend_cap();
    while true {
        if st[b + s_ps()] == st[b + s_pe()] {
            st[b + s_ps()] = 0;
            st[b + s_pe()] = tls.take(engine, slot, pend[base..base + pend_cap()]);
            if st[b + s_pe()] == 0 {
                return 0;
            }
        }
        match conns.write(tab, slot, pend[base + st[b + s_ps()]..base + st[b + s_pe()]]) {
            Sent::Wrote(k) => {
                st[b + s_ps()] = st[b + s_ps()] + k;
            }
            Sent::Again => {
                return 1;
            }
            Sent::Failed(e) => {
                return 0 - 1;
            }
        }
    }
    return 0;
}

// Whether a handshake from the key (`family`, `bits`) may start now under `--per-address-rate`,
// counting it if so. A key is counted in the address table of `gl` for the current window; an
// entry from an earlier window is free. If the table holds `ak_cap()` keys of this window the
// answer is no, which delays the connection to the next window and never lets one through.
pub fn addr_allows[&g, &c](gl: &!g [int], cfg: &c [int], family: int, bits: int) -> [] bool {
    let limit = cfg[c_addr_rate()];
    if limit == 0 {
        return true;
    }
    let serial = gl[g_wserial()] + 1;
    var free = 0 - 1;
    var k = 0;
    while k < ak_cap() {
        let at = g_ak() + 4 * k;
        if gl[at + 2] == serial {
            if gl[at] == family && gl[at + 1] == bits {
                if gl[at + 3] >= limit {
                    return false;
                }
                gl[at + 3] = gl[at + 3] + 1;
                return true;
            }
        } else if free < 0 {
            free = at;
        }
        k = k + 1;
    }
    if free < 0 {
        return false;
    }
    gl[free] = family;
    gl[free + 1] = bits;
    gl[free + 2] = serial;
    gl[free + 3] = 1;
    return true;
}

// The slot's key, as (family, bits) -- the two ints `addr.key_from` takes back.
pub fn slot_key_family[&s](st: &s [int], b: int) -> [] int {
    return addr.key_family(addr.key(addr.from_parts(st[b + s_pfam()], st[b + s_pw0()], st[b + s_pw1()], st[b + s_pw2()], st[b + s_pw3()], 0)));
}

pub fn slot_key_bits[&s](st: &s [int], b: int) -> [] int {
    return addr.key_bits(addr.key(addr.from_parts(st[b + s_pfam()], st[b + s_pw0()], st[b + s_pw1()], st[b + s_pw2()], st[b + s_pw3()], 0)));
}

// Starts queued connections, oldest first, while both bounds allow:
// fewer than `--handshakes` in progress and fewer than `--rate` started
// in this second. A connection whose address key has already started
// `--per-address-rate` handshakes in this second is passed over and keeps
// its place in the queue's order for the next window, without holding up
// the ones behind it. Answers how many ended (a `serve` that refused).
pub fn admit[&i, &e, &t, &p, &s, &g, &q, &c](io: &!i Io, engine: &!e tls.Engine, tab: &!t conns.Table, poller: &!p Poller, st: &!s [int], gl: &!g [int], queue: &!q [int], cfg: &c [int], now: int, now_unix: int) -> [poll, io_write] int {
    var ended = 0;
    if now - gl[g_window()] >= 1000 {
        gl[g_window()] = now;
        gl[g_started()] = 0;
        gl[g_wserial()] = gl[g_wserial()] + 1;
    }
    gl[g_held()] = 0;
    let cap = cfg[c_conns()];
    // One pass over what was queued when it began: a connection passed over goes to the tail,
    // and is not looked at again until the next call.
    var passes = gl[g_qlen()];
    while passes > 0 && gl[g_qlen()] > 0 && gl[g_started()] < cfg[c_rate()] && tls.handshakes_in_progress(engine) < cfg[c_handshakes()] {
        passes = passes - 1;
        let entry = queue[gl[g_qhead()]];
        gl[g_qhead()] = (gl[g_qhead()] + 1) % cap;
        gl[g_qlen()] = gl[g_qlen()] - 1;
        let slot = entry % 4096;
        let b = slot * stride();
        // An entry whose connection ended while it waited, or whose slot a
        // later connection took, is skipped.
        if st[b + s_phase()] == phase_queued() && st[b + s_id()] == entry / 4096 {
            if !addr_allows(gl, cfg, slot_key_family(st, b), slot_key_bits(st, b)) {
                queue[(gl[g_qhead()] + gl[g_qlen()]) % cap] = entry;
                gl[g_qlen()] = gl[g_qlen()] + 1;
                gl[g_held()] = gl[g_held()] + 1;
            } else {
                let code = tls.serve(engine, slot, now_unix);
                if code != 0 {
                    ended = ended + end_slot(io, engine, tab, st, slot, code, now);
                } else {
                    st[b + s_phase()] = phase_handshake();
                    st[b + s_waited()] = now - st[b + s_since()];
                    st[b + s_since()] = now;
                    gl[g_started()] = gl[g_started()] + 1;
                    if conns.watch(tab, poller, slot, slot + 1, 1) != 0 {
                        ended = ended + end_slot(io, engine, tab, st, slot, r_socket(), now);
                    } else {
                        st[b + s_watch()] = 1;
                    }
                }
            }
        }
    }
    return ended;
}

// Every identity read again beneath `dir` and replaced in the engine.
pub fn reload[&h, &i, &d, &e, &u, &l](heap: &!h Heap, io: &!i Io, dir: &d Dir, engine: &!e tls.Engine, subs: &u [byte], sublens: &l [int], count: int, now_unix: int) -> [heap, dir_read, file_read, io_write] int {
    var id = 0;
    var bad = 0;
    while id < count {
        let at = id * sub_cap();
        let code = echo_identity.load(heap, dir, subs[at..at + sublens[id]], engine, id, now_unix);
        io.write_all(io, "reload ");
        io.print_int(io, id);
        if code >= 0 {
            io.write_all(io, " ok");
        } else if code <= echo_identity.file_base() {
            io.write_all(io, " unreadable ");
            io.write_all(io, echo_identity.failed_file(code));
            io.write_all(io, " errno=");
            io.print_int(io, echo_identity.failed_errno(code));
            bad = bad + 1;
        } else {
            io.write_all(io, " refused ");
            io.write_all(io, tls.refusal_tag(code));
            bad = bad + 1;
        }
        io.newline(io);
        flush(io);
        id = id + 1;
    }
    return bad;
}

// `address:port` of a connection that is not in a table (so `conns.peer` cannot be asked), or `-`.
fn print_conn_peer[&i, &h](io: &!i Io, conn: &h Conn) -> [io_write] int {
    region r {
        let raw = alloc_slice[r](addr.raw_len(), byte_of(0));
        if conn_peer(conn, raw) == 0 {
            match addr.decode(raw) {
                addr.Parsed::Ok(p) => {
                    let text = alloc_slice[r](addr.max_text(), byte_of(0));
                    io.write_all(io, text[0..addr.text_port(p, text)]);
                }
                addr.Parsed::Bad => {
                    io.write_all(io, "-");
                }
            }
        } else {
            io.write_all(io, "-");
        }
    }
    return 0;
}

// How many connections in the table (any phase but free) are from the key (`family`, `bits`).
pub fn count_key[&s](st: &s [int], slots: int, family: int, bits: int) -> [] int {
    var n = 0;
    var slot = 0;
    while slot < slots {
        let b = slot * stride();
        if st[b + s_phase()] != phase_free() && st[b + s_pfam()] != 0 && slot_key_family(st, b) == family && slot_key_bits(st, b) == bits {
            n = n + 1;
        }
        slot = slot + 1;
    }
    return n;
}

// Accepts every connection waiting on the listener: each takes a slot and
// joins the queue, or, over the table, once stopping, or over `--per-address`, is
// closed at once. The peer is asked right after the connection is put in the table and
// kept in its slot (`docs/conn-peer.md` section 7).
pub fn accept_all[&h, &i, &l, &s, &g, &q, &c](heap: &!h Heap, io: &!i Io, table: conns.Table, listener: &!l Listener, st: &!s [int], gl: &!g [int], queue: &!q [int], cfg: &c [int], now: int) -> [heap, conn_accept, io_write] conns.Table {
    var tab = table;
    var more = true;
    while more {
        match tcp_accept(listener) {
            Accepted::Ok(c) => {
                var live = 0;
                borrow tab as &tt in {
                    live = conns.live(tt);
                }
                let id = gl[g_next_id()];
                gl[g_next_id()] = id + 1;
                if live >= cfg[c_conns()] || gl[g_stopping()] == 1 {
                    // It never enters the table, so its peer is read from the connection itself.
                    var refused = c;
                    io.write_all(io, "refused ");
                    io.print_int(io, id);
                    io.write_all(io, " peer=");
                    borrow refused as &rh in {
                        print_conn_peer(io, rh);
                    }
                    conn_close(refused);
                    if gl[g_stopping()] == 1 {
                        io.write_all(io, " stopping\n");
                    } else {
                        io.write_all(io, " full\n");
                    }
                    flush(io);
                } else {
                    let (grown, slot) = conns.put(heap, tab, c);
                    tab = grown;
                    if slot >= 0 && slot < cfg[c_conns()] {
                        borrow mut tab as &!tw in {
                            if conns.nonblocking(tw, slot) != 0 {
                                conns.close(tw, slot);
                            } else {
                                let b = slot * stride();
                                var family = 0;
                                match conns.peer(tw, slot) {
                                    conns.Peered::Known(p) => {
                                        family = addr.family(p);
                                        st[b + s_pfam()] = family;
                                        st[b + s_pw0()] = addr.word(p, 0);
                                        st[b + s_pw1()] = addr.word(p, 1);
                                        st[b + s_pw2()] = addr.word(p, 2);
                                        st[b + s_pw3()] = addr.word(p, 3);
                                        st[b + s_pport()] = addr.port(p);
                                    }
                                    conns.Peered::Unavailable(e) => {
                                    }
                                }
                                var why = "";
                                if family == 0 {
                                    // It ended between `accept` and now; there is nobody to serve.
                                    why = "gone";
                                } else if cfg[c_per_addr()] > 0 && count_key(st, cfg[c_conns()], family, slot_key_bits(st, b)) >= cfg[c_per_addr()] {
                                    why = "per-address";
                                }
                                if len(why) > 0 {
                                    io.write_all(io, "refused ");
                                    io.print_int(io, id);
                                    io.write_all(io, " peer=");
                                    print_peer(io, st, b);
                                    io.write_all(io, " ");
                                    io.write_all(io, why);
                                    io.newline(io);
                                    flush(io);
                                    var k = 0;
                                    while k < stride() {
                                        st[b + k] = 0;
                                        k = k + 1;
                                    }
                                    conns.close(tw, slot);
                                } else {
                                    st[b + s_phase()] = phase_queued();
                                    st[b + s_id()] = id;
                                    st[b + s_since()] = now;
                                    st[b + s_accepted()] = now;
                                    let at = (gl[g_qhead()] + gl[g_qlen()]) % cfg[c_conns()];
                                    queue[at] = id * 4096 + slot;
                                    gl[g_qlen()] = gl[g_qlen()] + 1;
                                }
                            }
                        }
                    }
                }
            }
            Accepted::Again => {
                more = false;
            }
            Accepted::Failed(e) => {
                more = false;
            }
        }
    }
    return tab;
}

// How long the next wait may sleep: until the rate's window turns if a
// queued connection waits on it, else a quarter second, which is how
// often the timeouts are looked at.
pub fn timeout_of[&g, &c](gl: &g [int], cfg: &c [int], now: int) -> [] int {
    if gl[g_qlen()] > 0 && (gl[g_started()] >= cfg[c_rate()] || gl[g_held()] > 0) {
        let left = gl[g_window()] + 1000 - now;
        if left < 1 {
            return 1;
        }
        if left < 250 {
            return left;
        }
    }
    return 250;
}

// A decimal argument, or -1 if it is not one (or is over 10^9).
pub fn number[&s](s: &s [byte]) -> [] int {
    if len(s) == 0 || len(s) > 9 {
        return 0 - 1;
    }
    var n = 0;
    var i = 0;
    while i < len(s) {
        let c = int_of(s[i]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        n = n * 10 + c - '0';
        i = i + 1;
    }
    return n;
}

// A number option's value into `cfg[at]`, within `low..=high`: false if
// it is not one.
pub fn set_number[&c](cfg: &!c [int], at: int, text: &static [byte], low: int, high: int) -> [] bool {
    let n = number(text);
    if n < low || n > high {
        return false;
    }
    cfg[at] = n;
    return true;
}

// The command line into `cfg` (and the port into `cfg[cfg_len()]`), the
// identities' subdirectories into `subs`/`sublens`, and the ALPN list,
// commas made spaces, into `alpn`. Answers the directory (empty if
// `--dir` was not given: `examples/tls_echo_fixed` has none to give), and in
// `info[0]` the ALPN list's length and `info[1]` 0, or 2 for a usage
// error.
pub fn parse_flags[&g, &c, &u, &n, &a, &f](g: &g Args, cfg: &!c [int], subs: &!u [byte], sublens: &!n [int], alpn: &!a [byte], info: &!f [int]) -> [args] &static [byte] {
    var dir = "";
    var bad = false;
    var c = flags.start();
    var going = true;
    while going {
        let (next, step) = flags.step(g, c);
        c = next;
        match step {
            flags.Arg::Long(name) => {
                let (after, text) = flags.value(g, c);
                c = after;
                if flags.named(name, "port") {
                    bad = bad || !set_number(cfg, cfg_len(), text, 1, 65535);
                } else if flags.named(name, "dir") {
                    dir = text;
                } else if flags.named(name, "identity") {
                    let k = cfg[c_identities()];
                    if k >= 16 || len(text) == 0 || len(text) > sub_cap() {
                        bad = true;
                    } else {
                        var j = 0;
                        while j < len(text) {
                            subs[k * sub_cap() + j] = text[j];
                            j = j + 1;
                        }
                        sublens[k] = len(text);
                        cfg[c_identities()] = k + 1;
                    }
                } else if flags.named(name, "alpn") {
                    if len(text) > len(alpn) {
                        bad = true;
                    } else {
                        var j = 0;
                        while j < len(text) {
                            alpn[j] = text[j];
                            if int_of(text[j]) == ',' {
                                alpn[j] = byte_of(' ');
                            }
                            j = j + 1;
                        }
                        info[0] = len(text);
                    }
                } else if flags.named(name, "connections") {
                    bad = bad || !set_number(cfg, c_conns(), text, 1, 4096);
                } else if flags.named(name, "handshakes") {
                    bad = bad || !set_number(cfg, c_handshakes(), text, 1, 4096);
                } else if flags.named(name, "rate") {
                    bad = bad || !set_number(cfg, c_rate(), text, 1, 1000000);
                } else if flags.named(name, "per-address") {
                    bad = bad || !set_number(cfg, c_per_addr(), text, 1, 4096);
                } else if flags.named(name, "per-address-rate") {
                    bad = bad || !set_number(cfg, c_addr_rate(), text, 1, 1000000);
                } else if flags.named(name, "handshake-timeout") {
                    bad = bad || !set_number(cfg, c_hs_timeout(), text, 1, 3600000);
                } else if flags.named(name, "idle") {
                    bad = bad || !set_number(cfg, c_idle(), text, 1, 86400000);
                } else {
                    bad = true;
                }
            }
            flags.Arg::Short(letter) => {
                bad = true;
            }
            flags.Arg::Operand(text) => {
                bad = true;
            }
            flags.Arg::Done => {
                going = false;
            }
        }
    }
    if bad || cfg[cfg_len()] == 0 {
        info[1] = 2;
    }
    return dir;
}

// `parse_flags`, for a server whose operator names the directory: `--dir` is
// required.
pub fn parse[&g, &c, &u, &n, &a, &f](g: &g Args, cfg: &!c [int], subs: &!u [byte], sublens: &!n [int], alpn: &!a [byte], info: &!f [int]) -> [args] &static [byte] {
    let dir = parse_flags(g, cfg, subs, sublens, alpn, info);
    if len(dir) == 0 {
        info[1] = 2;
    }
    return dir;
}

// Every identity added to the engine, the first the default. 0, or 6 if
// one could not be read or was refused (each said on standard error).
pub fn add_all[&h, &i, &d, &e, &u, &n](heap: &!h Heap, io: &!i Io, dir: &d Dir, engine: &!e tls.Engine, subs: &u [byte], sublens: &n [int], count: int, now_unix: int) -> [heap, dir_read, file_read, err_write] int {
    var id = 0;
    while id < count {
        let at = id * sub_cap();
        let code = echo_identity.load(heap, dir, subs[at..at + sublens[id]], engine, 0 - 1, now_unix);
        if code < 0 {
            io.error_all(io, "tls_echo: identity ");
            io.error_all(io, subs[at..at + sublens[id]]);
            if code <= echo_identity.file_base() {
                io.error_all(io, ": cannot read ");
                io.error_all(io, echo_identity.failed_file(code));
            } else {
                io.error_all(io, ": refused, ");
                io.error_all(io, tls.refusal_tag(code));
            }
            io.error_all(io, "\n");
            return 6;
        }
        id = id + 1;
    }
    return 0;
}
