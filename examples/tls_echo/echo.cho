edition 6;
module echo_loop;

// `tls_echo`'s loop: `tls_front`'s (`examples/tls_echo/front.cho`: the phases, the
// handshake bounds, the reload, the stop and the log, all described there) with the
// echo as what happens to an established connection's plaintext. `pump` is the
// connection's turn: write what the engine has, echo what was received, feed what the
// socket gave, read the socket. `examples/https_hello/loop.cho` is the same `pump` with
// `packages/http-server` where the echo is.

import std.conns;
import std.io;
import std.signals as sg;
import tls_front as front;
import tls;

// Everything that can be done for the connection in `slot` now, without
// waiting: write, echo, feed, read, until none of them moves. Reads only
// when everything read before has been echoed and written, so a peer that
// does not read its echo stops being read (back-pressure), and its slot's
// buffers are the most it can make the server hold. Answers 1 if the
// connection ended.
fn pump[&i, &e, &t, &p, &s, &q, &n, &a](io: &!i Io, engine: &!e tls.Engine, tab: &!t conns.Table, poller: &!p Poller, st: &!s [int], pend: &!q [byte], inq: &!n [byte], app: &!a [byte], slot: int, now: int) -> [conn_read, conn_write, poll, io_write] int {
    let b = slot * front.stride();
    let ib = slot * front.inq_cap();
    let ab = slot * front.app_cap();
    var going = true;
    var blocked = false;
    while going {
        going = false;
        let w = front.flush_slot(engine, tab, st, pend, slot);
        if w < 0 {
            return front.end_slot(io, engine, tab, st, slot, front.r_socket(), now);
        }
        blocked = w == 1;
        if !blocked {
            let ev = tls.event(engine, slot);
            if ev == tls.event_failed() {
                return front.end_slot(io, engine, tab, st, slot, tls.failure(engine, slot), now);
            }
            // `closed` is said as soon as the peer's close_notify is read,
            // before ours is queued: an established connection first echoes
            // what came before it (`recv` answers 0 after it, below), and the
            // connection ends once our close_notify is written too.
            if ev == tls.event_closed() && st[b + front.s_phase()] == front.phase_closing() {
                return front.end_slot(io, engine, tab, st, slot, st[b + front.s_reason()], now);
            }
            if ev == tls.event_closed() && st[b + front.s_phase()] == front.phase_handshake() {
                tls.finish(engine, slot);
                st[b + front.s_phase()] = front.phase_closing();
                st[b + front.s_since()] = now;
                going = true;
            }
            if ev == tls.event_established() && st[b + front.s_phase()] == front.phase_handshake() {
                front.log_established(io, engine, st, slot, now);
                st[b + front.s_phase()] = front.phase_established();
                st[b + front.s_active()] = now;
            }
        }
        if !blocked && st[b + front.s_phase()] == front.phase_established() {
            // The echo: what was received goes back as it came.
            if st[b + front.s_as()] < st[b + front.s_ae()] {
                let k = tls.send(engine, slot, app[ab + st[b + front.s_as()]..ab + st[b + front.s_ae()]]);
                if k > 0 {
                    st[b + front.s_as()] = st[b + front.s_as()] + k;
                    going = true;
                } else if k < 0 {
                    return front.end_slot(io, engine, tab, st, slot, k, now);
                }
            }
            if st[b + front.s_as()] == st[b + front.s_ae()] {
                st[b + front.s_as()] = 0;
                st[b + front.s_ae()] = 0;
                let got = tls.recv(engine, slot, app[ab..ab + front.app_cap()]);
                if got > 0 {
                    st[b + front.s_ae()] = got;
                    st[b + front.s_in()] = st[b + front.s_in()] + got;
                    going = true;
                } else if got == 0 {
                    // The peer's close_notify, after everything it sent was
                    // echoed: ours, and the connection is done once it is written.
                    tls.finish(engine, slot);
                    st[b + front.s_phase()] = front.phase_closing();
                    st[b + front.s_since()] = now;
                    going = true;
                } else if got != tls.would_block() {
                    return front.end_slot(io, engine, tab, st, slot, got, now);
                }
            }
        }
        if !blocked && st[b + front.s_is()] < st[b + front.s_ie()] {
            let c = tls.feed(engine, slot, inq[ib + st[b + front.s_is()]..ib + st[b + front.s_ie()]]);
            if c > 0 {
                st[b + front.s_is()] = st[b + front.s_is()] + c;
                going = true;
            } else if c < 0 {
                // Failed: its alert, if any, is written on the next turn.
                st[b + front.s_is()] = st[b + front.s_ie()];
                going = true;
            }
        }
        if st[b + front.s_is()] == st[b + front.s_ie()] {
            st[b + front.s_is()] = 0;
            st[b + front.s_ie()] = 0;
        }
        // The socket is read only once nothing else moved this turn, so
        // what the last bytes did (a handshake completed, say) is seen,
        // and logged, before an end of file that came with them.
        let idle_buffers = st[b + front.s_ie()] == 0 && st[b + front.s_ae()] == 0 && st[b + front.s_ps()] == st[b + front.s_pe()];
        if !going && !blocked && idle_buffers && st[b + front.s_eof()] == 0 && st[b + front.s_phase()] != front.phase_closing() {
            match conns.read(tab, slot, inq[ib..ib + front.inq_cap()]) {
                Received::Data(k) => {
                    st[b + front.s_ie()] = k;
                    st[b + front.s_active()] = now;
                    going = true;
                }
                Received::End => {
                    st[b + front.s_eof()] = 1;
                    tls.eof(engine, slot);
                    going = true;
                }
                Received::Again => {
                }
                Received::Failed(e) => {
                    return front.end_slot(io, engine, tab, st, slot, front.r_socket(), now);
                }
            }
        }
    }
    var want = 1;
    if blocked {
        want = 2;
    }
    if want != st[b + front.s_watch()] {
        conns.rewatch(tab, poller, slot, slot + 1, want);
        st[b + front.s_watch()] = want;
    }
    return 0;
}

// Sends close_notify on an established connection, for `reason`.
fn close_with[&i, &e, &t, &p, &s, &q, &n, &a](io: &!i Io, engine: &!e tls.Engine, tab: &!t conns.Table, poller: &!p Poller, st: &!s [int], pend: &!q [byte], inq: &!n [byte], app: &!a [byte], slot: int, reason: int, now: int) -> [conn_read, conn_write, poll, io_write] int {
    let b = slot * front.stride();
    tls.finish(engine, slot);
    st[b + front.s_phase()] = front.phase_closing();
    st[b + front.s_since()] = now;
    st[b + front.s_reason()] = reason;
    return pump(io, engine, tab, poller, st, pend, inq, app, slot, now);
}

fn sweep[&i, &e, &t, &p, &s, &q, &n, &a, &c](io: &!i Io, engine: &!e tls.Engine, tab: &!t conns.Table, poller: &!p Poller, st: &!s [int], pend: &!q [byte], inq: &!n [byte], app: &!a [byte], cfg: &c [int], now: int) -> [conn_read, conn_write, poll, io_write] int {
    var slot = 0;
    while slot < cfg[front.c_conns()] {
        let b = slot * front.stride();
        let phase = st[b + front.s_phase()];
        let held = now - st[b + front.s_since()];
        if phase == front.phase_queued() && held > cfg[front.c_hs_timeout()] {
            front.end_slot(io, engine, tab, st, slot, front.r_queue_timeout(), now);
        } else if phase == front.phase_handshake() && held > cfg[front.c_hs_timeout()] {
            front.end_slot(io, engine, tab, st, slot, front.r_handshake_timeout(), now);
        } else if phase == front.phase_established() && now - st[b + front.s_active()] > cfg[front.c_idle()] {
            close_with(io, engine, tab, poller, st, pend, inq, app, slot, front.r_idle(), now);
        } else if phase == front.phase_closing() && held > cfg[front.c_hs_timeout()] {
            // Our close_notify was never taken: the peer is not reading.
            front.end_slot(io, engine, tab, st, slot, st[b + front.s_reason()], now);
        }
        slot = slot + 1;
    }
    return 0;
}

// A stop: queued and handshaking connections are closed, established ones
// are sent close_notify.
fn stop_all[&i, &e, &t, &p, &s, &q, &n, &a, &c](io: &!i Io, engine: &!e tls.Engine, tab: &!t conns.Table, poller: &!p Poller, st: &!s [int], pend: &!q [byte], inq: &!n [byte], app: &!a [byte], cfg: &c [int], now: int) -> [conn_read, conn_write, poll, io_write] int {
    var slot = 0;
    while slot < cfg[front.c_conns()] {
        let phase = st[slot * front.stride() + front.s_phase()];
        if phase == front.phase_queued() || phase == front.phase_handshake() {
            front.end_slot(io, engine, tab, st, slot, front.r_shutdown(), now);
        } else if phase == front.phase_established() {
            close_with(io, engine, tab, poller, st, pend, inq, app, slot, front.r_shutdown(), now);
        }
        slot = slot + 1;
    }
    return 0;
}

// Serves until stopped. `subs`/`sublens` name each identity's
// subdirectory beneath `dir`, for a reload. 0, or 4 if there is no poller.
pub fn run[&h, &i, &l, &k, &e, &d, &w, &u, &n, &c](heap: &!h Heap, io: &!i Io, listener: &!l Listener, clock: &k Clock, engine: &!e tls.Engine, dir: &d Dir, watch: &!w SignalWatch, subs: &u [byte], sublens: &n [int], cfg: &c [int]) -> [heap, conn_accept, conn_read, conn_write, poll, clock, signals_read, dir_read, file_read, io_write] int {
    let max = cfg[front.c_conns()];
    let sig_token = max + 1;
    match poller_new() {
        Polling::Failed(e) => {
            return 4;
        }
        Polling::Ok(pl) => {
            var poll = pl;
            borrow mut poll as &!pw in {
                poller_add_listener(pw, listener, 0);
                poller_add_signals(pw, watch, sig_token);
            }
            var table = conns.empty(heap, max);
            let stb = box_slice(heap, front.stride() * max, 0);
            let glb = box_slice(heap, front.gl_len(), 0);
            let qb = box_slice(heap, max, 0);
            let pendb = box_slice(heap, front.pend_cap() * max, byte_of(0));
            let inqb = box_slice(heap, front.inq_cap() * max, byte_of(0));
            let appb = box_slice(heap, front.app_cap() * max, byte_of(0));
            let evb = box_slice(heap, 2 * max + 8, 0);
            borrow mut stb as &!sw in {
                borrow mut glb as &!gw in {
                    borrow mut qb as &!qw in {
                        borrow mut pendb as &!pdw in {
                            borrow mut inqb as &!iw in {
                                borrow mut appb as &!aw in {
                                    borrow mut evb as &!ew in {
                                        let st = contents(sw);
                                        let gl = contents(gw);
                                        let queue = contents(qw);
                                        let events = contents(ew);
                                        var now = clock_ms(clock);
                                        gl[front.g_window()] = now;
                                        gl[front.g_last_sweep()] = now;
                                        gl[front.g_next_id()] = 1;
                                        var running = true;
                                        while running {
                                            var ready = 0;
                                            borrow mut poll as &!pw in {
                                                ready = poller_wait(pw, events, front.timeout_of(gl, cfg, now));
                                            }
                                            now = clock_ms(clock);
                                            let now_unix = clock_unix_ms(clock);
                                            var j = 0;
                                            while j < ready {
                                                let token = events[2 * j];
                                                if token == 0 {
                                                    table = front.accept_all(heap, io, table, listener, st, gl, queue, cfg, now);
                                                } else if token == sig_token {
                                                    let mask = signals_pending(watch);
                                                    if sg.has(mask, sg.sighup()) {
                                                        front.reload(heap, io, dir, engine, subs, sublens, cfg[front.c_identities()], now_unix);
                                                    }
                                                    if sg.any(mask, sg.stop_signals()) && gl[front.g_stopping()] == 0 {
                                                        gl[front.g_stopping()] = 1;
                                                        gl[front.g_stop_at()] = now;
                                                        io.write_all(io, "stopping\n");
                                                        front.flush(io);
                                                        borrow mut table as &!tw in {
                                                            borrow mut poll as &!pw in {
                                                                stop_all(io, engine, tw, pw, st, contents(pdw), contents(iw), contents(aw), cfg, now);
                                                            }
                                                        }
                                                    }
                                                } else {
                                                    let slot = token - 1;
                                                    if slot >= 0 && slot < max && st[slot * front.stride() + front.s_phase()] >= front.phase_handshake() {
                                                        borrow mut table as &!tw in {
                                                            borrow mut poll as &!pw in {
                                                                pump(io, engine, tw, pw, st, contents(pdw), contents(iw), contents(aw), slot, now);
                                                            }
                                                        }
                                                    }
                                                }
                                                j = j + 1;
                                            }
                                            borrow mut table as &!tw in {
                                                borrow mut poll as &!pw in {
                                                    if now - gl[front.g_last_sweep()] >= 100 {
                                                        gl[front.g_last_sweep()] = now;
                                                        sweep(io, engine, tw, pw, st, contents(pdw), contents(iw), contents(aw), cfg, now);
                                                    }
                                                    if gl[front.g_stopping()] == 0 {
                                                        front.admit(io, engine, tw, pw, st, gl, queue, cfg, now, now_unix);
                                                    }
                                                }
                                            }
                                            if gl[front.g_stopping()] == 1 {
                                                var live = 0;
                                                borrow table as &tt in {
                                                    live = conns.live(tt);
                                                }
                                                if live == 0 || now - gl[front.g_stop_at()] > front.drain_ms() {
                                                    running = false;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            unbox_slice(heap, stb);
            unbox_slice(heap, glb);
            unbox_slice(heap, qb);
            unbox_slice(heap, pendb);
            unbox_slice(heap, inqb);
            unbox_slice(heap, appb);
            unbox_slice(heap, evb);
            conns.drop(heap, table);
            poller_close(poll);
            return 0;
        }
    }
}
