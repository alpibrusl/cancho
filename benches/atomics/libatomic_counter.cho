// docs/atomics.md section 1.3: "write it in your program first", as far as it goes today. Linux only: libatomic's
// `__atomic_fetch_add_8(void *p, uint64_t v, int order)` through `Ffi("atomic")`. Only a `[byte]` slice crosses a
// foreign boundary, as pointer and length, so the slice supplies p and v: an 8-byte slice makes `v` 8. Four threads
// each add 8 to one 8-byte heap cell 1,000,000 times through `&r Shared`; the answer is 32,000,000, printed as `E`
// (`L` if not). Measured on x86-64 Linux (older compiler rev 4c27593, edition 6): `E` on both backends,
// 0.05-0.08 s for the four million contended increments.
//
// Run: cancho run benches/atomics/libatomic_counter.cho --backend llvm -l atomic

edition 6;

// libatomic's __atomic_fetch_add_8(void *p, uint64_t v, int order): the slice supplies (p, len), so a
// 8-byte slice makes `v` 8. order 5 = __ATOMIC_SEQ_CST.
extern fn __atomic_fetch_add_8[&f, &s](ffi: &f Ffi("atomic"), cell: &s [byte], order: int) -> [ffi("atomic")] int;

res struct Shared {
    cell: Box[[byte]],
    lib: Ffi("atomic"),
}

fn work[&r](s: &r Shared) -> [ffi("atomic")] int {
    var i = 0;
    while i < 1000000 {
        let old = __atomic_fetch_add_8(s.lib, contents(s.cell), 5);
        i = i + 1;
    }
    return 0;
}

fn run[&i, &h](io: &!i Io, heap: &!h Heap, lib: Ffi("atomic")) -> [io_write, heap, conc] int {
    let s = Shared { cell: box_slice(heap, 8, byte_of(0)), lib: lib };
    var total = 0;
    borrow s as &q in {
        let f0 = work;
        let f1 = work;
        let f2 = work;
        let f3 = work;
        let t0 = spawn(q, f0);
        let t1 = spawn(q, f1);
        let t2 = spawn(q, f2);
        let t3 = spawn(q, f3);
        let a = join(t0);
        let b = join(t1);
        let c = join(t2);
        let d = join(t3);
        var k = 7;
        while k >= 0 {
            total = total * 256 + int_of(contents(q.cell)[k]);
            k = k - 1;
        }
    }
    let Shared { cell, lib } = s;
    unbox_slice(heap, cell);
    release(lib);
    if total == 32000000 {
        putchar(io, 69);
    } else {
        putchar(io, 76);
    }
    putchar(io, 10);
    return 0;
}

fn main(world: World) -> [conc] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals } = split(world);
    release(fs);
    release(args);
    release(net);
    release(clock);
    release(signals);
    let lib = narrow(ffi, "atomic");
    var i0 = io;
    var h0 = heap;
    borrow mut i0 as &!i in {
        borrow mut h0 as &!h in {
            let c = run(i, h, lib);
        }
    }
    release(i0);
    release(h0);
    return 0;
}
